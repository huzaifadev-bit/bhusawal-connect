---
// Bhusawal Connect - Rider Partner Home Screen & Live Fleet Dashboard
// Inspired by Blinkit Captain, Zomato Delivery Partner and Uber Driver UX
---

<!-- ==================== VIEW: FULL RIDER DASHBOARD (MAP-FIRST LIVE INTERFACE) ==================== -->
<section id="view-dashboard" class="fixed inset-0 w-full h-[100dvh] flex flex-col bg-slate-950 overflow-hidden z-40 selection:bg-blue-600 selection:text-white">
  
  <!-- MAIN TABS CONTAINER -->
  <div class="relative w-full flex-1 overflow-hidden">

    <!-- ==================== TAB 1: HOME (MAP-FIRST LIVE VIEW) ==================== -->
    <div id="tab-content-home" class="tab-page absolute inset-0 w-full h-full flex flex-col overflow-hidden">
      
      <!-- 1. LIVE BHUSAWAL LEAFLET MAP CANVAS -->
      <div id="rider-live-map" class="absolute inset-0 w-full h-full z-0 bg-slate-950"></div>

      <!-- 2. TOP FLOATING COMMAND BAR -->
      <div class="relative z-20 mx-3 mt-3 max-w-md w-[calc(100%-1.5rem)] self-center pointer-events-auto">
        <div class="bg-slate-900/95 backdrop-blur-xl rounded-2xl p-3 border border-slate-800/90 shadow-2xl space-y-2.5">
          
          <div class="flex items-center justify-between">
            <!-- Brand logo & Captain Title -->
            <div class="flex items-center gap-2.5">
              <div class="w-10 h-10 bg-gradient-to-tr from-blue-700 to-blue-500 text-white rounded-xl flex items-center justify-center font-black shadow-lg shadow-blue-600/30 border border-blue-400/30">
                <span class="material-symbols-outlined text-xl">two_wheeler</span>
              </div>
              <div>
                <h1 class="text-sm font-black text-white leading-tight tracking-tight flex items-center gap-1.5">
                  <span>Bhusawal Connect</span>
                  <span class="px-1.5 py-0.5 bg-blue-500/20 text-blue-300 text-[9px] font-black rounded uppercase border border-blue-500/30">CAPTAIN</span>
                </h1>
                <p class="text-[10px] font-semibold text-slate-400 flex items-center gap-1">
                  <span>Shared Fleet • Bhusawal</span>
                  <span class="inline-block w-1 h-1 rounded-full bg-slate-600"></span>
                  <span class="text-emerald-400 font-bold flex items-center gap-0.5">
                    <span class="material-symbols-outlined text-[11px]">verified</span> KYC
                  </span>
                </p>
              </div>
            </div>

            <!-- Right Header Actions: Notification Bell + Profile Avatar -->
            <div class="flex items-center gap-2">
              <button id="btn-top-notif" class="relative w-9 h-9 rounded-xl bg-slate-800/90 text-slate-300 hover:text-white border border-slate-700 flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-sm" title="Alerts">
                <span class="material-symbols-outlined text-lg">notifications</span>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
              </button>
              <button id="btn-top-profile" class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 text-white font-black text-xs flex items-center justify-center border border-blue-400/40 shadow-md active:scale-95 cursor-pointer" title="Profile">
                <span id="top-avatar-initials">RP</span>
              </button>
            </div>
          </div>

          <!-- PROMINENT ON DUTY / OFF DUTY CONTROL -->
          <div class="border-t border-slate-800/80 pt-2 flex items-center justify-between gap-2.5">
            <div class="min-w-0 flex-1">
              <p id="duty-banner-headline" class="text-xs font-black text-white truncate">You're available for orders.</p>
              <p id="duty-banner-subtext" class="text-[10px] font-semibold text-slate-400 truncate">Receiving Grocery, Food, Medicine, Parcel & Rides</p>
            </div>
            <button
              id="btn-toggle-duty"
              class="shrink-0 px-4 py-2 rounded-xl font-black text-xs flex items-center gap-2 shadow-lg transition-all active:scale-95 cursor-pointer bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-emerald-500/25 border border-emerald-400/50"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-slate-950 animate-pulse" id="duty-btn-dot"></span>
              <span id="btn-duty-text">🟢 ON DUTY</span>
            </button>
          </div>

        </div>
      </div>

      <!-- 3. HOME SUMMARY HUD (Today's Earnings, Completed, Distance, Online Time) -->
      <div class="relative z-20 mx-3 mt-2 max-w-md w-[calc(100%-1.5rem)] self-center pointer-events-auto">
        <div class="bg-slate-900/90 backdrop-blur-xl rounded-2xl p-2.5 border border-slate-800 shadow-xl grid grid-cols-4 gap-1 text-center">
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-wider block">Today</span>
            <span id="summary-today-earnings" class="text-sm font-black text-emerald-400 font-display">₹684</span>
          </div>
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-wider block">Orders</span>
            <span id="summary-today-orders" class="text-sm font-black text-white">6</span>
          </div>
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-wider block">Distance</span>
            <span id="summary-today-dist" class="text-sm font-black text-sky-400">18.4 km</span>
          </div>
          <div class="px-1">
            <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-wider block">Online</span>
            <span id="summary-today-time" class="text-sm font-black text-purple-400">4.2h</span>
          </div>
        </div>
      </div>

      <!-- 4. FIVE-VERTICAL SERVICE STATUS INDICATOR STRIP -->
      <div class="relative z-20 mx-3 mt-2 max-w-md w-[calc(100%-1.5rem)] self-center pointer-events-auto">
        <div class="bg-slate-900/85 backdrop-blur-md rounded-xl p-2 border border-slate-800 shadow-lg flex items-center justify-between gap-1 overflow-x-auto no-scrollbar">
          
          <!-- 1. GROCERY -->
          <div id="fleet-service-grocery" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[10px] font-black shrink-0 transition-all">
            <span class="material-symbols-outlined text-xs text-emerald-400">shopping_basket</span>
            <span>Grocery</span>
            <span class="svc-status-text text-[9px] font-bold opacity-80">Active</span>
          </div>

          <!-- 2. FOOD -->
          <div id="fleet-service-food" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-orange-500/15 border border-orange-500/30 text-orange-300 text-[10px] font-black shrink-0 transition-all">
            <span class="material-symbols-outlined text-xs text-orange-400">restaurant</span>
            <span>Food</span>
            <span class="svc-status-text text-[9px] font-bold opacity-80">Active</span>
          </div>

          <!-- 3. MEDICINE -->
          <div id="fleet-service-medicine" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-teal-500/15 border border-teal-500/30 text-teal-300 text-[10px] font-black shrink-0 transition-all">
            <span class="material-symbols-outlined text-xs text-teal-400">medical_services</span>
            <span>Medicine</span>
            <span class="svc-status-text text-[9px] font-bold opacity-80">Active</span>
          </div>

          <!-- 4. PARCEL -->
          <div id="fleet-service-parcel" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-indigo-500/15 border border-indigo-500/30 text-indigo-300 text-[10px] font-black shrink-0 transition-all">
            <span class="material-symbols-outlined text-xs text-indigo-400">inventory_2</span>
            <span>Parcel</span>
            <span class="svc-status-text text-[9px] font-bold opacity-80">Active</span>
          </div>

          <!-- 5. BIKE TAXI / PASSENGER -->
          <div id="fleet-service-passenger" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-300 text-[10px] font-black shrink-0 transition-all">
            <span class="material-symbols-outlined text-xs text-amber-400">two_wheeler</span>
            <span>Bike Taxi</span>
            <span class="svc-status-text text-[9px] font-bold opacity-80">Active</span>
          </div>

        </div>
      </div>

      <!-- 5. FLOATING MAP UTILITY CONTROLS -->
      <!-- Left: GPS Accuracy & Connection Status Pill -->
      <div id="badge-gps-accuracy" class="absolute left-3 top-52 z-20 pointer-events-auto">
        <button id="btn-gps-accuracy-info" title="GPS Status & Accuracy" class="px-2.5 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md text-white border border-slate-700/80 shadow-xl flex items-center gap-1.5 text-[11px] font-black hover:bg-slate-800 transition-all cursor-pointer">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" id="gps-status-dot"></span>
          <span id="gps-accuracy-text">GPS: ±8m Active</span>
        </button>
      </div>

      <!-- Right: Touch-Friendly Map Controls Cluster -->
      <div class="absolute right-3 top-52 z-20 flex flex-col gap-2 pointer-events-auto">
        <!-- Recenter / Auto-Follow Toggle -->
        <button id="btn-map-recenter" title="Recenter on Captain Location" class="w-10 h-10 rounded-xl bg-slate-900/95 backdrop-blur-md text-blue-400 border border-blue-500/60 shadow-xl flex items-center justify-center hover:bg-slate-800 active:scale-95 transition-all cursor-pointer relative">
          <span class="material-symbols-outlined text-lg">my_location</span>
          <span id="recenter-follow-indicator" class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-blue-500 ring-2 ring-slate-900 animate-ping"></span>
        </button>

        <!-- Demand Hotspots Toggle -->
        <button id="btn-map-hotspots" title="Toggle Demand Hotspots" class="w-10 h-10 rounded-xl bg-slate-900/95 backdrop-blur-md text-amber-400 border border-slate-700 shadow-xl flex items-center justify-center hover:bg-slate-800 active:scale-95 transition-all cursor-pointer">
          <span class="material-symbols-outlined text-lg">local_fire_department</span>
        </button>

        <!-- Thumb Zoom Controls -->
        <div class="flex flex-col rounded-xl bg-slate-900/95 backdrop-blur-md border border-slate-700 shadow-xl overflow-hidden">
          <button id="btn-map-zoom-in" title="Zoom In" class="w-10 h-9 text-slate-200 hover:text-white hover:bg-slate-800 flex items-center justify-center border-b border-slate-800 active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">add</span>
          </button>
          <button id="btn-map-zoom-out" title="Zoom Out" class="w-10 h-9 text-slate-200 hover:text-white hover:bg-slate-800 flex items-center justify-center active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">remove</span>
          </button>
        </div>
      </div>

      <!-- 6. DYNAMIC HOME STATE DRAWER (Floats over map above bottom nav) -->
      <div class="absolute bottom-20 left-3 right-3 z-20 max-w-md mx-auto pointer-events-auto">
        
        <!-- STATE A: OFFLINE STATE -->
        <div id="state-offline-card" class="hidden bg-slate-900/95 backdrop-blur-xl rounded-2xl p-4 border border-slate-700 shadow-2xl space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-2xl">bedtime</span>
            </div>
            <div>
              <h3 class="text-sm font-black text-white">You're Currently Offline</h3>
              <p class="text-[11px] font-semibold text-slate-400 leading-snug">Go online to receive delivery requests & passenger rides across Bhusawal.</p>
            </div>
          </div>
          <button id="btn-go-online-cta" class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm rounded-xl shadow-lg shadow-emerald-500/25 flex items-center justify-center gap-2 active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">bolt</span>
            <span>GO ON DUTY NOW</span>
          </button>
        </div>

        <!-- STATE B: AVAILABLE STATE (LOOKING FOR ORDERS) -->
        <div id="state-available-card" class="bg-slate-900/95 backdrop-blur-xl rounded-2xl p-4 border border-slate-700/80 shadow-2xl space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
              </span>
              <div>
                <h3 class="text-sm font-black text-white">Looking for Nearby Orders</h3>
                <p class="text-[11px] font-extrabold text-emerald-400">Shared Fleet Radar Active</p>
              </div>
            </div>
            <span class="text-[10px] font-extrabold text-amber-300 bg-amber-500/15 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1">
              <span>⚡ Station Road Surge</span>
            </span>
          </div>

          <!-- Radar Scanning Ticker -->
          <div class="bg-slate-950/80 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2 text-slate-300">
              <span class="material-symbols-outlined text-blue-400 text-sm animate-spin">radar</span>
              <span class="text-[11px] font-bold">Scanning 3 km radius in Bhusawal</span>
            </div>
            <span class="text-[10px] font-extrabold text-blue-300 bg-blue-500/15 px-2 py-0.5 rounded-md border border-blue-500/25">5 Verticals</span>
          </div>

          <!-- Collapsible Dispatch Simulation Drawer (For Rapid Verification) -->
          <div class="border-t border-slate-800/80 pt-2">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[9px] font-black uppercase tracking-wider text-slate-400">Incoming Dispatch Simulator:</span>
              <span class="text-[9px] text-blue-400 font-bold">1-Tap Test</span>
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
              <button class="btn-quick-sim px-2.5 py-1 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 text-[10px] font-black rounded-lg border border-emerald-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="GROCERY">🛒 Grocery</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-orange-500/20 hover:bg-orange-500/30 text-orange-300 text-[10px] font-black rounded-lg border border-orange-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="FOOD">🍔 Food</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 text-[10px] font-black rounded-lg border border-teal-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="MEDICINE">💊 Medicine</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 text-[10px] font-black rounded-lg border border-indigo-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="PARCEL">📦 Parcel</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-[10px] rounded-lg border border-amber-300 shrink-0 transition-all active:scale-95 cursor-pointer shadow-sm shadow-amber-400/20" data-sim="PASSENGER">🛵 Passenger Ride</button>
            </div>
          </div>
        </div>

        <!-- STATE C: ACTIVE ROUTE & MULTI-ORDER HUD (INTELLIGENT SEQUENCER) -->
        <div id="state-active-route-card" class="hidden bg-slate-900/95 backdrop-blur-xl rounded-2xl p-4 border-2 border-blue-500 shadow-2xl space-y-3">
          
          <!-- Top Batch Header & Total Earning -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center gap-2">
              <span id="route-batch-badge" class="px-2.5 py-1 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-lg text-[10px] font-black uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
                <span id="route-batch-count-text">ACTIVE ROUTE (1 ORDER)</span>
              </span>
              <span id="route-batch-metrics" class="text-[10px] font-bold text-slate-400">
                2.4 km • 12 mins
              </span>
            </div>
            <span id="route-batch-total-earnings" class="text-xs font-black text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              Total: ₹45
            </span>
          </div>

          <!-- PROMINENT NEXT ACTION HUD -->
          <div class="bg-gradient-to-r from-blue-950/80 via-slate-900 to-indigo-950/80 p-3 rounded-xl border border-blue-500/40 shadow-inner space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[9px] font-black uppercase tracking-wider text-blue-300 bg-blue-500/20 px-2 py-0.5 rounded flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px] animate-spin">navigation</span>
                <span>IMMEDIATE NEXT ACTION</span>
              </span>
              <span id="next-action-payout-pill" class="text-[10px] font-black text-emerald-400">
                +₹45
              </span>
            </div>

            <div>
              <h3 id="next-action-title" class="text-sm font-black text-white leading-tight">
                NEXT: "Go to Saijeevan Super Shoppy"
              </h3>
              <p id="next-action-subtext" class="text-[11px] font-semibold text-slate-300 truncate mt-0.5">
                Pickup Grocery #BHU-1025 • Station Road, Bhusawal
              </p>
            </div>

            <!-- Customer Supplied Google Maps Location Link Option -->
            <div id="next-action-maps-link-container" class="hidden pt-1">
              <a 
                id="btn-next-action-maps-link" 
                href="#" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full py-2 px-3 bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 font-extrabold text-xs rounded-xl border border-emerald-500/30 flex items-center justify-center gap-1.5 transition-all shadow-xs"
              >
                <span class="material-symbols-outlined text-sm text-emerald-400">pin_drop</span>
                <span>Open in Google Maps</span>
                <span class="material-symbols-outlined text-xs">open_in_new</span>
              </a>
            </div>

            <!-- Two High-Contrast Action Buttons: 1-Tap Google Navigation & Confirm/Complete -->
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button id="btn-next-action-nav" class="py-2.5 bg-slate-800 hover:bg-slate-700 text-blue-300 font-black text-xs rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer shadow-sm">
                <span class="material-symbols-outlined text-sm text-blue-400">near_me</span>
                <span>🧭 NAVIGATE</span>
              </button>
              <button id="btn-next-action-advance" class="py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-black text-xs rounded-xl shadow-md shadow-blue-600/30 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
                <span id="btn-next-action-advance-text">Confirm Pickup</span>
                <span class="material-symbols-outlined text-sm">check_circle</span>
              </button>
            </div>
          </div>

          <!-- ACTIVE ROUTE SEQUENCED STOP LIST -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-wider text-slate-400 px-0.5">
              <span>ACTIVE ROUTE (INTELLIGENT SEQUENCE)</span>
              <span class="text-[9px] text-blue-400 font-semibold">Precedence & SLA Tuned</span>
            </div>

            <div id="container-active-route-stops" class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
              <!-- Dynamically populated by BslRiderHome via BslRouteSequencer.computeOptimalRoute() -->
            </div>
          </div>

          <!-- UTILITY ACTIONS: VIEW ALL ORDERS & VIEW OPTIMIZED ROUTE -->
          <div class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-800">
            <button id="btn-view-all-active-orders" class="py-2 px-2 bg-slate-800/90 hover:bg-slate-800 text-slate-200 text-[11px] font-extrabold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xs text-blue-400">receipt_long</span>
              <span>View All Tasks</span>
            </button>
            <button id="btn-view-optimized-route" class="py-2 px-2 bg-slate-800/90 hover:bg-slate-800 text-slate-200 text-[11px] font-extrabold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xs text-purple-400">route</span>
              <span>View Route</span>
            </button>
          </div>

          <!-- MULTI-ORDER SIMULATION TESTING CONTROLS (BACKEND GUARDED) -->
          <div class="bg-slate-950/70 p-2 rounded-xl border border-slate-800/80 space-y-1">
            <div class="flex items-center justify-between text-[9px] font-black uppercase tracking-wider text-slate-400">
              <span>Stack Compatible Orders:</span>
              <span class="text-emerald-400 font-bold">Max 3</span>
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
              <button class="btn-stack-sim px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 active:scale-95 cursor-pointer" data-stack="GROCERY">➕ Grocery</button>
              <button class="btn-stack-sim px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 active:scale-95 cursor-pointer" data-stack="FOOD">➕ Food</button>
              <button class="btn-stack-sim px-2 py-1 bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 text-[10px] font-bold rounded-lg border border-teal-500/30 shrink-0 active:scale-95 cursor-pointer" data-stack="MEDICINE">➕ Medicine</button>
              <button class="btn-stack-sim px-2 py-1 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 text-[10px] font-bold rounded-lg border border-indigo-500/30 shrink-0 active:scale-95 cursor-pointer" data-stack="PARCEL">➕ Parcel</button>
            </div>
          </div>

        </div>

        <!-- STATE D: PASSENGER ACTIVE STATE (RAPIDO / BIKE TAXI EXCLUSIVE) -->
        <div id="state-passenger-active-card" class="hidden bg-gradient-to-br from-amber-950 via-slate-900 to-amber-950 rounded-2xl p-4 border-2 border-amber-400 shadow-2xl space-y-3">
          
          <!-- Top Header: Dynamic Stage Badge & Fare -->
          <div class="flex items-center justify-between border-b border-amber-500/30 pb-2">
            <div class="flex items-center gap-1.5">
              <span id="badge-passenger-status" class="px-2.5 py-1 bg-amber-400 text-slate-950 rounded-lg text-[10px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">two_wheeler</span>
                <span id="text-passenger-stage-badge">PASSENGER PICKUP</span>
              </span>
            </div>
