---
// Bhusawal Connect - Rider Partner Home Screen & Live Fleet Dashboard
---

<!-- ==================== VIEW 5: FULL RIDER DASHBOARD (MAP-FIRST LIVE INTERFACE) ==================== -->
<section id="view-dashboard" class="hidden fixed inset-0 w-full h-[100dvh] flex flex-col bg-slate-950 overflow-hidden z-40">
  
  <!-- MAIN TABS CONTAINER -->
  <div class="relative w-full flex-1 overflow-hidden">

    <!-- ==================== TAB 1: HOME (MAP-FIRST LIVE VIEW) ==================== -->
    <div id="tab-content-home" class="tab-page absolute inset-0 w-full h-full flex flex-col overflow-hidden">
      
      <!-- 1. LIVE BHUSAWAL LEAFLET MAP CANVAS -->
      <div id="rider-live-map" class="absolute inset-0 w-full h-full z-0 bg-slate-900"></div>

      <!-- 2. TOP FLOATING AREA -->
      <div class="relative z-20 mx-3 mt-3 max-w-md w-[calc(100%-1.5rem)] self-center pointer-events-auto">
        <div class="bg-slate-900/90 backdrop-blur-md rounded-2xl p-3 border border-slate-700/70 shadow-2xl space-y-2.5">
          
          <div class="flex items-center justify-between">
            <!-- Brand logo & Captain Title -->
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center font-black shadow-md shadow-blue-500/30">
                <span class="material-symbols-outlined text-xl">two_wheeler</span>
              </div>
              <div>
                <h1 class="text-sm font-black text-white leading-tight tracking-tight flex items-center gap-1.5">
                  <span>BSL Connect</span>
                  <span class="px-1.5 py-0.5 bg-blue-500/20 text-blue-300 text-[9px] font-black rounded uppercase border border-blue-500/30">CAPTAIN</span>
                </h1>
                <p class="text-[10px] font-semibold text-slate-400">Bhusawal Shared Fleet</p>
              </div>
            </div>

            <!-- Right Header Actions: Notification Bell + Profile Avatar -->
            <div class="flex items-center gap-2">
              <button id="btn-top-notif" class="relative w-9 h-9 rounded-xl bg-slate-800 text-slate-300 hover:text-white border border-slate-700 flex items-center justify-center transition-colors active:scale-95 cursor-pointer" title="Alerts">
                <span class="material-symbols-outlined text-lg">notifications</span>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
              </button>
              <button id="btn-top-profile" class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-extrabold text-xs flex items-center justify-center border border-blue-400/30 shadow-sm active:scale-95 cursor-pointer" title="Profile">
                <span id="top-avatar-initials">RP</span>
              </button>
            </div>
          </div>

          <!-- PROMINENT ON DUTY / OFF DUTY CONTROL -->
          <div class="border-t border-slate-800/80 pt-2 flex items-center justify-between gap-2">
            <div class="min-w-0 flex-1">
              <p id="duty-banner-headline" class="text-xs font-black text-white truncate">You're available for orders.</p>
              <p id="duty-banner-subtext" class="text-[10px] font-medium text-slate-400 truncate">Receiving Grocery, Food, Medicine & Rides</p>
            </div>
            <button
              id="btn-toggle-duty"
              class="shrink-0 px-3.5 py-2 rounded-xl font-black text-xs flex items-center gap-1.5 shadow-md transition-all active:scale-95 cursor-pointer bg-emerald-500 hover:bg-emerald-600 text-slate-950 shadow-emerald-500/20"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-slate-950 animate-pulse" id="duty-btn-dot"></span>
              <span id="btn-duty-text">🟢 ON DUTY</span>
            </button>
          </div>

        </div>
      </div>

      <!-- 3. HOME SUMMARY HUD (Today's Earnings, Completed, Distance, Online Time) -->
      <div class="relative z-20 mx-3 mt-2 max-w-md w-[calc(100%-1.5rem)] self-center pointer-events-auto">
        <div class="bg-slate-900/85 backdrop-blur-md rounded-xl p-2.5 border border-slate-800 shadow-xl grid grid-cols-4 gap-1 text-center">
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Earnings</span>
            <span id="summary-today-earnings" class="text-sm font-black text-emerald-400 font-display">₹640</span>
          </div>
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Orders</span>
            <span id="summary-today-orders" class="text-sm font-black text-white">6</span>
          </div>
          <div class="px-1 border-r border-slate-800">
            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Distance</span>
            <span id="summary-today-dist" class="text-sm font-black text-blue-400">18.4 km</span>
          </div>
          <div class="px-1">
            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Online</span>
            <span id="summary-today-time" class="text-sm font-black text-purple-400">4.2h</span>
          </div>
        </div>
      </div>

      <!-- 4. FLOATING MAP UTILITY CONTROLS (Accuracy Badge, Follow/Recenter, Hotspots, Zoom In/Out) -->
      <!-- Left: GPS Accuracy & Connection Status Pill -->
      <div id="badge-gps-accuracy" class="absolute left-3 top-44 z-20 pointer-events-auto">
        <button id="btn-gps-accuracy-info" title="GPS Status & Accuracy (Click to refresh)" class="px-2.5 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md text-white border border-slate-700/80 shadow-xl flex items-center gap-1.5 text-[11px] font-black hover:bg-slate-800 transition-all cursor-pointer">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" id="gps-status-dot"></span>
          <span id="gps-accuracy-text">GPS: ±8m</span>
        </button>
      </div>

      <!-- Right: Touch-Friendly Map Controls Cluster -->
      <div class="absolute right-3 top-44 z-20 flex flex-col gap-2 pointer-events-auto">
        <!-- Recenter / Auto-Follow Toggle -->
        <button id="btn-map-recenter" title="Auto-Follow Rider / Recenter Map" class="w-10 h-10 rounded-xl bg-slate-900/90 text-blue-400 border-2 border-blue-500 shadow-xl flex items-center justify-center hover:bg-slate-800 active:scale-95 transition-all cursor-pointer relative">
          <span class="material-symbols-outlined text-lg">my_location</span>
          <span id="recenter-follow-indicator" class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-blue-500 ring-2 ring-slate-900 animate-ping"></span>
        </button>

        <!-- Demand Hotspots Toggle -->
        <button id="btn-map-hotspots" title="Toggle Demand Hotspots" class="w-10 h-10 rounded-xl bg-slate-900/90 text-amber-400 border border-slate-700/80 shadow-xl flex items-center justify-center hover:bg-slate-800 active:scale-95 transition-all cursor-pointer">
          <span class="material-symbols-outlined text-lg">local_fire_department</span>
        </button>

        <!-- Ergonomic Thumb Zoom Controls -->
        <div class="flex flex-col rounded-xl bg-slate-900/90 border border-slate-700/80 shadow-xl overflow-hidden">
          <button id="btn-map-zoom-in" title="Zoom In" class="w-10 h-9 text-slate-200 hover:text-white hover:bg-slate-800 flex items-center justify-center border-b border-slate-800 active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">add</span>
          </button>
          <button id="btn-map-zoom-out" title="Zoom Out" class="w-10 h-9 text-slate-200 hover:text-white hover:bg-slate-800 flex items-center justify-center active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">remove</span>
          </button>
        </div>
      </div>

      <!-- 5. DYNAMIC HOME STATE DRAWER (Floats over map above bottom nav) -->
      <div class="absolute bottom-20 left-3 right-3 z-20 max-w-md mx-auto pointer-events-auto">
        
        <!-- STATE A: OFFLINE STATE -->
        <div id="state-offline-card" class="hidden bg-slate-900/95 backdrop-blur-md rounded-2xl p-4 border border-slate-700 shadow-2xl space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center">
              <span class="material-symbols-outlined text-2xl">bedtime</span>
            </div>
            <div>
              <h3 class="text-sm font-black text-white">You're offline</h3>
              <p class="text-[11px] font-semibold text-slate-400 leading-snug">You won't receive new delivery or ride requests.</p>
            </div>
          </div>
          <button id="btn-go-online-cta" class="w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-black text-sm rounded-xl shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 active:scale-95 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-base">bolt</span>
            <span>GO ON DUTY NOW</span>
          </button>
        </div>

        <!-- STATE B: AVAILABLE STATE (LOOKING FOR ORDERS) -->
        <div id="state-available-card" class="bg-slate-900/95 backdrop-blur-md rounded-2xl p-4 border border-slate-700 shadow-2xl space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
              </span>
              <div>
                <h3 class="text-sm font-black text-white">You're online</h3>
                <p class="text-[11px] font-bold text-emerald-400">Looking for nearby orders...</p>
              </div>
            </div>
            <span class="text-[10px] font-extrabold text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md border border-slate-700">
              ⚡ Station Road Surge
            </span>
          </div>

          <!-- Radar Simulation Ticker -->
          <div class="bg-slate-950/70 p-2.5 rounded-xl border border-slate-800/80 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2 text-slate-300">
              <span class="material-symbols-outlined text-blue-400 text-sm animate-spin">sync</span>
              <span class="text-[11px] font-bold">Scanning 3 km radius in Bhusawal</span>
            </div>
            <span class="text-[10px] font-extrabold text-blue-300 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20">6 verticals</span>
          </div>

          <!-- Quick Simulation Chips Bar (To test each state easily) -->
          <div class="border-t border-slate-800/80 pt-2">
            <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Simulate Incoming Request:</p>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
              <button class="btn-quick-sim px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="GROCERY">🛒 Grocery</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="FOOD">🍔 Food</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-[10px] font-bold rounded-lg border border-rose-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="MEDICINE">💊 Medicine</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 text-[10px] font-bold rounded-lg border border-indigo-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="PARCEL">📦 Parcel</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 text-[10px] font-bold rounded-lg border border-cyan-500/30 shrink-0 transition-all active:scale-95 cursor-pointer" data-sim="PICKUP_DROP">🔄 Pickup & Drop</button>
              <button class="btn-quick-sim px-2.5 py-1 bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-[10px] rounded-lg border border-amber-300 shrink-0 transition-all active:scale-95 cursor-pointer shadow-sm shadow-amber-400/20" data-sim="PASSENGER">🛵 Passenger Ride</button>
            </div>
          </div>
        </div>

                <!-- STATE C: ACTIVE ROUTE & MULTI-ORDER HUD (INTELLIGENT SEQUENCER) -->
        <div id="state-active-route-card" class="hidden bg-slate-900/95 backdrop-blur-md rounded-2xl p-3.5 border-2 border-blue-500 shadow-2xl space-y-3">
          
          <!-- Top Batch Header & Total Earning -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center gap-2">
              <span id="route-batch-badge" class="px-2 py-0.5 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-md text-[10px] font-black uppercase tracking-wider flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
                <span id="route-batch-count-text">ACTIVE ROUTE (1 ORDER)</span>
              </span>
              <span id="route-batch-metrics" class="text-[10px] font-bold text-slate-400">
                2.4 km • 12 mins
              </span>
            </div>
            <span id="route-batch-total-earnings" class="text-xs font-black text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              Total: ₹45
            </span>
          </div>

          <!-- PROMINENT NEXT ACTION HUD -->
          <div class="bg-gradient-to-r from-blue-950/80 via-slate-900 to-indigo-950/80 p-3 rounded-xl border border-blue-500/40 shadow-inner space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[9px] font-black uppercase tracking-wider text-blue-300 bg-blue-500/20 px-2 py-0.5 rounded flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px] animate-spin">navigation</span>
                <span>IMMEDIATE NEXT ACTION</span>
              </span>
              <span id="next-action-payout-pill" class="text-[10px] font-black text-emerald-400">
                +₹45
              </span>
            </div>

            <div>
              <h3 id="next-action-title" class="text-sm font-black text-white leading-tight">
                NEXT: "Go to Saijeevan Super Shoppy"
              </h3>
              <p id="next-action-subtext" class="text-[11px] font-semibold text-slate-300 truncate mt-0.5">
                Pickup Grocery #BHU-1025 • Station Road, Bhusawal
              </p>
            </div>

            <!-- Two High-Contrast Action Buttons: 1-Tap Google Navigation & Confirm/Complete -->
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button id="btn-next-action-nav" class="py-2.5 bg-slate-800 hover:bg-slate-700 text-blue-300 font-black text-xs rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer shadow-sm">
                <span class="material-symbols-outlined text-sm text-blue-400">near_me</span>
                <span>🧭 NAVIGATE</span>
              </button>
              <button id="btn-next-action-advance" class="py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-black text-xs rounded-xl shadow-md shadow-blue-600/30 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
                <span id="btn-next-action-advance-text">Confirm Pickup</span>
                <span class="material-symbols-outlined text-sm">check_circle</span>
              </button>
            </div>
          </div>

          <!-- ACTIVE ROUTE SEQUENCED STOP LIST -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-wider text-slate-400 px-0.5">
              <span>ACTIVE ROUTE (INTELLIGENT SEQUENCE)</span>
              <span class="text-[9px] text-blue-400 font-semibold">Precedence & SLA Tuned</span>
            </div>

            <div id="container-active-route-stops" class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
              <!-- Dynamically populated by BslRiderHome via BslRouteSequencer.computeOptimalRoute() -->
            </div>
          </div>

          <!-- UTILITY ACTIONS: VIEW ALL ORDERS & VIEW OPTIMIZED ROUTE -->
          <div class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-800">
            <button id="btn-view-all-active-orders" class="py-2 px-2 bg-slate-800/90 hover:bg-slate-800 text-slate-200 text-[11px] font-extrabold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xs text-blue-400">receipt_long</span>
              <span>View all active orders</span>
            </button>
            <button id="btn-view-optimized-route" class="py-2 px-2 bg-slate-800/90 hover:bg-slate-800 text-slate-200 text-[11px] font-extrabold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xs text-purple-400">route</span>
              <span>View optimized route</span>
            </button>
          </div>

          <!-- MULTI-ORDER SIMULATION TESTING CONTROLS (BACKEND GUARDED) -->
          <div class="bg-slate-950/70 p-2 rounded-xl border border-slate-800/80 space-y-1">
            <div class="flex items-center justify-between text-[9px] font-black uppercase tracking-wider text-slate-400">
              <span>Add to Route (Backend Guarded):</span>
              <span class="text-emerald-400 font-bold">Max 3</span>
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
              <button class="btn-stack-sim px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 active:scale-95 cursor-pointer" data-stack="GROCERY">➕ Grocery</button>
              <button class="btn-stack-sim px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-bold rounded-lg border border-slate-700 shrink-0 active:scale-95 cursor-pointer" data-stack="FOOD">➕ Food</button>
              <button class="btn-stack-sim px-2 py-1 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-[10px] font-bold rounded-lg border border-rose-500/30 shrink-0 active:scale-95 cursor-pointer" data-stack="MEDICINE">➕ Medicine</button>
              <button class="btn-stack-sim px-2 py-1 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 text-[10px] font-bold rounded-lg border border-indigo-500/30 shrink-0 active:scale-95 cursor-pointer" data-stack="PARCEL">➕ Parcel</button>
            </div>
          </div>

        </div>

        <!-- STATE D: PASSENGER ACTIVE STATE (RAPIDO / BIKE TAXI EXCLUSIVE) -->
        <div id="state-passenger-active-card" class="hidden bg-gradient-to-br from-amber-950 via-slate-900 to-amber-950 rounded-2xl p-4 border-2 border-amber-400 shadow-2xl space-y-3">
          
          <!-- Top Header: Dynamic Stage Badge & Fare -->
          <div class="flex items-center justify-between border-b border-amber-500/30 pb-2">
            <div class="flex items-center gap-1.5">
              <span id="badge-passenger-status" class="px-2.5 py-1 bg-amber-400 text-slate-950 rounded-lg text-[10px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">two_wheeler</span>
                <span id="text-passenger-stage-badge">PASSENGER PICKUP</span>
              </span>
            </div>
            <span id="card-passenger-fare" class="text-xs font-black text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/30">
              Fare: ₹55
            </span>
          </div>

          <!-- MANDATORY SERVER-ENFORCED EXCLUSIVITY NOTICE -->
          <div class="bg-amber-400/20 border-2 border-amber-400/50 rounded-xl p-2.5 flex items-center gap-2.5 text-amber-200 text-xs font-black shadow-inner">
            <span class="material-symbols-outlined text-amber-400 text-xl shrink-0 animate-pulse">lock</span>
            <div>
              <span class="text-white block font-black uppercase tracking-wider text-[11px]">🔒 PASSENGER MODE</span>
              <span class="text-amber-200/90 text-[10px] font-bold block">Other orders are paused while you have a passenger.</span>
            </div>
          </div>

          <!-- Passenger Details & Contact -->
          <div class="bg-slate-950/80 p-3 rounded-xl border border-amber-500/20 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <div>
                <h4 id="card-passenger-name" class="font-black text-white text-xs">Amit Sharma</h4>
                <span class="text-[10px] font-bold text-amber-400 flex items-center gap-1 mt-0.5">
                  <span>★ 4.9 Verified Passenger</span>
                  <span class="text-slate-500">•</span>
                  <span class="text-slate-400">Helmet Mandatory</span>
                </span>
              </div>
              <a id="card-passenger-call" href="tel:9876543210" class="px-3 py-1.5 bg-amber-400 hover:bg-amber-300 text-slate-950 rounded-xl text-xs font-black flex items-center gap-1 shadow-sm active:scale-95 transition-all">
                <span class="material-symbols-outlined text-sm">call</span>
                <span>Call Passenger</span>
              </a>
            </div>

            <!-- Locations (Pickup & Destination) -->
            <div class="space-y-1.5 pt-1 border-t border-slate-800">
              <div id="box-passenger-pickup" class="p-2 bg-slate-900/90 rounded-lg border border-slate-800 flex items-start gap-2">
                <span class="material-symbols-outlined text-amber-400 text-base shrink-0 mt-0.5">near_me</span>
                <div class="min-w-0 flex-1">
                  <span class="text-[9px] font-bold text-slate-400 uppercase block">Pickup Point</span>
                  <span id="card-passenger-pickup" class="font-bold text-white text-[11px] block truncate">Bhusawal Railway Station (Platform 1 Exit)</span>
                </div>
              </div>

              <div id="box-passenger-drop" class="p-2 bg-slate-900/90 rounded-lg border border-slate-800 flex items-start gap-2">
                <span class="material-symbols-outlined text-blue-400 text-base shrink-0 mt-0.5">flag</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="text-[9px] font-bold text-slate-400 uppercase block">Destination Drop</span>
                    <span id="card-passenger-metrics" class="text-[10px] font-bold text-slate-400">3.8 km • ~12 mins</span>
                  </div>
                  <span id="card-passenger-drop-landmark" class="font-bold text-white text-[11px] block truncate">Jamner Road Municipal Shopping Complex</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Passenger Stage Actions: 1-Tap Nav & SOS -->
          <div class="grid grid-cols-2 gap-2">
            <button id="btn-card-passenger-nav" class="py-2.5 bg-slate-800 hover:bg-slate-700 text-blue-300 font-black text-xs rounded-xl border border-slate-700 flex items-center justify-center gap-1 active:scale-95 transition-all cursor-pointer">
              <span class="material-symbols-outlined text-sm text-blue-400">navigation</span>
              <span id="btn-card-passenger-nav-text">🧭 Navigate to Pickup</span>
            </button>
            <button id="btn-card-passenger-sos" class="py-2.5 bg-rose-950 hover:bg-rose-900 text-rose-300 font-black text-xs rounded-xl border border-rose-500/40 flex items-center justify-center gap-1 active:scale-95 cursor-pointer">
              <span class="material-symbols-outlined text-sm">emergency</span>
