---
import { getProductById } from '../utils/productLookup';

const searchId = Astro.url.searchParams.get('id') || 
                 Astro.url.searchParams.get('productId') || 
                 Astro.url.searchParams.get('sku') || 
                 Astro.url.searchParams.get('product') || 
                 Astro.url.searchParams.get('item') || '';

const cleanUrlId = (searchId || '').trim();
const foundItem = getProductById(cleanUrlId);
const canonicalId = foundItem ? (foundItem["Product ID"] || foundItem.id || foundItem.sku || foundItem.ProductID || cleanUrlId) : cleanUrlId;

const targetRedirect = canonicalId ? `/product/${encodeURIComponent(canonicalId)}` : '/grocery';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0;url=${targetRedirect}`} />
  <script is:inline define:vars={{ targetRedirect }}>
    // Immediate client-side redirect to canonical product URL format: /product/{id}
    window.location.replace(targetRedirect);
  </script>
  <title>Redirecting to Canonical Product Page...</title>
</head>
<body class="bg-slate-50 font-sans flex items-center justify-center min-h-screen">
  <div class="text-center p-8 bg-white rounded-3xl shadow-sm border border-slate-100 max-w-sm">
    <div class="w-12 h-12 border-4 border-green-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
    <h2 class="text-base font-black text-slate-900">Redirecting to Canonical Product...</h2>
    <p class="text-xs text-slate-500 mt-1">Bhusawal Connect Canonical Product Routing</p>
  </div>
</body>
</html>
