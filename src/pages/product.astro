---
import Switcher from '../components/Switcher.astro';
import groceryCatalog from '../../public/grocery_catalog.json';
import foodCatalog from '../../public/food_catalog.json';

const urlName = Astro.url.searchParams.get('name') || '';
const urlId = Astro.url.searchParams.get('id') || '';

// First check if product is in Food Catalog
let foodItem = foodCatalog.find(p => p.id === urlId || (urlName && p.name.toLowerCase() === urlName.toLowerCase()));
let groceryItem = !foodItem ? groceryCatalog.find(p => 
  (urlId && (p.ProductID === urlId || p.id === urlId || p["Product ID"] === urlId)) ||
  (urlName && (p["Product Name"] || '').toLowerCase() === urlName.toLowerCase()) ||
  (urlName && (p["Product Name"] || '').toLowerCase().includes(urlName.toLowerCase()))
) : null;

// Determine if Food product or Grocery product
const isFood = !!foodItem || urlId.startsWith('bc_food_');
const productData = foodItem || groceryItem || foodCatalog[0];

// Standardized Fields
const id = productData.id || productData["Product ID"] || productData.ProductID || 'BC-001';
const name = productData.name || productData["Product Name"] || 'Product Details';
const category = productData.category || productData.Category || 'Food & Dining';
const price = parseFloat(productData.price || productData.MRP || productData["Selling Price"] || 100);
const mrp = price;
const rating = productData.rating || '4.8';
const isVeg = productData.isVeg !== undefined ? productData.isVeg : (category === 'Fruits & Vegetables' || !name.toLowerCase().includes('chicken'));
const prepTime = productData.prepTime || '15-20 min';
const description = productData.description || 'Authentic dish prepared fresh with high quality ingredients and traditional Bhusawal spices.';

// Food Ingredients Helper
function getIngredients(itemName: string, catName: string) {
  const n = itemName.toLowerCase();
  if (n.includes('poha')) return ['Flattened Rice', 'Mustard Seeds', 'Curry Leaves', 'Roasted Peanuts', 'Green Chillies', 'Lemon', 'Nylon Sev'];
  if (n.includes('pizza')) return ['Mozzarella Cheese', 'Hand Tossed Crust', 'Tomato Basil Sauce', 'Capsicum', 'Onions', 'Italian Herbs'];
  if (n.includes('burger')) return ['Soft Bun', 'Crispy Patty', 'Amul Cheese', 'Lettuce', 'Tomatoes', 'House Mayo'];
  if (n.includes('biryani')) return ['Basmati Rice', 'Pure Ghee', 'Saffron', 'Mint Leaves', 'Fried Onions', 'Indian Whole Spices'];
  if (n.includes('paneer')) return ['Fresh Cottage Cheese', 'Butter', 'Cashew Cream', 'Tomato Gravy', 'Kasturi Methi', 'Garam Masala'];
  if (n.includes('chicken')) return ['Tender Chicken', 'Ghee', 'Ginger Garlic Paste', 'Onion Gravy', 'Khandeshi Spices', 'Coriander'];
  if (n.includes('chai') || n.includes('tea')) return ['Fresh Milk', 'Assam Tea Leaves', 'Crushed Ginger', 'Cardamom', 'Tulsi'];
  if (n.includes('coffee')) return ['Espresso Shot', 'Chilled Whole Milk', 'Cocoa Powder', 'Vanilla Scoop', 'Sugar'];
  return ['Fresh Local Produce', 'Pure Cow Ghee', 'Authentic Indian Spices', 'Natural Herbs'];
}

const ingredients = getIngredients(name, category);

// Main Image & Gallery Array
const mainImg = productData.image || productData["Product Image URL"] || productData.img || 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80';
const galleryImages = [
  mainImg,
  'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80',
  'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
  'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80'
];

// Recommended Items (Same Category)
const recommendedItems = isFood 
  ? foodCatalog.filter(x => x.category === category && x.id !== id).slice(0, 6)
  : groceryCatalog.filter(x => (x.Category || '') === category && (x["Product Name"] || '') !== name).slice(0, 6);

// Frequently Bought Together Items
const fbt1 = isFood ? foodCatalog.find(x => x.category === 'Beverages') || foodCatalog[10] : groceryCatalog[1];
const fbt2 = isFood ? foodCatalog.find(x => x.category === 'Desserts' || x.category === 'Snacks') || foodCatalog[15] : groceryCatalog[2];
const fbtTotalPrice = price + parseFloat(fbt1?.price || fbt1?.MRP || 40) + parseFloat(fbt2?.price || fbt2?.MRP || 60);
const fbtBundlePrice = Math.round(fbtTotalPrice * 0.9);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name} | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- BRAND THEME TAILWIND CONFIGURATION -->
  <script is:inline define:vars={{ isFood }}>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandPrimary: isFood ? '#E53935' : '#7c3aed',
            brandDark: isFood ? '#C62828' : '#6d28d9',
            brandLight: isFood ? '#FFEBEE' : '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP STICKY HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href={isFood ? '/food' : '/grocery'} class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class={`text-lg font-black font-display tracking-tight ${isFood ? 'text-redBrand' : 'text-purpleBrand'}`}>
          bhusawal<span class="text-slate-900">connect</span>
        </span>
      </a>
    </div>

    <!-- Express Delivery Badge & Global Cart Icon -->
    <div class="flex items-center gap-3">
      <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1 ${isFood ? 'bg-redLight text-redBrand' : 'bg-purpleLight text-purpleBrand'}`}>
        <span class="material-symbols-outlined text-sm">bolt</span>
        {isFood ? '20 MIN EXPRESS FOOD DELIVERY' : '10 MIN EXPRESS GROCERY'}
      </span>

      <a href="/cart" class={`relative w-10 h-10 rounded-full text-white flex items-center justify-center font-bold shadow-md ${isFood ? 'bg-redBrand hover:bg-redDark' : 'bg-purpleBrand hover:bg-purpleDark'}`}>
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="pdp-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>
  </header>

  <!-- MAIN PRODUCT DETAILS CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

    <!-- BREADCRUMB -->
    <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
      <a href="/home" class="hover:text-slate-600">Home</a>
      <span>/</span>
      <a href={isFood ? '/food' : '/grocery'} class="hover:text-slate-600">{isFood ? 'Food Delivery' : 'Grocery'}</a>
      <span>/</span>
      <span class="text-slate-800 font-extrabold truncate max-w-xs">{name}</span>
    </div>

    <!-- MAIN PRODUCT TWO-COLUMN GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT COLUMN: LARGE GALLERY WITH THUMBNAIL PREVIEWS (LG: 5 COLS) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Large Main Image Container -->
        <div class="w-full aspect-square bg-white rounded-3xl p-4 border border-slate-100 shadow-sm relative overflow-hidden flex items-center justify-center group">
          
          <!-- Veg / Non-Veg Badge -->
          <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-black flex items-center gap-1.5 shadow-sm border border-slate-200 z-10">
            <span class={`w-2.5 h-2.5 rounded-full shrink-0 ${isVeg ? 'bg-emerald-600' : 'bg-rose-600'}`}></span>
            <span class={isVeg ? 'text-emerald-700' : 'text-rose-700'}>{isVeg ? 'PURE VEG' : 'NON-VEG'}</span>
          </div>

          <!-- Customer Rating Badge -->
          <div class="absolute top-4 right-4 bg-amber-50 text-amber-800 border border-amber-200 px-3 py-1 rounded-full text-xs font-black flex items-center gap-1 shadow-sm z-10">
            <span>⭐</span>
            <span>{rating} (128 reviews)</span>
          </div>

          <!-- Interactive Favourite Heart Button -->
          <button 
            id="pdp-fav-btn"
            class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-white/95 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 active:scale-90 transition-all z-10 shadow-sm"
            onclick="this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';"
          >
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
          </button>

          <!-- Main Image -->
          <img 
            id="pdp-main-image"
            src={mainImg} 
            alt={name} 
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';"
          />
        </div>

        <!-- Thumbnail Gallery Bar -->
        <div class="flex items-center gap-3 overflow-x-auto no-scrollbar py-1">
          {galleryImages.map((imgUrl, idx) => (
            <button 
              class={`pdp-thumb-btn w-16 h-16 rounded-2xl border-2 p-1 bg-white overflow-hidden shrink-0 transition-all ${idx === 0 ? (isFood ? 'border-redBrand' : 'border-purpleBrand') : 'border-slate-100 hover:border-slate-300'}`}
              onclick={`document.getElementById('pdp-main-image').src='${imgUrl}'; document.querySelectorAll('.pdp-thumb-btn').forEach(b => b.classList.remove('border-redBrand', 'border-purpleBrand')); this.classList.add('${isFood ? 'border-redBrand' : 'border-purpleBrand'}');`}
            >
              <img src={imgUrl} class="w-full h-full object-cover rounded-xl" alt="Gallery thumbnail" />
            </button>
          ))}
        </div>

      </div>

      <!-- RIGHT COLUMN: PRODUCT METADATA & ACTIONS (LG: 7 COLS) -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm space-y-5">
          
          <!-- Category & Prep Time -->
          <div class="flex items-center justify-between gap-2">
            <span class={`text-xs font-black uppercase tracking-wider ${isFood ? 'text-redBrand' : 'text-purpleBrand'}`}>
              {category}
            </span>
            <span class="text-xs font-extrabold text-slate-700 bg-slate-100 px-3 py-1 rounded-full flex items-center gap-1">
              ⏱️ Prep Time: {prepTime}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900 leading-tight">
            {name}
          </h1>

          <!-- Price & Discount -->
          <div class="flex items-baseline gap-3 pt-1 border-t border-slate-100">
            <span class="text-3xl sm:text-4xl font-black font-display text-slate-900">₹{price}</span>
            <span class="text-xs font-bold text-slate-400">Inclusive of all taxes</span>
          </div>

          <!-- Description -->
          <div class="space-y-1.5 pt-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Description</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
              {description}
            </p>
          </div>

          <!-- Ingredients Chips Section -->
          <div class="space-y-2 pt-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Key Ingredients</h3>
            <div class="flex flex-wrap gap-1.5">
              {ingredients.map(ing => (
                <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-xl border border-slate-200/80">
                  {ing}
                </span>
              ))}
            </div>
          </div>

          <!-- ADD TO CART & QUANTITY ACTION BOX -->
          <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            
            <!-- Quantity Stepper -->
            <div class={`flex items-center justify-between border rounded-2xl p-1 shadow-xs ${isFood ? 'bg-redLight border-red-200' : 'bg-purpleLight border-purple-200'}`}>
              <button id="pdp-qty-minus" class={`w-10 h-10 rounded-xl bg-white flex items-center justify-center font-black active:scale-90 transition-all ${isFood ? 'text-redBrand' : 'text-purpleBrand'}`}>
                -
              </button>
              <span id="pdp-qty-num" class={`px-4 text-sm font-black min-w-[32px] text-center ${isFood ? 'text-redBrand' : 'text-purpleBrand'}`}>1</span>
              <button id="pdp-qty-plus" class={`w-10 h-10 rounded-xl bg-white flex items-center justify-center font-black active:scale-90 transition-all ${isFood ? 'text-redBrand' : 'text-purpleBrand'}`}>
                +
              </button>
            </div>

            <!-- Add to Cart Button -->
            <button 
              id="pdp-add-to-cart-btn"
              class={`flex-1 py-4 text-white font-black text-sm rounded-2xl shadow-xl active:scale-95 transition-all flex items-center justify-center gap-2 ${isFood ? 'bg-redBrand hover:bg-redDark shadow-red-900/15' : 'bg-purpleBrand hover:bg-purpleDark shadow-purple-900/15'}`}
            >
              <span class="material-symbols-outlined text-lg">shopping_bag</span>
              <span>ADD TO CART • ₹{price}</span>
            </button>

          </div>

        </div>

        <!-- FREQUENTLY BOUGHT TOGETHER BUNDLE SECTION -->
        {fbt1 && fbt2 && (
          <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
            <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span>💡 Frequently Bought Together</span>
            </h3>

            <div class="grid grid-cols-3 gap-3 items-center">
              <div class="text-center space-y-1">
                <img src={mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
                <p class="text-[10px] font-bold text-slate-800 truncate">{name}</p>
                <p class="text-xs font-black">₹{price}</p>
              </div>

              <div class="text-center space-y-1">
                <img src={fbt1.image || fbt1["Product Image URL"] || mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
                <p class="text-[10px] font-bold text-slate-800 truncate">{fbt1.name || fbt1["Product Name"]}</p>
                <p class="text-xs font-black">₹{fbt1.price || fbt1.MRP}</p>
              </div>

              <div class="text-center space-y-1">
                <img src={fbt2.image || fbt2["Product Image URL"] || mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
                <p class="text-[10px] font-bold text-slate-800 truncate">{fbt2.name || fbt2["Product Name"]}</p>
                <p class="text-xs font-black">₹{fbt2.price || fbt2.MRP}</p>
              </div>
            </div>

            <button 
              id="pdp-add-bundle-btn"
              class={`w-full py-3 text-xs font-black rounded-xl border transition-all flex items-center justify-center gap-1 ${isFood ? 'bg-redLight text-redBrand border-red-200 hover:bg-redBrand hover:text-white' : 'bg-purpleLight text-purpleBrand border-purple-200 hover:bg-purpleBrand hover:text-white'}`}
            >
              <span>Add Combo Bundle for ₹{fbtBundlePrice}</span>
              <span class="line-through text-[10px] opacity-70">₹{fbtTotalPrice}</span>
            </button>
          </div>
        )}

      </div>

    </div>

    <!-- RECOMMENDED FOOD SECTION -->
    {recommendedItems.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-slate-200/60">
        <div class="flex items-center justify-between">
          <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 flex items-center gap-2">
            <span>🍽️ Recommended Food Items</span>
          </h2>
          <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Scroll →</span>
        </div>

        <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2">
          {recommendedItems.map(rec => (
            <div 
              class="w-48 sm:w-56 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-lg transition-all cursor-pointer group"
              onclick={`window.location.href='/product?id=${rec.id || rec["Product ID"]}';`}
            >
              <div>
                <div class="w-full aspect-square bg-slate-50 rounded-2xl p-2 mb-2 flex items-center justify-center overflow-hidden">
                  <img src={rec.image || rec["Product Image URL"]} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
                </div>
                <h3 class="text-xs font-extrabold text-slate-900 line-clamp-2 min-h-[2.2rem]">{rec.name || rec["Product Name"]}</h3>
              </div>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between mt-2">
                <span class="text-sm font-black text-slate-900">₹{rec.price || rec.MRP}</span>
                <span class={`text-[10px] font-black px-2.5 py-1 rounded-xl ${isFood ? 'bg-redLight text-redBrand' : 'bg-purpleLight text-purpleBrand'}`}>VIEW</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <Switcher />

  <!-- Dynamic Client Script for Cart Sync & Stepper Controls -->
  <script is:inline define:vars={{ id, name, price, mainImg, category, isFood }}>
    (function() {
      var currentQty = 1;

      function getCart() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {
          return [];
        }
      }

      function saveCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateBadge();
      }

      function updateBadge() {
        var cart = getCart();
        var total = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        var badge = document.getElementById('pdp-cart-badge');
        if (badge) badge.textContent = total;
      }

      // Quantity controls
      document.getElementById('pdp-qty-plus')?.addEventListener('click', function() {
        currentQty++;
        document.getElementById('pdp-qty-num').textContent = currentQty;
      });

      document.getElementById('pdp-qty-minus')?.addEventListener('click', function() {
        if (currentQty > 1) {
          currentQty--;
          document.getElementById('pdp-qty-num').textContent = currentQty;
        }
      });

      // Add to Cart Main Button
      document.getElementById('pdp-add-to-cart-btn')?.addEventListener('click', function() {
        var cart = getCart();
        var existing = cart.find(function(c) { return c.id === id; });
        if (existing) {
          existing.quantity = (existing.quantity || 1) + currentQty;
        } else {
          cart.push({
            id: id,
            name: name,
            price: price,
            mrp: price,
            image: mainImg,
            quantity: currentQty,
            restaurant: isFood ? 'Bhusawal Food Express' : 'Bhusawal Connect Store',
            cat: category
          });
        }
        saveCart(cart);
        alert(name + ' added to your cart!');
      });

      updateBadge();
    })();
  </script>

</body>
</html>
