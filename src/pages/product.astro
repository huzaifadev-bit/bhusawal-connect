---
import Switcher from '../components/Switcher.astro';
import groceryCatalog from '../../public/grocery_catalog.json';
import foodCatalog from '../../public/food_catalog.json';

const urlName = Astro.url.searchParams.get('name') || '';
const urlId = Astro.url.searchParams.get('id') || '';

// Server fallback
let foodItem = foodCatalog.find(p => p.id === urlId || (urlName && p.name.toLowerCase() === urlName.toLowerCase()));
let groceryItem = !foodItem ? groceryCatalog.find(p => 
  (urlId && (p.ProductID === urlId || p.id === urlId || p["Product ID"] === urlId)) ||
  (urlName && (p["Product Name"] || '').toLowerCase() === urlName.toLowerCase()) ||
  (urlName && (p["Product Name"] || '').toLowerCase().includes(urlName.toLowerCase()))
) : null;

const isFood = !!foodItem || urlId.startsWith('bc_food_');
const productData = foodItem || groceryItem || foodCatalog[0];

const id = productData.id || productData["Product ID"] || productData.ProductID || 'bc_food_101';
const name = productData.name || productData["Product Name"] || 'Bhusawal Special Tarri Poha';
const category = productData.category || productData.Category || 'Breakfast';
const price = parseFloat(productData.price || productData.MRP || productData["Selling Price"] || 40);
const mrp = price;
const rating = productData.rating || '4.9';
const isVeg = productData.isVeg !== undefined ? productData.isVeg : true;
const prepTime = productData.prepTime || '10-15 min';
const description = productData.description || 'Authentic Khandeshi Tarri Poha cooked with flattened rice, mustard seeds, curry leaves, roasted peanuts, topped with spicy tari gravy, fresh onions and nylon sev.';

function getIngredients(itemName: string) {
  const n = itemName.toLowerCase();
  if (n.includes('poha')) return ['Flattened Rice', 'Mustard Seeds', 'Curry Leaves', 'Roasted Peanuts', 'Green Chillies', 'Lemon', 'Spicy Tarri Gravy', 'Nylon Sev'];
  if (n.includes('pizza')) return ['Mozzarella Cheese', 'Hand Tossed Crust', 'Tomato Basil Sauce', 'Capsicum', 'Onions', 'Italian Herbs'];
  if (n.includes('burger')) return ['Soft Bun', 'Crispy Patty', 'Amul Cheese', 'Lettuce', 'Tomatoes', 'House Mayo'];
  if (n.includes('biryani')) return ['Basmati Rice', 'Pure Ghee', 'Saffron', 'Mint Leaves', 'Fried Onions', 'Indian Whole Spices'];
  if (n.includes('paneer')) return ['Fresh Cottage Cheese', 'Butter', 'Cashew Cream', 'Tomato Gravy', 'Kasturi Methi', 'Garam Masala'];
  if (n.includes('chicken')) return ['Tender Chicken', 'Ghee', 'Ginger Garlic Paste', 'Onion Gravy', 'Khandeshi Spices', 'Coriander'];
  if (n.includes('chai') || n.includes('tea')) return ['Fresh Milk', 'Assam Tea Leaves', 'Crushed Ginger', 'Cardamom', 'Tulsi'];
  if (n.includes('coffee')) return ['Espresso Shot', 'Chilled Whole Milk', 'Cocoa Powder', 'Vanilla Scoop', 'Sugar'];
  return ['Fresh Local Produce', 'Pure Cow Ghee', 'Authentic Indian Spices', 'Natural Herbs'];
}

const ingredients = getIngredients(name);
const mainImg = productData.image || productData["Product Image URL"] || productData.img || 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80';
const galleryImages = [
  mainImg,
  'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80',
  'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
  'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80'
];

const recommendedItems = foodCatalog.filter(x => x.category === category && x.id !== id).slice(0, 6);

const fbt1 = foodCatalog.find(x => x.category === 'Beverages') || foodCatalog[10];
const fbt2 = foodCatalog.find(x => x.category === 'Desserts' || x.category === 'Snacks') || foodCatalog[15];
const fbtTotalPrice = price + parseFloat(fbt1?.price || 40) + parseFloat(fbt2?.price || 60);
const fbtBundlePrice = Math.round(fbtTotalPrice * 0.9);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title id="pdp-meta-title">{name} | Food Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-white">

  <!-- TOP STICKY HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a id="pdp-back-link" href="/food" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-redBrand tracking-tight">
          bhusawal<span class="text-slate-900">connect</span>
        </span>
      </a>
    </div>

    <!-- Express Delivery Badge & Global Cart Icon -->
    <div class="flex items-center gap-3">
      <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1 bg-redLight text-redBrand">
        <span class="material-symbols-outlined text-sm">bolt</span>
        20 MIN EXPRESS FOOD DELIVERY
      </span>

      <a href="/cart" class="relative w-10 h-10 rounded-full text-white flex items-center justify-center font-bold shadow-md bg-redBrand hover:bg-redDark transition-colors">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="pdp-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>
  </header>

  <!-- MAIN PRODUCT DETAILS CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

    <!-- BREADCRUMB -->
    <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
      <a href="/home" class="hover:text-slate-600">Home</a>
      <span>/</span>
      <a href="/food" class="hover:text-slate-600">Food Delivery</a>
      <span>/</span>
      <span id="pdp-breadcrumb-name" class="text-slate-800 font-extrabold truncate max-w-xs">{name}</span>
    </div>

    <!-- MAIN PRODUCT TWO-COLUMN GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT COLUMN: LARGE GALLERY WITH THUMBNAIL PREVIEWS (LG: 5 COLS) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Large Main Image Container -->
        <div class="w-full aspect-square bg-slate-50/80 rounded-3xl p-4 border border-slate-100 shadow-xs relative overflow-hidden flex items-center justify-center group">
          
          <!-- Veg / Non-Veg Badge -->
          <div id="pdp-diet-badge" class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-black flex items-center gap-1.5 shadow-xs border border-slate-200 z-10">
            <span id="pdp-diet-dot" class={`w-2.5 h-2.5 rounded-full shrink-0 ${isVeg ? 'bg-emerald-600' : 'bg-rose-600'}`}></span>
            <span id="pdp-diet-text" class={isVeg ? 'text-emerald-700' : 'text-rose-700'}>{isVeg ? 'PURE VEG' : 'NON-VEG'}</span>
          </div>

          <!-- Customer Rating Badge -->
          <div id="pdp-rating-badge" class="absolute top-4 right-4 bg-amber-50 text-amber-800 border border-amber-200 px-3 py-1 rounded-full text-xs font-black flex items-center gap-1 shadow-xs z-10">
            <span>⭐</span>
            <span id="pdp-rating-text">{rating} (128 reviews)</span>
          </div>

          <!-- Interactive Favourite Heart Button -->
          <button 
            id="pdp-fav-btn"
            class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-white/95 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 active:scale-90 transition-all z-10 shadow-xs"
            onclick="this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';"
          >
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
          </button>

          <!-- Main Image -->
          <img 
            id="pdp-main-image"
            src={mainImg} 
            alt={name} 
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';"
          />
        </div>

        <!-- Thumbnail Gallery Bar -->
        <div id="pdp-gallery-row" class="flex items-center gap-3 overflow-x-auto no-scrollbar py-1">
          {galleryImages.map((imgUrl, idx) => (
            <button 
              class={`pdp-thumb-btn w-16 h-16 rounded-2xl border-2 p-1 bg-white overflow-hidden shrink-0 transition-all ${idx === 0 ? 'border-redBrand' : 'border-slate-100 hover:border-slate-300'}`}
              onclick={`document.getElementById('pdp-main-image').src='${imgUrl}'; document.querySelectorAll('.pdp-thumb-btn').forEach(b => b.classList.remove('border-redBrand')); this.classList.add('border-redBrand');`}
            >
              <img src={imgUrl} class="w-full h-full object-cover rounded-xl" alt="Gallery thumbnail" />
            </button>
          ))}
        </div>

      </div>

      <!-- RIGHT COLUMN: PRODUCT METADATA & ACTIONS (LG: 7 COLS) -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm space-y-5">
          
          <!-- Category & Prep Time -->
          <div class="flex items-center justify-between gap-2">
            <span id="pdp-category-tag" class="text-xs font-black uppercase tracking-wider text-redBrand">
              {category}
            </span>
            <span id="pdp-preptime-tag" class="text-xs font-extrabold text-slate-700 bg-slate-100 px-3 py-1 rounded-full flex items-center gap-1">
              ⏱️ Prep Time: {prepTime}
            </span>
          </div>

          <!-- Title -->
          <h1 id="pdp-title" class="text-2xl sm:text-3xl font-black font-display text-slate-900 leading-tight">
            {name}
          </h1>

          <!-- Price & Discount -->
          <div class="flex items-baseline gap-3 pt-1 border-t border-slate-100">
            <span id="pdp-price" class="text-3xl sm:text-4xl font-black font-display text-slate-900">₹{price}</span>
            <span class="text-xs font-bold text-slate-400">Inclusive of all taxes • Fresh Hot Delivery</span>
          </div>

          <!-- Description -->
          <div class="space-y-1.5 pt-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Description</h3>
            <p id="pdp-desc" class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
              {description}
            </p>
          </div>

          <!-- Ingredients Chips Section -->
          <div class="space-y-2 pt-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Key Ingredients</h3>
            <div id="pdp-ingredients-box" class="flex flex-wrap gap-1.5">
              {ingredients.map(ing => (
                <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-xl border border-slate-200/80">
                  {ing}
                </span>
              ))}
            </div>
          </div>

          <!-- ADD TO CART & QUANTITY ACTION BOX -->
          <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            
            <!-- Quantity Stepper -->
            <div class="flex items-center justify-between border border-red-200 bg-redLight rounded-2xl p-1 shadow-xs">
              <button id="pdp-qty-minus" class="w-10 h-10 rounded-xl bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                -
              </button>
              <span id="pdp-qty-num" class="px-4 text-sm font-black text-redBrand min-w-[32px] text-center">1</span>
              <button id="pdp-qty-plus" class="w-10 h-10 rounded-xl bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                +
              </button>
            </div>

            <!-- Add to Cart Button -->
            <button 
              id="pdp-add-to-cart-btn"
              class="flex-1 py-4 bg-redBrand hover:bg-redDark text-white font-black text-sm rounded-2xl shadow-xl shadow-red-900/15 active:scale-95 transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-lg">shopping_bag</span>
              <span id="pdp-add-btn-text">ADD TO CART • ₹{price}</span>
            </button>

          </div>

        </div>

        <!-- FREQUENTLY BOUGHT TOGETHER BUNDLE SECTION -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
          <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span>💡 Frequently Bought Together</span>
          </h3>

          <div class="grid grid-cols-3 gap-3 items-center" id="pdp-fbt-grid">
            <div class="text-center space-y-1">
              <img id="fbt-img-main" src={mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
              <p id="fbt-name-main" class="text-[10px] font-bold text-slate-800 truncate">{name}</p>
              <p id="fbt-price-main" class="text-xs font-black">₹{price}</p>
            </div>

            <div class="text-center space-y-1">
              <img id="fbt-img-1" src={fbt1?.image || mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
              <p id="fbt-name-1" class="text-[10px] font-bold text-slate-800 truncate">{fbt1?.name || 'Beverage'}</p>
              <p id="fbt-price-1" class="text-xs font-black">₹{fbt1?.price || 40}</p>
            </div>

            <div class="text-center space-y-1">
              <img id="fbt-img-2" src={fbt2?.image || mainImg} class="w-16 h-16 rounded-2xl object-cover mx-auto border" />
              <p id="fbt-name-2" class="text-[10px] font-bold text-slate-800 truncate">{fbt2?.name || 'Dessert'}</p>
              <p id="fbt-price-2" class="text-xs font-black">₹{fbt2?.price || 60}</p>
            </div>
          </div>

          <button 
            id="pdp-add-bundle-btn"
            class="w-full py-3 text-xs font-black rounded-xl border border-red-200 bg-redLight text-redBrand hover:bg-redBrand hover:text-white transition-all flex items-center justify-center gap-1"
          >
            <span id="pdp-fbt-btn-text">Add Combo Bundle for ₹{fbtBundlePrice}</span>
            <span id="pdp-fbt-strike-text" class="line-through text-[10px] opacity-70">₹{fbtTotalPrice}</span>
          </button>
        </div>

      </div>

    </div>

    <!-- RECOMMENDED FOOD SECTION -->
    <section class="space-y-4 pt-4 border-t border-slate-200/60">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 flex items-center gap-2">
          <span>🍽️ Recommended Food Items</span>
        </h2>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Scroll →</span>
      </div>

      <div id="pdp-recommended-carousel" class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2">
        {recommendedItems.map(rec => (
          <div 
            class="w-48 sm:w-56 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-lg transition-all cursor-pointer group"
            onclick={`window.location.href='/product?id=${rec.id}';`}
          >
            <div>
              <div class="w-full aspect-square bg-slate-50 rounded-2xl p-2 mb-2 flex items-center justify-center overflow-hidden">
                <img src={rec.image} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
              </div>
              <h3 class="text-xs font-extrabold text-slate-900 line-clamp-2 min-h-[2.2rem]">{rec.name}</h3>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between mt-2">
              <span class="text-sm font-black text-slate-900">₹{rec.price}</span>
              <span class="text-[10px] font-black px-2.5 py-1 rounded-xl bg-redLight text-redBrand">VIEW</span>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- Client-Side Catalog Array for Dynamic Hydration -->
  <script is:inline define:vars={{ foodCatalog, groceryCatalog }}>
    window.BHUSAWAL_FOOD_CATALOG = foodCatalog || [];
    window.BHUSAWAL_GROCERY_CATALOG = groceryCatalog || [];
  </script>

  <!-- Dynamic Client Script for Food PDP Hydration & Cart Sync -->
  <script is:inline>
    (function() {
      var foodCatalog = window.BHUSAWAL_FOOD_CATALOG || [];
      var groceryCatalog = window.BHUSAWAL_GROCERY_CATALOG || [];

      var params = new URLSearchParams(window.location.search);
      var targetId = params.get('id') || '';
      var targetName = params.get('name') || '';

      // Find item in Food Catalog or Grocery Catalog
      var foodItem = foodCatalog.find(function(p) {
        return p.id === targetId || (targetName && p.name.toLowerCase() === targetName.toLowerCase());
      });

      var currentItem = foodItem;
      if (!currentItem && targetId) {
        currentItem = foodCatalog[0]; // fallback
      }

      var currentQty = 1;

      if (currentItem) {
        // Hydrate DOM with food item details dynamically!
        document.title = currentItem.name + ' | Food Delivery | Bhusawal Connect';

        var titleEl = document.getElementById('pdp-title');
        if (titleEl) titleEl.textContent = currentItem.name;

        var breadcrumbEl = document.getElementById('pdp-breadcrumb-name');
        if (breadcrumbEl) breadcrumbEl.textContent = currentItem.name;

        var priceEl = document.getElementById('pdp-price');
        if (priceEl) priceEl.textContent = '₹' + currentItem.price;

        var addBtnTextEl = document.getElementById('pdp-add-btn-text');
        if (addBtnTextEl) addBtnTextEl.textContent = 'ADD TO CART • ₹' + currentItem.price;

        var catEl = document.getElementById('pdp-category-tag');
        if (catEl) catEl.textContent = currentItem.category;

        var prepEl = document.getElementById('pdp-preptime-tag');
        if (prepEl) prepEl.textContent = '⏱️ Prep Time: ' + (currentItem.prepTime || '15-20 min');

        var descEl = document.getElementById('pdp-desc');
        if (descEl) descEl.textContent = currentItem.description || 'Authentic dish prepared fresh with high quality ingredients and traditional Bhusawal spices.';

        var mainImgEl = document.getElementById('pdp-main-image');
        if (mainImgEl && currentItem.image) mainImgEl.src = currentItem.image;

        // Diet Badge
        var dietDot = document.getElementById('pdp-diet-dot');
        var dietText = document.getElementById('pdp-diet-text');
        if (dietDot && dietText) {
          if (currentItem.isVeg) {
            dietDot.className = 'w-2.5 h-2.5 rounded-full shrink-0 bg-emerald-600';
            dietText.className = 'text-emerald-700';
            dietText.textContent = 'PURE VEG';
          } else {
            dietDot.className = 'w-2.5 h-2.5 rounded-full shrink-0 bg-rose-600';
            dietText.className = 'text-rose-700';
            dietText.textContent = 'NON-VEG';
          }
        }

        // Rating
        var ratingEl = document.getElementById('pdp-rating-text');
        if (ratingEl) ratingEl.textContent = (currentItem.rating || '4.9') + ' (128 reviews)';

        // Gallery
        var galleryRow = document.getElementById('pdp-gallery-row');
        if (galleryRow && currentItem.image) {
          var galleryImgs = [
            currentItem.image,
            'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80',
            'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
            'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80'
          ];
          var gHtml = '';
          galleryImgs.forEach(function(url, idx) {
            var borderClass = idx === 0 ? 'border-redBrand' : 'border-slate-100 hover:border-slate-300';
            gHtml += `
              <button 
                class="pdp-thumb-btn w-16 h-16 rounded-2xl border-2 p-1 bg-white overflow-hidden shrink-0 transition-all ${borderClass}"
                onclick="document.getElementById('pdp-main-image').src='${url}'; document.querySelectorAll('.pdp-thumb-btn').forEach(function(b){b.classList.remove('border-redBrand');}); this.classList.add('border-redBrand');"
              >
                <img src="${url}" class="w-full h-full object-cover rounded-xl" alt="Thumbnail" />
              </button>
            `;
          });
          galleryRow.innerHTML = gHtml;
        }

        // Ingredients
        var ingBox = document.getElementById('pdp-ingredients-box');
        if (ingBox) {
          function getIngs(n) {
            var nameL = n.toLowerCase();
            if (nameL.includes('poha')) return ['Flattened Rice', 'Mustard Seeds', 'Curry Leaves', 'Roasted Peanuts', 'Green Chillies', 'Lemon', 'Spicy Tarri Gravy', 'Nylon Sev'];
            if (nameL.includes('pizza')) return ['Mozzarella Cheese', 'Hand Tossed Crust', 'Tomato Basil Sauce', 'Capsicum', 'Onions', 'Italian Herbs'];
            if (nameL.includes('burger')) return ['Soft Bun', 'Crispy Patty', 'Amul Cheese', 'Lettuce', 'Tomatoes', 'House Mayo'];
            if (nameL.includes('biryani')) return ['Basmati Rice', 'Pure Ghee', 'Saffron', 'Mint Leaves', 'Fried Onions', 'Indian Whole Spices'];
            if (nameL.includes('paneer')) return ['Fresh Cottage Cheese', 'Butter', 'Cashew Cream', 'Tomato Gravy', 'Kasturi Methi', 'Garam Masala'];
            if (nameL.includes('chicken')) return ['Tender Chicken', 'Ghee', 'Ginger Garlic Paste', 'Onion Gravy', 'Khandeshi Spices', 'Coriander'];
            if (nameL.includes('chai') || nameL.includes('tea')) return ['Fresh Milk', 'Assam Tea Leaves', 'Crushed Ginger', 'Cardamom', 'Tulsi'];
            if (nameL.includes('coffee')) return ['Espresso Shot', 'Chilled Whole Milk', 'Cocoa Powder', 'Vanilla Scoop', 'Sugar'];
            return ['Fresh Local Produce', 'Pure Cow Ghee', 'Authentic Indian Spices', 'Natural Herbs'];
          }
          var ings = getIngs(currentItem.name);
          var ingHtml = '';
          ings.forEach(function(ing) {
            ingHtml += `<span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-xl border border-slate-200/80">${ing}</span>`;
          });
          ingBox.innerHTML = ingHtml;
        }

        // Recommended items
        var recCarousel = document.getElementById('pdp-recommended-carousel');
        if (recCarousel) {
          var recs = foodCatalog.filter(function(x) { return x.category === currentItem.category && x.id !== currentItem.id; }).slice(0, 6);
          if (recs.length > 0) {
            var rHtml = '';
            recs.forEach(function(rec) {
              rHtml += `
                <div 
                  class="w-48 sm:w-56 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-lg transition-all cursor-pointer group"
                  onclick="window.location.href='/product?id=${rec.id}';"
                >
                  <div>
                    <div class="w-full aspect-square bg-slate-50 rounded-2xl p-2 mb-2 flex items-center justify-center overflow-hidden">
                      <img src="${rec.image}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
                    </div>
                    <h3 class="text-xs font-extrabold text-slate-900 line-clamp-2 min-h-[2.2rem]">${rec.name}</h3>
                  </div>
                  <div class="pt-2 border-t border-slate-100 flex items-center justify-between mt-2">
                    <span class="text-sm font-black text-slate-900">₹${rec.price}</span>
                    <span class="text-[10px] font-black px-2.5 py-1 rounded-xl bg-redLight text-redBrand">VIEW</span>
                  </div>
                </div>
              `;
            });
            recCarousel.innerHTML = rHtml;
          }
        }
      }

      function getCart() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {
          return [];
        }
      }

      function saveCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateBadge();
      }

      function updateBadge() {
        var cart = getCart();
        var total = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        var badge = document.getElementById('pdp-cart-badge');
        if (badge) badge.textContent = total;
      }

      // Quantity controls
      document.getElementById('pdp-qty-plus')?.addEventListener('click', function() {
        currentQty++;
        document.getElementById('pdp-qty-num').textContent = currentQty;
      });

      document.getElementById('pdp-qty-minus')?.addEventListener('click', function() {
        if (currentQty > 1) {
          currentQty--;
          document.getElementById('pdp-qty-num').textContent = currentQty;
        }
      });

      // Add to Cart Button
      document.getElementById('pdp-add-to-cart-btn')?.addEventListener('click', function() {
        if (!currentItem) return;
        var cart = getCart();
        var existing = cart.find(function(c) { return c.id === currentItem.id; });
        if (existing) {
          existing.quantity = (existing.quantity || 1) + currentQty;
        } else {
          cart.push({
            id: currentItem.id,
            name: currentItem.name,
            price: currentItem.price,
            mrp: currentItem.price,
            image: currentItem.image,
            quantity: currentQty,
            restaurant: 'Bhusawal Food Express',
            cat: currentItem.category
          });
        }
        saveCart(cart);
        alert(currentItem.name + ' added to your cart!');
      });

      updateBadge();
    })();
  </script>

</body>
</html>
