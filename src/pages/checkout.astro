          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">City *</label>
            <input type="text" id="field-city" value="Bhusawal" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">PIN Code *</label>
            <input type="text" id="field-pincode" value="425201" required maxlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

        <div class="pt-2 flex items-center gap-2">
          <input type="checkbox" id="field-save-profile" checked class="accent-blueBrand w-4 h-4" />
          <label for="field-save-profile" class="text-xs font-bold text-slate-700">Save this address to my profile for future orders</label>
        </div>

        <button type="submit" class="w-full py-3.5 bg-blueBrand hover:bg-blueDark text-white font-black text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-1.5 mt-2">
          <span class="material-symbols-outlined text-base">check</span>
          <span>Save & Use Address</span>
        </button>

      </form>
    </div>
  </div>
<!-- CLIENT-SIDE CHECKOUT & ADDRESS ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      let map, marker;
      let currentLat = 21.0478;
      let currentLng = 75.7896;
      let selectedAddressObject = null;

      // Default Bhusawal addresses
      const DEFAULT_ADDRESSES = [
        {
          id: 'A1',
          name: 'Sahil Patel',
          phone: '9923456789',
          tag: 'Home',
          house: 'Plot 42',
          building: 'Gokul Residency',
          street: 'Station Road',
          area: 'Shivaji Nagar',
          landmark: 'Near Railway Station',
          city: 'Bhusawal',
          pincode: '425201',
          full: 'Plot 42, Gokul Residency, Station Road, Shivaji Nagar, Near Railway Station, Bhusawal - 425201',
          lat: 21.0478,
          lng: 75.7896
        },
        {
          id: 'A2',
          name: 'Sahil Patel',
          phone: '9923456789',
          tag: 'Work',
          house: 'Shop 12',
          building: 'Commercial Complex',
          street: 'Jamner Road',
          area: 'Main Market',
          landmark: 'Opposite Central Bank',
          city: 'Bhusawal',
          pincode: '425201',
          full: 'Shop 12, Commercial Complex, Jamner Road, Main Market, Opposite Central Bank, Bhusawal - 425201',
          lat: 21.0512,
          lng: 75.7920
        }
      ];

      function getSavedAddresses() {
        try {
          const stored = JSON.parse(localStorage.getItem('bhusawal_user_addresses') || '[]');
          if (Array.isArray(stored) && stored.length > 0) return stored;
        } catch(e) {}
        return DEFAULT_ADDRESSES;
      }

      function saveAddressesToStorage(addressesList) {
        localStorage.setItem('bhusawal_user_addresses', JSON.stringify(addressesList));
      }

      // Tag Button Selection in Form Modal
      const tagButtons = document.querySelectorAll('#modal-tag-selector-group .tag-selector-btn');
      const tagHiddenInput = document.getElementById('field-tag');

      tagButtons.forEach(btn => {
        btn.onclick = () => {
          tagButtons.forEach(b => {
            b.className = 'tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200';
          });
          btn.className = 'tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-blueBrand text-white border-blueBrand shadow-xs';
          if (tagHiddenInput) tagHiddenInput.value = btn.dataset.tag || 'Home';
        };
      });

      function setTagActive(tagValue) {
        if (tagHiddenInput) tagHiddenInput.value = tagValue;
        tagButtons.forEach(b => {
          if (b.dataset.tag === tagValue) {
            b.className = 'tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-blueBrand text-white border-blueBrand shadow-xs';
          } else {
            b.className = 'tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200';
          }
        });
      }

      // Reverse Geocode Helper for Bhusawal Address Formatting
      async function reverseGeocodeAddress(lat, lng) {
        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`);
          const data = await res.json();
          if (data && data.display_name) {
            return data.display_name;
          }
        } catch(e) {}
        return `Location (${lat.toFixed(4)}, ${lng.toFixed(4)}), Bhusawal, Maharashtra 425201`;
      }

      // Initialize HD Google Maps / Location Picker Canvas
      function initLeafletMap(lat, lng) {
        currentLat = parseFloat(parseFloat(lat).toFixed(4));
        currentLng = parseFloat(parseFloat(lng).toFixed(4));

        const mapContainer = document.getElementById('checkout-leaflet-map');
        if (!mapContainer || typeof L === 'undefined') return;

        const pinIcon = L.divIcon({
          className: 'custom-doorstep-pin',
          html: `<div style="background:#EF4444;color:#fff;padding:6px 12px;border-radius:24px;font-size:11px;font-weight:900;box-shadow:0 8px 20px rgba(239,68,68,0.5);border:3px solid #fff;display:flex;align-items:center;gap:4px;white-space:nowrap;">📍 <span id="pin-badge-text">Doorstep Pin</span></div>`,
          iconSize: [130, 36],
          iconAnchor: [65, 18]
        });

        if (!map) {
          map = L.map('checkout-leaflet-map', { zoomControl: true }).setView([lat, lng], 17);
          
          // Google Maps Roadmap HD Vector Tiles
          L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            maxZoom: 20,
            subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
            attribution: '© Google Maps'
          }).addTo(map);

          marker = L.marker([lat, lng], { draggable: true, icon: pinIcon }).addTo(map);

          const handlePositionChange = async (newLat, newLng) => {
            updateLatLngDisplay(newLat, newLng);
            const addrText = await reverseGeocodeAddress(newLat, newLng);
            const previewEl = document.getElementById('checkout-doorstep-preview');
            if (previewEl) previewEl.textContent = addrText;

            // Recalculate Distance & Delivery Fee dynamically
            const shopLat = 21.0478;
            const shopLng = 75.7896;
            const dLat = (newLat - shopLat) * 111;
            const dLng = (newLng - shopLng) * 111 * Math.cos(newLat * Math.PI / 180);
            const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
            const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));
            const dynamicDeliveryCharge = Math.round(30 + Math.max(0, roadKm - 3.0) * 10);
            
            renderCartSummary(dynamicDeliveryCharge);
          };

          marker.on('dragend', function (e) {
            const pos = marker.getLatLng();
            handlePositionChange(pos.lat, pos.lng);
          });

          map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            handlePositionChange(e.latlng.lat, e.latlng.lng);
          });
        } else {
          map.setView([lat, lng], 17);
          marker.setLatLng([lat, lng]);
        }

        updateLatLngDisplay(lat, lng);
      }

      function updateLatLngDisplay(lat, lng) {
        currentLat = parseFloat(parseFloat(lat).toFixed(4));
        currentLng = parseFloat(parseFloat(lng).toFixed(4));
        const displayEl = document.getElementById('display-lat-lng');
        const modalEl = document.getElementById('modal-lat-lng-text');
        if (displayEl) displayEl.textContent = `Lat: ${currentLat}, Lng: ${currentLng}`;
        if (modalEl) modalEl.textContent = `Lat: ${currentLat}, Lng: ${currentLng}`;
      }

      let selectedAddressId = localStorage.getItem('bhusawal_selected_address_id') || null;

      function setSelectedAddressId(addrId) {
        const addresses = getSavedAddresses();
        if (addresses.length === 0) return;

        let targetAddr = addresses.find(a => a.id === addrId);
        if (!targetAddr) {
          targetAddr = addresses[0];
        }

        selectedAddressId = targetAddr.id;
        selectedAddressObject = targetAddr;

        localStorage.setItem('bhusawal_selected_address_id', selectedAddressId);
        localStorage.setItem('bhusawal_selected_address', JSON.stringify(targetAddr));

        if (window.BhusawalCheckoutState) {
          window.BhusawalCheckoutState.state.address = targetAddr;
        }

        updateSelectedAddressUI(targetAddr);
        renderSavedAddresses();
      }

      // Render Saved Addresses List (Single Source of Truth: selectedAddressId)
      function renderSavedAddresses() {
        const grid = document.getElementById('saved-addresses-grid');
        const addresses = getSavedAddresses();
        if (!grid) return;

        if (!selectedAddressId && addresses.length > 0) {
          selectedAddressId = addresses[0].id;
          selectedAddressObject = addresses[0];
        }

        let html = '';
        addresses.forEach((addr) => {
          const isSelected = (addr.id === selectedAddressId);
          if (isSelected) {
            selectedAddressObject = addr;
          }

          const tagIcons = { Home: '📍', Work: '💼', Office: '🏢', Other: '📌' };
          const tagIcon = tagIcons[addr.tag] || '📍';

          html += `
            <div class="saved-addr-card p-3.5 rounded-2xl border-2 ${isSelected ? 'border-blueBrand bg-blueLight/50 shadow-sm' : 'border-slate-200 bg-white'} transition-all relative flex flex-col justify-between cursor-pointer" data-id="${addr.id}">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-black text-blueBrand flex items-center gap-1">${tagIcon} ${addr.tag || 'Saved'}</span>
                  ${isSelected ? '<span class="px-2 py-0.5 rounded-full bg-blueBrand text-white text-[9px] font-black uppercase">Selected ✓</span>' : ''}
                </div>
                <p class="text-xs font-black text-slate-900">${addr.name || 'Customer'} (+91 ${addr.phone || '9923456789'})</p>
                <p class="text-[11px] font-bold text-slate-500 line-clamp-2 mt-0.5">${addr.full}</p>
              </div>

              <!-- CARD ACTION BUTTONS: SELECT, EDIT, DELETE -->
              <div class="flex items-center justify-between pt-3 mt-2 border-t border-slate-100 text-[11px] font-black">
                <span class="btn-select-addr text-blueBrand hover:underline">
                  ${isSelected ? 'Active Address ✓' : 'Select'}
                </span>
                <div class="flex items-center gap-2">
                  <button type="button" class="btn-edit-addr text-slate-600 hover:text-blueBrand flex items-center gap-0.5" data-id="${addr.id}">
                    <span class="material-symbols-outlined text-[13px]">edit</span> Edit
                  </button>
                  <button type="button" class="btn-delete-addr text-rose-500 hover:text-rose-700 flex items-center gap-0.5" data-id="${addr.id}">
                    <span class="material-symbols-outlined text-[13px]">delete</span> Delete
                  </button>
                </div>
              </div>
            </div>
          `;
        });

        grid.innerHTML = html;

        // Card Click Listener (Single Source of Truth)
        grid.querySelectorAll('.saved-addr-card').forEach(card => {
          card.onclick = (e) => {
            if (e.target.closest('.btn-edit-addr') || e.target.closest('.btn-delete-addr')) return;
            const addrId = card.dataset.id;
            if (addrId && addrId !== selectedAddressId) {
              setSelectedAddressId(addrId);
            }
          };
        });

        // Bind Edit Action
        grid.querySelectorAll('.btn-edit-addr').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const addrId = btn.dataset.id;
            const addr = addresses.find(a => a.id === addrId);
            if (addr) {
              openAddressModal(addr.lat || currentLat, addr.lng || currentLng, addr);
            }
          };
        });

        // Bind Delete Action (Preserves Cart!)
        grid.querySelectorAll('.btn-delete-addr').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const addrId = btn.dataset.id;
            if (confirm('Are you sure you want to delete this delivery address?')) {
              let addrs = getSavedAddresses().filter(a => a.id !== addrId);
              saveAddressesToStorage(addrs);
              if (selectedAddressId === addrId) {
                const nextAddr = addrs[0] || null;
                if (nextAddr) {
                  setSelectedAddressId(nextAddr.id);
                } else {
                  selectedAddressId = null;
                  selectedAddressObject = null;
                  renderSavedAddresses();
                }
              } else {
                renderSavedAddresses();
              }
            }
          };
        });
      }

      // Update Selected Address UI: Real-time calculation of Distance, ETA, and Delivery Charges
      function updateSelectedAddressUI(addr) {
        if (!addr) return;
        selectedAddressObject = addr;

        // Save selected address in localStorage & Customer Profile Sync
        try {
          localStorage.setItem('bhusawal_selected_address', JSON.stringify(addr));
          localStorage.setItem('bhusawal_selected_address_id', addr.id);

          let profile = JSON.parse(localStorage.getItem('bhusawal_user_profile') || '{}');
          profile.selectedAddress = addr;
          localStorage.setItem('bhusawal_user_profile', JSON.stringify(profile));
        } catch(e) {}

        const selAddrEl = document.getElementById('summary-selected-address');
        if (selAddrEl) {
          selAddrEl.textContent = `${addr.tag || 'Saved'}: ${addr.name || 'Customer'} (+91 ${addr.phone || '9923456789'}) - ${addr.full || ''}`;
        }

        // 1. Calculate Road Distance (km) from Store (lat: 21.0478, lng: 75.7896)
        const shopLat = 21.0478;
        const shopLng = 75.7896;
        const destLat = addr.lat || 21.0478;
        const destLng = addr.lng || 75.7896;

        const dLat = (destLat - shopLat) * 111;
        const dLng = (destLng - shopLng) * 111 * Math.cos(destLat * Math.PI / 180);
        const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
        const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));

        // 2. Calculate ETA (Minutes)
        const travelMins = Math.max(6, Math.round(roadKm * 4.5) + 5);
        const etaWidget = document.querySelector('.bg-blueLight.text-blueBrand');
        if (etaWidget) {
          etaWidget.innerHTML = `<span class="w-2.5 h-2.5 rounded-full bg-blueBrand animate-ping"></span><span class="text-xs font-black">⚡ Express Delivery: ~${travelMins} Mins (${roadKm} km)</span>`;
        }

        // 3. Dynamic Delivery Charges Calculation
        const baseDeliveryFee = 30; // ₹30 base fee for up to 3 km
        const extraKm = Math.max(0, roadKm - 3.0);
        const dynamicDeliveryCharge = Math.round(baseDeliveryFee + extraKm * 10);

        // 4. Center Leaflet Map
        initLeafletMap(destLat, destLng);

        // 5. Update Cart Summary with Dynamic Delivery Charge (Cart items strictly preserved!)
        renderCartSummary(dynamicDeliveryCharge);
      }

      // Quick Bhusawal Area Pills Listener
      document.querySelectorAll('.area-pill-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const lat = parseFloat(btn.dataset.lat);
          const lng = parseFloat(btn.dataset.lng);
          const name = btn.dataset.name;
          
          initLeafletMap(lat, lng);
          const previewEl = document.getElementById('checkout-doorstep-preview');
          if (previewEl) previewEl.textContent = `${name}, Bhusawal, Maharashtra 425201`;

          // Recalculate Distance & Delivery Fee
          const shopLat = 21.0478;
          const shopLng = 75.7896;
          const dLat = (lat - shopLat) * 111;
          const dLng = (lng - shopLng) * 111 * Math.cos(lat * Math.PI / 180);
          const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
          const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));
          const dynamicDeliveryCharge = Math.round(30 + Math.max(0, roadKm - 3.0) * 10);
          
          renderCartSummary(dynamicDeliveryCharge);
        });
      });

      // Address Search Action
      const executeAddressSearch = async () => {
        const query = (document.getElementById('checkout-search-address-input')?.value || '').trim();
        if (!query) return;

        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query + ', Bhusawal, Maharashtra')}&format=json&limit=1`);
          const data = await res.json();
          if (data && data.length > 0) {
            const lat = parseFloat(data[0].lat);
            const lng = parseFloat(data[0].lon);
            initLeafletMap(lat, lng);
            const previewEl = document.getElementById('checkout-doorstep-preview');
            if (previewEl) previewEl.textContent = data[0].display_name;

            const shopLat = 21.0478;
            const shopLng = 75.7896;
            const dLat = (lat - shopLat) * 111;
            const dLng = (lng - shopLng) * 111 * Math.cos(lat * Math.PI / 180);
            const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
            const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));
            const dynamicDeliveryCharge = Math.round(30 + Math.max(0, roadKm - 3.0) * 10);

            renderCartSummary(dynamicDeliveryCharge);
          } else {
            alert(`Could not locate "${query}". Please select an area pill or drag the pin on the map.`);
          }
        } catch(e) {}
      };

      document.getElementById('btn-search-address')?.addEventListener('click', executeAddressSearch);
      document.getElementById('checkout-search-address-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeAddressSearch();
        }
      });

      // GPS & Location Buttons
      document.getElementById('btn-use-current-gps')?.addEventListener('click', () => {
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              initLeafletMap(lat, lng);
              openAddressModal(lat, lng);
            },
            (err) => {
              initLeafletMap(21.0478, 75.7896);
              openAddressModal(21.0478, 75.7896);
            }
          );
        } else {
          openAddressModal(21.0478, 75.7896);
        }
      });

      document.getElementById('btn-select-google-maps')?.addEventListener('click', () => {
        initLeafletMap(currentLat, currentLng);
        openAddressModal(currentLat, currentLng);
      });

      function openAddressModal(lat, lng, addressToEdit = null) {
        updateLatLngDisplay(lat, lng);
        const modal = document.getElementById('address-form-modal');
        const modalTitle = modal.querySelector('h2');
        const idField = document.getElementById('field-address-id');

        if (addressToEdit) {
          if (modalTitle) modalTitle.textContent = "Edit Delivery Address";
          if (idField) idField.value = addressToEdit.id;
          document.getElementById('field-name').value = addressToEdit.name || '';
          document.getElementById('field-phone').value = addressToEdit.phone || '';
          document.getElementById('field-house').value = addressToEdit.house || '';
          document.getElementById('field-building').value = addressToEdit.building || '';
          document.getElementById('field-street').value = addressToEdit.street || '';
          document.getElementById('field-area').value = addressToEdit.area || '';
          document.getElementById('field-landmark').value = addressToEdit.landmark || '';
          document.getElementById('field-city').value = addressToEdit.city || 'Bhusawal';
          document.getElementById('field-pincode').value = addressToEdit.pincode || '425201';
          setTagActive(addressToEdit.tag || 'Home');
