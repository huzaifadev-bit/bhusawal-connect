          document.getElementById('field-phone').value = "";
          document.getElementById('field-house').value = "";
          document.getElementById('field-building').value = "";
          document.getElementById('field-street').value = "";
          document.getElementById('field-area').value = "";
          document.getElementById('field-landmark').value = "";
          document.getElementById('field-city').value = "Bhusawal";
          document.getElementById('field-pincode').value = "425201";
          setTagActive('Home');
        }

        modal.classList.remove('hidden');
      }

      document.getElementById('btn-open-address-modal')?.addEventListener('click', () => {
        openAddressModal(currentLat, currentLng);
      });

      document.getElementById('close-address-modal')?.addEventListener('click', () => {
        document.getElementById('address-form-modal').classList.add('hidden');
      });

      // Address Form Submission (Handles Add and Edit seamlessly without touching Cart)
      document.getElementById('address-details-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const editingId = document.getElementById('field-address-id').value;
        const tag = document.getElementById('field-tag').value || 'Home';
        const name = document.getElementById('field-name').value;
        const phone = document.getElementById('field-phone').value;
        const house = document.getElementById('field-house').value;
        const building = document.getElementById('field-building').value;
        const street = document.getElementById('field-street').value;
        const area = document.getElementById('field-area').value;
        const landmark = document.getElementById('field-landmark').value;
        const city = document.getElementById('field-city').value;
        const pincode = document.getElementById('field-pincode').value;

        const fullAddr = `${house}, ${building ? building + ', ' : ''}${street}, ${area}, ${landmark ? 'Near ' + landmark + ', ' : ''}${city} - ${pincode}`;

        let addresses = getSavedAddresses();

        if (editingId) {
          // Update existing address
          const idx = addresses.findIndex(a => a.id === editingId);
          if (idx !== -1) {
            addresses[idx] = {
              ...addresses[idx],
              name, phone, tag, house, building, street, area, landmark, city, pincode, full: fullAddr,
              lat: currentLat, lng: currentLng
            };
            selectedAddressObject = addresses[idx];
          }
        } else {
          // Add new address
          const newAddrObj = {
            id: 'A-' + Date.now(),
            name, phone, tag, house, building, street, area, landmark, city, pincode, full: fullAddr,
            lat: currentLat, lng: currentLng
          };
          addresses.unshift(newAddrObj);
          selectedAddressObject = newAddrObj;
        }

        saveAddressesToStorage(addresses);
        localStorage.setItem('bhusawal_selected_address_id', selectedAddressObject.id);
        updateSelectedAddressUI(selectedAddressObject);
        renderSavedAddresses();

        document.getElementById('address-form-modal').classList.add('hidden');
      });

      // Preferred Pharmacy input handler
      const prefInput = document.getElementById('preferred-pharmacy-input');
      const noticeText = document.getElementById('pharmacy-notice-text');

      if (prefInput) {
        prefInput.value = localStorage.getItem('bhusawal_preferred_pharmacy') || '';
        if (prefInput.value.trim() && noticeText) {
          noticeText.textContent = `Order will be requested from ${prefInput.value.trim()}.`;
        }

        prefInput.addEventListener('input', () => {
          const val = prefInput.value.trim();
          localStorage.setItem('bhusawal_preferred_pharmacy', val);
          if (noticeText) {
            if (val) {
              noticeText.textContent = `Order will be requested from ${val}.`;
            } else {
              noticeText.textContent = `We will source your medicines from a nearby verified partner pharmacy.`;
            }
          }
        });
      }

      // Special Instructions
      const specInstInput = document.getElementById('checkout-special-instructions');
      if (specInstInput) {
        specInstInput.value = localStorage.getItem('bhusawal_cart_notes') || '';
        specInstInput.addEventListener('input', () => {
          localStorage.setItem('bhusawal_cart_notes', specInstInput.value);
        });
      }

      // Payment Selection Engine & Interactive Switcher (Single Source of Truth: selectedPaymentMethod)
      const paymentLabels = {
        'UPI': '📱 Instant UPI',
        'COD': '💵 Cash on Delivery',
        'CREDIT_CARD': '💳 Credit Card',
        'DEBIT_CARD': '🏦 Debit Card',
        'NET_BANKING': '🌐 Net Banking'
      };

      let selectedPaymentMethod = localStorage.getItem('bhusawal_selected_payment') || 'UPI';

      function setSelectedPaymentMethod(paymentCode) {
        if (!paymentCode) paymentCode = 'UPI';
        selectedPaymentMethod = paymentCode;
        localStorage.setItem('bhusawal_selected_payment', selectedPaymentMethod);

        if (window.BhusawalCheckoutState) {
          window.BhusawalCheckoutState.state.payment = selectedPaymentMethod;
        }

        // Iterate over ALL payment cards and update radio checked & card styling synchronously
        document.querySelectorAll('#payment-options-grid .payment-card').forEach(card => {
          const radio = card.querySelector('input[name="payment-method"]');
          const badge = card.querySelector('.check-badge');
          const methodVal = card.dataset.method || (radio ? radio.value : null);
          const isSelected = (methodVal === selectedPaymentMethod);

          if (radio) {
            radio.checked = isSelected;
          }

          if (isSelected) {
            card.className = 'payment-card p-4 rounded-2xl border-2 border-blueBrand bg-blueLight/40 shadow-sm flex items-center justify-between cursor-pointer transition-all';
            if (badge) badge.classList.remove('hidden');
          } else {
            card.className = 'payment-card p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-blue-300 flex items-center justify-between cursor-pointer transition-all';
            if (badge) badge.classList.add('hidden');
          }
        });

        const selectedBadge = document.getElementById('selected-payment-badge');
        const summaryPayment = document.getElementById('summary-selected-payment');
        const labelText = paymentLabels[selectedPaymentMethod] || selectedPaymentMethod;

        if (selectedBadge) selectedBadge.textContent = `${labelText} (Selected)`;
        if (summaryPayment) summaryPayment.textContent = labelText;
      }

      document.querySelectorAll('input[name="payment-method"]').forEach(radio => {
        radio.addEventListener('change', () => {
          setSelectedPaymentMethod(radio.value);
        });
      });

      document.querySelectorAll('#payment-options-grid .payment-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const radio = card.querySelector('input[name="payment-method"]');
          const methodVal = card.dataset.method || (radio ? radio.value : null);
          if (methodVal && methodVal !== selectedPaymentMethod) {
            setSelectedPaymentMethod(methodVal);
          }
        });
      });

      // Initialize default selection UI
      updatePaymentSelectionUI();

      // ============================================================
      // UNIFIED CHECKOUT STATE MANAGER (Preserves ALL 6 States)
      // ============================================================
      class CheckoutStateManager {
        constructor() {
          this.state = {
            cart: this.loadCart(),
            address: this.loadAddress(),
            payment: this.loadPayment(),
            notes: localStorage.getItem('bhusawal_cart_notes') || '',
            coupon: this.loadCoupon(),
            slot: localStorage.getItem('bhusawal_delivery_slot') || '⚡ Express Instant (~15-25 Mins)'
          };

          this.initListeners();
          this.syncUI();
        }

        loadCart() {
          try {
            return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          } catch(e) { return []; }
        }

        loadAddress() {
          try {
            return JSON.parse(localStorage.getItem('bhusawal_selected_address') || 'null');
          } catch(e) { return null; }
        }

        loadPayment() {
          return localStorage.getItem('bhusawal_selected_payment') || 'UPI';
        }

        loadCoupon() {
          try {
            return JSON.parse(localStorage.getItem('bhusawal_applied_coupon') || 'null');
          } catch(e) { return null; }
        }

        saveState() {
          try {
            localStorage.setItem('bhusawal_cart', JSON.stringify(this.state.cart));
            if (this.state.address) {
              localStorage.setItem('bhusawal_selected_address', JSON.stringify(this.state.address));
            }
            localStorage.setItem('bhusawal_selected_payment', this.state.payment);
            localStorage.setItem('bhusawal_cart_notes', this.state.notes);
            if (this.state.coupon) {
              localStorage.setItem('bhusawal_applied_coupon', JSON.stringify(this.state.coupon));
            } else {
              localStorage.removeItem('bhusawal_applied_coupon');
            }
            localStorage.setItem('bhusawal_delivery_slot', this.state.slot);
          } catch(e) {}
        }

        setAddress(addrObj) {
          this.state.address = addrObj;
          this.saveState();
          this.syncUI();
        }

        setPayment(paymentCode) {
          this.state.payment = paymentCode;
          this.saveState();
          this.syncUI();
        }

        setNotes(notesText) {
          this.state.notes = notesText;
          this.saveState();
        }

        setSlot(slotText) {
          this.state.slot = slotText;
          this.saveState();
          this.syncUI();
        }

        applyCoupon(codeStr) {
          const cleanCode = (codeStr || '').trim().toUpperCase();
          let subtotal = this.state.cart.reduce((sum, item) => sum + (parseFloat(item.price || 0) * (item.quantity || 1)), 0);

          let discountAmount = 0;
          if (cleanCode === 'WELCOME50') {
            if (subtotal < 199) {
              alert('WELCOME50 coupon requires a minimum order subtotal of ₹199.');
              return false;
            }
            discountAmount = 50;
          } else if (cleanCode === 'BHUSAWAL10') {
            discountAmount = Math.round(subtotal * 0.10);
          } else if (cleanCode === 'BHUSAWALCONNECT') {
            discountAmount = 30;
          } else {
            alert('Invalid coupon code! Try WELCOME50, BHUSAWAL10, or BHUSAWALCONNECT.');
            return false;
          }

          this.state.coupon = {
            code: cleanCode,
            discountAmount: discountAmount
          };

          this.saveState();
          this.syncUI();
          return true;
        }

        removeCoupon() {
          this.state.coupon = null;
          this.saveState();
          this.syncUI();
        }

        syncUI() {
          // Render Delivery Slot Buttons
          const slotBtns = document.querySelectorAll('#delivery-slot-group .slot-btn');
          slotBtns.forEach(btn => {
            const check = btn.querySelector('.slot-check');
            if (btn.dataset.slot === this.state.slot) {
              btn.className = 'slot-btn p-3.5 rounded-2xl border-2 border-blueBrand bg-blueLight/40 text-left transition-all flex items-center justify-between shadow-xs';
              if (check) check.classList.remove('hidden');
            } else {
              btn.className = 'slot-btn p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all hover:border-blue-300 flex items-center justify-between';
              if (check) check.classList.add('hidden');
            }
          });
          const slotSummaryEl = document.getElementById('summary-selected-slot');
          if (slotSummaryEl) slotSummaryEl.textContent = this.state.slot;

          // Render Coupon Badge & Price Breakdown Row
          const badgeEl = document.getElementById('applied-coupon-badge');
          const codeNameEl = document.getElementById('applied-coupon-code-name');
          const savingsTextEl = document.getElementById('applied-coupon-savings-text');
          const discountRow = document.getElementById('summary-coupon-discount-row');
          const discountCodeText = document.getElementById('summary-coupon-code-text');
          const discountValEl = document.getElementById('summary-coupon-discount-val');

          if (this.state.coupon) {
            if (badgeEl) badgeEl.classList.remove('hidden');
            if (codeNameEl) codeNameEl.textContent = this.state.coupon.code;
            if (savingsTextEl) savingsTextEl.textContent = `(Saved ₹${this.state.coupon.discountAmount})`;
            if (discountRow) discountRow.classList.remove('hidden');
            if (discountCodeText) discountCodeText.textContent = this.state.coupon.code;
            if (discountValEl) discountValEl.textContent = `-₹${this.state.coupon.discountAmount}`;
          } else {
            if (badgeEl) badgeEl.classList.add('hidden');
            if (discountRow) discountRow.classList.add('hidden');
          }

          // Calculate delivery charge & render summary
          let deliveryFee = 30;
          if (this.state.address) {
            const shopLat = 21.0478;
            const shopLng = 75.7896;
            const destLat = this.state.address.lat || 21.0478;
            const destLng = this.state.address.lng || 75.7896;

            const dLat = (destLat - shopLat) * 111;
            const dLng = (destLng - shopLng) * 111 * Math.cos(destLat * Math.PI / 180);
            const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
            const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));
            deliveryFee = Math.round(30 + Math.max(0, roadKm - 3.0) * 10);
          }

          renderCartSummary(deliveryFee, this.state.coupon ? this.state.coupon.discountAmount : 0);
        }

        initListeners() {
          // Delivery Slot listeners
          document.querySelectorAll('#delivery-slot-group .slot-btn').forEach(btn => {
            btn.onclick = () => this.setSlot(btn.dataset.slot);
          });

          // Coupon listeners
          const applyBtn = document.getElementById('btn-apply-coupon');
          const couponInput = document.getElementById('checkout-coupon-input');
          const removeBtn = document.getElementById('btn-remove-coupon');

          if (applyBtn && couponInput) {
            applyBtn.onclick = () => {
              if (this.applyCoupon(couponInput.value)) {
                couponInput.value = '';
              }
            };
          }
          if (removeBtn) {
            removeBtn.onclick = () => this.removeCoupon();
          }
        }
      }

      window.BhusawalCheckoutState = new CheckoutStateManager();

      // Render Cart Summary Items & Dynamic Distance/Fee Calculations
      function renderCartSummary(deliveryFee = 30, discountAmount = 0) {
        let cart = [];
        try {
          cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        const itemsBox = document.getElementById('checkout-cart-items');
        if (!itemsBox) return;

        const hasRx = cart.some(item => {
          if (item.rxRequired === true || item.rx === 'true' || item.rx === true) return true;
          var name = (item.name || '').toLowerCase();
          var cat = (item.cat || item.category || '').toLowerCase();
          if (cat.includes('prescription')) return true;
          const rxNames = ['brufen', 'flexon', 'allegra', 'glycomet', 'janumet', 'ecosprin', 'atorva', 'telma', 'amlodipine', 'losartan', 'folic acid', 'pan d', 'minoxidil', 'moxifloxacin'];
          return rxNames.some(rn => name.includes(rn));
        });

        const rxBanner = document.getElementById('checkout-rx-banner');
        if (hasRx) {
          rxBanner?.classList.remove('hidden');
        } else {
          rxBanner?.classList.add('hidden');
        }

        if (cart.length === 0) {
          itemsBox.innerHTML = '<p class="text-xs font-bold text-slate-400 py-3">Your cart is empty.</p>';
          return;
        }

        let subtotal = 0;
        let html = '';
        cart.forEach(item => {
          const qty = item.quantity || 1;
          const price = parseFloat(item.price || item.mrp || 0);
          const itemTotal = Math.round(price * qty);
          subtotal += itemTotal;

          html += `
            <div class="py-2.5 flex items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <img loading="lazy" src="${item.image || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg'}" class="w-8 h-8 rounded-lg object-cover bg-slate-50 p-0.5 border" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                <div class="min-w-0">
                  <h4 class="font-black text-slate-800 truncate max-w-[140px]">${item.displayName || item.name || item.originalName}</h4>
                  <p class="text-[10px] font-bold text-slate-400">Qty: ${qty} × ₹${price}</p>
                </div>
              </div>
              <span class="font-black text-slate-900 shrink-0">₹${itemTotal}</span>
            </div>
          `;
        });

        itemsBox.innerHTML = html;

        const taxFee = Math.round(subtotal * 0.05);
        const grandTotal = Math.max(0, Math.round(subtotal + deliveryFee + taxFee - discountAmount));
        const subtotalEl = document.getElementById('summary-mrp-subtotal');
        const taxChargeEl = document.getElementById('summary-tax-charge');
        const deliveryChargeEl = document.getElementById('summary-delivery-charge');
        const grandTotalEl = document.getElementById('summary-grand-total');

        if (subtotalEl) subtotalEl.textContent = `₹${subtotal}`;
        if (taxChargeEl) taxChargeEl.textContent = `₹${taxFee}`;
        if (deliveryChargeEl) deliveryChargeEl.textContent = `₹${deliveryFee}`;
        if (grandTotalEl) grandTotalEl.textContent = `₹${grandTotal}`;
      }

      // Place Order Button Handler
      document.getElementById('btn-place-order')?.addEventListener('click', () => {
        if (!selectedAddressObject) {
          alert('Please select or add a delivery address before placing your order!');
          return;
        }

        let cart = [];
        try {
          cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        if (cart.length === 0) {
          alert('Your cart is empty!');
          return;
        }

        const selectedPaymentCode = document.querySelector('input[name="payment-method"]:checked')?.value || 'UPI';
        const selectedPaymentReadable = paymentLabels[selectedPaymentCode] || selectedPaymentCode;
        const preferredStore = (document.getElementById('preferred-pharmacy-input')?.value || '').trim();
        const specialNotes = (document.getElementById('checkout-special-instructions')?.value || '').trim();

        const isMedicineOrder = cart.some(i => i.cat || i.category || i.brand || i.rxRequired);
        const hasRx = cart.some(item => item.rxRequired === true || item.rx === 'true');

        // Create Order Object
        const orderId = (hasRx ? 'RX-BHU-' : 'BHU-') + Math.floor(100000 + Math.random() * 900000);
        let subtotal = cart.reduce((acc, i) => acc + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

        let deliveryFee = 30;
        if (selectedAddressObject) {
          const shopLat = 21.0478;
          const shopLng = 75.7896;
          const destLat = selectedAddressObject.lat || 21.0478;
          const destLng = selectedAddressObject.lng || 75.7896;

          const dLat = (destLat - shopLat) * 111;
          const dLng = (destLng - shopLng) * 111 * Math.cos(destLat * Math.PI / 180);
          const straightKm = Math.sqrt(dLat * dLat + dLng * dLng);
          const roadKm = Math.max(1.0, parseFloat((straightKm * 1.35).toFixed(1)));
          deliveryFee = Math.round(30 + Math.max(0, roadKm - 3.0) * 10);
        }

        const activeCoupon = window.BhusawalCheckoutState?.state?.coupon || null;
        const discountAmount = activeCoupon ? activeCoupon.discountAmount : 0;
        const taxFee = Math.round(subtotal * 0.05);
        const grandTotal = Math.max(0, Math.round(subtotal + deliveryFee + taxFee - discountAmount));
        const activeSlot = window.BhusawalCheckoutState?.state?.slot || '⚡ Express Instant (~15-25 Mins)';

        const hasAgeRestricted = cart.some(i => window.BhusawalAgeVerification && window.BhusawalAgeVerification.isCigaretteItem(i));

        const newOrder = {
          id: orderId,
          uid: (window.BhusawalBackend && window.BhusawalBackend.db ? (window.BhusawalBackend.customers.getAll()[0]?.uid || '') : ''),
          customerId: (window.BhusawalBackend && window.BhusawalBackend.db ? (window.BhusawalBackend.customers.getAll()[0]?.customerId || '') : ''),
          customerPhone: (window.BhusawalBackend && window.BhusawalBackend.db ? (window.BhusawalBackend.customers.getAll()[0]?.phoneNumber || '') : ''),
          isAgeRestricted: hasAgeRestricted,
          requiresAgeVerification: hasAgeRestricted,
          ageVerificationStatus: hasAgeRestricted ? 'VERIFIED_18_PLUS' : 'N/A',
          type: hasRx ? 'PRESCRIPTION' : (isMedicineOrder ? 'MEDICINE' : 'STANDARD'),
          date: new Date().toISOString(),
          createdAt: new Date().toISOString(),
          status: hasRx ? 'Under Verification' : 'Confirmed',
          items: cart,
          subtotal: subtotal,
          tax: taxFee,
          taxFee: taxFee,
          deliveryFee: deliveryFee,
          discount: discountAmount,
          coupon: activeCoupon,
          slot: activeSlot,
          total: grandTotal,
          selectedAddressId: selectedAddressId,
          selectedAddress: selectedAddressObject ? selectedAddressObject.full : '',
          address: selectedAddressObject ? selectedAddressObject.full : '',
          lat: currentLat,
          lng: currentLng,
          latitude: currentLat,
          longitude: currentLng,
          payment: selectedPaymentReadable,
          paymentMethod: selectedPaymentReadable,
          paymentCode: selectedPaymentCode,
          storeName: preferredStore || 'Nearby Verified Partner Pharmacy',
          notes: specialNotes,
          rxStatus: hasRx ? 'Prescription Verification Required Before Dispatch' : 'Verified'
        };

        // Smart Order Assignment (GPS Road Distance & Shortest ETA Priority)
        if (window.BhusawalSmartDispatcher) {
          window.BhusawalSmartDispatcher.assignNearestRider(newOrder);
        } else {
          newOrder.assignedRider = 'Rahul Ramesh Patil';
          newOrder.riderPhone = '9876543210';
          newOrder.etaMins = 8;
          newOrder.roadDistanceKm = 1.8;
        }

        // Save order to history via BhusawalBackend
        if (window.BhusawalBackend) {
          window.BhusawalBackend.orders.create(newOrder);
        } else {
          let orders = [];
          try {
            orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
          } catch(e) {}
          orders.unshift(newOrder);
          localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
        }

        localStorage.setItem('bhusawal_active_order', JSON.stringify(newOrder));
        window.dispatchEvent(new Event('orderUpdated'));

        // Clear Cart
        localStorage.removeItem('bhusawal_cart');

        // Redirect to Confirmation or Tracking
        if (hasRx) {
          window.location.href = `/track_order?id=${orderId}`;
        } else {
          window.location.href = `/order_confirmation?orderId=${orderId}`;
        }
      });

      // Initial Calls
      setSelectedPaymentMethod(selectedPaymentMethod);
      renderSavedAddresses();
      initLeafletMap(21.0478, 75.7896);
      renderCartSummary();
    });
  </script>
</body>
</html>
