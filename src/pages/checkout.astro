        <!-- Address Tag / Label Selector -->
        <div>
          <label class="text-[11px] font-black text-slate-700 block uppercase mb-1">Address Label / Tag *</label>
          <div class="flex items-center gap-2 flex-wrap" id="modal-tag-selector-group">
            <button type="button" class="tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-blueBrand text-white border-blueBrand shadow-xs" data-tag="Home">📍 Home</button>
            <button type="button" class="tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200" data-tag="Work">💼 Work</button>
            <button type="button" class="tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200" data-tag="Office">🏢 Office</button>
            <button type="button" class="tag-selector-btn px-3 py-1.5 rounded-xl border text-xs font-black transition-all bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200" data-tag="Other">📌 Other</button>
