---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <script is:inline src="/bhusawal_age_verification.js"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout & Delivery Address | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- Leaflet Map CSS & JS for Interactive Location Picker -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="/assets/smart_assignment_engine.js"></script>
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_dispatch_engine.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>

  <!-- TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF',
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE',
            emeraldBrand: '#10B981'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    #checkout-leaflet-map { height: 220px; width: 100%; border-radius: 1.5rem; z-index: 1; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/cart" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-blueBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- Estimated Delivery Time Widget -->
    <div class="flex items-center gap-2 bg-blueLight text-blueBrand px-3.5 py-1.5 rounded-full border border-blue-200 shadow-xs">
      <span class="w-2.5 h-2.5 rounded-full bg-blueBrand animate-ping"></span>
      <span class="text-xs font-black">⚡ Express Delivery: ~20 Mins</span>
    </div>
  </header>

  <!-- MAIN CHECKOUT GRID -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE TITLE & STEP INDICATOR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900" id="checkout-title">Order Checkout</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5">Select delivery address, map pin location & payment method</p>
      </div>

      <!-- Step Indicator -->
      <div class="flex items-center gap-2 text-xs font-extrabold">
        <span class="text-slate-400">Cart</span>
        <span class="text-slate-300">→</span>
        <span class="px-3 py-1 rounded-full bg-blueBrand text-white font-black">Address & Checkout</span>
        <span class="text-slate-300">→</span>
        <span class="text-slate-400">Confirmation</span>
      </div>
    </div>

    <!-- PRESCRIPTION STATUS BANNER (If Medicine / Rx items exist) -->
    <div id="checkout-rx-banner" class="hidden bg-amber-50 border-2 border-amber-300 rounded-3xl p-4 sm:p-5 shadow-sm space-y-2">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 font-black shadow-xs">
          📋
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-black text-amber-900 uppercase tracking-wider">Prescription Status</h3>
            <span class="px-2 py-0.5 rounded-full bg-amber-200 text-amber-900 text-[10px] font-black" id="checkout-rx-status-badge">Verification Required</span>
          </div>
          <p class="text-xs font-semibold text-amber-800 mt-0.5" id="checkout-rx-status-desc">
            Prescription Verification Required Before Dispatch. Certified partner pharmacist will verify details upon order placement.
          </p>
        </div>
      </div>
    </div>

    <!-- CHECKOUT MAIN RESPONSIVE GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- LEFT 7 COLS: ADDRESS SELECTION, MAP PICKER, PREFERRED PHARMACY & PAYMENT METHOD -->
      <div class="lg:col-span-7 space-y-6">

        <!-- 1. MANDATORY ADDRESS SELECTION & MAP CONTAINER -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-5">
          
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-black font-display text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-blueBrand text-2xl">location_on</span>
                <span>Saved Address & Delivery Location</span>
              </h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Choose a saved address or pin your exact location</p>
            </div>
            <button id="btn-open-address-modal" class="px-3.5 py-1.5 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl transition-all shadow-xs flex items-center gap-1 active:scale-95">
              <span>+ Add New Address</span>
            </button>
          </div>

          <!-- TWO LOCATION PICKER OPTIONS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            
            <!-- Option 1: Use Current Location (GPS) -->
            <button id="btn-use-current-gps" type="button" class="p-4 rounded-2xl border-2 border-blue-200 bg-blueLight/60 hover:bg-blueLight text-left transition-all group flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-blueBrand text-white flex items-center justify-center font-black shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-xl">my_location</span>
              </div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Current GPS Location</h3>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">Detect exact doorstep GPS coordinates</p>
              </div>
            </button>

            <!-- Option 2: Select Location on Google Maps -->
            <button id="btn-select-google-maps" type="button" class="p-4 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-left transition-all group flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-xl">map</span>
              </div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Interactive Map Pin Picker</h3>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">Drag pin to set exact building or doorstep</p>
              </div>
            </button>

          </div>

          <!-- ADDRESS SEARCH & BHUSAWAL AREA QUICK PRESET SELECTOR -->
          <div class="space-y-2.5 pt-2 border-t border-slate-100">
            <label class="text-xs font-black text-slate-700 flex items-center justify-between">
              <span>🔍 Search Address or Landmark in Bhusawal:</span>
              <span class="text-[10px] font-bold text-blueBrand">HD Google Maps Vector API</span>
            </label>

            <div class="flex items-center gap-2">
              <div class="relative flex-1">
                <input 
                  type="text" 
                  id="checkout-search-address-input"
                  placeholder="Search street, colony, or landmark (e.g. Station Road, Shivaji Nagar...)" 
                  class="w-full bg-slate-50 border border-slate-200 rounded-2xl pl-9 pr-4 py-2.5 text-xs font-extrabold text-slate-900 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-slate-400"
                />
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-lg">search</span>
              </div>
              <button id="btn-search-address" type="button" class="px-4 py-2.5 bg-blueBrand hover:bg-blueDark text-white font-black text-xs rounded-2xl shrink-0 transition-all shadow-md">
                Search
              </button>
            </div>

            <!-- BHUSAWAL AREA PRESET PILLS -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-[11px] font-extrabold">
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider shrink-0">Quick Area:</span>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0478" data-lng="75.7896" data-name="Station Road Market">📍 Station Road</button>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0512" data-lng="75.7920" data-name="Jamner Road Commercial Hub">📍 Jamner Road</button>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0450" data-lng="75.7850" data-name="Shivaji Nagar Colony">📍 Shivaji Nagar</button>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0400" data-lng="75.7800" data-name="Varangaon Road Housing">📍 Varangaon Road</button>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0550" data-lng="75.7980" data-name="Nahata College Area">📍 Nahata College</button>
              <button type="button" class="area-pill-btn px-3 py-1 rounded-xl bg-slate-100 hover:bg-blueLight hover:text-blueBrand text-slate-700 border border-slate-200 shrink-0 transition-all" data-lat="21.0350" data-lng="75.7700" data-name="Ordnance Factory Township">📍 Ordnance Factory</button>
            </div>
          </div>

          <!-- SAVED ADDRESSES LIST -->
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider">Saved Addresses</h3>
            <div id="saved-addresses-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Dynamically populated by JS -->
            </div>
          </div>

          <!-- LIVE MAP DISPLAY & DOORSTEP LOCATION VERIFICATION CARD -->
          <div class="space-y-2.5 pt-2 border-t border-slate-100">
            <div class="flex items-center justify-between text-xs font-black text-slate-700">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-blueBrand text-sm">map</span>
                Live Doorstep Pin Location on Google Map
              </span>
              <span id="display-lat-lng" class="text-[10px] font-mono text-blueBrand bg-blueLight px-2 py-0.5 rounded-md border border-blue-200">Lat: 21.0478, Lng: 75.7896</span>
            </div>

            <!-- MAP CANVAS -->
            <div id="checkout-leaflet-map" class="h-64 rounded-2xl shadow-inner border border-slate-200 overflow-hidden relative"></div>

            <!-- DOORSTEP VERIFICATION CARD -->
            <div class="p-3.5 bg-slate-900 text-white rounded-2xl border border-slate-800 space-y-1 shadow-md">
              <div class="flex items-center justify-between text-[10px] font-bold text-blue-400 uppercase tracking-wider">
                <span>📍 Doorstep Delivery Destination Preview:</span>
                <span>GPS High Accuracy</span>
              </div>
              <p id="checkout-doorstep-preview" class="text-xs font-black text-white leading-relaxed">
                Station Road Market, Bhusawal, Maharashtra 425201
              </p>
              <p class="text-[10px] text-slate-400 font-semibold italic">
                Rider will follow Google Maps driving route to this exact doorstep pin location.
              </p>
            </div>
          </div>

        </div>

        <!-- 2. PREFERRED MEDICAL STORE SECTION -->
        <div id="preferred-store-card" class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-2xl">local_pharmacy</span>
            <div>
              <h2 class="text-lg font-black font-display text-slate-900">Preferred Medical Store (Optional)</h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Specify a favorite pharmacy in Bhusawal or leave empty for auto-assignment</p>
            </div>
          </div>

          <div class="space-y-2">
            <input 
              type="text" 
              id="preferred-pharmacy-input"
              placeholder="e.g. Apollo Pharmacy Station Road, MedPlus Jamner Road..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-extrabold text-slate-900 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-slate-400"
            />
            
            <div id="pharmacy-notice-default" class="p-3 rounded-2xl bg-blueLight/60 border border-blue-200 text-xs font-bold text-blueBrand flex items-center gap-2">
              <span class="material-symbols-outlined text-base">info</span>
              <span id="pharmacy-notice-text">We will source your medicines from a nearby verified partner pharmacy.</span>
            </div>
          </div>
        </div>

        <!-- 3. SPECIAL INSTRUCTIONS SECTION -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-2xl">edit_note</span>
            <div>
              <h2 class="text-lg font-black font-display text-slate-900">Special Instructions</h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Add packaging or delivery notes for store & rider</p>
            </div>
          </div>

          <textarea 
            id="checkout-special-instructions"
            rows="2"
            placeholder="e.g. Leave parcel at security desk, call before arriving, include extra carry bag..."
            class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3.5 text-xs font-semibold text-slate-800 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-slate-400"
          ></textarea>
        </div>

        <!-- 3B. PROMO CODE / COUPON CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-blueBrand text-2xl">local_offer</span>
              <div>
                <h2 class="text-lg font-black font-display text-slate-900">Apply Promo Coupon</h2>
                <p class="text-xs font-bold text-slate-400 mt-0.5">Use discount codes like WELCOME50, BHUSAWAL10, BHUSAWALCONNECT</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <input 
              type="text" 
              id="checkout-coupon-input" 
              placeholder="Enter Promo Code (e.g. WELCOME50)" 
              class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-black uppercase tracking-wider text-slate-900 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-normal"
            />
            <button id="btn-apply-coupon" type="button" class="px-5 py-3 bg-slate-900 hover:bg-slate-800 text-white font-black text-xs rounded-2xl shrink-0 transition-all">
              Apply
            </button>
          </div>

          <div id="applied-coupon-badge" class="hidden p-3 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-800 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span>🎉 Promo <strong id="applied-coupon-code-name">WELCOME50</strong> applied!</span>
              <span id="applied-coupon-savings-text" class="text-emerald-700 font-extrabold">(Saved ₹50)</span>
            </span>
            <button id="btn-remove-coupon" type="button" class="text-rose-600 font-black hover:underline text-xs">✕ Remove</button>
          </div>
        </div>

        <!-- 3C. DELIVERY SLOT SELECTION CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-blueBrand text-2xl">schedule</span>
              <div>
                <h2 class="text-lg font-black font-display text-slate-900">Delivery Time Slot</h2>
                <p class="text-xs font-bold text-slate-400 mt-0.5">Choose express instant delivery or schedule for later</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="delivery-slot-group">
            <button type="button" class="slot-btn p-3.5 rounded-2xl border-2 border-blueBrand bg-blueLight/40 text-left transition-all flex items-center justify-between" data-slot="⚡ Express Instant (~15-25 Mins)">
              <div>
                <span class="text-xs font-black text-slate-900 block">⚡ Express Instant</span>
                <span class="text-[10px] font-bold text-slate-500">Delivered in ~15 to 25 mins</span>
              </div>
              <span class="slot-check text-xs font-black text-blueBrand">✓</span>
            </button>

            <button type="button" class="slot-btn p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all hover:border-blue-300 flex items-center justify-between" data-slot="🌅 Evening Slot (5 PM - 7 PM)">
              <div>
                <span class="text-xs font-black text-slate-900 block">🌅 Evening Slot</span>
                <span class="text-[10px] font-bold text-slate-500">Today 5:00 PM - 7:00 PM</span>
              </div>
              <span class="slot-check hidden text-xs font-black text-blueBrand">✓</span>
            </button>

            <button type="button" class="slot-btn p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all hover:border-blue-300 flex items-center justify-between" data-slot="🌙 Night Slot (8 PM - 10 PM)">
              <div>
                <span class="text-xs font-black text-slate-900 block">🌙 Night Slot</span>
                <span class="text-[10px] font-bold text-slate-500">Today 8:00 PM - 10:00 PM</span>
              </div>
              <span class="slot-check hidden text-xs font-black text-blueBrand">✓</span>
            </button>

            <button type="button" class="slot-btn p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all hover:border-blue-300 flex items-center justify-between" data-slot="☀️ Tomorrow Morning (9 AM - 11 AM)">
              <div>
                <span class="text-xs font-black text-slate-900 block">☀️ Tomorrow Morning</span>
                <span class="text-[10px] font-bold text-slate-500">Tomorrow 9:00 AM - 11:00 AM</span>
              </div>
              <span class="slot-check hidden text-xs font-black text-blueBrand">✓</span>
            </button>
          </div>
        </div>
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h2 class="text-lg font-black font-display text-slate-900 flex items-center gap-2">
              <span class="material-symbols-outlined text-blueBrand text-2xl">payments</span>
              <span>Select Payment Method</span>
            </h2>
            <span id="selected-payment-badge" class="px-3 py-1 rounded-full bg-blueLight text-blueBrand text-xs font-black">
              📱 Instant UPI (Selected)
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="payment-options-grid">
            
            <!-- 1. Instant UPI -->
            <label class="payment-card p-4 rounded-2xl border-2 border-blueBrand bg-blueLight/40 shadow-sm flex items-center justify-between cursor-pointer transition-all" data-method="UPI">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment-method" value="UPI" checked class="accent-blueBrand w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">📱 Instant UPI</span>
                  <span class="text-[10px] font-bold text-slate-400">GPay, PhonePe, Paytm, BHIM</span>
                </div>
              </div>
              <span class="check-badge text-xs text-blueBrand font-black">✓</span>
            </label>

            <!-- 2. Cash on Delivery -->
            <label class="payment-card p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-blue-300 flex items-center justify-between cursor-pointer transition-all" data-method="COD">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment-method" value="COD" class="accent-blueBrand w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">💵 Cash on Delivery</span>
                  <span class="text-[10px] font-bold text-slate-400">Pay cash/UPI at doorstep</span>
                </div>
              </div>
              <span class="check-badge hidden text-xs text-blueBrand font-black">✓</span>
            </label>

            <!-- 3. Credit Card -->
            <label class="payment-card p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-blue-300 flex items-center justify-between cursor-pointer transition-all" data-method="CREDIT_CARD">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment-method" value="CREDIT_CARD" class="accent-blueBrand w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">💳 Credit Card</span>
                  <span class="text-[10px] font-bold text-slate-400">Visa, Mastercard, RuPay, Amex</span>
                </div>
              </div>
              <span class="check-badge hidden text-xs text-blueBrand font-black">✓</span>
            </label>

            <!-- 4. Debit Card -->
            <label class="payment-card p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-blue-300 flex items-center justify-between cursor-pointer transition-all" data-method="DEBIT_CARD">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment-method" value="DEBIT_CARD" class="accent-blueBrand w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">🏦 Debit Card</span>
