---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout & Delivery Address | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- Leaflet Map CSS & JS for Interactive Location Picker -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF',
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE',
            emeraldBrand: '#10B981'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    #checkout-leaflet-map { height: 220px; width: 100%; border-radius: 1.5rem; z-index: 1; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/cart" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-blueBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- Estimated Delivery Time Widget -->
    <div class="flex items-center gap-2 bg-blueLight text-blueBrand px-3.5 py-1.5 rounded-full border border-blue-200 shadow-xs">
      <span class="w-2.5 h-2.5 rounded-full bg-blueBrand animate-ping"></span>
      <span class="text-xs font-black">⚡ Express Delivery: ~20 Mins</span>
    </div>
  </header>

  <!-- MAIN CHECKOUT GRID -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE TITLE & STEP INDICATOR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900" id="checkout-title">Order Checkout</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5">Select delivery address, map pin location & payment method</p>
      </div>

      <!-- Step Indicator -->
      <div class="flex items-center gap-2 text-xs font-extrabold">
        <span class="text-slate-400">Cart</span>
        <span class="text-slate-300">→</span>
        <span class="px-3 py-1 rounded-full bg-blueBrand text-white font-black">Address & Checkout</span>
        <span class="text-slate-300">→</span>
        <span class="text-slate-400">Confirmation</span>
      </div>
    </div>

    <!-- PRESCRIPTION STATUS BANNER (If Medicine / Rx items exist) -->
    <div id="checkout-rx-banner" class="hidden bg-amber-50 border-2 border-amber-300 rounded-3xl p-4 sm:p-5 shadow-sm space-y-2">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 font-black shadow-xs">
          📋
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-black text-amber-900 uppercase tracking-wider">Prescription Status</h3>
            <span class="px-2 py-0.5 rounded-full bg-amber-200 text-amber-900 text-[10px] font-black" id="checkout-rx-status-badge">Verification Required</span>
          </div>
          <p class="text-xs font-semibold text-amber-800 mt-0.5" id="checkout-rx-status-desc">
            Prescription Verification Required Before Dispatch. Certified partner pharmacist will verify details upon order placement.
          </p>
        </div>
      </div>
    </div>

    <!-- CHECKOUT MAIN RESPONSIVE GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- LEFT 7 COLS: ADDRESS SELECTION, MAP PICKER, PREFERRED PHARMACY & PAYMENT METHOD -->
      <div class="lg:col-span-7 space-y-6">

        <!-- 1. MANDATORY ADDRESS SELECTION & MAP CONTAINER -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-5">
          
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-black font-display text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-blueBrand text-2xl">location_on</span>
                <span>Saved Address & Delivery Location</span>
              </h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Choose a saved address or pin your exact location</p>
            </div>
            <button id="btn-open-address-modal" class="px-3.5 py-1.5 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl transition-all shadow-xs flex items-center gap-1 active:scale-95">
              <span>+ Add New Address</span>
            </button>
          </div>

          <!-- TWO LOCATION PICKER OPTIONS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            
            <!-- Option 1: Use Current Location (GPS) -->
            <button id="btn-use-current-gps" class="p-4 rounded-2xl border-2 border-blue-200 bg-blueLight/60 hover:bg-blueLight text-left transition-all group flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-blueBrand text-white flex items-center justify-center font-black shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-xl">my_location</span>
              </div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Current Location</h3>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">Detect live GPS coordinates</p>
              </div>
            </button>

            <!-- Option 2: Select Location on Google Maps -->
            <button id="btn-select-google-maps" class="p-4 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-left transition-all group flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-xl">map</span>
              </div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Google Maps Address Picker</h3>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">Drag pin to set doorstep</p>
              </div>
            </button>

          </div>

          <!-- SAVED ADDRESSES LIST -->
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider">Saved Address</h3>
            <div id="saved-addresses-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Dynamically populated by JS -->
            </div>
          </div>

          <!-- LIVE MAP DISPLAY FOR SELECTED LOCATION -->
          <div class="space-y-2 pt-2 border-t border-slate-100">
            <div class="flex items-center justify-between text-xs font-black text-slate-700">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-blueBrand text-sm">map</span>
                Selected Pin Location on Map
              </span>
              <span id="display-lat-lng" class="text-[10px] font-mono text-blueBrand bg-blueLight px-2 py-0.5 rounded-md">Lat: 21.0478, Lng: 75.7896</span>
            </div>
            <div id="checkout-leaflet-map" class="shadow-inner border border-slate-200"></div>
          </div>

        </div>

        <!-- 2. PREFERRED MEDICAL STORE SECTION -->
        <div id="preferred-store-card" class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-2xl">local_pharmacy</span>
            <div>
              <h2 class="text-lg font-black font-display text-slate-900">Preferred Medical Store (Optional)</h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Specify a favorite pharmacy in Bhusawal or leave empty for auto-assignment</p>
            </div>
          </div>

          <div class="space-y-2">
            <input 
              type="text" 
              id="preferred-pharmacy-input"
              placeholder="e.g. Apollo Pharmacy Station Road, MedPlus Jamner Road..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-extrabold text-slate-900 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-slate-400"
            />
            
            <div id="pharmacy-notice-default" class="p-3 rounded-2xl bg-blueLight/60 border border-blue-200 text-xs font-bold text-blueBrand flex items-center gap-2">
              <span class="material-symbols-outlined text-base">info</span>
              <span id="pharmacy-notice-text">We will source your medicines from a nearby verified partner pharmacy.</span>
            </div>
          </div>
        </div>

        <!-- 3. SPECIAL INSTRUCTIONS SECTION -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-2xl">edit_note</span>
            <div>
              <h2 class="text-lg font-black font-display text-slate-900">Special Instructions</h2>
              <p class="text-xs font-bold text-slate-400 mt-0.5">Add packaging or delivery notes for store & rider</p>
            </div>
          </div>

          <textarea 
            id="checkout-special-instructions"
            rows="2"
            placeholder="e.g. Leave parcel at security desk, call before arriving, include extra carry bag..."
            class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3.5 text-xs font-semibold text-slate-800 outline-none focus:border-blueBrand focus:bg-white transition-all placeholder-slate-400"
          ></textarea>
        </div>

        <!-- 4. PAYMENT METHOD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <h2 class="text-lg font-black font-display text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-2xl">payments</span>
            <span>Payment Method</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="p-4 rounded-2xl border-2 border-blueBrand bg-blueLight/40 flex items-center gap-3 cursor-pointer">
              <input type="radio" name="payment-method" value="UPI" checked class="accent-blueBrand w-4 h-4" />
              <div>
                <span class="text-xs font-black text-slate-900 block">Instant UPI QR</span>
                <span class="text-[10px] font-bold text-slate-400">GPay, PhonePe, Paytm</span>
              </div>
            </label>

            <label class="p-4 rounded-2xl border-2 border-slate-200 bg-white hover:bg-slate-50 flex items-center gap-3 cursor-pointer">
              <input type="radio" name="payment-method" value="COD" class="accent-blueBrand w-4 h-4" />
              <div>
                <span class="text-xs font-black text-slate-900 block">Cash on Delivery</span>
                <span class="text-[10px] font-bold text-slate-400">Pay at Doorstep</span>
              </div>
            </label>

            <label class="p-4 rounded-2xl border-2 border-slate-200 bg-white hover:bg-slate-50 flex items-center gap-3 cursor-pointer">
              <input type="radio" name="payment-method" value="CARD" class="accent-blueBrand w-4 h-4" />
              <div>
                <span class="text-xs font-black text-slate-900 block">Card / NetBanking</span>
                <span class="text-[10px] font-bold text-slate-400">Visa, Mastercard</span>
              </div>
            </label>
          </div>
        </div>

      </div>

      <!-- RIGHT 5 COLS: ORDER SUMMARY & PLACE ORDER -->
      <div class="lg:col-span-5 space-y-6">

        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4 sticky top-24">
          <h2 class="text-lg font-black font-display text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="material-symbols-outlined text-blueBrand text-xl">receipt_long</span>
            <span>Order Summary</span>
          </h2>

          <!-- Cart Items Preview -->
          <div id="checkout-cart-items" class="divide-y divide-slate-100 max-h-56 overflow-y-auto no-scrollbar">
            <!-- Dynamically populated items -->
          </div>

          <!-- Price Breakdown -->
          <div class="border-t border-slate-200 pt-4 space-y-2.5 text-xs font-bold text-slate-600">
            <div class="flex justify-between">
              <span>Item Subtotal:</span>
              <span id="summary-mrp-subtotal" class="text-slate-900 font-extrabold">₹0</span>
            </div>
            <div class="flex justify-between">
              <span>Delivery Fee (Fixed):</span>
              <span class="text-slate-900 font-extrabold">₹30</span>
            </div>
            <div class="flex justify-between text-sm font-black text-slate-900 pt-3 border-t border-slate-200">
              <span>Grand Total:</span>
              <span id="summary-grand-total" class="text-blueBrand text-xl font-black font-display">₹30</span>
            </div>
          </div>

          <!-- Selected Address Summary Box -->
          <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200 space-y-1">
            <span class="text-[10px] font-black text-blueBrand uppercase tracking-wider block">Deliver To:</span>
            <p id="summary-selected-address" class="text-xs font-extrabold text-slate-900 line-clamp-2">
              Select or add an address above
            </p>
          </div>

          <!-- PLACE ORDER BUTTON -->
          <button id="btn-place-order" class="w-full py-4 bg-blueBrand hover:bg-blueDark text-white font-black text-sm rounded-2xl shadow-xl shadow-blue-900/20 active:scale-95 transition-all flex items-center justify-center gap-2">
            <span>Place Order</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </div>

      </div>

    </div>

  </main>

  <!-- ADD / EDIT ADDRESS MODAL -->
  <div id="address-form-modal" class="fixed inset-0 z-[10000] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-4 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      
      <button id="close-address-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>

      <div>
        <h2 class="text-xl font-black font-display text-slate-900">Add Complete Delivery Address</h2>
        <p class="text-xs font-bold text-slate-400 mt-0.5">Provide detailed location information for fast delivery</p>
      </div>

      <!-- DETECTED LAT/LNG DISPLAY BADGE -->
      <div class="p-2.5 bg-blueLight rounded-xl border border-blue-100 flex items-center justify-between text-xs font-bold text-blueBrand">
        <span>📍 Detected Coordinates:</span>
        <span id="modal-lat-lng-text" class="font-mono text-[11px]">Lat: 21.0478, Lng: 75.7896</span>
      </div>

      <!-- ADDRESS FORM FIELDS -->
      <form id="address-details-form" class="space-y-3 text-left">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Full Name *</label>
            <input type="text" id="field-name" required placeholder="Sahil Patel" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Mobile Number *</label>
            <input type="tel" id="field-phone" required maxlength="10" placeholder="9923456789" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">House / Flat No. *</label>
            <input type="text" id="field-house" required placeholder="Plot 42 / Flat 3B" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Building Name</label>
            <input type="text" id="field-building" placeholder="Gokul Heights" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

        <div>
          <label class="text-[11px] font-black text-slate-700 block uppercase">Street / Road Name *</label>
          <input type="text" id="field-street" required placeholder="Station Road / Varangaon Road" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Area / Colony *</label>
            <input type="text" id="field-area" required placeholder="Shivaji Nagar" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Landmark</label>
            <input type="text" id="field-landmark" placeholder="Near Railway Station" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">City *</label>
            <input type="text" id="field-city" value="Bhusawal" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">PIN Code *</label>
            <input type="text" id="field-pincode" value="425201" required maxlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

        <div class="pt-2 flex items-center gap-2">
          <input type="checkbox" id="field-save-profile" checked class="accent-blueBrand w-4 h-4" />
          <label for="field-save-profile" class="text-xs font-bold text-slate-700">Save this address to my profile for future orders</label>
        </div>

        <button type="submit" class="w-full py-3.5 bg-blueBrand hover:bg-blueDark text-white font-black text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-1.5 mt-2">
          <span class="material-symbols-outlined text-base">check</span>
          <span>Save & Use Address</span>
        </button>

      </form>
    </div>
  </div>

  <Switcher />

  <!-- CLIENT-SIDE CHECKOUT & ADDRESS ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      let map, marker;
      let currentLat = 21.0478;
      let currentLng = 75.7896;
      let selectedAddressObject = null;

      // Default Bhusawal addresses
      const DEFAULT_ADDRESSES = [
        {
          id: 'A1',
          name: 'Sahil Patel',
          phone: '9923456789',
          tag: 'Home',
          full: 'Plot 42, Near Station Road, Varangaon Road, Bhusawal',
          lat: 21.0478,
          lng: 75.7896
        },
        {
          id: 'A2',
          name: 'Sahil Patel',
          phone: '9923456789',
          tag: 'Work',
          full: 'Shop 12, Main Market, Jamner Road, Bhusawal',
          lat: 21.0512,
          lng: 75.7920
        }
      ];

      function getSavedAddresses() {
        try {
          const stored = JSON.parse(localStorage.getItem('bhusawal_user_addresses') || '[]');
          if (Array.isArray(stored) && stored.length > 0) return stored;
        } catch(e) {}
        return DEFAULT_ADDRESSES;
      }

      function saveAddressToProfile(addr) {
        let addresses = getSavedAddresses();
        addresses.push(addr);
        localStorage.setItem('bhusawal_user_addresses', JSON.stringify(addresses));
        renderSavedAddresses();
      }

      // Initialize Leaflet Map / Location Picker
      function initLeafletMap(lat, lng) {
        currentLat = lat;
        currentLng = lng;

        const mapContainer = document.getElementById('checkout-leaflet-map');
        if (!mapContainer) return;

        if (!map) {
          map = L.map('checkout-leaflet-map').setView([lat, lng], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
          }).addTo(map);

          marker = L.marker([lat, lng], { draggable: true }).addTo(map);

          // Update coordinates on drag end
          marker.on('dragend', function (e) {
            const position = marker.getLatLng();
            updateLatLngDisplay(position.lat, position.lng);
          });

          map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateLatLngDisplay(e.latlng.lat, e.latlng.lng);
          });
        } else {
          map.setView([lat, lng], 15);
          marker.setLatLng([lat, lng]);
        }

        updateLatLngDisplay(lat, lng);
      }

      function updateLatLngDisplay(lat, lng) {
        currentLat = parseFloat(lat).toFixed(4);
        currentLng = parseFloat(lng).toFixed(4);
        document.getElementById('display-lat-lng').textContent = `Lat: ${currentLat}, Lng: ${currentLng}`;
        document.getElementById('modal-lat-lng-text').textContent = `Lat: ${currentLat}, Lng: ${currentLng}`;
      }

      // Render Saved Addresses List
      function renderSavedAddresses() {
        const grid = document.getElementById('saved-addresses-grid');
        const addresses = getSavedAddresses();
        if (!grid) return;

        let html = '';
        addresses.forEach((addr, idx) => {
          const isSelected = idx === 0;
          if (isSelected && !selectedAddressObject) {
            selectedAddressObject = addr;
            updateSelectedAddressUI(addr);
          }

          html += `
            <div class="saved-addr-card p-3.5 rounded-2xl border-2 ${isSelected ? 'border-blueBrand bg-blueLight/50' : 'border-slate-200 bg-white'} cursor-pointer transition-all hover:border-blue-300" data-idx="${idx}">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-black text-blueBrand flex items-center gap-1">📍 ${addr.tag || 'Address'}</span>
                ${isSelected ? '<span class="w-4 h-4 rounded-full bg-blueBrand flex items-center justify-center text-white text-[9px] font-black">✓</span>' : ''}
              </div>
              <p class="text-xs font-black text-slate-900">${addr.name || 'Customer'}</p>
              <p class="text-[11px] font-bold text-slate-500 line-clamp-2 mt-0.5">${addr.full}</p>
            </div>
          `;
        });

        grid.innerHTML = html;

        grid.querySelectorAll('.saved-addr-card').forEach(card => {
          card.onclick = () => {
            const idx = parseInt(card.dataset.idx);
            const addr = addresses[idx];
            if (addr) {
              selectedAddressObject = addr;
              updateSelectedAddressUI(addr);
              renderSavedAddresses();
            }
          };
        });
      }

      function updateSelectedAddressUI(addr) {
        document.getElementById('summary-selected-address').textContent = `${addr.name} (+91 ${addr.phone}) - ${addr.full}`;
        if (addr.lat && addr.lng) {
          initLeafletMap(addr.lat, addr.lng);
        }
      }

      // 1. Current Location GPS Handler
      document.getElementById('btn-use-current-gps')?.addEventListener('click', () => {
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              initLeafletMap(lat, lng);
              alert(`GPS location detected! Latitude: ${lat.toFixed(4)}, Longitude: ${lng.toFixed(4)}.`);
              openAddressModal(lat, lng);
            },
            (err) => {
              alert('Unable to retrieve live GPS location. Using default Bhusawal coordinates (21.0478, 75.7896).');
              initLeafletMap(21.0478, 75.7896);
              openAddressModal(21.0478, 75.7896);
            }
          );
        } else {
          openAddressModal(21.0478, 75.7896);
        }
      });

      // 2. Google Maps Location Picker Handler
      document.getElementById('btn-select-google-maps')?.addEventListener('click', () => {
        initLeafletMap(currentLat, currentLng);
        openAddressModal(currentLat, currentLng);
      });

      function openAddressModal(lat, lng) {
        updateLatLngDisplay(lat, lng);
        document.getElementById('address-form-modal').classList.remove('hidden');
      }

      document.getElementById('btn-open-address-modal')?.addEventListener('click', () => {
        openAddressModal(currentLat, currentLng);
      });

      document.getElementById('close-address-modal')?.addEventListener('click', () => {
        document.getElementById('address-form-modal').classList.add('hidden');
      });

      // Save Address Form Submission
      document.getElementById('address-details-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('field-name').value;
        const phone = document.getElementById('field-phone').value;
        const house = document.getElementById('field-house').value;
        const building = document.getElementById('field-building').value;
        const street = document.getElementById('field-street').value;
        const area = document.getElementById('field-area').value;
        const landmark = document.getElementById('field-landmark').value;
        const city = document.getElementById('field-city').value;
        const pincode = document.getElementById('field-pincode').value;

        const fullAddr = `${house}, ${building ? building + ', ' : ''}${street}, ${area}, ${landmark ? 'Near ' + landmark + ', ' : ''}${city} - ${pincode}`;

        const newAddrObj = {
          id: 'A-' + Math.random(),
          name,
          phone,
          tag: 'Saved',
          full: fullAddr,
          lat: currentLat,
          lng: currentLng
        };

        selectedAddressObject = newAddrObj;
        saveAddressToProfile(newAddrObj);
        updateSelectedAddressUI(newAddrObj);

        document.getElementById('address-form-modal').classList.add('hidden');
        alert('Delivery address saved successfully!');
      });

      // Preferred Pharmacy input handler
      const prefInput = document.getElementById('preferred-pharmacy-input');
      const noticeText = document.getElementById('pharmacy-notice-text');

      if (prefInput) {
        prefInput.value = localStorage.getItem('bhusawal_preferred_pharmacy') || '';
        if (prefInput.value.trim() && noticeText) {
          noticeText.textContent = `Order will be requested from ${prefInput.value.trim()}.`;
        }

        prefInput.addEventListener('input', () => {
          const val = prefInput.value.trim();
          localStorage.setItem('bhusawal_preferred_pharmacy', val);
          if (val) {
            noticeText.textContent = `Order will be requested from ${val}.`;
          } else {
            noticeText.textContent = `We will source your medicines from a nearby verified partner pharmacy.`;
          }
        });
      }

      // Special Instructions
      const specInstInput = document.getElementById('checkout-special-instructions');
      if (specInstInput) {
        specInstInput.value = localStorage.getItem('bhusawal_cart_notes') || '';
        specInstInput.addEventListener('input', () => {
          localStorage.setItem('bhusawal_cart_notes', specInstInput.value);
        });
      }

      // Render Cart Summary Items & Calculations
      function renderCartSummary() {
        let cart = [];
        try {
          cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        const itemsBox = document.getElementById('checkout-cart-items');
        if (!itemsBox) return;

        const hasRx = cart.some(item => {
          if (item.rxRequired === true || item.rx === 'true' || item.rx === true) return true;
          var name = (item.name || '').toLowerCase();
          var cat = (item.cat || item.category || '').toLowerCase();
          if (cat.includes('prescription')) return true;
          const rxNames = ['brufen', 'flexon', 'allegra', 'glycomet', 'janumet', 'ecosprin', 'atorva', 'telma', 'amlodipine', 'losartan', 'folic acid', 'pan d', 'minoxidil', 'moxifloxacin'];
          return rxNames.some(rn => name.includes(rn));
        });

        const rxBanner = document.getElementById('checkout-rx-banner');
        if (hasRx) {
          rxBanner?.classList.remove('hidden');
        } else {
          rxBanner?.classList.add('hidden');
        }

        if (cart.length === 0) {
          itemsBox.innerHTML = '<p class="text-xs font-bold text-slate-400 py-3">Your cart is empty.</p>';
          return;
        }

        let subtotal = 0;
        let html = '';
        cart.forEach(item => {
          const qty = item.quantity || 1;
          const price = parseFloat(item.price || item.mrp || 0);
          const itemTotal = Math.round(price * qty);
          subtotal += itemTotal;

          html += `
            <div class="py-2.5 flex items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <img loading="lazy" src="${item.image || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg'}" class="w-8 h-8 rounded-lg object-cover bg-slate-50 p-0.5 border" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                <div class="min-w-0">
                  <h4 class="font-black text-slate-800 truncate max-w-[140px]">${item.name}</h4>
                  <p class="text-[10px] font-bold text-slate-400">Qty: ${qty} × ₹${price}</p>
                </div>
              </div>
              <span class="font-black text-slate-900 shrink-0">₹${itemTotal}</span>
            </div>
          `;
        });

        itemsBox.innerHTML = html;

        const deliveryFee = 30; // Fixed Delivery Fee = ₹30
        const grandTotal = subtotal + deliveryFee;
        document.getElementById('summary-mrp-subtotal').textContent = `₹${subtotal}`;
        document.getElementById('summary-grand-total').textContent = `₹${grandTotal}`;
      }

      // Place Order Button Handler
      document.getElementById('btn-place-order')?.addEventListener('click', () => {
        if (!selectedAddressObject) {
          alert('Please select or add a delivery address before placing your order!');
          return;
        }

        let cart = [];
        try {
          cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        if (cart.length === 0) {
          alert('Your cart is empty!');
          return;
        }

        const selectedPayment = document.querySelector('input[name="payment-method"]:checked')?.value || 'UPI';
        const preferredStore = (document.getElementById('preferred-pharmacy-input')?.value || '').trim();
        const specialNotes = (document.getElementById('checkout-special-instructions')?.value || '').trim();

        const isMedicineOrder = cart.some(i => i.cat || i.category || i.brand || i.rxRequired);
        const hasRx = cart.some(item => item.rxRequired === true || item.rx === 'true');

        // Create Order Object
        const orderId = (hasRx ? 'RX-BHU-' : 'BHU-') + Math.floor(100000 + Math.random() * 900000);
        let subtotal = cart.reduce((acc, i) => acc + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);
        const grandTotal = Math.round(subtotal + 30);

        const newOrder = {
          id: orderId,
          type: hasRx ? 'PRESCRIPTION' : (isMedicineOrder ? 'MEDICINE' : 'STANDARD'),
          date: new Date().toISOString(),
          status: hasRx ? 'Under Verification' : 'Confirmed',
          items: cart,
          total: grandTotal,
          address: selectedAddressObject.full,
          lat: currentLat,
          lng: currentLng,
          payment: selectedPayment,
          storeName: preferredStore || 'Nearby Verified Partner Pharmacy',
          notes: specialNotes,
          rxStatus: hasRx ? 'Prescription Verification Required Before Dispatch' : 'Verified'
        };

        // Save order to history
        let orders = [];
        try {
          orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
        } catch(e) {}
        orders.unshift(newOrder);
        localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
        localStorage.setItem('bhusawal_active_order', JSON.stringify(newOrder));

        // Clear Cart
        localStorage.removeItem('bhusawal_cart');

        // Redirect to Confirmation or Tracking
        if (hasRx) {
          window.location.href = `/track_order?id=${orderId}`;
        } else {
          window.location.href = `/order_confirmation?orderId=${orderId}`;
        }
      });

      // Initial Calls
      renderSavedAddresses();
      initLeafletMap(21.0478, 75.7896);
      renderCartSummary();
    });
  </script>
</body>
</html>
