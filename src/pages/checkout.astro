            <label class="text-[11px] font-black text-slate-700 block uppercase">Building Name</label>
            <input type="text" id="field-building" placeholder="Gokul Heights" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
