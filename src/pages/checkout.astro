          <label class="text-[11px] font-black text-slate-700 block uppercase">Street / Road Name *</label>
          <input type="text" id="field-street" required placeholder="Station Road / Varangaon Road" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Area / Colony *</label>
            <input type="text" id="field-area" required placeholder="Shivaji Nagar" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
          <div>
            <label class="text-[11px] font-black text-slate-700 block uppercase">Landmark</label>
            <input type="text" id="field-landmark" placeholder="Near Railway Station" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 outline-none focus:border-blueBrand" />
          </div>
        </div>

