---
import Switcher from '../components/Switcher.astro';
import catalog from '../../public/grocery_catalog.json';

// Recommendations for Impulse Additions
const cartRecommendations = catalog.slice(0, 4);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Food Cart | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE BRANDING THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP NAV HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/food" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-redBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1 rounded-full bg-redLight text-redBrand text-xs font-black uppercase tracking-wider flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">bolt</span>
        20 MIN EXPRESS FOOD DELIVERY
      </span>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- BREADCRUMB & TITLE -->
    <div class="flex items-center justify-between border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Your Food Cart</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5" id="cart-header-subtitle">Loading your items...</p>
      </div>

      <button id="clear-entire-cart-btn" class="hidden text-xs font-black text-rose-500 hover:text-rose-700 hover:underline flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">delete</span>
        Clear Cart
      </button>
    </div>

    <!-- EMPTY CART CONTAINER -->
    <div id="empty-cart-container" class="hidden bg-white rounded-3xl p-8 sm:p-12 border border-slate-100 shadow-sm text-center max-w-lg mx-auto space-y-5">
      <div class="w-24 h-24 rounded-full bg-redLight text-redBrand mx-auto flex items-center justify-center shadow-inner">
        <span class="material-symbols-outlined text-5xl">shopping_cart</span>
      </div>
      <div>
        <h2 class="text-xl font-black font-display text-slate-900">Your Food Cart is empty!</h2>
        <p class="text-xs font-bold text-slate-400 mt-1">Explore delicious Biryanis, Thalis, Pizzas & Desserts from top Bhusawal restaurants.</p>
      </div>
      <a href="/food" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-redBrand hover:bg-redDark text-white font-black text-sm rounded-2xl shadow-lg shadow-red-900/15 active:scale-95 transition-all">
        <span class="material-symbols-outlined text-base">restaurant</span>
        <span>Explore Restaurants</span>
      </a>
    </div>

    <!-- MAIN CART CONTENT (GRID LAYOUT) -->
    <div id="active-cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT 7 COLS: RESTAURANT NAME & FOOD ITEMS -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- DELIVERY ADDRESS CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm flex items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-redLight text-redBrand flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-2xl">location_on</span>
            </div>
            <div>
              <span class="text-[10px] font-black text-redBrand uppercase tracking-wider block">DELIVERY ADDRESS</span>
              <p class="text-xs sm:text-sm font-extrabold text-slate-900 mt-0.5 truncate max-w-xs sm:max-w-md" id="cart-delivery-address">
                Home - Varangaon Road, Bhusawal
              </p>
            </div>
          </div>
          
          <a href="/checkout" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-black rounded-xl transition-all shrink-0">
            Change
          </a>
        </div>

        <!-- GROUPED FOOD ITEMS CONTAINERS BY RESTAURANT -->
        <div id="grouped-cart-items-wrapper" class="space-y-5">
          <!-- Dynamically populated by JS into Restaurant & Food Item groups -->
        </div>

      </div>

      <!-- RIGHT 5 COLS: PRICE SUMMARY & CHECKOUT BUTTON -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- PRICE SUMMARY BREAKDOWN CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4 sticky top-24">
          <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-redBrand">receipt_long</span>
            <span>Bill Details & Summary</span>
          </h3>

          <div class="space-y-3.5 text-xs font-bold text-slate-600">
            <!-- Subtotal -->
            <div class="flex items-center justify-between">
              <span>Item Subtotal (<span id="summary-items-count">0 items</span>)</span>
              <span class="text-slate-900 font-black" id="summary-subtotal">₹0</span>
            </div>

            <!-- Fixed Delivery Fee -->
            <div class="flex items-center justify-between pt-1">
              <span class="flex items-center gap-1">
                <span>Delivery Fee</span>
                <span class="text-[10px] font-extrabold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Fixed</span>
              </span>
              <span class="font-black text-slate-900" id="summary-delivery">₹30</span>
            </div>

            <!-- Grand Total -->
            <div class="pt-4 border-t border-slate-100 flex items-baseline justify-between text-slate-900">
              <div>
                <span class="text-base font-black block font-display">Grand Total</span>
                <span class="text-[10px] font-bold text-slate-400">Subtotal + ₹30 Delivery Fee</span>
              </div>
              <span class="text-2xl sm:text-3xl font-black font-display text-redBrand" id="summary-grand-total">₹0</span>
            </div>
          </div>

          <!-- CHECKOUT BUTTON -->
          <a href="/checkout" id="checkout-animated-btn" class="w-full py-4 bg-redBrand hover:bg-redDark text-white font-black text-sm rounded-2xl shadow-xl shadow-red-900/20 active:scale-95 transition-all duration-300 flex items-center justify-between px-6 group">
            <div class="text-left">
              <span class="text-[10px] uppercase font-bold text-red-100 block">Ready to Order</span>
              <span class="text-base font-black font-display" id="btn-grand-total">Proceed to Checkout • ₹0</span>
            </div>
            <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </div>
          </a>

          <p class="text-[10px] font-bold text-slate-400 text-center flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified_user</span>
            Safe & Secure Checkout • UPI, Cards & Cash on Delivery
          </p>
        </div>

      </div>
    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE CART ENGINE & EXACT CALCULATIONS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // 1. Get Normalized Cart Array
      function getNormalizedCart() {
        let raw = [];
        try {
          raw = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        if (!Array.isArray(raw)) {
          const arr = [];
          Object.keys(raw).forEach((key, idx) => {
            const qty = raw[key];
            if (typeof qty === 'number' && qty > 0) {
              arr.push({ id: 'BC-LEG-' + idx, name: key, price: 150, image: '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg', quantity: qty, restaurant: 'Bhusawal Connect Kitchen' });
            }
          });
          return arr;
        }

        return raw;
      }

      function saveCart(cartArray) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cartArray));
        renderCartUI();
      }

      // 2. Main Render Cart Logic
      function renderCartUI() {
        const cart = getNormalizedCart();
        const emptyBox = document.getElementById('empty-cart-container');
        const activeBox = document.getElementById('active-cart-content');
        const clearBtn = document.getElementById('clear-entire-cart-btn');
        const subtitle = document.getElementById('cart-header-subtitle');

        if (!cart || cart.length === 0) {
          emptyBox?.classList.remove('hidden');
          activeBox?.classList.add('hidden');
          clearBtn?.classList.add('hidden');
          if (subtitle) subtitle.textContent = '0 Items in your cart';
          return;
        }

        emptyBox?.classList.add('hidden');
        activeBox?.classList.remove('hidden');
        clearBtn?.classList.remove('hidden');

        const totalQty = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        if (subtitle) subtitle.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'} in your cart`;

        // Group products by Restaurant
        const groups = {};
        cart.forEach(item => {
          const restaurantName = item.restaurant || item.cat || 'Bhusawal Verified Restaurant';
          if (!groups[restaurantName]) groups[restaurantName] = [];
          groups[restaurantName].push(item);
        });

        // Render Grouped Products HTML
        const wrapper = document.getElementById('grouped-cart-items-wrapper');
        if (wrapper) {
          let html = '';
          Object.keys(groups).forEach(restName => {
            const items = groups[restName];
            html += `
              <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
                
                <!-- Restaurant Name Header -->
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-xl bg-redLight text-redBrand flex items-center justify-center text-base font-bold">🏪</span>
                    <h3 class="text-base font-black text-slate-900 font-display">${restName}</h3>
                  </div>
                  <span class="text-xs font-bold text-slate-400">${items.length} ${items.length === 1 ? 'item' : 'items'}</span>
                </div>

                <div class="divide-y divide-slate-100 space-y-3">
            `;

            items.forEach(item => {
              const id = item.id;
              const name = item.name || 'Food Item';
              const price = parseFloat(item.mrp || item.MRP || item.price || 0);
              const qty = item.quantity || 1;
              const itemTotal = Math.round(price * qty);
              const img = item.image || item.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

              html += `
                <div class="pt-3 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3.5 min-w-0 flex-1">
                    <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 p-1 flex items-center justify-center shrink-0 overflow-hidden">
                      <img loading="lazy" src="${img}" alt="${name}" class="w-full h-full object-cover rounded-xl" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="text-xs sm:text-sm font-extrabold text-slate-900 truncate">${name}</h4>
                      <p class="text-[11px] font-bold text-slate-400 mt-0.5">MRP ₹${price} / unit</p>
                    </div>
                  </div>

                  <!-- Quantity Controls & Item Total -->
                  <div class="flex items-center gap-4 shrink-0">
                    <div class="flex items-center justify-between bg-redLight text-redBrand font-black text-xs rounded-2xl overflow-hidden border border-red-200/60 shadow-xs">
                      <button class="cart-minus-btn w-8 h-8 flex items-center justify-center hover:bg-redBrand hover:text-white transition-all font-black text-sm" data-id="${id}">-</button>
                      <span class="px-2.5 text-xs font-black min-w-[1.2rem] text-center">${qty}</span>
                      <button class="cart-plus-btn w-8 h-8 flex items-center justify-center hover:bg-redBrand hover:text-white transition-all font-black text-sm" data-id="${id}">+</button>
                    </div>

                    <div class="text-right min-w-[3.5rem]">
                      <span class="text-sm font-black text-slate-900 block">₹${itemTotal}</span>
                      <button class="cart-delete-btn text-[10px] font-extrabold text-slate-400 hover:text-rose-500 transition-colors" data-id="${id}">Remove</button>
                    </div>
                  </div>
                </div>
              `;
            });

            html += `
                </div>
              </div>
            `;
          });

          wrapper.innerHTML = html;

          // Bind Quantity & Delete Handlers
          wrapper.querySelectorAll('.cart-plus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                item.quantity = (item.quantity || 1) + 1;
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-minus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              let cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                if (item.quantity > 1) {
                  item.quantity -= 1;
                } else {
                  cart = cart.filter(i => i.id !== id);
                }
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-delete-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart().filter(i => i.id !== id);
              saveCart(cart);
            };
          });
        }

        // 3. Perform Calculations (Subtotal + Fixed Delivery ₹30)
        calculateSummary(cart);
      }

      function calculateSummary(cart) {
        const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.mrp || item.MRP || item.price || 0) * (item.quantity || 1)), 0);
        const totalItemsCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

        const deliveryFee = 30; // Fixed Delivery Fee = ₹30
        const grandTotal = Math.round(subtotal + deliveryFee);

        // Update DOM Price Summary Elements
        const countEl = document.getElementById('summary-items-count');
        const subtotalEl = document.getElementById('summary-subtotal');
        const deliveryEl = document.getElementById('summary-delivery');
        const grandEl = document.getElementById('summary-grand-total');
        const btnGrandEl = document.getElementById('btn-grand-total');

        if (countEl) countEl.textContent = `${totalItemsCount} ${totalItemsCount === 1 ? 'item' : 'items'}`;
        if (subtotalEl) subtotalEl.textContent = `₹${Math.round(subtotal)}`;
        if (deliveryEl) deliveryEl.textContent = `₹${deliveryFee}`;
        if (grandEl) grandEl.textContent = `₹${grandTotal}`;
        if (btnGrandEl) btnGrandEl.textContent = `Proceed to Checkout • ₹${grandTotal}`;
      }

      // 4. Clear Entire Cart Action
      document.getElementById('clear-entire-cart-btn')?.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your food cart?')) {
          localStorage.removeItem('bhusawal_cart');
          renderCartUI();
        }
      });

      // Initial Call
      renderCartUI();
    });
  </script>
</body>
</html>
