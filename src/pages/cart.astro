---
import Switcher from '../components/Switcher.astro';
import catalog from '../../public/grocery_catalog.json';

// Get 6 popular recommendation items from catalog
const cartRecommendations = catalog.slice(0, 8);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Shopping Cart | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/grocery" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <span class="px-3 py-1 rounded-full bg-purple-50 text-purpleBrand text-xs font-black uppercase tracking-wider flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">bolt</span>
        10 MIN DELIVERY
      </span>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- BREADCRUMB & TITLE -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Your Cart</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5" id="cart-header-subtitle">Loading your items...</p>
      </div>

      <button id="clear-entire-cart-btn" class="hidden text-xs font-black text-rose-500 hover:text-rose-700 hover:underline flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">delete</span>
        Clear Cart
      </button>
    </div>

    <!-- EMPTY CART CONTAINER (Shown when cart is empty) -->
    <div id="empty-cart-container" class="hidden bg-white rounded-3xl p-8 sm:p-12 border border-slate-100 shadow-sm text-center max-w-lg mx-auto space-y-5 animate-in fade-in duration-300">
      <div class="w-24 h-24 rounded-full bg-purple-50 text-purpleBrand mx-auto flex items-center justify-center shadow-inner">
        <span class="material-symbols-outlined text-5xl">shopping_cart</span>
      </div>
      <div>
        <h2 class="text-xl font-black font-display text-slate-900">Your cart is empty!</h2>
        <p class="text-xs font-bold text-slate-400 mt-1">Looks like you haven't added anything to your cart yet. Explore 5,000+ items in our Grocery Superstore.</p>
      </div>
      <a href="/grocery" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-purpleBrand hover:bg-purpleDark text-white font-black text-sm rounded-2xl shadow-lg shadow-purple-900/15 active:scale-95 transition-all">
        <span class="material-symbols-outlined text-base">storefront</span>
        <span>Start Shopping Now</span>
      </a>
    </div>

    <!-- MAIN CART CONTENT (GRID LAYOUT) -->
    <div id="active-cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT 7 COLS: GROUPED PRODUCTS & RECOMMENDED ITEMS -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- FREE DELIVERY PROGRESS BANNER -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 space-y-2">
          <div class="flex items-center justify-between text-xs font-black">
            <span class="text-emerald-950 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-emerald-600 text-base">local_shipping</span>
              <span id="free-delivery-text">Add ₹45 more for FREE Delivery!</span>
            </span>
            <span class="text-emerald-700" id="free-delivery-status">Target ₹199</span>
          </div>
          <div class="w-full bg-emerald-200/60 h-2 rounded-full overflow-hidden">
            <div id="free-delivery-bar" class="bg-emerald-600 h-full w-[60%] transition-all duration-500"></div>
          </div>
        </div>

        <!-- GROUPED PRODUCTS CONTAINERS -->
        <div id="grouped-cart-items-wrapper" class="space-y-4">
          <!-- Dynamically populated by JS into Category groups -->
        </div>

        <!-- RECOMMENDED IMPULSE PRODUCTS CAROUSEL -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-black text-purpleBrand uppercase tracking-wider">Before You Checkout</span>
              <h3 class="text-base font-black font-display text-slate-900">Recommended Add-Ons</h3>
            </div>
            <span class="text-xs font-bold text-slate-400">⚡ 10 Min Delivery</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {cartRecommendations.map(rec => {
              const rId = rec["Product ID"] || rec.ProductID || rec.id || '';
              const rName = rec["Product Name"] || rec.name || '';
              const rPrice = parseFloat(rec["Selling Price"] || rec.sp || rec.MRP || 50);
              const rImg = rec["Product Image URL"] || rec.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
              const rPack = rec["Pack Size"] || rec.pack || '1 Unit';

              return (
                <div class="bg-slate-50/80 rounded-2xl p-2.5 border border-slate-100 flex flex-col justify-between group">
                  <div class="w-full aspect-square bg-white rounded-xl p-1 mb-2 flex items-center justify-center overflow-hidden border border-slate-100">
                    <img src={rImg} alt={rName} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                  </div>
                  <div class="space-y-1">
                    <h4 class="text-[11px] font-bold text-slate-800 line-clamp-2 leading-snug min-h-[1.8rem]">{rName}</h4>
                    <p class="text-[10px] text-slate-400 font-semibold">{rPack}</p>
                    <div class="flex items-center justify-between pt-1">
                      <span class="text-xs font-black text-slate-900">₹{rPrice}</span>
                      <button class="add-rec-btn px-2.5 py-1 bg-purpleBrand text-white text-[10px] font-black rounded-lg hover:bg-purpleDark active:scale-90 transition-all" data-id={rId} data-name={rName.replace(/"/g, '&quot;')} data-price={rPrice} data-img={rImg}>
                        + ADD
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

      </div>

      <!-- RIGHT 5 COLS: COUPONS, PRICE SUMMARY & CHECKOUT BUTTON -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- COUPONS & PROMO CODES SECTION -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-purpleBrand text-lg">local_offer</span>
              Coupons & Offers
            </h3>
            <span class="text-xs font-bold text-emerald-700" id="applied-coupon-status"></span>
          </div>

          <!-- Coupon Input Form -->
          <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-2xl border border-slate-200 focus-within:ring-2 focus-within:ring-purpleBrand/40 transition-all">
            <input type="text" id="coupon-input" placeholder="Enter Promo Code (e.g. BHUSAWAL10)" class="w-full bg-transparent px-3 py-1.5 text-xs font-bold uppercase text-slate-800 outline-none placeholder-slate-400" />
            <button id="apply-coupon-btn" class="px-4 py-2 bg-purpleBrand hover:bg-purpleDark text-white text-xs font-black rounded-xl transition-all shadow-xs">
              Apply
            </button>
          </div>

          <!-- Quick Available Coupons Chips -->
          <div class="space-y-2 pt-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Available Coupons for You:</span>
            <div class="space-y-2">
              <div class="select-coupon-card p-3 rounded-2xl bg-amber-50/60 border border-amber-200/80 flex items-center justify-between cursor-pointer hover:bg-amber-100/60 transition-colors" data-code="BHUSAWAL10">
                <div class="flex items-center gap-2.5">
                  <span class="px-2 py-1 bg-amber-400 text-slate-950 text-[10px] font-black rounded-lg">BHUSAWAL10</span>
                  <div>
                    <p class="text-xs font-black text-amber-950">10% OFF on all orders</p>
                    <p class="text-[10px] font-bold text-amber-800">Save up to ₹100 on your purchase</p>
                  </div>
                </div>
                <span class="text-xs font-black text-purpleBrand">Apply</span>
              </div>

              <div class="select-coupon-card p-3 rounded-2xl bg-emerald-50/60 border border-emerald-200/80 flex items-center justify-between cursor-pointer hover:bg-emerald-100/60 transition-colors" data-code="FREEDEL">
                <div class="flex items-center gap-2.5">
                  <span class="px-2 py-1 bg-emerald-600 text-white text-[10px] font-black rounded-lg">FREEDEL</span>
                  <div>
                    <p class="text-xs font-black text-emerald-950">Free Delivery Guarantee</p>
                    <p class="text-[10px] font-bold text-emerald-800">Waive delivery charges completely</p>
                  </div>
                </div>
                <span class="text-xs font-black text-purpleBrand">Apply</span>
              </div>
            </div>
          </div>
        </div>

        <!-- PRICE SUMMARY BREAKDOWN CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-3">
            Bill Details & Price Summary
          </h3>

          <div class="space-y-2.5 text-xs font-bold text-slate-600">
            <div class="flex items-center justify-between">
              <span>Item Subtotal (<span id="summary-items-count">0 items</span>)</span>
              <span class="text-slate-900 font-black" id="summary-subtotal">₹0</span>
            </div>

            <div class="flex items-center justify-between text-emerald-700">
              <span>Discount Savings</span>
              <span class="font-black" id="summary-savings">-₹0</span>
            </div>

            <div id="coupon-discount-row" class="hidden flex items-center justify-between text-emerald-700">
              <span>Coupon Discount (<span id="summary-coupon-name"></span>)</span>
              <span class="font-black" id="summary-coupon-discount">-₹0</span>
            </div>

            <div class="flex items-center justify-between">
              <span>Delivery Charge</span>
              <span class="font-black" id="summary-delivery">₹25</span>
            </div>

            <div class="flex items-center justify-between">
              <span>Handling & Platform Fee</span>
              <span class="font-black" id="summary-platform">₹5</span>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-baseline justify-between text-slate-900">
              <div>
                <span class="text-sm font-black block font-display">To Pay (Grand Total)</span>
                <span class="text-[10px] font-bold text-slate-400">Inclusive of all taxes & charges</span>
              </div>
              <span class="text-2xl font-black font-display text-purpleBrand" id="summary-grand-total">₹0</span>
            </div>
          </div>

          <!-- ANIMATED CHECKOUT BUTTON -->
          <a href="/billing" id="checkout-animated-btn" class="w-full py-4 bg-gradient-to-r from-purpleBrand via-purpleDark to-indigo-700 hover:from-purpleDark hover:to-purpleBrand text-white font-black text-sm rounded-2xl shadow-xl shadow-purple-900/20 active:scale-95 transition-all duration-300 flex items-center justify-between px-6 group">
            <div class="text-left">
              <span class="text-[10px] uppercase font-bold text-purple-200 block">Ready to Order</span>
              <span class="text-base font-black font-display" id="btn-grand-total">Proceed to Checkout • ₹0</span>
            </div>
            <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </div>
          </a>

          <p class="text-[10px] font-bold text-slate-400 text-center flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified_user</span>
            Safe & Secure Checkout • UPI, Cards & Cash on Delivery
          </p>
        </div>

      </div>
    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE CART ENGINE & CALCULATIONS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      let activeCoupon = null; // { code: 'BHUSAWAL10', type: 'pct', val: 10 } or { code: 'FREEDEL', type: 'free_del', val: 25 }

      // 1. Get Normalized Cart Array
      function getNormalizedCart() {
        let raw = [];
        try {
          raw = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        if (!Array.isArray(raw)) {
          // Fallback if legacy object format { "Item": qty }
          const arr = [];
          Object.keys(raw).forEach((key, idx) => {
            const qty = raw[key];
            if (typeof qty === 'number' && qty > 0) {
              arr.push({ id: 'BC-LEG-' + idx, name: key, price: 60, image: '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg', quantity: qty, cat: 'Grocery' });
            }
          });
          return arr;
        }

        return raw;
      }

      function saveCart(cartArray) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cartArray));
        renderCartUI();
      }

      // 2. Main Render Cart Logic
      function renderCartUI() {
        const cart = getNormalizedCart();
        const emptyBox = document.getElementById('empty-cart-container');
        const activeBox = document.getElementById('active-cart-content');
        const clearBtn = document.getElementById('clear-entire-cart-btn');
        const subtitle = document.getElementById('cart-header-subtitle');

        if (!cart || cart.length === 0) {
          emptyBox?.classList.remove('hidden');
          activeBox?.classList.add('hidden');
          clearBtn?.classList.add('hidden');
          if (subtitle) subtitle.textContent = '0 Items in your cart';
          return;
        }

        emptyBox?.classList.add('hidden');
        activeBox?.classList.remove('hidden');
        clearBtn?.classList.remove('hidden');

        const totalQty = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        if (subtitle) subtitle.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'} in your cart`;

        // Group products by category
        const groups = {};
        cart.forEach(item => {
          const category = item.cat || item.Category || 'Grocery & Essentials';
          if (!groups[category]) groups[category] = [];
          groups[category].push(item);
        });

        // Render Grouped Products HTML
        const wrapper = document.getElementById('grouped-cart-items-wrapper');
        if (wrapper) {
          let html = '';
          Object.keys(groups).forEach(catName => {
            const items = groups[catName];
            html += `
              <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-purpleBrand"></span>
                    <h3 class="text-sm font-black text-slate-900 font-display">${catName}</h3>
                  </div>
                  <span class="text-xs font-bold text-slate-400">${items.length} ${items.length === 1 ? 'type' : 'types'}</span>
                </div>

                <div class="divide-y divide-slate-100/80 space-y-3">
            `;

            items.forEach(item => {
              const id = item.id;
              const name = item.name || 'Grocery Item';
              const price = parseFloat(item.price || 0);
              const qty = item.quantity || 1;
              const itemTotal = Math.round(price * qty);
              const img = item.image || item.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

              html += `
                <div class="pt-3 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0 flex-1">
                    <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 p-1.5 flex items-center justify-center flex-shrink-0">
                      <img src="${img}" alt="${name}" class="max-h-full max-w-full object-contain" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="text-xs sm:text-sm font-extrabold text-slate-800 truncate">${name}</h4>
                      <p class="text-[11px] font-bold text-slate-400 mt-0.5">₹${price} / unit</p>
                    </div>
                  </div>

                  <!-- Quantity Controls & Item Total -->
                  <div class="flex items-center gap-4 flex-shrink-0">
                    <div class="flex items-center justify-between bg-purple-50 text-purpleBrand font-black text-xs rounded-xl overflow-hidden border border-purple-200/60 shadow-xs">
                      <button class="cart-minus-btn px-3 py-1.5 hover:bg-purpleBrand hover:text-white transition-all" data-id="${id}">-</button>
                      <span class="px-2 text-xs font-black min-w-[1.2rem] text-center">${qty}</span>
                      <button class="cart-plus-btn px-3 py-1.5 hover:bg-purpleBrand hover:text-white transition-all" data-id="${id}">+</button>
                    </div>

                    <div class="text-right min-w-[3.5rem]">
                      <span class="text-sm font-black text-slate-900 block">₹${itemTotal}</span>
                      <button class="cart-delete-btn text-[10px] font-bold text-slate-400 hover:text-rose-500 transition-colors" data-id="${id}">Remove</button>
                    </div>
                  </div>
                </div>
              `;
            });

            html += `
                </div>
              </div>
            `;
          });

          wrapper.innerHTML = html;

          // Bind Quantity & Delete Handlers
          wrapper.querySelectorAll('.cart-plus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                item.quantity = (item.quantity || 1) + 1;
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-minus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              let cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                if (item.quantity > 1) {
                  item.quantity -= 1;
                } else {
                  cart = cart.filter(i => i.id !== id);
                }
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-delete-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart().filter(i => i.id !== id);
              saveCart(cart);
            };
          });
        }

        // 3. Perform Accurate Price Calculations
        calculateSummary(cart);
      }

      function calculateSummary(cart) {
        const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.price || 0) * (item.quantity || 1)), 0);
        const totalItemsCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

        // Delivery Fee logic: Free if subtotal >= 199, else 25
        let deliveryFee = subtotal >= 199 ? 0 : 25;
        const platformFee = 5;

        // Delivery Progress Bar
        const freeText = document.getElementById('free-delivery-text');
        const freeStatus = document.getElementById('free-delivery-status');
        const freeBar = document.getElementById('free-delivery-bar');

        if (subtotal >= 199) {
          if (freeText) freeText.textContent = '🎉 Congratulations! You have unlocked FREE Delivery!';
          if (freeStatus) freeStatus.textContent = 'FREE Delivery Unlocked';
          if (freeBar) freeBar.style.width = '100%';
        } else {
          const needed = 199 - subtotal;
          if (freeText) freeText.textContent = `Add ₹${Math.round(needed)} more for FREE Delivery!`;
          if (freeStatus) freeStatus.textContent = `Target ₹199`;
          if (freeBar) freeBar.style.width = `${Math.min(100, (subtotal / 199) * 100)}%`;
        }

        // Calculate Coupon Discount
        let couponDiscount = 0;
        if (activeCoupon) {
          if (activeCoupon.code === 'BHUSAWAL10') {
            couponDiscount = Math.round(subtotal * 0.10);
          } else if (activeCoupon.code === 'FREEDEL') {
            deliveryFee = 0;
            couponDiscount = 25;
          } else if (activeCoupon.code === 'WELCOME50' && subtotal >= 299) {
            couponDiscount = 50;
          }
        }

        const grandTotal = Math.max(0, Math.round(subtotal - couponDiscount + deliveryFee + platformFee));

        // Update DOM Price Summary Elements
        const countEl = document.getElementById('summary-items-count');
        const subtotalEl = document.getElementById('summary-subtotal');
        const deliveryEl = document.getElementById('summary-delivery');
        const platformEl = document.getElementById('summary-platform');
        const grandEl = document.getElementById('summary-grand-total');
        const btnGrandEl = document.getElementById('btn-grand-total');

        const couponRow = document.getElementById('coupon-discount-row');
        const couponName = document.getElementById('summary-coupon-name');
        const couponDiscountEl = document.getElementById('summary-coupon-discount');

        if (countEl) countEl.textContent = `${totalItemsCount} ${totalItemsCount === 1 ? 'item' : 'items'}`;
        if (subtotalEl) subtotalEl.textContent = `₹${Math.round(subtotal)}`;
        if (deliveryEl) deliveryEl.textContent = deliveryFee === 0 ? 'FREE' : `₹${deliveryFee}`;
        if (platformEl) platformEl.textContent = `₹${platformFee}`;
        if (grandEl) grandEl.textContent = `₹${grandTotal}`;
        if (btnGrandEl) btnGrandEl.textContent = `Proceed to Checkout • ₹${grandTotal}`;

        if (activeCoupon && couponDiscount > 0) {
          if (couponRow) couponRow.classList.remove('hidden');
          if (couponName) couponName.textContent = activeCoupon.code;
          if (couponDiscountEl) couponDiscountEl.textContent = `-₹${couponDiscount}`;
        } else {
          if (couponRow) couponRow.classList.add('hidden');
        }
      }

      // 4. Coupons Handling
      const couponInput = document.getElementById('coupon-input');
      const applyBtn = document.getElementById('apply-coupon-btn');
      const appliedStatus = document.getElementById('applied-coupon-status');

      function applyCouponCode(code) {
        const c = code.trim().toUpperCase();
        if (c === 'BHUSAWAL10') {
          activeCoupon = { code: 'BHUSAWAL10', type: 'pct', val: 10 };
          if (appliedStatus) appliedStatus.textContent = '✓ BHUSAWAL10 Applied';
          alert('Coupon BHUSAWAL10 applied! You get 10% OFF.');
        } else if (c === 'FREEDEL') {
          activeCoupon = { code: 'FREEDEL', type: 'free_del', val: 25 };
          if (appliedStatus) appliedStatus.textContent = '✓ FREEDEL Applied';
          alert('Coupon FREEDEL applied! Free Delivery unlocked.');
        } else if (c === 'WELCOME50') {
          activeCoupon = { code: 'WELCOME50', type: 'flat', val: 50 };
          if (appliedStatus) appliedStatus.textContent = '✓ WELCOME50 Applied';
          alert('Coupon WELCOME50 applied! ₹50 OFF.');
        } else {
          alert('Invalid promo code. Try "BHUSAWAL10" or "FREEDEL".');
          return;
        }
        renderCartUI();
      }

      applyBtn?.addEventListener('click', () => {
        if (couponInput && couponInput.value) {
          applyCouponCode(couponInput.value);
        }
      });

      document.querySelectorAll('.select-coupon-card').forEach(card => {
        card.addEventListener('click', () => {
          const code = card.dataset.code;
          if (couponInput) couponInput.value = code;
          applyCouponCode(code);
        });
      });

      // 5. Add Recommended Item to Cart
      document.querySelectorAll('.add-rec-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          const name = btn.dataset.name;
          const price = parseFloat(btn.dataset.price);
          const img = btn.dataset.img;

          let cart = getNormalizedCart();
          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({ id, name, price, image: img, quantity: 1, cat: 'Grocery & Add-ons' });
          }
          saveCart(cart);

          btn.textContent = '✓ ADDED';
          btn.classList.replace('bg-purpleBrand', 'bg-emerald-600');
          setTimeout(() => {
            btn.textContent = '+ ADD';
            btn.classList.replace('bg-emerald-600', 'bg-purpleBrand');
          }, 1200);
        });
      });

      // 6. Clear Entire Cart Action
      document.getElementById('clear-entire-cart-btn')?.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your entire cart?')) {
          localStorage.removeItem('bhusawal_cart');
          renderCartUI();
        }
      });

      // Initial Call
      renderCartUI();
    });
  </script>
</body>
</html>
