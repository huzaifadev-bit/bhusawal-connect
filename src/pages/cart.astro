---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping Cart | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF',
            emeraldBrand: '#10B981'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP NAV HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-blueBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- ESTIMATED DELIVERY TIME BADGE -->
    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-full bg-blueLight text-blueBrand text-xs font-black uppercase tracking-wider flex items-center gap-1.5 border border-blue-200/80 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-blueBrand animate-ping"></span>
        <span>⚡ 10 Min Express Delivery</span>
      </span>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- BREADCRUMB & TITLE -->
    <div class="flex items-center justify-between border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Your Shopping Cart</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5" id="cart-header-subtitle">Loading your items...</p>
      </div>

      <button id="clear-entire-cart-btn" class="hidden text-xs font-black text-rose-500 hover:text-rose-700 hover:underline flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">delete</span>
        Clear Cart
      </button>
    </div>

    <!-- PRESCRIPTION VERIFICATION REQUIRED BANNER (Shown if any Rx product exists) -->
    <div id="rx-warning-banner" class="hidden bg-amber-50 border-2 border-amber-300 rounded-3xl p-4 sm:p-5 shadow-sm space-y-2 animate-in fade-in duration-300">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 font-black shadow-xs">
          📋
        </div>
        <div>
          <h3 class="text-sm font-black text-amber-900 uppercase tracking-wider">Prescription Verification Required Before Dispatch.</h3>
          <p class="text-xs font-semibold text-amber-800 mt-0.5">
            Your cart contains medicine(s) that require a valid doctor's prescription. Our certified partner pharmacist will review your prescription before packing and dispatching this order.
          </p>
        </div>
      </div>
    </div>

    <!-- EMPTY CART CONTAINER -->
    <div id="empty-cart-container" class="hidden bg-white rounded-3xl p-8 sm:p-12 border border-slate-100 shadow-sm text-center max-w-lg mx-auto space-y-5">
      <div class="w-24 h-24 rounded-full bg-blueLight text-blueBrand mx-auto flex items-center justify-center shadow-inner">
        <span class="material-symbols-outlined text-5xl">shopping_cart</span>
      </div>
      <div>
        <h2 class="text-xl font-black font-display text-slate-900">Your Cart is empty!</h2>
        <p class="text-xs font-bold text-slate-400 mt-1">Explore Medicines, Groceries, Daily Essentials & Food from Bhusawal's top partners.</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/medicines" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blueBrand hover:bg-blueDark text-white font-black text-xs rounded-2xl shadow-md active:scale-95 transition-all">
          <span>💊 Shop Medicines</span>
        </a>
        <a href="/grocery" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-2xl shadow-md active:scale-95 transition-all">
          <span>🛒 Shop Grocery</span>
        </a>
      </div>
    </div>

    <!-- MAIN CART CONTENT (GRID LAYOUT) -->
    <div id="active-cart-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT 7 COLS: ITEMS LIST & DELIVERY ADDRESS -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- DELIVERY ADDRESS & ESTIMATED TIME CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm flex items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-blueLight text-blueBrand flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-2xl">location_on</span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-black text-blueBrand uppercase tracking-wider block">DELIVERING TO</span>
                <span class="text-[10px] font-black text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">⚡ 10 MIN EXPRESS</span>
              </div>
              <p class="text-xs sm:text-sm font-extrabold text-slate-900 mt-0.5 truncate max-w-xs sm:max-w-md" id="cart-delivery-address">
                Home - Station Road, Shivaji Nagar, Bhusawal
              </p>
            </div>
          </div>
          
          <a href="/checkout" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-black rounded-xl transition-all shrink-0">
            Change
          </a>
        </div>

        <!-- GROUPED CART ITEMS WRAPPER -->
        <div id="grouped-cart-items-wrapper" class="space-y-5">
          <!-- Dynamically populated by JS into grouped category / store cards -->
        </div>

        <!-- SPECIAL INSTRUCTIONS CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blueBrand text-xl">edit_note</span>
            <h3 class="text-sm font-black font-display text-slate-900">Delivery or Packaging Instructions (Optional)</h3>
          </div>
          <p class="text-xs text-slate-400 font-medium">Add instructions for the pharmacist or delivery captain.</p>
          
          <textarea 
            id="special-instructions-input"
            rows="2"
            placeholder="e.g. Ring bell, leave package at security desk, call before arrival..."
            class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3 text-xs font-semibold text-slate-800 outline-none focus:ring-2 focus:ring-blueBrand/40 focus:bg-white transition-all placeholder-slate-400"
          ></textarea>
        </div>

      </div>

      <!-- RIGHT 5 COLS: BILL DETAILS & CHECKOUT BUTTON -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- PRICE SUMMARY BREAKDOWN CARD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 sticky top-24">
          <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-blueBrand">receipt_long</span>
            <span>Bill Details & Savings</span>
          </h3>

          <div class="space-y-3.5 text-xs font-bold text-slate-600">
            
            <!-- Item Total (MRP) -->
            <div class="flex items-center justify-between">
              <span>Item Total (MRP)</span>
              <span class="text-slate-500 line-through font-bold" id="summary-mrp">₹0</span>
            </div>

            <!-- Product Discount / Savings -->
            <div class="flex items-center justify-between text-emerald-600">
              <span class="flex items-center gap-1">
                <span>Total Discount / Savings</span>
                <span class="text-[9px] font-black bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded border border-emerald-200">SAVED</span>
              </span>
              <span class="font-black" id="summary-savings">- ₹0</span>
            </div>

            <!-- Subtotal (Selling Price) -->
            <div class="flex items-center justify-between pt-1 border-t border-slate-100">
              <span>Subtotal (<span id="summary-items-count">0 items</span>)</span>
              <span class="text-slate-900 font-black" id="summary-subtotal">₹0</span>
            </div>

            <!-- Fixed Delivery Fee -->
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-1">
                <span>Delivery Fee</span>
                <span class="text-[10px] font-extrabold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Fixed Rate</span>
              </span>
              <span class="font-black text-slate-900" id="summary-delivery">₹30</span>
            </div>

            <!-- Rx Required Notice inside summary -->
            <div id="rx-summary-notice" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-2.5 text-[11px] font-bold text-amber-800">
              📋 Prescription Verification Required Before Dispatch.
            </div>

            <!-- Grand Total -->
            <div class="pt-4 border-t border-slate-100 flex items-baseline justify-between text-slate-900">
              <div>
                <span class="text-base font-black block font-display">Grand Total</span>
                <span class="text-[10px] font-bold text-slate-400">Subtotal + ₹30 Delivery Fee</span>
              </div>
              <span class="text-2xl sm:text-3xl font-black font-display text-blueBrand" id="summary-grand-total">₹0</span>
            </div>
          </div>

          <!-- CHECKOUT BUTTON -->
          <a href="/checkout" id="checkout-animated-btn" class="w-full py-4 bg-blueBrand hover:bg-blueDark text-white font-black text-sm rounded-2xl shadow-xl shadow-blue-900/20 active:scale-95 transition-all duration-300 flex items-center justify-between px-6 group">
            <div class="text-left">
              <span class="text-[10px] uppercase font-bold text-blue-100 block">Ready to Order</span>
              <span class="text-base font-black font-display" id="btn-grand-total">Proceed to Checkout • ₹0</span>
            </div>
            <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </div>
          </a>

          <p class="text-[10px] font-bold text-slate-400 text-center flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified_user</span>
            Safe & Secure Checkout • UPI, Cards & Cash on Delivery
          </p>
        </div>

      </div>
    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE CART ENGINE & CALCULATIONS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      function getNormalizedCart() {
        let raw = [];
        try {
          raw = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}

        if (!Array.isArray(raw)) {
          const arr = [];
          Object.keys(raw).forEach((key, idx) => {
            const qty = raw[key];
            if (typeof qty === 'number' && qty > 0) {
              arr.push({ id: 'BC-LEG-' + idx, name: key, price: 150, mrp: 160, image: '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg', quantity: qty, restaurant: 'Bhusawal Express Store' });
            }
          });
          return arr;
        }

        return raw;
      }

      function saveCart(cartArray) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cartArray));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        renderCartUI();
      }

      function isRxRequired(item) {
        if (item.rxRequired === true || item.rx === 'true' || item.rx === true) return true;
        var name = (item.name || '').toLowerCase();
        var cat = (item.cat || item.category || '').toLowerCase();
        if (cat.includes('prescription')) return true;
        // Known Rx medicines in system
        const rxNames = ['brufen', 'flexon', 'allegra', 'glycomet', 'janumet', 'ecosprin', 'atorva', 'telma', 'amlodipine', 'losartan', 'folic acid', 'pan d', 'minoxidil', 'moxifloxacin'];
        return rxNames.some(rn => name.includes(rn));
      }

      function renderCartUI() {
        const cart = getNormalizedCart();
        const emptyBox = document.getElementById('empty-cart-container');
        const activeBox = document.getElementById('active-cart-content');
        const clearBtn = document.getElementById('clear-entire-cart-btn');
        const subtitle = document.getElementById('cart-header-subtitle');
        const rxWarningBanner = document.getElementById('rx-warning-banner');
        const rxSummaryNotice = document.getElementById('rx-summary-notice');

        if (!cart || cart.length === 0) {
          emptyBox?.classList.remove('hidden');
          activeBox?.classList.add('hidden');
          clearBtn?.classList.add('hidden');
          rxWarningBanner?.classList.add('hidden');
          rxSummaryNotice?.classList.add('hidden');
          if (subtitle) subtitle.textContent = '0 Items in your cart';
          return;
        }

        emptyBox?.classList.add('hidden');
        activeBox?.classList.remove('hidden');
        clearBtn?.classList.remove('hidden');

        const totalQty = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        if (subtitle) subtitle.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'} in your cart`;

        // Check if any Prescription Required medicine exists
        const hasRxProduct = cart.some(isRxRequired);
        if (hasRxProduct) {
          rxWarningBanner?.classList.remove('hidden');
          rxSummaryNotice?.classList.remove('hidden');
        } else {
          rxWarningBanner?.classList.add('hidden');
          rxSummaryNotice?.classList.add('hidden');
        }

        // Group products by Store / Restaurant / Category
        const groups = {};
        cart.forEach(item => {
          const storeName = item.restaurant || item.brand || item.cat || 'Bhusawal Express Partner';
          if (!groups[storeName]) groups[storeName] = [];
          groups[storeName].push(item);
        });

        // Render Grouped Products HTML
        const wrapper = document.getElementById('grouped-cart-items-wrapper');
        if (wrapper) {
          let html = '';
          Object.keys(groups).forEach(storeName => {
            const items = groups[storeName];
            html += `
              <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
                
                <!-- Store Header -->
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-xl bg-blueLight text-blueBrand flex items-center justify-center text-base font-bold">🏬</span>
                    <h3 class="text-base font-black text-slate-900 font-display">${storeName}</h3>
                  </div>
                  <span class="text-xs font-bold text-slate-400">${items.length} ${items.length === 1 ? 'item' : 'items'}</span>
                </div>

                <div class="divide-y divide-slate-100 space-y-3">
            `;

            items.forEach(item => {
              const id = item.id;
              const name = item.name || 'Product';
              const price = parseFloat(item.price || 0);
              const mrp = parseFloat(item.mrp || item.MRP || price);
              const qty = item.quantity || 1;
              const itemTotal = Math.round(price * qty);
              const img = item.image || item.img || 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80';
              const itemRx = isRxRequired(item);

              html += `
                <div class="pt-3 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3.5 min-w-0 flex-1">
                    <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 p-1 flex items-center justify-center shrink-0 overflow-hidden relative">
                      <img loading="lazy" src="${img}" alt="${name}" class="w-full h-full object-contain rounded-xl" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80';" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <h4 class="text-xs sm:text-sm font-extrabold text-slate-900 truncate">${name}</h4>
                        ${itemRx ? `<span class="bg-rose-500 text-white text-[8px] font-black px-1.5 py-0.2 rounded uppercase">Rx Required</span>` : ''}
                      </div>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="text-[11px] font-extrabold text-slate-900">₹${price}</span>
                        ${mrp > price ? `<span class="text-[10px] font-bold text-slate-400 line-through">₹${mrp}</span>` : ''}
                      </div>
                    </div>
                  </div>

                  <!-- Quantity Controls & Item Total -->
                  <div class="flex items-center gap-3.5 shrink-0">
                    <div class="flex items-center justify-between bg-blueLight text-blueBrand font-black text-xs rounded-2xl overflow-hidden border border-blue-200/80 shadow-xs">
                      <button class="cart-minus-btn w-8 h-8 flex items-center justify-center hover:bg-blueBrand hover:text-white transition-all font-black text-sm" data-id="${id}">-</button>
                      <span class="px-2.5 text-xs font-black min-w-[1.2rem] text-center">${qty}</span>
                      <button class="cart-plus-btn w-8 h-8 flex items-center justify-center hover:bg-blueBrand hover:text-white transition-all font-black text-sm" data-id="${id}">+</button>
                    </div>

                    <div class="text-right min-w-[3.5rem]">
                      <span class="text-sm font-black text-slate-900 block">₹${itemTotal}</span>
                      <button class="cart-delete-btn text-[10px] font-extrabold text-slate-400 hover:text-rose-500 transition-colors flex items-center gap-0.5 ml-auto" data-id="${id}">
                        <span class="material-symbols-outlined text-[12px]">delete</span>
                        <span>Remove</span>
                      </button>
                    </div>
                  </div>
                </div>
              `;
            });

            html += `
                </div>
              </div>
            `;
          });

          wrapper.innerHTML = html;

          // Bind Quantity & Delete Handlers
          wrapper.querySelectorAll('.cart-plus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                item.quantity = (item.quantity || 1) + 1;
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-minus-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              let cart = getNormalizedCart();
              const item = cart.find(i => i.id === id);
              if (item) {
                if (item.quantity > 1) {
                  item.quantity -= 1;
                } else {
                  cart = cart.filter(i => i.id !== id);
                }
                saveCart(cart);
              }
            };
          });

          wrapper.querySelectorAll('.cart-delete-btn').forEach(btn => {
            btn.onclick = () => {
              const id = btn.dataset.id;
              const cart = getNormalizedCart().filter(i => i.id !== id);
              saveCart(cart);
            };
          });
        }

        calculateSummary(cart);
      }

      function calculateSummary(cart) {
        let totalMrp = 0;
        let subtotal = 0;

        cart.forEach(item => {
          const qty = item.quantity || 1;
          const price = parseFloat(item.price || 0);
          const mrp = parseFloat(item.mrp || item.MRP || price);

          subtotal += price * qty;
          totalMrp += mrp * qty;
        });

        const savings = Math.max(0, totalMrp - subtotal);
        const totalItemsCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

        const deliveryFee = 30; // Fixed Delivery Fee = ₹30
        const grandTotal = Math.round(subtotal + deliveryFee);

        const mrpEl = document.getElementById('summary-mrp');
        const savingsEl = document.getElementById('summary-savings');
        const countEl = document.getElementById('summary-items-count');
        const subtotalEl = document.getElementById('summary-subtotal');
        const deliveryEl = document.getElementById('summary-delivery');
        const grandEl = document.getElementById('summary-grand-total');
        const btnGrandEl = document.getElementById('btn-grand-total');

        if (mrpEl) mrpEl.textContent = `₹${Math.round(totalMrp)}`;
        if (savingsEl) savingsEl.textContent = `- ₹${Math.round(savings)}`;
        if (countEl) countEl.textContent = `${totalItemsCount} ${totalItemsCount === 1 ? 'item' : 'items'}`;
        if (subtotalEl) subtotalEl.textContent = `₹${Math.round(subtotal)}`;
        if (deliveryEl) deliveryEl.textContent = `₹${deliveryFee}`;
        if (grandEl) grandEl.textContent = `₹${grandTotal}`;
        if (btnGrandEl) btnGrandEl.textContent = `Proceed to Checkout • ₹${grandTotal}`;
      }

      // Special Instructions
      const input = document.getElementById('special-instructions-input');
      if (input) {
        input.value = localStorage.getItem('bhusawal_cart_notes') || '';
        input.addEventListener('input', () => {
          localStorage.setItem('bhusawal_cart_notes', input.value);
        });
      }

      // Clear Entire Cart Action
      document.getElementById('clear-entire-cart-btn')?.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your cart?')) {
          localStorage.removeItem('bhusawal_cart');
          renderCartUI();
        }
      });

      renderCartUI();
    });
  </script>
</body>
</html>
