        var elRevWeight = document.getElementById('review-parcel-weight');
        var elRevDist = document.getElementById('review-estimated-distance');
        var elRevTime = document.getElementById('review-estimated-time');
        var elRevCharge = document.getElementById('review-delivery-charge');
        var elRevNotes = document.getElementById('review-special-instructions');

        var mins = Math.round(distanceKm * 4);
        if (mins < 10) mins = 10;
        var extraDist = Math.max(0, distanceKm - 2);
        var distCost = Math.round(extraDist * perKmFare);
        var total = baseFare + distCost - 5;
        if (total < baseFare) total = baseFare;

        if (elRevPick && pickInput) elRevPick.textContent = pickInput.value || 'Varangaon Road, Bhusawal';
        if (elRevDrop && dropInput) elRevDrop.textContent = dropInput.value || 'Jamner Road, Bhusawal';
        if (elRevCat) elRevCat.textContent = selectedCategory;
        if (elRevWeight) elRevWeight.textContent = selectedWeight;
        if (elRevDist) elRevDist.textContent = distanceKm.toFixed(1) + ' km';
        if (elRevTime) elRevTime.textContent = mins + ' Mins';
        if (elRevCharge) elRevCharge.textContent = '₹' + total;
        if (elRevNotes) {
          var val = (notesInput?.value || '').trim();
          elRevNotes.textContent = val ? `"${val}"` : 'No special instructions added.';
        }
      }

      document.getElementById('pickup-address-input')?.addEventListener('input', updateReviewSection);
      document.getElementById('drop-address-input')?.addEventListener('input', updateReviewSection);
      document.getElementById('delivery-notes-input')?.addEventListener('input', updateReviewSection);

      // WEIGHT BUTTON SELECTION
      var weightBtns = document.querySelectorAll('.parcel-weight-btn');
      weightBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          weightBtns.forEach(function(b) {
            b.classList.remove('active', 'bg-orangeLight', 'border-2', 'border-orangeBrand');
            b.classList.add('bg-white', 'border', 'border-slate-200');
          });
          btn.classList.add('active', 'bg-orangeLight', 'border-2', 'border-orangeBrand');
          btn.classList.remove('bg-white', 'border', 'border-slate-200');
          
          selectedWeight = btn.getAttribute('data-weight');
          baseFare = parseInt(btn.getAttribute('data-base')) || 30;
          recalculateFare();
          updateReviewSection();
        });
      });

      // FARE CALCULATION
      function recalculateFare() {
        var extraDist = Math.max(0, distanceKm - 2);
        var distCost = Math.round(extraDist * perKmFare);
        var total = baseFare + distCost - 5;
        if (total < baseFare) total = baseFare;

        var elBase = document.getElementById('fare-base-amount');
        var elDistKm = document.getElementById('fare-distance-km');
        var elDistCost = document.getElementById('fare-distance-cost');
        var elTotalDisplay = document.getElementById('total-fare-display');
        var elBarTotal = document.getElementById('bar-fare-total');
        var elRouteDist = document.getElementById('route-distance-text');
        var elRouteTime = document.getElementById('route-time-text');
        var elDurationText = document.getElementById('fare-duration-text');
        var elWeightLabel = document.getElementById('fare-weight-label');

        var mins = Math.round(distanceKm * 4);
        if (mins < 10) mins = 10;

        if (elBase) elBase.textContent = '₹' + baseFare;
        if (elWeightLabel) elWeightLabel.textContent = selectedWeight;
        if (elDistKm) elDistKm.textContent = distanceKm.toFixed(1) + ' km';
        if (elDistCost) elDistCost.textContent = '₹' + distCost;
        if (elTotalDisplay) elTotalDisplay.textContent = '₹' + total;
        if (elBarTotal) elBarTotal.textContent = '₹' + total;
        if (elRouteDist) elRouteDist.textContent = distanceKm.toFixed(1) + ' km';
        if (elRouteTime) elRouteTime.textContent = mins + ' mins';
        if (elDurationText) elDurationText.textContent = mins + ' Mins';

        updateReviewSection();
      }

      // INITIALIZE LEAFLET ROUTE MAP
      var map, routePolyline, pickupMarker, dropMarker;

      function initMap() {
        var mapContainer = document.getElementById('route-map');
        if (!mapContainer || typeof L === 'undefined') return;

        map = L.map('route-map', { zoomControl: false }).setView(pickupCoords, 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var pickupIcon = L.divIcon({
          className: 'custom-pickup-pin',
          html: '<div style="background:#F97316;color:#FFF;padding:4px 8px;border-radius:12px;font-weight:900;font-size:11px;border:2px solid #EA580C;">📍 Pickup</div>',
          iconSize: [60, 30]
        });

        var dropIcon = L.divIcon({
          className: 'custom-drop-pin',
          html: '<div style="background:#0F172A;color:#FFF;padding:4px 8px;border-radius:12px;font-weight:900;font-size:11px;border:2px solid #334155;">🏁 Delivery</div>',
          iconSize: [60, 30]
        });

        pickupMarker = L.marker(pickupCoords, { icon: pickupIcon }).addTo(map);
        dropMarker = L.marker(dropCoords, { icon: dropIcon }).addTo(map);

        routePolyline = L.polyline([pickupCoords, dropCoords], {
          color: '#F97316',
          weight: 5,
          opacity: 0.8,
          dashArray: '10, 10'
        }).addTo(map);

        map.fitBounds(routePolyline.getBounds(), { padding: [30, 30] });
      }

      setTimeout(initMap, 500);

      // AUTOCOMPLETE DROPDOWNS
      function setupAutocomplete(inputId, dropdownId, onSelect) {
        var input = document.getElementById(inputId);
        var dropdown = document.getElementById(dropdownId);
        if (!input || !dropdown) return;

        input.addEventListener('input', function() {
          var val = input.value.toLowerCase().trim();
          if (val.length < 2) {
            dropdown.classList.add('hidden');
            return;
          }

          var matches = sampleBhusawalPoints.filter(function(p) {
            return p.name.toLowerCase().indexOf(val) !== -1;
          });

          if (matches.length === 0) {
            dropdown.classList.add('hidden');
            return;
          }

          var html = '';
          matches.forEach(function(m, idx) {
            html += `<div class="p-3 hover:bg-orangeLight cursor-pointer border-b border-slate-100 flex items-center gap-2 text-xs font-bold text-slate-800 dropdown-item-${inputId}" data-idx="${idx}">
              <span class="material-symbols-outlined text-orangeBrand text-base">location_on</span>
              <span>${m.name}</span>
            </div>`;
          });

          dropdown.innerHTML = html;
          dropdown.classList.remove('hidden');

          dropdown.querySelectorAll(`.dropdown-item-${inputId}`).forEach(function(item) {
            item.addEventListener('click', function() {
              var idx = item.getAttribute('data-idx');
              var match = matches[idx];
              input.value = match.name;
              dropdown.classList.add('hidden');
              onSelect(match.coords);
            });
          });
        });
      }

      setupAutocomplete('pickup-address-input', 'pickup-search-dropdown', function(coords) {
        pickupCoords = coords;
        if (pickupMarker) pickupMarker.setLatLng(pickupCoords);
        updatePolyline();
        updateReviewSection();
      });

      setupAutocomplete('drop-address-input', 'drop-search-dropdown', function(coords) {
        dropCoords = coords;
        if (dropMarker) dropMarker.setLatLng(dropCoords);
        updatePolyline();
        updateReviewSection();
      });

      function updatePolyline() {
        if (routePolyline) routePolyline.setLatLngs([pickupCoords, dropCoords]);
        if (map) map.fitBounds(routePolyline.getBounds(), { padding: [30, 30] });

        var lat1 = pickupCoords[0], lon1 = pickupCoords[1];
        var lat2 = dropCoords[0], lon2 = dropCoords[1];
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        distanceKm = Math.round((6371 * c * 1.3) * 10) / 10;
        if (distanceKm < 1.5) distanceKm = 2.4;

        recalculateFare();
        updateReviewSection();
      }

      // BOOK PARCEL CLICK HANDLER
      var btnConfirm = document.getElementById('btn-confirm-parcel-booking');
      var btnConfirmBottom = document.getElementById('btn-confirm-parcel-booking-bottom');
      var searchModal = document.getElementById('partner-search-modal');
      var searchPhase1 = document.getElementById('partner-searching-phase');
      var searchPhase2 = document.getElementById('partner-accepted-phase');

      function handleParcelBookingSubmit() {
        var pickVal = (document.getElementById('pickup-address-input') || {}).value || 'Varangaon Road, Bhusawal';
        var dropVal = (document.getElementById('drop-address-input') || {}).value || 'Jamner Road, Bhusawal';

        if (pickVal === dropVal) {
          var banner = document.getElementById('address-validation-banner');
          if (banner) banner.classList.remove('hidden');
          return;
        }

        if (searchModal) {
          searchModal.classList.remove('hidden');
          if (searchPhase1) searchPhase1.classList.remove('hidden');
          if (searchPhase2) searchPhase2.classList.add('hidden');

          setTimeout(function() {
            if (searchPhase1) searchPhase1.classList.add('hidden');
            if (searchPhase2) searchPhase2.classList.remove('hidden');

            var senderName = (document.getElementById('pickup-sender-name') || {}).value || 'Rahul Patil';
            var senderPhone = (document.getElementById('pickup-sender-phone') || {}).value || '9876543210';
            var receiverName = (document.getElementById('drop-receiver-name') || {}).value || 'Amit Sharma';
            var receiverPhone = (document.getElementById('drop-receiver-phone') || {}).value || '9123456789';
            var deliveryNotes = (document.getElementById('delivery-notes-input') || {}).value || '';
            var secureOtp = Math.floor(1000 + Math.random() * 9000).toString();
            var elModalOtp = document.getElementById('assigned-partner-otp');
            if (elModalOtp) elModalOtp.textContent = secureOtp;

              var activeOrder = {
                id: 'PARCEL-BHU-' + Math.floor(100000 + Math.random() * 900000),
                type: 'PARCEL',
                category: selectedCategory,
                weight: selectedWeight,
                photoUrl: uploadedPhotoUrl,
                pickupAddress: pickVal,
                dropAddress: dropVal,
                senderName: senderName,
                senderPhone: senderPhone,
                receiverName: receiverName,
                receiverPhone: receiverPhone,
                deliveryNotes: deliveryNotes,
                total: document.getElementById('review-delivery-charge')?.textContent?.replace('₹', '') || '32',
                status: 'Request Accepted',
                rider: 'Rahul Patil',
                vehicle: 'EV Scooter (MH 19 AX 4892)',
                otp: secureOtp,
                otpVerified: false,
                timestamp: new Date().toISOString()
              };

              try {
                localStorage.setItem('bhusawal_active_order', JSON.stringify(activeOrder));
                var existing = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
                existing.unshift(activeOrder);
                localStorage.setItem('bhusawal_orders', JSON.stringify(existing));
              } catch(e) {}

            }, 3000);
          }
        }

      var btnCloseModal = document.getElementById('btn-close-partner-search-modal');
      var btnCancelSearch = document.getElementById('btn-cancel-search');
      var btnCancelAccepted = document.getElementById('btn-cancel-accepted-booking');
      var btnTrackParcel = document.getElementById('btn-track-live-parcel');

      function cancelBooking() {
        if (searchModal) searchModal.classList.add('hidden');
        try {
          localStorage.removeItem('bhusawal_active_order');
        } catch(e) {}
      }

      if (btnCloseModal) btnCloseModal.addEventListener('click', cancelBooking);
      if (btnCancelSearch) btnCancelSearch.addEventListener('click', cancelBooking);
      if (btnCancelAccepted) btnCancelAccepted.addEventListener('click', cancelBooking);

      if (btnTrackParcel) {
        btnTrackParcel.addEventListener('click', function() {
          window.location.href = '/track_order';
        });
      }

    })();
  </script>
</body>
</html>
