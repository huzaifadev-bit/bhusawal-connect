<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>📦 Send Parcels Anywhere in Bhusawal | Bhusawal Connect</title>
  
  <!-- TAILWIND & GOOGLE FONTS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- LEAFLET MAPS FOR ROUTE PREVIEW & SELECT ON MAP -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- ORANGE & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            orangeBrand: '#F97316',
            orangeDark: '#EA580C',
            orangeLight: '#FFF7ED',
            orangeBorder: '#FFEDD5',
            orangeDeep: '#C2410C',
            orangeAccent: '#FB923C'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }

    /* Custom Leaflet Pin Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.2);
    }
  </style>
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
</head>

<body class="pb-36 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors active:scale-95">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>📦 Parcel Delivery</span>
          <span class="bg-orangeLight text-orangeDeep text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-orangeBorder">BHUSAWAL EXPRESS</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Send documents, keys, packages & gifts across Bhusawal</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <!-- History Link -->
      <a href="/parcel_history" class="px-3.5 py-1.5 bg-orangeLight text-orangeDeep text-xs font-black rounded-xl border border-orangeBorder hover:bg-orangeBrand hover:text-white transition-all flex items-center gap-1 shadow-2xs">
        <span class="material-symbols-outlined text-base">history</span>
        <span class="hidden sm:inline">Booking History</span>
      </a>

      <!-- Support -->
      <a href="tel:+919876543210" class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 text-slate-700 text-xs font-black rounded-full hover:bg-slate-200 transition-all shadow-xs">
        <span class="material-symbols-outlined text-sm">headset_mic</span>
        <span class="hidden sm:inline">Support</span>
      </a>
    </div>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-7">

    <!-- ==================== LARGE HERO BANNER ==================== -->
    <section class="relative overflow-hidden bg-gradient-to-br from-orangeBrand via-amber-500 to-orange-600 rounded-3xl p-6 sm:p-10 text-white shadow-xl border border-orangeDark/20 group">
      
      <!-- BACKGROUND ACCENT GLOWS -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-amber-700/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- LEFT COLUMN: CONTENT -->
        <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
          
          <!-- TOP BADGE -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950 text-orangeBrand text-xs font-black uppercase tracking-wider shadow-md">
            <span class="w-2 h-2 rounded-full bg-orangeBrand animate-ping"></span>
            <span>BHUSAWAL PARCEL EXPRESS • 10-MIN PICKUP</span>
          </div>

          <!-- HEADLINE -->
          <h1 class="text-3xl sm:text-5xl font-black font-display tracking-tight text-white leading-tight sm:leading-none">
            Send Parcels Anywhere in Bhusawal
          </h1>

          <!-- SUBHEADING -->
          <p class="text-base sm:text-xl font-extrabold text-orange-100 tracking-wide">
            Fast, Safe & Reliable Parcel Delivery
          </p>

          <!-- CTA BUTTON (LARGE ORANGE BUTTON) -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a 
              href="#pickup-section-card" 
              onclick="document.getElementById('pickup-address-input').focus();"
              class="w-full sm:w-auto px-10 py-4 bg-orangeBrand hover:bg-orangeDark text-white active:scale-95 transition-all duration-300 rounded-2xl font-black text-lg sm:text-xl shadow-2xl flex items-center justify-center gap-3 border-2 border-white group/btn cursor-pointer"
            >
              <span>📦 Send Parcel</span>
              <span class="material-symbols-outlined text-2xl group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>

          <!-- 4 FEATURE CARDS -->
          <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 text-left">
            
            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md text-slate-900 flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">📦</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Safe Handling</p>
                <p class="text-[10px] font-bold text-slate-600">Careful Care</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md text-slate-900 flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">⚡</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Fast Pickup</p>
                <p class="text-[10px] font-bold text-slate-600">~10 Mins ETA</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md text-slate-900 flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">📍</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Live Tracking</p>
                <p class="text-[10px] font-bold text-slate-600">Real-time GPS</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md text-slate-900 flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">🛡</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Secure Delivery</p>
                <p class="text-[10px] font-bold text-slate-600">OTP Handover</p>
              </div>
            </div>

          </div>

        </div>

        <!-- RIGHT COLUMN: HERO BANNER ILLUSTRATION (RIDER + PARCEL BOXES + BIKE) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/90 bg-white group-hover:scale-[1.02] transition-transform duration-300">
            <img 
              src="/assets/services/service_parcel_hero.jpg?v=3" 
              alt="Bhusawal Connect delivery partner carrying parcel boxes beside a delivery bike" 
              class="w-full h-60 sm:h-72 lg:h-84 object-cover"
              onerror="this.onerror=null;this.src='/assets/service_parcel_hero.jpg';"
            />
            
            <!-- OVERLAY BADGE -->
            <div class="absolute bottom-3 left-3 right-3 bg-slate-950/85 backdrop-blur-md p-3 rounded-2xl text-white flex items-center justify-between border border-white/20">
              <div class="flex items-center gap-2">
                <span class="text-xl">📦 🛵</span>
                <div>
                  <p class="text-xs font-black text-orangeBrand">Doorstep Express Partner</p>
                  <p class="text-[10px] text-slate-300 font-medium">Bhusawal Citywide Delivery</p>
                </div>
              </div>
              <span class="text-[10px] font-black bg-orangeBrand text-white px-2.5 py-1 rounded-lg uppercase shadow-xs">Active Now</span>
            </div>

          </div>
        </div>

      </div>

    </section>

    <!-- VALIDATION ERROR TOAST BANNER -->
    <div id="address-validation-banner" class="hidden bg-rose-500 text-white p-4 rounded-2xl shadow-lg border border-rose-600 flex items-center justify-between gap-3 animate-bounce">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-xl">warning</span>
        <p class="text-xs font-black" id="validation-banner-text">Pickup and Delivery addresses must be different!</p>
      </div>
      <button type="button" onclick="document.getElementById('address-validation-banner').classList.add('hidden');" class="text-white hover:text-rose-200 font-black text-xs">✕</button>
    </div>


    <!-- ==================== 1. PICKUP ADDRESS ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-orangeBrand transition-all" id="pickup-section-card">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-orangeBrand text-white flex items-center justify-center font-black shadow-md shrink-0">
            <span class="material-symbols-outlined text-xl">my_location</span>
          </div>
          <div>
            <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span>📍 Pickup Address</span>
              <span class="text-[10px] font-extrabold text-orangeDeep bg-orangeLight px-2 py-0.5 rounded-full border border-orangeBorder">Package Origin</span>
            </h2>
            <p class="text-xs text-slate-500 font-medium">Select where rider collects the parcel in Bhusawal</p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 flex-wrap">
          <button id="btn-pickup-gps" type="button" class="flex items-center gap-1 text-[11px] font-black text-orangeDeep bg-orangeLight hover:bg-orangeBrand hover:text-white px-3 py-1.5 rounded-xl border border-orangeBorder transition-all shadow-xs active:scale-95">
            <span class="material-symbols-outlined text-sm">gps_fixed</span>
            <span>GPS Location</span>
          </button>

          <button id="btn-pickup-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-orangeLight hover:bg-orangeBrand hover:text-white px-3 py-1.5 rounded-xl border border-orangeBorder transition-all shadow-xs active:scale-95">
            <span class="material-symbols-outlined text-sm">map</span>
            <span>Select on Map</span>
          </button>
        </div>
      </div>

      <div class="relative">
        <label for="pickup-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Pickup Address (Google Maps Autocomplete)</label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-orangeBrand text-lg">search</span>
          <input 
            type="text" 
            id="pickup-address-input" 
            value="Varangaon Road, Near Station Square, Bhusawal" 
            placeholder="Search landmark, shop or colony in Bhusawal..." 
            class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orangeBrand transition-all" 
            autocomplete="off"
          />
          <button id="clear-pickup-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
        </div>

        <div id="pickup-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
          <!-- Populated dynamically -->
        </div>
      </div>

    </section>


    <!-- ==================== 2. DELIVERY ADDRESS ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-orangeBrand transition-all" id="drop-section-card">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-black shadow-md shrink-0">
            <span class="material-symbols-outlined text-xl">location_on</span>
          </div>
          <div>
            <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span>🏁 Delivery Address</span>
              <span class="text-[10px] font-extrabold text-slate-700 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200">Destination</span>
            </h2>
            <p class="text-xs text-slate-500 font-medium">Select where parcel is delivered in Bhusawal</p>
          </div>
        </div>

        <button id="btn-drop-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-orangeLight hover:bg-orangeBrand hover:text-white px-3 py-1.5 rounded-xl border border-orangeBorder transition-all shadow-xs active:scale-95">
          <span class="material-symbols-outlined text-sm">map</span>
          <span>Select on Map</span>
        </button>
      </div>

      <div class="relative">
        <label for="drop-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Delivery Address (Google Maps Autocomplete)</label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg">search</span>
          <input 
            type="text" 
            id="drop-address-input" 
            value="Jamner Road, Ordnance Factory Gate, Bhusawal" 
            placeholder="Search drop location, shop or colony..." 
            class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orangeBrand transition-all" 
            autocomplete="off"
          />
          <button id="clear-drop-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
        </div>

        <div id="drop-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>


    <!-- ==================== SENDER INFORMATION CARD ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-orangeBorder shadow-sm space-y-4 relative overflow-hidden group hover:border-orangeBrand transition-all" id="sender-info-card">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-orangeBrand text-white flex items-center justify-center font-black shadow-md shrink-0">
            <span class="material-symbols-outlined text-xl">person</span>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
              <span>Sender Information</span>
              <span class="text-[10px] font-extrabold text-orangeDeep bg-orangeLight px-2.5 py-0.5 rounded-full border border-orangeBorder uppercase">Pickup Contact</span>
            </h2>
            <p class="text-xs text-slate-500 font-medium">Contact details of person handing over parcel</p>
          </div>
        </div>

        <span class="text-xs font-black text-orangeBrand bg-orangeLight px-3 py-1 rounded-full border border-orangeBorder">
          Required *
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
        <div>
          <label for="pickup-sender-name" class="text-xs font-black text-slate-700 block mb-1.5 flex items-center gap-1">
            <span class="material-symbols-outlined text-base text-orangeBrand">badge</span>
            <span>Sender Name <span class="text-rose-500">*</span></span>
          </label>
          <input 
            type="text" 
            id="pickup-sender-name" 
            value="Rahul Patil" 
            placeholder="Enter Sender's Full Name" 
            class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl px-4 py-3 text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 focus:bg-white focus:border-orangeBrand focus:outline-none focus:ring-2 focus:ring-orangeLight transition-all" 
          />
        </div>

        <div>
          <label for="pickup-sender-phone" class="text-xs font-black text-slate-700 block mb-1.5 flex items-center gap-1">
            <span class="material-symbols-outlined text-base text-orangeBrand">call</span>
            <span>Sender Mobile Number <span class="text-rose-500">*</span></span>
          </label>
          <div class="relative flex items-center">
            <span class="absolute left-3.5 text-xs font-black text-slate-400">+91</span>
            <input 
              type="tel" 
              id="pickup-sender-phone" 
              value="9876543210" 
              maxlength="10"
              placeholder="10-digit mobile number" 
              class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl pl-12 pr-4 py-3 text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 focus:bg-white focus:border-orangeBrand focus:outline-none focus:ring-2 focus:ring-orangeLight transition-all" 
            />
          </div>
        </div>
      </div>
    </section>


    <!-- ==================== RECEIVER INFORMATION CARD ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-900/10 shadow-sm space-y-4 relative overflow-hidden group hover:border-orangeBrand transition-all" id="receiver-info-card">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-slate-950 text-white flex items-center justify-center font-black shadow-md shrink-0">
            <span class="material-symbols-outlined text-xl">person_pin</span>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
              <span>Receiver Information</span>
              <span class="text-[10px] font-extrabold text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200 uppercase">Delivery Contact</span>
            </h2>
            <p class="text-xs text-slate-500 font-medium">Contact details of person receiving parcel</p>
          </div>
        </div>

        <span class="text-xs font-black text-slate-900 bg-slate-100 px-3 py-1 rounded-full border border-slate-200">
          Required *
        </span>
      </div>

      <div class="space-y-4 pt-1">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="drop-receiver-name" class="text-xs font-black text-slate-700 block mb-1.5 flex items-center gap-1">
              <span class="material-symbols-outlined text-base text-slate-700">badge</span>
              <span>Receiver Name <span class="text-rose-500">*</span></span>
            </label>
            <input 
              type="text" 
              id="drop-receiver-name" 
              value="Amit Sharma" 
              placeholder="Enter Receiver's Full Name" 
              class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl px-4 py-3 text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 focus:bg-white focus:border-orangeBrand focus:outline-none focus:ring-2 focus:ring-orangeLight transition-all" 
            />
          </div>

          <div>
            <label for="drop-receiver-phone" class="text-xs font-black text-slate-700 block mb-1.5 flex items-center gap-1">
              <span class="material-symbols-outlined text-base text-slate-700">call</span>
              <span>Receiver Mobile Number <span class="text-rose-500">*</span></span>
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-xs font-black text-slate-400">+91</span>
              <input 
                type="tel" 
                id="drop-receiver-phone" 
                value="9123456789" 
                maxlength="10"
                placeholder="10-digit mobile number" 
                class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl pl-12 pr-4 py-3 text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orangeLight transition-all" 
              />
            </div>
          </div>
        </div>

        <!-- DELIVERY NOTES (OPTIONAL) -->
        <div>
          <label for="delivery-notes-input" class="text-xs font-black text-slate-700 block mb-1.5 flex items-center justify-between">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-base text-orangeBrand">note_alt</span>
              <span>Delivery Notes (Optional)</span>
            </span>
            <span class="text-[11px] font-bold text-slate-400 uppercase">Optional</span>
          </label>
          <textarea 
            id="delivery-notes-input" 
            rows="2" 
            placeholder="e.g. Leave package at door, call before arriving, handle fragile items with extra care..." 
            class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl px-4 py-3 text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 focus:bg-white focus:border-orangeBrand focus:outline-none focus:ring-2 focus:ring-orangeLight transition-all resize-none"
          ></textarea>
        </div>
      </div>
    </section>


    <!-- ==================== 3. GOOGLE MAPS ROUTE PREVIEW ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="text-orangeBrand">🗺️</span>
            <span>Google Maps Route Preview</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium">Real-time route calculation between pickup and delivery locations</p>
        </div>

        <div class="flex items-center gap-2 bg-orangeLight border border-orangeBorder px-3 py-1 rounded-xl text-xs font-black text-orangeDeep shadow-2xs">
          <span>⚡ <span id="route-distance-text">3.2 km</span></span>
          <span class="text-orangeBrand">•</span>
