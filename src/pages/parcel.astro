---
import Switcher from '../components/Switcher.astro';
---

<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Send Parcel - Bhusawal Connect</title>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline="" />
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "secondary-container": "#e5e2e1",
            "on-primary": "#ffffff",
            "on-surface-variant": "#5b4039",
            "outline": "#907067",
            "on-primary-container": "#541200",
            "surface-tint": "#b02f00",
            "secondary": "#5f5e5e",
            "inverse-primary": "#ffb5a0",
            "outline-variant": "#e4beb4",
            "on-secondary-fixed": "#1c1b1b",
            "background": "#f9f9f9",
            "error-container": "#ffdad6",
            "tertiary": "#006e1c",
            "surface-container-lowest": "#ffffff",
            "on-error": "#ffffff",
            "inverse-surface": "#2f3131",
            "on-tertiary": "#ffffff",
            "surface-container-highest": "#e2e2e2",
            "secondary-fixed": "#e5e2e1",
            "tertiary-fixed": "#94f990",
            "surface-container": "#eeeeee",
            "on-surface": "#1a1c1c",
            "primary": "#4f46e5",
            "primary-container": "#6366f1",
            "on-secondary-container": "#656464",
            "surface-container-low": "#f3f3f3",
            "surface-dim": "#dadada",
            "primary-fixed": "#e0e7ff",
            "on-primary-fixed-variant": "#862200",
            "error": "#ba1a1a",
            "on-error-container": "#93000a",
            "surface-container-high": "#e8e8e8",
            "surface-bright": "#f9f9f9",
            "on-secondary": "#ffffff",
            "surface": "#f9f9f9"
          },
          "fontFamily": {
            "label-sm": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"],
            "body-md": ["Plus Jakarta Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "headline-lg-mobile": ["Plus Jakarta Sans"]
          },
          "spacing": {
            "margin-mobile": "16px",
            "gutter": "16px"
          }
        }
      }
    }
  </script>
  
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f9f9f9; min-height: 100dvh; }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

    <!-- Leaflet Map CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        .custom-pin-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>

</head>
<body class="text-on-surface bg-background pb-32">
  <!-- Top App Bar -->
  <header class="bg-surface/80 backdrop-blur-xl shadow-sm top-0 sticky z-50 flex items-center justify-between px-margin-mobile h-16 w-full">
    <div class="flex items-center gap-3">
      <a href="/home" class="p-2 hover:bg-surface-container-high rounded-full transition-colors active:scale-95 duration-150">
        <span class="material-symbols-outlined text-primary">arrow_back</span>
      </a>
      <h1 class="font-headline-lg-mobile text-headline-md text-on-surface">Send Parcel</h1>
    </div>
  </header>

  <main class="max-w-md mx-auto px-margin-mobile pt-6 space-y-6">
    <div class="px-4 mt-3 max-w-md mx-auto">
      <div class="bg-white p-3 rounded-2xl border border-neutral-100 shadow-sm space-y-2">
        <div class="flex items-center justify-between text-xs font-black text-neutral-800">
          <span>📦 Bhusawal Pickup & Drop Route</span>
          <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[10px]">Google Maps Live</span>
        </div>
        <div id="parcel-bhusawal-map" class="h-36 w-full rounded-xl border border-neutral-200"></div>
      </div>
    </div>
    <!-- Form Container -->
    <div class="bg-white rounded-2xl p-6 border border-outline-variant/10 shadow-[0_4px_12px_rgba(0,0,0,0.02)] space-y-4">
      <h2 class="font-bold text-headline-md text-on-surface mb-2">Delivery Details</h2>
      
      <!-- Addresses -->
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-secondary uppercase mb-1">Pickup Address</label>
          <input type="text" id="pickup-addr" class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" placeholder="Enter pickup location in Bhusawal" value="Varangaon Road, Bhusawal" />
        </div>
        <div>
          <label class="block text-xs font-bold text-secondary uppercase mb-1">Drop Address</label>
          <input type="text" id="drop-addr" class="w-full bg-white border border-outline-variant/50 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-sm" placeholder="Enter recipient address" />
        </div>
      </div>

      <!-- Interactive GPS Route Map -->
      <div id="map" class="h-44 w-full rounded-2xl border border-outline-variant/30 overflow-hidden shadow-inner mt-4" style="z-index:10; position: relative;"></div>

      <!-- Recipient Info -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-secondary uppercase mb-1">Receiver Name</label>
          <input type="text" id="receiver-name" class="w-full bg-white border border-outline-variant/50 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-sm" placeholder="Name" />
        </div>
        <div>
          <label class="block text-xs font-bold text-secondary uppercase mb-1">Receiver Phone</label>
          <input type="text" id="receiver-phone" class="w-full bg-white border border-outline-variant/50 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-sm" placeholder="Phone" />
        </div>
      </div>
    </div>

    <!-- Package Config -->
    <div class="bg-white rounded-2xl p-6 border border-outline-variant/10 shadow-[0_4px_12px_rgba(0,0,0,0.02)] space-y-4">
      <h2 class="font-bold text-headline-md text-on-surface mb-2">Package Information</h2>

      <!-- Type Selectors -->
      <div>
        <label class="block text-xs font-bold text-secondary uppercase mb-2">Package Type</label>
        <div class="grid grid-cols-4 gap-2 text-center" id="package-types">
          <button class="p-2 border border-primary bg-primary-fixed/30 text-primary font-bold rounded-xl text-[10px] active:scale-95 transition-all">Docs</button>
          <button class="p-2 border border-outline-variant bg-white text-secondary rounded-xl text-[10px] active:scale-95 transition-all">Food</button>
          <button class="p-2 border border-outline-variant bg-white text-secondary rounded-xl text-[10px] active:scale-95 transition-all">Clothes</button>
          <button class="p-2 border border-outline-variant bg-white text-secondary rounded-xl text-[10px] active:scale-95 transition-all">Other</button>
        </div>
      </div>

      <!-- Weight Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-bold text-secondary uppercase">Weight Estimation</label>
          <span class="text-sm font-bold text-primary" id="weight-label">1 kg</span>
        </div>
        <input type="range" id="weight-slider" min="1" max="15" value="1" class="w-full h-2 bg-surface-container rounded-lg appearance-none cursor-pointer accent-primary" />
        <p class="text-[10px] text-on-surface-variant mt-1">Weight changes impact base delivery fees.</p>
      </div>
    </div>

    <!-- Booking Summary Card -->
    <div class="bg-white rounded-2xl p-6 border border-outline-variant/10 shadow-[0_4px_12px_rgba(0,0,0,0.02)] flex justify-between items-center">
      <div>
        <p class="text-[10px] text-secondary font-bold uppercase tracking-wide">Estimated Fee</p>
        <p class="text-2xl font-bold text-primary" id="fare-label">₹50.00</p>
      </div>
      <button id="btn-book-parcel" class="bg-primary text-on-primary font-bold h-14 px-8 rounded-full flex items-center justify-center gap-2 hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary/20">
        Request Rider
        <span class="material-symbols-outlined">arrow_forward</span>
      </button>
    </div>
  </main>

  <script is:inline>
    // Handle package types selections
    const typeButtons = document.querySelectorAll('#package-types button');
    let selectedType = "Docs";

    typeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        typeButtons.forEach(b => {
          b.className = "p-2 border border-outline-variant bg-white text-secondary rounded-xl text-[10px] transition-all";
        });
        btn.className = "p-2 border border-primary bg-primary-fixed/30 text-primary font-bold rounded-xl text-[10px] transition-all";
        selectedType = btn.textContent.trim();
      });
    });

    // Handle Weight Slider & Fare logic
    const slider = document.getElementById('weight-slider');
    const weightLabel = document.getElementById('weight-label');
    const fareLabel = document.getElementById('fare-label');
    let currentDistance = 2.0; // Default 2 km
    let baseFare = 40;

    function calculateFare() {
      const weight = parseInt(slider.value);
      // Fare: Base 40 + (weight * 5) + (distance * 12)
      const totalFare = Math.round(baseFare + (weight * 5) + (currentDistance * 12));
      fareLabel.textContent = `₹${totalFare}.00`;
    }

    slider.addEventListener('input', (e) => {
      weightLabel.textContent = `${e.target.value} kg`;
      calculateFare();
    });

    // Initialize Leaflet Map
    let userLatLng = [21.0478, 75.7896];
    const map = L.map('map', { zoomControl: false }).setView(userLatLng, 13);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    const createPin = (icon, color) => {
        return L.divIcon({
            className: 'custom-pin-icon',
            html: `<div class="w-8 h-8 rounded-full ${color} text-white flex items-center justify-center border-2 border-white shadow-md">
                       <span class="material-symbols-outlined text-sm font-bold">${icon}</span>
                   </div>`,
            iconSize: [32, 32],
            iconAnchor: [16, 16]
        });
    };

    // Current pickup marker
    const pickupMarker = L.marker(userLatLng, {
        icon: createPin('radio_button_checked', 'bg-primary')
    }).addTo(map);

    let dropMarker = null;
    let routeLine = null;

    // Distance calculator helper
    function getDistance(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    const dropInput = document.getElementById('drop-addr');

    dropInput.addEventListener('focus', () => {
        if (!dropMarker) {
            const dropLat = userLatLng[0] + 0.012;
            const dropLng = userLatLng[1] - 0.015;
            currentDistance = getDistance(userLatLng[0], userLatLng[1], dropLat, dropLng);

            dropMarker = L.marker([dropLat, dropLng], {
                icon: createPin('location_on', 'bg-emerald-600'),
                draggable: true
            }).addTo(map).bindPopup("Recipient Drop Point (Drag to change)").openPopup();

            routeLine = L.polyline([userLatLng, [dropLat, dropLng]], {
                color: '#4f46e5',
                weight: 3,
                dashArray: '5, 5'
            }).addTo(map);

            map.fitBounds(routeLine.getBounds(), { padding: [30, 30] });
            dropInput.value = "Station Road, Bhusawal";
            calculateFare();

            // Recalculate fare when drop marker is dragged
            dropMarker.on('dragend', () => {
                const newPos = dropMarker.getLatLng();
                routeLine.setLatLngs([userLatLng, newPos]);
                currentDistance = getDistance(userLatLng[0], userLatLng[1], newPos.lat, newPos.lng);
                calculateFare();
                map.fitBounds(routeLine.getBounds(), { padding: [30, 30] });
            });
        }
    });

    // Read cached location from launch or request permission
    const cachedLat = localStorage.getItem('bhusawal_user_lat');
    const cachedLng = localStorage.getItem('bhusawal_user_lng');

    if (cachedLat && cachedLng) {
        const lat = parseFloat(cachedLat);
        const lng = parseFloat(cachedLng);
        userLatLng = [lat, lng];
        pickupMarker.setLatLng(userLatLng);
        pickupMarker.bindPopup("Your Location: Pickup").openPopup();
        map.setView(userLatLng, 13);
    } else if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                userLatLng = [lat, lng];
                localStorage.setItem('bhusawal_user_lat', lat);
                localStorage.setItem('bhusawal_user_lng', lng);
                
                pickupMarker.setLatLng(userLatLng);
                pickupMarker.bindPopup("Your Location: Pickup").openPopup();
                map.setView(userLatLng, 13);
                
                if (dropMarker) {
                    routeLine.setLatLngs([userLatLng, dropMarker.getLatLng()]);
                    currentDistance = getDistance(userLatLng[0], userLatLng[1], dropMarker.getLatLng().lat, dropMarker.getLatLng().lng);
                    calculateFare();
                }
            },
            (error) => {
                console.warn("Location permission denied, using default Bhusawal.");
                pickupMarker.bindPopup("Pickup: Varangaon Road, Bhusawal").openPopup();
            }
        );
    }

    // Dispatch Order
    document.getElementById('btn-book-parcel').addEventListener('click', () => {
      const pickup = document.getElementById('pickup-addr').value.trim();
      const drop = document.getElementById('drop-addr').value.trim();
      const name = document.getElementById('receiver-name').value.trim();
      const phone = document.getElementById('receiver-phone').value.trim();

      if (!drop || !name || !phone) {
        alert("Please fill all drop-off and recipient fields.");
        return;
      }

      // Proceed with simulated booking
      localStorage.setItem('bhusawal_last_order', JSON.stringify({
        id: 'PRC-' + Math.floor(Math.random() * 9000 + 1000),
        items: `Parcel (${selectedType}, ${slider.value}kg) to ${name}`,
        total: Math.round(baseFare + (parseInt(slider.value) * 5) + (currentDistance * 12)),
        status: 'Verifying...',
        date: 'Today'
      }));

      alert("Rider request sent! Redirecting to confirmation.");
      window.location.href = "/order_confirmation?type=parcel";
    });
  </script>

  <Switcher />
<script>
        if (!localStorage.getItem('bhusawal_user_token')) {
            window.location.href = '/';
        }
</script>
<script is:inline>
    try {
      const bhusawalParcelMap = L.map('parcel-bhusawal-map', { zoomControl: false, attributionControl: false }).setView([21.0478, 75.7896], 15);
      L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(bhusawalParcelMap);
      L.marker([21.0455, 75.7858]).addTo(bhusawalParcelMap).bindPopup("Pickup: Station Road");
      L.marker([21.0520, 75.7980]).addTo(bhusawalParcelMap).bindPopup("Drop: Jamner Road");
    } catch(e){}
  </script>
</body>
</html>
