      var photoPreviewImg = document.getElementById('photo-preview-img');
      var photoFilename = document.getElementById('photo-filename');
      var uploadedPhotoUrl = '';

      if (photoInput) {
        photoInput.addEventListener('change', function(e) {
          var file = e.target.files && e.target.files[0];
          if (file) {
            var reader = new FileReader();
            reader.onload = function(evt) {
              uploadedPhotoUrl = evt.target.result;
              if (photoPreviewImg) photoPreviewImg.src = uploadedPhotoUrl;
              if (photoFilename) photoFilename.textContent = file.name;
              if (photoPrompt) photoPrompt.classList.add('hidden');
              if (photoPreviewContainer) photoPreviewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
