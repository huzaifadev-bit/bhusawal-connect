        }

        // Search in riders
        var riders = getRiders();
        var matchRider = riders.find(function(r) {
          return (r.name || '').toLowerCase().indexOf(query) >= 0 ||
                 (r.phone || '').indexOf(query) >= 0 ||
                 (r.id || '').toLowerCase().indexOf(query) >= 0;
