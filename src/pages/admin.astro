      // ==================== KYC SECTION ====================
      function refreshKYC() {
        var riders = getRiders();
        var riderAuth = getRiderAuth();

        // Add current rider if registered
        var allRiders = riders.slice();
        if (riderAuth && riderAuth.fullName) {
          var found = allRiders.find(function(r) { return r.phone === riderAuth.phone; });
          if (!found) {
            allRiders.push({
              id: 'BHU-RIDER-NEW',
              name: riderAuth.fullName,
              phone: riderAuth.phone,
              bikeNo: riderAuth.bikeNo || '—',
              isVerified: !!riderAuth.kycApproved,
              kycSubmitted: riderAuth.kycSubmitted !== false,
              kycApproved: riderAuth.kycApproved
            });
          }
        }

        var pendingCount = allRiders.filter(function(r) { return !r.isVerified && !r.kycApproved; }).length;
        document.getElementById('nav-badge-kyc').textContent = pendingCount;

        var tbody = document.getElementById('kyc-table-body');
        if (allRiders.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><span class="material-symbols-outlined">verified_user</span><p>No KYC applications</p></div></td></tr>';
          return;
        }

        var html = '';
        allRiders.forEach(function(r) {
          var kycStatus = (r.isVerified || r.kycApproved) ? '<span class="badge badge-success">✓ Approved</span>' : '<span class="badge badge-warning">Pending</span>';
          var actions = (r.isVerified || r.kycApproved)
            ? '<span style="font-size:12px;color:var(--admin-success);">Verified</span>'
            : '<div class="kyc-actions">' +
                '<button class="btn btn-sm btn-success" onclick="approveKYC(\'' + (r.id || '') + '\', \'' + (r.phone || '') + '\')"><span class="material-symbols-outlined" style="font-size:14px;">check</span> Approve</button>' +
                '<button class="btn btn-sm btn-danger" onclick="rejectKYC(\'' + (r.id || '') + '\')"><span class="material-symbols-outlined" style="font-size:14px;">close</span> Reject</button>' +
              '</div>';

          html += '<tr>' +
            '<td><div class="rider-info"><div class="rider-avatar">' + (r.name || 'R').charAt(0) + '</div><div><div class="rider-name">' + (r.name || 'Unknown') + '</div></div></div></td>' +
            '<td>' + (r.phone || '—') + '</td>' +
            '<td>XXXX-XXXX-' + Math.floor(1000 + Math.random() * 9000) + '</td>' +
            '<td>' + (r.bikeNo || '—') + '</td>' +
            '<td>' + kycStatus + '</td>' +
            '<td style="font-size:12px;color:var(--admin-text-muted);">Today</td>' +
            '<td>' + actions + '</td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      window.approveKYC = function(riderId, phone) {
        // Update riders pool
        var riders = getRiders();
        var idx = riders.findIndex(function(r) { return r.id === riderId; });
        if (idx >= 0) {
          riders[idx].isVerified = true;
          riders[idx].isActive = true;
          riders[idx].kycApproved = true;
          localStorage.setItem(RIDERS_KEY, JSON.stringify(riders));
        }

        // Also update rider auth if matching phone
        var riderAuth = getRiderAuth();
        if (riderAuth && riderAuth.phone === phone) {
          riderAuth.kycApproved = true;
          localStorage.setItem(RIDER_AUTH_KEY, JSON.stringify(riderAuth));
        }

        addNotification('verified', 'KYC Approved', 'Rider ' + riderId + ' KYC approved');
        showToast('KYC Approved ✓');
        refreshAll();
      };

      window.rejectKYC = function(riderId) {
        if (!confirm('Reject KYC for ' + riderId + '?')) return;
        addNotification('gpp_bad', 'KYC Rejected', 'Rider ' + riderId + ' KYC rejected');
        showToast('KYC Rejected', 'cancel');
        refreshAll();
      };

