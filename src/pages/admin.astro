      // ==================== RIDERS SECTION & ACTIONS ====================
      function refreshRiders() {
        var riders = getRiders();
        var riderAuth = getRiderAuth();

        // Sync current rider auth into pool if missing
        if (riderAuth && riderAuth.fullName) {
          var found = riders.find(function(r) { return r.phone === riderAuth.phone; });
          if (!found) {
            riders.push({
              id: 'BHU-RIDER-01',
              name: riderAuth.fullName,
              phone: riderAuth.phone,
              vehicleType: riderAuth.vehicleType || 'Bike/Scooter',
              bikeNo: riderAuth.bikeNo || 'MH-19-BK-9923',
              isOnline: !!riderAuth.isOnline,
              isVerified: !!riderAuth.kycApproved,
              isActive: !!riderAuth.kycApproved,
              isSuspended: false,
              isRejected: false,
              activeOrders: [],
              lat: 21.0478,
              lng: 75.7896,
              rating: 4.9,
              todayEarnings: 680,
              zone: riderAuth.city || 'Bhusawal',
              kycSubmitted: riderAuth.kycSubmitted,
              kycApproved: riderAuth.kycApproved
            });
          }
        }

        var statusFilter = document.getElementById('rider-filter-status').value;
        var orders = getOrders();

        // Compute counts
        var totalCount = riders.length;
        var onlineCount = riders.filter(function(r) { return r.isOnline && (!r.activeOrders || r.activeOrders.length === 0) && !r.isSuspended && (r.isVerified || r.kycApproved); }).length;
        var busyCount = riders.filter(function(r) { return r.isOnline && r.activeOrders && r.activeOrders.length > 0 && !r.isSuspended; }).length;
        var offlineCount = riders.filter(function(r) { return !r.isOnline && !r.isSuspended && !r.isRejected && (r.isVerified || r.kycApproved); }).length;
        var pendingCount = riders.filter(function(r) { return !r.isVerified && !r.kycApproved && !r.isRejected && !r.isSuspended; }).length;
        var rejectedCount = riders.filter(function(r) { return r.isSuspended || r.isRejected; }).length;

        document.getElementById('rider-stat-total').textContent = totalCount;
        document.getElementById('rider-stat-online').textContent = onlineCount;
        document.getElementById('rider-stat-busy').textContent = busyCount;
        document.getElementById('rider-stat-offline').textContent = offlineCount;
        document.getElementById('rider-stat-pending').textContent = pendingCount;
        document.getElementById('rider-stat-rejected').textContent = rejectedCount;

        // Filter riders
        var filtered = riders.filter(function(r) {
          if (statusFilter === 'online') return r.isOnline && (!r.activeOrders || r.activeOrders.length === 0) && !r.isSuspended;
          if (statusFilter === 'busy') return r.isOnline && r.activeOrders && r.activeOrders.length > 0;
          if (statusFilter === 'offline') return !r.isOnline && !r.isSuspended && !r.isRejected && (r.isVerified || r.kycApproved);
          if (statusFilter === 'pending') return !r.isVerified && !r.kycApproved && !r.isRejected && !r.isSuspended;
          if (statusFilter === 'rejected') return r.isSuspended || r.isRejected;
          return true;
        });

        var tbody = document.getElementById('riders-table-body');
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8"><div class="empty-state"><span class="material-symbols-outlined">two_wheeler</span><p>No delivery partners match the selected filter</p></div></td></tr>';
          return;
        }

        var html = '';
        filtered.forEach(function(r) {
          var isVerified = (r.isVerified || r.kycApproved) && !r.isRejected;
          var isSuspended = r.isSuspended || r.isRejected;
          var activeOrd = orders.find(function(o) { return (o.riderId === r.id || o.riderName === r.name) && ['delivered','cancelled'].indexOf((o.status||'').toLowerCase()) < 0; });

          var statusBadge = '';
          if (isSuspended) {
            statusBadge = '<span class="badge badge-danger">🔴 Suspended</span>';
          } else if (!isVerified) {
            statusBadge = '<span class="badge badge-warning">⏳ Verification Pending</span>';
          } else if (r.isOnline) {
            statusBadge = activeOrd ? '<span class="badge badge-warning">🟡 Busy (On Delivery)</span>' : '<span class="badge badge-success">🟢 Available</span>';
          } else {
            statusBadge = '<span class="badge badge-muted">⚪ Offline</span>';
          }

          var currentOrderText = activeOrd ? '<span class="font-mono" style="font-weight:700;color:var(--admin-primary);cursor:pointer;" onclick="viewOrder(\'' + activeOrd.id + '\')">#' + activeOrd.id + '</span>' : '<span style="color:var(--admin-text-muted);">None</span>';
          var gpsText = (r.lat ? r.lat.toFixed(4) + '° N, ' + r.lng.toFixed(4) + '° E' : '21.0478° N, 75.7896° E') + '<br><small style="color:var(--admin-text-muted);">' + (r.zone || 'Jamner Rd, Bhusawal') + '</small>';
          var earningsText = formatCurrency(r.todayEarnings || (Math.floor(Math.random()*4 + 2)*120));
          var ratingText = '⭐ ' + (r.rating || 4.8);

          var actionsHtml = '<div style="display:flex;gap:4px;flex-wrap:wrap;">';
          
          if (!isVerified && !isSuspended) {
            actionsHtml += '<button class="btn btn-sm btn-success" onclick="approveRider(\'' + r.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">check</span> Approve</button>';
            actionsHtml += '<button class="btn btn-sm btn-danger" onclick="rejectRider(\'' + r.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">close</span> Reject</button>';
          } else if (isSuspended) {
            actionsHtml += '<button class="btn btn-sm btn-success" onclick="reactivateRider(\'' + r.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">refresh</span> Reactivate</button>';
          } else {
            actionsHtml += '<button class="btn btn-sm btn-danger" onclick="suspendRider(\'' + r.id + '\')" title="Suspend Rider"><span class="material-symbols-outlined" style="font-size:14px;">block</span></button>';
            actionsHtml += '<button class="btn btn-sm btn-primary" onclick="openAssignOrderToRiderModal(\'' + r.id + '\', \'' + (r.name || 'Rider') + '\')" title="Assign Order"><span class="material-symbols-outlined" style="font-size:14px;">receipt_long</span></button>';
          }

          actionsHtml += '<button class="btn btn-sm btn-outline" onclick="callRider(\'' + (r.phone || '') + '\', \'' + (r.name || 'Rider') + '\')" title="Call Rider"><span class="material-symbols-outlined" style="font-size:14px;">call</span></button>';
          actionsHtml += '<button class="btn btn-sm btn-outline" onclick="openMessageRiderModal(\'' + r.id + '\', \'' + (r.name || 'Rider') + '\')" title="Message Rider"><span class="material-symbols-outlined" style="font-size:14px;">sms</span></button>';
          actionsHtml += '</div>';

          html += '<tr>' +
            '<td><div class="rider-avatar">' + (r.name || 'R').charAt(0) + '</div></td>' +
            '<td><div><div style="font-weight:700;">' + (r.name || 'Rider') + '</div><div style="font-size:11.5px;color:var(--admin-text-muted);">' + (r.phone || '—') + ' • ' + (r.bikeNo || 'Bike') + '</div></div></td>' +
            '<td>' + statusBadge + '</td>' +
            '<td>' + currentOrderText + '</td>' +
            '<td style="font-size:11.5px;">' + gpsText + '</td>' +
            '<td><strong style="color:var(--admin-success);">' + earningsText + '</strong></td>' +
            '<td style="font-weight:600;">' + ratingText + '</td>' +
            '<td>' + actionsHtml + '</td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      // Admin Rider Actions
      window.approveRider = function(riderId) {
        var riders = getRiders();
        var idx = riders.findIndex(function(r) { return r.id === riderId; });
        if (idx >= 0) {
          riders[idx].isVerified = true;
          riders[idx].kycApproved = true;
          riders[idx].isSuspended = false;
          riders[idx].isRejected = false;
          localStorage.setItem(RIDERS_KEY, JSON.stringify(riders));
        }

        var riderAuth = getRiderAuth();
        if (riderAuth) {
          riderAuth.kycApproved = true;
          localStorage.setItem(RIDER_AUTH_KEY, JSON.stringify(riderAuth));
        }

        addNotification('verified', 'Rider Approved', 'Delivery partner ' + riderId + ' approved by admin');
        showToast('Rider Approved ✓', 'check_circle');
        refreshAll();
      };

      window.rejectRider = function(riderId) {
        if (!confirm('Reject verification for rider ' + riderId + '?')) return;
        var riders = getRiders();
        var idx = riders.findIndex(function(r) { return r.id === riderId; });
        if (idx >= 0) {
          riders[idx].isVerified = false;
          riders[idx].kycApproved = false;
          riders[idx].isRejected = true;
          localStorage.setItem(RIDERS_KEY, JSON.stringify(riders));
        }
        addNotification('block', 'Rider Rejected', 'Rider ' + riderId + ' verification rejected');
        showToast('Rider Rejected', 'close');
        refreshAll();
      };

      window.suspendRider = function(riderId) {
        if (!confirm('Suspend rider ' + riderId + '? They will be logged out and disabled from taking orders.')) return;
        var riders = getRiders();
        var idx = riders.findIndex(function(r) { return r.id === riderId; });
        if (idx >= 0) {
          riders[idx].isSuspended = true;
          riders[idx].isOnline = false;
          localStorage.setItem(RIDERS_KEY, JSON.stringify(riders));
        }
        addNotification('block', 'Rider Suspended', 'Rider ' + riderId + ' suspended by admin');
        showToast('Rider Suspended', 'block');
        refreshAll();
      };

      window.reactivateRider = function(riderId) {
        var riders = getRiders();
        var idx = riders.findIndex(function(r) { return r.id === riderId; });
        if (idx >= 0) {
          riders[idx].isSuspended = false;
          riders[idx].isRejected = false;
          riders[idx].isVerified = true;
          riders[idx].kycApproved = true;
          localStorage.setItem(RIDERS_KEY, JSON.stringify(riders));
        }
        addNotification('refresh', 'Rider Reactivated', 'Rider ' + riderId + ' reactivated by admin');
        showToast('Rider Reactivated ✓');
        refreshAll();
      };

      window.callRider = function(phone, name) {
        if (!phone) return showToast('No phone number available', 'error');
        showToast('Calling ' + name + ' (' + phone + ')...', 'call');
        window.location.href = 'tel:' + phone.replace(/\s+/g, '');
      };

      var activeMsgRiderId = '';
      window.openMessageRiderModal = function(riderId, name) {
        activeMsgRiderId = riderId;
        document.getElementById('msg-rider-name').textContent = name;
        document.getElementById('rider-message-text').value = '';
        document.getElementById('rider-message-modal').classList.add('open');
      };

      document.getElementById('btn-send-rider-msg').addEventListener('click', function() {
        var msg = document.getElementById('rider-message-text').value.trim();
        if (!msg) return showToast('Please enter a message', 'error');

        addNotification('sms', 'Rider Message Sent', 'Message sent to rider ' + activeMsgRiderId + ': ' + msg);
