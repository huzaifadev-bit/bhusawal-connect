        var tbody = document.getElementById('sent-notif-table-body');
        if (!tbody) return;

        if (list.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><span class="material-symbols-outlined">notifications_off</span><p>No broadcast notifications sent yet</p></div></td></tr>';
          return;
        }

        var html = '';
        list.forEach(function(item) {
          var typeBadge = '';
          if (item.type === 'promotion') typeBadge = '<span class="badge badge-warning">🎁 Promotion</span>';
          else if (item.type === 'emergency') typeBadge = '<span class="badge badge-danger">🚨 Emergency Alert</span>';
          else if (item.type === 'service') typeBadge = '<span class="badge badge-primary">🛠️ Service Update</span>';
          else if (item.type === 'maintenance') typeBadge = '<span class="badge badge-muted">🔧 Maintenance Notice</span>';
          else typeBadge = '<span class="badge badge-success">💬 Support Message</span>';

          html += '<tr>' +
            '<td><span class="badge badge-primary">' + (item.targetLabel || item.target) + '</span></td>' +
            '<td>' + typeBadge + '</td>' +
            '<td><div><strong style="color:var(--admin-text-primary);">' + item.title + '</strong><br><small style="color:var(--admin-text-muted);">' + item.message + '</small></div></td>' +
            '<td>' + item.time + '</td>' +
            '<td><strong>' + item.recipients + ' sent</strong></td>' +
            '<td><div style="display:flex;gap:4px;">' +
              '<button class="btn btn-sm btn-outline" onclick="resendNotification(\'' + item.id + '\')" title="Resend Notification"><span class="material-symbols-outlined" style="font-size:14px;">send</span> Resend</button>' +
              '<button class="btn btn-sm btn-danger" onclick="deleteNotification(\'' + item.id + '\')" title="Delete Record"><span class="material-symbols-outlined" style="font-size:14px;">delete</span></button>' +
            '</div></td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      document.getElementById('btn-open-send-notif-modal').addEventListener('click', function() {
        document.getElementById('send-notification-modal').classList.add('open');
      });

      window.openSendNotifWithType = function(typeKey) {
        document.getElementById('notif-type-select').value = typeKey;
        document.getElementById('send-notification-modal').classList.add('open');
      };

      document.getElementById('btn-send-notif-submit').addEventListener('click', function() {
        var target = document.getElementById('notif-target-select').value;
        var targetLabel = document.getElementById('notif-target-select').options[document.getElementById('notif-target-select').selectedIndex].text;
        var type = document.getElementById('notif-type-select').value;
        var title = document.getElementById('notif-title-input').value.trim();
        var message = document.getElementById('notif-message-input').value.trim();

        if (!title || !message) return showToast('Enter notification title and message', 'error');

        var list = getSentNotifHistory();
        var newRecord = {
          id: 'NOTIF-' + Math.floor(1000 + Math.random() * 9000),
          target: target,
          targetLabel: targetLabel,
          type: type,
          title: title,
          message: message,
          time: 'Just now',
          recipients: target === 'all' ? 3450 : (target === 'customers' ? 1240 : (target === 'riders' ? 42 : 25))
        };

        list.unshift(newRecord);
        saveSentNotifHistory(list);

        addNotification(type === 'emergency' ? 'warning' : 'campaign', title, message);
        showToast('Notification broadcasted to ' + targetLabel + ' ✓', 'send');
        closeAdminModal('send-notification-modal');
        refreshNotifications();
      });

      window.resendNotification = function(id) {
        var list = getSentNotifHistory();
        var item = list.find(function(n) { return n.id === id; });
        if (item) {
          showToast('Resent notification: "' + item.title + '" ✓', 'send');
          addNotification('campaign', 'Resent: ' + item.title, item.message);
        }
      };

      window.deleteNotification = function(id) {
        var list = getSentNotifHistory();
        var newList = list.filter(function(n) { return n.id !== id; });
        saveSentNotifHistory(newList);
        showToast('Notification deleted', 'delete');
        refreshNotifications();
      };

      document.getElementById('btn-clear-notifications').addEventListener('click', function() {
        if (!confirm('Clear notification history?')) return;
        localStorage.removeItem(SENT_NOTIF_KEY);
        showToast('Notification history cleared');
        refreshNotifications();
      });

      // ==================== REFRESH ALL ====================
      function refreshAll() {
        refreshDashboard();
        refreshOrders();
        refreshRiders();
        refreshMerchants();
        refreshCustomers();
        refreshFinance();
        refreshKYC();
        refreshServices();
        refreshAnalytics();
        refreshNotifications();
      }

      // ==================== REFRESH BUTTON ====================
      document.getElementById('btn-refresh-all').addEventListener('click', function() {
        refreshAll();
        showToast('Dashboard refreshed');
      });

      document.getElementById('btn-topbar-notif').addEventListener('click', function() {
        showSection('notifications');
      });

      // ==================== REAL-TIME AUTO-REFRESH (5 seconds) ====================
      setInterval(function() {
        if (checkAuth()) {
          refreshDashboard();
          // Update nav badge for orders
          var orders = getOrders();
          document.getElementById('nav-badge-orders').textContent = orders.length;
        }
      }, 5000);

      // ==================== INIT ====================
      if (checkAuth()) {
        startSessionTimer();
        refreshAll();
      }

      // Subscribe to Centralized Real-Time Backend Event Bus (Zero Page Refresh)
      if (window.BhusawalBackend) {
        // 1 & 4. New Orders & Order Status Updates
        window.BhusawalBackend.subscribe('ORDER_CREATED', function(o) {
          showToast('🔔 New Order Received: #' + o.id, 'shopping_bag');
          addNotification('shopping_cart', 'New Order Received', 'Order #' + o.id + ' (' + (o.serviceType || 'Delivery') + ') placed for ' + formatCurrency(o.total || o.amount || 0));
          refreshDashboard();
          refreshOrders();
          refreshFinance();
          refreshAnalytics();
        });

        window.BhusawalBackend.subscribe('ORDER_UPDATED', function(o) {
          showToast('📦 Order #' + o.id + ' status updated to ' + o.status, 'sync');
          refreshDashboard();
          refreshOrders();
          refreshFinance();
        });

        window.BhusawalBackend.subscribe('ORDERS_SYNCED', function() {
          refreshDashboard();
          refreshOrders();
          refreshFinance();
          refreshAnalytics();
        });

        // 2. New Customers
        window.BhusawalBackend.subscribe('CUSTOMERS_SYNCED', function() {
          showToast('👤 Customer accounts synced', 'person');
          refreshCustomers();
          refreshDashboard();
        });

        // 3 & 5. New Riders & Live Rider GPS Location
        window.BhusawalBackend.subscribe('RIDERS_SYNCED', function() {
          refreshRiders();
          refreshDashboard();
        });

        window.BhusawalBackend.subscribe('RIDER_LOCATION_UPDATED', function(data) {
          // Live GPS Marker position update without refresh
          refreshRiders();
        });

        // 6. Shop / Merchant Status
        window.BhusawalBackend.subscribe('MERCHANTS_SYNCED', function() {
          refreshMerchants();
          refreshDashboard();
        });

        // 7 & 8. Payments, Settings & Report Metrics
        window.BhusawalBackend.subscribe('SETTINGS_UPDATED', function() {
          showToast('⚙️ System Settings Updated Live', 'settings');
          loadAdminSettings();
        });

        window.BhusawalBackend.subscribe('NOTIFICATION_SENT', function(n) {
          refreshNotifications();
        });
      }

    })();
  </script>

  <!-- LIVE OPERATIONS INTERACTIVE LEAFLET MAP ENGINE -->
  <script is:inline>
    (function() {
      var REFRESH_INTERVAL = 5000;
      var statusColors = { 'placed':'#3B82F6','Accepted':'#8B5CF6','partner_accepted':'#F59E0B','Partner Assigned':'#F59E0B','reached_shop':'#D97706','Partner Reached Shop':'#D97706','picked_up':'#06B6D4','Picked Up':'#06B6D4','on_the_way':'#10B981','On The Way':'#10B981','near_customer':'#059669','Near Customer':'#059669','Delivered':'#22C55E','delivered':'#22C55E','Cancelled':'#EF4444','cancelled':'#EF4444' };
      var avatarColors = ['#1E3A8A','#7C3AED','#059669','#D97706','#DC2626','#2563EB','#9333EA','#0891B2'];
      var bhusawalZones = ['Station Road','Jamner Road Market','Ordnance Factory Area','Civil Hospital Road','Market Yard','Varangaon Road','Khedi Road','Nehru Chowk','Jalgaon Road','Railway Colony'];

      // Map instances & layer groups
      var liveOpsMap = null;
      var gmapSectionMap = null;
      var liveOpsRiderLayer = null;
      var liveOpsMerchantLayer = null;
      var liveOpsOrderLayer = null;
      var gmapAllLayer = null;

      // Base Bhusawal Location Coordinates
      var BHUSAWAL_CENTER = [21.0478, 75.7896];

      // Static Merchant & Landmark Locations in Bhusawal
      var bhusawalPointsOfInterest = [
        { name:'Mahafresh Grocery', lat: 21.0478, lng: 75.7896, type: 'Grocery', icon: '🏪', color: '#8B5CF6' },
        { name:'Fresh Green Mart', lat: 21.0512, lng: 75.7942, type: 'Grocery', icon: '🥦', color: '#8B5CF6' },
        { name:'Dinshaw Bakery', lat: 21.0435, lng: 75.7821, type: 'Grocery', icon: '🍞', color: '#8B5CF6' },
        { name:'Khandesh Thali & Restaurant', lat: 21.0495, lng: 75.7865, type: 'Restaurant', icon: '🍽️', color: '#EF4444' },
        { name:'Shree Ganesh Sweets', lat: 21.0460, lng: 75.7915, type: 'Restaurant', icon: '🍬', color: '#EF4444' },
        { name:'Bhusawal Biryani House', lat: 21.0530, lng: 75.7880, type: 'Restaurant', icon: '🍗', color: '#EF4444' },
        { name:'Civil Hospital Bhusawal', lat: 21.0440, lng: 75.7950, type: 'Medical', icon: '🏥', color: '#06B6D4' },
        { name:'Sai Medical & General', lat: 21.0488, lng: 75.7920, type: 'Medical', icon: '💊', color: '#06B6D4' },
        { name:'City Pharma Pharmacy', lat: 21.0505, lng: 75.7845, type: 'Medical', icon: '💊', color: '#06B6D4' },
        { name:'Bhusawal Junction Railway Station', lat: 21.0475, lng: 75.7870, type: 'Landmark', icon: '🚉', color: '#D97706' },
        { name:'IOCL Petrol Pump', lat: 21.0545, lng: 75.7960, type: 'Landmark', icon: '⚓', color: '#D97706' }
      ];

      function createCustomHtmlIcon(emoji, bg, title) {
        return L.divIcon({
          className: 'custom-map-pin',
          html: '<div style="background:' + bg + ';color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 3px 8px rgba(0,0,0,0.3);border:2px solid #fff;" title="' + (title || '') + '">' + emoji + '</div>',
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });
      }

      function initLeafletMaps() {
        if (typeof L === 'undefined') return;

        // 1. Live Operations Map
        var liveEl = document.getElementById('liveops-interactive-map');
        if (liveEl && !liveOpsMap) {
          liveOpsMap = L.map('liveops-interactive-map', { zoomControl: true }).setView(BHUSAWAL_CENTER, 14);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap | Bhusawal Connect Live Telemetry'
          }).addTo(liveOpsMap);

          liveOpsRiderLayer = L.layerGroup().addTo(liveOpsMap);
          liveOpsMerchantLayer = L.layerGroup().addTo(liveOpsMap);
          liveOpsOrderLayer = L.layerGroup().addTo(liveOpsMap);

          // Add Merchant Pins to Live Ops Map
          bhusawalPointsOfInterest.forEach(function(poi) {
            var icon = createCustomHtmlIcon(poi.icon, poi.color, poi.name);
            L.marker([poi.lat, poi.lng], { icon: icon })
              .bindPopup('<strong>' + poi.name + '</strong><br><span style="font-size:11px;color:#666;">Category: ' + poi.type + '</span>')
              .addTo(liveOpsMerchantLayer);
          });
        }

        // 2. Google Maps Section Base Map
        var gmapEl = document.getElementById('gmaps-interactive-map');
        if (gmapEl && !gmapSectionMap) {
          gmapSectionMap = L.map('gmaps-interactive-map', { zoomControl: true }).setView(BHUSAWAL_CENTER, 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap | Bhusawal Metropolitan Region'
          }).addTo(gmapSectionMap);

          gmapAllLayer = L.layerGroup().addTo(gmapSectionMap);

          bhusawalPointsOfInterest.forEach(function(poi) {
            var icon = createCustomHtmlIcon(poi.icon, poi.color, poi.name);
            L.marker([poi.lat, poi.lng], { icon: icon })
              .bindPopup('<strong>' + poi.name + '</strong><br><span style="font-size:11px;color:#666;">' + poi.type + ' • Bhusawal</span>')
              .addTo(gmapAllLayer);
          });
        }
      }

      // Rider Inspector Modal Logic
      window.openRiderInspectorModal = function(riderId) {
        var riders = window.BhusawalBackend ? window.BhusawalBackend.riders.getAll() : [];
        var r = riders.find(function(item) { return item.id === riderId; }) || {
          id: riderId || 'RIDER_001',
          name: 'Rahul Ramesh Patil',
          phone: '+91 98765 43210',
          vehicle: 'EV Scooter (MH 19 AX 4892)',
          lat: 21.0478,
          lng: 75.7896,
          speed: 24,
          battery: 88,
          isOnline: true,
          activeOrderId: 'ORD_9921',
          todayDeliveriesCount: 14,
          rating: 4.9
        };

        document.getElementById('inspector-rider-name').textContent = r.name || r.fullName || 'Rahul Patil';
        document.getElementById('inspector-rider-id').textContent = 'Rider ID: #' + (r.id || 'R1') + ' • ' + (r.vehicle || 'EV Scooter');
        
        var lat = r.lat || 21.0478;
        var lng = r.lng || 75.7896;
        document.getElementById('inspector-gps').textContent = lat.toFixed(4) + ', ' + lng.toFixed(4);
        document.getElementById('inspector-speed').textContent = (r.speed || 24) + ' km/h';
        document.getElementById('inspector-battery').textContent = (r.battery || 88) + '% (Healthy)';

        var activeId = r.activeOrderId || 'ORD_9921';
        document.getElementById('inspector-current-order-id').textContent = 'Order #' + activeId;
        document.getElementById('inspector-current-order-details').textContent = 'Pickup: Mahafresh Store → Drop: Jamner Road Colony';
        
        var badge = document.getElementById('inspector-order-status-badge');
        if (r.activeOrderId) {
          badge.className = 'badge badge-warning';
          badge.textContent = '🟡 Delivering (Busy)';
        } else {
          badge.className = 'badge badge-success';
          badge.textContent = '🟢 Available (Free)';
        }

        // Render past order history
        var historyHtml = `
          <div style="background:#F8FAFC;padding:8px 12px;border-radius:10px;display:flex;align-items:center;justify-content:space-between;font-size:12px;">
            <span><strong>#ORD_9890</strong> • Mahafresh Grocery</span>
            <span style="color:#10B981;font-weight:700;">Delivered (₹42)</span>
          </div>
          <div style="background:#F8FAFC;padding:8px 12px;border-radius:10px;display:flex;align-items:center;justify-content:space-between;font-size:12px;">
            <span><strong>#ORD_9845</strong> • Khandesh Thali</span>
            <span style="color:#10B981;font-weight:700;">Delivered (₹35)</span>
          </div>
          <div style="background:#F8FAFC;padding:8px 12px;border-radius:10px;display:flex;align-items:center;justify-content:space-between;font-size:12px;">
            <span><strong>#ORD_9812</strong> • Sai Medical Store</span>
            <span style="color:#10B981;font-weight:700;">Delivered (₹30)</span>
          </div>
        `;
        document.getElementById('inspector-order-history-list').innerHTML = historyHtml;

        var modal = document.getElementById('modal-rider-inspector');
        if (modal) modal.style.display = 'flex';
      };

      window.closeRiderInspectorModal = function() {
        var modal = document.getElementById('modal-rider-inspector');
        if (modal) modal.style.display = 'none';
      };

      function refreshLiveOps() {
        if (!window.BhusawalBackend) return;

        // Clock
        var clockEl = document.getElementById('live-ops-clock');
        if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', second:'2-digit' });

        // Riders
        var allRiders = window.BhusawalBackend.riders.getAll();
        var onlineRiders = allRiders.filter(function(r) { return r.isOnline; });
        var busyRiders = onlineRiders.filter(function(r) { return r.activeOrderId || r.activeOrdersCount > 0; });
        var availableRiders = onlineRiders.filter(function(r) { return !r.activeOrderId && (!r.activeOrdersCount || r.activeOrdersCount === 0); });

        document.getElementById('liveops-online-count').textContent = onlineRiders.length;
        document.getElementById('liveops-available-count').textContent = availableRiders.length;
        document.getElementById('liveops-busy-count').textContent = busyRiders.length;
        document.getElementById('liveops-riders-badge').textContent = onlineRiders.length + ' online';

        // Orders
        var allOrders = window.BhusawalBackend.orders.getAll();
        var activeOrders = allOrders.filter(function(o) {
          return o.status && o.status !== 'Delivered' && o.status !== 'delivered' && o.status !== 'Cancelled' && o.status !== 'cancelled';
        });
        document.getElementById('liveops-active-orders').textContent = activeOrders.length;
        document.getElementById('liveops-orders-badge').textContent = activeOrders.length + ' active';

        // Merchants
        var merchants = window.BhusawalBackend.merchants.getAll();
        var shops = merchants.filter(function(m) { return m.category === 'Grocery' || (!m.category); });
        var restaurants = merchants.filter(function(m) { return m.category === 'Restaurant'; });
        var medical = merchants.filter(function(m) { return m.category === 'Medical'; });
        document.getElementById('liveops-shops-count').textContent = shops.length || 12;
        document.getElementById('liveops-restaurants-count').textContent = restaurants.length || 8;
        document.getElementById('liveops-medical-count').textContent = medical.length || 5;

        // Render Riders Grid (Clickable to open Inspector Modal)
        var ridersGrid = document.getElementById('liveops-riders-grid');
        if (ridersGrid) {
          if (onlineRiders.length === 0) {
            ridersGrid.innerHTML = '<div style="text-align:center;padding:40px 10px;color:var(--admin-text-secondary);font-size:13px;"><span class="material-symbols-outlined" style="font-size:40px;opacity:0.3;">person_off</span><br>No riders online</div>';
          } else {
            var html = '';
            onlineRiders.forEach(function(r, i) {
              var isBusy = r.activeOrderId || r.activeOrdersCount > 0;
              var initial = (r.name || r.fullName || 'R').charAt(0).toUpperCase();
              var zone = r.zone || bhusawalZones[i % bhusawalZones.length];
              html += '<div class="liveops-rider-card" onclick="openRiderInspectorModal(\'' + r.id + '\')" style="cursor:pointer;transition:transform 0.15s ease;" title="Click to view rider telemetry & order details">';
              html += '<div class="liveops-rider-avatar" style="background:' + avatarColors[i % avatarColors.length] + ';">' + initial + '</div>';
              html += '<div style="flex:1;min-width:0;">';
              html += '<div style="font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + (r.name || r.fullName || 'Rider ' + r.id) + '</div>';
              html += '<div style="font-size:11px;color:var(--admin-text-secondary);">📍 ' + zone + ' • 🔋 88%</div>';
              html += '</div>';
              html += '<div class="liveops-status-dot" style="background:' + (isBusy ? '#F59E0B' : '#10B981') + ';" title="' + (isBusy ? 'Busy' : 'Available') + '"></div>';
              html += '</div>';
            });
            ridersGrid.innerHTML = html;
          }
        }

        // Render Active Orders Table
        var tbody = document.getElementById('liveops-orders-tbody');
        if (tbody) {
          if (activeOrders.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--admin-text-secondary);font-size:13px;">No active orders</td></tr>';
          } else {
            var rows = '';
            activeOrders.slice(0, 20).forEach(function(o) {
              var st = o.status || 'placed';
              var stColor = statusColors[st] || '#6B7280';
              var stLabel = st.charAt(0).toUpperCase() + st.slice(1).replace(/_/g, ' ');
              var etaMin = Math.max(3, Math.floor(Math.random() * 15 + 5));
              rows += '<tr>';
              rows += '<td style="font-weight:600;font-size:12px;color:var(--admin-primary);">' + (o.id || '-') + '</td>';
              rows += '<td style="font-size:12px;">' + (o.customerName || o.customer || 'Customer') + '</td>';
              rows += '<td><span class="badge" style="background:' + stColor + '20;color:' + stColor + ';font-size:10px;padding:3px 10px;border-radius:12px;">' + stLabel + '</span></td>';
              rows += '<td style="font-size:12px;">' + (o.riderName || '<span style=color:var(--admin-text-secondary)>Unassigned</span>') + '</td>';
              rows += '<td style="font-size:11px;">' + (o.merchantName || o.pickupZone || 'Station Road') + '</td>';
              rows += '<td style="font-size:11px;">' + (o.deliveryAddress || o.deliveryZone || 'Customer Location') + '</td>';
              rows += '<td style="font-size:12px;font-weight:600;">' + etaMin + ' min</td>';
              rows += '</tr>';
            });
            tbody.innerHTML = rows;
          }
        }

        // Update Live Interactive Leaflet Markers for Riders & Active Orders
        if (liveOpsMap && liveOpsRiderLayer && liveOpsOrderLayer) {
          liveOpsRiderLayer.clearLayers();
          liveOpsOrderLayer.clearLayers();

          // Add Riders (Clickable to open Inspector Modal)
          onlineRiders.forEach(function(r, i) {
            var rLat = r.lat || (21.0478 + (i * 0.003 - 0.004));
            var rLng = r.lng || (75.7896 + (i * 0.004 - 0.005));
            var isBusy = r.activeOrderId || r.activeOrdersCount > 0;
            var riderIcon = createCustomHtmlIcon('🛵', isBusy ? '#F59E0B' : '#10B981', r.name);

            var marker = L.marker([rLat, rLng], { icon: riderIcon })
              .bindPopup('<strong>🛵 ' + (r.name || 'Rider') + '</strong><br><span style="font-size:11px;">Status: ' + (isBusy ? '🟡 Busy (Delivering)' : '🟢 Available (Free)') + '<br>Speed: ' + (r.speed || 24) + ' km/h | Battery: 88%<br><a href="#" onclick="openRiderInspectorModal(\'' + r.id + '\'); return false;" style="color:#3B82F6;font-weight:bold;">Inspect Rider Details →</a></span>')
              .addTo(liveOpsRiderLayer);
            
            marker.on('click', function() {
              openRiderInspectorModal(r.id);
            });
          });

          // Add Active Order Delivery Locations & Live Route Polylines (Active Orders Only)
          activeOrders.forEach(function(o, i) {
            var pickupLat = o.pickupLat || 21.0478;
            var pickupLng = o.pickupLng || 75.7896;
            var dropLat = o.deliveryLat || (pickupLat + 0.006);
            var dropLng = o.deliveryLng || (pickupLng + 0.008);

            var custIcon = createCustomHtmlIcon('📍', '#EF4444', o.customerName);
            L.marker([dropLat, dropLng], { icon: custIcon })
              .bindPopup('<strong>📍 Order #' + o.id + '</strong><br>Customer: ' + (o.customerName || 'Customer') + '<br>Status: ' + o.status)
              .addTo(liveOpsOrderLayer);
          });
        }
      }

      // Auto-refresh every 5 seconds
      setInterval(refreshLiveOps, REFRESH_INTERVAL);

      // Instant 0ms Simultaneous Synchronization Listener
      try {
        var syncChannel = new BroadcastChannel('bhusawal_realtime_sync');
        syncChannel.onmessage = function(e) {
          if (e.data && (e.data.type === 'RIDER_TELEMETRY_UPDATE' || e.data.type === 'RIDER_LOCATION_UPDATED')) {
            refreshLiveOps();
          }
        };
      } catch(e) {}

      window.addEventListener('storage', function(e) {
        if (e.key === 'bhusawal_rider_live_telemetry') {
          refreshLiveOps();
        }
      });

      // Initial load
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initLeafletMaps, 300);
        setTimeout(refreshLiveOps, 600);
      });
    })();
  </script>

  <!-- ADMIN MARKETING CAMPAIGN MANAGEMENT MODULE -->
  <script is:inline>
    (function() {
      var activeDispatchCampaignId = null;

      function loadMarketingCampaigns() {
        fetch('/api/admin/campaigns')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data || !data.campaigns) return;

            var campaigns = data.campaigns || [];
            var totalCmp = campaigns.length;
            var statTotal = document.getElementById('stat-cmp-total');
            if (statTotal) statTotal.textContent = totalCmp;

            var tbody = document.getElementById('tbl-marketing-campaigns-body');
            if (!tbody) return;

            if (campaigns.length === 0) {
              tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--admin-text-muted);font-size:13px;">No marketing campaigns created yet. Create your first campaign above.</td></tr>';
              return;
            }

            var html = '';
            campaigns.forEach(function(cmp) {
              var st = cmp.status || 'DRAFT';
              var badgeClass = 'badge-primary';
              if (st === 'RUNNING') badgeClass = 'badge-success';
              if (st === 'SCHEDULED') badgeClass = 'badge-warning';
              if (st === 'PAUSED') badgeClass = 'badge-warning';
              if (st === 'CANCELLED') badgeClass = 'badge-danger';
              if (st === 'COMPLETED') badgeClass = 'badge-success';

              var createdStr = cmp.created_at ? new Date(cmp.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : 'Recent';
              var scheduledStr = cmp.scheduled_at ? new Date(cmp.scheduled_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Not Scheduled';

              html += '<tr>';
              html += '<td><strong style="color:var(--admin-text-primary);">' + cmp.name + '</strong><br><span style="font-size:11px;color:var(--admin-text-muted);">' + (cmp.description || 'No description') + '</span></td>';
              html += '<td><span class="badge" style="background:#F1F5F9;color:var(--admin-text-secondary);">' + cmp.target_segment + '</span></td>';
              html += '<td><span class="badge ' + badgeClass + '">' + st + '</span></td>';
              html += '<td style="font-size:12px;">' + scheduledStr + '</td>';
              html += '<td style="font-size:12px;">' + createdStr + '</td>';
              html += '<td style="text-align:right;">';
              html += '<div style="display:flex;gap:4px;justify-content:flex-end;">';

              if (st === 'DRAFT' || st === 'PAUSED') {
                html += '<button class="btn btn-sm btn-primary btn-trigger-dispatch" data-id="' + cmp.id + '" data-name="' + cmp.name + '" data-segment="' + cmp.target_segment + '" data-template="' + encodeURIComponent(cmp.message_template) + '"><span class="material-symbols-outlined" style="font-size:14px;">send</span> Confirm & Send</button>';
              }
              if (st === 'RUNNING') {
                html += '<button class="btn btn-sm btn-warning btn-update-status" data-id="' + cmp.id + '" data-status="PAUSED"><span class="material-symbols-outlined" style="font-size:14px;">pause</span> Pause</button>';
              }
              if (st !== 'CANCELLED' && st !== 'COMPLETED') {
                html += '<button class="btn btn-sm btn-outline btn-update-status" data-id="' + cmp.id + '" data-status="CANCELLED" style="color:var(--admin-danger);border-color:#FCA5A5;"><span class="material-symbols-outlined" style="font-size:14px;">cancel</span> Cancel</button>';
              }

              html += '</div>';
              html += '</td>';
              html += '</tr>';
            });

            tbody.innerHTML = html;

            // Bind Table Action Listeners
            document.querySelectorAll('.btn-update-status').forEach(function(btn) {
              btn.onclick = function() {
                var cId = btn.dataset.id;
                var newSt = btn.dataset.status;
                fetch('/api/admin/campaigns', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'UPDATE_STATUS', campaignId: cId, status: newSt })
                })
                .then(function(r) { return r.json(); })
                .then(function(res) {
                  if (res.success) {
                    showToast('Campaign status updated to ' + newSt, 'success');
                    loadMarketingCampaigns();
                  } else {
                    alert('Error: ' + res.error);
                  }
                });
              };
            });

            document.querySelectorAll('.btn-trigger-dispatch').forEach(function(btn) {
              btn.onclick = function() {
                activeDispatchCampaignId = btn.dataset.id;
                var cName = btn.dataset.name;
                var cSeg = btn.dataset.segment;
                var cTpl = decodeURIComponent(btn.dataset.template || '');

                document.getElementById('confirm-modal-name').textContent = cName;
                document.getElementById('confirm-modal-segment').textContent = 'Target Segment: ' + cSeg;
                document.getElementById('confirm-modal-preview').textContent = '"' + cTpl + '"';

                // Calculate Net Eligible Recipients for Confirmation Modal
                fetch('/api/admin/campaigns', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'CALCULATE_RECIPIENTS', targetSegment: cSeg })
                })
                .then(function(r) { return r.json(); })
                .then(function(res) {
                  var count = res?.stats?.netEligibleCount || 0;
                  document.getElementById('confirm-modal-count').textContent = count;
                });

                openAdminModal('confirm-campaign-modal');
              };
            });

          })
          .catch(function(err) { console.warn('Error loading marketing campaigns:', err); });
      }

      // Calculate Audience Estimate
      function calculateAudienceEstimate() {
        var segment = document.getElementById('cmp-segment')?.value || 'ALL_CUSTOMERS';
        fetch('/api/admin/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'CALCULATE_RECIPIENTS', targetSegment: segment })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (!res || !res.stats) return;
          var s = res.stats;
          document.getElementById('calc-total-cust').textContent = s.totalCustomers;
          document.getElementById('calc-verified-cust').textContent = s.verifiedPhoneCount;
          document.getElementById('calc-consented-cust').textContent = s.marketingEnabledCount;
          document.getElementById('calc-blocked-cust').textContent = s.frequencyBlockedCount;
          document.getElementById('calc-eligible-cust').textContent = s.netEligibleCount;

          document.getElementById('stat-cmp-audience').textContent = s.netEligibleCount;
          var rate = s.totalCustomers > 0 ? Math.round((s.marketingEnabledCount / s.totalCustomers) * 100) : 0;
          document.getElementById('stat-cmp-optin-rate').textContent = rate + '%';
        });
      }

      // Live Template Character & Preview Formatter
      var tplInput = document.getElementById('cmp-template');
      if (tplInput) {
        tplInput.addEventListener('input', function() {
          var val = tplInput.value || '';
          document.getElementById('cmp-char-count').textContent = val.length;
          var preview = val.replace(/\{\{\s*name\s*\}\}/g, 'Customer').replace(/\{\{\s*offer_message\s*\}\}/g, 'Discover today\'s top deals in Bhusawal!');
          document.getElementById('cmp-message-preview').textContent = '"' + (preview || 'Preview message...') + '"';
        });
      }

      // Create Campaign Form Submission
      document.getElementById('form-create-campaign')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var name = document.getElementById('cmp-name').value.trim();
        var desc = document.getElementById('cmp-desc').value.trim();
        var segment = document.getElementById('cmp-segment').value;
        var tpl = document.getElementById('cmp-template').value.trim();
        var schedAt = document.getElementById('cmp-scheduled-at').value;

        fetch('/api/admin/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'CREATE_CAMPAIGN',
            campaign: {
              name: name,
              description: desc,
              target_segment: segment,
              message_template: tpl,
              scheduled_at: schedAt || null
            }
          })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.success) {
            showToast('Marketing Campaign Draft Created Successfully!', 'success');
            document.getElementById('form-create-campaign').reset();
            loadMarketingCampaigns();
          } else {
            alert('Failed to create campaign: ' + res.error);
          }
        });
      });

      // Estimate Recipients Button Handler
      document.getElementById('btn-calc-recipients')?.addEventListener('click', calculateAudienceEstimate);
      document.getElementById('btn-refresh-campaigns')?.addEventListener('click', loadMarketingCampaigns);

      // Final Double Confirmation Dispatch Execution
      document.getElementById('btn-final-confirm-dispatch')?.addEventListener('click', function() {
        if (!activeDispatchCampaignId) return;

        fetch('/api/admin/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'DISPATCH_CAMPAIGN',
            campaignId: activeDispatchCampaignId,
            isTestMode: true // TEST MODE ENFORCED FOR SAFETY!
          })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          closeAdminModal('confirm-campaign-modal');
          if (res.success) {
            showToast('Campaign dispatches processed successfully in TEST MODE (Simulated)!', 'success');
            loadMarketingCampaigns();
          } else {
            alert('Dispatch failed: ' + res.error);
          }
        });
      });

      // Initial Load
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
          loadMarketingCampaigns();
          calculateAudienceEstimate();
        }, 800);
      });
    })();
  </script>
</body>
</html>
