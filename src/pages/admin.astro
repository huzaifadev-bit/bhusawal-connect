      document.getElementById('btn-save-product-edit').addEventListener('click', function() {
        var pId = document.getElementById('edit-prod-target-id').value;
        if (!prodOverrides[pId]) prodOverrides[pId] = {};

        prodOverrides[pId].name = document.getElementById('edit-prod-name').value.trim();
        prodOverrides[pId].brand = document.getElementById('edit-prod-brand').value.trim();
        prodOverrides[pId].pack = document.getElementById('edit-prod-pack').value.trim();
