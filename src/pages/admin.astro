      window.hideProduct = function(id) {
        if (!prodOverrides[id]) prodOverrides[id] = {};
        prodOverrides[id].hidden = true;
        localStorage.setItem('bhusawal_catalog_overrides', JSON.stringify(prodOverrides));
        showToast('Product #' + id + ' hidden');
        refreshProducts();
      };

      window.showProduct = function(id) {
        if (!prodOverrides[id]) prodOverrides[id] = {};
        prodOverrides[id].hidden = false;
        localStorage.setItem('bhusawal_catalog_overrides', JSON.stringify(prodOverrides));
        showToast('Product #' + id + ' published ✓');
        refreshProducts();
      };

      // Bulk Export Catalog
      document.getElementById('btn-bulk-export-catalog').addEventListener('click', function() {
        var exportData = catalogData.map(getEffectiveProduct);
        var blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'bhusawal_catalog_8000_' + new Date().toISOString().split('T')[0] + '.json';
        a.click();
        URL.revokeObjectURL(url);
        showToast('Exported 8,000+ catalog items ✓');
      });

      // Bulk Import Catalog
      document.getElementById('btn-open-bulk-import').addEventListener('click', function() {
        document.getElementById('bulk-import-status').style.display = 'none';
        document.getElementById('bulk-import-modal').classList.add('open');
      });

      document.getElementById('btn-execute-bulk-import').addEventListener('click', function() {
        var fileInput = document.getElementById('bulk-import-file-input');
        if (!fileInput.files || fileInput.files.length === 0) return showToast('Select a JSON file to import', 'error');

        var reader = new FileReader();
        reader.onload = function(e) {
          try {
            var imported = JSON.parse(e.target.result);
            if (Array.isArray(imported)) {
              catalogData = imported;
              document.getElementById('bulk-import-status').textContent = '✓ Successfully imported ' + imported.length.toLocaleString() + ' products';
              document.getElementById('bulk-import-status').style.display = 'block';
              showToast('Bulk import completed: ' + imported.length + ' products');
              refreshProducts();
              setTimeout(function() { closeAdminModal('bulk-import-modal'); }, 1500);
            } else {
              showToast('Invalid catalog format (expected JSON array)', 'error');
            }
          } catch(err) {
            showToast('JSON parse error during import', 'error');
          }
        };
        reader.readAsText(fileInput.files[0]);
      });

