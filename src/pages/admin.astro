      var activeAssignRiderId = '';
      window.openAssignOrderToRiderModal = function(riderId, name) {
        activeAssignRiderId = riderId;
        document.getElementById('assign-to-rider-name').textContent = name;

        var orders = getOrders();
        var unassigned = orders.filter(function(o) { return !o.riderId && !o.riderName && ['placed','confirmed'].indexOf((o.status||'').toLowerCase()) >= 0; });
        var listEl = document.getElementById('pending-orders-assign-list');

        if (unassigned.length === 0) {
          listEl.innerHTML = '<div class="empty-state"><span class="material-symbols-outlined">inbox</span><p>No pending unassigned orders right now</p></div>';
        } else {
          var html = '';
          unassigned.forEach(function(o) {
            var svc = getServiceType(o);
            html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px;border:1px solid var(--admin-border);border-radius:10px;background:#F8FAFC;">' +
              '<div>' +
                '<div style="font-weight:700;font-size:13.5px;"><span class="font-mono">#' + o.id + '</span> • <span class="badge ' + getServiceBadgeColor(svc) + '">' + svc + '</span></div>' +
                '<div style="font-size:11.5px;color:var(--admin-text-muted);">' + (o.customerName || 'Customer') + ' • ' + formatCurrency(o.total || o.amount) + '</div>' +
              '</div>' +
              '<button class="btn btn-sm btn-primary" onclick="assignRiderToOrder(\'' + o.id + '\', \'' + riderId + '\', \'' + name + '\', \'\')">Assign Order</button>' +
            '</div>';
          });
          listEl.innerHTML = html;
        }
        document.getElementById('rider-assign-order-modal').classList.add('open');
      };

      document.getElementById('rider-filter-status').addEventListener('change', refreshRiders);

      // ==================== CUSTOMERS SECTION ====================
      function refreshCustomers() {
        var customers = [];
        if (window.BhusawalBackend) {
          customers = window.BhusawalBackend.customers.getAll();
        }

        var filterEl = document.getElementById('customer-filter-status');
        var filterVal = filterEl ? filterEl.value : 'all';

        if (filterVal === 'active') customers = customers.filter(function(c) { return c.accountStatus !== 'blocked'; });
        else if (filterVal === 'blocked') customers = customers.filter(function(c) { return c.accountStatus === 'blocked'; });

        var tbody = document.getElementById('customers-table-body');
        if (!tbody) return;

        if (customers.length === 0) {
          tbody.innerHTML = '<tr><td colspan="10"><div class="empty-state"><span class="material-symbols-outlined">group</span><p>No customer data available yet. Registered customers will appear here.</p></div></td></tr>';
          return;
        }

        customers.sort(function(a, b) { return (b.totalSpend || 0) - (a.totalSpend || 0); });

        var html = '';
        customers.forEach(function(c) {
          var custId = c.customerId || ('CUST-' + (c.uid ? c.uid.substring(0, 6).toUpperCase() : '9923'));
          var name = c.name || 'Bhusawal Customer';
          var phone = c.phoneNumber || c.phone || '—';
          var area = c.preferredArea || 'Bhusawal City';
          
          var totalOrders = c.totalOrders || 0;
          var completedOrders = c.totalCompletedOrders || 0;
          var cancelledOrders = c.totalCancelledOrders || 0;
          
          var totalSpend = c.totalSpend || 0;
          var aov = c.averageOrderValue || (totalOrders > 0 ? Math.round(totalSpend / totalOrders) : 0);

          var lastOrderDate = c.lastOrderAt ? new Date(c.lastOrderAt).toLocaleDateString() : 'No Orders Yet';
          var favCats = c.favoriteCategories && c.favoriteCategories.length > 0 ? c.favoriteCategories.join(', ') : 'Daily Needs';

          var mktConsent = c.marketingConsent !== false ? '<span class="badge badge-success">✓ Granted</span>' : '<span class="badge badge-warning">Opted Out</span>';
          var smsConsent = c.promotionalSmsConsent !== false ? '<span class="badge badge-success">✓ Enabled</span>' : '<span class="badge badge-danger">Disabled</span>';
          var statusBadge = c.accountStatus === 'blocked' ? '<span class="badge badge-danger">Blocked</span>' : '<span class="badge badge-success">Active</span>';

          html += '<tr>' +
            '<td><span class="font-mono" style="font-weight:700;">' + custId + '</span></td>' +
