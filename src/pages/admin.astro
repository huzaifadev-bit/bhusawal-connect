      };

      document.getElementById('btn-save-image-replace').addEventListener('click', function() {
        var pId = document.getElementById('replace-image-prod-id').value;
        var newUrl = document.getElementById('replace-image-url-input').value.trim();
        if (!newUrl) return showToast('Enter a valid Image URL', 'error');

        if (!prodOverrides[pId]) prodOverrides[pId] = {};
        // Image URL updated without touching ID or Category
        prodOverrides[pId].image = newUrl;

