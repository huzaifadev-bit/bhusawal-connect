      // ==================== SETTINGS PERSISTENCE & SAVE ====================
      var SETTINGS_KEY = 'bhusawal_admin_settings';

      function loadAdminSettings() {
        try {
          var data = localStorage.getItem(SETTINGS_KEY);
          if (data) {
            var s = JSON.parse(data);
            if (s.baseFee) document.getElementById('setting-base-delivery-fee').value = s.baseFee;
            if (s.freeDeliveryMin) document.getElementById('setting-free-delivery-min').value = s.freeDeliveryMin;
            if (s.minOrderVal) document.getElementById('setting-min-order-val').value = s.minOrderVal;
            if (s.commission) document.getElementById('setting-platform-commission').value = s.commission;
            if (s.gstRate) document.getElementById('setting-gst-rate').value = s.gstRate;
            if (s.gstin) document.getElementById('setting-gstin-number').value = s.gstin;
            if (s.phone) document.getElementById('setting-support-phone').value = s.phone;
            if (s.whatsapp) document.getElementById('setting-support-whatsapp').value = s.whatsapp;
            if (s.email) document.getElementById('setting-support-email').value = s.email;
            if (s.status) document.getElementById('setting-platform-status').value = s.status;

            if (s.toggles) {
              document.getElementById('toggle-bike-taxi').checked = !!s.toggles.bikeTaxi;
              document.getElementById('toggle-auto-rickshaw').checked = !!s.toggles.autoRickshaw;
              document.getElementById('toggle-parcel-delivery').checked = !!s.toggles.parcel;
              document.getElementById('toggle-medicine-upload').checked = !!s.toggles.medicine;
              document.getElementById('toggle-cod-payment').checked = !!s.toggles.cod;
              document.getElementById('toggle-express-delivery').checked = !!s.toggles.express;
            }
          }
        } catch(e) {}
      }

      document.getElementById('btn-save-all-admin-settings').addEventListener('click', function() {
        var s = {
          baseFee: document.getElementById('setting-base-delivery-fee').value,
