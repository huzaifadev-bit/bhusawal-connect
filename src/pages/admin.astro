      // ==================== PRODUCT MANAGEMENT SYSTEM (8,000 PRODUCTS) ====================
      var catalogData = [];
      var prodOverrides = {};
      var prodCurrentPage = 1;
      var prodItemsPerPage = 15;

      try {
        prodOverrides = JSON.parse(localStorage.getItem('bhusawal_catalog_overrides') || '{}');
      } catch(e) {}

      // Load grocery catalog asynchronously
      function loadCatalog() {
        fetch('/grocery_catalog.json')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            catalogData = data;
            refreshProducts();
          })
          .catch(function(err) {
            console.error('Failed loading full catalog, generating fallback:', err);
            // Fallback 20 items if network fails
            var fallback = [];
            for (var i = 1; i <= 30; i++) {
              var id = 'BC-' + (100000 + i);
              fallback.push({
                id: id,
                name: 'Grocery Product Item #' + i,
                brand: 'Bhusawal Harvest',
                category: i % 2 === 0 ? 'Fresh Vegetables' : 'Dairy & Bread',
                pack: '500 g',
                mrp: 100 + i * 5,
                price: 80 + i * 4,
                stock: 100,
                status: 'in_stock',
                image: 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=200&h=200&fit=crop'
              });
            }
            catalogData = fallback;
            refreshProducts();
          });
      }

      function getEffectiveProduct(item) {
        var pId = item.id || item['Product ID'];
        var override = prodOverrides[pId] || {};
        return {
          id: pId,
          name: override.name || item.name || item['Product Name'],
          brand: override.brand || item.brand || item['Brand Name'] || 'Bhusawal Brand',
          category: item.category || item['Category'] || 'Grocery', // LOCKED
          pack: override.pack || item.pack || item['Pack Size'] || '1 unit',
          mrp: override.mrp !== undefined ? override.mrp : (item.mrp || item.MRP || 100),
          price: override.price !== undefined ? override.price : (item.price || item.sp || item.sellingPrice || 85),
          stockStatus: override.stockStatus || item.status || (item.stock > 0 ? 'in_stock' : 'out_of_stock'),
          stockQty: override.stockQty !== undefined ? override.stockQty : (item.stock || 100),
          hidden: !!override.hidden,
          image: override.image || item.image || item.img || item['Product Image URL'] || 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=200&h=200&fit=crop'
        };
      }

      function refreshProducts() {
        if (catalogData.length === 0) return;

        var searchQuery = (document.getElementById('product-search-input').value || '').toLowerCase().trim();
        var catFilter = document.getElementById('product-filter-category').value;
        var statusFilter = document.getElementById('product-filter-status').value;

        var filtered = catalogData.map(getEffectiveProduct).filter(function(p) {
          if (searchQuery) {
            var match = (p.name || '').toLowerCase().indexOf(searchQuery) >= 0 ||
                        (p.id || '').toLowerCase().indexOf(searchQuery) >= 0 ||
                        (p.brand || '').toLowerCase().indexOf(searchQuery) >= 0;
            if (!match) return false;
          }
          if (catFilter !== 'all' && (p.category || '').toLowerCase().indexOf(catFilter.toLowerCase()) < 0) {
            return false;
          }
          if (statusFilter !== 'all') {
            if (statusFilter === 'in_stock' && (p.stockStatus !== 'in_stock' || p.hidden)) return false;
            if (statusFilter === 'out_of_stock' && p.stockStatus !== 'out_of_stock') return false;
            if (statusFilter === 'hidden' && !p.hidden) return false;
          }
          return true;
        });

        var totalItems = filtered.length;
        var totalPages = Math.ceil(totalItems / prodItemsPerPage) || 1;
        if (prodCurrentPage > totalPages) prodCurrentPage = totalPages;
        if (prodCurrentPage < 1) prodCurrentPage = 1;

        var startIdx = (prodCurrentPage - 1) * prodItemsPerPage;
        var pageItems = filtered.slice(startIdx, startIdx + prodItemsPerPage);

        // Update pagination bar
        document.getElementById('product-pagination-info').textContent =
          'Showing ' + (totalItems === 0 ? 0 : startIdx + 1) + ' - ' + Math.min(startIdx + prodItemsPerPage, totalItems) + ' of ' + totalItems.toLocaleString() + ' products';
        document.getElementById('prod-current-page').textContent = 'Page ' + prodCurrentPage + ' of ' + totalPages;
        document.getElementById('btn-prod-prev-page').disabled = (prodCurrentPage <= 1);
        document.getElementById('btn-prod-next-page').disabled = (prodCurrentPage >= totalPages);

        var tbody = document.getElementById('products-table-body');
        if (pageItems.length === 0) {
          tbody.innerHTML = '<tr><td colspan="9"><div class="empty-state"><span class="material-symbols-outlined">inventory_2</span><p>No products match current filters</p></div></td></tr>';
          return;
        }

        var html = '';
        pageItems.forEach(function(p) {
          var stockBadge = p.hidden
            ? '<span class="badge badge-muted">🙈 Hidden</span>'
            : (p.stockStatus === 'in_stock' ? '<span class="badge badge-success">🟢 In Stock (' + p.stockQty + ')</span>' : '<span class="badge badge-danger">🔴 Out of Stock</span>');

          var visibilityBtn = p.hidden
            ? '<button class="btn btn-sm btn-outline" onclick="showProduct(\'' + p.id + '\')" title="Show Product"><span class="material-symbols-outlined" style="font-size:14px;">visibility</span> Show</button>'
            : '<button class="btn btn-sm btn-outline" onclick="hideProduct(\'' + p.id + '\')" title="Hide Product"><span class="material-symbols-outlined" style="font-size:14px;">visibility_off</span> Hide</button>';

          html += '<tr>' +
            '<td><img src="' + p.image + '" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid var(--admin-border);" onerror="this.src=\'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=100&h=100&fit=crop\'"/></td>' +
            '<td><span class="font-mono" style="font-weight:700;color:var(--admin-primary);">' + p.id + '</span></td>' +
            '<td><div><strong style="color:var(--admin-text-primary);">' + p.name + '</strong><br><small style="color:var(--admin-text-muted);">' + (p.brand || '') + ' • ' + (p.pack || '') + '</small></div></td>' +
            '<td><span class="badge badge-primary">' + p.category + '</span></td>' +
            '<td><span style="text-decoration:line-through;color:var(--admin-text-muted);">' + formatCurrency(p.mrp) + '</span></td>' +
            '<td><strong style="color:var(--admin-success);font-size:14px;">' + formatCurrency(p.price) + '</strong></td>' +
            '<td>' + stockBadge + '</td>' +
            '<td>' + (p.hidden ? 'Hidden' : 'Visible') + '</td>' +
            '<td><div style="display:flex;gap:4px;flex-wrap:wrap;">' +
              '<button class="btn btn-sm btn-outline" onclick="openEditProductModal(\'' + p.id + '\')" title="Edit Product"><span class="material-symbols-outlined" style="font-size:14px;">edit</span> Edit</button>' +
              '<button class="btn btn-sm btn-outline" onclick="openReplaceImageModal(\'' + p.id + '\')" title="Replace Image"><span class="material-symbols-outlined" style="font-size:14px;">image</span> Image</button>' +
              visibilityBtn +
            '</div></td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      // Pagination events
      document.getElementById('btn-prod-prev-page').addEventListener('click', function() {
        if (prodCurrentPage > 1) { prodCurrentPage--; refreshProducts(); }
      });
      document.getElementById('btn-prod-next-page').addEventListener('click', function() {
        prodCurrentPage++; refreshProducts();
      });
      document.getElementById('product-search-input').addEventListener('input', function() {
        prodCurrentPage = 1; refreshProducts();
      });
      document.getElementById('product-filter-category').addEventListener('change', function() {
        prodCurrentPage = 1; refreshProducts();
