      document.getElementById('product-filter-status').addEventListener('change', function() {
        prodCurrentPage = 1; refreshProducts();
      });

      // Product Edit Actions
      window.openEditProductModal = function(id) {
        var raw = catalogData.find(function(item) { return (item.id || item['Product ID']) === id; });
        if (!raw) return showToast('Product not found', 'error');
