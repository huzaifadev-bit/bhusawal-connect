        sessionStartTime = Date.now();
        lastActivityTime = Date.now();
        sessionWarned = false;
        document.getElementById('session-bar').style.display = 'flex';

        clearInterval(sessionTimerInterval);
        sessionTimerInterval = setInterval(function() {
          var now = Date.now();
          var elapsed = now - sessionStartTime;
          var idle = now - lastActivityTime;
          var remaining = SESSION_TIMEOUT_MS - idle;

          // Format elapsed
          var eMin = Math.floor(elapsed / 60000);
          var eSec = Math.floor((elapsed % 60000) / 1000);
          document.getElementById('session-elapsed').textContent = eMin + ':' + (eSec < 10 ? '0' : '') + eSec;

          // Format remaining
          if (remaining <= 0) {
            performLogout('Session expired due to inactivity');
            return;
          }
          var rMin = Math.floor(remaining / 60000);
          var rSec = Math.floor((remaining % 60000) / 1000);
          document.getElementById('session-remaining').textContent = rMin + ':' + (rSec < 10 ? '0' : '') + rSec;

          // Warn at 2 min
          if (remaining <= SESSION_WARNING_MS && !sessionWarned) {
            sessionWarned = true;
            showToast('Session expiring in 2 minutes — move mouse to stay logged in', 'timer');
          }
        }, 1000);
