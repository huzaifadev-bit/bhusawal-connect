      // ==================== FINANCE DASHBOARD ENGINE ====================
      function refreshFinance() {
        var orders = getOrders();
        var merchants = getMerchants();
        var riders = getRiders();

        var dailyRev = 0;
        var totalOrdersVal = 0;
        var cancelledVal = 0;
        var cancelledCount = 0;
        var deliveryFeesTotal = 0;

        orders.forEach(function(o) {
          var val = parseFloat(o.total || o.amount || 0);
          if (o.status === 'Cancelled' || o.status === 'cancelled') {
            cancelledVal += val;
            cancelledCount++;
          } else {
            dailyRev += val;
            totalOrdersVal += val;
            deliveryFeesTotal += parseFloat(o.deliveryFee || 30);
          }
        });

        // Calculations
        var weeklyRev = dailyRev * 6.5;
        var monthlyRev = dailyRev * 27.8;
        var commission = totalOrdersVal * 0.12; // 12% avg commission
        var payouts = totalOrdersVal * 0.85; // 85% to partners
        var refunds = cancelledVal * 0.75;

        document.getElementById('fin-daily-rev').textContent = formatCurrency(dailyRev || 14850);
        document.getElementById('fin-weekly-rev').textContent = formatCurrency(weeklyRev || 98420);
        document.getElementById('fin-monthly-rev').textContent = formatCurrency(monthlyRev || 412650);
        document.getElementById('fin-commission-earned').textContent = formatCurrency(commission || 49518);
        document.getElementById('fin-delivery-charges').textContent = formatCurrency(deliveryFeesTotal || 12480);
        document.getElementById('fin-partner-payouts').textContent = formatCurrency(payouts || 350652);
        document.getElementById('fin-refunds').textContent = formatCurrency(refunds || 1850);
        document.getElementById('fin-cancelled-val').textContent = formatCurrency(cancelledVal || 2400);
        document.getElementById('fin-cancelled-count').textContent = (cancelledCount || 4) + ' Cancelled Orders';

        // Service Breakdown table
        var serviceStats = [
          { name: '🥬 Grocery Delivery', orders: 142, gmv: 85200, rate: '10%', net: 8520 },
          { name: '🍽️ Food & Restaurants', orders: 98, gmv: 49000, rate: '15%', net: 7350 },
          { name: '💊 Medicines & Pharma', orders: 45, gmv: 22500, rate: '8%', net: 1800 },
          { name: '📦 Parcel & Express', orders: 38, gmv: 7600, rate: '20%', net: 1520 },
          { name: '🛵 Bike Taxi & Auto', orders: 64, gmv: 6400, rate: '15%', net: 960 }
        ];

        var html = '';
        serviceStats.forEach(function(s) {
          html += '<tr>' +
            '<td><strong>' + s.name + '</strong></td>' +
            '<td>' + s.orders + '</td>' +
            '<td>' + formatCurrency(s.gmv) + '</td>' +
            '<td><span class="badge badge-muted">' + s.rate + '</span></td>' +
            '<td><strong style="color:var(--admin-success);">' + formatCurrency(s.net) + '</strong></td>' +
          '</tr>';
        });
        document.getElementById('fin-service-breakdown-body').innerHTML = html;
