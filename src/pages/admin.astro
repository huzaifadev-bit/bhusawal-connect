        prodOverrides[pId].stockQty = parseInt(document.getElementById('edit-prod-stock-qty').value) || 0;

        localStorage.setItem('bhusawal_catalog_overrides', JSON.stringify(prodOverrides));
        showToast('Product #' + pId + ' updated ✓');
        closeAdminModal('edit-product-modal');
        refreshProducts();
