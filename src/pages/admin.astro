        } catch(e) {}
        
        // Default Seed Data of Bhusawal Businesses
        var seed = [
          { id: 'MERCH-01', name: 'Bhusawal Super Grocery Mart', owner: 'Ramesh Patil', phone: '+91 98230 11223', category: 'Grocery', status: 'active', orders: 248, rating: 4.8, commission: 10, address: 'Station Road, Bhusawal' },
          { id: 'MERCH-02', name: 'Khandesh Restaurant & Thali', owner: 'Suresh Chaudhari', phone: '+91 94222 33445', category: 'Restaurant', status: 'active', orders: 186, rating: 4.7, commission: 15, address: 'Jamner Road, Bhusawal' },
          { id: 'MERCH-03', name: 'Sanjeevani Medico & Pharma', owner: 'Dr. Vikas Mahajan', phone: '+91 98900 55667', category: 'Medical', status: 'active', orders: 112, rating: 4.9, commission: 8, address: 'Near Civil Hospital, Bhusawal' },
          { id: 'MERCH-04', name: 'Bhusawal Electronics & Mobiles', owner: 'Aniket Joshi', phone: '+91 97654 88990', category: 'Local Shop', status: 'active', orders: 64, rating: 4.6, commission: 12, address: 'Main Market, Bhusawal' },
          { id: 'MERCH-05', name: 'Shree Ganesh Sweet Home', owner: 'Ganesh Agrawal', phone: '+91 98221 77665', category: 'Restaurant', status: 'active', orders: 155, rating: 4.8, commission: 15, address: 'Station Square, Bhusawal' },
          { id: 'MERCH-06', name: 'Bhusawal Fresh Veggies Bazaar', owner: 'Nana Phadke', phone: '+91 94215 66778', category: 'Grocery', status: 'pending', orders: 0, rating: 0, commission: 10, address: 'Krishi Mandi, Bhusawal' }
        ];
        localStorage.setItem(MERCHANTS_KEY, JSON.stringify(seed));
        return seed;
