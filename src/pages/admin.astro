      function saveMerchants(list) {
        localStorage.setItem(MERCHANTS_KEY, JSON.stringify(list));
      }

      var currentMerchantCategoryTab = 'all';

      // Tab switcher
      document.querySelectorAll('#section-merchants .auth-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          document.querySelectorAll('#section-merchants .auth-tab').forEach(function(t) { t.classList.remove('active'); });
          this.classList.add('active');
          currentMerchantCategoryTab = this.getAttribute('data-merchant-tab');
          refreshMerchants();
        });
      });

      function refreshMerchants() {
        var merchants = getMerchants();
        var statusFilter = document.getElementById('merchant-filter-status').value;

        // Update tab count badges
        var countAll = merchants.length;
        var countGrocery = merchants.filter(function(m) { return m.category === 'Grocery'; }).length;
        var countRest = merchants.filter(function(m) { return m.category === 'Restaurant'; }).length;
        var countMed = merchants.filter(function(m) { return m.category === 'Medical'; }).length;
        var countShops = merchants.filter(function(m) { return m.category === 'Local Shop'; }).length;

        document.getElementById('merchant-count-all').textContent = countAll;
        document.getElementById('merchant-count-grocery').textContent = countGrocery;
        document.getElementById('merchant-count-restaurants').textContent = countRest;
        document.getElementById('merchant-count-medicines').textContent = countMed;
        document.getElementById('merchant-count-shops').textContent = countShops;

        // Filter merchants
        var filtered = merchants.filter(function(m) {
          // Category tab filter
          if (currentMerchantCategoryTab === 'grocery' && m.category !== 'Grocery') return false;
          if (currentMerchantCategoryTab === 'restaurants' && m.category !== 'Restaurant') return false;
          if (currentMerchantCategoryTab === 'medicines' && m.category !== 'Medical') return false;
          if (currentMerchantCategoryTab === 'shops' && m.category !== 'Local Shop') return false;

          // Status filter dropdown
          if (statusFilter !== 'all' && m.status !== statusFilter) return false;
          return true;
        });

        var tbody = document.getElementById('merchants-table-body');
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="9"><div class="empty-state"><span class="material-symbols-outlined">storefront</span><p>No partner businesses match selected filter</p></div></td></tr>';
          return;
        }

        var html = '';
        filtered.forEach(function(m) {
          var statusBadge = '';
          if (m.status === 'active') statusBadge = '<span class="badge badge-success">🟢 Active</span>';
          else if (m.status === 'pending') statusBadge = '<span class="badge badge-warning">⏳ Pending Approval</span>';
          else if (m.status === 'suspended') statusBadge = '<span class="badge badge-danger">🔴 Suspended</span>';
          else if (m.status === 'rejected') statusBadge = '<span class="badge badge-danger">❌ Rejected</span>';

          var categoryBadgeClass = 'badge-primary';
          if (m.category === 'Grocery') categoryBadgeClass = 'badge-success';
          else if (m.category === 'Restaurant') categoryBadgeClass = 'badge-warning';
          else if (m.category === 'Medical') categoryBadgeClass = 'badge-danger';

          var actionsHtml = '<div style="display:flex;gap:4px;flex-wrap:wrap;">';
          if (m.status === 'pending') {
            actionsHtml += '<button class="btn btn-sm btn-success" onclick="approveMerchant(\'' + m.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">check</span> Approve</button>';
            actionsHtml += '<button class="btn btn-sm btn-danger" onclick="rejectMerchant(\'' + m.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">close</span> Reject</button>';
          } else if (m.status === 'suspended' || m.status === 'rejected') {
            actionsHtml += '<button class="btn btn-sm btn-success" onclick="activateMerchant(\'' + m.id + '\')"><span class="material-symbols-outlined" style="font-size:14px;">refresh</span> Activate</button>';
          } else {
            actionsHtml += '<button class="btn btn-sm btn-danger" onclick="suspendMerchant(\'' + m.id + '\')" title="Suspend Shop"><span class="material-symbols-outlined" style="font-size:14px;">block</span></button>';
          }

          actionsHtml += '<button class="btn btn-sm btn-outline" onclick="openEditMerchantModal(\'' + m.id + '\')" title="Edit Shop Details"><span class="material-symbols-outlined" style="font-size:14px;">edit</span></button>';
          actionsHtml += '<button class="btn btn-sm btn-outline" onclick="openMerchantCatalogModal(\'' + m.id + '\')" title="View Catalog"><span class="material-symbols-outlined" style="font-size:14px;">inventory</span></button>';
          actionsHtml += '<button class="btn btn-sm btn-outline" onclick="viewMerchantOrders(\'' + m.name + '\')" title="View Shop Orders"><span class="material-symbols-outlined" style="font-size:14px;">receipt_long</span></button>';
          actionsHtml += '</div>';

          html += '<tr>' +
            '<td><div><strong style="color:var(--admin-text-primary);">' + m.name + '</strong><br><small style="color:var(--admin-text-muted);">' + (m.address || 'Bhusawal') + '</small></div></td>' +
            '<td>' + m.owner + '</td>' +
            '<td><a href="tel:' + m.phone.replace(/\s+/g,'') + '" style="color:var(--admin-primary);text-decoration:none;font-weight:600;">' + m.phone + '</a></td>' +
            '<td><span class="badge ' + categoryBadgeClass + '">' + m.category + '</span></td>' +
            '<td>' + statusBadge + '</td>' +
            '<td><strong>' + m.orders + '</strong></td>' +
            '<td>⭐ ' + (m.rating || '—') + '</td>' +
            '<td><span class="badge badge-muted">' + m.commission + '%</span></td>' +
            '<td>' + actionsHtml + '</td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      window.approveMerchant = function(id) {
        var list = getMerchants();
        var idx = list.findIndex(function(m) { return m.id === id; });
