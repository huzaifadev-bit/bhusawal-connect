      }

      function formatCurrency(val) {
        return '₹' + Number(val || 0).toLocaleString('en-IN');
      }

      function formatTime(dateStr) {
        if (!dateStr) return '—';
        try {
          var d = new Date(dateStr);
          return d.toLocaleString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true, day: 'numeric', month: 'short' });
        } catch(e) { return dateStr; }
      }

      function truncate(str, len) {
        if (!str) return '—';
        return str.length > len ? str.substring(0, len) + '…' : str;
      }

      function getStatusBadge(status) {
        var s = (status || '').toLowerCase().replace(/[\s_-]/g, '_');
        var map = {
          'placed': ['badge-primary', 'Placed'],
          'confirmed': ['badge-primary', 'Confirmed'],
          'preparing': ['badge-warning', 'Preparing'],
          'order_assigned': ['badge-primary', 'Assigned'],
          'partner_accepted': ['badge-primary', 'Accepted'],
          'navigate_to_pickup': ['badge-warning', 'To Pickup'],
          'reached_pickup': ['badge-warning', 'At Pickup'],
          'pickup_confirmed': ['badge-warning', 'Picked Up'],
          'navigate_to_customer': ['badge-warning', 'On The Way'],
          'on_the_way': ['badge-warning', 'On The Way'],
          'reached_destination': ['badge-primary', 'Arrived'],
          'otp_verification': ['badge-primary', 'OTP Check'],
          'delivered': ['badge-success', 'Delivered'],
          'payment_completed': ['badge-success', 'Completed'],
          'cancelled': ['badge-danger', 'Cancelled'],
          'ready_for_next': ['badge-success', 'Ready']
        };
        var m = map[s] || ['badge-muted', status || 'Unknown'];
        return '<span class="badge ' + m[0] + '">' + m[1] + '</span>';
      }

      function getServiceType(order) {
        if (order.serviceType) return order.serviceType;
        if (order.type) return order.type;
        if (order.items && order.items.length > 0) {
          var cat = (order.items[0].category || '').toLowerCase();
          if (cat.indexOf('food') >= 0 || cat.indexOf('restaurant') >= 0) return 'Food';
          if (cat.indexOf('medicine') >= 0 || cat.indexOf('pharma') >= 0) return 'Medicine';
          if (cat.indexOf('parcel') >= 0) return 'Parcel';
        }
        return 'Grocery';
      }

      function getServiceBadgeColor(type) {
        var t = (type || '').toLowerCase();
        if (t.indexOf('food') >= 0) return 'badge-warning';
        if (t.indexOf('medicine') >= 0) return 'badge-danger';
        if (t.indexOf('parcel') >= 0) return 'badge-primary';
        if (t.indexOf('ride') >= 0) return 'badge-muted';
        return 'badge-success';
      }

      // ==================== TOAST ====================
      var toastTimer = null;
      function showToast(msg, icon) {
        var el = document.getElementById('admin-toast');
        document.getElementById('toast-message').textContent = msg;
        document.getElementById('toast-icon').textContent = icon || 'check_circle';
        el.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function() { el.classList.remove('show'); }, 3000);
      }

      // ==================== AUTH ====================
      function checkAuth() {
        var auth = null;
        try { auth = JSON.parse(localStorage.getItem(AUTH_KEY)); } catch(e) {}
        if (auth && auth.loggedIn) {
          document.getElementById('admin-login-overlay').style.display = 'none';
          applyRBAC(auth.role);
          updateTopbar(auth);
          return true;
        }
        document.getElementById('admin-login-overlay').style.display = 'flex';
        stopSessionTimer();
        return false;
      }

      function updateTopbar(auth) {
        var name = auth.name || 'Admin';
        var roleKey = auth.role || 'super_admin';
        var roleLabel = ROLE_LABELS[roleKey] || roleKey;
        document.getElementById('topbar-display-name').textContent = name;
        document.getElementById('topbar-display-role').textContent = roleLabel;
        document.getElementById('topbar-avatar-initials').textContent = name.split(' ').map(function(w){return w.charAt(0);}).join('').substring(0,2).toUpperCase();
        document.getElementById('session-role-badge').textContent = roleLabel;
      }

      function applyRBAC(roleKey) {
        var permissions = ROLE_PERMISSIONS[roleKey] || ROLE_PERMISSIONS['support_executive'];
        var allSections = ['dashboard','orders','riders','products','merchants','customers','kyc','services','analytics','notifications','settings'];

        allSections.forEach(function(sectionId) {
          var navItem = document.querySelector('[data-section="' + sectionId + '"]');
          var sectionEl = document.getElementById('section-' + sectionId);

          if (permissions.indexOf(sectionId) >= 0) {
            // Permitted
            if (navItem) { navItem.style.display = 'flex'; navItem.style.opacity = '1'; navItem.style.pointerEvents = 'auto'; }
            if (sectionEl) { sectionEl.classList.remove('rbac-locked'); }
          } else {
            // Restricted
            if (navItem) { navItem.style.display = 'none'; }
            if (sectionEl) { sectionEl.classList.add('rbac-locked'); }
          }
        });
      }

      function completeLogin(email, roleKey, method) {
        var account = ADMIN_ACCOUNTS[email] || { name: 'Admin', role: roleKey };
        var authData = {
          loggedIn: true,
          email: email,
          name: account.name,
          role: roleKey,
          loginTime: new Date().toISOString(),
          loginMethod: method
        };

        // Remember login
        if (document.getElementById('remember-login') && document.getElementById('remember-login').checked) {
          authData.remember = true;
        }

        localStorage.setItem(AUTH_KEY, JSON.stringify(authData));
        document.getElementById('admin-login-overlay').style.display = 'none';
        document.getElementById('login-error').style.display = 'none';
        applyRBAC(roleKey);
        updateTopbar(authData);
        startSessionTimer();
        addNotification('login', 'Admin Login', account.name + ' logged in as ' + (ROLE_LABELS[roleKey] || roleKey) + ' via ' + method);
        refreshAll();
        showToast('Welcome, ' + account.name + ' (' + (ROLE_LABELS[roleKey] || roleKey) + ')');
      }

      // ==================== AUTH TABS ====================
      document.querySelectorAll('.auth-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          var targetTab = this.getAttribute('data-auth-tab');
          document.querySelectorAll('.auth-tab').forEach(function(t) { t.classList.remove('active'); });
          document.querySelectorAll('.auth-step').forEach(function(s) { s.classList.remove('active'); });
          this.classList.add('active');
          var targetStep = document.getElementById('auth-step-' + targetTab);
          if (targetStep) targetStep.classList.add('active');
          document.getElementById('login-error').style.display = 'none';
          document.getElementById('auth-success-msg').style.display = 'none';
        });
      });

      // ==================== PASSWORD LOGIN ====================
      document.getElementById('admin-login-form').addEventListener('submit', function(e) {
        e.preventDefault();
        var email = document.getElementById('admin-email').value.trim().toLowerCase();
        var pass = document.getElementById('admin-password').value;
        var selectedRole = document.getElementById('admin-role-select').value;

        var account = ADMIN_ACCOUNTS[email];
        if (account && account.password === pass) {
          // Validate role matches the account
          var roleToUse = account.role;
          // Allow super_admin to login as any role for testing
          if (account.role === 'super_admin' && selectedRole !== 'super_admin') {
            roleToUse = selectedRole;
          } else if (account.role !== selectedRole && account.role !== 'super_admin') {
            document.getElementById('login-error').textContent = 'This account does not have the "' + (ROLE_LABELS[selectedRole] || selectedRole) + '" role.';
            document.getElementById('login-error').style.display = 'block';
            return;
          }
          completeLogin(email, roleToUse, 'Password');
        } else {
          document.getElementById('login-error').textContent = 'Invalid email or password. Please try again.';
          document.getElementById('login-error').style.display = 'block';
        }
      });

      // ==================== OTP LOGIN ====================
      var pendingOTPPhone = '';
      var generatedOTP = '';

      document.getElementById('btn-send-otp').addEventListener('click', function() {
        var phone = document.getElementById('admin-otp-phone').value.replace(/\D/g, '');
        if (phone.length < 10) {
          document.getElementById('login-error').textContent = 'Enter a valid 10-digit mobile number.';
          document.getElementById('login-error').style.display = 'block';
          return;
        }
        // Take last 10 digits
        phone = phone.slice(-10);
        pendingOTPPhone = phone;
        generatedOTP = '123456'; // Demo OTP

        document.getElementById('otp-display-phone').textContent = '+91 ' + phone.substring(0,5) + ' ' + phone.substring(5);
        document.getElementById('otp-phone-step').style.display = 'none';
        document.getElementById('otp-verify-step').style.display = 'block';
        document.getElementById('login-error').style.display = 'none';

        // Focus first OTP input
        var firstOtp = document.querySelector('.otp-digit[data-idx="0"]');
        if (firstOtp) firstOtp.focus();

        showToast('OTP sent to +91 ' + phone, 'sms');
      });

      // OTP digit auto-advance
      document.querySelectorAll('.otp-digit').forEach(function(input) {
        input.addEventListener('input', function() {
          this.value = this.value.replace(/\D/g, '');
          if (this.value.length === 1) {
            var nextIdx = parseInt(this.getAttribute('data-idx')) + 1;
            var nextInput = document.querySelector('.otp-digit[data-idx="' + nextIdx + '"]');
            if (nextInput) nextInput.focus();
          }
        });
        input.addEventListener('keydown', function(e) {
          if (e.key === 'Backspace' && this.value === '') {
            var prevIdx = parseInt(this.getAttribute('data-idx')) - 1;
            var prevInput = document.querySelector('.otp-digit[data-idx="' + prevIdx + '"]');
            if (prevInput) { prevInput.focus(); prevInput.value = ''; }
          }
        });
      });

      document.getElementById('btn-verify-otp').addEventListener('click', function() {
        var enteredOTP = '';
        document.querySelectorAll('.otp-digit').forEach(function(d) { enteredOTP += d.value; });

        if (enteredOTP.length !== 6) {
          document.getElementById('login-error').textContent = 'Enter all 6 digits of the OTP.';
          document.getElementById('login-error').style.display = 'block';
          return;
        }

        if (enteredOTP === generatedOTP) {
          // Find account by phone
          var matchEmail = PHONE_TO_ACCOUNT[pendingOTPPhone];
          var selectedRole = document.getElementById('admin-otp-role-select').value;
          if (matchEmail) {
            var account = ADMIN_ACCOUNTS[matchEmail];
            var roleToUse = account.role;
            if (account.role === 'super_admin') roleToUse = selectedRole;
            completeLogin(matchEmail, roleToUse, 'OTP');
          } else {
            // Allow any phone with valid OTP as super_admin for demo
            completeLogin('admin@bhusawalconnect.com', selectedRole, 'OTP');
          }
        } else {
          document.getElementById('login-error').textContent = 'Invalid OTP. Please try again.';
          document.getElementById('login-error').style.display = 'block';
        }
      });

      document.getElementById('btn-resend-otp').addEventListener('click', function() {
        generatedOTP = '123456';
        showToast('OTP resent to +91 ' + pendingOTPPhone, 'sms');
        // Clear OTP fields
        document.querySelectorAll('.otp-digit').forEach(function(d) { d.value = ''; });
        document.querySelector('.otp-digit[data-idx="0"]').focus();
      });

      // ==================== FORGOT PASSWORD ====================
      document.getElementById('btn-forgot-password').addEventListener('click', function() {
        document.querySelectorAll('.auth-tab').forEach(function(t) { t.classList.remove('active'); });
        document.querySelectorAll('.auth-step').forEach(function(s) { s.classList.remove('active'); });
        document.getElementById('auth-step-forgot').classList.add('active');
        document.getElementById('login-error').style.display = 'none';
      });

      document.getElementById('btn-back-to-login').addEventListener('click', function() {
        document.querySelectorAll('.auth-step').forEach(function(s) { s.classList.remove('active'); });
        document.querySelectorAll('.auth-tab').forEach(function(t) { t.classList.remove('active'); });
        document.getElementById('auth-step-password').classList.add('active');
        document.querySelector('[data-auth-tab="password"]').classList.add('active');
        document.getElementById('auth-success-msg').style.display = 'none';
      });

      document.getElementById('btn-send-reset').addEventListener('click', function() {
        var email = document.getElementById('forgot-email').value.trim().toLowerCase();
        if (!email || email.indexOf('@') < 0) {
          document.getElementById('login-error').textContent = 'Enter a valid email address.';
          document.getElementById('login-error').style.display = 'block';
          return;
        }
        document.getElementById('login-error').style.display = 'none';
        document.getElementById('auth-success-msg').textContent = '✓ Password reset link sent to ' + email + '. Check your inbox.';
        document.getElementById('auth-success-msg').style.display = 'block';
        showToast('Reset link sent to ' + email, 'mail');
        addNotification('lock_reset', 'Password Reset', 'Reset link sent to ' + email);
      });

      // ==================== REMEMBER LOGIN (Auto-fill) ====================
      (function loadRemembered() {
        try {
          var auth = JSON.parse(localStorage.getItem(AUTH_KEY));
          if (auth && auth.remember && auth.email) {
            document.getElementById('admin-email').value = auth.email;
            document.getElementById('remember-login').checked = true;
          }
        } catch(e) {}
      })();

      // ==================== SIDEBAR NAVIGATION ====================
      var navItems = document.querySelectorAll('.sidebar-nav-item');
      navItems.forEach(function(item) {
        item.addEventListener('click', function() {
          var section = this.getAttribute('data-section');
          if (section) showSection(section);
        });
      });

      window.showSection = function(sectionId) {
        document.querySelectorAll('.admin-section').forEach(function(s) { s.classList.remove('active'); });
        document.querySelectorAll('.sidebar-nav-item').forEach(function(n) { n.classList.remove('active'); });
        var target = document.getElementById('section-' + sectionId);
        if (target) target.classList.add('active');
        var navTarget = document.querySelector('[data-section="' + sectionId + '"]');
        if (navTarget) navTarget.classList.add('active');

        // Close mobile sidebar
        document.getElementById('admin-sidebar').classList.remove('open');
        document.getElementById('sidebar-overlay').classList.remove('open');

        refreshAll();
      };

      // ==================== MOBILE SIDEBAR ====================
      document.getElementById('topbar-hamburger').addEventListener('click', function() {
        document.getElementById('admin-sidebar').classList.toggle('open');
        document.getElementById('sidebar-overlay').classList.toggle('open');
      });

      document.getElementById('sidebar-overlay').addEventListener('click', function() {
        document.getElementById('admin-sidebar').classList.remove('open');
        this.classList.remove('open');
      });

      // ==================== DASHBOARD REFRESH ====================
      function refreshDashboard() {
        var orders = getOrders();
        var riders = getRiders();

        // Stats
        document.getElementById('stat-total-orders').textContent = orders.length;

        var totalRev = 0;
        orders.forEach(function(o) { totalRev += parseFloat(o.total || o.amount || 0); });
        document.getElementById('stat-revenue').textContent = formatCurrency(totalRev);

        var onlineRiders = riders.filter(function(r) { return r.isOnline; });
        document.getElementById('stat-active-riders').textContent = onlineRiders.length;

        var pendingOrders = orders.filter(function(o) {
          var s = (o.status || '').toLowerCase().replace(/[\s_-]/g, '_');
          return s === 'placed' || s === 'confirmed' || s === 'order_assigned';
        });
        document.getElementById('stat-pending-orders').textContent = pendingOrders.length;

        document.getElementById('dash-last-updated').textContent =
          new Date().toLocaleString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });

        // Recent Orders (last 5)
        var recentBody = document.getElementById('dashboard-recent-orders');
        if (orders.length === 0) {
          recentBody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><span class="material-symbols-outlined">inbox</span><p>No orders yet. Orders placed on the customer app will appear here in real time.</p></div></td></tr>';
        } else {
          var sorted = orders.slice().sort(function(a, b) {
            return new Date(b.time || b.date || 0) - new Date(a.time || a.date || 0);
          });
          var html = '';
          sorted.slice(0, 5).forEach(function(o) {
            var svc = getServiceType(o);
            html += '<tr>' +
              '<td><span class="font-mono">' + (o.id || '—') + '</span></td>' +
              '<td>' + truncate(o.customerName || o.address || 'Customer', 20) + '</td>' +
              '<td><span class="badge ' + getServiceBadgeColor(svc) + '">' + svc + '</span></td>' +
              '<td>' + formatCurrency(o.total || o.amount) + '</td>' +
              '<td>' + getStatusBadge(o.status) + '</td>' +
              '<td style="font-size:12px;color:var(--admin-text-muted);">' + formatTime(o.time || o.date) + '</td>' +
            '</tr>';
          });
          recentBody.innerHTML = html;
        }

        // Fleet Status
        var fleetBody = document.getElementById('dashboard-fleet-status');
        if (riders.length === 0) {
          fleetBody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><span class="material-symbols-outlined">two_wheeler</span><p>No riders registered. Riders who sign up on the Delivery Partner app will appear here.</p></div></td></tr>';
        } else {
          var fleetHtml = '';
          riders.forEach(function(r) {
            var statusClass = r.isOnline ? ((r.activeOrders && r.activeOrders.length > 0) ? 'busy' : 'online') : 'offline';
            var statusLabel = r.isOnline ? ((r.activeOrders && r.activeOrders.length > 0) ? 'Busy' : 'Available') : 'Offline';
            var badgeClass = statusClass === 'online' ? 'badge-success' : (statusClass === 'busy' ? 'badge-warning' : 'badge-muted');

            fleetHtml += '<tr>' +
              '<td><div class="rider-info"><div class="rider-avatar">' + (r.name || 'R').charAt(0) + '</div><div><div class="rider-name">' + (r.name || 'Unknown') + '</div><div class="rider-sub">' + (r.phone || '') + '</div></div></div></td>' +
              '<td><span class="badge ' + badgeClass + '"><span class="status-dot ' + statusClass + '"></span>' + statusLabel + '</span></td>' +
              '<td>' + (r.bikeNo || '—') + '</td>' +
              '<td>' + (r.zone || '—') + '</td>' +
              '<td>' + ((r.activeOrders || []).length) + '</td>' +
              '<td>⭐ ' + (r.rating || '—') + '</td>' +
            '</tr>';
          });
          fleetBody.innerHTML = fleetHtml;
        }

        // Update nav badge
        document.getElementById('nav-badge-orders').textContent = orders.length;
      }

      // ==================== ORDERS SECTION & MODALS ====================
      window.closeAdminModal = function(modalId) {
        var el = document.getElementById(modalId);
        if (el) el.classList.remove('open');
      };

      function refreshOrders() {
        var orders = getOrders();
        var statusFilter = document.getElementById('order-filter-status').value;
        var serviceFilter = document.getElementById('order-filter-service').value;
        var typeFilter = document.getElementById('order-filter-type') ? document.getElementById('order-filter-type').value : 'all';
        var searchQuery = (document.getElementById('topbar-search-input') ? document.getElementById('topbar-search-input').value : '').toLowerCase().trim();

        var filtered = orders.filter(function(o) {
          if (typeFilter === 'simulation' && !o.isSimulation) return false;
          if (typeFilter === 'production' && o.isSimulation) return false;

          if (searchQuery) {
            var searchTarget = ((o.id || '') + ' ' + (o.customerName || '') + ' ' + (o.storeName || '') + ' ' + (o.riderName || '') + ' ' + (o.status || '')).toLowerCase();
            if (searchTarget.indexOf(searchQuery) < 0) return false;
          }
          if (statusFilter !== 'all') {
            var s = (o.status || '').toLowerCase().replace(/[\s_-]/g, '_');
            if (statusFilter === 'placed' && s !== 'placed') return false;
            if (statusFilter === 'confirmed' && s !== 'confirmed' && s !== 'order_assigned' && s !== 'partner_accepted') return false;
            if (statusFilter === 'preparing' && s !== 'preparing' && s !== 'navigate_to_pickup' && s !== 'reached_pickup' && s !== 'pickup_confirmed') return false;
            if (statusFilter === 'on_the_way' && s !== 'navigate_to_customer' && s !== 'on_the_way' && s !== 'reached_destination' && s !== 'otp_verification') return false;
            if (statusFilter === 'delivered' && s !== 'delivered' && s !== 'payment_completed') return false;
            if (statusFilter === 'cancelled' && s !== 'cancelled') return false;
          }
          if (serviceFilter !== 'all') {
            var svc = getServiceType(o).toLowerCase();
            if (serviceFilter === 'shops' && svc.indexOf('shop') < 0 && svc.indexOf('local') < 0) return false;
            else if (serviceFilter === 'ride' && svc.indexOf('ride') < 0 && svc.indexOf('auto') < 0 && svc.indexOf('drop') < 0) return false;
            else if (['shops','ride'].indexOf(serviceFilter) < 0 && svc.indexOf(serviceFilter) < 0) return false;
          }
          return true;
        });

        var tbody = document.getElementById('orders-table-body');
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="10"><div class="empty-state"><span class="material-symbols-outlined">inbox</span><p>No orders match the selected filters</p></div></td></tr>';
          return;
        }

        var sorted = filtered.slice().sort(function(a, b) {
          return new Date(b.time || b.date || 0) - new Date(a.time || a.date || 0);
        });

        var html = '';
        sorted.forEach(function(o) {
          var svc = getServiceType(o);
          var riderName = o.riderName || o.assignedRider;
          var riderCell = riderName
            ? '<span style="font-weight:600;font-size:12.5px;">' + truncate(riderName, 14) + '</span>'
            : '<span class="badge badge-warning" onclick="openAssignModal(\'' + (o.id || '') + '\')" style="cursor:pointer;">+ Assign Rider</span>';

          var eta = o.eta || (o.status === 'delivered' ? 'Delivered' : '15-25 mins');
          var storeName = o.storeName || o.pickupAddress || 'Bhusawal Hub';
          var custName = o.customerName || o.name || 'Customer';

          html += '<tr>' +
            '<td><span class="font-mono" style="font-weight:700;color:var(--admin-primary);cursor:pointer;" onclick="viewOrder(\'' + (o.id || '') + '\')">' + (o.id || '—') + '</span></td>' +
            '<td><div><div style="font-weight:600;">' + truncate(custName, 16) + '</div><div style="font-size:11px;color:var(--admin-text-muted);">' + (o.customerPhone || o.phone || '—') + '</div></div></td>' +
            '<td>' + truncate(storeName, 18) + '</td>' +
            '<td><span class="badge ' + getServiceBadgeColor(svc) + '">' + svc + '</span></td>' +
            '<td><strong style="color:var(--admin-text-primary);">' + formatCurrency(o.total || o.amount) + '</strong></td>' +
            '<td><span class="badge badge-muted">' + (o.paymentMethod || 'COD') + '</span></td>' +
            '<td>' + getStatusBadge(o.status) + '</td>' +
            '<td style="font-size:12px;font-weight:600;color:var(--admin-text-secondary);">' + eta + '</td>' +
            '<td>' + riderCell + '</td>' +
            '<td><div style="display:flex;gap:4px;">' +
              '<button class="btn btn-sm btn-outline" onclick="viewOrder(\'' + (o.id || '') + '\')" title="View Details"><span class="material-symbols-outlined" style="font-size:14px;">visibility</span></button>' +
              '<button class="btn btn-sm btn-outline" onclick="openAssignModal(\'' + (o.id || '') + '\')" title="Assign / Reassign Rider"><span class="material-symbols-outlined" style="font-size:14px;">person_add</span></button>' +
              '<button class="btn btn-sm btn-outline" onclick="openLiveTrackModal(\'' + (o.id || '') + '\')" title="Live Track"><span class="material-symbols-outlined" style="font-size:14px;">navigation</span></button>' +
              '<button class="btn btn-sm btn-outline" onclick="openContactModal(\'' + (o.id || '') + '\')" title="Contact Customer & Rider"><span class="material-symbols-outlined" style="font-size:14px;">call</span></button>' +
              '<button class="btn btn-sm btn-danger" onclick="cancelOrder(\'' + (o.id || '') + '\')" title="Cancel Order"><span class="material-symbols-outlined" style="font-size:14px;">close</span></button>' +
            '</div></td>' +
          '</tr>';
        });
        tbody.innerHTML = html;
      }

      // View Detailed Order Modal
      window.viewOrder = function(orderId) {
        var orders = getOrders();
        var order = orders.find(function(o) { return o.id === orderId; });
        if (!order) return showToast('Order not found', 'error');

        var svc = getServiceType(order);
        document.getElementById('modal-order-id').textContent = '#' + order.id;
        document.getElementById('modal-service-badge').innerHTML = '<span class="badge ' + getServiceBadgeColor(svc) + '">' + svc + '</span>';
        document.getElementById('modal-status-badge').innerHTML = getStatusBadge(order.status);
        document.getElementById('modal-order-time').textContent = 'Placed on ' + formatTime(order.time || order.date);

        // Timeline Step Highlight
        var s = (order.status || '').toLowerCase().replace(/[\s_-]/g, '_');
        var timelineSteps = document.querySelectorAll('#modal-order-timeline .timeline-step');
        timelineSteps.forEach(function(step) { step.classList.remove('completed', 'active'); });

        if (s === 'placed') {
          timelineSteps[0].classList.add('active');
        } else if (['confirmed','order_assigned','partner_accepted'].indexOf(s) >= 0) {
          timelineSteps[0].classList.add('completed');
          timelineSteps[1].classList.add('active');
        } else if (['preparing','navigate_to_pickup','reached_pickup','pickup_confirmed'].indexOf(s) >= 0) {
          timelineSteps[0].classList.add('completed');
          timelineSteps[1].classList.add('completed');
          timelineSteps[2].classList.add('active');
        } else if (['navigate_to_customer','on_the_way','reached_destination','otp_verification'].indexOf(s) >= 0) {
          timelineSteps[0].classList.add('completed');
          timelineSteps[1].classList.add('completed');
          timelineSteps[2].classList.add('completed');
          timelineSteps[3].classList.add('active');
        } else if (['delivered','payment_completed'].indexOf(s) >= 0) {
          timelineSteps.forEach(function(step) { step.classList.add('completed'); });
        }

        // Populate info boxes
        document.getElementById('modal-customer-name').textContent = order.customerName || order.name || 'Customer';
        document.getElementById('modal-customer-phone').textContent = order.customerPhone || order.phone || '+91 98765 43210';
        document.getElementById('modal-customer-address').textContent = order.address || order.deliveryAddress || 'Bhusawal City';

        document.getElementById('modal-store-name').textContent = order.storeName || (svc + ' Store');
        document.getElementById('modal-store-address').textContent = order.pickupAddress || 'Jamner Road, Bhusawal';

        document.getElementById('modal-rider-name').textContent = order.riderName || order.assignedRider || 'Unassigned';
        document.getElementById('modal-rider-phone').textContent = order.riderPhone || (order.riderName ? '+91 98765 00000' : 'Click assign to allocate rider');
        document.getElementById('modal-eta-text').textContent = 'ETA: ' + (order.eta || '15-25 mins');

        // Items list
        var itemsHtml = '';
        var items = order.items || [];
        if (items.length === 0) {
          itemsHtml = '<tr><td colspan="4" style="color:var(--admin-text-muted);text-align:center;">1 x ' + svc + ' Order Package</td></tr>';
        } else {
          items.forEach(function(it) {
            var itemTotal = (it.price || 0) * (it.qty || 1);
            itemsHtml += '<tr>' +
              '<td><strong>' + (it.name || 'Product Item') + '</strong></td>' +
              '<td>' + (it.qty || 1) + '</td>' +
              '<td>' + formatCurrency(it.price || 0) + '</td>' +
              '<td style="text-align:right;font-weight:600;">' + formatCurrency(itemTotal) + '</td>' +
            '</tr>';
          });
        }
        document.getElementById('modal-items-list').innerHTML = itemsHtml;
        document.getElementById('modal-payment-status').textContent = (order.paymentMethod || 'COD') + ' • ' + (order.paymentStatus || 'Pending');
        document.getElementById('modal-total-amount').textContent = formatCurrency(order.total || order.amount);

        // Bind modal buttons
        document.getElementById('modal-btn-contact-cust').onclick = function() { openContactModal(orderId); };
        document.getElementById('modal-btn-assign-rider').onclick = function() { openAssignModal(orderId); };
        document.getElementById('modal-btn-live-track').onclick = function() { openLiveTrackModal(orderId); };

        document.getElementById('order-details-modal').classList.add('open');
      };

      // Assign / Reassign Rider Modal
      window.openAssignModal = function(orderId) {
        var riders = getRiders();
        var orders = getOrders();
        var order = orders.find(function(o) { return o.id === orderId; });

        document.getElementById('assign-modal-order-id').textContent = '#' + orderId;
        var listEl = document.getElementById('assign-riders-list');

        if (riders.length === 0) {
          listEl.innerHTML = '<div class="empty-state"><span class="material-symbols-outlined">two_wheeler</span><p>No delivery partners registered in system</p></div>';
        } else {
          var html = '';
          riders.forEach(function(r) {
            var isAssignedThis = (order && (order.riderId === r.id || order.riderName === r.name));
            html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px;border:1px solid var(--admin-border);border-radius:10px;background:#F8FAFC;">' +
              '<div style="display:flex;align-items:center;gap:10px;">' +
                '<div class="rider-avatar">' + (r.name || 'R').charAt(0) + '</div>' +
                '<div>' +
                  '<div style="font-weight:700;font-size:13.5px;">' + (r.name || 'Rider') + ' ' + (isAssignedThis ? '<span class="badge badge-success">Assigned</span>' : '') + '</div>' +
                  '<div style="font-size:11.5px;color:var(--admin-text-muted);">' + (r.bikeNo || 'Bike/Scooter') + ' • ' + (r.phone || '') + '</div>' +
                '</div>' +
              '</div>' +
              '<button class="btn btn-sm ' + (isAssignedThis ? 'btn-outline' : 'btn-primary') + '" onclick="assignRiderToOrder(\'' + orderId + '\', \'' + (r.id || r.name) + '\', \'' + (r.name || 'Rider') + '\', \'' + (r.phone || '') + '\')">' +
                (isAssignedThis ? 'Reassign' : 'Assign') +
              '</button>' +
            '</div>';
          });
          listEl.innerHTML = html;
        }
        document.getElementById('assign-rider-modal').classList.add('open');
      };

      window.assignRiderToOrder = function(orderId, riderId, riderName, riderPhone) {
        var orders = getOrders();
        var idx = orders.findIndex(function(o) { return o.id === orderId; });
        if (idx >= 0) {
          orders[idx].riderId = riderId;
          orders[idx].riderName = riderName;
          orders[idx].assignedRider = riderName;
          orders[idx].riderPhone = riderPhone || '+91 98765 00000';
          if (orders[idx].status === 'placed' || orders[idx].status === 'confirmed') {
            orders[idx].status = 'order_assigned';
          }
          localStorage.setItem(ORDERS_KEY, JSON.stringify(orders));
          addNotification('two_wheeler', 'Rider Assigned', 'Order ' + orderId + ' assigned to rider ' + riderName);
          showToast('Assigned to ' + riderName, 'check_circle');
          closeAdminModal('assign-rider-modal');
          closeAdminModal('order-details-modal');
          refreshAll();
        }
      };

