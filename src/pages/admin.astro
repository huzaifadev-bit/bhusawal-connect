      // Strict Image Replacement (NO ID OR CATEGORY MUTATION)
      window.openReplaceImageModal = function(id) {
        var raw = catalogData.find(function(item) { return (item.id || item['Product ID']) === id; });
        if (!raw) return showToast('Product not found', 'error');
