  <script is:inline>
    let cart = JSON.parse(localStorage.getItem('bhusawal_cart_medicine') || '{}');
    let cartCount = 0;
    let cartTotal = 0;

    const cartBar = document.querySelector('.fixed.bottom-24');
    const cartTextCount = cartBar.querySelector('p.font-bold');
    const cartTextDetails = cartBar.querySelector('p.text-white\\/80');

    function updateCartBar() {
      localStorage.setItem('bhusawal_cart_medicine', JSON.stringify(cart));
      cartCount = Object.values(cart).reduce((sum, item) => sum + item.qty, 0);
      cartTotal = Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
      if (cartCount > 0) {
        cartBar.classList.remove('hidden');
        cartTextCount.textContent = cartCount + ' Item' + (cartCount > 1 ? 's' : '');
        cartTextDetails.textContent = `₹${cartTotal} • Pharmacy Delivery`;
      } else {
        cartBar.classList.add('hidden');
      }
    }

    function replaceWithStepper(btn, title, price, themeColor = '#10b981', imgUrl = '', packSize = '', category = '') {
      const btnClass = btn.className;
      const stepper = document.createElement('div');
      // Relative positioning parent is the right column flex container
      stepper.className = 'flex items-center rounded-lg shadow-sm overflow-hidden z-10';
      stepper.style.backgroundColor = themeColor;
      stepper.innerHTML = `
        <button class="qty-minus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">−</button>
        <span class="qty-value w-6 h-7 flex items-center justify-center text-white text-[11px] font-extrabold">1</span>
        <button class="qty-plus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">+</button>
      `;
      btn.replaceWith(stepper);

      if (!cart[title]) {
        cart[title] = { price, qty: 1, themeColor, btnClass, imgUrl, packSize, category };
      }
      updateCartBar();

      const qtyDisplay = stepper.querySelector('.qty-value');
      qtyDisplay.textContent = cart[title].qty;

      stepper.querySelector('.qty-plus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty++;
        qtyDisplay.textContent = cart[title].qty;
        updateCartBar();
      });

      stepper.querySelector('.qty-minus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty--;
        if (cart[title].qty <= 0) {
          delete cart[title];
          const addBtn = document.createElement('button');
          addBtn.className = btnClass;
          addBtn.textContent = 'Add';
          stepper.replaceWith(addBtn);
          bindAddButton(addBtn);
        } else {
          qtyDisplay.textContent = cart[title].qty;
        }
        updateCartBar();
      });
    }

    function bindAddButton(btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.bg-white');
        const title = card.querySelector('h3').textContent.trim();
        const priceText = card.querySelector('.font-bold.text-on-surface').textContent.trim();
        const price = parseInt(priceText.replace(/[^\d]/g, ''));
        
        const packEl = card.querySelector('p.text-xs.text-on-surface-variant');
        const packSize = packEl ? packEl.textContent.trim() : '1 Unit';

        replaceWithStepper(btn, title, price, '#10b981', '', packSize, 'Medicines');
      });
    }

    function syncUIWithCart() {
      document.querySelectorAll('.bg-white').forEach(card => {
        const titleEl = card.querySelector('h3');
        if (!titleEl) return;
        const title = titleEl.textContent.trim();
        if (cart[title]) {
          const btn = Array.from(card.querySelectorAll('button')).find(b => b.textContent.trim() === 'Add' || b.textContent.trim() === 'Added');
          if (btn) {
            const priceText = card.querySelector('.font-bold.text-on-surface').textContent.trim();
            const price = parseInt(priceText.replace(/[^\d]/g, ''));
            const packEl = card.querySelector('p.text-xs.text-on-surface-variant');
            const packSize = packEl ? packEl.textContent.trim() : '1 Unit';

            replaceWithStepper(btn, title, price, '#10b981', '', packSize, 'Medicines');
          }
        }
      });
      updateCartBar();
    }

    // Bind and sync initial cart state
    document.querySelectorAll('button').forEach(btn => {
      if (btn.textContent.trim() === 'Add') {
        bindAddButton(btn);
      }
    });
    syncUIWithCart();

    cartBar.addEventListener('click', () => {
      if (cartCount > 0) {
        window.location.href = '/billing?type=medicine';
      }
    });
  </script>

  <Switcher />
