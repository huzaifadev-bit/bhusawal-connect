      .rx-store-fields { display: grid; grid-template-columns: 1fr; gap: 0.65rem; }
      @media(min-width:640px) { .rx-store-fields { grid-template-columns: 1fr 1fr; } }
      .rx-store-section .rx-input { background: #FFFFFF; }
      .rx-store-helper {
        display: flex; align-items: flex-start; gap: 0.4rem;
        font-size: 0.65rem; font-weight: 500; color: #94A3B8;
        line-height: 1.55; padding-top: 0.15rem;
      }
      .rx-store-helper svg { flex-shrink: 0; margin-top: 0.1rem; color: #CBD5E1; }

      /* INFO BADGE */
      .rx-info-badge {
