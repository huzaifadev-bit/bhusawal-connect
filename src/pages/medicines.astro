  { id: 'med_103', name: 'Volini Pain Relief Spray (100g)', price: 215, mrp: 245, image: 'https://images.unsplash.com/photo-1607613009820-a29f7bb81c04?auto=format&fit=crop&w=800&q=80', category: 'Popular Medicines', rating: '4.9', rxRequired: false, pack: '100g Can' },
  { id: 'med_104', name: 'Electral ORS Powder (21.8g Sachet)', price: 22, mrp: 22, image: 'https://images.unsplash.com/photo-1585435557343-3b092031a831?auto=format&fit=crop&w=800&q=80', category: 'Popular Medicines', rating: '4.9', rxRequired: false, pack: '1 Sachet' },
  { id: 'med_105', name: 'Combiflam Pain Relief Tablet (Strip of 20)', price: 45, mrp: 48, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Popular Medicines', rating: '4.8', rxRequired: false, pack: '20 Tablets' },
  { id: 'med_106', name: 'Vicks Vaporub Relief Balm (50g)', price: 145, mrp: 160, image: 'https://images.unsplash.com/photo-1576602976047-174e57a47881?auto=format&fit=crop&w=800&q=80', category: 'Popular Medicines', rating: '4.9', rxRequired: false, pack: '50g Jar' }
];

// 8. Health & Wellness
const healthWellnessItems = [
  { id: 'med_201', name: 'Revital H Daily Multivitamin (60 Capsules)', price: 495, mrp: 550, image: 'https://images.unsplash.com/photo-1550572017-edf79289989a?auto=format&fit=crop&w=800&q=80', category: 'Health & Wellness', rating: '4.9', rxRequired: false, pack: '60 Capsules' },
  { id: 'med_202', name: 'Shelcal 500 Calcium & D3 (Strip of 15)', price: 118, mrp: 131, image: 'https://images.unsplash.com/photo-1584017911766-d451b3d0e843?auto=format&fit=crop&w=800&q=80', category: 'Health & Wellness', rating: '4.8', rxRequired: false, pack: '15 Tablets' },
  { id: 'med_203', name: 'Becosules Z Multivitamin Capsules (20s)', price: 48, mrp: 52, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Health & Wellness', rating: '4.9', rxRequired: false, pack: '20 Capsules' },
  { id: 'med_204', name: 'Limcee 500mg Vitamin C Chewable (15s)', price: 24, mrp: 26, image: 'https://images.unsplash.com/photo-1584017911766-d451b3d0e843?auto=format&fit=crop&w=800&q=80', category: 'Health & Wellness', rating: '4.8', rxRequired: false, pack: '15 Tablets' },
  { id: 'med_205', name: 'Dabur Chyawanprash Special 1kg Jar', price: 345, mrp: 395, image: 'https://images.unsplash.com/photo-1631549916768-4119b2e5f926?auto=format&fit=crop&w=800&q=80', category: 'Health & Wellness', rating: '4.9', rxRequired: false, pack: '1kg Jar' }
];

// 9. Personal Care
const personalCareItems = [
  { id: 'med_301', name: 'Dettol Antiseptic Liquid (500ml)', price: 212, mrp: 235, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.9', rxRequired: false, pack: '500ml Bottle' },
  { id: 'med_302', name: 'Savlon Antiseptic Cream (60g)', price: 72, mrp: 80, image: 'https://images.unsplash.com/photo-1576602976047-174e57a47881?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.8', rxRequired: false, pack: '60g Tube' },
  { id: 'med_303', name: 'Sensodyne Rapid Relief Toothpaste (100g)', price: 210, mrp: 230, image: 'https://images.unsplash.com/photo-1559598467-f8b76c8155d0?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.9', rxRequired: false, pack: '100g Tube' },
  { id: 'med_304', name: 'Nivea Soft Light Moisturizing Cream (200ml)', price: 299, mrp: 340, image: 'https://images.unsplash.com/photo-1608248597379-e07543926b11?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.9', rxRequired: false, pack: '200ml Tub' }
];

// 10. Baby Care
const babyCareItems = [
  { id: 'med_401', name: 'Pampers All-Round Protection Diapers (M, 48s)', price: 799, mrp: 899, image: 'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80', category: 'Baby Care', rating: '4.9', rxRequired: false, pack: '48 Diapers' },
  { id: 'med_402', name: 'Himalaya Gentle Baby Wipes (72 Wipes)', price: 175, mrp: 195, image: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=800&q=80', category: 'Baby Care', rating: '4.8', rxRequired: false, pack: '72 Pack' },
  { id: 'med_403', name: "Johnson's Baby Powder (400g)", price: 285, mrp: 310, image: 'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80', category: 'Baby Care', rating: '4.9', rxRequired: false, pack: '400g Pack' },
  { id: 'med_404', name: 'Nestle Cerelac Wheat Apple Baby Cereal (300g)', price: 260, mrp: 275, image: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=800&q=80', category: 'Baby Care', rating: '4.9', rxRequired: false, pack: '300g Box' }
];

// 11. Medical Devices
const medicalDevicesItems = [
  { id: 'med_501', name: 'Omron HEM-7120 Fully Automatic BP Monitor', price: 1990, mrp: 2480, image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.9', rxRequired: false, pack: '1 Unit' },
  { id: 'med_502', name: 'Dr. Morepen BG-03 Blood Glucose Monitor (50 Strips)', price: 799, mrp: 1099, image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.8', rxRequired: false, pack: '1 Kit + 50 Strips' },
  { id: 'med_503', name: 'Dr. Trust Infrared Digital Thermometer', price: 1199, mrp: 1599, image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.9', rxRequired: false, pack: '1 Unit' },
  { id: 'med_504', name: 'HealthSense Facial Steamer & Vaporizer', price: 499, mrp: 799, image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.7', rxRequired: false, pack: '1 Device' }
];
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Medicines & Pharmacy Express Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- CLEAN LIGHT BLUE (#3B82F6) & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="pb-32 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== 1. DELIVERY ADDRESS TOP BAR ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="medicine-address-btn">
        <div class="w-9 h-9 rounded-full bg-blueLight text-blueBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-blueBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-blueBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="medicine-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button & Global Cart Button -->
    <div class="flex items-center gap-2">
      <a href="/upload_prescription" class="hidden sm:flex items-center gap-1 px-3 py-1.5 rounded-full bg-blueLight text-blueBrand text-xs font-black border border-blue-200 hover:bg-blueBrand hover:text-white transition-all shadow-xs">
        <span class="material-symbols-outlined text-sm">upload_file</span>
        <span>Upload Rx</span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-blueBrand text-white flex items-center justify-center font-bold hover:bg-blueDark transition-colors shadow-md group">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="med-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-7">

    <!-- ==================== 2. SEARCH MEDICINES ==================== -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2 space-y-2.5 relative" id="med-search-box">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-blueBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input 
          type="text" 
          id="med-search-input" 
          placeholder="Search 1,000+ medicines, BP monitors, diapers & health supplements..." 
          class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" 
          autocomplete="off" 
        />
        <button id="clear-med-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- ==================== 3. HEALTH CATEGORY CHIPS ==================== -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-xs font-black">
      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-blueBrand text-white border border-blueBrand shadow-sm shrink-0 active:scale-95">
        💊 All Medicines
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🔥 Popular
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🩺 Medical Devices
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        👶 Baby Care
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🧴 Personal Care
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🌱 Ayush & Herbal
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        💪 Vitamins & Supplements
      </button>
    </div>

    <!-- ==================== 4. SPONSORED MEDICAL STORES (HORIZONTAL CAROUSEL) ==================== -->
    <section class="space-y-3 pt-1 border-b border-slate-100 pb-5">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
          <span class="text-blueBrand">🏥</span>
          <span>Sponsored Medical Stores</span>
        </h2>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Scroll →</span>
      </div>

      <div class="flex items-center gap-4 overflow-x-auto no-scrollbar py-1.5 px-0.5">
        {sponsoredMedicalStores.map(store => (
          <div 
            class="w-64 sm:w-72 shrink-0 bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-lg hover:border-blueBrand transition-all cursor-pointer overflow-hidden flex flex-col justify-between group"
            onclick={`window.location.href='/shops?id=${store.id}';`}
          >
            <div class="h-28 sm:h-32 bg-slate-100 relative overflow-hidden">
              <img src={store.cover} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <span class="absolute top-2 left-2 px-2.5 py-0.5 bg-white/95 backdrop-blur-md text-blueBrand text-[9px] font-black rounded-full uppercase tracking-wider shadow-xs border border-slate-200">
                ✓ Verified Pharmacy
              </span>

              <span class="absolute bottom-2 right-2 px-2.5 py-0.5 bg-blueBrand text-white text-[9px] font-black rounded-full shadow-xs">
                ⚡ {store.deliveryTime}
              </span>
            </div>

            <div class="p-3.5 space-y-1">
              <h3 class="text-xs font-black font-display text-slate-900 group-hover:text-blueBrand transition-colors truncate">
                {store.name}
              </h3>
              <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">{store.discount}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== 5. UPLOAD DOCTOR PRESCRIPTION BANNER ==================== -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden border border-blue-400/30">
      <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1.5 max-w-lg">
          <span class="bg-white/20 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">⚡ 10 Min Rx Processing</span>
          <h2 class="text-xl sm:text-2xl font-black font-display leading-tight">Have a Doctor's Prescription?</h2>
          <p class="text-xs text-blue-100 font-medium">Upload photo of your prescription & our licensed Bhusawal pharmacist will fulfill & deliver medicines to your doorstep.</p>
        </div>

        <a 
          href="/upload_prescription" 
          class="px-6 py-3 bg-white text-blueBrand hover:bg-blue-50 font-black text-xs rounded-2xl shadow-lg active:scale-95 transition-all shrink-0 flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-lg">cloud_upload</span>
          <span>Upload Doctor Prescription</span>
        </a>
      </div>
    </section>

    <!-- ==================== 6. SHOP BY CATEGORY ==================== -->
    <section class="space-y-3.5 pt-2">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 flex items-center gap-2">
          <span>🏷️ Shop by Category</span>
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {shopCategories.map(cat => (
          <div 
            class={`p-4 rounded-3xl border flex flex-col items-center justify-center text-center gap-2 cursor-pointer hover:shadow-lg transition-all ${cat.color} group`}
            onclick={`window.location.href='/medicine_search?cat=${encodeURIComponent(cat.name)}';`}
          >
            <span class="text-3xl group-hover:scale-110 transition-transform">{cat.icon}</span>
            <span class="text-xs font-black">{cat.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== 7. POPULAR MEDICINES ==================== -->
    <section class="space-y-3.5 pt-2" id="sec-popular-medicines">
      <div class="flex items-end justify-between px-1">
        <div>
          <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span>💊 Popular Medicines</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top-selling OTC & daily health medicines ({popularMedicines.length} items)</p>
        </div>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider shrink-0">Scroll →</span>
      </div>

      <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2 px-0.5">
        {popularMedicines.map(item => (
          <div 
            class="med-card w-52 sm:w-60 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-blue-200 transition-all cursor-pointer group"
            data-id={item.id}
            data-name={item.name}
            data-price={item.price}
            data-img={item.image}
            onclick={`window.location.href='/medicine_details?id=${item.id}';`}
          >
            <div>
              <div class="w-full aspect-square bg-slate-50 rounded-2xl p-2.5 mb-3 flex items-center justify-center border border-slate-100 overflow-hidden relative">
                <span class="absolute top-2 left-2 bg-blueLight text-blueBrand text-[9px] font-black px-2 py-0.5 rounded-full border border-blue-200 uppercase">
                  {item.pack}
                </span>

                <img src={item.image} alt={item.name} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
              </div>

              <span class="text-[10px] font-extrabold text-blueBrand uppercase tracking-wider block mb-0.5 truncate">
                {item.category}
              </span>
              <h3 class="text-xs sm:text-sm font-black font-display text-slate-900 line-clamp-2 leading-snug min-h-[2.4rem]">
                {item.name}
              </h3>
            </div>

            <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 mt-3">
