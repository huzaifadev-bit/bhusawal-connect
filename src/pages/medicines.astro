      .rx-preview-name { font-size: 0.75rem; font-weight: 800; color: #1E293B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rx-preview-status { font-size: 0.65rem; font-weight: 700; color: #16A34A; margin-top: 0.1rem; }
      .rx-change-btn {
        padding: 0.4rem 0.85rem; background: #F1F5F9; color: #64748B;
        font-size: 0.7rem; font-weight: 800; border-radius: 0.65rem;
        border: none; cursor: pointer; transition: all 0.15s; flex-shrink: 0;
