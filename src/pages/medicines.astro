      @media(min-width:640px) { .rx-form-row { grid-template-columns: 1fr 1fr; } }

      .rx-field { display: flex; flex-direction: column; gap: 0.3rem; }
      .rx-label { font-size: 0.7rem; font-weight: 800; color: #475569; }
      .rx-required { color: #EF4444; font-weight: 900; }
      .rx-optional-tag {
        display: inline-block; padding: 0.1rem 0.45rem;
