  { id: 'med_1702', name: 'Digene Acidity & Gas Relief Gel', brand: 'Abbott', price: 95, mrp: 110, image: 'https://images.unsplash.com/photo-1584017911766-d451b3d0e843?auto=format&fit=crop&w=800&q=80', category: 'Digestive Care', rating: '4.8', rxRequired: false, pack: '200ml Bottle' },
  { id: 'med_1703', name: 'Pan D Capsule', brand: 'Alkem', price: 125, mrp: 142, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Digestive Care', rating: '4.8', rxRequired: true, pack: '15 Capsules' },
  // Medical Devices
  { id: 'med_1801', name: 'Omron HEM-7120 BP Monitor', brand: 'Omron', price: 1990, mrp: 2480, image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.9', rxRequired: false, pack: '1 Unit' },
  { id: 'med_1802', name: 'Dr. Morepen Blood Glucose Monitor', brand: 'Dr. Morepen', price: 799, mrp: 1099, image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.8', rxRequired: false, pack: '1 Kit + 50 Strips' },
  { id: 'med_1803', name: 'Dr. Trust Infrared Thermometer', brand: 'Dr. Trust', price: 1199, mrp: 1599, image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80', category: 'Medical Devices', rating: '4.9', rxRequired: false, pack: '1 Unit' },
  // Personal Care
  { id: 'med_1901', name: 'Dettol Antiseptic Liquid', brand: 'Reckitt', price: 212, mrp: 235, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.9', rxRequired: false, pack: '500ml Bottle' },
  { id: 'med_1902', name: 'Savlon Antiseptic Cream', brand: 'ITC', price: 72, mrp: 80, image: 'https://images.unsplash.com/photo-1576602976047-174e57a47881?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.8', rxRequired: false, pack: '60g Tube' },
  { id: 'med_1903', name: 'Band-Aid Flexible Fabric Strips', brand: 'J&J', price: 95, mrp: 110, image: 'https://images.unsplash.com/photo-1585435557343-3b092031a831?auto=format&fit=crop&w=800&q=80', category: 'Personal Care', rating: '4.7', rxRequired: false, pack: '100 Strips' },
  // Covid Essentials
  { id: 'med_2001', name: 'N95 Face Mask (Pack of 10)', brand: 'Venus', price: 250, mrp: 350, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', category: 'Covid Essentials', rating: '4.8', rxRequired: false, pack: '10 Masks' },
  { id: 'med_2002', name: 'Lifebuoy Hand Sanitizer', brand: 'HUL', price: 125, mrp: 150, image: 'https://images.unsplash.com/photo-1585435557343-3b092031a831?auto=format&fit=crop&w=800&q=80', category: 'Covid Essentials', rating: '4.7', rxRequired: false, pack: '500ml Pump' },
  { id: 'med_2003', name: 'Digital Pulse Oximeter', brand: 'Dr. Trust', price: 999, mrp: 1399, image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80', category: 'Covid Essentials', rating: '4.9', rxRequired: false, pack: '1 Device' }
];

---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Medicines & Pharmacy Express Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- CLEAN LIGHT BLUE (#3B82F6) & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="pb-32 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== 1. DELIVERY ADDRESS TOP BAR ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="medicine-address-btn">
        <div class="w-9 h-9 rounded-full bg-blueLight text-blueBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-blueBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-blueBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="medicine-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button & Global Cart Button -->
    <div class="flex items-center gap-2">
      <a href="#section-prescription-upload" class="hidden sm:flex items-center gap-1 px-3 py-1.5 rounded-full bg-blueLight text-blueBrand text-xs font-black border border-blue-200 hover:bg-blueBrand hover:text-white transition-all shadow-xs">
        <span class="material-symbols-outlined text-sm">upload_file</span>
        <span>Upload Rx</span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-blueBrand text-white flex items-center justify-center font-bold hover:bg-blueDark transition-colors shadow-md group">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="med-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-7">

    <!-- ==================== 2. SEARCH MEDICINES ==================== -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2 space-y-2.5 relative" id="med-search-box">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-blueBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input 
          type="text" 
          id="med-search-input" 
          placeholder="Search 1,000+ medicines, BP monitors, diapers & health supplements..." 
          class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" 
          autocomplete="off" 
        />
        <button id="clear-med-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- ==================== 3. HEALTH CATEGORY CHIPS ==================== -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-xs font-black">
      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-blueBrand text-white border border-blueBrand shadow-sm shrink-0 active:scale-95">
        💊 All Medicines
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🔥 Popular
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🩺 Medical Devices
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        👶 Baby Care
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🧴 Personal Care
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        🌱 Ayush & Herbal
      </button>

      <button class="med-chip-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-blueLight hover:text-blueBrand border border-slate-200/80 transition-all shrink-0 active:scale-95">
        💪 Vitamins & Supplements
      </button>
    </div>

    <!-- ==================== 4. FEATURED MEDICAL STORES (SINGLE HORIZONTAL SCROLLING CAROUSEL) ==================== -->
    <section class="space-y-3.5 pt-1 border-b border-slate-100 pb-6">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-base sm:text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span class="text-blueBrand">🏥</span>
            <span>Featured Medical Stores</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Verified partner pharmacies in Bhusawal with express delivery</p>
        </div>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider shrink-0">Scroll →</span>
      </div>

      <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-1.5 px-0.5">
        {featuredMedicalStores.map(store => (
          <div 
            class="w-72 sm:w-80 shrink-0 bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-xl hover:border-blueBrand transition-all cursor-pointer overflow-hidden flex flex-col justify-between group relative"
            onclick={`window.location.href='/shops?id=${store.id}';`}
          >
            <!-- STORE IMAGE HEADER -->
            <div class="h-32 sm:h-36 bg-slate-100 relative overflow-hidden">
              <img src={store.cover} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
              
              <!-- VERIFIED PARTNER BADGE -->
              <div class="absolute top-2.5 left-2.5 flex items-center gap-1 px-2.5 py-1 bg-white/95 backdrop-blur-md text-blueBrand text-[9px] font-black rounded-full shadow-xs border border-blue-100">
                <span class="material-symbols-outlined text-[11px] text-blueBrand font-black">verified</span>
                <span>Verified Partner</span>
              </div>

              <!-- OPEN / CLOSED BADGE -->
              <div class="absolute top-2.5 right-2.5 px-2.5 py-1 bg-emerald-500/90 backdrop-blur-md text-white text-[9px] font-black rounded-full shadow-xs flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                <span>{store.timing}</span>
              </div>

              <!-- STORE LOGO AVATAR OVERLAY -->
              <div class="absolute -bottom-3 left-4 w-12 h-12 rounded-2xl bg-white border-2 border-white p-1 shadow-md overflow-hidden shrink-0">
                <img src={store.logo} alt={store.name} class="w-full h-full object-cover rounded-xl" />
              </div>

              <!-- ETA BADGE -->
              <span class="absolute bottom-2.5 right-2.5 px-2.5 py-0.5 bg-blueBrand text-white text-[9px] font-black rounded-full shadow-xs">
                ⚡ {store.deliveryTime}
              </span>
            </div>

            <!-- CARD BODY -->
            <div class="pt-5 p-4 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-sm font-black font-display text-slate-900 group-hover:text-blueBrand transition-colors line-clamp-1">
                  {store.name}
                </h3>
              </div>

              <div class="flex items-center justify-between text-xs font-bold text-slate-500 pt-1 border-t border-slate-100/80">
                <!-- RATING -->
                <div class="flex items-center gap-1 text-slate-800">
                  <span class="text-amber-500 font-black">★ {store.rating}</span>
                  <span class="text-[10px] text-slate-400 font-medium">({store.ratingsCount})</span>
                </div>

                <!-- DISTANCE -->
                <div class="flex items-center gap-1 text-slate-600 text-[11px] font-extrabold">
                  <span class="material-symbols-outlined text-xs text-blueBrand">near_me</span>
                  <span>{store.distance} away</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== 5. PREMIUM DOCTOR PRESCRIPTION UPLOAD SECTION ==================== -->
    <section class="rx-premium-section" id="section-prescription-upload">
      
      <!-- PREMIUM HEADER -->
      <div class="rx-premium-header">
        <div class="rx-header-left">
          <div class="rx-badge-row">
            <span class="rx-processing-badge">
              <span class="rx-pulse-dot"></span>
              ⚡ Pharmacist Online
            </span>
            <span class="rx-secure-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              100% Secure
            </span>
          </div>
          <h2 class="rx-title">
            <span class="rx-title-icon">📋</span>
            Doctor Prescription Upload
          </h2>
          <p class="rx-subtitle">Upload your doctor's prescription and our licensed pharmacist will prepare & deliver your medicines.</p>
        </div>
      </div>

      <!-- 3 UPLOAD ACTION CARDS -->
      <div class="rx-upload-grid">
        
        <!-- UPLOAD PRESCRIPTION IMAGE -->
        <label class="rx-upload-card">
          <input type="file" accept="image/*" class="hidden rx-file-trigger" data-type="image" />
          <div class="rx-upload-icon-wrap rx-icon-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <span class="rx-upload-label">Upload Image</span>
          <span class="rx-upload-hint">JPG, PNG, WEBP</span>
        </label>

        <!-- TAKE PHOTO USING CAMERA -->
        <label class="rx-upload-card">
          <input type="file" accept="image/*" capture="environment" class="hidden rx-file-trigger" data-type="camera" />
          <div class="rx-upload-icon-wrap rx-icon-indigo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </div>
          <span class="rx-upload-label">Take Photo</span>
          <span class="rx-upload-hint">Open Camera</span>
        </label>

        <!-- UPLOAD PDF -->
        <label class="rx-upload-card">
          <input type="file" accept="application/pdf" class="hidden rx-file-trigger" data-type="pdf" />
          <div class="rx-upload-icon-wrap rx-icon-rose">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <span class="rx-upload-label">Upload PDF</span>
          <span class="rx-upload-hint">PDF Document</span>
        </label>

      </div>

      <!-- FILE UPLOAD PREVIEW -->
      <div id="rx-upload-preview-box" class="rx-preview-box hidden">
        <div class="rx-preview-left">
          <div class="rx-preview-icon" id="rx-file-icon-box">✅</div>
          <div class="rx-preview-info">
            <h4 class="rx-preview-name" id="rx-file-name">prescription.pdf</h4>
            <p class="rx-preview-status">Prescription attached successfully</p>
          </div>
        </div>
        <button type="button" id="rx-clear-file-btn" class="rx-change-btn">Change</button>
      </div>

      <!-- MEDICINE REQUEST FORM (shown after upload) -->
      <div id="rx-order-form-container" class="rx-form-container">
        
        <!-- FORM HEADER -->
        <div class="rx-form-header">
          <h3 class="rx-form-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Patient & Delivery Details
          </h3>
        </div>

        <!-- ROW 1: Patient Name + Mobile -->
        <div class="rx-form-row">
          <div class="rx-field">
            <label class="rx-label">Patient Name <span class="rx-required">*</span></label>
            <input type="text" id="rx-input-patient-name" placeholder="Full name as on prescription" class="rx-input" />
          </div>
          <div class="rx-field">
            <label class="rx-label">Mobile Number <span class="rx-required">*</span></label>
            <input type="tel" id="rx-input-mobile" placeholder="10-digit mobile number" class="rx-input" />
          </div>
        </div>

        <!-- ROW 2: Delivery Address -->
        <div class="rx-field">
          <label class="rx-label">Delivery Address <span class="rx-required">*</span></label>
          <input type="text" id="rx-input-address" placeholder="House / Flat / Building, Street, Area" class="rx-input" />
        </div>

        <!-- ROW 3: Landmark -->
        <div class="rx-field">
          <label class="rx-label">Landmark <span class="rx-optional-tag">Optional</span></label>
          <input type="text" id="rx-input-landmark" placeholder="Near hospital, temple, school, etc." class="rx-input" />
        </div>

        <!-- ROW 4: Special Instructions -->
        <div class="rx-field">
          <label class="rx-label">Special Instructions <span class="rx-optional-tag">Optional</span></label>
          <textarea id="rx-input-notes" rows="2" placeholder="e.g. Please send generic brands, 1-month supply, call before dispatch..." class="rx-input rx-textarea"></textarea>
        </div>

        <!-- PREFERRED MEDICAL STORE (OPTIONAL) -->
        <div class="rx-store-section">
          <div class="rx-store-section-header">
            <h4 class="rx-store-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Preferred Medical Store
              <span class="rx-optional-tag">Optional</span>
            </h4>
          </div>

          <div class="rx-store-fields">
            <div class="rx-field">
              <input type="text" id="rx-store-name-input" placeholder="Enter Medical Store Name (Optional)" class="rx-input" />
            </div>
            <div class="rx-field">
              <input type="text" id="rx-store-area-input" placeholder="Medical Store Area / Location" class="rx-input" />
            </div>
          </div>

          <p class="rx-store-helper">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            If you have a preferred medical store, enter its name and area. Otherwise leave it blank and Bhusawal Connect will arrange medicines from the nearest verified partner pharmacy.
          </p>
        </div>

        <!-- INFO BADGE -->
        <div class="rx-info-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          You don't need to type medicine names. Our licensed pharmacist will read your uploaded prescription.
        </div>

        <!-- SUBMIT BUTTON -->
        <button type="button" id="btn-submit-prescription-order" class="rx-submit-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Submit Prescription Order
        </button>

      </div>

    </section>

    <!-- PRESCRIPTION SECTION STYLES -->
    <style>
      .rx-premium-section {
        background: linear-gradient(135deg, #EFF6FF 0%, #FFFFFF 40%, #F0F7FF 100%);
        border-radius: 1.5rem;
        padding: 1.5rem;
        border: 1.5px solid rgba(59,130,246,0.15);
        box-shadow: 0 4px 24px rgba(59,130,246,0.06), 0 1px 3px rgba(0,0,0,0.04);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      @media(min-width:640px) { .rx-premium-section { padding: 2rem; gap: 1.5rem; } }

      /* HEADER */
      .rx-premium-header { display: flex; flex-direction: column; gap: 0.5rem; }
      .rx-badge-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .rx-processing-badge {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.3rem 0.75rem; border-radius: 99px;
        background: #3B82F6; color: #fff;
        font-size: 0.65rem; font-weight: 800; letter-spacing: 0.03em;
      }
      .rx-pulse-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #86EFAC; display: inline-block;
        animation: rxPulse 1.5s ease-in-out infinite;
      }
      @keyframes rxPulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.4; transform:scale(1.5); } }
      .rx-secure-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.3rem 0.65rem; border-radius: 99px;
        background: #F0FDF4; color: #16A34A; border: 1px solid #BBF7D0;
        font-size: 0.65rem; font-weight: 800;
      }
      .rx-title {
        font-size: 1.25rem; font-weight: 900; color: #0F172A;
        display: flex; align-items: center; gap: 0.4rem;
        letter-spacing: -0.025em; margin-top: 0.25rem;
        font-family: 'Inter', 'SF Pro Display', system-ui, sans-serif;
      }
      @media(min-width:640px) { .rx-title { font-size: 1.5rem; } }
      .rx-title-icon { font-size: 1.3rem; }
      .rx-subtitle { font-size: 0.75rem; color: #64748B; font-weight: 500; margin-top: 0.15rem; line-height: 1.5; }

      /* UPLOAD GRID */
      .rx-upload-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
      }
      .rx-upload-card {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 1.25rem 0.75rem;
        background: #FFFFFF;
        border-radius: 1rem;
        border: 1.5px solid #E2E8F0;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .rx-upload-card::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(59,130,246,0.04), transparent);
        opacity: 0; transition: opacity 0.2s;
      }
      .rx-upload-card:hover::before { opacity: 1; }
      .rx-upload-card:hover { border-color: #3B82F6; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59,130,246,0.1); }
      .rx-upload-card:active { transform: scale(0.97); }

      .rx-upload-icon-wrap {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 0.6rem;
      }
      .rx-icon-blue { background: #EFF6FF; color: #3B82F6; }
      .rx-icon-indigo { background: #EEF2FF; color: #6366F1; }
      .rx-icon-rose { background: #FFF1F2; color: #F43F5E; }

      .rx-upload-label { font-size: 0.7rem; font-weight: 800; color: #1E293B; letter-spacing: -0.01em; }
      .rx-upload-hint { font-size: 0.6rem; font-weight: 600; color: #94A3B8; margin-top: 0.15rem; }
      @media(min-width:640px) {
        .rx-upload-card { padding: 1.75rem 1rem; }
        .rx-upload-icon-wrap { width: 56px; height: 56px; border-radius: 16px; }
        .rx-upload-label { font-size: 0.8rem; }
        .rx-upload-hint { font-size: 0.65rem; }
      }

      /* PREVIEW BOX */
      .rx-preview-box {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        background: #FFFFFF; padding: 1rem 1.25rem;
        border-radius: 1rem; border: 1.5px solid #86EFAC;
        box-shadow: 0 2px 8px rgba(34,197,94,0.08);
      }
      .rx-preview-box.hidden { display: none; }
      .rx-preview-left { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
      .rx-preview-icon {
        width: 42px; height: 42px; border-radius: 12px;
        background: #F0FDF4; display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
      }
