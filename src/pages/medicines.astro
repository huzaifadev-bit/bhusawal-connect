<script is:inline>
  (function() {
    const cachedAddr = localStorage.getItem('bhusawal_user_address') || 'Home - Varangaon Rd, Bhusawal';
    const cachedLat = localStorage.getItem('bhusawal_user_lat');
    const cachedLng = localStorage.getItem('bhusawal_user_lng');
    
    document.addEventListener('DOMContentLoaded', () => {
      const addrEl = document.getElementById('header-address');
      if (addrEl) {
        // Shorten the address to make it look clean (max 30 chars) and append "..." if longer
        let shortAddr = cachedAddr;
        if (shortAddr.length > 30) {
          shortAddr = shortAddr.substring(0, 27) + '...';
        }
        addrEl.textContent = shortAddr;
      }
      
      const etaEl = document.getElementById('header-eta');
      if (etaEl) {
        if (cachedLat && cachedLng) {
          const lat1 = parseFloat(cachedLat);
          const lng1 = parseFloat(cachedLng);
          const lat2 = 21.0478;
          const lng2 = 75.7896;
          const R = 6371;
          const dLat = (lat2 - lat1) * Math.PI / 180;
          const dLon = (lng2 - lng1) * Math.PI / 180;
          const a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
          const dist = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
          const minutes = Math.max(7, Math.round(dist * 2.5 + 4));
          etaEl.textContent = minutes + ' minutes';
        } else {
          etaEl.textContent = '10 minutes';
        }
      }
    });
  })();
</script>

