  </main>

  <Switcher />

  <!-- DYNAMIC CLIENT SCRIPT -->
  <script is:inline>
    (function() {
      // ========== 1. PRESCRIPTION FILE UPLOAD ==========
      var fileTriggers = document.querySelectorAll('.rx-file-trigger');
      var previewBox = document.getElementById('rx-upload-preview-box');
      var fileNameEl = document.getElementById('rx-file-name');
      var clearFileBtn = document.getElementById('rx-clear-file-btn');
      var uploadedFileName = '';

      fileTriggers.forEach(function(input) {
        input.addEventListener('change', function(e) {
          if (e.target.files && e.target.files[0]) {
            var file = e.target.files[0];
            uploadedFileName = file.name;
            if (fileNameEl) fileNameEl.textContent = file.name;
            if (previewBox) previewBox.classList.remove('hidden');
          }
        });
      });

      if (clearFileBtn) {
        clearFileBtn.addEventListener('click', function() {
          uploadedFileName = '';
          if (previewBox) previewBox.classList.add('hidden');
        });
      }

      // ========== 2. PRESCRIPTION SUBMIT ==========
      var submitBtn = document.getElementById('btn-submit-prescription-order');
      if (submitBtn) {
        submitBtn.addEventListener('click', function() {
          var patientName = (document.getElementById('rx-input-patient-name') || {}).value || '';
          var mobile = (document.getElementById('rx-input-mobile') || {}).value || '';
          var address = (document.getElementById('rx-input-address') || {}).value || '';
          var landmark = (document.getElementById('rx-input-landmark') || {}).value || '';
          var notes = (document.getElementById('rx-input-notes') || {}).value || '';
          var storeNameVal = (document.getElementById('rx-store-name-input') || {}).value || '';
          var storeAreaVal = (document.getElementById('rx-store-area-input') || {}).value || '';

          var storeName = storeNameVal.trim() ? storeNameVal.trim() : 'Nearest Partner Pharmacy';
          var storeArea = storeAreaVal.trim() ? storeAreaVal.trim() : 'Bhusawal Local Area';
          var storeChoice = storeNameVal.trim() ? 'PREFERRED' : 'NEAREST';

          if (!patientName.trim()) { alert('Please enter Patient Name'); return; }
          if (!mobile.trim()) { alert('Please enter Mobile Number'); return; }
          if (!address.trim()) { alert('Please enter Delivery Address'); return; }

          var orderId = 'RX-BHU-' + Math.floor(100000 + Math.random() * 900000);
          var rxOrder = {
            id: orderId, type: 'PRESCRIPTION', patientName: patientName, mobile: mobile,
            address: address, landmark: landmark, notes: notes, storeChoice: storeChoice,
            storeName: storeName, storeArea: storeArea,
            fileName: uploadedFileName || 'Prescription_Attached.pdf',
            total: 0, status: 'Accepted', timestamp: new Date().toISOString()
          };

          try {
            localStorage.setItem('bhusawal_active_order', JSON.stringify(rxOrder));
            var orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            orders.unshift(rxOrder);
            localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
          } catch(e) {}

          alert('Prescription order submitted successfully! Redirecting to live tracking...');
          window.location.href = '/track_order';
        });
      }

      // ========== 3. CATEGORY CHIP FILTERING ==========
      var chips = document.querySelectorAll('.med-cat-chip');
      var allCards = document.querySelectorAll('#med-product-grid .med-card');
      var gridTitle = document.getElementById('med-grid-title');
      var gridSubtitle = document.getElementById('med-grid-subtitle');

      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var cat = chip.getAttribute('data-category');

          // Update active chip styling
          chips.forEach(function(c) {
            c.classList.remove('active', 'bg-blueBrand', 'text-white', 'border-transparent');
            c.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200/80');
          });
          chip.classList.add('active', 'bg-blueBrand', 'text-white', 'border-transparent');
          chip.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200/80');

          // Filter cards
          var visibleCount = 0;
          allCards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          // Update title
          if (gridTitle) gridTitle.textContent = cat === 'all' ? 'All Medicines' : cat;
          if (gridSubtitle) gridSubtitle.textContent = 'Showing ' + visibleCount + ' products';
        });
      });

      // ========== 4. CART FUNCTIONS ==========
      
      // GLOBAL MED CART FUNCTIONS EXPOSED TO WINDOW FOR Direct 100% RELIABLE CLICK HANDLERS
      window.getGlobalCart = function() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); }
        catch(e) { return []; }
      };

      window.saveGlobalCart = function(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        if (typeof updateAllCartUI === 'function') updateAllCartUI();
      };

      window.goToMedDetails = function(event, id) {
        if (event.target.closest('.btn-add-med') || event.target.closest('.med-qty-selector') || event.target.closest('.med-fav-btn')) {
          return;
        }
        window.location.href = '/medicine_details?id=' + id;
      };

      window.addMedToCart = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;

        var id = card.getAttribute('data-id');
        var name = card.getAttribute('data-name');
        var price = parseFloat(card.getAttribute('data-price')) || 0;
        var mrp = parseFloat(card.getAttribute('data-mrp')) || price;
        var img = card.getAttribute('data-img');
        var brand = card.getAttribute('data-brand') || '';
        var rxRequired = card.getAttribute('data-rx') === 'true';

        var cart = window.getGlobalCart();
        var existing = cart.find(function(c) { return c.id === id; });
        if (existing) {
          existing.quantity = (existing.quantity || 1) + 1;
        } else {
          cart.push({
            id: id,
            name: name,
            price: price,
            mrp: mrp,
            image: img,
            quantity: 1,
            restaurant: brand || 'Bhusawal Express Pharmacy',
            cat: 'Medicines',
            rxRequired: rxRequired
          });
        }
        window.saveGlobalCart(cart);
      };

      window.medQtyPlus = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;
        var id = card.getAttribute('data-id');
        var cart = window.getGlobalCart();
        var item = cart.find(function(c) { return c.id === id; });
        if (item) {
          item.quantity = (item.quantity || 1) + 1;
          window.saveGlobalCart(cart);
        }
      };

      window.medQtyMinus = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;
        var id = card.getAttribute('data-id');
        var cart = window.getGlobalCart();
        var idx = cart.findIndex(function(c) { return c.id === id; });
        if (idx > -1) {
          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            cart.splice(idx, 1);
          }
          window.saveGlobalCart(cart);
        }
      };

      window.toggleMedFav = function(btn, event) {
        if (event) event.stopPropagation();
        btn.classList.toggle('text-rose-500');
        btn.classList.toggle('border-rose-200');
        btn.classList.toggle('text-slate-400');
        btn.classList.toggle('border-slate-200');
      };

      function getGlobalCart() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); }
        catch(e) { return []; }
      }

      function saveGlobalCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateAllCartUI();
      }

      function updateAllCartUI() {
        var cart = getGlobalCart();
        var totalCount = cart.reduce(function(sum, item) { return sum + (item.quantity || 1); }, 0);
        var totalPrice = cart.reduce(function(sum, item) { return sum + (parseFloat(item.price || 0) * (item.quantity || 1)); }, 0);

        var badge = document.getElementById('med-cart-badge');
        if (badge) badge.textContent = totalCount;

        var floatBar = document.getElementById('med-floating-cart-bar');
        var floatCount = document.getElementById('med-float-count');
        var floatTotal = document.getElementById('med-float-total');

        if (floatBar) {
          if (totalCount > 0) {
            floatBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
            if (floatCount) floatCount.textContent = totalCount + (totalCount === 1 ? ' ITEM' : ' ITEMS');
            if (floatTotal) floatTotal.textContent = '\u20B9' + Math.round(totalPrice);
          } else {
            floatBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          }
        }

        // Sync qty selectors with cart state
        allCards.forEach(function(card) {
          var cid = card.getAttribute('data-id');
          var cartItem = cart.find(function(c) { return c.id === cid; });
          var addBtn = card.querySelector('.btn-add-med');
          var qtySel = card.querySelector('.med-qty-selector');
          var qtyCount = card.querySelector('.med-qty-count');

          if (cartItem && cartItem.quantity > 0) {
            if (addBtn) addBtn.classList.add('hidden');
            if (qtySel) qtySel.classList.remove('hidden');
            if (qtyCount) qtyCount.textContent = cartItem.quantity;
          } else {
            if (addBtn) addBtn.classList.remove('hidden');
            if (qtySel) qtySel.classList.add('hidden');
          }
        });
      }

      // ========== 5. ADD TO CART ==========
      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.btn-add-med');
        if (addBtn) {
          e.stopPropagation();
          var card = addBtn.closest('.med-card');
          if (!card) return;

          var id = card.getAttribute('data-id');
          var name = card.getAttribute('data-name');
          var price = parseFloat(card.getAttribute('data-price')) || 0;
          var mrp = parseFloat(card.getAttribute('data-mrp')) || price;
          var img = card.getAttribute('data-img');
          var brand = card.getAttribute('data-brand') || '';

          var cart = getGlobalCart();
          var existing = cart.find(function(c) { return c.id === id; });
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({
              id: id, name: name, price: price, mrp: mrp, image: img,
              quantity: 1, restaurant: brand || 'Bhusawal Express Pharmacy', cat: 'Medicines'
            });
          }
          saveGlobalCart(cart);
        }
      });

      // ========== 6. QUANTITY PLUS / MINUS ==========
      document.addEventListener('click', function(e) {
        var plusBtn = e.target.closest('.med-qty-plus');
        var minusBtn = e.target.closest('.med-qty-minus');

        if (plusBtn) {
          e.stopPropagation();
          var card = plusBtn.closest('.med-card');
          if (!card) return;
          var id = card.getAttribute('data-id');
          var cart = getGlobalCart();
          var item = cart.find(function(c) { return c.id === id; });
          if (item) { item.quantity = (item.quantity || 1) + 1; saveGlobalCart(cart); }
        }

        if (minusBtn) {
          e.stopPropagation();
          var card = minusBtn.closest('.med-card');
          if (!card) return;
          var id = card.getAttribute('data-id');
          var cart = getGlobalCart();
          var idx = cart.findIndex(function(c) { return c.id === id; });
          if (idx > -1) {
            if (cart[idx].quantity > 1) {
              cart[idx].quantity -= 1;
            } else {
              cart.splice(idx, 1);
            }
            saveGlobalCart(cart);
          }
        }
      });

      // ========== 7. FAVOURITE BUTTON ==========
      document.addEventListener('click', function(e) {
        var favBtn = e.target.closest('.med-fav-btn');
        if (favBtn) {
          e.stopPropagation();
          var card = favBtn.closest('.med-card');
          if (!card) return;
          var id = card.getAttribute('data-id');
          var name = card.getAttribute('data-name');

          var isFav = favBtn.classList.contains('med-fav-active');
          if (isFav) {
            favBtn.classList.remove('med-fav-active', 'text-rose-500', 'border-rose-200');
            favBtn.classList.add('text-slate-400', 'border-slate-200');
            favBtn.querySelector('svg').setAttribute('fill', 'none');
          } else {
            favBtn.classList.add('med-fav-active', 'text-rose-500', 'border-rose-200');
            favBtn.classList.remove('text-slate-400', 'border-slate-200');
            favBtn.querySelector('svg').setAttribute('fill', 'currentColor');
          }

          // Save to wishlist
          try {
            var wishlist = JSON.parse(localStorage.getItem('bhusawal_wishlist') || '[]');
            if (isFav) {
              wishlist = wishlist.filter(function(w) { return w.id !== id; });
            } else {
              if (!wishlist.find(function(w) { return w.id === id; })) {
                wishlist.push({ id: id, name: name });
              }
            }
            localStorage.setItem('bhusawal_wishlist', JSON.stringify(wishlist));
          } catch(ex) {}
        }
      });

      // ========== 8. SEARCH ==========
      var searchInput = document.getElementById('med-search-input');
      if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            window.location.href = '/medicine_search?q=' + encodeURIComponent(searchInput.value.trim());
          }
        });
      }

      // Init
      updateAllCartUI();
    })();
  </script>

</body>
</html>
