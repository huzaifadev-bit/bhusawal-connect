          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">BP monitors, glucometers, thermometers & steamers ({medicalDevicesItems.length} items)</p>
        </div>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider shrink-0">Scroll →</span>
      </div>

      <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2 px-0.5">
        {medicalDevicesItems.map(item => (
          <div 
            class="med-card w-52 sm:w-60 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-blue-200 transition-all cursor-pointer group"
            data-id={item.id}
            data-name={item.name}
            data-price={item.price}
            data-img={item.image}
            onclick={`window.location.href='/medicine_details?id=${item.id}';`}
          >
            <div>
              <div class="w-full aspect-square bg-slate-50 rounded-2xl p-2.5 mb-3 flex items-center justify-center border border-slate-100 overflow-hidden relative">
                <span class="absolute top-2 left-2 bg-blueLight text-blueBrand text-[9px] font-black px-2 py-0.5 rounded-full border border-blue-200 uppercase">
                  {item.pack}
                </span>

                <img src={item.image} alt={item.name} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
              </div>

              <span class="text-[10px] font-extrabold text-blueBrand uppercase tracking-wider block mb-0.5 truncate">
                {item.category}
              </span>
              <h3 class="text-xs sm:text-sm font-black font-display text-slate-900 line-clamp-2 leading-snug min-h-[2.4rem]">
                {item.name}
              </h3>
            </div>

            <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 mt-3">
              <div>
                <span class="text-[9px] text-slate-400 line-through font-bold">MRP ₹{item.mrp}</span>
                <span class="text-sm sm:text-base font-black font-display text-slate-900 block">₹{item.price}</span>
              </div>

              <button 
                class="btn-add-med px-3.5 py-1.5 bg-blueLight text-blueBrand hover:bg-blueBrand hover:text-white border border-blue-200 text-xs font-black rounded-xl active:scale-90 transition-all shadow-xs"
                onclick="event.stopPropagation();"
              >
                + ADD
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== 12. CONTINUE SHOPPING FLOATING BAR ==================== -->
    <div id="med-floating-cart-bar" class="fixed bottom-4 left-4 right-4 max-w-xl mx-auto bg-slate-900 text-white rounded-2xl p-3.5 shadow-2xl z-50 flex items-center justify-between transition-all transform translate-y-32 opacity-0 pointer-events-none border border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blueBrand text-white flex items-center justify-center font-black shadow-md">
          <span class="material-symbols-outlined text-xl">shopping_bag</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span id="med-float-count" class="text-xs font-black bg-white/20 px-2 py-0.5 rounded-md">0 ITEMS</span>
            <span class="text-xs text-slate-400 font-bold">•</span>
            <span id="med-float-total" class="text-sm font-black text-white">₹0</span>
          </div>
          <p class="text-[10px] text-slate-400 font-semibold mt-0.5">10 Min Express Pharmacy Delivery</p>
        </div>
      </div>

      <a href="/cart" class="px-5 py-2.5 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl active:scale-95 transition-all shadow-md flex items-center gap-1">
        <span>Continue to Cart</span>
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

  </main>

  <Switcher />

  <!-- DYNAMIC CLIENT SCRIPT FOR PRESCRIPTION UPLOAD & STORE TOGGLE -->
  <script is:inline>
    (function() {
      // 1. File Upload Logic
      var fileTriggers = document.querySelectorAll('.rx-file-trigger');
      var previewBox = document.getElementById('rx-upload-preview-box');
      var fileNameEl = document.getElementById('rx-file-name');
      var clearFileBtn = document.getElementById('rx-clear-file-btn');
      var uploadedFileName = '';

      fileTriggers.forEach(function(input) {
        input.addEventListener('change', function(e) {
          if (e.target.files && e.target.files[0]) {
            var file = e.target.files[0];
            uploadedFileName = file.name;
            if (fileNameEl) fileNameEl.textContent = file.name;
            if (previewBox) previewBox.classList.remove('hidden');
          }
        });
      });

      if (clearFileBtn) {
        clearFileBtn.addEventListener('click', function() {
          uploadedFileName = '';
          if (previewBox) previewBox.classList.add('hidden');
        });
      }

      // 2. Radio Choice YES / NO Store Toggle
      var choiceNo = document.getElementById('rx-choice-no');
      var choiceYes = document.getElementById('rx-choice-yes');
      var prefFields = document.getElementById('rx-preferred-store-fields');
      var autoBadge = document.getElementById('rx-auto-store-badge');

      function updateStoreChoiceUI() {
        if (choiceYes && choiceYes.checked) {
          if (prefFields) prefFields.classList.remove('hidden');
          if (autoBadge) autoBadge.classList.add('hidden');
        } else {
          if (prefFields) prefFields.classList.add('hidden');
          if (autoBadge) autoBadge.classList.remove('hidden');
        }
      }

      if (choiceNo) choiceNo.addEventListener('change', updateStoreChoiceUI);
      if (choiceYes) choiceYes.addEventListener('change', updateStoreChoiceUI);

      // 3. Submit Prescription Order Handler
      var submitBtn = document.getElementById('btn-submit-prescription-order');
      if (submitBtn) {
        submitBtn.addEventListener('click', function() {
          var patientName = (document.getElementById('rx-input-patient-name') || {}).value || '';
          var mobile = (document.getElementById('rx-input-mobile') || {}).value || '';
          var address = (document.getElementById('rx-input-address') || {}).value || '';
          var notes = (document.getElementById('rx-input-notes') || {}).value || '';
          var isParticularStore = choiceYes && choiceYes.checked;
          var storeName = isParticularStore ? ((document.getElementById('rx-store-name-input') || {}).value || '') : 'Nearest Verified Pharmacy';
          var storeArea = isParticularStore ? ((document.getElementById('rx-store-area-input') || {}).value || '') : 'Bhusawal Local Area';

          if (!patientName.trim()) {
            alert('Please enter Patient Name');
            return;
          }

          if (!mobile.trim()) {
            alert('Please enter Mobile Number');
            return;
          }

          var orderId = 'RX-BHU-' + Math.floor(100000 + Math.random() * 900000);
          var rxOrder = {
            id: orderId,
            type: 'PRESCRIPTION',
            patientName: patientName,
            mobile: mobile,
            address: address,
            notes: notes,
            storeChoice: isParticularStore ? 'YES' : 'NO',
            storeName: storeName,
            storeArea: storeArea,
            fileName: uploadedFileName || 'Prescription_Attached.pdf',
            total: 0,
            status: 'Accepted',
            timestamp: new Date().toISOString()
          };

          try {
            localStorage.setItem('bhusawal_active_order', JSON.stringify(rxOrder));
            var orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            orders.unshift(rxOrder);
            localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
          } catch(e) {}

          alert('Prescription order submitted successfully! Redirecting to live tracking...');
          window.location.href = '/track_order';
        });
      }

      // 4. Cart UI Functions
      function getGlobalCart() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) { return []; }
      }

      function saveGlobalCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateAllCartUI();
      }

      function updateAllCartUI() {
        var cart = getGlobalCart();
        var totalCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        var totalPrice = cart.reduce((sum, item) => sum + (parseFloat(item.price || item.mrp || 0) * (item.quantity || 1)), 0);

        var badge = document.getElementById('med-cart-badge');
        if (badge) badge.textContent = totalCount;

        var floatBar = document.getElementById('med-floating-cart-bar');
        var floatCount = document.getElementById('med-float-count');
        var floatTotal = document.getElementById('med-float-total');

        if (floatBar) {
          if (totalCount > 0) {
            floatBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
            if (floatCount) floatCount.textContent = totalCount + (totalCount === 1 ? ' ITEM' : ' ITEMS');
            if (floatTotal) floatTotal.textContent = '₹' + Math.round(totalPrice);
          } else {
            floatBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          }
        }
      }

      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.btn-add-med');
        if (addBtn) {
          e.stopPropagation();
          var card = addBtn.closest('.med-card');
          if (!card) return;

          var id = card.getAttribute('data-id');
          var name = card.getAttribute('data-name');
          var price = parseFloat(card.getAttribute('data-price')) || 0;
          var img = card.getAttribute('data-img');

          var cart = getGlobalCart();
          var existing = cart.find(function(c) { return c.id === id; });
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({
              id: id,
              name: name,
              price: price,
              mrp: price,
              image: img,
              quantity: 1,
              restaurant: 'Bhusawal Express Pharmacy',
              cat: 'Medicines'
            });
          }
          saveGlobalCart(cart);
          alert(name + ' added to your cart!');
        }
      });

      var searchInput = document.getElementById('med-search-input');
      if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            window.location.href = '/medicine_search?q=' + encodeURIComponent(searchInput.value.trim());
          }
        });
      }

      updateAllCartUI();
    })();
  </script>

</body>
</html>
