            {/* Medicine Name */}
            <h3 class="text-[11px] sm:text-xs font-black font-display text-slate-900 line-clamp-2 leading-snug min-h-[2.2rem]">
              {item.name}
            </h3>

            {/* Rating */}
            <div class="flex items-center gap-1 mt-1">
              <span class="text-[9px] font-black text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-md border border-amber-100">⭐ {item.rating}</span>
            </div>

            {/* Price + Add to Cart */}
            <div class="pt-2 border-t border-slate-100 mt-2.5">
              <div class="flex items-center gap-1.5 mb-2">
                <span class="text-sm sm:text-base font-black font-display text-slate-900">₹{item.price}</span>
                {item.mrp > item.price && (
                  <span class="text-[9px] text-slate-400 line-through font-bold">₹{item.mrp}</span>
                )}
                {item.mrp > item.price && (
                  <span class="text-[9px] font-black text-emerald-600 bg-emerald-50 px-1 py-0.5 rounded">
                    {Math.round(((item.mrp - item.price) / item.mrp) * 100)}% OFF
                  </span>
                )}
              </div>

              {/* Add / Qty Selector */}
              <div class="med-cart-actions">
                <button class="btn-add-med w-full py-1.5 bg-blueLight text-blueBrand hover:bg-blueBrand hover:text-white border border-blue-200 text-xs font-black rounded-xl active:scale-95 transition-all" onclick="window.addMedToCart(this, event)">
                  + ADD
                </button>
                <div class="med-qty-selector hidden flex items-center justify-between w-full bg-blueBrand rounded-xl overflow-hidden">
                  <button class="med-qty-minus px-3 py-1.5 text-white text-sm font-black hover:bg-blueDark transition-colors" onclick="window.medQtyMinus(this, event)">−</button>
                  <span class="med-qty-count text-white text-xs font-black">1</span>
                  <button class="med-qty-plus px-3 py-1.5 text-white text-sm font-black hover:bg-blueDark transition-colors" onclick="window.medQtyPlus(this, event)">+</button>
                </div>
              </div>
            </div>
