      .rx-input:focus { border-color: #3B82F6; background: #FFFFFF; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
      .rx-textarea { resize: vertical; min-height: 56px; }

      /* PREFERRED STORE SECTION */
      .rx-store-section {
        background: #F8FAFC;
