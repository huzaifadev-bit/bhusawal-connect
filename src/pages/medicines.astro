  { id: 'cat_devices', name: 'Medical Devices', icon: '🩺', color: 'bg-cyan-50 border-cyan-200 text-cyan-700' },
  { id: 'cat_ayurveda', name: 'Ayurveda & Herbal', icon: '🌱', color: 'bg-emerald-50 border-emerald-200 text-emerald-700' }
