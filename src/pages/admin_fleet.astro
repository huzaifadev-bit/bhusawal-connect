---
import Switcher from '../components/Switcher.astro';
---

<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Admin Fleet Control Center - Bhusawal Connect</title>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <script src="/assets/realtime_sync.js" is:inline></script>

  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0f172a; color: #f8fafc; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  </style>
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 pb-20">

  <header class="bg-slate-900/90 backdrop-blur-md sticky top-0 z-40 border-b border-slate-800 px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-black text-xl">
          📡
        </div>
        <div>
          <h1 class="text-base font-black text-white leading-tight">Admin Fleet Control Center</h1>
          <p class="text-xs font-bold text-slate-400">Real-Time Bhusawal Fleet Monitoring & Auto-Rider Dispatch Engine</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-black px-3 py-1.5 rounded-full flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Real-time Fleet Sync Active
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 mt-6 space-y-6">

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl space-y-1">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Active Fleet Riders</p>
        <h2 class="text-2xl font-black text-emerald-400">3 Riders</h2>
        <p class="text-[11px] text-slate-400 font-bold">2 Free • 1 On Delivery</p>
      </div>

      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl space-y-1">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Pending Orders</p>
        <h2 id="kpi-pending-orders" class="text-2xl font-black text-amber-400">0 Orders</h2>
        <p class="text-[11px] text-slate-400 font-bold">Auto-Assigning Nearest</p>
      </div>

      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl space-y-1">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Avg Bhusawal ETA</p>
        <h2 class="text-2xl font-black text-purple-400">8.4 Mins</h2>
        <p class="text-[11px] text-slate-400 font-bold">Target: &lt; 10 Mins</p>
      </div>

      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl space-y-1">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Today Completed</p>
        <h2 class="text-2xl font-black text-blue-400">142 Orders</h2>
        <p class="text-[11px] text-slate-400 font-bold">100% On-Time Payout</p>
      </div>
    </div>

    <!-- Live Map & Rider Management Panel -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Live Map (2 Columns) -->
      <div class="lg:col-span-2 bg-slate-900 p-4 rounded-3xl border border-slate-800 shadow-xl space-y-3">
        <div class="flex items-center justify-between px-2">
          <h3 class="text-xs font-black text-white uppercase tracking-wider flex items-center gap-2">
            <span>🗺️ Live Bhusawal Rider Fleet Map</span>
          </h3>
          <span class="text-[10px] font-extrabold text-slate-400">Updating GPS in Realtime</span>
        </div>
        <div id="admin-fleet-map" class="h-[500px] w-full rounded-2xl border border-slate-800"></div>
      </div>

      <!-- Pending Orders & Rider Dispatch Control (1 Column) -->
      <div class="bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 class="text-xs font-black text-white uppercase tracking-wider">⚡ Dispatch Management</h3>
          <span class="bg-purple-500/20 text-purple-400 text-[10px] font-black px-2.5 py-0.5 rounded-full">Auto-Dispatch ON</span>
        </div>

        <!-- Rider Fleet Table -->
        <div class="space-y-3">
          <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-wider">Active Riders in Bhusawal</h4>
          
          <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700/80 flex items-center justify-between text-xs">
            <div>
              <p class="font-black text-white">Huzaifa Shaikh</p>
              <p class="text-[10px] text-emerald-400 font-bold" id="huzaifa-status">🟢 ONLINE • Free (Station Rd)</p>
            </div>
            <button id="btn-assign-huzaifa" class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-[10px] font-black px-3 py-1 rounded-xl hover:bg-emerald-500/30">Assign Order</button>
          </div>

          <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700/80 flex items-center justify-between text-xs">
            <div>
              <p class="font-black text-white">Rahul Patil</p>
              <p class="text-[10px] text-blue-400 font-bold">🔵 ON DELIVERY (#ORD-8921)</p>
            </div>
            <button class="bg-slate-700 text-slate-400 text-[10px] font-black px-3 py-1 rounded-xl">Busy</button>
          </div>

          <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700/80 flex items-center justify-between text-xs">
            <div>
              <p class="font-black text-white">Vikas Mahajan</p>
              <p class="text-[10px] text-emerald-400 font-bold">🟢 ONLINE • Free (Jamner Rd)</p>
            </div>
            <button class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-[10px] font-black px-3 py-1 rounded-xl hover:bg-emerald-500/30">Assign Order</button>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-3 space-y-2">
          <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-wider">Auto-Rider Engine</h4>
          <button id="btn-auto-assign" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-black text-xs py-2.5 rounded-xl shadow-md transition-all">
            ⚡ Auto-Assign Pending Orders to Nearest Rider
          </button>
        </div>
      </div>

    </div>

  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize Admin Map
      const adminMap = L.map('admin-fleet-map', { zoomControl: false }).setView([21.0478, 75.7896], 14);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19
      }).addTo(adminMap);

      const freeRiderIcon = L.divIcon({
        html: '<div class="w-8 h-8 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center font-black shadow-lg border-2 border-white">🛵</div>',
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });

      const busyRiderIcon = L.divIcon({
        html: '<div class="w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center font-black shadow-lg border-2 border-white">🛵</div>',
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });

      const huzaifaMarker = L.marker([21.0455, 75.7858], { icon: freeRiderIcon }).addTo(adminMap).bindPopup("Huzaifa Shaikh (Station Rd)");
      L.marker([21.0520, 75.7980], { icon: busyRiderIcon }).addTo(adminMap).bindPopup("Rahul Patil (ON DELIVERY)");
      L.marker([21.0490, 75.7920], { icon: freeRiderIcon }).addTo(adminMap).bindPopup("Vikas Mahajan (Jamner Rd)");

      setTimeout(() => adminMap.invalidateSize(), 200);

      function updateKPIs() {
        try {
          const pending = JSON.parse(localStorage.getItem('pending_rider_orders') || '[]');
          document.getElementById('kpi-pending-orders').textContent = pending.length + ' Orders';
        } catch(e) {}
      }

      updateKPIs();

      // Listen for Real-time GPS location updates from Huzaifa's Rider App
      if (window.BhusawalRealtime) {
        window.BhusawalRealtime.on('rider-location', (pos) => {
          if (pos && pos.lat && pos.lng) {
            huzaifaMarker.setLatLng([pos.lat, pos.lng]);
          }
        });

        window.BhusawalRealtime.on('new-order', () => {
          updateKPIs();
        });
      }

      // Auto Assign Button
      document.getElementById('btn-auto-assign').addEventListener('click', () => {
        const pending = JSON.parse(localStorage.getItem('pending_rider_orders') || '[]');
        if (pending.length === 0) {
          alert("No pending orders to assign right now!");
          return;
        }
        alert("Auto-assigned " + pending.length + " order(s) to nearest available rider (Huzaifa Shaikh)!");
      });
    });
  </script>

  <Switcher />
</body>
</html>
