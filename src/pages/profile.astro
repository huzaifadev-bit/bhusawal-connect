</head>
<body class="bg-background text-on-background font-body-md min-h-screen pb-24">

<!-- Top App Bar -->
<header class="bg-surface/80 dark:bg-inverse-surface/80 backdrop-blur-xl shadow-sm top-0 sticky z-50 flex items-center justify-between px-margin-mobile h-16 w-full">
    <div class="flex items-center gap-2 min-w-0">
        
        <a href="/home" class="p-2 hover:bg-surface-container-high rounded-full transition-colors active:scale-95 duration-150 flex-shrink-0 flex items-center justify-center mr-1">
            <span class="material-symbols-outlined text-primary">arrow_back</span>
        </a>
  
        <!-- Delivery Time & Location Info -->
        <div class="flex flex-col min-w-0">
            <div class="flex items-center gap-1">
                <span class="material-symbols-outlined text-primary text-sm font-black animate-pulse" style="font-variation-settings: 'FILL' 1;">bolt</span>
                <span class="font-extrabold text-[13px] tracking-tight text-on-surface" id="header-eta">10 minutes</span>
            </div>
            <div class="flex items-center gap-0.5 text-[10px] text-on-surface-variant font-extrabold cursor-pointer hover:text-primary transition-colors min-w-0 uppercase tracking-wide">
                <span class="truncate" id="header-address">Home - Varangaon Road, Bhusawal</span>
                <span class="material-symbols-outlined text-xs flex-shrink-0">keyboard_arrow_down</span>
            </div>
        </div>
    </div>
    <!-- Profile Avatar on Top Right -->
    <a href="/profile" class="w-9 h-9 rounded-full overflow-hidden border border-outline-variant/30 flex-shrink-0 hover:ring-2 hover:ring-primary/20 active:scale-90 transition-all flex items-center justify-center">
        <img class="w-full h-full object-cover" src="/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg" alt="Profile"  onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
    </a>
</header>
<script is:inline>
  (function() {
    const cachedAddr = localStorage.getItem('bhusawal_user_address') || 'Home - Varangaon Rd, Bhusawal';
    const cachedLat = localStorage.getItem('bhusawal_user_lat');
    const cachedLng = localStorage.getItem('bhusawal_user_lng');
    
    document.addEventListener('DOMContentLoaded', () => {
      const addrEl = document.getElementById('header-address');
      if (addrEl) {
        // Shorten the address to make it look clean (max 30 chars) and append "..." if longer
        let shortAddr = cachedAddr;
        if (shortAddr.length > 30) {
          shortAddr = shortAddr.substring(0, 27) + '...';
        }
        addrEl.textContent = shortAddr;
      }
      
      const etaEl = document.getElementById('header-eta');
      if (etaEl) {
        if (cachedLat && cachedLng) {
          const lat1 = parseFloat(cachedLat);
          const lng1 = parseFloat(cachedLng);
          const lat2 = 21.0478;
          const lng2 = 75.7896;
          const R = 6371;
          const dLat = (lat2 - lat1) * Math.PI / 180;
          const dLon = (lng2 - lng1) * Math.PI / 180;
          const a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
          const dist = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
          const minutes = Math.max(7, Math.round(dist * 2.5 + 4));
          etaEl.textContent = minutes + ' minutes';
        } else {
          etaEl.textContent = '10 minutes';
        }
      }
    });
  })();
</script>

<main class="max-w-md mx-auto px-margin-mobile py-4 space-y-6">

    <!-- Profile Overview Card -->
    <div class="profile-header-bg p-6 rounded-3xl text-white shadow-lg flex items-center gap-4 relative overflow-hidden">
        <!-- Overlay subtle pattern -->
        <div class="absolute inset-0 bg-black/5 mix-blend-overlay" />
        
        <!-- Avatar -->
        <div class="w-16 h-16 rounded-full border-4 border-white/30 overflow-hidden shadow-inner flex-shrink-0">
            <img class="w-full h-full object-cover" src="/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg" alt="User Profile"  onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
        </div>
        <!-- Profile Info -->
        <div class="flex-1 min-w-0">
            <h2 id="user-name" class="text-xl font-bold truncate">Sahil Patel</h2>
            <p id="user-phone" class="text-sm text-white/80 font-medium mt-0.5">+91 99999 99999</p>
            <div class="inline-flex bg-white/20 backdrop-blur-md px-2 py-0.5 rounded-full text-[10px] font-bold mt-2 tracking-wide uppercase">
                Customer
            </div>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-3 gap-3">
        <div class="bg-white p-3 rounded-2xl border border-outline-variant/30 text-center shadow-sm">
            <p id="stat-orders" class="text-xl font-extrabold text-primary">0</p>
            <p class="text-[10px] font-bold text-on-surface-variant mt-0.5 uppercase tracking-wide">Orders</p>
        </div>
        <div class="bg-white p-3 rounded-2xl border border-outline-variant/30 text-center shadow-sm">
            <p class="text-xl font-extrabold text-[#0c831f]">2</p>
            <p class="text-[10px] font-bold text-on-surface-variant mt-0.5 uppercase tracking-wide">Addresses</p>
        </div>
        <div class="bg-white p-3 rounded-2xl border border-outline-variant/30 text-center shadow-sm">
            <p class="text-xl font-extrabold text-blue-600">₹0</p>
            <p class="text-[10px] font-bold text-on-surface-variant mt-0.5 uppercase tracking-wide">B-Wallet</p>
        </div>
    </div>

    <!-- Past / Active Orders Section -->
    <div class="space-y-3">
        <div class="flex items-center justify-between">
            <h3 class="font-headline-md text-lg text-on-surface">Recent Orders</h3>
            <span class="text-xs font-bold text-primary hover:underline cursor-pointer">View History</span>
        </div>

        <div id="orders-container" class="space-y-3">
            <!-- Dynamic order items will be injected here -->
            <div class="bg-white p-6 rounded-2xl border border-outline-variant/20 text-center space-y-3 shadow-sm">
                <div class="w-12 h-12 bg-primary-fixed/30 text-primary rounded-full flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-2xl">receipt_long</span>
                </div>
                <div>
                    <h4 class="font-bold text-on-surface text-sm">No orders yet</h4>
                    <p class="text-xs text-on-surface-variant mt-1">Order groceries, food, or medicines to view updates.</p>
                </div>
                <a href="/home" class="inline-flex bg-primary text-on-primary text-xs font-extrabold px-4 py-2 rounded-xl transition-all active:scale-95">
                    Order Now
                </a>
            </div>
        </div>
    </div>

    <!-- Settings Menu List -->
    <div class="bg-white rounded-3xl border border-outline-variant/20 shadow-sm overflow-hidden divide-y divide-outline-variant/10">
        <!-- Addresses -->
        <div class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors cursor-pointer active:scale-98">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary-fixed/20 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-on-surface">Saved Addresses</h4>
                    <p class="text-[10px] text-on-surface-variant">Manage home, office addresses</p>
                </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant">chevron_right</span>
        </div>

        <!-- Payments -->
        <div class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors cursor-pointer active:scale-98">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">payments</span>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-on-surface">Payment Methods</h4>
                    <p class="text-[10px] text-on-surface-variant">UPI, saved cards, wallet link</p>
                </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant">chevron_right</span>
        </div>

        <!-- Help -->
        <div class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors cursor-pointer active:scale-98">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">help</span>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-on-surface">Help & Support</h4>
                    <p class="text-[10px] text-on-surface-variant">Chat with support, FAQs</p>
                </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant">chevron_right</span>
        </div>

        <!-- Log Out -->
        <div id="btn-logout" class="flex items-center justify-between p-4 hover:bg-error/5 transition-colors cursor-pointer active:scale-98 group">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-error/10 text-error flex items-center justify-center">
                    <span class="material-symbols-outlined">logout</span>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-error group-hover:underline">Sign Out</h4>
                    <p class="text-[10px] text-error/80">Log out of your customer session</p>
                </div>
            </div>
            <span class="material-symbols-outlined text-error">chevron_right</span>
        </div>
    </div>

</main>

<!-- BottomNavBar -->
<nav class="fixed bottom-0 w-full z-50 rounded-t-xl bg-surface/80 dark:bg-inverse-surface/80 backdrop-blur-xl shadow-[0_-4px_12px_rgba(0,0,0,0.04)] border-t border-outline-variant/30 fixed bottom-0 w-full flex justify-around items-center h-20 pb-safe px-4">
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary-container transition-all active:scale-90 duration-200" href="/home">
        <span class="material-symbols-outlined">home</span>
        <span class="font-label-sm text-label-sm">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary-container transition-all active:scale-90 duration-200" href="/orders">
        <span class="material-symbols-outlined">receipt_long</span>
        <span class="font-label-sm text-label-sm">Orders</span>
    </a>
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary-container transition-all active:scale-90 duration-200" href="/grocery">
        <span class="material-symbols-outlined">search</span>
        <span class="font-label-sm text-label-sm">Search</span>
    </a>
    <a class="flex flex-col items-center justify-center text-primary bg-primary-fixed/30 rounded-full px-4 py-1 active:scale-90 duration-200 transition-all" href="/profile">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">person</span>
        <span class="font-label-sm text-label-sm">Account</span>
    </a>
</nav>

<script>
    // Route guard
    if (!localStorage.getItem('bhusawal_user_token')) {
        window.location.href = '/';
    }

    // Populate user profile details
    const userString = localStorage.getItem('bhusawal_user');
    if (userString) {
        try {
            const user = JSON.parse(userString);
            document.getElementById('user-name').textContent = user.name || 'Bhusawal Connect Resident';
            document.getElementById('user-phone').textContent = user.phone || '';
        } catch (e) {
            console.error('Failed to parse user details', e);
        }
    }

    // Fetch and populate recent orders from localStorage
    const ordersString = localStorage.getItem('bhusawal_orders');
    if (ordersString) {
        try {
            const orders = JSON.parse(ordersString);
            if (orders && orders.length > 0) {
                // Update orders stat counter
                document.getElementById('stat-orders').textContent = orders.length;

                const ordersContainer = document.getElementById('orders-container');
                ordersContainer.innerHTML = ''; // Clear empty state

                // Display up to 3 recent orders
                orders.slice(0, 3).forEach(order => {
                    const statusColors = {
                        'Verifying': 'bg-yellow-100 text-yellow-700',
                        'Preparing': 'bg-blue-100 text-blue-700',
                        'Delivering': 'bg-orange-100 text-orange-700',
                        'Delivered': 'bg-green-100 text-green-700',
                        'Verifying...': 'bg-yellow-100 text-yellow-700'
                    };
                    const statusClass = statusColors[order.status] || 'bg-surface-container text-on-surface-variant';

                    const orderEl = document.createElement('div');
                    orderEl.className = 'bg-white p-4 rounded-2xl border border-outline-variant/30 shadow-sm flex items-center justify-between gap-4';
                    orderEl.innerHTML = `
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-primary-fixed/20 text-primary flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined">receipt</span>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-sm text-on-surface truncate">${order.items}</h4>
                                </div>
                                <p class="text-[10px] text-on-surface-variant mt-0.5">${order.date || 'Today'} • #${order.id}</p>
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="inline-block text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wide ${statusClass}">
                                ${order.status}
                            </span>
                            <p class="font-extrabold text-sm text-on-surface mt-1">₹${order.total || '0'}</p>
                        </div>
                    `;
                    ordersContainer.appendChild(orderEl);
                });
            }
        } catch (e) {
            console.error('Failed to parse orders details', e);
        }
    }

    // Log Out functionality
    document.getElementById('btn-logout').addEventListener('click', () => {
        localStorage.removeItem('bhusawal_user_token');
        localStorage.removeItem('bhusawal_user');
        window.location.href = '/';
    });
</script>

<Switcher />
</body>
</html>