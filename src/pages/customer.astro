---
// src/pages/customer.astro - Customer Hub & Dashboard
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Dashboard | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff',
            skyBrand: '#0284c7',
            skyLight: '#e0f2fe'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-24 text-slate-800 antialiased bg-slate-50">

  <!-- TOP STICKY HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3.5 shadow-xs">
    <div class="max-w-4xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/home" class="flex items-center gap-1.5">
          <span class="text-xl font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
        </a>
        <span class="px-2.5 py-0.5 bg-purple-50 text-purpleBrand text-[10px] font-black uppercase rounded-full border border-purple-100">
          Customer Hub
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a href="/cart" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 hover:bg-purple-50 hover:text-purpleBrand transition-colors relative">
          <span class="material-symbols-outlined text-lg">shopping_cart</span>
          <span id="cart-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-purpleBrand text-white text-[9px] font-black rounded-full flex items-center justify-center">0</span>
        </a>
        <button id="btn-logout" class="px-3 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-xl text-xs font-black transition-all flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">logout</span>
          <span class="hidden sm:inline">Logout</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-6 space-y-6">

    <!-- AUTHENTICATED CUSTOMER BANNER -->
    <div class="bg-gradient-to-r from-purple-900 via-indigo-900 to-slate-900 rounded-3xl p-6 text-white shadow-xl flex items-center justify-between flex-wrap gap-4 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-purple-500/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="flex items-center gap-4 relative z-10">
        <div class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white text-2xl font-black shadow-inner">
          <span class="material-symbols-outlined text-3xl text-purple-300">verified_user</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 id="customer-name" class="text-xl sm:text-2xl font-black font-display">Bhusawal Customer</h1>
            <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">
              Verified
            </span>
          </div>
          <p id="customer-phone" class="text-xs font-bold text-purple-200 mt-0.5">+91 Verified Customer</p>
          <p id="customer-id" class="text-[10px] text-purple-300/80 font-mono mt-0.5">Session: Authenticated</p>
        </div>
      </div>

      <div class="flex items-center gap-2 relative z-10">
        <a href="/profile" class="px-4 py-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-2xl text-xs font-black transition-all flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base">manage_accounts</span>
          <span>Edit Profile</span>
        </a>
      </div>
    </div>

    <!-- QUICK WALLET & STATS STRIP -->
    <div class="grid grid-cols-3 gap-3">
      <div class="bg-white rounded-2xl p-4 border border-slate-100 shadow-xs text-center">
        <span class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider block">Orders</span>
        <span id="stat-orders" class="text-xl font-black font-display text-slate-900">0</span>
      </div>
      <div class="bg-white rounded-2xl p-4 border border-slate-100 shadow-xs text-center">
        <span class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider block">Wallet</span>
        <span class="text-xl font-black font-display text-emerald-600">₹150</span>
      </div>
      <div class="bg-white rounded-2xl p-4 border border-slate-100 shadow-xs text-center">
        <span class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider block">Location</span>
        <span class="text-xs font-black text-purpleBrand bg-purple-50 px-2 py-0.5 rounded-full inline-block mt-1">Bhusawal</span>
      </div>
    </div>

    <!-- CORE SERVICES GRID -->
    <div class="space-y-3">
      <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Quick Services</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        
        <!-- Grocery -->
        <a href="/grocery" class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs hover:border-purpleBrand hover:shadow-md transition-all flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            🛒
          </div>
          <span class="text-xs font-black text-slate-900 mt-2">Daily Needs</span>
          <span class="text-[10px] font-bold text-slate-400">2,680+ Items</span>
        </a>

        <!-- Food -->
        <a href="/food" class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs hover:border-purpleBrand hover:shadow-md transition-all flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            🍔
          </div>
          <span class="text-xs font-black text-slate-900 mt-2">Food Delivery</span>
          <span class="text-[10px] font-bold text-slate-400">225+ Dishes</span>
        </a>

        <!-- Medicines -->
        <a href="/medicines" class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs hover:border-purpleBrand hover:shadow-md transition-all flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            💊
          </div>
          <span class="text-xs font-black text-slate-900 mt-2">Medicines</span>
          <span class="text-[10px] font-bold text-slate-400">Prescription & OTC</span>
        </a>

        <!-- Bike Taxi & Auto -->
        <a href="/bike_ride" class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs hover:border-purpleBrand hover:shadow-md transition-all flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            🛵
          </div>
          <span class="text-xs font-black text-slate-900 mt-2">Bike Taxi</span>
          <span class="text-[10px] font-bold text-slate-400">Instant Ride</span>
        </a>

      </div>
    </div>

    <!-- QUICK ACTIONS & ACTIVE ORDERS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Track Order Card -->
      <a href="/track_order" class="bg-white p-5 rounded-3xl border border-purple-100 shadow-xs hover:shadow-md transition-all flex items-center justify-between group">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purpleBrand flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">location_on</span>
          </div>
          <div>
            <h3 class="text-sm font-black text-slate-900 group-hover:text-purpleBrand transition-colors">Live Order Tracking</h3>
            <p class="text-xs font-bold text-slate-400">Track delivery partner in real-time</p>
          </div>
        </div>
        <span class="material-symbols-outlined text-slate-400 group-hover:text-purpleBrand group-hover:translate-x-1 transition-all">chevron_right</span>
      </a>

      <!-- Order History Card -->
      <a href="/orders" class="bg-white p-5 rounded-3xl border border-slate-100 shadow-xs hover:shadow-md transition-all flex items-center justify-between group">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-slate-50 text-slate-700 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">receipt_long</span>
          </div>
          <div>
            <h3 class="text-sm font-black text-slate-900 group-hover:text-purpleBrand transition-colors">Order History</h3>
            <p class="text-xs font-bold text-slate-400">View past invoices and receipts</p>
          </div>
        </div>
        <span class="material-symbols-outlined text-slate-400 group-hover:text-purpleBrand group-hover:translate-x-1 transition-all">chevron_right</span>
      </a>

    </div>

  </main>

  <!-- BOTTOM NAVIGATION BAR -->
  <nav class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200/80 px-6 py-2 shadow-lg">
    <div class="max-w-md mx-auto flex items-center justify-around">
      <a href="/home" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">home</span>
        <span class="text-[10px] font-bold">Home</span>
      </a>
      <a href="/grocery" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">storefront</span>
        <span class="text-[10px] font-bold">Grocery</span>
      </a>
      <a href="/orders" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">receipt_long</span>
        <span class="text-[10px] font-bold">Orders</span>
      </a>
      <a href="/customer" class="flex flex-col items-center gap-0.5 text-purpleBrand">
        <span class="material-symbols-outlined text-xl">person</span>
        <span class="text-[10px] font-black">Customer</span>
      </a>
    </div>
  </nav>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Session check
      const profileStr = localStorage.getItem('bhusawal_user_profile');
      const phone = localStorage.getItem('bhusawal_user_phone');

      if (!profileStr && !phone) {
        // Unauthenticated customer -> redirect to login
        window.location.href = '/login?redirect=/customer';
        return;
      }

      let profile = {};
      try {
        profile = JSON.parse(profileStr || '{}');
      } catch (e) {}

      // 2. Populate UI
      const nameEl = document.getElementById('customer-name');
      const phoneEl = document.getElementById('customer-phone');
      const idEl = document.getElementById('customer-id');

      if (nameEl) nameEl.textContent = profile.name || 'Bhusawal Customer';
      if (phoneEl) phoneEl.textContent = profile.phone || phone || '+91 Customer';
      if (idEl) idEl.textContent = `Customer ID: ${profile.id || 'CUST-' + (phone || '9999').slice(-4)}`;

      // 3. Count Orders
      try {
        const orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
        const statOrders = document.getElementById('stat-orders');
        if (statOrders) statOrders.textContent = orders.length;
      } catch (e) {}

      // 4. Cart badge
      try {
        const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        const badge = document.getElementById('cart-badge');
        if (badge && cart.length > 0) {
          badge.textContent = cart.length;
          badge.classList.remove('hidden');
        }
      } catch (e) {}

      // 5. Logout handler
      const logoutBtn = document.getElementById('btn-logout');
      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem('bhusawal_user_profile');
        localStorage.removeItem('bhusawal_user_phone');
        localStorage.removeItem('bhusawal_auth_session');
        window.dispatchEvent(new Event('storage'));
        window.location.href = '/login';
      });
    });
  </script>

</body>
</html>
