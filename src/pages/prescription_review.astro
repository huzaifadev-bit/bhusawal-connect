---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pharmacist Prescription Verification Console | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAFC; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="bg-white min-h-screen text-slate-800 pb-20 antialiased">

  <!-- HEADER -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50 px-4 py-3 shadow-xs">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/medicines" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
          <span class="material-symbols-outlined text-xl">arrow_back</span>
        </a>
        <div>
          <h1 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
            <span>💊 Pharmacist Review Dashboard</span>
            <span class="bg-blueLight text-blueBrand text-[9px] font-black px-2 py-0.5 rounded-full uppercase border border-blue-200">VERIFIED PARTNER</span>
          </h1>
          <p class="text-[10px] text-slate-500 font-semibold">Verify doctor prescriptions, manage stock & suggest alternatives</p>
        </div>
      </div>

      <a href="/orders" class="px-3.5 py-1.5 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl transition-all shadow-sm">
        My Customer Orders
      </a>
    </div>
  </header>

  <!-- MAIN CONSOLE -->
  <main class="max-w-7xl mx-auto px-4 mt-6 space-y-6">

    <!-- SUMMARY METRICS BAR -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Pending Review</span>
        <span class="text-2xl font-black text-amber-600 font-display" id="metric-pending">1</span>
        <span class="text-[10px] font-semibold text-slate-500 block">Needs verification</span>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Verified & Packed</span>
        <span class="text-2xl font-black text-emerald-600 font-display" id="metric-verified">4</span>
        <span class="text-[10px] font-semibold text-slate-500 block">Ready for dispatch</span>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Alternatives Suggested</span>
        <span class="text-2xl font-black text-blueBrand font-display" id="metric-alt">1</span>
        <span class="text-[10px] font-semibold text-slate-500 block">Awaiting customer decision</span>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Completed Deliveries</span>
        <span class="text-2xl font-black text-slate-800 font-display" id="metric-delivered">12</span>
        <span class="text-[10px] font-semibold text-slate-500 block">Delivered safely</span>
      </div>
    </div>

    <!-- PRESCRIPTION ORDERS REVIEW GRID -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
          <span>📄</span>
          <span>Prescription Verification Queue</span>
        </h2>
        <button id="btn-refresh-queue" class="text-xs font-bold text-blueBrand hover:underline flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">refresh</span> Refresh Queue
        </button>
      </div>

      <div id="rx-review-cards-container" class="space-y-4">
        <!-- Dynamically rendered -->
      </div>
    </div>

  </main>

  <Switcher />

  <!-- DASHBOARD SCRIPT -->
  <script is:inline>
    (function() {
      const SAMPLE_RX_ORDERS = [
        {
          id: 'RX-BHU-784920',
          type: 'PRESCRIPTION',
          patientName: 'Rahul Patil',
          mobile: '9876543210',
          date: new Date().toISOString(),
          status: 'Under Verification',
          step: 2,
          address: 'Plot 42, Station Road, Shivaji Nagar, Bhusawal',
          landmark: 'Near Bus Stand',
          notes: 'Deliver before 8 PM. Please check dosage.',
          storeName: 'Apollo Pharmacy - Station Road',
          storeArea: 'Bhusawal Local Area',
          fileName: 'Doctor_Prescription_Aug2026.pdf',
          total: 345,
          payment: 'Cash on Delivery',
          alternativeSuggested: null,
          items: [
            { id: 'm1', name: 'Dolo 650mg Tablet (Strip of 15)', price: 32, quantity: 2 },
            { id: 'm2', name: 'Revital H Multivitamin (60 Capsules)', price: 281, quantity: 1 }
          ]
        }
      ];

      function getRxOrders() {
        try {
          const stored = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
          const rxList = stored.filter(o => o.type === 'PRESCRIPTION' || (o.id || '').startsWith('RX-'));
          if (rxList && rxList.length > 0) return rxList;
        } catch(e) {}
        return SAMPLE_RX_ORDERS;
      }

      function saveAllOrders(allList) {
        localStorage.setItem('bhusawal_orders', JSON.stringify(allList));
        renderQueue();
      }

      const RX_STEPS_DEF = [
        '1. Prescription Uploaded',
        '2. Under Verification',
        '3. Verified',
        '4. Medicines Packed',
        '5. Picked Up',
        '6. Out For Delivery',
        '7. Delivered'
      ];

      function renderQueue() {
        const orders = getRxOrders();
        const container = document.getElementById('rx-review-cards-container');

        // Metrics
        let pending = 0, verified = 0, altCount = 0, delivered = 0;
        orders.forEach(o => {
          if (o.status === 'Prescription Uploaded' || o.status === 'Under Verification') pending++;
          if (o.status === 'Verified' || o.status === 'Medicines Packed') verified++;
          if (o.alternativeSuggested && o.alternativeSuggested.customerDecision === 'PENDING') altCount++;
          if (o.status === 'Delivered') delivered++;
        });

        document.getElementById('metric-pending').textContent = pending;
        document.getElementById('metric-verified').textContent = verified;
        document.getElementById('metric-alt').textContent = altCount;
        document.getElementById('metric-delivered').textContent = delivered;

        if (orders.length === 0) {
          container.innerHTML = `
            <div class="bg-white rounded-3xl p-8 text-center space-y-2 border border-slate-200">
              <span class="material-symbols-outlined text-4xl text-slate-300">task_alt</span>
              <h3 class="text-base font-black text-slate-800">No Prescriptions Pending Review</h3>
              <p class="text-xs font-bold text-slate-400">All prescription orders have been verified and processed!</p>
            </div>
          `;
          return;
        }

        let html = '';
        orders.forEach(order => {
          const id = order.id || 'RX-BHU-000';
          const status = order.status || 'Under Verification';
          const alt = order.alternativeSuggested;

          html += `
            <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-xs space-y-4 hover:border-blue-300 transition-all">
              
              <!-- Card Top Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="bg-blueBrand text-white text-xs font-black px-2.5 py-0.5 rounded-md uppercase">Rx Order</span>
                    <h3 class="text-base font-black font-display text-slate-900">#${id}</h3>
                    <span class="px-2.5 py-0.5 rounded-full bg-blueLight text-blueBrand text-xs font-black border border-blue-200">${status}</span>
                  </div>
                  <p class="text-xs font-bold text-slate-500 mt-1">
                    Patient: <span class="text-slate-900">${order.patientName || 'Customer'}</span> (${order.mobile || 'N/A'}) • Preferred Store: <span class="text-blueBrand font-black">${order.storeName || 'Nearest Verified Pharmacy'}</span>
                  </p>
                </div>
                <div class="text-left sm:text-right">
                  <a href="/track_order?id=${id}" class="text-xs font-black text-blueBrand hover:underline flex items-center gap-1">
                    Track Customer View <span class="material-symbols-outlined text-sm">open_in_new</span>
                  </a>
                </div>
              </div>

              <!-- Prescription Document Preview Card -->
              <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-blueLight text-blueBrand flex items-center justify-center font-black text-lg shrink-0">
                    📄
                  </div>
                  <div>
                    <h4 class="text-xs font-black text-slate-900">${order.fileName || 'Prescription_Document.pdf'}</h4>
                    <p class="text-[11px] text-slate-500 font-semibold">Address: ${order.address || 'Bhusawal Local Area'} ${order.landmark ? '(' + order.landmark + ')' : ''}</p>
                    ${order.notes ? `<p class="text-[11px] text-slate-600 font-bold mt-0.5">Customer Instructions: "${order.notes}"</p>` : ''}
                  </div>
                </div>
                <button class="px-3.5 py-1.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-extrabold rounded-xl shrink-0 active:scale-95 transition-all">
                  🔍 View Document
                </button>
              </div>

              <!-- Alternative Suggestion Panel -->
              ${alt ? `
                <div class="bg-amber-50 border border-amber-300 rounded-2xl p-3.5 space-y-1.5 text-xs font-bold text-slate-800">
                  <div class="flex items-center justify-between text-amber-900 font-black">
                    <span>⚠️ Alternative Medicine Flagged</span>
                    <span class="bg-white px-2 py-0.5 rounded text-[10px] uppercase font-extrabold text-amber-800 border border-amber-200">Customer Status: ${alt.customerDecision}</span>
                  </div>
                  <p class="text-xs font-semibold text-slate-700">
                    Original: <span class="line-through text-rose-600 font-black">${alt.original}</span> ➔ Suggested: <span class="text-emerald-700 font-black">${alt.suggested} (₹${alt.price})</span>
                  </p>
                  <p class="text-[11px] italic text-slate-500">"Pharmacist Note: ${alt.pharmacistNote}"</p>
                </div>
              ` : ''}

              <!-- PHARMACIST ACTION CONTROLS -->
              <div class="pt-2 border-t border-slate-100 space-y-3">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">PHARMACIST VERIFICATION ACTIONS</span>
                
                <div class="flex flex-wrap items-center gap-2">
                  <button class="btn-verify-rx px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black rounded-xl shadow-xs active:scale-95 transition-all" data-id="${id}">
                    ✓ Approve & Mark Verified
                  </button>

                  <button class="btn-suggest-alt-modal px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-black rounded-xl shadow-xs active:scale-95 transition-all" data-id="${id}">
                    ⚠️ Suggest Alternative Medicine
                  </button>

                  <button class="btn-pack-rx px-4 py-2 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl shadow-xs active:scale-95 transition-all" data-id="${id}">
                    📦 Mark Medicines Packed
                  </button>

                  <button class="btn-dispatch-rx px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-black rounded-xl shadow-xs active:scale-95 transition-all" data-id="${id}">
                    🛵 Dispatch Out For Delivery
                  </button>
                </div>
              </div>

            </div>
          `;
        });

        container.innerHTML = html;

        // Bind Action Handlers
        document.querySelectorAll('.btn-verify-rx').forEach(btn => {
          btn.onclick = () => {
            const id = btn.dataset.id;
            updateOrderStatus(id, 'Verified');
          };
        });

        document.querySelectorAll('.btn-pack-rx').forEach(btn => {
          btn.onclick = () => {
            const id = btn.dataset.id;
            updateOrderStatus(id, 'Medicines Packed');
          };
        });

        document.querySelectorAll('.btn-dispatch-rx').forEach(btn => {
          btn.onclick = () => {
            const id = btn.dataset.id;
            updateOrderStatus(id, 'Out For Delivery');
          };
        });

        document.querySelectorAll('.btn-suggest-alt-modal').forEach(btn => {
          btn.onclick = () => {
            const id = btn.dataset.id;
            const orig = prompt('Enter unavailable medicine name:', 'Dolo 650mg Tablet');
            if (!orig) return;
            const sugg = prompt('Enter recommended substitute medicine name:', 'Crocin Advance 500mg Tablet');
            if (!sugg) return;
            const price = prompt('Enter substitute price (₹):', '28');
            const note = prompt('Enter note for customer:', 'Original medicine is out of stock. Substitute contains same active ingredient.');

            const allOrders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            const target = allOrders.find(o => o.id === id);
            if (target) {
              target.status = 'Under Verification';
              target.alternativeSuggested = {
                original: orig,
                suggested: sugg,
                price: parseFloat(price) || 30,
                pharmacistNote: note || 'Pharmacist suggested substitute.',
                customerDecision: 'PENDING'
              };
              saveAllOrders(allOrders);
              alert('Alternative medicine suggestion sent to customer for approval!');
            }
          };
        });
      }

      function updateOrderStatus(orderId, newStatus) {
        const allOrders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
        const target = allOrders.find(o => o.id === orderId);
        if (target) {
          target.status = newStatus;
          saveAllOrders(allOrders);
          alert(`Order #${orderId} updated to '${newStatus}'!`);
        }
      }

      document.getElementById('btn-refresh-queue')?.addEventListener('click', renderQueue);

      renderQueue();
    })();
  </script>

</body>
</html>
