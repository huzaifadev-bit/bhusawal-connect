---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Booking Summary — Express Parcel Delivery | Bhusawal Connect</title>
  
  <!-- TAILWIND & GOOGLE FONTS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- LEAFLET MAPS FOR SUMMARY ROUTE PREVIEW -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- GROCERY MATCHED PREMIUM TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            yellowBrand: '#FACC15',
            yellowDark: '#CA8A04',
            yellowLight: '#FEF9C3',
            yellowBorder: '#FEF08A',
            yellowAccent: '#EAB308',
            yellowDeep: '#854D0E',
            purpleBrand: '#7C3AED',
            purpleLight: '#F5F3FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #FAFAFA; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }

    /* Custom Leaflet Pin Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.15);
    }
  </style>
</head>

<body class="pb-40 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-slate-50/50">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-6 py-4 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/parcel" class="w-10 h-10 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-700 hover:bg-slate-200 transition-all active:scale-95 border border-slate-200">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-lg sm:text-xl font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>📦 Parcel Booking Summary</span>
          <span class="bg-yellowLight text-yellowDeep text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-yellowBorder">STEP 2 OF 2</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Review your item delivery details before confirming pickup</p>
      </div>
    </div>

    <!-- Edit Info Button -->
    <a href="/parcel" class="flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-yellowLight text-slate-800 hover:text-yellowDeep text-xs font-black rounded-xl border border-slate-200 hover:border-yellowBorder transition-all active:scale-95 shadow-xs">
      <span class="material-symbols-outlined text-base text-yellowDark">edit</span>
      <span class="hidden sm:inline">Edit Details</span>
    </a>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-6">

    <!-- STEP PROGRESS INDICATOR BAR -->
    <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex items-center justify-between text-xs font-black">
      <div class="flex items-center gap-2 text-emerald-600">
        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-black">✓</span>
        <span>1. Item Details</span>
      </div>
      <div class="h-0.5 flex-1 mx-4 bg-yellowBrand rounded-full"></div>
      <div class="flex items-center gap-2 text-slate-900">
        <span class="w-6 h-6 rounded-full bg-yellowBrand text-slate-950 flex items-center justify-center text-xs font-black shadow-xs">2</span>
        <span class="font-extrabold">2. Review & Confirm</span>
      </div>
    </div>

    <!-- ROUTE MAP PREVIEW CARD -->
    <section class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-black">
            <span class="material-symbols-outlined text-lg">route</span>
          </div>
          <div>
            <h2 class="text-base font-black font-display text-slate-900">Delivery Route Preview</h2>
            <p class="text-xs text-slate-500 font-medium">Bhusawal local courier rider path</p>
          </div>
        </div>

        <div class="flex items-center gap-2 bg-yellowLight border border-yellowBorder px-3 py-1 rounded-xl text-xs font-black text-yellowDeep shadow-xs">
          <span>📏 <span id="summary-distance-text">3.5 km</span></span>
          <span class="text-yellowDark/40">•</span>
          <span>⏱️ <span id="summary-time-text">15 - 20 Mins</span></span>
        </div>
      </div>

      <!-- MAP CONTAINER -->
      <div class="w-full h-48 sm:h-56 rounded-2xl overflow-hidden border border-slate-200 relative shadow-inner z-10" id="summary-map">
        <!-- Leaflet Map rendered via JS -->
      </div>
    </section>

    <!-- MAIN TWO-COLUMN GRID (SUMMARY CARDS) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- LEFT COLUMN: ADDRESSES & ITEM DETAILS (8 Cols) -->
      <div class="md:col-span-7 space-y-6">
        
        <!-- ADDRESS DETAILS CARD -->
        <section class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span class="text-yellowDark">📍</span>
              <span>Pickup & Drop Addresses</span>
            </h3>
            <a href="/parcel" class="text-xs font-bold text-yellowDark hover:underline">Change</a>
          </div>

          <div class="space-y-4 text-xs font-semibold relative pl-4 border-l-2 border-dashed border-slate-300">
            
            <!-- PICKUP ADDRESS -->
            <div class="relative space-y-1">
              <div class="absolute -left-[23px] top-0.5 w-4 h-4 rounded-full bg-sky-500 border-2 border-white shadow-xs"></div>
              <span class="text-[10px] font-black text-sky-700 uppercase tracking-wider block">Pickup Address</span>
              <p class="font-bold text-slate-900 text-sm" id="sum-pickup-addr">Varangaon Road, Near Station Square, Bhusawal</p>
              <p class="text-slate-500" id="sum-sender-info">Sender: Rahul Patil • 9876543210</p>
            </div>

            <!-- DROP ADDRESS -->
            <div class="relative space-y-1 pt-2">
              <div class="absolute -left-[23px] top-2.5 w-4 h-4 rounded-full bg-slate-900 border-2 border-white shadow-xs"></div>
              <span class="text-[10px] font-black text-slate-700 uppercase tracking-wider block">Drop Address</span>
              <p class="font-bold text-slate-900 text-sm" id="sum-drop-addr">Jamner Road, Near Ordnance Factory Gate, Bhusawal</p>
              <p class="text-slate-500" id="sum-receiver-info">Receiver: Amit Sharma • 9123456789</p>
            </div>

          </div>
        </section>

        <!-- ITEM SPECIFICATIONS CARD -->
        <section class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span class="text-yellowDark">📦</span>
              <span>Selected Item Specifications</span>
            </h3>
            <a href="/parcel" class="text-xs font-bold text-yellowDark hover:underline">Edit</a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Category -->
            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 space-y-1">
              <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider block">📦 Selected Item Category</span>
              <p class="text-sm font-black text-slate-900" id="sum-category-text">Documents / Office Papers</p>
            </div>

            <!-- Weight -->
            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 space-y-1">
              <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider block">⚖ Estimated Weight</span>
              <p class="text-sm font-black text-slate-900" id="sum-weight-text">Up to 1 kg (Lightweight)</p>
            </div>

          </div>

          <!-- DESCRIPTION -->
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 space-y-1">
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider block">📝 Item Description</span>
            <p class="text-xs font-bold text-slate-800" id="sum-description-text">Important property legal documents enclosed in a sealed waterproof envelope.</p>
          </div>

          <!-- UPLOADED ITEM PHOTO PREVIEW -->
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 space-y-2">
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider block">📷 Uploaded Item Photo</span>
            
            <div class="flex items-center gap-3">
              <div class="w-16 h-16 rounded-xl bg-white border border-slate-200 p-1 overflow-hidden shadow-xs shrink-0">
                <img 
                  id="sum-item-photo" 
                  src="/assets/scooter_parcel_delivery.jpg" 
                  alt="Item Package Preview" 
                  class="w-full h-full object-cover rounded-lg"
                  onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=300&q=80';"
                />
              </div>

              <div class="text-xs">
                <p class="font-black text-slate-900" id="sum-photo-label">Package Photo Uploaded</p>
                <p class="text-slate-500 text-[11px]">Rider will verify package condition at pickup spot.</p>
              </div>
            </div>
          </div>

          <!-- DELIVERY INSTRUCTIONS -->
          <div class="bg-yellowLight/50 p-3.5 rounded-2xl border border-yellowBorder space-y-1">
            <span class="text-[10px] font-black text-yellowDeep uppercase tracking-wider block">📝 Delivery Instructions</span>
            <p class="text-xs font-bold text-slate-900" id="sum-instructions-text">Please handle with care. Call receiver upon arrival at Ordnance Factory Gate.</p>
          </div>

        </section>

      </div>


      <!-- RIGHT COLUMN: PAYMENT METHOD & FARE BREAKDOWN (5 Cols) -->
      <div class="md:col-span-5 space-y-6">
        
        <!-- PAYMENT METHOD SELECTOR CARD -->
        <section class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span class="text-yellowDark">💳</span>
              <span>Select Payment Method</span>
            </h3>
          </div>

          <div class="space-y-2.5" id="payment-options-group">
            
            <!-- Cash on Pickup (Default) -->
            <label class="flex items-center justify-between p-3.5 rounded-2xl border-2 border-yellowBrand bg-yellowLight cursor-pointer transition-all payment-option-btn active">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment_method" value="Cash on Pickup" checked class="accent-yellowDark w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">Cash on Pickup</span>
                  <span class="text-[10px] font-semibold text-slate-600 block">Pay rider when picking up parcel</span>
                </div>
              </div>
              <span class="text-lg">💵</span>
            </label>

            <!-- UPI / PhonePe / GPay -->
            <label class="flex items-center justify-between p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-50 cursor-pointer transition-all payment-option-btn">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment_method" value="UPI / GPay / PhonePe" class="accent-yellowDark w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">UPI / QR Code</span>
                  <span class="text-[10px] font-semibold text-slate-500 block">Scan & pay rider on delivery</span>
                </div>
              </div>
              <span class="text-lg">📲</span>
            </label>

            <!-- Cash on Delivery (Receiver pays) -->
            <label class="flex items-center justify-between p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-50 cursor-pointer transition-all payment-option-btn">
              <div class="flex items-center gap-3">
                <input type="radio" name="payment_method" value="Cash on Delivery" class="accent-yellowDark w-4 h-4" />
                <div>
                  <span class="text-xs font-black text-slate-900 block">Cash on Delivery</span>
                  <span class="text-[10px] font-semibold text-slate-500 block">Receiver pays fee at drop point</span>
                </div>
              </div>
              <span class="text-lg">🏠</span>
            </label>

          </div>
        </section>

        <!-- FARE BREAKDOWN CARD (GROCERY STYLED) -->
        <section class="bg-gradient-to-br from-yellowLight via-white to-amber-50/50 rounded-3xl p-5 border border-yellowBorder shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-yellowBorder pb-3">
            <h3 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span class="text-yellowDark">💰</span>
              <span>Fare Breakdown</span>
            </h3>
            <span class="text-[10px] font-black bg-yellowBrand/30 text-yellowDeep px-2 py-0.5 rounded-md border border-yellowBorder">MINIMUM ₹30 FEE</span>
          </div>

          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between font-semibold text-slate-600">
              <span>Base Courier Charge</span>
              <span class="font-bold text-slate-900" id="fare-base">₹30</span>
            </div>

            <div class="flex justify-between font-semibold text-slate-600">
              <span>Distance Charge (<span id="fare-dist-km">3.5 km</span>)</span>
              <span class="font-bold text-slate-900" id="fare-dist-cost">₹15</span>
            </div>

            <div class="flex justify-between font-semibold text-slate-600">
              <span>Weight Surcharge</span>
              <span class="font-bold text-slate-900" id="fare-weight-cost">₹0</span>
            </div>

            <div class="flex justify-between font-bold text-emerald-700 pt-1 border-t border-yellowBorder">
              <span>Instant Promo Discount</span>
              <span>-₹5</span>
            </div>

            <div class="flex justify-between items-baseline pt-2 border-t border-slate-300 font-black font-display text-slate-900">
              <span class="text-sm">Total Payable Fee</span>
              <span class="text-2xl text-yellowDeep font-black" id="total-payable-fare">₹40</span>
            </div>
          </div>
        </section>

        <!-- BACK & EDIT ACTION BUTTON -->
        <a href="/parcel" class="w-full py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-black text-xs rounded-2xl flex items-center justify-center gap-2 border border-slate-200 transition-all active:scale-95 shadow-xs">
          <span class="material-symbols-outlined text-base">arrow_back</span>
          <span>Back & Edit Parcel Information</span>
        </a>

      </div>

    </div>

  </main>


  <!-- ==================== DELIVERY PARTNER SEARCHING & ASSIGNED OVERLAY MODAL ==================== -->
  <div id="partner-search-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-300">
    <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl overflow-hidden shadow-2xl space-y-0 border border-slate-100 flex flex-col animate-in fade-in slide-in-from-bottom-6 duration-300">
      
      <!-- PHASE 1: SEARCHING FOR DELIVERY PARTNER -->
      <div id="partner-search-phase" class="p-6 sm:p-8 text-center space-y-6">
        
        <!-- RADAR RIPPLE ANIMATION WITH PACKAGE BIKE ICON -->
        <div class="relative w-28 h-28 mx-auto flex items-center justify-center">
          <div class="absolute inset-0 rounded-full bg-yellowBrand/30 animate-ping"></div>
          <div class="absolute inset-2 rounded-full bg-yellowBrand/40 animate-pulse"></div>
          <div class="relative z-10 w-20 h-20 rounded-full bg-yellowBrand text-slate-950 flex items-center justify-center text-4xl shadow-xl border-2 border-white">
            📦
          </div>
        </div>

        <!-- TEXT STATUS -->
        <div class="space-y-1.5">
          <h3 class="text-xl font-black font-display text-slate-900 animate-pulse">Searching for Delivery Partner...</h3>
          <p class="text-xs font-extrabold text-slate-500">Connecting with active Bhusawal express parcel riders nearby</p>
        </div>

        <!-- METRICS INFO PILLS -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="bg-yellowLight rounded-2xl p-3 border border-yellowBorder text-center">
            <span class="text-[10px] font-black text-yellowDeep uppercase tracking-wider block">Available Partners</span>
            <span class="text-sm font-black text-slate-900">⚡ 5 Active Riders</span>
          </div>
          <div class="bg-yellowLight rounded-2xl p-3 border border-yellowBorder text-center">
            <span class="text-[10px] font-black text-yellowDeep uppercase tracking-wider block">Estimated Arrival</span>
            <span class="text-sm font-black text-slate-900">⏱️ ~5 Mins Pickup</span>
          </div>
        </div>

        <!-- CANCEL SEARCH BUTTON -->
        <button id="btn-cancel-partner-search" type="button" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-black rounded-xl transition-all active:scale-95">
          Cancel Search
        </button>
      </div>


      <!-- PHASE 2: PARTNER ACCEPTS & ASSIGNED (Revealed after 3.5s animation) -->
      <div id="partner-match-phase" class="hidden p-6 sm:p-8 space-y-5 animate-in fade-in zoom-in-95 duration-500">
        
        <!-- SUCCESS BANNER -->
        <div class="bg-emerald-50 text-emerald-800 p-3.5 rounded-2xl border border-emerald-200 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 text-xl animate-bounce">check_circle</span>
            <div>
              <h4 class="text-xs font-black">Delivery Partner Accepted!</h4>
              <p class="text-[10px] font-bold text-emerald-600">Rider is arriving at pickup location in 5 mins</p>
            </div>
          </div>
          <span class="bg-emerald-600 text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase">ASSIGNED</span>
        </div>

        <!-- PARTNER DETAILS CARD -->
        <div class="flex items-center justify-between bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
          <div class="flex items-center gap-3">
            <!-- Partner Photo Avatar -->
            <div class="relative">
              <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=160&q=80" alt="Delivery Partner Vikram Patil" class="w-14 h-14 rounded-2xl object-cover border-2 border-yellowBrand shadow-md" />
              <span class="absolute -bottom-1 -right-1 bg-yellowBrand text-slate-950 w-5 h-5 rounded-full flex items-center justify-center text-[10px] shadow-xs">⚡</span>
            </div>

            <div>
              <div class="flex items-center gap-1.5">
                <h3 class="text-base font-black text-slate-900">Vikram Patil</h3>
                <span class="inline-flex items-center gap-0.5 bg-yellowLight text-yellowDeep text-[9px] font-black px-1.5 py-0.5 rounded border border-yellowBorder" title="Verified Delivery Captain">
                  <span class="material-symbols-outlined text-[11px]">verified</span> Verified Partner
                </span>
              </div>

              <!-- Rating & Deliveries -->
              <div class="flex items-center gap-2 text-xs font-bold text-slate-600 mt-0.5">
                <span class="flex items-center gap-0.5 text-amber-500">
                  ⭐ <span>4.9</span>
                </span>
                <span class="text-slate-300">•</span>
                <span>850+ completed deliveries</span>
              </div>
            </div>
          </div>

          <!-- Vehicle Details Badge -->
          <div class="text-right">
            <span class="bg-yellowBrand text-slate-950 text-xs font-black px-2.5 py-1 rounded-lg border border-yellowDark/20 shadow-2xs block font-mono">
              MH 19 BJ 5921
            </span>
            <span class="text-[10px] text-slate-500 font-bold block mt-0.5">Express Delivery Bike</span>
          </div>
        </div>

        <!-- SAFETY & HANDOVER BADGES -->
        <div class="flex items-center justify-between text-xs font-bold bg-yellowLight/60 p-3 rounded-xl border border-yellowBorder">
          <div class="flex items-center gap-1.5 text-yellowDeep">
            <span class="material-symbols-outlined text-base">verified_user</span>
            <span>Tamper-Proof Box & Live OTP Verification</span>
          </div>
          <span class="bg-white text-emerald-700 text-[10px] font-black px-2 py-0.5 rounded-md border border-emerald-200">
            ✓ Verified Rider
          </span>
        </div>

        <!-- PARCEL SUMMARY DETAILS -->
        <div class="bg-slate-50 rounded-xl p-3 space-y-1.5 text-xs border border-slate-200/80">
          <div class="flex justify-between font-semibold text-slate-600">
            <span>Pickup Spot:</span>
            <span class="font-bold text-slate-900 truncate max-w-[200px]" id="modal-pickup-text">Varangaon Road</span>
          </div>
          <div class="flex justify-between font-semibold text-slate-600">
            <span>Drop Destination:</span>
            <span class="font-bold text-slate-900 truncate max-w-[200px]" id="modal-drop-text">Jamner Road</span>
          </div>
          <div class="flex justify-between font-black text-slate-900 pt-1 border-t border-slate-200">
            <span>Total Delivery Fee:</span>
            <span class="text-yellowDeep text-sm font-black" id="modal-fare-text">₹40</span>
          </div>
        </div>

        <!-- ACTION BUTTONS: CALL, MESSAGE, CANCEL REQUEST -->
        <div class="grid grid-cols-3 gap-2.5 pt-1">
          <!-- Call -->
          <a href="tel:+919876543210" class="py-3 bg-yellowBrand hover:bg-yellowDark text-slate-950 hover:text-white text-xs font-black rounded-xl shadow-md flex items-center justify-center gap-1.5 transition-all active:scale-95">
            <span class="material-symbols-outlined text-base">call</span>
            <span>Call Rider</span>
          </a>

          <!-- Message -->
          <button id="btn-message-partner" type="button" class="py-3 bg-slate-900 hover:bg-slate-800 text-white text-xs font-black rounded-xl shadow-md flex items-center justify-center gap-1.5 transition-all active:scale-95">
            <span class="material-symbols-outlined text-base">chat</span>
            <span>Message</span>
          </button>

          <!-- Cancel Request -->
          <button id="btn-cancel-assigned-partner" type="button" class="py-3 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs font-black rounded-xl transition-all active:scale-95">
            Cancel Request
          </button>
        </div>

      </div>

    </div>
  </div>


  <!-- ==================== LARGE YELLOW "CONFIRM PICKUP REQUEST" BUTTON (FIXED BOTTOM BAR) ==================== -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-4 py-4 shadow-2xl">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      
      <div>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block">Total Delivery Fee</span>
        <div class="flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black font-display text-yellowDeep" id="bar-summary-total">₹40</span>
          <span class="text-xs text-slate-400 line-through font-bold">₹45</span>
        </div>
      </div>

      <!-- LARGE YELLOW "CONFIRM PICKUP REQUEST" BUTTON -->
      <button 
        id="btn-confirm-pickup-request" 
        type="button" 
        class="flex-1 sm:flex-none px-8 sm:px-12 py-4 bg-gradient-to-r from-yellowBrand to-amber-400 text-slate-950 hover:bg-yellowDark text-base font-black rounded-2xl shadow-xl hover:shadow-2xl active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer border border-yellowDark/20"
      >
        <span>Confirm Pickup Request</span>
        <span class="material-symbols-outlined text-xl">check_circle</span>
      </button>

    </div>
  </div>

  <Switcher />


  <!-- ==================== DYNAMIC CLIENT SCRIPT ==================== -->
  <script is:inline>
    (function() {
      // 1. READ PARCEL DRAFT FROM LOCALSTORAGE
      var parcelDraft = null;
      var searchTimer = null;

      try {
        parcelDraft = JSON.parse(localStorage.getItem('bhusawal_parcel_draft') || 'null');
      } catch(e) {}

      // Fallback Sample Data if accessed directly
      if (!parcelDraft) {
        parcelDraft = {
          pickupAddress: 'Varangaon Road, Near Station Square, Bhusawal',
          dropAddress: 'Jamner Road, Near Ordnance Factory Gate, Bhusawal',
          category: 'Documents / Office Papers',
          description: 'Important legal documents in a sealed waterproof pouch.',
          weight: 'Up to 1 kg',
          distance: '3.5 km',
          estTime: '15 - 20 Mins',
          instructions: 'Call receiver on arrival. Handle envelope gently.',
          paymentMethod: 'Cash on Pickup',
          baseFee: 30,
          distFee: 15,
          weightFee: 0,
          total: 40,
          pickupCoords: [21.0455, 75.7893],
          dropCoords: [21.0385, 75.8050]
        };
      }

      // 2. POPULATE SUMMARY FIELDS
      var pAddrEl = document.getElementById('sum-pickup-addr');
      var dAddrEl = document.getElementById('sum-drop-addr');
      var catEl = document.getElementById('sum-category-text');
      var weightEl = document.getElementById('sum-weight-text');
      var descEl = document.getElementById('sum-description-text');
      var instEl = document.getElementById('sum-instructions-text');
      var distTextEl = document.getElementById('summary-distance-text');
      var timeTextEl = document.getElementById('summary-time-text');
      var fareBaseEl = document.getElementById('fare-base');
      var fareDistKmEl = document.getElementById('fare-dist-km');
      var fareDistCostEl = document.getElementById('fare-dist-cost');
      var fareWeightCostEl = document.getElementById('fare-weight-cost');
      var totalFareEl = document.getElementById('total-payable-fare');
      var barTotalEl = document.getElementById('bar-summary-total');

      if (pAddrEl) pAddrEl.textContent = parcelDraft.pickupAddress || 'Varangaon Road, Bhusawal';
      if (dAddrEl) dAddrEl.textContent = parcelDraft.dropAddress || 'Jamner Road, Bhusawal';
      if (catEl) catEl.textContent = parcelDraft.category || 'Documents';
      if (weightEl) weightEl.textContent = parcelDraft.weight || 'Up to 1 kg';
      if (descEl) descEl.textContent = parcelDraft.description || 'General parcel items';
      if (instEl) instEl.textContent = parcelDraft.instructions || 'Handle with care';

      var distVal = parcelDraft.distance || '3.5 km';
      var timeVal = parcelDraft.estTime || '15 - 20 Mins';
      if (distTextEl) distTextEl.textContent = distVal;
      if (timeTextEl) timeTextEl.textContent = timeVal;

      var baseFee = parcelDraft.baseFee || 30;
      var distFee = parcelDraft.distFee || 15;
      var weightFee = parcelDraft.weightFee || 0;
      var totalFee = Math.max(30, (baseFee + distFee + weightFee) - 5);

      if (fareBaseEl) fareBaseEl.textContent = '₹' + baseFee;
      if (fareDistKmEl) fareDistKmEl.textContent = distVal;
      if (fareDistCostEl) fareDistCostEl.textContent = '₹' + distFee;
      if (fareWeightCostEl) fareWeightCostEl.textContent = '₹' + weightFee;
      if (totalFareEl) totalFareEl.textContent = '₹' + totalFee;
      if (barTotalEl) barTotalEl.textContent = '₹' + totalFee;

      // 3. LEAFLET SUMMARY ROUTE MAP
      function initSummaryMap() {
        var mapContainer = document.getElementById('summary-map');
        if (!mapContainer || typeof L === 'undefined') return;

        var pCoords = parcelDraft.pickupCoords || [21.0455, 75.7893];
        var dCoords = parcelDraft.dropCoords || [21.0385, 75.8050];

        var map = L.map('summary-map', { zoomControl: false, scrollWheelZoom: false }).setView([21.0420, 75.7970], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18 }).addTo(map);

        var pickupIcon = L.divIcon({
          className: 'custom-pin-icon',
          html: '<div style="background:#0284C7;color:#FFF;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;box-shadow:0 4px 10px rgba(0,0,0,0.2);">📍</div>',
          iconSize: [30, 30]
        });

        var dropIcon = L.divIcon({
          className: 'custom-pin-icon',
          html: '<div style="background:#0F172A;color:#FFF;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;box-shadow:0 4px 10px rgba(0,0,0,0.2);">🏁</div>',
          iconSize: [30, 30]
        });

        L.marker(pCoords, { icon: pickupIcon }).addTo(map).bindPopup('<b>Pickup Spot</b>');
        L.marker(dCoords, { icon: dropIcon }).addTo(map).bindPopup('<b>Drop Spot</b>');

        var latlngs = [pCoords, [(pCoords[0]+dCoords[0])/2, (pCoords[1]+dCoords[1])/2], dCoords];
        var polyline = L.polyline(latlngs, { color: '#0284C7', weight: 4, dashArray: '6, 6' }).addTo(map);
        map.fitBounds(polyline.getBounds(), { padding: [30, 30] });
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(initSummaryMap, 300);
      } else {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(initSummaryMap, 300); });
      }

      // 4. PAYMENT SELECTION TOGGLE
      var payOptions = document.querySelectorAll('.payment-option-btn');
      var selectedPayment = 'Cash on Pickup';

      payOptions.forEach(function(opt) {
        opt.addEventListener('click', function() {
          payOptions.forEach(function(o) {
            o.classList.remove('border-yellowBrand', 'bg-yellowLight');
            o.classList.add('border-slate-200', 'bg-slate-50');
          });
          opt.classList.add('border-yellowBrand', 'bg-yellowLight');
          opt.classList.remove('border-slate-200', 'bg-slate-50');

          var radio = opt.querySelector('input[type="radio"]');
          if (radio) {
            radio.checked = true;
            selectedPayment = radio.value;
          }
        });
      });

      // 5. SEARCH & PARTNER MATCH OVERLAY SYSTEM
      var partnerModal = document.getElementById('partner-search-modal');
      var searchPhase = document.getElementById('partner-search-phase');
      var matchPhase = document.getElementById('partner-match-phase');
      var confirmBtn = document.getElementById('btn-confirm-pickup-request');
      var cancelSearchBtn = document.getElementById('btn-cancel-partner-search');
      var cancelPartnerBtn = document.getElementById('btn-cancel-assigned-partner');
      var messageBtn = document.getElementById('btn-message-partner');

      if (confirmBtn) {
        confirmBtn.addEventListener('click', function() {
          var orderId = 'PARCEL-BHU-' + Math.floor(100000 + Math.random() * 900000);
          
          var finalOrder = {
            id: orderId,
            type: 'PARCEL',
            category: parcelDraft.category || 'Documents',
            description: parcelDraft.description || '',
            weight: parcelDraft.weight || 'Up to 1 kg',
            pickupAddress: parcelDraft.pickupAddress || '',
            dropAddress: parcelDraft.dropAddress || '',
            distance: parcelDraft.distance || '3.5 km',
            total: totalFee,
            paymentMethod: selectedPayment,
            status: 'Rider Assigned',
            rider: 'Vikram Patil (Express Rider)',
            rating: '4.9 ⭐',
            deliveries: '850+ completed deliveries',
            vehicle: 'Express Delivery Bike (MH 19 BJ 5921)',
            timestamp: new Date().toISOString()
          };

          try {
            localStorage.setItem('bhusawal_active_order', JSON.stringify(finalOrder));
            var orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            orders.unshift(finalOrder);
            localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
            localStorage.removeItem('bhusawal_parcel_draft');
          } catch(e) {}

          // Update Modal Details
          var pTxt = document.getElementById('modal-pickup-text');
          var dTxt = document.getElementById('modal-drop-text');
          var fTxt = document.getElementById('modal-fare-text');
          if (pTxt) pTxt.textContent = parcelDraft.pickupAddress || 'Varangaon Road';
          if (dTxt) dTxt.textContent = parcelDraft.dropAddress || 'Jamner Road';
          if (fTxt) fTxt.textContent = '₹' + totalFee;

          // Open Searching Modal
          if (partnerModal) {
            partnerModal.classList.remove('hidden');
            if (searchPhase) searchPhase.classList.remove('hidden');
            if (matchPhase) matchPhase.classList.add('hidden');
          }

          // Trigger 3.5s Simulated Match Transition Animation
          if (searchTimer) clearTimeout(searchTimer);
          searchTimer = setTimeout(function() {
            if (searchPhase) searchPhase.classList.add('hidden');
            if (matchPhase) {
              matchPhase.classList.remove('hidden');
              matchPhase.classList.add('animate-in', 'fade-in', 'zoom-in-95');
            }
          }, 3500);
        });
      }

      if (cancelSearchBtn) {
        cancelSearchBtn.addEventListener('click', function() {
          if (searchTimer) clearTimeout(searchTimer);
          if (partnerModal) partnerModal.classList.add('hidden');
        });
      }

      if (cancelPartnerBtn) {
        cancelPartnerBtn.addEventListener('click', function() {
          if (confirm('Are you sure you want to cancel this pickup request?')) {
            if (partnerModal) partnerModal.classList.add('hidden');
            alert('Pickup request cancelled.');
          }
        });
      }

      if (messageBtn) {
        messageBtn.addEventListener('click', function() {
          alert('💬 Delivery Partner Vikram Patil: "Hello! I am assigned to collect your parcel. Reaching pickup spot in 5 minutes."');
        });
      }

    })();
  </script>
</body>
</html>
