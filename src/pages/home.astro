      function setupSearchLogic() {
        populateDefaultSections();
        refreshHomeProductButtons();
        refreshHomeWishlistButtons();

        const searchInput = document.getElementById('main-search-input');
        const clearBtn = document.getElementById('clear-universal-search');
        const dropdown = document.getElementById('search-results-dropdown');
        const defaultView = document.getElementById('search-default-view');
        const activeResults = document.getElementById('search-active-results');

        function performUniversalSearch(rawQuery) {
          const query = rawQuery.trim().toLowerCase();

          if (!query) {
            clearBtn?.classList.add('hidden');
            defaultView?.classList.remove('hidden');
            activeResults?.classList.add('hidden');
            renderRecentSearches();
            return;
          }

          clearBtn?.classList.remove('hidden');
          defaultView?.classList.add('hidden');
          activeResults?.classList.remove('hidden');

          const tokens = query.split(/\s+/).filter(Boolean);

          const groceryMatches = [];
          const foodMatches = [];
          const medicineMatches = [];
          const groceryStoreMatches = [];
          const restaurantMatches = [];
          const medicalStoreMatches = [];

          for (let i = 0; i < UNIVERSAL_INDEX.length; i++) {
            const item = UNIVERSAL_INDEX[i];
            let matchesAll = true;

            for (let t = 0; t < tokens.length; t++) {
              if (!item.fullText.includes(tokens[t])) {
                matchesAll = false;
                break;
              }
            }

            if (!matchesAll) continue;

            if (item.type === 'grocery' && groceryMatches.length < 5) groceryMatches.push(item);
            else if (item.type === 'food' && foodMatches.length < 4) foodMatches.push(item);
            else if (item.type === 'medicine' && medicineMatches.length < 4) medicineMatches.push(item);
            else if (item.type === 'grocery_store' && groceryStoreMatches.length < 3) groceryStoreMatches.push(item);
            else if (item.type === 'restaurant' && restaurantMatches.length < 3) restaurantMatches.push(item);
            else if (item.type === 'medical_store' && medicalStoreMatches.length < 3) medicalStoreMatches.push(item);
          }

          let sectionBlocks = [];

          function hl(str) {
            if (!str) return '';
            const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            return str.replace(re, '<span class="search-match-hl">$1</span>');
          }

          // 1. 🛒 GROCERY PRODUCTS SECTION
          if (groceryMatches.length > 0) {
            sectionBlocks.push(`
