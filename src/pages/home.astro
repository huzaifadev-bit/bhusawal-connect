import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read existing catalog database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read catalog at build time", err);
}

const foodJsonPath = path.join(process.cwd(), 'public/food_catalog.json');
let foodCatalog = [];
try {
  foodCatalog = JSON.parse(fs.readFileSync(foodJsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read food catalog at build time", err);
}

// Deduplication helper
function dedupProducts(arr) {
  const seen = new Set();
  return arr.filter(p => {
    const name = (p["Product Name"] || "").trim().toLowerCase();
    if (seen.has(name)) return false;
    seen.add(name);
    return true;
  });
}

// Product sections from catalog
const trendingKws = ['lays', 'pringles', 'kurkure', 'coca', 'pepsi', 'sprite', 'red bull', 'dairy milk', 'kitkat', 'nutella', 'oreo', 'good day', 'maggi', 'nivea', 'dettol'];
let trendingProducts = [];
const seenTrending = new Set();
for (const kw of trendingKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenTrending.has(cleanName)) {
      trendingProducts.push(p);
      seenTrending.add(cleanName);
      if (trendingProducts.length >= 12) break;
    }
  }
  if (trendingProducts.length >= 12) break;
}

