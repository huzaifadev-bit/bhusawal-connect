---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read the database at build-time for static rendering
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
 catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
 console.error("Failed to read grocery catalog at build time", err);
}

// Helper deduplicator
function dedupHome(arr) {
  const seen = new Set();
  return arr.filter(p => {
    const name = (p["Product Name"] || "").trim().toLowerCase();
    if (seen.has(name)) return false;
    seen.add(name);
    return true;
  });
}

// 1. Trending & Hot Sellers
const trendingKws = ['lays', 'pringles', 'kurkure', 'coca', 'pepsi', 'sprite', 'red bull', 'dairy milk', 'kitkat', 'nutella', 'oreo', 'good day', 'maggi', 'durex', 'pedigree', 'nivea', 'dettol'];
let trendingProducts = [];
const seenTrending = new Set();

for (const kw of trendingKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenTrending.has(cleanName)) {
      trendingProducts.push(p);
      seenTrending.add(cleanName);
      if (trendingProducts.length >= 16) break;
    }
  }
  if (trendingProducts.length >= 16) break;
}
if (trendingProducts.length < 16) {
  trendingProducts = dedupHome([...trendingProducts, ...catalog.filter(p => p.Category === 'Snacks & Confectionery' || p.Category === 'Beverages')]).slice(0, 16);
}

// 2. Daily Need Essentials
const dailyKws = ['banana', 'apple', 'tomato', 'onion', 'potato', 'palak', 'spinach', 'milk', 'dahi', 'curd', 'paneer', 'bread', 'atta', 'rice', 'dal', 'oil', 'ghee', 'soap', 'toothpaste'];
let dailyNeedProducts = [];
const seenDaily = new Set();

for (const kw of dailyKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenDaily.has(cleanName)) {
      dailyNeedProducts.push(p);
      seenDaily.add(cleanName);
      if (dailyNeedProducts.length >= 16) break;
    }
  }
  if (dailyNeedProducts.length >= 16) break;
}
if (dailyNeedProducts.length < 16) {
  dailyNeedProducts = dedupHome([...dailyNeedProducts, ...catalog.filter(p => p.Category === 'Fruits & Vegetables' || p.Category === 'Dairy & Breakfast' || p.Category === 'Grocery Staples')]).slice(0, 16);
}
