---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read existing catalog database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read catalog at build time", err);
}

// Deduplication helper
function dedupProducts(arr) {
  const seen = new Set();
  return arr.filter(p => {
    const name = (p["Product Name"] || "").trim().toLowerCase();
    if (seen.has(name)) return false;
    seen.add(name);
    return true;
  });
}

// 1. Trending Products
const trendingKws = ['lays', 'pringles', 'kurkure', 'coca', 'pepsi', 'sprite', 'red bull', 'dairy milk', 'kitkat', 'nutella', 'oreo', 'good day', 'maggi', 'nivea', 'dettol'];
let trendingProducts = [];
const seenTrending = new Set();
for (const kw of trendingKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenTrending.has(cleanName)) {
      trendingProducts.push(p);
      seenTrending.add(cleanName);
      if (trendingProducts.length >= 12) break;
    }
  }
  if (trendingProducts.length >= 12) break;
}

// 2. Popular Products
let popularProducts = dedupProducts(catalog.filter(p => p.Category === 'Snacks & Confectionery' || p.Category === 'Beverages')).slice(0, 12);

// 3. Today's Offers
let offerProducts = dedupProducts(catalog.filter(p => p["Offer Price"] && parseFloat(p["Offer Price"]) < parseFloat(p.MRP))).slice(0, 12);

// 4. Buy Again (Daily Essentials)
let buyAgainProducts = dedupProducts(catalog.filter(p => p.Category === 'Dairy & Breakfast' || p.Category === 'Fruits & Vegetables')).slice(0, 12);

// 5. Recently Ordered
let recentlyOrderedProducts = dedupProducts(catalog.filter(p => p.Category === 'Grocery Staples' || p.Category === 'Home Cleaning & Household')).slice(0, 12);

// Dynamic Categories list
const categoriesList = [
  { name: 'Fruits & Vegetables', icon: '🥬', color: 'from-emerald-500/20 to-teal-500/20' },
  { name: 'Dairy & Breakfast', icon: '🥛', color: 'from-blue-500/20 to-cyan-500/20' },
  { name: 'Grocery Staples', icon: '🌾', color: 'from-yellow-500/20 to-amber-500/20' },
  { name: 'Snacks & Confectionery', icon: '🍿', color: 'from-amber-500/20 to-orange-500/20' },
  { name: 'Beverages', icon: '🥤', color: 'from-rose-500/20 to-pink-500/20' },
  { name: 'Personal Care', icon: '✨', color: 'from-pink-500/20 to-rose-500/20' },
  { name: 'Home Cleaning & Household', icon: '🧹', color: 'from-indigo-500/20 to-blue-500/20' },
  { name: 'Instant & Frozen Foods', icon: '🍜', color: 'from-purple-500/20 to-indigo-500/20' },
];

// Featured Stores Data
const featuredStores = [
  { name: 'Bhusawal Express Store', tag: 'Superstore', rating: '4.9', time: '10-15 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=600&q=80', logo: '🏬', sponsored: true },
  { name: 'Royal Biryani & Caterers', tag: 'Mughlai & Biryani', rating: '4.8', time: '25-30 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=600&q=80', logo: '🍲', sponsored: true },
  { name: 'Shiv Dairy & Sweets', tag: 'Fresh Dairy & Sweets', rating: '4.9', time: '15-20 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=600&q=80', logo: '🥛', sponsored: false },
  { name: "Kwality Wall's Hub", tag: 'Ice Creams & Desserts', rating: '4.7', time: '12-18 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=600&q=80', logo: '🍦', sponsored: false },
];
