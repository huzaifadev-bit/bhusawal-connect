          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-green-100 to-emerald-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-emerald-700 text-lg">shopping_basket</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Daily Needs</h4>
            <p class="text-[10px] font-bold text-emerald-600 mt-0.5 leading-tight">2,699 Master SKUs</p>
          </div>
        </a>

        <!-- 2. Medicine -->
        <a href="/medicines" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-3 overflow-hidden">
