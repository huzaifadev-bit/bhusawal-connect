                <div class="flex flex-wrap justify-center gap-1.5 pt-1">
                  <button class="fallback-tag px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand rounded-xl text-xs font-extrabold transition-all" data-query="Amul Gold Milk">Amul Milk</button>
                  <button class="fallback-tag px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand rounded-xl text-xs font-extrabold transition-all" data-query="Fortune Oil">Fortune Oil</button>
                  <button class="fallback-tag px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand rounded-xl text-xs font-extrabold transition-all" data-query="Chicken Biryani">Chicken Biryani</button>
                  <button class="fallback-tag px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand rounded-xl text-xs font-extrabold transition-all" data-query="Dolo 650">Dolo 650</button>
                  <button class="fallback-tag px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand rounded-xl text-xs font-extrabold transition-all" data-query="Sai Jeevan Super Mall">Sai Jeevan Store</button>
                </div>
              </div>
            `;
          } else {
            activeResults.innerHTML = sectionBlocks.join('');
          }
        }

        // Direct Global Click Event Delegation across Search Overlay
        dropdown?.addEventListener('click', (e) => {
          const itemLink = e.target.closest('.search-item-link');
          if (itemLink) {
            e.preventDefault();
            e.stopPropagation();
            const rawQuery = searchInput?.value.trim();
            if (rawQuery) window.saveRecentSearch(rawQuery);

            const targetUrl = itemLink.dataset.href || itemLink.getAttribute('href');
            if (targetUrl) {
              window.location.href = targetUrl;
            }
          }
        });

        searchInput?.addEventListener('focus', () => {
          dropdown?.classList.remove('hidden');
          if (!searchInput.value.trim()) renderRecentSearches();
        });

        searchInput?.addEventListener('input', (e) => {
          performUniversalSearch(e.target.value);
        });

        searchInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const query = searchInput.value.trim();
            if (query) {
              window.saveRecentSearch(query);
              window.location.href = `/grocery?search=${encodeURIComponent(query)}`;
            }
          }
        });

        clearBtn?.addEventListener('click', () => {
          searchInput.value = '';
          performUniversalSearch('');
        });

        document.addEventListener('click', (e) => {
          const trendingTag = e.target.closest('.universal-trending-tag');
          if (trendingTag) {
            const q = trendingTag.dataset.query;
            if (searchInput) searchInput.value = q;
            performUniversalSearch(q);
            return;
          }

          const recentTag = e.target.closest('.universal-recent-tag');
          if (recentTag) {
            const q = recentTag.dataset.query;
            if (searchInput) searchInput.value = q;
            performUniversalSearch(q);
            return;
          }

          const fallbackTag = e.target.closest('.fallback-tag');
          if (fallbackTag) {
            const q = fallbackTag.dataset.query;
            if (searchInput) searchInput.value = q;
            performUniversalSearch(q);
            return;
          }

          if (!e.target.closest('#main-search-input') && !e.target.closest('#search-results-dropdown')) {
            dropdown?.classList.add('hidden');
          }
        });

        document.getElementById('clear-recent-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          clearRecentSearches();
        });

        // Voice Search Support
        const micBtn = document.getElementById('mic-search-btn');
        if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
          const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
          const recognition = new SpeechRecognition();
          recognition.lang = 'en-IN';
          
          micBtn.onclick = () => {
            micBtn.classList.add('animate-pulse', 'text-red-500');
            recognition.start();
          };

          recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            if (searchInput) searchInput.value = transcript;
            micBtn.classList.remove('animate-pulse', 'text-red-500');
            performUniversalSearch(transcript);
          };

          recognition.onerror = () => {
            micBtn.classList.remove('animate-pulse', 'text-red-500');
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupSearchLogic);
      } else {
        setupSearchLogic();
      }
    })();
  </script>
</body>
</html>
