// Helper to sanitize product IDs and Names
function getField(p, key) {
  const map = {
    id: ['Product ID', 'ProductID', 'id'],
    name: ['Product Name', 'name'],
    brand: ['Brand Name', 'brand'],
    mrp: ['MRP', 'mrp', 'Selling Price', 'sp'],
    sp: ['Selling Price', 'sp', 'MRP', 'mrp'],
    img: ['Product Image URL', 'img', 'image'],
    pack: ['Pack Size', 'pack', 'Unit']
  };
  const keys = map[key] || [key];
  for (const k of keys) {
    if (p[k] !== undefined && p[k] !== '') return p[k];
  }
  return '';
}

