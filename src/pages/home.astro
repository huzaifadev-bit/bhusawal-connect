            <div class="p-4 space-y-2 flex-1 flex flex-col justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-purple-50 text-purpleBrand flex items-center justify-center text-xl shrink-0 border border-purple-100 shadow-xs">
                  {store.logo}
                </div>
                <div>
                  <h4 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">{store.name}</h4>
                  <p class="text-xs font-bold text-slate-400 mt-0.5">{store.tag}</p>
                </div>
              </div>
              <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
                <span class="flex items-center gap-1 text-amber-600">
                  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                  {store.rating} <span class="text-[10px] text-slate-400 font-semibold">({store.count})</span>
                </span>
                <span class="text-purpleBrand font-extrabold">Open Now</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. TRENDING ESSENTIALS CATALOG GRID -->
    <section class="space-y-4 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight">Trending Essentials in Bhusawal</h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top ordered items with 10-Min doorstep delivery</p>
        </div>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">View Store</a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
        {trendingProducts.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id;
          const name = (p["Product Name"] || p.name || '').split(" (Batch")[0];
          const mrp = parseFloat(p.MRP || p.mrp || p["Selling Price"] || p.sp || 50);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const pack = p["Pack Size"] || p.pack || '1 Unit';

          return (
            <div class="bg-white rounded-2xl p-3 border border-slate-100 shadow-xs hover:shadow-lg hover:border-purple-200 transition-all flex flex-col justify-between group">
              <div>
                <div class="w-full aspect-square bg-slate-50 rounded-xl p-1.5 mb-2 flex items-center justify-center border border-slate-100 overflow-hidden">
                  <img loading="lazy" src={img} alt={name} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                </div>
                <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem]">{name}</h4>
                <p class="text-[10px] font-semibold text-slate-400 mt-0.5">{pack}</p>
              </div>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-1 mt-2">
                <span class="text-xs font-black text-slate-900">MRP ₹{mrp}</span>
                <button class="add-home-cart-btn px-2.5 py-1 bg-purple-50 text-purpleBrand hover:bg-purpleBrand hover:text-white border border-purple-200 text-[10px] font-black rounded-xl active:scale-90 transition-all" data-id={id} data-name={name.replace(/"/g, '&quot;')} data-price={mrp} data-img={img}>
                  + ADD
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE GLOBAL SEARCH ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {

      let fullCatalog = [];
      try {
        const res = await fetch('/grocery_catalog.json');
        fullCatalog = await res.json();
      } catch(e) {
        console.error("Failed to load search catalog", e);
      }

      // Sample Stores & Food Datasets for Cross-Domain Search
      const STORES_LIST = [
        { name: 'Bhusawal Express Superstore', tag: 'Supermarket • 25,500+ Items', link: '/grocery', icon: '🏬' },
        { name: 'Royal Biryani & Caterers', tag: 'Mughlai & North Indian', link: '/food', icon: '🍲' },
        { name: 'Modern Pharmacy & Wellness', tag: 'Essential Medicines', link: '/medicines', icon: '💊' },
        { name: 'Shiv Dairy & Sweets', tag: 'Fresh Milk & Paneer', link: '/shops', icon: '🥛' },
        { name: 'Kwality Wall's Ice Cream Hub', tag: 'Ice Creams & Shakes', link: '/shops', icon: '🍦' }
      ];

      const MEDICINES_LIST = [
        { name: 'Paracetamol 500mg Tablet', desc: 'Fever & Pain Relief', price: 15, link: '/medicines' },
        { name: 'Dolo 650mg Anti-Pyretic', desc: 'High Fever Relief', price: 30, link: '/medicines' },
        { name: 'Crocin Pain Relief 650', desc: 'Headache & Body Pain', price: 24, link: '/medicines' },
        { name: 'Gelusil Antacid Syrup (200ml)', desc: 'Acidity & Gas Relief', price: 110, link: '/medicines' },
        { name: 'Vicks Vaporub (50g)', desc: 'Cold & Cough Balm', price: 145, link: '/medicines' },
        { name: 'ORAL REHYDRATION SALTS ORS', desc: 'Dehydration Solution', price: 20, link: '/medicines' }
      ];

      const FOOD_ITEMS_LIST = [
        { name: 'Royal Chicken Dum Biryani', desc: 'Aromatic Basmati Rice & Tender Spiced Chicken', price: 180, link: '/food' },
        { name: 'Paneer Butter Masala', desc: 'Rich Tomato Butter Gravy with Fresh Cottage Cheese', price: 160, link: '/food' },
        { name: 'Butter Tandoori Roti (4 Pcs)', desc: 'Whole Wheat Clay Oven Bread', price: 40, link: '/food' },
        { name: 'Special Bhusawal Banana Halwa', desc: 'Traditional Local Sweet', price: 90, link: '/food' }
      ];

      const CATEGORIES_LIST = [
        { name: 'Fruits & Vegetables', link: '/grocery?category=Fruits%20%26%20Vegetables' },
        { name: 'Dairy & Breakfast', link: '/grocery?category=Dairy%20%26%20Breakfast' },
        { name: 'Grocery Staples', link: '/grocery?category=Grocery%20Staples' },
        { name: 'Snacks & Confectionery', link: '/grocery?category=Snacks%20%26%20Confectionery' },
        { name: 'Beverages', link: '/grocery?category=Beverages' },
        { name: 'Personal Care', link: '/grocery?category=Personal%20Care' }
      ];

      // Recent Searches LocalStorage System
      function getRecentSearches() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_recent_searches') || '[]');
        } catch(e) { return []; }
      }

      function addRecentSearch(query) {
        if (!query || query.trim().length < 2) return;
        let list = getRecentSearches();
        list = list.filter(q => q.toLowerCase() !== query.toLowerCase());
        list.unshift(query);
        if (list.length > 6) list = list.slice(0, 6);
        localStorage.setItem('bhusawal_recent_searches', JSON.stringify(list));
        renderRecentSearches();
      }

      function renderRecentSearches() {
        const box = document.getElementById('recent-searches-box');
        const listEl = document.getElementById('recent-searches-list');
        const recent = getRecentSearches();

        if (!recent || recent.length === 0) {
          box?.classList.add('hidden');
          return;
        }

        box?.classList.remove('hidden');
        listEl.innerHTML = recent.map(q => `
          <button class="recent-search-tag px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-purple-100 text-slate-700 hover:text-purpleBrand text-xs font-bold transition-all flex items-center gap-1" data-query="${q.replace(/"/g, '&quot;')}">
            <span class="material-symbols-outlined text-xs text-slate-400">history</span>
            <span>${q}</span>
          </button>
        `).join('');

        listEl.querySelectorAll('.recent-search-tag').forEach(btn => {
          btn.onclick = () => {
            const query = btn.dataset.query;
            searchInput.value = query;
            performGlobalSearch(query);
          };
        });
      }

      document.getElementById('clear-recent-btn')?.addEventListener('click', () => {
        localStorage.removeItem('bhusawal_recent_searches');
        renderRecentSearches();
      });

      renderRecentSearches();

      // Input & Dropdown Handlers
      const searchInput = document.getElementById('main-search-input');
      const dropdown = document.getElementById('search-results-dropdown');
      const defaultView = document.getElementById('search-default-view');
      const activeResults = document.getElementById('search-active-results');

      searchInput?.addEventListener('focus', () => {
        dropdown?.classList.remove('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('#main-search-input') && !e.target.closest('#search-results-dropdown')) {
          dropdown?.classList.add('hidden');
        }
      });

      // Popular Searches Tags Handler
      document.querySelectorAll('.pop-search-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const query = tag.textContent.trim();
          searchInput.value = query;
          performGlobalSearch(query);
        });
      });

      // Voice Search Support
      const micBtn = document.getElementById('mic-search-btn');
      if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        recognition.lang = 'en-IN';
        
        micBtn.onclick = () => {
          micBtn.classList.add('animate-pulse', 'text-rose-500');
          recognition.start();
        };

        recognition.onresult = (event) => {
          const transcript = event.results[0][0].transcript;
          searchInput.value = transcript;
          micBtn.classList.remove('animate-pulse', 'text-rose-500');
          performGlobalSearch(transcript);
        };

        recognition.onerror = () => {
          micBtn.classList.remove('animate-pulse', 'text-rose-500');
        };
      }

      // Fast Global Search Algorithm across Products, Stores, Medicines, Food, Categories, Brands
      function performGlobalSearch(query) {
        if (!query || query.trim().length === 0) {
          defaultView?.classList.remove('hidden');
          activeResults?.classList.add('hidden');
          return;
        }

        const q = query.trim().toLowerCase();
        addRecentSearch(query.trim());

        defaultView?.classList.add('hidden');
        activeResults?.classList.remove('hidden');

        // 1. Search Stores
        const matchingStores = STORES_LIST.filter(s => s.name.toLowerCase().includes(q) || s.tag.toLowerCase().includes(q));

        // 2. Search Medicines
        const matchingMedicines = MEDICINES_LIST.filter(m => m.name.toLowerCase().includes(q) || m.desc.toLowerCase().includes(q));

        // 3. Search Food
        const matchingFood = FOOD_ITEMS_LIST.filter(f => f.name.toLowerCase().includes(q) || f.desc.toLowerCase().includes(q));

        // 4. Search Categories
        const matchingCategories = CATEGORIES_LIST.filter(c => c.name.toLowerCase().includes(q));

        // 5. Search Products from 25,500+ Database
        const matchingProducts = fullCatalog.filter(p => {
          const name = (p["Product Name"] || '').toLowerCase();
          const brand = (p["Brand Name"] || '').toLowerCase();
          const cat = (p.Category || '').toLowerCase();
          return name.includes(q) || brand.includes(q) || cat.includes(q);
        }).slice(0, 15);

        let html = '';

        // Render Stores Matches
        if (matchingStores.length > 0) {
          html += `
            <div class="py-2">
              <span class="text-[10px] font-black text-purpleBrand uppercase tracking-wider block px-2 mb-1">🏬 Partner Stores</span>
              ${matchingStores.map(s => `
                <a href="${s.link}" class="flex items-center justify-between p-2 hover:bg-purple-50 rounded-2xl transition-all">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">${s.icon}</span>
                    <div>
                      <h4 class="text-xs font-black text-slate-900">${s.name}</h4>
                      <p class="text-[10px] font-bold text-slate-400">${s.tag}</p>
                    </div>
                  </div>
                  <span class="text-xs font-black text-purpleBrand">Visit Store →</span>
                </a>
              `).join('')}
            </div>
          `;
        }

        // Render Medicine Matches
        if (matchingMedicines.length > 0) {
          html += `
            <div class="py-2">
              <span class="text-[10px] font-black text-blue-600 uppercase tracking-wider block px-2 mb-1">💊 Medicines & Healthcare</span>
              ${matchingMedicines.map(m => `
                <a href="/medicines" class="flex items-center justify-between p-2 hover:bg-blue-50 rounded-2xl transition-all">
                  <div>
                    <h4 class="text-xs font-black text-slate-900">${m.name}</h4>
                    <p class="text-[10px] font-bold text-slate-400">${m.desc}</p>
                  </div>
                  <span class="text-xs font-black text-slate-900">MRP ₹${m.price}</span>
                </a>
              `).join('')}
            </div>
          `;
        }

        // Render Food Matches
        if (matchingFood.length > 0) {
          html += `
            <div class="py-2">
              <span class="text-[10px] font-black text-orange-600 uppercase tracking-wider block px-2 mb-1">🍔 Restaurant Food</span>
              ${matchingFood.map(f => `
                <a href="/food" class="flex items-center justify-between p-2 hover:bg-orange-50 rounded-2xl transition-all">
                  <div>
                    <h4 class="text-xs font-black text-slate-900">${f.name}</h4>
                    <p class="text-[10px] font-bold text-slate-400">${f.desc}</p>
                  </div>
                  <span class="text-xs font-black text-slate-900">₹${f.price}</span>
                </a>
              `).join('')}
            </div>
          `;
        }

        // Render Products Matches
        if (matchingProducts.length > 0) {
          html += `
            <div class="py-2">
              <span class="text-[10px] font-black text-emerald-600 uppercase tracking-wider block px-2 mb-1">🛒 Products (${matchingProducts.length} results)</span>
              ${matchingProducts.map(p => {
                const name = (p["Product Name"] || '').split(" (Batch")[0];
                const mrp = parseFloat(p.MRP || p.mrp || p["Selling Price"] || 50);
                const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
                return `
                  <a href="/grocery?search=${encodeURIComponent(name)}" class="flex items-center justify-between p-2 hover:bg-emerald-50 rounded-2xl transition-all">
                    <div class="flex items-center gap-2 min-w-0">
                      <img loading="lazy" src="${img}" alt="${name}" class="w-8 h-8 object-contain rounded-lg bg-slate-50 border p-0.5 shrink-0" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                      <div class="min-w-0">
                        <h4 class="text-xs font-black text-slate-900 truncate">${name}</h4>
                        <p class="text-[10px] font-bold text-slate-400">${p.Category || 'Grocery'}</p>
                      </div>
                    </div>
                    <span class="text-xs font-black text-slate-900 shrink-0">MRP ₹${mrp}</span>
                  </a>
                `;
              }).join('')}
            </div>
          `;
        }

        if (html === '') {
          activeResults.innerHTML = `
            <div class="py-8 text-center space-y-2">
              <span class="material-symbols-outlined text-3xl text-slate-300">search_off</span>
              <p class="text-xs font-bold text-slate-500">No exact matches found for "${query}".</p>
              <a href="/grocery?search=${encodeURIComponent(query)}" class="inline-block px-4 py-2 bg-purpleBrand text-white text-xs font-black rounded-xl shadow-xs">
                Search full 25,500+ Grocery Catalog →
              </a>
            </div>
          `;
        } else {
          activeResults.innerHTML = html;
        }
      }

      searchInput?.addEventListener('input', (e) => {
        performGlobalSearch(e.target.value);
      });

      // Add to Cart Buttons
      document.querySelectorAll('.add-home-cart-btn').forEach(btn => {
        btn.onclick = () => {
          const id = btn.dataset.id;
          const name = btn.dataset.name;
          const price = parseFloat(btn.dataset.price);
          const img = btn.dataset.img;

          let cart = [];
          try {
            cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          } catch(e) {}

          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Home Item' });
          }

          localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
          btn.textContent = '✓ ADDED';
          btn.classList.replace('bg-purple-50', 'bg-emerald-600');
          btn.classList.replace('text-purpleBrand', 'text-white');
          setTimeout(() => {
            btn.textContent = '+ ADD';
            btn.classList.replace('bg-emerald-600', 'bg-purple-50');
            btn.classList.replace('text-white', 'text-purpleBrand');
          }, 1200);
        };
      });

    });
  </script>
</body>
</html>
