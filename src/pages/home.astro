---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read existing catalog database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read catalog at build time", err);
}

// Deduplication helper
function dedupProducts(arr) {
  const seen = new Set();
  return arr.filter(p => {
    const name = (p["Product Name"] || "").trim().toLowerCase();
    if (seen.has(name)) return false;
    seen.add(name);
    return true;
  });
}

// Product sections from catalog
const trendingKws = ['lays', 'pringles', 'kurkure', 'coca', 'pepsi', 'sprite', 'red bull', 'dairy milk', 'kitkat', 'nutella', 'oreo', 'good day', 'maggi', 'nivea', 'dettol'];
let trendingProducts = [];
const seenTrending = new Set();
for (const kw of trendingKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenTrending.has(cleanName)) {
      trendingProducts.push(p);
      seenTrending.add(cleanName);
      if (trendingProducts.length >= 12) break;
    }
  }
  if (trendingProducts.length >= 12) break;
}

// Verified Partner Stores Data
const verifiedPartnerStores = [
  { id: 'express_superstore', name: 'Bhusawal Express Superstore', tag: 'Supermarket • 25,500+ Items', rating: '4.9', count: '1,240+ ratings', time: '10-15 min', cover: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=800&q=80', logo: '🏬' },
  { id: 'royal_biryani', name: 'Royal Biryani & Caterers', tag: 'Mughlai & North Indian', rating: '4.8', count: '850+ ratings', time: '20-25 min', cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80', logo: '🍲' },
  { id: 'modern_pharmacy', name: 'Modern Pharmacy & Wellness', tag: 'Essential Medicines & Healthcare', rating: '4.9', count: '920+ ratings', time: '10-15 min', cover: 'https://images.unsplash.com/photo-1586015555751-63bb77f4322a?auto=format&fit=crop&w=800&q=80', logo: '💊' },
  { id: 'shiv_dairy', name: 'Shiv Dairy & Sweets', tag: 'Fresh Milk, Paneer & Sweets', rating: '4.9', count: '1,500+ ratings', time: '10-15 min', cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80', logo: '🥛' },
  { id: 'kwality_hub', name: "Kwality Wall's Ice Cream Hub", tag: 'Ice Creams & Shakes', rating: '4.7', count: '610+ ratings', time: '12-18 min', cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80', logo: '🍦' }
];
