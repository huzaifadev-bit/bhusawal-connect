      window.location.href = '/';
    }

    // Micro-interactions for scrolling effects
    window.addEventListener('scroll', () => {
      const header = document.querySelector('header');
      if (window.scrollY > 20) {
        header.classList.add('shadow-md');
        header.classList.remove('shadow-sm');
      } else {
        header.classList.add('shadow-sm');
        header.classList.remove('shadow-md');
      }
    });

    // Search bar focus behavior
    const searchInput = document.querySelector('input');
    searchInput.addEventListener('focus', () => {
      searchInput.parentElement.classList.add('scale-[1.02]');
    });
    searchInput.addEventListener('blur', () => {
      searchInput.parentElement.classList.remove('scale-[1.02]');
    });

    // Load full catalog for search
    let fullCatalog = [];
    fetch('/grocery_catalog.json?v=' + new Date().getTime())
     .then(r => r.json())
     .then(data => { fullCatalog = data; })
     .catch(err => console.error('Failed to load catalog', err));

    const allSection = document.getElementById('all-products-grid').closest('section');
    const searchOverlay = document.getElementById('search-results-overlay');
    const searchGrid = document.getElementById('search-results-grid');
    const searchTitle = document.getElementById('search-results-title');

    document.getElementById('btn-clear-search').addEventListener('click', () => {
      searchInput.value = '';
      searchOverlay.classList.add('hidden');
      allSection.classList.remove('hidden');
    });

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      if (query.length > 1 && fullCatalog.length > 0) {
        const matches = fullCatalog.filter(item => {
          const name = (item['Product Name'] || '').toLowerCase();
          const brand = (item['Brand Name'] || '').toLowerCase();
          const cat = (item['Category'] || '').toLowerCase();
          return name.includes(query) || brand.includes(query) || cat.includes(query);
        });
        renderSearchResults(query, matches.slice(0, 40));
      } else if (query.length === 0) {
        searchOverlay.classList.add('hidden');
        allSection.classList.remove('hidden');
      }
    });

    function renderSearchResults(query, products) {
      allSection.classList.add('hidden');
      searchOverlay.classList.remove('hidden');
      searchTitle.textContent = 'Results for "' + query + '" (' + products.length + ')';

      let html = '';
      products.forEach(p => {
        const imgUrl = p['Product Image URL'] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg';
        html += '<div class="bg-white rounded-2xl p-2.5 shadow-[0_8px_16px_rgba(0,0,0,0.02)] flex flex-col group border border-neutral-100/80 hover:border-primary/30 hover:shadow-[0_8px_24px_rgba(0,0,0,0.05)] transition-all duration-300 relative">' +
         '<div class="w-full aspect-square rounded-xl bg-white border border-neutral-100/60 mb-2.5 relative flex items-center justify-center p-2.5 overflow-hidden">' +
          '<img alt="' + (p['Product Name'] || '') + '" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="' + imgUrl + '" onerror="this.onerror=null;this.src=\'/assets/d686bc969706f3bd6cf093f663be9579.jpg\';" />' +
          '<div class="absolute top-2 left-2 bg-[#ffc107] text-neutral-900 text-[7px] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-wider">' + (p.Category || 'Grocery') + '</div>' +
          '<button class="absolute bottom-2 right-2 bg-white border border-primary text-primary px-3 py-1 rounded-lg text-[10px] font-extrabold shadow-md hover:bg-primary/5 active:scale-95 transition-all duration-200 btn-add-search">ADD</button>' +
         '</div>' +
         '<div class="flex-grow flex flex-col justify-between">' +
          '<div>' +
           '<div class="flex items-center flex-wrap gap-1">' +
            '<span class="bg-[#0c831f] text-white px-1.5 py-0.5 rounded text-[10px] font-extrabold selling-price">₹' + p.MRP + '</span>' +
           '</div>' +
           '<h3 class="text-[11px] font-extrabold text-neutral-800 line-clamp-2 h-7.5 mt-1.5 leading-snug">' + p['Product Name'] + '</h3>' +
          '</div>' +
          '<div class="mt-1">' +
           '<p class="text-[9px] text-neutral-500 font-bold">' + (p['Pack Size'] || '1 Unit') + '</p>' +
          '</div>' +
         '</div>' +
        '</div>';
      });
      searchGrid.innerHTML = html;

      // Bind add buttons on search results
      searchGrid.querySelectorAll('.btn-add-search').forEach(btn => bindAddButton(btn));
    }
  
    // Cart interaction logic on Home
    let cart = JSON.parse(localStorage.getItem('bhusawal_cart_grocery') || '{}');
    let cartCount = 0;
    let cartTotal = 0;

    // Floating Cart Bar element
    const cartBar = document.createElement('div');
    cartBar.className = "fixed bottom-24 left-4 right-4 z-50 hidden";
    cartBar.innerHTML = `
      <div class="bg-primary text-on-primary h-16 rounded-2xl flex items-center justify-between px-6 shadow-xl cursor-pointer hover:brightness-110 transition-all">
       <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
         <span class="material-symbols-outlined">shopping_basket</span>
        </div>
        <div>
         <p class="font-bold text-label-md leading-none" id="home-cart-count">0 Items</p>
         <p class="text-[10px] text-white/80" id="home-cart-total">₹0 • Super-App Delivery</p>
        </div>
       </div>
       <div class="flex items-center gap-2">
        <span class="font-bold uppercase tracking-widest text-sm">View Cart</span>
        <span class="material-symbols-outlined">arrow_forward</span>
       </div>
      </div>
    `;
    document.body.appendChild(cartBar);

    function updateCartBar() {
      localStorage.setItem('bhusawal_cart_grocery', JSON.stringify(cart));
      cartCount = Object.values(cart).reduce((sum, item) => sum + item.qty, 0);
      cartTotal = Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
      if (cartCount > 0) {
        cartBar.classList.remove('hidden');
        document.getElementById('home-cart-count').textContent = cartCount + ' Item' + (cartCount > 1 ? 's' : '');
        document.getElementById('home-cart-total').textContent = '₹' + cartTotal + ' • Super-App Delivery';
      } else {
        cartBar.classList.add('hidden');
      }
    }

    function replaceWithStepper(btn, title, price, imgUrl = '', packSize = '', category = '') {
      const btnClass = btn.className;
      const stepper = document.createElement('div');
      stepper.className = 'absolute bottom-2 right-2 flex items-center bg-primary rounded-lg shadow-md overflow-hidden z-10';
      stepper.innerHTML = `
        <button class="qty-minus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">−</button>
        <span class="qty-value w-6 h-7 flex items-center justify-center text-white text-[11px] font-extrabold">1</span>
        <button class="qty-plus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">+</button>
      `;
      btn.replaceWith(stepper);

      // Initialize cart entry
      if (!cart[title]) {
        cart[title] = { price, qty: 1, imgUrl, packSize, category, btnClass };
      }
      updateCartBar();

      const qtyDisplay = stepper.querySelector('.qty-value');
      qtyDisplay.textContent = cart[title].qty;

      stepper.querySelector('.qty-plus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty++;
        qtyDisplay.textContent = cart[title].qty;
        updateCartBar();
      });

      stepper.querySelector('.qty-minus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty--;
        if (cart[title].qty <= 0) {
          delete cart[title];
          // Restore ADD button
          const addBtn = document.createElement('button');
          addBtn.className = btnClass;
          addBtn.textContent = 'ADD';
          stepper.replaceWith(addBtn);
          bindAddButton(addBtn);
        } else {
          qtyDisplay.textContent = cart[title].qty;
        }
        updateCartBar();
      });
    }

    function bindAddButton(btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.group');
        const title = card.querySelector('h3').textContent.trim();
        const priceEl = card.querySelector('.selling-price') || card.querySelector('[class*="bg-[#0c831f]"]');
        const priceText = priceEl ? priceEl.textContent.trim() : '0';
        const price = parseInt(priceText.replace(/[^\d]/g, ''));
        
        const imgEl = card.querySelector('img');
        const imgUrl = imgEl ? imgEl.getAttribute('src') : '';
        
        const packEl = card.querySelector('p.text-neutral-500');
        const packSize = packEl ? packEl.textContent.trim() : '';
        
        const catEl = card.querySelector('.absolute.top-2.left-2');
        const category = catEl ? catEl.textContent.trim() : '';

        replaceWithStepper(btn, title, price, imgUrl, packSize, category);
      });
    }

    function syncUIWithCart() {
      document.querySelectorAll('.group').forEach(card => {
        const titleEl = card.querySelector('h3');
        if (!titleEl) return;
        const title = titleEl.textContent.trim();
        if (cart[title]) {
          const btn = card.querySelector('.btn-add-home-product') || card.querySelector('.btn-add-search');
          if (btn) {
            const priceEl = card.querySelector('.selling-price') || card.querySelector('[class*="bg-[#0c831f]"]');
            const priceText = priceEl ? priceEl.textContent.trim() : '0';
            const price = parseInt(priceText.replace(/[^\d]/g, ''));
            
            const imgEl = card.querySelector('img');
            const imgUrl = imgEl ? imgEl.getAttribute('src') : '';
            
            const packEl = card.querySelector('p.text-neutral-500');
            const packSize = packEl ? packEl.textContent.trim() : '';
            
            const catEl = card.querySelector('.absolute.top-2.left-2');
            const category = catEl ? catEl.textContent.trim() : '';

            replaceWithStepper(btn, title, price, imgUrl, packSize, category);
          }
        }
      });
      updateCartBar();
    }

    // Bind all static ADD buttons and sync UI
    document.querySelectorAll('.btn-add-home-product').forEach(btn => bindAddButton(btn));
    syncUIWithCart();

    cartBar.addEventListener('click', () => {
      if (cartCount > 0) {
        window.location.href = '/billing';
      }
    });
 </script>
  <Switcher />
  <script src="/assets/zepto_search.js" defer></script>

<script>
  document.addEventListener('click', (e) => {
    const card = e.target.closest('.group');
    if (card && !e.target.closest('button') && !e.target.closest('a')) {
      const titleEl = card.querySelector('h3, h4');
      if (titleEl) {
        const title = titleEl.textContent.trim();
        window.location.href = '/product?name=' + encodeURIComponent(title);
      }
    }
  });
</script>

