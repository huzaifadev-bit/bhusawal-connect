              <span class="material-symbols-outlined text-amber-800 text-lg">two_wheeler</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Bike Ride</h4>
            <p class="text-[10px] font-bold text-amber-600 mt-0.5 leading-tight">Quick City Commute</p>
          </div>
        </a>

        <!-- 5. Parcel Delivery -->
        <a href="/parcel" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-orange-50 to-red-100 flex items-center justify-center p-3 overflow-hidden">
