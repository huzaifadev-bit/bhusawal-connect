---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read existing catalog database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read catalog at build time", err);
}

// Deduplication helper
function dedupProducts(arr) {
  const seen = new Set();
  return arr.filter(p => {
    const name = (p["Product Name"] || "").trim().toLowerCase();
    if (seen.has(name)) return false;
    seen.add(name);
    return true;
  });
}

// 1. Trending Products
const trendingKws = ['lays', 'pringles', 'kurkure', 'coca', 'pepsi', 'sprite', 'red bull', 'dairy milk', 'kitkat', 'nutella', 'oreo', 'good day', 'maggi', 'nivea', 'dettol'];
let trendingProducts = [];
const seenTrending = new Set();
for (const kw of trendingKws) {
  const matches = catalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(kw));
  for (const p of matches) {
    const cleanName = (p["Product Name"] || "").split(" (Batch")[0];
    if (!seenTrending.has(cleanName)) {
      trendingProducts.push(p);
      seenTrending.add(cleanName);
      if (trendingProducts.length >= 12) break;
    }
  }
  if (trendingProducts.length >= 12) break;
}

// 2. Popular Products
let popularProducts = dedupProducts(catalog.filter(p => p.Category === 'Snacks & Confectionery' || p.Category === 'Beverages')).slice(0, 12);

// 3. Today's Offers
let offerProducts = dedupProducts(catalog.filter(p => p["Offer Price"] && parseFloat(p["Offer Price"]) < parseFloat(p.MRP))).slice(0, 12);

// 4. Buy Again (Daily Essentials)
let buyAgainProducts = dedupProducts(catalog.filter(p => p.Category === 'Dairy & Breakfast' || p.Category === 'Fruits & Vegetables')).slice(0, 12);

// 5. Recently Ordered
let recentlyOrderedProducts = dedupProducts(catalog.filter(p => p.Category === 'Grocery Staples' || p.Category === 'Household Care')).slice(0, 12);

// Dynamic Categories list
const categoriesList = [
  { name: 'Fruits & Vegetables', icon: '🥬', color: 'from-emerald-500/20 to-teal-500/20' },
  { name: 'Dairy & Breakfast', icon: '🥛', color: 'from-blue-500/20 to-cyan-500/20' },
  { name: 'Snacks & Confectionery', icon: '🍿', color: 'from-amber-500/20 to-orange-500/20' },
  { name: 'Beverages', icon: '🥤', color: 'from-rose-500/20 to-pink-500/20' },
  { name: 'Meat & Seafood', icon: '🍗', color: 'from-red-500/20 to-rose-500/20' },
  { name: 'Bakery & Biscuits', icon: '🍞', color: 'from-yellow-500/20 to-amber-500/20' },
  { name: 'Instant & Frozen', icon: '🍜', color: 'from-purple-500/20 to-indigo-500/20' },
  { name: 'Household Care', icon: '🧹', color: 'from-indigo-500/20 to-blue-500/20' },
];

// Featured Stores Data
const featuredStores = [
  { name: 'Bhusawal Express Store', tag: 'Superstore', rating: '4.9', time: '10-15 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=600&q=80', logo: '🏬', sponsored: true },
  { name: 'Royal Biryani & Caterers', tag: 'Mughlai & Biryani', rating: '4.8', time: '25-30 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=600&q=80', logo: '🍲', sponsored: true },
  { name: 'Shiv Dairy & Sweets', tag: 'Fresh Dairy & Sweets', rating: '4.9', time: '15-20 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=600&q=80', logo: '🥛', sponsored: false },
  { name: "Kwality Wall's Hub", tag: 'Ice Creams & Desserts', rating: '4.7', time: '12-18 min', status: 'Open Now', cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=600&q=80', logo: '🍦', sponsored: false },
];
---

<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Super-App</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .glass-card { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.6); }
  </style>
</head>

<body class="pb-24 max-w-7xl mx-auto min-h-screen text-slate-800">

  <!-- 1. TOP HEADER (LOCATION & PROFILE) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3 shadow-sm flex items-center justify-between">
    <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="header-location-btn">
      <div class="w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold">
        <span class="material-symbols-outlined text-xl">location_on</span>
      </div>
      <div>
        <div class="flex items-center gap-1">
          <span class="text-xs font-black text-purpleBrand uppercase tracking-wider">Delivery in 10-15 Mins</span>
          <span class="material-symbols-outlined text-sm text-purpleBrand">expand_more</span>
        </div>
        <p class="text-xs font-bold text-slate-700 truncate max-w-[220px] sm:max-w-xs" id="header-address-text">
          Home - Varangaon Road, Bhusawal
        </p>
      </div>
    </div>

    <a href="/profile" class="w-10 h-10 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold shadow-md hover:scale-105 active:scale-95 transition-all">
      <span class="material-symbols-outlined">person</span>
    </a>
  </header>

  <main class="px-4 py-4 space-y-6">

    <!-- 2. STICKY SEARCH BAR WITH AUTOCOMPLETE -->
    <div class="relative z-40">
      <div class="flex items-center gap-2 bg-slate-100 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="main-search-input" placeholder="Search 'Milk', 'Biryani', 'Lays', 'Fruits'..." class="w-full bg-transparent outline-none text-sm font-medium text-slate-800 placeholder-slate-400" autocomplete="off" />
        <span class="material-symbols-outlined text-purpleBrand cursor-pointer">mic</span>
      </div>

      <!-- Live Search Autocomplete Dropdown -->
      <div id="search-results-dropdown" class="hidden absolute top-14 left-0 right-0 bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden max-h-96 overflow-y-auto z-50">
        <div class="p-2 divide-y divide-slate-100" id="search-dropdown-list">
          <!-- Results dynamically populated -->
        </div>
      </div>
    </div>

    <!-- 3. HERO PROMO CAROUSEL -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-700 via-purple-600 to-indigo-700 text-white p-6 shadow-xl shadow-purple-900/10">
      <div class="relative z-10 max-w-sm">
        <span class="px-3 py-1 bg-amber-400 text-slate-900 text-[11px] font-black uppercase tracking-wider rounded-full inline-block mb-3">SUPER-APP EXCLUSIVE</span>
        <h2 class="text-2xl font-black font-display leading-tight mb-2">Bhusawal Express Grocery & Food</h2>
        <p class="text-xs text-purple-100 mb-4">Get groceries, fresh milk, hot food & medicines delivered in under 15 mins!</p>
        <a href="/grocery" class="inline-flex items-center gap-2 bg-white text-purpleBrand font-extrabold text-xs px-5 py-2.5 rounded-xl shadow-md hover:bg-purple-50 active:scale-95 transition-all">
          <span>Explore Grocery</span>
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
      <div class="absolute -right-6 -bottom-8 opacity-20 text-9xl select-none">🛍️</div>
    </div>

    <!-- 4. SERVICES GRID (6 KEY SERVICES) -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Our Services</h3>
        <span class="text-xs font-bold text-purpleBrand uppercase tracking-wider">Bhusawal Local</span>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
        
        <a href="/grocery" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-emerald-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">🛒</div>
          <span class="text-xs font-extrabold text-slate-800">Grocery</span>
          <span class="text-[10px] text-emerald-600 font-bold">10-15 Min</span>
        </a>

        <a href="/food" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-orange-50 to-amber-50 border border-orange-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-orange-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">🍔</div>
          <span class="text-xs font-extrabold text-slate-800">Food</span>
          <span class="text-[10px] text-orange-600 font-bold">Hot Meals</span>
        </a>

        <a href="/medicines" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-blue-50 to-cyan-50 border border-blue-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-blue-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">💊</div>
          <span class="text-xs font-extrabold text-slate-800">Medicine</span>
          <span class="text-[10px] text-blue-600 font-bold">Pharmacy</span>
        </a>

        <a href="/auto" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-amber-50 to-yellow-50 border border-amber-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-amber-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">🛺</div>
          <span class="text-xs font-extrabold text-slate-800">Auto</span>
          <span class="text-[10px] text-amber-600 font-bold">City Rides</span>
        </a>

        <a href="/parcel" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-purple-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">📦</div>
          <span class="text-xs font-extrabold text-slate-800">Parcel</span>
          <span class="text-[10px] text-purple-600 font-bold">Pickup/Drop</span>
        </a>

        <a href="/shops" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-gradient-to-br from-rose-50 to-pink-50 border border-rose-100 hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all group">
          <div class="w-12 h-12 rounded-full bg-rose-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform mb-2">🏪</div>
          <span class="text-xs font-extrabold text-slate-800">Shops</span>
          <span class="text-[10px] text-rose-600 font-bold">Local Market</span>
        </a>

      </div>
    </section>

    <!-- 5. FEATURED PARTNER STORES -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Featured Partner Stores</h3>
        <a href="/shops" class="text-xs font-bold text-purpleBrand hover:underline">View All</a>
      </div>
      <div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
        {featuredStores.map(store => (
          <a href="/shops" class="flex-shrink-0 w-64 bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow group">
            <div class="h-28 relative overflow-hidden">
              <img src={store.cover} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              {store.sponsored && (
                <span class="absolute top-2 left-2 bg-slate-900/80 text-white text-[10px] font-black px-2 py-0.5 rounded-full uppercase">Sponsored</span>
              )}
              <span class="absolute bottom-2 right-2 bg-white/90 backdrop-blur-md text-slate-800 text-[10px] font-black px-2 py-0.5 rounded-full">⚡ {store.time}</span>
            </div>
            <div class="p-3 flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-xl flex-shrink-0 border border-purple-100">
                {store.logo}
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-black text-slate-900 truncate">{store.name}</h4>
                <p class="text-[11px] text-slate-500 font-medium truncate">{store.tag}</p>
                <div class="flex items-center gap-2 mt-1 text-[11px] font-bold text-slate-700">
                  <span class="text-emerald-600">★ {store.rating}</span>
                  <span>•</span>
                  <span class="text-slate-400">{store.status}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. DYNAMIC CATEGORIES LIST -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Explore Categories</h3>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">All Categories</a>
      </div>
      <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
        {categoriesList.map(cat => (
          <a href={`/grocery?category=${encodeURIComponent(cat.name)}`} class="flex flex-col items-center p-2 rounded-2xl bg-white border border-slate-100 hover:border-purple-200 active:scale-95 transition-all text-center group">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${cat.color} flex items-center justify-center text-2xl mb-1 group-hover:scale-110 transition-transform`}>
              {cat.icon}
            </div>
            <span class="text-[11px] font-extrabold text-slate-700 leading-tight line-clamp-2">{cat.name}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. 🔥 TRENDING PRODUCTS CAROUSEL -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🔥</span>
          <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Trending Products</h3>
        </div>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">See All</a>
      </div>
      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        {trendingProducts.map(p => (
          <div class="flex-shrink-0 w-36 sm:w-44 bg-white rounded-2xl border border-slate-100 p-2.5 shadow-sm hover:shadow-md transition-shadow relative flex flex-col justify-between">
            {parseFloat(p.MRP) > parseFloat(p["Offer Price"]) && (
              <span class="absolute top-2 left-2 bg-purpleBrand text-white text-[9px] font-black px-1.5 py-0.5 rounded-full z-10">
                {Math.round(((parseFloat(p.MRP) - parseFloat(p["Offer Price"])) / parseFloat(p.MRP)) * 100)}% OFF
              </span>
            )}
            <div class="h-28 w-full flex items-center justify-center mb-2 overflow-hidden rounded-xl bg-slate-50">
              <img src={p["Image URL"]} alt={p["Product Name"]} class="max-h-full max-w-full object-contain p-1" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider truncate">{p.Category}</p>
              <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 h-8 leading-tight mb-1">{p["Product Name"]}</h4>
              <p class="text-[10px] text-slate-500 font-bold mb-2">{p.Unit || '1 Pack'}</p>
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-black text-slate-900">₹{p["Offer Price"]}</span>
                  {parseFloat(p.MRP) > parseFloat(p["Offer Price"]) && (
                    <span class="text-[10px] text-slate-400 line-through ml-1">₹{p.MRP}</span>
                  )}
                </div>
                <button class="add-to-cart-btn px-2.5 py-1 bg-purpleBrand text-white text-xs font-black rounded-lg shadow-sm hover:bg-purpleDark active:scale-95 transition-all" data-id={p.id} data-name={p["Product Name"]} data-price={p["Offer Price"]} data-img={p["Image URL"]}>
                  ADD
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. ⭐ POPULAR PRODUCTS CAROUSEL -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">⭐</span>
          <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Popular Products</h3>
        </div>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">See All</a>
      </div>
      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        {popularProducts.map(p => (
          <div class="flex-shrink-0 w-36 sm:w-44 bg-white rounded-2xl border border-slate-100 p-2.5 shadow-sm hover:shadow-md transition-shadow relative flex flex-col justify-between">
            <div class="h-28 w-full flex items-center justify-center mb-2 overflow-hidden rounded-xl bg-slate-50">
              <img src={p["Image URL"]} alt={p["Product Name"]} class="max-h-full max-w-full object-contain p-1" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
            </div>
            <div>
              <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 h-8 leading-tight mb-1">{p["Product Name"]}</h4>
              <p class="text-[10px] text-slate-500 font-bold mb-2">{p.Unit || '1 Pack'}</p>
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-black text-slate-900">₹{p["Offer Price"]}</span>
                  {parseFloat(p.MRP) > parseFloat(p["Offer Price"]) && (
                    <span class="text-[10px] text-slate-400 line-through ml-1">₹{p.MRP}</span>
                  )}
                </div>
                <button class="add-to-cart-btn px-2.5 py-1 bg-purpleBrand text-white text-xs font-black rounded-lg shadow-sm hover:bg-purpleDark active:scale-95 transition-all" data-id={p.id} data-name={p["Product Name"]} data-price={p["Offer Price"]} data-img={p["Image URL"]}>
                  ADD
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 9. ⚡ TODAY'S OFFERS -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">⚡</span>
          <h3 class="text-lg font-black font-display text-slate-900 tracking-tight">Today's Deals</h3>
        </div>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">View Offers</a>
      </div>
      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        {offerProducts.map(p => (
          <div class="flex-shrink-0 w-36 sm:w-44 bg-white rounded-2xl border border-slate-100 p-2.5 shadow-sm hover:shadow-md transition-shadow relative flex flex-col justify-between">
            <span class="absolute top-2 left-2 bg-emerald-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full z-10">
              DEAL
            </span>
            <div class="h-28 w-full flex items-center justify-center mb-2 overflow-hidden rounded-xl bg-slate-50">
              <img src={p["Image URL"]} alt={p["Product Name"]} class="max-h-full max-w-full object-contain p-1" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
            </div>
            <div>
              <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 h-8 leading-tight mb-1">{p["Product Name"]}</h4>
              <p class="text-[10px] text-slate-500 font-bold mb-2">{p.Unit || '1 Pack'}</p>
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-black text-slate-900">₹{p["Offer Price"]}</span>
                  <span class="text-[10px] text-slate-400 line-through ml-1">₹{p.MRP}</span>
                </div>
                <button class="add-to-cart-btn px-2.5 py-1 bg-purpleBrand text-white text-xs font-black rounded-lg shadow-sm hover:bg-purpleDark active:scale-95 transition-all" data-id={p.id} data-name={p["Product Name"]} data-price={p["Offer Price"]} data-img={p["Image URL"]}>
                  ADD
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. 🔄 BUY AGAIN & 11. 🕒 RECENTLY ORDERED -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Buy Again -->
      <div class="bg-white rounded-3xl p-4 border border-slate-100 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-xl">🔄</span>
            <h3 class="text-base font-black font-display text-slate-900">Buy Again</h3>
          </div>
          <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">More</a>
        </div>
        <div class="grid grid-cols-3 gap-2">
          {buyAgainProducts.slice(0, 3).map(p => (
            <div class="bg-slate-50 rounded-xl p-2 flex flex-col justify-between">
              <img src={p["Image URL"]} alt={p["Product Name"]} class="h-16 w-full object-contain mb-1" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <h5 class="text-[10px] font-bold text-slate-800 truncate">{p["Product Name"]}</h5>
              <div class="flex items-center justify-between mt-1">
                <span class="text-[10px] font-black text-slate-900">₹{p["Offer Price"]}</span>
                <button class="add-to-cart-btn w-5 h-5 bg-purpleBrand text-white rounded-md flex items-center justify-center text-xs font-bold" data-id={p.id} data-name={p["Product Name"]} data-price={p["Offer Price"]} data-img={p["Image URL"]}>+</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Recently Ordered -->
      <div class="bg-white rounded-3xl p-4 border border-slate-100 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-xl">🕒</span>
            <h3 class="text-base font-black font-display text-slate-900">Recently Ordered</h3>
          </div>
          <a href="/orders" class="text-xs font-bold text-purpleBrand hover:underline">History</a>
        </div>
        <div class="grid grid-cols-3 gap-2">
          {recentlyOrderedProducts.slice(0, 3).map(p => (
            <div class="bg-slate-50 rounded-xl p-2 flex flex-col justify-between">
              <img src={p["Image URL"]} alt={p["Product Name"]} class="h-16 w-full object-contain mb-1" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <h5 class="text-[10px] font-bold text-slate-800 truncate">{p["Product Name"]}</h5>
              <div class="flex items-center justify-between mt-1">
                <span class="text-[10px] font-black text-slate-900">₹{p["Offer Price"]}</span>
                <button class="add-to-cart-btn w-5 h-5 bg-purpleBrand text-white rounded-md flex items-center justify-center text-xs font-bold" data-id={p.id} data-name={p["Product Name"]} data-price={p["Offer Price"]} data-img={p["Image URL"]}>+</button>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </main>

  <!-- 12. BOTTOM NAVIGATION BAR -->
  <nav class="fixed bottom-0 left-0 right-0 max-w-7xl mx-auto bg-white/95 backdrop-blur-lg border-t border-slate-200/80 px-6 py-2 flex items-center justify-between z-50 shadow-2xl">
    
    <a href="/home" class="flex flex-col items-center gap-0.5 text-purpleBrand font-bold">
      <span class="material-symbols-outlined text-2xl">home</span>
      <span class="text-[10px]">Home</span>
    </a>

    <a href="/grocery" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors font-medium">
      <span class="material-symbols-outlined text-2xl">shopping_basket</span>
      <span class="text-[10px]">Grocery</span>
    </a>

    <a href="/shops" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors font-medium">
      <span class="material-symbols-outlined text-2xl">storefront</span>
      <span class="text-[10px]">Shops</span>
    </a>

    <a href="/orders" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors font-medium">
      <span class="material-symbols-outlined text-2xl">receipt_long</span>
      <span class="text-[10px]">Orders</span>
    </a>

    <a href="/profile" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors font-medium">
      <span class="material-symbols-outlined text-2xl">person</span>
      <span class="text-[10px]">Profile</span>
    </a>

  </nav>

  <!-- FLOATING CART BAR (IF ITEMS IN CART) -->
  <div id="floating-cart-bar" class="hidden fixed bottom-16 left-4 right-4 max-w-xl mx-auto bg-purpleBrand text-white p-3 rounded-2xl shadow-xl flex items-center justify-between z-50">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center font-black text-sm" id="cart-count-badge">
        0
      </div>
      <div>
        <p class="text-xs font-black" id="cart-total-text">₹0</p>
        <p class="text-[10px] text-purple-200">View items in basket</p>
      </div>
    </div>
    <a href="/billing" class="bg-white text-purpleBrand font-extrabold text-xs px-4 py-2 rounded-xl flex items-center gap-1 shadow-md hover:bg-purple-50 active:scale-95 transition-all">
      <span>Checkout</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <Switcher />

  <!-- SCRIPT FOR CART & LIVE SEARCH ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Cart Management & Floating Bar
      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const totalText = document.getElementById('cart-total-text');

          if (cart.length > 0) {
            const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
            const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

            if (countBadge) countBadge.textContent = totalQty;
            if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);
            if (bar) bar.classList.remove('hidden');
          } else {
            if (bar) bar.classList.add('hidden');
          }
        } catch(e) {}
      }

      updateCartBar();

      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const id = btn.dataset.id;
          const name = btn.dataset.name;
          const price = btn.dataset.price;
          const img = btn.dataset.img;

          let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({ id, name, price, image: img, quantity: 1 });
          }
          localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
          updateCartBar();

          btn.textContent = 'ADDED!';
          btn.classList.replace('bg-purpleBrand', 'bg-emerald-600');
          setTimeout(() => {
            btn.textContent = 'ADD';
            btn.classList.replace('bg-emerald-600', 'bg-purpleBrand');
          }, 1500);
        });
      });

      // 2. Live Search Dropdown Logic
      const searchInput = document.getElementById('main-search-input');
      const dropdown = document.getElementById('search-results-dropdown');
      const dropdownList = document.getElementById('search-dropdown-list');

      if (searchInput && dropdown && dropdownList) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.trim().toLowerCase();
          if (query.length < 2) {
            dropdown.classList.add('hidden');
            return;
          }

          dropdownList.innerHTML = `
            <a href="/grocery?search=${encodeURIComponent(query)}" class="flex items-center gap-3 p-3 hover:bg-slate-50 transition-colors">
              <span class="material-symbols-outlined text-purpleBrand">search</span>
              <div>
                <p class="text-xs font-extrabold text-slate-800">Search for "${query}"</p>
                <p class="text-[10px] text-slate-400">Search across 25,000+ groceries & daily needs</p>
              </div>
            </a>
          `;
          dropdown.classList.remove('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      // Address Header Click
      document.getElementById('header-location-btn')?.addEventListener('click', () => {
        window.location.href = '/profile';
      });
    });
  </script>
</body>
</html>
