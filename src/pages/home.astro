                        <div class="min-w-0 flex-1">
                          <h4 class="text-xs font-black text-slate-900 truncate leading-tight">${hl(p.name)}</h4>
                          <p class="text-[10px] font-semibold text-slate-400 truncate">${hl(p.brand)} • ${p.cat}</p>
                        </div>
                      </div>
                      <span class="text-xs font-black text-slate-900 shrink-0">₹${p.price}</span>
                    </a>
                  `).join('')}
                </div>
              </div>
