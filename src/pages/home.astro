  <!-- ==================== UNIVERSAL SEARCH & CLIENT SCRIPTS ==================== -->
  <script is:inline define:vars={{ serverGroceryCatalog: catalog, serverFoodCatalog: foodCatalog }}>
    // Expose Recent Search helper globally
    const RECENT_KEY = 'bhusawal_universal_recent_searches';
    window.saveRecentSearch = function(term) {
      if (!term || term.trim().length < 2) return;
      let list = [];
      try { list = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) {}
      const clean = term.trim();
      list = list.filter(item => item.toLowerCase() !== clean.toLowerCase());
      list.unshift(clean);
      if (list.length > 8) list = list.slice(0, 8);
      try { localStorage.setItem(RECENT_KEY, JSON.stringify(list)); } catch(e) {}
    };

    (function initHomepageSystem() {
      const groceryCatalog = serverGroceryCatalog || [];
      const foodCatalog = serverFoodCatalog || [];

      // Desktop Carousel Scrolling Controls
      const track = document.getElementById('sponsored-carousel-track');
      document.getElementById('sponsored-prev-btn')?.addEventListener('click', () => {
        track?.scrollBy({ left: -320, behavior: 'smooth' });
      });
      document.getElementById('sponsored-next-btn')?.addEventListener('click', () => {
        track?.scrollBy({ left: 320, behavior: 'smooth' });
      });

      // Cart Storage Helpers
      function getCart() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); } catch(e) { return []; }
      }
      function saveCart(cart) { localStorage.setItem('bhusawal_cart', JSON.stringify(cart)); }

      function addToCart(id, name, price, img) {
        let cart = getCart();
        const existing = cart.find(i => i.id === id);
        if (existing) existing.quantity = (existing.quantity || 1) + 1;
        else cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Home Item' });
        saveCart(cart);
        refreshHomeProductButtons();
      }

      function changeQty(id, delta) {
        let cart = getCart();
        const idx = cart.findIndex(i => i.id === id);
        if (idx > -1) {
          cart[idx].quantity = (cart[idx].quantity || 1) + delta;
          if (cart[idx].quantity <= 0) cart.splice(idx, 1);
        }
        saveCart(cart);
        refreshHomeProductButtons();
      }

      // Wishlist Helpers
      const WISHLIST_KEY = 'bhusawal_wishlist';
      function getWishlist() {
        try { return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]'); } catch(e) { return []; }
      }
      function toggleWishlist(id, name, price, img, brand, pack) {
        let list = getWishlist();
        const idx = list.findIndex(i => (i.id || i["Product ID"]) === id);
        if (idx > -1) list.splice(idx, 1);
        else list.push({ id, name, price, mrp: price, image: img, brand, pack, cat: 'Grocery' });
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
        refreshHomeWishlistButtons();
      }

      function refreshHomeWishlistButtons() {
        const wishlist = getWishlist();
        const wishIds = new Set(wishlist.map(i => i.id || i["Product ID"]));

        document.querySelectorAll('.home-wishlist-btn').forEach(btn => {
          const id = btn.dataset.id;
          const isW = wishIds.has(id);
          const icon = btn.querySelector('.material-symbols-outlined');
          if (isW) {
            btn.classList.add('text-red-500', 'bg-red-50');
            btn.classList.remove('text-slate-400');
            if (icon) icon.style.fontVariationSettings = "'FILL' 1";
          } else {
            btn.classList.remove('text-red-500', 'bg-red-50');
            btn.classList.add('text-slate-400');
            if (icon) icon.style.fontVariationSettings = "'FILL' 0";
          }
        });
      }

      function refreshHomeProductButtons() {
        const cart = getCart();
        document.querySelectorAll('.home-cart-action-area').forEach(area => {
          if (!area.dataset.originalHtml) {
            area.dataset.originalHtml = area.innerHTML;
          }
          const card = area.closest('[data-product-id]');
          if (!card) return;
          const id = card.dataset.productId;
          const btn = area.querySelector('[data-name]');
          let name = '', price = 0, img = '';
          if (btn) { name = btn.dataset.name; price = parseFloat(btn.dataset.price || 0); img = btn.dataset.img; }

          const cartItem = cart.find(i => i.id === id);
          const qty = cartItem ? (cartItem.quantity || 1) : 0;

          if (qty > 0) {
            area.innerHTML = `<div class="flex items-center bg-purpleBrand text-white font-extrabold text-[10px] rounded-lg overflow-hidden shadow-2xs">
              <button class="qty-btn px-2 py-1 hover:bg-purpleDark active:scale-90" data-action="minus" data-id="${id}">−</button>
              <span class="px-1 font-black text-center min-w-[1rem]">${qty}</span>
              <button class="qty-btn px-2 py-1 hover:bg-purpleDark active:scale-90" data-action="plus" data-id="${id}" data-name="${name}" data-price="${price}" data-img="${img}">+</button>
            </div>`;
          } else if (area.dataset.originalHtml) {
            area.innerHTML = area.dataset.originalHtml;
          }
        });
      }

      // Event Listeners for Add Buttons & Wishlist
      document.body.addEventListener('click', (e) => {
        const addBtn = e.target.closest('.home-add-btn');
        if (addBtn) {
          e.stopPropagation();
          addToCart(addBtn.dataset.id, addBtn.dataset.name, parseFloat(addBtn.dataset.price), addBtn.dataset.img);
          return;
        }

        const qtyBtn = e.target.closest('.qty-btn');
        if (qtyBtn) {
          e.stopPropagation();
          if (qtyBtn.dataset.action === 'plus') {
            addToCart(qtyBtn.dataset.id, qtyBtn.dataset.name, parseFloat(qtyBtn.dataset.price), qtyBtn.dataset.img);
          } else {
            changeQty(qtyBtn.dataset.id, -1);
          }
          return;
        }

        const wishBtn = e.target.closest('.home-wishlist-btn');
        if (wishBtn) {
          e.stopPropagation();
          toggleWishlist(
            wishBtn.dataset.id,
            wishBtn.dataset.name,
            parseFloat(wishBtn.dataset.price),
            wishBtn.dataset.img,
            wishBtn.dataset.brand,
            wishBtn.dataset.pack
          );
          return;
        }
      });

      // Medicines Master Dataset
      const medicinesCatalog = [
        { id: 'BC-MED-001', name: 'Dolo 650', brand: 'Micro Labs', category: 'Medicines', price: 32, img: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=300&q=80', desc: 'Fever & Pain Relief' },
        { id: 'BC-MED-002', name: 'Crocin 650', brand: 'GSK', category: 'Medicines', price: 30, img: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=300&q=80', desc: 'Optizorb Pain Relief' },
        { id: 'BC-MED-003', name: 'Vitamin C', brand: 'Limcee', category: 'Medicines', price: 25, img: 'https://images.unsplash.com/photo-1584017911766-d451b3d0e843?w=300&q=80', desc: 'Immunity Booster' },
        { id: 'BC-MED-004', name: 'Volini Spray', brand: 'Sun Pharma', category: 'Medicines', price: 245, img: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=300&q=80', desc: 'Instant Pain Relief' }
      ];

      const groceryStoresList = [
        { id: 'sai-jeevan', name: 'Sai Jeevan Super Mall', tag: 'Station Road, Bhusawal', rating: '4.8', img: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?w=300&q=80', link: '/store_profile?store=sai-jeevan' },
        { id: 'shiv-dairy', name: 'Shiv Dairy', tag: 'Station Road, Bhusawal', rating: '4.9', img: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?w=300&q=80', link: '/store_profile?store=shiv-dairy' },
        { id: 'balaji-mart', name: 'Balaji Mart', tag: 'Jalgaon Road, Bhusawal', rating: '4.7', img: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=300&q=80', link: '/store_profile?store=balaji-mart' }
      ];

      const restaurantsList = [
        { id: 'royal-biryani', name: 'Royal Biryani', tag: 'Station Road, Bhusawal', rating: '4.8', img: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=300&q=80', link: '/store_profile?store=royal-biryani' },
        { id: 'hotel-sagar-grand', name: 'Hotel Sagar Grand', tag: 'Highway Touch, Bhusawal', rating: '4.7', img: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=300&q=80', link: '/store_profile?store=hotel-sagar-grand' }
      ];

      const medicalStoresList = [
        { id: 'wellness-forever', name: 'Wellness Forever', tag: 'Jalgaon Road, Bhusawal', rating: '4.8', img: 'https://images.unsplash.com/photo-1576602976047-174e57a47881?w=300&q=80', link: '/store_profile?store=wellness-forever' },
        { id: 'apollo-pharmacy', name: 'Apollo Pharmacy', tag: 'Station Road, Bhusawal', rating: '4.9', img: 'https://images.unsplash.com/photo-1586015555751-63bb77f4322a?w=300&q=80', link: '/store_profile?store=apollo-pharmacy' }
      ];

      // UNIVERSAL INDEXING DATASET
      const UNIVERSAL_INDEX = [];

      function pField(p, key) {
        const map = {
          id: ['Product ID','ProductID','id'],
          name: ['Product Name','name'],
          brand: ['Brand Name','brand'],
          cat: ['Category'],
          subcat: ['Subcategory'],
          pack: ['Pack Size','pack','Unit'],
          mrp: ['MRP','mrp'],
          sp: ['Selling Price','sp'],
          img: ['Product Image URL','img','image'],
          kw: ['Search Keywords','kw']
        };
        const keys = map[key] || [key];
        for (const k of keys) { if (p[k] !== undefined && p[k] !== '') return p[k]; }
        return '';
      }

      function buildIndex() {
        groceryCatalog.forEach(p => {
          const id = pField(p, 'id');
          const name = pField(p, 'name');
          const brand = pField(p, 'brand') || 'Bhusawal Fresh';
          const cat = pField(p, 'cat') || 'Grocery';
          const subcat = pField(p, 'subcat') || '';
          const kw = pField(p, 'kw') || '';
          const sp = parseFloat(pField(p, 'sp') || pField(p, 'mrp') || 50);
          const img = pField(p, 'img') || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

          UNIVERSAL_INDEX.push({
            type: 'grocery',
            id, name, brand, cat, subcat, price: sp, img,
            fullText: `${name} ${brand} ${cat} ${subcat} ${kw}`.toLowerCase(),
            link: `/product/${encodeURIComponent(id)}`
          });
        });

        foodCatalog.forEach(f => {
          const id = f.id || ('food_1');
          const name = f.name || '';
          const brand = f.restaurant || 'Bhusawal Food Express';
          const cat = f.category || 'Food';
          const price = parseFloat(f.price || 120);
          const img = f.image || 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=300&q=80';

          UNIVERSAL_INDEX.push({
            type: 'food',
            id, name, brand, cat, price, img,
            fullText: `${name} ${brand} ${cat} ${f.description || ''}`.toLowerCase(),
            link: `/product/${encodeURIComponent(id)}`
          });
        });

        medicinesCatalog.forEach(m => {
          UNIVERSAL_INDEX.push({
            type: 'medicine',
            id: m.id, name: m.name, brand: m.brand, cat: m.category, price: m.price, img: m.img,
            fullText: `${m.name} ${m.brand} ${m.category} ${m.desc}`.toLowerCase(),
            link: `/medicine_details?id=${encodeURIComponent(m.id)}&name=${encodeURIComponent(m.name)}`
          });
        });

        groceryStoresList.forEach(s => {
          UNIVERSAL_INDEX.push({
            type: 'grocery_store',
            id: s.id, name: s.name, tag: s.tag, rating: s.rating, img: s.img,
            fullText: `${s.name} ${s.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(s.id)}`
          });
        });

        restaurantsList.forEach(r => {
          UNIVERSAL_INDEX.push({
            type: 'restaurant',
            id: r.id, name: r.name, tag: r.tag, rating: r.rating, img: r.img,
            fullText: `${r.name} ${r.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(r.id)}`
          });
        });

        medicalStoresList.forEach(m => {
          UNIVERSAL_INDEX.push({
            type: 'medical_store',
            id: m.id, name: m.name, tag: m.tag, rating: m.rating, img: m.img,
            fullText: `${m.name} ${m.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(m.id)}`
          });
        });
      }

      buildIndex();

      // UI Search Interaction
      const searchInput = document.getElementById('main-search-input');
      const clearBtn = document.getElementById('clear-search-input-btn');
      const dropdown = document.getElementById('search-results-dropdown');
      const defaultView = document.getElementById('search-default-view');
      const activeResults = document.getElementById('search-active-results');

      function showDefaultSearch() {
        defaultView?.classList.remove('hidden');
        activeResults?.classList.add('hidden');
        renderRecentSearches();
      }

      function renderRecentSearches() {
        const box = document.getElementById('recent-searches-box');
        const listEl = document.getElementById('recent-searches-list');
        let recent = [];
        try { recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) {}

        if (!recent || recent.length === 0) {
          box?.classList.add('hidden');
          return;
        }

        box?.classList.remove('hidden');
        listEl.innerHTML = recent.map(q => `
          <button class="recent-search-tag px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-purple-100 text-slate-700 hover:text-purpleBrand text-xs font-bold transition-all flex items-center gap-1" data-query="${q.replace(/"/g, '&quot;')}">
            <span class="material-symbols-outlined text-xs text-slate-400">history</span>
            <span>${q}</span>
          </button>
        `).join('');

        listEl.querySelectorAll('.recent-search-tag').forEach(btn => {
          btn.onclick = () => {
            const query = btn.dataset.query;
            searchInput.value = query;
            clearBtn?.classList.remove('hidden');
            performSearch(query);
          };
        });
      }

      document.getElementById('clear-recent-btn')?.addEventListener('click', () => {
        localStorage.removeItem(RECENT_KEY);
        renderRecentSearches();
      });

      document.querySelectorAll('.pop-search-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const query = tag.textContent.trim();
          searchInput.value = query;
          clearBtn?.classList.remove('hidden');
          performSearch(query);
        });
      });

      function performSearch(query) {
        if (!query || query.trim().length === 0) {
          showDefaultSearch();
          return;
        }

        const q = query.trim().toLowerCase();
        defaultView?.classList.add('hidden');
        activeResults?.classList.remove('hidden');

        // Filter matched entries across grocery, food, medicines, stores
        const matched = UNIVERSAL_INDEX.filter(item => item.fullText.includes(q)).slice(0, 20);

        if (matched.length === 0) {
          activeResults.innerHTML = `
            <div class="p-8 text-center space-y-2">
              <span class="material-symbols-outlined text-4xl text-slate-300">search_off</span>
              <p class="text-xs font-black text-slate-700">No instant results found for "${query}".</p>
              <p class="text-[11px] font-medium text-slate-400">Try searching for milk, paneer, biryani, dolo or store names.</p>
              <a href="/grocery" class="inline-block mt-2 px-4 py-2 bg-purpleBrand text-white text-xs font-black rounded-xl">Browse Grocery Catalog →</a>
            </div>
          `;
          return;
        }

        // Group results by type
        const groceryMatches = matched.filter(i => i.type === 'grocery');
        const foodMatches = matched.filter(i => i.type === 'food');
        const medicineMatches = matched.filter(i => i.type === 'medicine');
        const storeMatches = matched.filter(i => i.type.includes('store') || i.type === 'restaurant');

        let html = '';

        if (groceryMatches.length > 0) {
          html += `<div class="p-2 space-y-1">
            <span class="text-[10px] font-black text-emerald-700 uppercase tracking-wider block px-2">🛒 Daily Needs (${groceryMatches.length})</span>
            ${groceryMatches.map(p => `
              <a href="${p.link}" onclick="window.saveRecentSearch('${p.name.replace(/'/g, "\\'")}');" class="flex items-center justify-between p-2 hover:bg-emerald-50/60 rounded-2xl transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${p.img}" alt="${p.name}" class="w-10 h-10 object-contain rounded-xl bg-slate-50 p-1 shrink-0 border border-slate-100" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                  <div class="min-w-0">
                    <h5 class="text-xs font-black text-slate-900 truncate">${p.name}</h5>
                    <p class="text-[10px] font-bold text-slate-400">${p.brand} • ${p.cat}</p>
                  </div>
                </div>
                <span class="text-xs font-black text-slate-900 shrink-0">₹${p.price}</span>
              </a>
            `).join('')}
          </div>`;
        }

        if (foodMatches.length > 0) {
          html += `<div class="p-2 space-y-1">
            <span class="text-[10px] font-black text-amber-700 uppercase tracking-wider block px-2">🍔 Restaurant Dishes (${foodMatches.length})</span>
            ${foodMatches.map(f => `
              <a href="${f.link}" onclick="window.saveRecentSearch('${f.name.replace(/'/g, "\\'")}');" class="flex items-center justify-between p-2 hover:bg-amber-50/60 rounded-2xl transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${f.img}" alt="${f.name}" class="w-10 h-10 object-cover rounded-xl shrink-0 border border-slate-100" loading="lazy" />
                  <div class="min-w-0">
                    <h5 class="text-xs font-black text-slate-900 truncate">${f.name}</h5>
                    <p class="text-[10px] font-bold text-amber-700">${f.brand}</p>
                  </div>
                </div>
                <span class="text-xs font-black text-slate-900 shrink-0">₹${f.price}</span>
              </a>
            `).join('')}
          </div>`;
        }

        if (medicineMatches.length > 0) {
          html += `<div class="p-2 space-y-1">
            <span class="text-[10px] font-black text-blue-700 uppercase tracking-wider block px-2">💊 Medicines (${medicineMatches.length})</span>
            ${medicineMatches.map(m => `
              <a href="${m.link}" onclick="window.saveRecentSearch('${m.name.replace(/'/g, "\\'")}');" class="flex items-center justify-between p-2 hover:bg-blue-50/60 rounded-2xl transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${m.img}" alt="${m.name}" class="w-10 h-10 object-contain rounded-xl bg-slate-50 p-1 shrink-0 border border-slate-100" loading="lazy" />
                  <div class="min-w-0">
                    <h5 class="text-xs font-black text-slate-900 truncate">${m.name}</h5>
                    <p class="text-[10px] font-bold text-blue-600">${m.brand}</p>
                  </div>
                </div>
                <span class="text-xs font-black text-slate-900 shrink-0">₹${m.price}</span>
              </a>
            `).join('')}
          </div>`;
        }

        if (storeMatches.length > 0) {
          html += `<div class="p-2 space-y-1">
            <span class="text-[10px] font-black text-purpleBrand uppercase tracking-wider block px-2">🏬 Partner Stores (${storeMatches.length})</span>
            ${storeMatches.map(s => `
              <a href="${s.link}" onclick="window.saveRecentSearch('${s.name.replace(/'/g, "\\'")}');" class="flex items-center justify-between p-2 hover:bg-purple-50/60 rounded-2xl transition-all">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src="${s.img}" alt="${s.name}" class="w-10 h-10 object-cover rounded-xl shrink-0 border border-slate-100" loading="lazy" />
                  <div class="min-w-0">
                    <h5 class="text-xs font-black text-slate-900 truncate">${s.name}</h5>
                    <p class="text-[10px] font-bold text-slate-400">${s.tag} • ⭐ ${s.rating}</p>
                  </div>
                </div>
                <span class="text-xs font-black text-purpleBrand">Visit →</span>
              </a>
            `).join('')}
          </div>`;
        }

        activeResults.innerHTML = html;
      }

      // Input Event
      searchInput?.addEventListener('input', (e) => {
        const val = e.target.value;
        if (val.length > 0) clearBtn?.classList.remove('hidden');
        else clearBtn?.classList.add('hidden');
        performSearch(val);
      });

      searchInput?.addEventListener('focus', () => {
        dropdown?.classList.remove('hidden');
        if (!searchInput.value.trim()) showDefaultSearch();
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        showDefaultSearch();
        searchInput.focus();
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('#main-search-input') && !e.target.closest('#search-results-dropdown') && !e.target.closest('#clear-search-input-btn')) {
          dropdown?.classList.add('hidden');
        }
      });

      // Voice Search Engine
      const micBtn = document.getElementById('mic-search-btn');
      if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        const rec = new SpeechRec();
        rec.lang = 'en-IN';
        rec.continuous = false;

        micBtn.onclick = () => {
          micBtn.classList.add('animate-pulse', 'text-rose-500');
          rec.start();
        };

        rec.onresult = (evt) => {
          const text = evt.results[0][0].transcript;
          if (searchInput) {
            searchInput.value = text;
            clearBtn?.classList.remove('hidden');
            dropdown?.classList.remove('hidden');
            performSearch(text);
          }
          micBtn.classList.remove('animate-pulse', 'text-rose-500');
        };

        rec.onerror = () => {
          micBtn.classList.remove('animate-pulse', 'text-rose-500');
        };
      }

      // Initial Button Renders
      refreshHomeProductButtons();
      refreshHomeWishlistButtons();
    })();
  </script>
</body>
</html>
