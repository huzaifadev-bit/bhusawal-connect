<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Super App for Bhusawal</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .green-scroll::-webkit-scrollbar { height: 4px; }
    .green-scroll::-webkit-scrollbar-track { background: #f0fdf4; border-radius: 4px; }
    .green-scroll::-webkit-scrollbar-thumb { background: #86efac; border-radius: 4px; }

    .search-match-hl {
      background-color: #f3e8ff;
      color: #7c3aed;
      font-weight: 800;
      padding: 0 2px;
      border-radius: 4px;
    }

    /* Product card hover effect */
    .home-product-card {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .home-product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px -6px rgba(124, 58, 237, 0.12), 0 4px 12px -4px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased">

  <!-- 1. TOP HEADER (LOCATION & PROFILE) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="header-location-btn">
      <div class="w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold shadow-xs">
        <span class="material-symbols-outlined text-xl">location_on</span>
      </div>
      <div>
        <div class="flex items-center gap-1">
          <span class="text-xs font-black text-purpleBrand uppercase tracking-wider">Delivery in 10-15 Mins</span>
          <span class="material-symbols-outlined text-sm text-purpleBrand">expand_more</span>
        </div>
        <p class="text-xs font-bold text-slate-700 truncate max-w-[220px] sm:max-w-xs" id="header-address-text">
          Home - Varangaon Road, Bhusawal
        </p>
      </div>
    </div>

    <a href="/profile" class="w-10 h-10 rounded-full bg-purpleBrand text-white flex items-center justify-center font-bold shadow-md hover:scale-105 active:scale-95 transition-all">
      <span class="material-symbols-outlined text-xl">person</span>
    </a>
  </header>

  <main class="px-4 py-5 space-y-7">

    <!-- ==================== UNIVERSAL SEARCH BAR ==================== -->
    <div class="relative z-40">
      <div class="flex items-center gap-2.5 bg-white rounded-2xl px-4 py-3.5 border-2 border-purple-300 shadow-md focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:border-purpleBrand transition-all">
        <span class="material-symbols-outlined text-purpleBrand text-xl shrink-0">search</span>
        <input 
          type="text" 
          id="main-search-input" 
          placeholder="Search Grocery, Food, Medicines, Stores, Restaurants, Brands..." 
          class="w-full bg-transparent outline-none text-xs sm:text-sm font-extrabold text-slate-900 placeholder-slate-400" 
          autocomplete="off" 
        />
        <button id="clear-universal-search" class="hidden text-slate-400 hover:text-slate-600 shrink-0">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
        <button id="mic-search-btn" class="text-purpleBrand hover:text-purpleDark flex items-center justify-center p-1.5 rounded-full hover:bg-purple-50 transition-colors shrink-0" title="Voice Search">
          <span class="material-symbols-outlined text-xl">mic</span>
        </button>
      </div>

      <!-- LIVE UNIVERSAL SEARCH DROPDOWN OVERLAY -->
      <div id="search-results-dropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-3xl shadow-2xl border border-purple-100 overflow-hidden max-h-[82vh] overflow-y-auto z-50 p-4 space-y-4 no-scrollbar">
        
        <!-- INITIAL DEFAULT STATE -->
        <div id="search-default-view" class="space-y-5">
          <div id="recent-searches-box" class="hidden space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">schedule</span> Recent Searches
              </span>
              <button id="clear-recent-btn" class="text-[10px] font-black text-red-500 hover:underline">Clear History</button>
            </div>
            <div id="recent-searches-list" class="flex flex-wrap gap-1.5 pt-0.5"></div>
          </div>

          <div class="space-y-2">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span>🔥</span> Trending Searches in Bhusawal
            </span>
            <div class="flex flex-wrap gap-1.5 pt-0.5" id="trending-searches-row">
              {popularSearches.map(term => (
                <button class="universal-trending-tag px-3 py-1 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white rounded-xl text-xs font-extrabold border border-purple-200/80 transition-all flex items-center gap-1" data-query={term}>
                  <span>⚡</span> {term}
                </button>
              ))}
            </div>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-100">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span>⭐</span> Popular Products
            </span>
            <div id="dropdown-popular-products-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-100">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span>🍽️</span> Popular Restaurants
            </span>
            <div id="dropdown-popular-restaurants-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-100">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span>🏬</span> Popular Stores
            </span>
            <div id="dropdown-popular-stores-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
          </div>
        </div>

        <!-- ACTIVE TYPING CONTAINER -->
        <div id="search-active-results" class="hidden space-y-3"></div>

      </div>
    </div>

    <!-- HERO BANNER -->
    <div class="relative overflow-hidden rounded-3xl shadow-xl bg-gradient-to-r from-purple-900 via-purple-950 to-slate-900 p-6 sm:p-8 text-white">
      <div class="relative z-10 max-w-xl space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 bg-purpleBrand text-white text-[10px] font-black uppercase tracking-wider rounded-full shadow-xs">BHUSAWAL SUPER APP</span>
          <span class="px-2.5 py-0.5 bg-white/10 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded-full">10-MIN EXPRESS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-display text-white leading-tight">Everything Bhusawal Needs, In One App</h2>
        <p class="text-xs sm:text-sm text-purple-100 font-semibold">Order Grocery, Food, Medicines, Rides & Parcels with 10-Minute Doorstep Delivery across Bhusawal.</p>
      </div>
    </div>

    <!-- SERVICE CARDS -->
    <section class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight">Our Services</h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Explore Bhusawal Connect services</p>
        </div>
        <a href="/shops" class="text-xs font-bold text-purpleBrand hover:underline flex items-center gap-0.5">
          View All
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </a>
      </div>

      <div class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-6 gap-3.5 pb-3">

        <!-- 1. Daily Needs -->
        <a href="/grocery" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center p-3 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" loading="lazy" src="/assets/services/service_grocery.jpg" alt="Daily Needs" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-green-100 to-emerald-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-emerald-700 text-lg">shopping_basket</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Daily Needs</h4>
            <p class="text-[10px] font-bold text-emerald-600 mt-0.5 leading-tight">2,699 Master SKUs</p>
          </div>
        </a>

        <!-- 2. Medicine -->
        <a href="/medicines" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-3 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" loading="lazy" src="/assets/services/service_medicine.jpg" alt="Medicine" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-blue-100 to-indigo-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-blue-700 text-lg">medical_services</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Medicines</h4>
            <p class="text-[10px] font-bold text-blue-600 mt-0.5 leading-tight">24x7 Pharmacy & OTC</p>
          </div>
        </a>

        <!-- 3. Food Delivery -->
        <a href="/food" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-amber-50 to-orange-100 flex items-center justify-center p-3 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" loading="lazy" src="/assets/services/service_food.jpg" alt="Food Delivery" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-amber-100 to-orange-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-amber-700 text-lg">restaurant</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Food</h4>
            <p class="text-[10px] font-bold text-amber-600 mt-0.5 leading-tight">Hot Restaurant Dishes</p>
          </div>
        </a>

        <!-- 4. Bike Taxi -->
        <a href="/bike_ride" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
