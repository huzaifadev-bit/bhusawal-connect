      // UNIVERSAL INDEXING DATASET
      const UNIVERSAL_INDEX = [];

      function pField(p, key) {
        const map = {
          id: ['Product ID','ProductID','id'],
          name: ['Product Name','name'],
          brand: ['Brand Name','brand'],
          cat: ['Category'],
          subcat: ['Subcategory'],
          pack: ['Pack Size','pack','Unit'],
          mrp: ['MRP','mrp'],
          sp: ['Selling Price','sp'],
          img: ['Product Image URL','img','image'],
          kw: ['Search Keywords','kw']
        };
        const keys = map[key] || [key];
        for (const k of keys) { if (p[k] !== undefined && p[k] !== '') return p[k]; }
        return '';
      }

      function buildIndex() {
        groceryCatalog.forEach(p => {
          const id = pField(p, 'id');
          const name = pField(p, 'name');
          const brand = pField(p, 'brand') || 'Bhusawal Fresh';
          const cat = pField(p, 'cat') || 'Grocery';
          const subcat = pField(p, 'subcat') || '';
          const kw = pField(p, 'kw') || '';
          const sp = parseFloat(pField(p, 'sp') || pField(p, 'mrp') || 50);
          const img = pField(p, 'img') || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

          UNIVERSAL_INDEX.push({
            type: 'grocery',
            id, name, brand, cat, subcat, price: sp, img,
            fullText: `${name} ${brand} ${cat} ${subcat} ${kw}`.toLowerCase(),
            link: `/product/${encodeURIComponent(id)}`
          });
        });

        foodCatalog.forEach(f => {
          const id = f.id || ('food_1');
          const name = f.name || '';
          const brand = f.restaurant || 'Bhusawal Food Express';
          const cat = f.category || 'Food';
          const price = parseFloat(f.price || 120);
          const img = f.image || 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=300&q=80';

          UNIVERSAL_INDEX.push({
            type: 'food',
            id, name, brand, cat, price, img,
            fullText: `${name} ${brand} ${cat} ${f.description || ''}`.toLowerCase(),
            link: `/product/${encodeURIComponent(id)}`
          });
        });

        medicinesCatalog.forEach(m => {
          UNIVERSAL_INDEX.push({
            type: 'medicine',
            id: m.id, name: m.name, brand: m.brand, cat: m.category, price: m.price, img: m.img,
            fullText: `${m.name} ${m.brand} ${m.category} ${m.desc}`.toLowerCase(),
            link: `/medicine_details?id=${encodeURIComponent(m.id)}&name=${encodeURIComponent(m.name)}`
          });
        });

        groceryStoresList.forEach(s => {
          UNIVERSAL_INDEX.push({
            type: 'grocery_store',
            id: s.id, name: s.name, tag: s.tag, rating: s.rating, img: s.img,
            fullText: `${s.name} ${s.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(s.id)}`
          });
        });

        restaurantsList.forEach(r => {
          UNIVERSAL_INDEX.push({
            type: 'restaurant',
            id: r.id, name: r.name, tag: r.tag, rating: r.rating, img: r.img,
            fullText: `${r.name} ${r.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(r.id)}`
          });
        });

        medicalStoresList.forEach(m => {
          UNIVERSAL_INDEX.push({
            type: 'medical_store',
            id: m.id, name: m.name, tag: m.tag, rating: m.rating, img: m.img,
            fullText: `${m.name} ${m.tag}`.toLowerCase(),
            link: `/store_profile?store=${encodeURIComponent(m.id)}`
          });
        });
      }

      buildIndex();

      function getRecentSearches() {
        try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) { return []; }
      }

      function clearRecentSearches() {
        localStorage.removeItem(RECENT_KEY);
        renderRecentSearches();
      }

      function renderRecentSearches() {
        const box = document.getElementById('recent-searches-box');
        const listEl = document.getElementById('recent-searches-list');
