  <!-- ==================== UNIVERSAL SEARCH & CLIENT SCRIPT ==================== -->
  <script is:inline>
    // Universal Global Search Implementation
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('main-search-input');
      const clearSearchBtn = document.getElementById('clear-universal-search');
      const micBtn = document.getElementById('mic-search-btn');
      const searchDropdown = document.getElementById('search-results-dropdown');
      const searchDefaultView = document.getElementById('search-default-view');
      const searchActiveResults = document.getElementById('search-active-results');
      const recentBox = document.getElementById('recent-searches-box');
      const recentList = document.getElementById('recent-searches-list');
      const clearRecentBtn = document.getElementById('clear-recent-btn');

      // Populate Quick Popular Grids inside Dropdown
      const popProductsGrid = document.getElementById('dropdown-popular-products-grid');
      const popRestaurantsGrid = document.getElementById('dropdown-popular-restaurants-grid');
      const popStoresGrid = document.getElementById('dropdown-popular-stores-grid');

      if (window.BHUSAWAL_DB) {
        // Render 4 top grocery
        if (popProductsGrid) {
          const topG = window.BHUSAWAL_DB.grocery.slice(0, 4);
          popProductsGrid.innerHTML = topG.map(item => `
            <a href="/product/${encodeURIComponent(item.id)}" class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-purple-50 transition-colors">
              <img src="${item.img}" class="w-8 h-8 rounded-lg object-contain bg-slate-50 border border-slate-100" />
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-extrabold text-slate-800 truncate">${item.displayName || item.name}</p>
                <p class="text-[9px] font-black text-purpleBrand">₹${item.sp || item.mrp}</p>
              </div>
            </a>
          `).join('');
        }

        // Render 2 top restaurants
        if (popRestaurantsGrid) {
          const topR = window.BHUSAWAL_DB.stores.filter(s => s.type === 'Restaurant').slice(0, 2);
          popRestaurantsGrid.innerHTML = topR.map(r => `
            <a href="${r.link}" class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-purple-50 transition-colors">
              <span class="text-xl">🍔</span>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-extrabold text-slate-800 truncate">${r.name}</p>
                <p class="text-[9px] font-bold text-slate-400 truncate">${r.location}</p>
              </div>
            </a>
          `).join('');
        }

        // Render 2 top stores
        if (popStoresGrid) {
          const topS = window.BHUSAWAL_DB.stores.filter(s => s.type !== 'Restaurant').slice(0, 2);
          popStoresGrid.innerHTML = topS.map(s => `
            <a href="${s.link}" class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-purple-50 transition-colors">
              <span class="text-xl">${s.logo}</span>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-extrabold text-slate-800 truncate">${s.name}</p>
                <p class="text-[9px] font-bold text-slate-400 truncate">${s.location}</p>
              </div>
            </a>
          `).join('');
        }
      }

      // Recent Searches LocalStorage Handler
      function getRecentSearches() {
        try {
          return JSON.parse(localStorage.getItem('bc_recent_searches') || '[]');
        } catch {
          return [];
        }
      }

      function addRecentSearch(query) {
        if (!query || query.trim().length === 0) return;
        let recent = getRecentSearches().filter(q => q.toLowerCase() !== query.toLowerCase());
        recent.unshift(query.trim());
        recent = recent.slice(0, 8);
        localStorage.setItem('bc_recent_searches', JSON.stringify(recent));
        renderRecentSearches();
      }

      function renderRecentSearches() {
        const recent = getRecentSearches();
        if (recent.length === 0) {
          recentBox.classList.add('hidden');
        } else {
          recentBox.classList.remove('hidden');
          recentList.innerHTML = recent.map(term => `
            <button class="recent-search-tag px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition-all" data-query="${term}">
              ${term}
            </button>
          `).join('');
        }
      }

      renderRecentSearches();

      if (clearRecentBtn) {
        clearRecentBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          localStorage.removeItem('bc_recent_searches');
          renderRecentSearches();
        });
      }

      // Show dropdown on focus
      searchInput.addEventListener('focus', () => {
        searchDropdown.classList.remove('hidden');
      });

      // Trending tag clicks
      document.querySelectorAll('.universal-trending-tag').forEach(btn => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query');
          searchInput.value = q;
          searchInput.focus();
          executeSearch(q);
        });
      });

      // Recent tag clicks
      document.addEventListener('click', (e) => {
        const tag = e.target.closest('.recent-search-tag');
        if (tag) {
          const q = tag.getAttribute('data-query');
          searchInput.value = q;
          searchInput.focus();
          executeSearch(q);
        }
      });

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#main-search-input') && !e.target.closest('#search-results-dropdown')) {
          searchDropdown.classList.add('hidden');
        }
      });

      // Input change typing listener with Debounce
      let searchTimeout;
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value;
        if (val.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }

        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          executeSearch(val);
        }, 150);
      });

      // Clear button
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        searchDefaultView.classList.remove('hidden');
        searchActiveResults.classList.add('hidden');
        searchInput.focus();
      });

      // Search executor across Master DB
      function executeSearch(query) {
        const q = (query || '').trim().toLowerCase();
        if (!q) {
          searchDefaultView.classList.remove('hidden');
          searchActiveResults.classList.add('hidden');
          return;
        }

        searchDefaultView.classList.add('hidden');
        searchActiveResults.classList.remove('hidden');

        if (!window.BHUSAWAL_DB) {
          searchActiveResults.innerHTML = '<p class="text-center text-slate-400 py-4 text-xs font-bold">Searching database...</p>';
          return;
        }

        const results = window.BHUSAWAL_DB.universalSearch(q);
        const totalFound = results.grocery.length + results.food.length + results.medicines.length + results.stores.length;

        if (totalFound === 0) {
          searchActiveResults.innerHTML = `
            <div class="text-center py-8 space-y-2">
              <span class="text-3xl">🔍</span>
              <p class="text-sm font-black text-slate-700">No matching items found in Bhusawal for "${query}"</p>
              <p class="text-xs text-slate-400">Try searching with popular terms like Milk, Biryani, Dolo, Atta</p>
            </div>
          `;
          return;
        }

        let html = '';

        // Highlight matching substring
        function highlightMatch(text, queryText) {
          if (!text) return '';
          const regex = new RegExp(`(${queryText.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&')})`, 'gi');
          return text.replace(regex, '<span class="search-match-hl">$1</span>');
        }

        // Section: Stores & Restaurants
        if (results.stores.length > 0) {
          html += `
            <div class="space-y-1.5 pb-2 border-b border-slate-100">
              <span class="text-[10px] font-black text-purpleBrand uppercase tracking-wider">🏬 Stores & Restaurants (${results.stores.length})</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                ${results.stores.map(s => `
                  <a href="${s.link}" class="flex items-center gap-2 p-2 rounded-xl bg-purple-50/50 hover:bg-purple-100/70 border border-purple-100 transition-all group">
                    <span class="text-xl">${s.logo || '🏬'}</span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-extrabold text-slate-900 truncate group-hover:text-purpleBrand">${highlightMatch(s.name, q)}</p>
                        <span class="text-[9px] font-bold text-amber-600 shrink-0">⭐ ${s.rating}</span>
                      </div>
                      <p class="text-[10px] text-slate-500 truncate">${highlightMatch(s.tagline || s.location, q)}</p>
                    </div>
                  </a>
                `).join('')}
              </div>
            </div>
          `;
        }

        // Section: Grocery (Daily Needs)
        if (results.grocery.length > 0) {
          html += `
            <div class="space-y-1.5 pb-2 border-b border-slate-100">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-black text-emerald-700 uppercase tracking-wider">🛒 Daily Needs Products (${results.grocery.length})</span>
                <a href="/grocery?search=${encodeURIComponent(q)}" class="text-[10px] font-black text-emerald-700 hover:underline">View in Grocery →</a>
              </div>
              <div class="divide-y divide-slate-100">
                ${results.grocery.slice(0, 6).map(item => `
                  <div class="flex items-center justify-between py-2 gap-3 hover:bg-slate-50 px-1 rounded-xl">
                    <a href="/product/${encodeURIComponent(item.id)}" class="flex items-center gap-2.5 min-w-0 flex-1">
                      <img src="${item.img}" class="w-10 h-10 rounded-xl object-contain bg-emerald-50/40 p-1 border border-slate-100 shrink-0" onerror="this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                      <div class="min-w-0">
                        <p class="text-xs font-extrabold text-slate-900 truncate">${highlightMatch(item.displayName || item.name, q)}</p>
                        <p class="text-[10px] text-slate-400 font-semibold">${item.pack} • <span class="text-emerald-700 font-bold">${item.brand}</span></p>
                      </div>
                    </a>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-xs font-black text-slate-900">₹${item.sp || item.mrp}</span>
                      <button class="universal-add-cart-btn px-2.5 py-1 bg-green-50 hover:bg-green-600 text-green-700 hover:text-white border border-green-200 text-[10px] font-black rounded-lg active:scale-90 transition-all" data-id="${item.id}" data-name="${(item.displayName || item.name).replace(/"/g, '&quot;')}" data-price="${item.sp || item.mrp}" data-img="${item.img}">
                        + ADD
                      </button>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        // Section: Medicines (Pharmacy)
        if (results.medicines.length > 0) {
          html += `
            <div class="space-y-1.5 pb-2 border-b border-slate-100">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-black text-blue-700 uppercase tracking-wider">💊 Pharmacy & OTC Medicines (${results.medicines.length})</span>
                <a href="/medicines" class="text-[10px] font-black text-blue-700 hover:underline">View in Pharmacy →</a>
              </div>
              <div class="divide-y divide-slate-100">
                ${results.medicines.slice(0, 5).map(m => `
                  <div class="flex items-center justify-between py-2 gap-3 hover:bg-slate-50 px-1 rounded-xl">
                    <a href="/medicine_details?id=${encodeURIComponent(m.id)}&name=${encodeURIComponent(m.name)}" class="flex items-center gap-2.5 min-w-0 flex-1">
                      <img src="${m.img}" class="w-10 h-10 rounded-xl object-contain bg-blue-50/40 p-1 border border-slate-100 shrink-0" onerror="this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                      <div class="min-w-0">
                        <p class="text-xs font-extrabold text-slate-900 truncate">${highlightMatch(m.name, q)}</p>
                        <p class="text-[10px] text-blue-600 font-bold">${m.pack} • ${m.desc || 'OTC Healthcare'}</p>
                      </div>
                    </a>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-xs font-black text-slate-900">₹${m.sp || m.price}</span>
                      <button class="universal-add-cart-btn px-2.5 py-1 bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white border border-blue-200 text-[10px] font-black rounded-lg active:scale-90 transition-all" data-id="${m.id}" data-name="${m.name.replace(/"/g, '&quot;')}" data-price="${m.sp || m.price}" data-img="${m.img}">
                        + ADD
                      </button>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        // Section: Food & Dishes
        if (results.food.length > 0) {
          html += `
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-black text-amber-700 uppercase tracking-wider">🍔 Restaurant Dishes (${results.food.length})</span>
                <a href="/food" class="text-[10px] font-black text-amber-700 hover:underline">View in Food →</a>
              </div>
              <div class="divide-y divide-slate-100">
                ${results.food.slice(0, 5).map(f => `
                  <div class="flex items-center justify-between py-2 gap-3 hover:bg-slate-50 px-1 rounded-xl">
                    <a href="/product/${encodeURIComponent(f.id)}" class="flex items-center gap-2.5 min-w-0 flex-1">
                      <img src="${f.image || f.img}" class="w-10 h-10 rounded-xl object-cover bg-amber-50/40 border border-slate-100 shrink-0" onerror="this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                      <div class="min-w-0">
                        <p class="text-xs font-extrabold text-slate-900 truncate">${highlightMatch(f.name, q)}</p>
                        <p class="text-[10px] text-amber-700 font-bold">${f.restaurant || 'Bhusawal Restaurant'}</p>
                      </div>
                    </a>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-xs font-black text-slate-900">₹${f.price}</span>
                      <button class="universal-add-cart-btn px-2.5 py-1 bg-amber-50 hover:bg-amber-600 text-amber-700 hover:text-white border border-amber-200 text-[10px] font-black rounded-lg active:scale-90 transition-all" data-id="${f.id}" data-name="${f.name.replace(/"/g, '&quot;')}" data-price="${f.price}" data-img="${f.image || f.img}">
                        + ADD
                      </button>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        searchActiveResults.innerHTML = html;
      }

      // Enter key in search box triggers first search tag save
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const val = searchInput.value.trim();
          if (val) {
            addRecentSearch(val);
          }
        }
      });

      // Universal Cart Quick Add from Search Results
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.universal-add-cart-btn');
        if (btn) {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name');
          const price = parseFloat(btn.getAttribute('data-price')) || 0;
          const img = btn.getAttribute('data-img');

          if (window.BHUSAWAL_BACKEND && window.BHUSAWAL_BACKEND.cart) {
            window.BHUSAWAL_BACKEND.cart.addItem({
              id,
              name,
              price,
              mrp: price,
              img,
              category: 'search'
            }, 1);
            if (window.BHUSAWAL_NOTIFICATIONS) {
              window.BHUSAWAL_NOTIFICATIONS.success(`Added ${name} to cart!`);
            }
            btn.innerText = '✓ ADDED';
            btn.classList.add('bg-purpleBrand', 'text-white');
            setTimeout(() => {
              btn.innerText = '+ ADD';
              btn.classList.remove('bg-purpleBrand', 'text-white');
            }, 1200);
          }
        }
      });

      // Voice Search with Web Speech API
      if (micBtn) {
        micBtn.addEventListener('click', () => {
          if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
            alert('Voice search is not supported in this browser. Please use Chrome or Edge.');
            return;
          }
          const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
          const recognition = new SpeechRecognition();
          recognition.lang = 'en-IN';
          recognition.interimResults = false;

          micBtn.classList.add('animate-pulse', 'text-red-500');

          recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            searchInput.value = transcript;
            clearSearchBtn.classList.remove('hidden');
            searchDropdown.classList.remove('hidden');
            addRecentSearch(transcript);
            executeSearch(transcript);
          };

          recognition.onerror = () => {
            micBtn.classList.remove('animate-pulse', 'text-red-500');
          };

          recognition.onend = () => {
            micBtn.classList.remove('animate-pulse', 'text-red-500');
          };

          recognition.start();
        });
      }

      // Sponsored Carousel Navigation Buttons
      const track = document.getElementById('sponsored-carousel-track');
      const prevBtn = document.getElementById('sponsored-prev-btn');
      const nextBtn = document.getElementById('sponsored-next-btn');

      if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -320, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: 320, behavior: 'smooth' });
        });
      }
    });
  </script>
</body>
</html>
