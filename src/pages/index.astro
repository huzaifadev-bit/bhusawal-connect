        <a href="/parcel" class="service-card bg-orange-50/80 rounded-[22px] border border-orange-200/90 shadow-md hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-orange-50 via-amber-50 to-orange-100 flex items-center justify-center p-2.5 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/services/service_parcel_hero.jpg';" loading="lazy" src="/assets/services/service_parcel_hero.jpg?v=3" alt="Send Parcels Anywhere in Bhusawal" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3 bg-orange-50/90">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-orange-100 to-red-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-orange-700 text-lg">local_shipping</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Send Parcel</h4>
            <p class="text-[10px] font-bold text-orange-800 mt-0.5 leading-tight">Fast City Courier</p>
          </div>
        </a>

        <!-- 6. Local Shops -->
        <a href="/shops" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-purple-50 to-indigo-100 flex items-center justify-center p-3 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" loading="lazy" src="/assets/services/service_shops.jpg" alt="Local Shops" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-purple-100 to-indigo-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-purple-700 text-lg">storefront</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Local Shops</h4>
            <p class="text-[10px] font-bold text-purple-600 mt-0.5 leading-tight">Explore Local Businesses</p>
          </div>
        </a>

      </div>
    </section>

    <!-- 5. SPONSORED PARTNERS CAROUSEL -->
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-1.5">
            <span>⭐</span> Sponsored Partners
          </h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top trusted brands in Bhusawal</p>
        </div>
      </div>

      <div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
        {sponsoredPartners.map(p => (
          <a href={p.link} class="flex-shrink-0 w-72 sm:w-80 bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl transition-all overflow-hidden group cursor-pointer">
            <div class="h-36 w-full relative overflow-hidden bg-slate-100">
              <img src={p.cover} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[10px] font-black uppercase tracking-wider">
                Sponsored
              </span>
              <span class="absolute bottom-3 right-3 px-2.5 py-0.5 rounded-full bg-slate-900/80 text-white text-[10px] font-bold backdrop-blur-md">
                ⚡ {p.time}
              </span>
            </div>
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-black text-purpleBrand uppercase">{p.type}</span>
                <span class="text-[10px] font-bold text-amber-500">⭐ {p.rating}</span>
              </div>
              <h4 class="text-sm font-black text-slate-900 truncate group-hover:text-purpleBrand transition-colors">{p.name}</h4>
              <p class="text-xs text-slate-400 font-medium truncate">{p.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. POPULAR GROCERY STAPLES -->
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-1.5">
            <span>🛒</span> Popular Grocery Staples
          </h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top daily essentials delivered fast</p>
        </div>
        <a href="/grocery" class="text-xs font-bold text-purpleBrand hover:underline">View All →</a>
      </div>

      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        {popularGroceryProducts.map(item => (
          <div class="flex-shrink-0 w-36 sm:w-40 bg-white rounded-2xl border border-slate-100 p-2.5 flex flex-col justify-between hover:shadow-lg transition-all group">
            <a href={`/product/${encodeURIComponent(item.id || item.ProductID || 'BC-000001')}`} class="h-28 w-full bg-slate-50 rounded-xl flex items-center justify-center p-2 mb-2">
              <img src={item.img || item['Product Image URL']} alt={item.name || item['Product Name']} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
            </a>
            <span class="text-[8px] font-black text-purpleBrand uppercase truncate">{item.brand || item['Brand Name'] || 'Bhusawal Fresh'}</span>
            <a href={`/product/${encodeURIComponent(item.id || item.ProductID || 'BC-000001')}`} class="text-xs font-bold text-slate-900 line-clamp-2 leading-tight hover:text-purpleBrand">{item.name || item['Product Name']}</a>
            <p class="text-[10px] text-slate-400 font-medium truncate">{item.pack || item.Unit || '1 Unit'}</p>
            <div class="flex items-center justify-between mt-2 pt-1 border-t border-slate-50">
              <span class="text-xs font-black text-slate-900">₹{item.sp || item['Selling Price'] || item.mrp || 50}</span>
              <button class="px-2 py-1 bg-purple-50 text-purpleBrand hover:bg-purpleBrand hover:text-white rounded-lg text-[10px] font-black transition-colors" onclick={`window.BHUSAWAL_BACKEND.cart.addItem({ id: '${item.id || item.ProductID}', name: '${(item.name || item['Product Name'] || '').replace(/'/g, "\\'")}', price: ${item.sp || item.mrp || 50}, img: '${item.img || item['Product Image URL']}' }, 1); window.BHUSAWAL_NOTIFICATIONS.success('Added to cart!');`}>
                + ADD
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. POPULAR FOOD & DISHES -->
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-1.5">
            <span>🍔</span> Popular Restaurant Food
          </h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Hot delicious meals from top restaurants</p>
        </div>
        <a href="/food" class="text-xs font-bold text-purpleBrand hover:underline">View All →</a>
      </div>

      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
        {popularFoodItems.map(item => (
          <div class="flex-shrink-0 w-36 sm:w-40 bg-white rounded-2xl border border-slate-100 p-2.5 flex flex-col justify-between hover:shadow-lg transition-all group">
            <a href={`/product/${encodeURIComponent(item.id || 'food_1')}`} class="h-28 w-full bg-slate-50 rounded-xl overflow-hidden mb-2">
              <img src={item.image || item.img} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </a>
            <span class="text-[8px] font-black text-orange-600 uppercase truncate">{item.restaurant || 'Bhusawal Dine'}</span>
            <a href={`/product/${encodeURIComponent(item.id || 'food_1')}`} class="text-xs font-bold text-slate-900 line-clamp-2 leading-tight hover:text-purpleBrand">{item.name}</a>
            <p class="text-[10px] text-slate-400 font-medium truncate">Fresh & Hot</p>
            <div class="flex items-center justify-between mt-2 pt-1 border-t border-slate-50">
              <span class="text-xs font-black text-slate-900">₹{item.price || 120}</span>
              <button class="px-2 py-1 bg-amber-50 text-amber-700 hover:bg-amber-600 hover:text-white rounded-lg text-[10px] font-black transition-colors" onclick={`window.BHUSAWAL_BACKEND.cart.addItem({ id: '${item.id || 'food_1'}', name: '${(item.name || '').replace(/'/g, "\\'")}', price: ${item.price || 120}, img: '${item.image || item.img}' }, 1); window.BHUSAWAL_NOTIFICATIONS.success('Added to cart!');`}>
                + ADD
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <!-- BOTTOM NAVIGATION BAR -->
  <nav class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-slate-100 py-2 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-around">
      <a href="/home" class="flex flex-col items-center gap-0.5 text-purpleBrand">
        <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">home</span>
        <span class="text-[9px] font-black">Home</span>
      </a>
      <a href="/grocery" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">local_grocery_store</span>
        <span class="text-[9px] font-bold">Grocery</span>
      </a>
      <a href="/orders" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">receipt_long</span>
        <span class="text-[9px] font-bold">Orders</span>
      </a>
      <a href="/profile" class="flex flex-col items-center gap-0.5 text-slate-400 hover:text-purpleBrand transition-colors">
        <span class="material-symbols-outlined text-xl">person</span>
        <span class="text-[9px] font-bold">Account</span>
      </a>
    </div>
  </nav>

  <script is:inline>
    // Simple Search input listener to redirect or show drop
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('main-search-input');
      const dropdown = document.getElementById('search-results-dropdown');
      
      if (searchInput && dropdown) {
        searchInput.addEventListener('focus', () => {
          dropdown.classList.remove('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('#main-search-input') && !e.target.closest('#search-results-dropdown')) {
            dropdown.classList.add('hidden');
          }
        });
      }
    });
  </script>
</body>
</html>
