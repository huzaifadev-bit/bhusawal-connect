---
import Switcher from '../components/Switcher.astro';
---

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Welcome | Bhusawal Connect</title>
    <!-- Google Fonts: Premium Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline="" />
    <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
    <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        h1, h2, h3, .font-headline {
            font-family: 'Outfit', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        /* Glassmorphism Styling */
        .glass-panel {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 24px 64px -12px rgba(176, 47, 0, 0.08);
        }
        /* Dynamic Mesh Background */
        .bg-mesh-glow {
            position: fixed;
            width: 100vw;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: -1;
            background-color: #faf9f8;
            overflow: hidden;
        }
        .glow-circle {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.55;
            mix-blend-mode: multiply;
            animation: float-glow 20s infinite alternate ease-in-out;
        }
        .glow-1 {
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, #ffdbd1 0%, rgba(255,219,209,0) 70%);
            top: -10%;
            right: -10%;
            animation-duration: 25s;
        }
        .glow-2 {
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(12,131,31,0.12) 0%, rgba(12,131,31,0) 70%);
            bottom: -15%;
            left: -10%;
            animation-duration: 30s;
            animation-delay: -5s;
        }
        .glow-3 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,165,0,0.1) 0%, rgba(255,165,0,0) 70%);
            top: 40%;
            left: 20%;
            animation-duration: 18s;
            animation-delay: -2s;
        }
        
        @keyframes float-glow {
            0% {
                transform: translate(0, 0) scale(1);
            }
            50% {
                transform: translate(5%, 8%) scale(1.15);
            }
            100% {
                transform: translate(-3%, -5%) scale(0.9);
            }
        }

        /* Input Styling */
        .custom-input:focus-within {
            border-color: #b02f00;
            box-shadow: 0 0 0 4px rgba(176, 47, 0, 0.12);
        }

        /* Animated slide-in-up */
        .animate-slide-up {
            animation: slide-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes slide-up {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
    <!-- Insert Tailwind Config -->
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                "inverse-surface": "#2f3131",
                "tertiary": "#0c831f",
                "surface-tint": "#b02f00",
                "primary-fixed": "#ffdbd1",
                "on-primary-fixed": "#3b0900",
                "on-background": "#1a1c1c",
                "on-primary-fixed-variant": "#862200",
                "error": "#ba1a1a",
                "surface-bright": "#f9f9f9",
                "on-primary-container": "#541200",
                "inverse-primary": "#ffb5a0",
                "on-secondary-fixed": "#1c1b1b",
                "on-tertiary-fixed": "#002204",
                "on-secondary-fixed-variant": "#474646",
                "on-error-container": "#93000a",
                "surface-container": "#eeeeee",
                "on-surface-variant": "#5b4039",
                "on-surface": "#1a1c1c",
                "primary": "#b02f00",
                "outline-variant": "#e4beb4",
                "on-tertiary-container": "#003208",
                "surface-container-high": "#e8e8e8",
                "on-primary": "#ffffff",
                "surface-container-lowest": "#ffffff",
                "primary-fixed-dim": "#ffb5a0",
                "secondary-container": "#e5e2e1",
                "secondary-fixed": "#e5e2e1",
                "outline": "#907067",
                "surface-container-highest": "#e2e2e2",
                "inverse-on-surface": "#f1f1f1",
                "on-secondary-container": "#656464",
                "background": "#f9f9f9",
                "tertiary-container": "#41a447",
                "surface-dim": "#dadada",
                "surface": "#f9f9f9",
                "secondary-fixed-dim": "#c8c6c5",
                "tertiary-fixed": "#94f990",
                "on-error": "#ffffff",
                "tertiary-fixed-dim": "#78dc77",
                "surface-container-low": "#f3f3f3",
                "on-tertiary-fixed-variant": "#005313",
                "surface-variant": "#e2e2e2",
                "error-container": "#ffdad6",
                "primary-container": "#ff5722",
                "on-secondary": "#ffffff",
                "on-tertiary": "#ffffff",
                "secondary": "#5f5e5e"
            }
          }
        }
      }
    </script>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4">

<!-- Dynamic Mesh Background -->
<div class="bg-mesh-glow">
    <div class="glow-circle glow-1" />
    <div class="glow-circle glow-2" />
    <div class="glow-circle glow-3" />
</div>

<!-- Simulated SMS Toast Popup (Apple/Android style) -->
<div id="sms-toast" class="hidden fixed top-6 left-1/2 -translate-x-1/2 z-[100] w-[calc(100%-32px)] max-w-sm p-4 rounded-2xl bg-[#1e293b]/95 backdrop-blur-md shadow-2xl border border-white/10 flex items-center gap-3 animate-in fade-in slide-in-from-top-4 duration-300">
    <div class="w-9 h-9 bg-primary/20 text-primary rounded-xl flex items-center justify-center flex-shrink-0 animate-pulse">
        <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">sms</span>
    </div>
    <div class="flex-1 min-w-0">
        <p class="font-bold text-[10px] text-primary uppercase tracking-wider font-extrabold">Simulated SMS</p>
        <p class="text-[12px] font-semibold text-white mt-0.5" id="sms-toast-message">Your OTP is 123456</p>
    </div>
</div>

<main class="w-full max-w-md animate-slide-up space-y-8">
    
    <!-- Branding Header -->
    <div class="text-center">
        <!-- Stylized Glow Logo -->
        <div class="w-20 h-20 bg-gradient-to-tr from-primary to-[#ff5722] rounded-3xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-primary/20 animate-pulse">
            <span class="material-symbols-outlined text-white text-4xl" style="font-variation-settings: 'FILL' 1;">local_mall</span>
        </div>
        <h1 class="text-4xl font-extrabold tracking-tighter text-on-surface mb-1">
            Bhusawal <span class="text-primary italic font-black">Connect</span>
        </h1>
        <p class="text-xs font-semibold text-on-surface-variant max-w-xs mx-auto">
            Bhusawal's #1 All-in-One Local Super App
        </p>
    </div>

    <!-- APP PROMOTIONAL ADVERTISEMENT BANNER (ULTRA CLEAN) -->
    <div class="relative overflow-hidden rounded-[28px] bg-gradient-to-br from-neutral-900 via-neutral-800 to-primary/90 p-5 text-white shadow-xl border border-white/10">
        <div class="relative z-10 space-y-3">
            <div class="flex items-center justify-between">
                <span class="bg-primary/30 border border-primary/50 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Bhusawal Local App
                </span>
                <span class="text-[11px] font-bold text-neutral-300 flex items-center gap-1">
                    <span class="material-symbols-outlined text-primary text-sm">bolt</span> 10-Min Delivery
                </span>
            </div>

            <div>
                <h2 class="text-lg font-black tracking-tight leading-tight text-white">Your City's All-in-One Super App 🚀</h2>
                <p class="text-xs text-neutral-300 mt-1 font-medium leading-relaxed">Groceries, Hot Food, Medicines, Parcels & Auto Rides delivered to your door.</p>
            </div>

            <!-- App Features Grid -->
            <div class="grid grid-cols-2 gap-2 pt-1">
                <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 flex items-center gap-2 border border-white/10">
                    <span class="material-symbols-outlined text-primary text-lg">electric_bolt</span>
                    <div>
                        <p class="text-[9px] uppercase font-bold text-neutral-400 leading-none">Doorstep Service</p>
                        <p class="text-xs font-black text-white leading-tight mt-0.5">Express 10-Min</p>
                    </div>
                </div>
                <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 flex items-center gap-2 border border-white/10">
                    <span class="material-symbols-outlined text-primary text-lg">widgets</span>
                    <div>
                        <p class="text-[9px] uppercase font-bold text-neutral-400 leading-none">Local Marketplace</p>
                        <p class="text-xs font-black text-white leading-tight mt-0.5">5 Services in 1</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Login/OTP Container Card -->
    <div class="glass-panel p-8 rounded-[32px] border border-white/50 relative overflow-hidden min-h-[380px] flex flex-col justify-between">
        
        <!-- STEP 1: Phone Request state -->
        <div id="step-phone" class="space-y-6 transition-all duration-300">
            <div>
                <h2 class="text-2xl font-extrabold text-on-surface tracking-tight mb-2">Welcome</h2>
                <p class="text-xs font-semibold text-on-surface-variant leading-relaxed">
                    Verify your phone number with OTP to enter the Bhusawal marketplace dashboard.
                </p>
            </div>

            <!-- Input Group -->
            <div class="space-y-4">
                <div class="custom-input relative flex items-center bg-white/70 border border-outline-variant/40 rounded-2xl shadow-sm transition-all">
                    <!-- Country Code flag placeholder -->
                    <div class="pl-4 pr-3 flex items-center gap-1.5 border-r border-outline-variant/20">
                        <span class="text-xs">🇮🇳</span>
                        <span class="font-bold text-on-surface-variant text-sm">+91</span>
                    </div>
                    <!-- Number Input -->
                    <input 
                        type="tel" 
                        id="phone-input" 
                        maxlength="10" 
                        class="w-full py-4 px-3 bg-transparent rounded-r-2xl outline-none font-semibold text-on-surface text-base tracking-widest placeholder-neutral-400" 
                        placeholder="Enter 10-digit number"
                        autocomplete="off"
                    />
                </div>
                <div id="phone-error" class="hidden text-error text-[11px] font-bold pl-2 flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">error</span>
                    <span>Please enter a valid 10-digit mobile number</span>
                </div>
            </div>

            <!-- Submit Button -->
            <button 
                id="btn-send-otp" 
                class="w-full bg-gradient-to-r from-primary to-[#ff5722] text-on-primary font-bold h-14 rounded-2xl shadow-lg shadow-primary/20 flex items-center justify-center gap-2 hover:brightness-105 active:scale-[0.97] transition-all cursor-pointer text-sm tracking-wide"
            >
                Send OTP
                <span class="material-symbols-outlined text-base">arrow_forward</span>
            </button>
        </div>

        <!-- STEP 2: Verify OTP state (Initially Hidden) -->
        <div id="step-otp" class="hidden space-y-6 transition-all duration-300">
            <div>
                <button id="btn-back-to-phone" class="flex items-center gap-1 text-primary text-xs font-bold mb-2 hover:underline">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Change Number
                </button>
                <h2 class="text-2xl font-extrabold text-on-surface tracking-tight mb-1">Verify OTP</h2>
                <p class="text-xs font-semibold text-on-surface-variant">
                    Enter the code sent to <span id="display-phone" class="font-extrabold text-on-surface">+91 99999 99999</span>
                </p>
            </div>

            <!-- 6 Digits Boxes -->
            <div class="space-y-4">
                <div class="flex justify-between gap-2" id="otp-container">
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                    <input type="text" pattern="[0-9]*" inputmode="numeric" maxlength="1" class="otp-box w-11 h-14 text-center text-xl font-extrabold border border-outline-variant/40 rounded-xl bg-white/70 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none shadow-sm" />
                </div>
                <div id="otp-error" class="hidden text-error text-[11px] font-bold pl-2 flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">error</span>
                    <span>Invalid verification code. Please try again.</span>
                </div>
            </div>

            <!-- Resend timer -->
            <div class="flex items-center justify-between text-xs px-1 font-semibold">
                <span class="text-on-surface-variant" id="timer-text">Resend OTP in <span id="timer-count" class="font-extrabold text-primary">30</span>s</span>
                <button id="btn-resend" class="text-primary font-bold hover:underline hidden">Resend Code</button>
            </div>

            <!-- Verify Button -->
            <button 
                id="btn-verify-otp" 
                class="w-full bg-gradient-to-r from-primary to-[#ff5722] text-on-primary font-bold h-14 rounded-2xl shadow-lg shadow-primary/20 flex items-center justify-center gap-2 hover:brightness-105 active:scale-[0.97] transition-all cursor-pointer text-sm tracking-wide"
            >
                Verify & Continue
                <span class="material-symbols-outlined text-base">login</span>
            </button>
        </div>

        <!-- Hint block -->
        <div class="mt-6 border-t border-outline-variant/20 pt-4 text-center">
            <p class="text-[11px] font-bold text-[#0c831f] flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-sm animate-pulse">lock</span>
                <span>Testing Code: Use 123456</span>
            </p>
        </div>
    </div>

    <!-- Quick Features Showcase -->
    <div class="grid grid-cols-3 gap-3 text-center px-2">
        <div class="space-y-1.5">
            <div class="w-10 h-10 bg-white/60 backdrop-blur rounded-xl border border-white/50 flex items-center justify-center mx-auto text-primary shadow-sm">
                <span class="material-symbols-outlined text-xl">shopping_basket</span>
            </div>
            <p class="text-[10px] font-bold text-on-surface-variant">Daily Groceries</p>
        </div>
        <div class="space-y-1.5">
            <div class="w-10 h-10 bg-white/60 backdrop-blur rounded-xl border border-white/50 flex items-center justify-center mx-auto text-primary shadow-sm">
                <span class="material-symbols-outlined text-xl">restaurant</span>
            </div>
            <p class="text-[10px] font-bold text-on-surface-variant">Instant Food</p>
        </div>
        <div class="space-y-1.5">
            <div class="w-10 h-10 bg-white/60 backdrop-blur rounded-xl border border-white/50 flex items-center justify-center mx-auto text-primary shadow-sm">
                <span class="material-symbols-outlined text-xl">directions_car</span>
            </div>
            <p class="text-[10px] font-bold text-on-surface-variant">Auto Rides</p>
        </div>
    </div>
</main>

<script>
    const stepPhone = document.getElementById('step-phone');
    const stepOtp = document.getElementById('step-otp');
    const phoneInput = document.getElementById('phone-input');
    const phoneError = document.getElementById('phone-error');
    const otpError = document.getElementById('otp-error');
    const displayPhone = document.getElementById('display-phone');
    const smsToast = document.getElementById('sms-toast');
    const smsToastMessage = document.getElementById('sms-toast-message');
    
    const btnSendOtp = document.getElementById('btn-send-otp');
    const btnVerifyOtp = document.getElementById('btn-verify-otp');
    const btnBackToPhone = document.getElementById('btn-back-to-phone');
    const btnResend = document.getElementById('btn-resend');
    
    const timerText = document.getElementById('timer-text');
    const timerCount = document.getElementById('timer-count');
    
    const otpBoxes = document.querySelectorAll('.otp-box');
    
    let countdown;
    let toastTimeout;

    function showSmsToast(phone) {
        clearTimeout(toastTimeout);
        smsToastMessage.innerHTML = `Your OTP is <strong class="text-primary text-base font-black">123456</strong> (sent to +91 ${phone.slice(0, 5)} ${phone.slice(5)})`;
        smsToast.classList.remove('hidden');
        toastTimeout = setTimeout(() => {
            smsToast.classList.add('hidden');
        }, 10000);
    }
    
    // Auto-focus logic for OTP boxes
    otpBoxes.forEach((box, index) => {
        box.addEventListener('input', (e) => {
            const val = e.target.value;
            if (val.length === 1 && index < otpBoxes.length - 1) {
                otpBoxes[index + 1].focus();
            }
            clearOtpError();
        });
        
        box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                otpBoxes[index - 1].focus();
            }
        });
    });

    function getOtpCode() {
        let code = '';
        otpBoxes.forEach(box => code += box.value);
        return code;
    }

    function clearOtpError() {
        otpError.classList.add('hidden');
    }

    // Start verification timer
    function startTimer() {
        clearInterval(countdown);
        let timeRemaining = 30;
        timerText.classList.remove('hidden');
        btnResend.classList.add('hidden');
        timerCount.textContent = timeRemaining;

        countdown = setInterval(() => {
            timeRemaining--;
            timerCount.textContent = timeRemaining;
            if (timeRemaining <= 0) {
                clearInterval(countdown);
                timerText.classList.add('hidden');
                btnResend.classList.remove('hidden');
            }
        }, 1000);
    }

    // Phone format validator
    function validatePhone(phone) {
        return /^\d{10}$/.test(phone);
    }

    // Send OTP Handler
    btnSendOtp.addEventListener('click', async () => {
        const phone = phoneInput.value.trim();
        if (!validatePhone(phone)) {
            phoneError.classList.remove('hidden');
            return;
        }
        phoneError.classList.add('hidden');

        btnSendOtp.disabled = true;
        btnSendOtp.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span> Sending...';

        try {
            const res = await fetch('/api/auth/request-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: `+91${phone}` })
            });
            const data = await res.json();
            console.log('OTP request outcome:', data);
        } catch (err) {
            console.warn('Backend offline, proceeding with mock simulator.', err);
        }

        // Show step 2
        displayPhone.textContent = `+91 ${phone.slice(0, 5)} ${phone.slice(5)}`;
        stepPhone.classList.add('hidden');
        stepOtp.classList.remove('hidden');
        btnSendOtp.disabled = false;
        btnSendOtp.innerHTML = 'Send OTP <span class="material-symbols-outlined text-base">arrow_forward</span>';
        
        startTimer();
        showSmsToast(phone);
        otpBoxes[0].focus();
    });

    // Verify OTP Handler
    btnVerifyOtp.addEventListener('click', async () => {
        const phone = phoneInput.value.trim();
        const code = getOtpCode();

        if (code.length < 6) {
            otpError.textContent = 'Please enter a 6-digit code';
            otpError.classList.remove('hidden');
            return;
        }

        btnVerifyOtp.disabled = true;
        btnVerifyOtp.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span> Verifying...';

        let success = false;
        let userData = null;
        let token = null;

        try {
            const res = await fetch('/api/auth/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: `+91${phone}`, otp: code })
            });
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    success = true;
                    token = data.token;
                    userData = data.user;
                }
            }
        } catch (err) {
            console.warn('Backend offline, running fallback verification.', err);
        }

        // Fallback mock check
        if (!success && code === '123456') {
            success = true;
            token = 'mock_jwt_token_bhusawal_connect_' + Date.now();
            userData = {
                id: 'MOCK-1',
                phone: `+91${phone}`,
                name: 'Sahil Patel',
                role: 'CUSTOMER'
            };
        }

        if (success) {
            localStorage.setItem('bhusawal_user_token', token);
            localStorage.setItem('bhusawal_user', JSON.stringify(userData));
            if (!localStorage.getItem('bhusawal_user_address')) {
                localStorage.setItem('bhusawal_user_address', 'Home - Varangaon Road, Bhusawal');
            }

            // Immediately redirect to home dashboard for fast, seamless login
            window.location.href = '/home';

            // Asynchronously request geolocation in background if available
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        localStorage.setItem('bhusawal_user_lat', lat);
                        localStorage.setItem('bhusawal_user_lng', lng);
                        try {
                            const address = await getAddressFromCoords(lat, lng);
                            localStorage.setItem('bhusawal_user_address', `Home - ${address}`);
                        } catch (e) {}
                    },
                    (error) => {}
                );
            }
        } else {
            otpError.innerHTML = '<span class="material-symbols-outlined text-sm">error</span> Incorrect code. Try 123456';
            otpError.classList.remove('hidden');
            btnVerifyOtp.disabled = false;
            btnVerifyOtp.innerHTML = 'Verify & Continue <span class="material-symbols-outlined text-base">login</span>';
        }
    });

    // Go back button handler
    btnBackToPhone.addEventListener('click', () => {
        stepOtp.classList.add('hidden');
        stepPhone.classList.remove('hidden');
        clearOtpError();
    });

    // Resend button handler
    btnResend.addEventListener('click', () => {
        const phone = phoneInput.value.trim();
        startTimer();
        showSmsToast(phone);
        otpBoxes.forEach(box => box.value = '');
        otpBoxes[0].focus();
    });

    // Reverse Geocoding Helper
    async function getAddressFromCoords(lat, lng) {
        try {
            const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`, {
                headers: { 'Accept-Language': 'en' }
            });
            const data = await res.json();
            if (data && data.address) {
                const road = data.address.road || data.address.suburb || data.address.neighbourhood || '';
                const city = data.address.city || data.address.town || data.address.village || 'Bhusawal';
                return road ? `${road}, ${city}` : city;
            }
        } catch (e) {
            console.warn("Reverse geocoding failed", e);
        }
        return 'Varangaon Road, Bhusawal';
    }
</script>

