  <Switcher />

  <!-- SCRIPT FOR CART & LIVE SEARCH ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Cart Management & Floating Bar
      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const totalText = document.getElementById('cart-total-text');

          if (cart.length > 0) {
            const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
            const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

            if (countBadge) countBadge.textContent = totalQty;
            if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);
            if (bar) bar.classList.remove('hidden');
          } else {
            if (bar) bar.classList.add('hidden');
          }
        } catch(e) {}
      }

      updateCartBar();

      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const id = btn.dataset.id;
          const name = btn.dataset.name;
          const price = btn.dataset.price;
          const img = btn.dataset.img;

          let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({ id, name, price, image: img, quantity: 1 });
          }
          localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
          updateCartBar();

          btn.textContent = 'ADDED!';
          btn.classList.replace('bg-purpleBrand', 'bg-emerald-600');
          setTimeout(() => {
            btn.textContent = 'ADD';
            btn.classList.replace('bg-emerald-600', 'bg-purpleBrand');
          }, 1500);
        });
      });

      // 2. Live Search Dropdown Logic
      const searchInput = document.getElementById('main-search-input');
      const dropdown = document.getElementById('search-results-dropdown');
      const dropdownList = document.getElementById('search-dropdown-list');

      if (searchInput && dropdown && dropdownList) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.trim().toLowerCase();
          if (query.length < 2) {
            dropdown.classList.add('hidden');
            return;
          }

          dropdownList.innerHTML = `
            <a href="/grocery?search=${encodeURIComponent(query)}" class="flex items-center gap-3 p-3 hover:bg-slate-50 transition-colors">
              <span class="material-symbols-outlined text-purpleBrand">search</span>
              <div>
                <p class="text-xs font-extrabold text-slate-800">Search for "${query}"</p>
                <p class="text-[10px] text-slate-400">Search across 25,000+ groceries & daily needs</p>
              </div>
            </a>
          `;
          dropdown.classList.remove('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      // Address Header Click
      document.getElementById('header-location-btn')?.addEventListener('click', () => {
        window.location.href = '/profile';
      });
    });
  </script>
