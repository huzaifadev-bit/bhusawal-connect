<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect - Fast Local Delivery</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased">

  <!-- 1. TOP HEADER (LOCATION & PROFILE) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="header-location-btn">
      <div class="w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold shadow-xs">
        <span class="material-symbols-outlined text-xl">location_on</span>
      </div>
      <div>
        <div class="flex items-center gap-1">
          <span class="text-xs font-black text-purpleBrand uppercase tracking-wider">Delivery in 10-15 Mins</span>
          <span class="material-symbols-outlined text-sm text-purpleBrand">expand_more</span>
        </div>
        <p class="text-xs font-bold text-slate-700 truncate max-w-[220px] sm:max-w-xs" id="header-address-text">
          Home - Varangaon Road, Bhusawal
        </p>
      </div>
    </div>

    <a href="/profile" class="w-10 h-10 rounded-full bg-purpleBrand text-white flex items-center justify-center font-bold shadow-md hover:scale-105 active:scale-95 transition-all">
      <span class="material-symbols-outlined text-xl">person</span>
    </a>
  </header>

  <main class="px-4 py-5 space-y-7">

    <!-- 2. IMPROVED GLOBAL SEARCH BAR & DROPDOWN -->
    <div class="relative z-40">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="main-search-input" placeholder="Search Products, Stores, Medicines, Food, Brands..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
        <button id="mic-search-btn" class="text-purpleBrand hover:text-purpleDark flex items-center justify-center p-1 rounded-full hover:bg-purple-100 transition-colors" title="Voice Search">
          <span class="material-symbols-outlined text-xl">mic</span>
        </button>
      </div>

      <!-- Live Search Overlay Dropdown -->
      <div id="search-results-dropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden max-h-[80vh] overflow-y-auto z-50">
        
        <!-- DEFAULT: POPULAR SEARCHES & CATEGORIES -->
        <div id="search-default-view" class="p-4 space-y-4">
          <!-- Recent Searches (Dynamic from LocalStorage) -->
          <div id="recent-searches-box" class="hidden space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">schedule</span>
                Recent Searches
              </span>
              <button id="clear-recent-btn" class="text-[10px] font-black text-red-500 hover:underline">Clear History</button>
            </div>
            <div id="recent-searches-list" class="flex flex-wrap gap-2 pt-1">
              <!-- Dynamically populated tags -->
            </div>
          </div>

          <!-- Popular Searches Section -->
          <div class="space-y-2">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-amber-500">local_fire_department</span>
              Popular Searches in Bhusawal
            </span>
            <div class="flex flex-wrap gap-2 pt-1">
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Amul Taaza Milk</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Maggi Noodles</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Paracetamol 500mg</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Royal Chicken Biryani</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Fortune Sunflower Oil</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Lay's Chips</button>
              <button class="pop-search-tag px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purpleBrand hover:text-white text-purpleBrand text-xs font-bold border border-purple-100 transition-all">Bhusawal Bananas</button>
            </div>
          </div>

          <!-- Quick Categories Links -->
          <div class="space-y-2 pt-2 border-t border-slate-100">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider">Explore Services</span>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <a href="/grocery" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">🛒</span>
                <span>Grocery Store</span>
              </a>
              <a href="/medicines" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">💊</span>
                <span>Pharmacy</span>
              </a>
              <a href="/food" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">🍔</span>
                <span>Food Delivery</span>
              </a>
              <a href="/shops" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">🏪</span>
                <span>Partner Shops</span>
              </a>
              <a href="/bike_ride" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">🛵</span>
                <span>Pickup & Drop</span>
              </a>
              <a href="/parcel" class="p-2.5 rounded-2xl bg-slate-50 hover:bg-purple-50 border border-slate-100 flex items-center gap-2 text-xs font-extrabold text-slate-800">
                <span class="text-lg">📦</span>
                <span>Parcel Express</span>
              </a>
            </div>
          </div>

        </div>

        <!-- ACTIVE TYPING: SEARCH RESULTS CONTAINER -->
        <div id="search-active-results" class="hidden p-3 divide-y divide-slate-100">
          <!-- Dynamically populated grouped results -->
        </div>

      </div>
    </div>

    <!-- 3. HERO SUPER-APP SHOWCASE BANNER -->
    <div class="relative overflow-hidden rounded-3xl shadow-xl bg-gradient-to-r from-purple-900 via-purple-950 to-slate-900 p-6 sm:p-8 text-white">
      <div class="relative z-10 max-w-xl space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 bg-purpleBrand text-white text-[10px] font-black uppercase tracking-wider rounded-full shadow-xs">BHUSAWAL SUPER APP</span>
          <span class="px-2.5 py-0.5 bg-white/10 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded-full">10-MIN EXPRESS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-display text-white leading-tight">Everything Bhusawal Needs, In One App</h2>
        <p class="text-xs sm:text-sm text-purple-100 font-semibold">Order Grocery, Food, Medicines, Rides & Parcels with 10-Minute Doorstep Delivery across Bhusawal.</p>
      </div>
    </div>

    <!-- 4. SERVICES SECTION (6 SERVICES WITH 3D ILLUSTRATIONS) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <div>
          <h3 class="text-xl font-black font-display text-slate-900 tracking-tight">Our Services</h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Explore Bhusawal Connect services</p>
        </div>
        <a href="/shops" class="text-xs font-bold text-purpleBrand hover:underline flex items-center gap-0.5">
          View All
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </a>
      </div>

      <!-- 6-Card Responsive Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-6 gap-3.5 pb-3">

        <!-- 1. Daily Needs -->
        <a href="/grocery" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
          <div class="h-[120px] sm:h-[135px] bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center p-3 overflow-hidden">
            <img onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" loading="lazy" src="/assets/services/service_grocery.jpg" alt="Daily Needs" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300 rounded-xl" />
          </div>
          <div class="p-3">
            <div class="w-9 h-9 mx-auto mb-1.5 rounded-xl bg-gradient-to-br from-green-100 to-emerald-200 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-emerald-700 text-lg">shopping_basket</span>
            </div>
            <h4 class="text-xs font-black text-slate-900">Daily Needs</h4>
            <p class="text-[10px] font-bold text-emerald-600 mt-0.5 leading-tight">25,000+ Fresh Essentials</p>
          </div>
        </a>

        <!-- 2. Medicine -->
        <a href="/medicines" class="service-card bg-white rounded-[22px] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-300 overflow-hidden group text-center cursor-pointer">
