---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Notifications & Alerts | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/profile" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- Mark All Read Action -->
    <div class="flex items-center gap-2">
      <button id="btn-mark-all-read" class="px-3.5 py-1.5 bg-purple-50 text-purpleBrand border border-purple-200 text-xs font-black rounded-xl hover:bg-purpleBrand hover:text-white transition-all flex items-center gap-1.5 active:scale-95 shadow-xs">
        <span class="material-symbols-outlined text-base">done_all</span>
        <span>Mark All as Read</span>
      </button>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE TITLE & UNREAD BADGE -->
    <div class="flex items-center justify-between border-b border-slate-200/60 pb-4">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Notifications</h1>
          <span class="px-3 py-0.5 rounded-full bg-purpleBrand text-white text-xs font-black" id="unread-count-badge">3 Unread</span>
        </div>
        <p class="text-xs font-bold text-slate-400 mt-0.5">Stay updated on your live orders, store alerts & offers</p>
      </div>
    </div>

    <!-- CATEGORY FILTER TABS -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
      <button class="notif-filter-tab px-4 py-2 rounded-xl bg-purpleBrand text-white font-black text-xs transition-all shadow-xs" data-cat="all">
        All Notifications
      </button>
      <button class="notif-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-extrabold text-xs border border-slate-200 transition-all" data-cat="order">
        📦 Order Updates
      </button>
      <button class="notif-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-extrabold text-xs border border-slate-200 transition-all" data-cat="offers">
        🏷️ Offers & Deals
      </button>
      <button class="notif-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-extrabold text-xs border border-slate-200 transition-all" data-cat="store">
        🏬 Store Updates
      </button>
      <button class="notif-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-extrabold text-xs border border-slate-200 transition-all" data-cat="promo">
        📢 Promotions
      </button>
    </div>

    <!-- NOTIFICATIONS LIST WRAPPER -->
    <div id="notifications-list-container" class="space-y-3">
      <!-- Dynamically populated by JS -->
    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE NOTIFICATION ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      let currentCategory = 'all';

      // Default sample notifications dataset
      const INITIAL_NOTIFICATIONS = [
        {
          id: 'N1',
          cat: 'order',
          title: 'Order #BHU-98214 Out for Delivery!',
          desc: 'Your delivery rider is on the way with your grocery essentials. Delivery expected in 6 minutes.',
          time: '5 mins ago',
          read: false,
          link: '/track_order',
          icon: 'local_shipping',
          iconBg: 'bg-purple-100 text-purpleBrand'
        },
        {
          id: 'N2',
          cat: 'offers',
          title: 'Fresh Milk & Dairy Available at MRP!',
          desc: 'Amul Taaza Milk & Pasteurised Butter in stock. 10-Minute Doorstep Delivery in Bhusawal.',
          time: '1 hour ago',
          read: false,
          link: '/grocery',
          icon: 'local_offer',
          iconBg: 'bg-amber-100 text-amber-900'
        },
        {
          id: 'N3',
          cat: 'store',
          title: 'New Category Added: Sexual Wellness & Hygiene',
          desc: 'Explore Durex, Stayfree, Whispers, and wellness products with discrete doorstep packaging.',
          time: '3 hours ago',
          read: false,
          link: '/grocery?category=Sexual%20Wellness',
          icon: 'storefront',
          iconBg: 'bg-emerald-100 text-emerald-800'
        },
        {
          id: 'N4',
          cat: 'order',
          title: 'Order #BHU-98200 Delivered Successfully',
          desc: 'Your order was delivered to Plot 42, Station Road, Shivaji Nagar, Bhusawal.',
          time: 'Yesterday',
          read: true,
          link: '/orders',
          icon: 'check_circle',
          iconBg: 'bg-emerald-100 text-emerald-800'
        },
        {
          id: 'N5',
          cat: 'promo',
          title: 'Earn ₹100 B-Wallet Cashback on Referral',
          desc: 'Invite your friends in Bhusawal using your code BHUSAWAL-SAHIL50 and earn instant rewards.',
          time: '2 days ago',
          read: true,
          link: '/profile',
          icon: 'card_giftcard',
          iconBg: 'bg-indigo-100 text-indigo-800'
        }
      ];

      function getNotifications() {
        try {
          const stored = JSON.parse(localStorage.getItem('bhusawal_notifications') || '[]');
          if (Array.isArray(stored) && stored.length > 0) return stored;
        } catch(e) {}
        return INITIAL_NOTIFICATIONS;
      }

      function saveNotifications(notifArray) {
        localStorage.setItem('bhusawal_notifications', JSON.stringify(notifArray));
        renderNotificationsUI();
      }

      function renderNotificationsUI() {
        const notifs = getNotifications();
        const container = document.getElementById('notifications-list-container');
        const badge = document.getElementById('unread-count-badge');

        const unreadCount = notifs.filter(n => !n.read).length;
        if (badge) {
          badge.textContent = `${unreadCount} Unread`;
          if (unreadCount === 0) {
            badge.classList.replace('bg-purpleBrand', 'bg-slate-300');
          } else {
            badge.classList.replace('bg-slate-300', 'bg-purpleBrand');
          }
        }

        let filtered = notifs;
        if (currentCategory !== 'all') {
          filtered = notifs.filter(n => n.cat === currentCategory);
        }

        if (!filtered || filtered.length === 0) {
          container.innerHTML = `
            <div class="bg-white rounded-3xl p-8 text-center space-y-3 border border-slate-100">
              <span class="material-symbols-outlined text-4xl text-slate-300">notifications_off</span>
              <h3 class="text-base font-black text-slate-800">No notifications found</h3>
              <p class="text-xs font-bold text-slate-400">You are all caught up!</p>
            </div>
          `;
          return;
        }

        let html = '';
        filtered.forEach(n => {
          const isUnread = !n.read;

          html += `
            <div class="notif-card p-4 sm:p-5 rounded-3xl bg-white border ${isUnread ? 'border-l-4 border-l-purpleBrand border-slate-200 shadow-xs' : 'border-slate-100 opacity-90'} hover:border-purple-300 transition-all flex items-start justify-between gap-4 cursor-pointer" data-id="${n.id}" data-link="${n.link || '/home'}">
              
              <div class="flex items-start gap-3.5 min-w-0 flex-1">
                <div class="w-11 h-11 rounded-2xl ${n.iconBg || 'bg-purple-100 text-purpleBrand'} flex items-center justify-center font-black shrink-0 shadow-xs">
                  <span class="material-symbols-outlined text-xl">${n.icon || 'notifications'}</span>
                </div>

                <div class="min-w-0 flex-1 space-y-1">
                  <div class="flex items-center gap-2">
                    <h3 class="text-xs sm:text-sm font-black text-slate-900 leading-snug">${n.title}</h3>
                    ${isUnread ? '<span class="w-2 h-2 rounded-full bg-purpleBrand shrink-0 animate-ping"></span>' : ''}
                  </div>
                  <p class="text-xs font-semibold text-slate-600 leading-relaxed">${n.desc}</p>
                  <span class="text-[10px] font-bold text-slate-400 block pt-0.5">${n.time}</span>
                </div>
              </div>

              <!-- Action button -->
              <a href="${n.link || '/home'}" class="px-3 py-1.5 bg-slate-50 hover:bg-purpleBrand text-slate-700 hover:text-white border border-slate-200 hover:border-purpleBrand text-[11px] font-black rounded-xl shrink-0 transition-all active:scale-95" onclick="event.stopPropagation();">
                View
              </a>

            </div>
          `;
        });

        container.innerHTML = html;

        // Card click marks as read
        container.querySelectorAll('.notif-card').forEach(card => {
          card.onclick = () => {
            const id = card.dataset.id;
            const link = card.dataset.link;
            let list = getNotifications();
            const target = list.find(n => n.id === id);
            if (target) {
              target.read = true;
              saveNotifications(list);
            }
            window.location.href = link;
          };
        });
      }

      // Mark All as Read Button
      document.getElementById('btn-mark-all-read')?.addEventListener('click', () => {
        let list = getNotifications();
        list.forEach(n => n.read = true);
        saveNotifications(list);
        alert('All notifications marked as read!');
      });

      // Filter Tabs Handler
      document.querySelectorAll('.notif-filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.notif-filter-tab').forEach(t => {
            t.classList.remove('bg-purpleBrand', 'text-white', 'shadow-xs');
            t.classList.add('bg-white', 'text-slate-700');
          });
          tab.classList.replace('bg-white', 'bg-purpleBrand');
          tab.classList.replace('text-slate-700', 'text-white');
          tab.classList.add('shadow-xs');

          currentCategory = tab.dataset.cat;
          renderNotificationsUI();
        });
      });

      // Initial Call
      renderNotificationsUI();
    });
  </script>
</body>
</html>
