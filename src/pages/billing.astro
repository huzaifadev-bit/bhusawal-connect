<body class="text-on-surface bg-[#f4f6f8] min-h-screen pb-40">
 <!-- Top Navigation Header -->
 <header class="bg-white sticky top-0 z-50 shadow-sm flex items-center justify-between px-4 h-16 w-full max-w-md mx-auto">
  <div class="flex items-center gap-3">
   <a href="/home" class="p-2 hover:bg-neutral-100 rounded-full transition-all">
    <span class="material-symbols-outlined text-neutral-800">arrow_back</span>
   </a>
   <div>
    <h1 class="text-sm font-extrabold text-neutral-800">Checkout & Payment</h1>
    <p class="text-[10px] text-neutral-500 font-bold" id="header-address">Select Delivery Address</p>
   </div>
  </div>
 </header>

 <main class="max-w-md mx-auto px-4 mt-4 space-y-4">

  <!-- Mandatory Address Collection Card -->
  <div class="bg-white rounded-2xl p-4 shadow-[0_8px_16px_rgba(0,0,0,0.02)] border border-neutral-100 space-y-3" id="billing-address-card">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-rose-600 text-lg">location_on</span>
        <h3 class="text-xs font-black text-neutral-800">Select Delivery Address</h3>
      </div>
      <a href="/profile" class="text-[11px] font-black text-rose-600 hover:underline flex items-center gap-0.5">
        <span class="material-symbols-outlined text-xs">add</span> Manage
      </a>
    </div>

    <!-- Address Cards Container -->
    <div id="checkout-address-list" class="space-y-2">
      <!-- Address options rendered dynamically -->
    </div>

    <!-- Out of Delivery Area Error Banner -->
    <div id="delivery-zone-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-xs font-bold space-y-1">
      <div class="flex items-center gap-1.5 text-red-800 font-black">
        <span class="material-symbols-outlined text-base">error</span>
        <span>Out of Delivery Radius</span>
      </div>
      <p id="delivery-zone-msg">Sorry, Bhusawal Connect does not currently deliver to this location.</p>
    </div>

    <!-- Bhusawal Delivery Location Map Card -->
    <div id="checkout-bhusawal-map" class="h-28 w-full rounded-xl border border-neutral-200 z-10 mt-2"></div>
  </div>

  <div class="bg-white rounded-2xl p-4 shadow-[0_8px_16px_rgba(0,0,0,0.02)] border border-neutral-100 flex items-center gap-4">
   <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-600 shrink-0">
    <span class="material-symbols-outlined text-2xl">schedule</span>
   </div>
   <div>
    <h2 class="text-sm font-extrabold text-neutral-800">Delivering in 6 mins</h2>
    <p class="text-xs text-neutral-500 font-bold mt-0.5" id="cart-item-count-label">0 items</p>
   </div>
  </div>

  <!-- Items List Card -->
