  ];

  const MEDICINE_RECOMMENDATIONS = [
   { name: "ORS Orange Liquid", price: 30, mrp: 30, img: "https://www.bbassets.com/media/uploads/p/xxl/10000127_17.jpg", pack: "200 ml Pack", category: "OTC" },
