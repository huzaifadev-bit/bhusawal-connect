    <!-- Mock QR Code -->
    <div class="w-48 h-48 border border-neutral-100 p-3 rounded-2xl bg-white shadow-sm flex items-center justify-center">
     <img src="/assets/d686bc969706f3bd6cf093f663be9579.jpg" class="w-40 h-40 object-contain" id="upi-qr-image" onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
    </div>
    
    <div class="flex items-center gap-1.5 bg-neutral-50 px-3 py-1.5 rounded-full text-[10px] text-neutral-500 font-extrabold">
     <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
     Waiting for payment confirmation...
    </div>
    
    <button id="btn-cancel-upi" class="w-full h-11 border border-neutral-200 text-neutral-700 font-black text-xs rounded-xl hover:bg-neutral-50 active:scale-95 transition-all mt-4">
     Cancel Payment
    </button>
   </div>
  </div>

  <!-- Bill Summary Card -->
  <div class="bg-white rounded-2xl p-4 shadow-[0_8px_16px_rgba(0,0,0,0.02)] border border-neutral-100 space-y-3">
   <h3 class="text-xs font-extrabold text-neutral-800">Bill Summary</h3>
   <div class="space-y-2 text-xs font-bold text-neutral-500">
