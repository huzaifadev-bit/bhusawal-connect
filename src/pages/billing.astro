---
import Switcher from '../components/Switcher.astro';
import catalog from '../../public/grocery_catalog.json';

const recommendations = catalog.slice(0, 4);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout & Payment | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- Leaflet Map CSS & JS for Google Maps Location Picker -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    #leaflet-map { height: 200px; width: 100%; border-radius: 1rem; z-index: 1; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased">

  <!-- TOP NAVIGATION HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/cart" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- ETA Widget Header -->
    <div class="flex items-center gap-2 bg-emerald-50 text-emerald-800 px-3.5 py-1.5 rounded-full border border-emerald-200/80 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
      <span class="text-xs font-black">⚡ Delivering in 10-15 Mins</span>
    </div>
  </header>

  <!-- MAIN CHECKOUT GRID -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE TITLE & PROGRESS -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Checkout & Payment</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5">Select address, delivery options and complete your order</p>
      </div>

      <!-- Step Indicator -->
      <div class="flex items-center gap-2 text-xs font-extrabold">
        <span class="text-slate-400">Cart</span>
        <span class="text-slate-300">→</span>
        <span class="px-3 py-1 rounded-full bg-purpleBrand text-white font-black">Checkout</span>
        <span class="text-slate-300">→</span>
        <span class="text-slate-400">Confirmation</span>
      </div>
    </div>

    <!-- CHECKOUT MAIN GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- LEFT 7 COLS: ADDRESS, MAP, INSTRUCTIONS & PAYMENT METHOD -->
      <div class="lg:col-span-7 space-y-6">

        <!-- 1. SAVED ADDRESSES & GPS LOCATION PICKER -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span class="material-symbols-outlined text-purpleBrand text-xl">location_on</span>
              Delivery Address (Bhusawal)
            </h2>
            
            <!-- Current Location GPS Button -->
            <button id="btn-use-gps" class="px-3 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-xs font-black rounded-xl transition-all flex items-center gap-1.5 active:scale-95 shadow-xs">
              <span class="material-symbols-outlined text-sm">my_location</span>
              <span>Use Current GPS</span>
            </button>
          </div>

          <!-- Saved Address Chips Options -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            
            <div class="address-option-card p-3.5 rounded-2xl border-2 border-purpleBrand bg-purple-50/50 cursor-pointer transition-all" data-address="Home: Plot 42, Near Station Road, Shivaji Nagar, Bhusawal">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-black text-purpleBrand flex items-center gap-1">🏠 Home</span>
                <span class="w-3.5 h-3.5 rounded-full bg-purpleBrand flex items-center justify-center text-white text-[8px] font-black">✓</span>
              </div>
              <p class="text-[11px] font-bold text-slate-700 leading-snug">Plot 42, Near Station Road, Shivaji Nagar, Bhusawal</p>
            </div>

            <div class="address-option-card p-3.5 rounded-2xl border border-slate-200 bg-white hover:border-purpleBrand cursor-pointer transition-all" data-address="Work: Shop 12, Jamner Road Market, Bhusawal">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-black text-slate-800 flex items-center gap-1">🏢 Work</span>
              </div>
              <p class="text-[11px] font-bold text-slate-500 leading-snug">Shop 12, Jamner Road Market, Bhusawal</p>
            </div>

            <div class="address-option-card p-3.5 rounded-2xl border border-slate-200 bg-white hover:border-purpleBrand cursor-pointer transition-all" data-address="Other: Flat 3B, Ordnance Factory Colony, Bhusawal">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-black text-slate-800 flex items-center gap-1">📍 Other</span>
              </div>
              <p class="text-[11px] font-bold text-slate-500 leading-snug">Flat 3B, Ordnance Factory Colony, Bhusawal</p>
            </div>

          </div>

          <!-- Selected Address Detail Box -->
          <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200 space-y-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block">Selected Address:</span>
            <p class="text-xs font-black text-slate-900" id="display-selected-address">Plot 42, Near Station Road, Shivaji Nagar, Bhusawal (Maharashtra 425201)</p>
          </div>

          <!-- Interactive Google Maps / Leaflet Location Picker Preview -->
          <div class="space-y-2 pt-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-700 flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-purpleBrand">map</span>
                Map Location Pin (Bhusawal Area)
              </span>
              <span class="text-[10px] font-bold text-slate-400">Click map to adjust pin</span>
            </div>
            <div id="leaflet-map" class="shadow-sm border border-slate-200"></div>
          </div>
        </div>

        <!-- 2. DELIVERY INSTRUCTIONS -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-purpleBrand text-xl">directions_bike</span>
            Delivery Instructions for Rider
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <button class="instruction-chip p-3 rounded-2xl border border-slate-200 hover:border-purpleBrand text-left transition-all group" data-text="Leave at Door">
              <span class="text-lg block mb-1">🔕</span>
              <span class="text-xs font-black text-slate-800 group-hover:text-purpleBrand block">Leave at Door</span>
              <span class="text-[9px] font-bold text-slate-400">Don't ring bell</span>
            </button>

            <button class="instruction-chip p-3 rounded-2xl border border-slate-200 hover:border-purpleBrand text-left transition-all group" data-text="Call Before Arrival">
              <span class="text-lg block mb-1">📞</span>
              <span class="text-xs font-black text-slate-800 group-hover:text-purpleBrand block">Call Me</span>
              <span class="text-[9px] font-bold text-slate-400">Before reaching</span>
            </button>

            <button class="instruction-chip p-3 rounded-2xl border border-slate-200 hover:border-purpleBrand text-left transition-all group" data-text="Hand to Security">
              <span class="text-lg block mb-1">🚪</span>
              <span class="text-xs font-black text-slate-800 group-hover:text-purpleBrand block">Gate / Security</span>
              <span class="text-[9px] font-bold text-slate-400">Leave at gate</span>
            </button>

            <button class="instruction-chip p-3 rounded-2xl border border-slate-200 hover:border-purpleBrand text-left transition-all group" data-text="Beware of Dog">
              <span class="text-lg block mb-1">🛑</span>
              <span class="text-xs font-black text-slate-800 group-hover:text-purpleBrand block">Beware Pet</span>
              <span class="text-[9px] font-bold text-slate-400">Pet at house</span>
            </button>
          </div>

          <input type="text" id="custom-instruction-input" placeholder="Add custom note for delivery partner (optional)..." class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-purpleBrand transition-colors" />
        </div>

        <!-- 3. SELECT PAYMENT METHOD -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-purpleBrand text-xl">payments</span>
            Select Payment Method
          </h2>

          <div class="space-y-3">
            
            <!-- UPI Payment Option -->
            <div class="payment-method-card p-4 rounded-2xl border-2 border-purpleBrand bg-purple-50/40 cursor-pointer transition-all flex items-center justify-between" data-method="upi">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-100 text-purpleBrand flex items-center justify-center font-black">
                  <span class="material-symbols-outlined text-xl">qr_code_scanner</span>
                </div>
                <div>
                  <h3 class="text-xs font-black text-slate-900">UPI Instant Payment (GPay, PhonePe, Paytm, BHIM)</h3>
                  <p class="text-[10px] font-bold text-slate-500">Scan QR Code or pay via UPI App</p>
                </div>
              </div>
              <span class="w-4 h-4 rounded-full border-2 border-purpleBrand bg-purpleBrand flex items-center justify-center text-white text-[9px] font-black">✓</span>
            </div>

            <!-- Cash on Delivery (COD) -->
            <div class="payment-method-card p-4 rounded-2xl border border-slate-200 bg-white hover:border-purpleBrand cursor-pointer transition-all flex items-center justify-between" data-method="cod">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-black">
                  <span class="material-symbols-outlined text-xl">payments</span>
                </div>
                <div>
                  <h3 class="text-xs font-black text-slate-900">Cash on Delivery (COD)</h3>
                  <p class="text-[10px] font-bold text-slate-500">Pay cash or UPI at your doorstep</p>
                </div>
              </div>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300"></span>
            </div>

            <!-- Cards -->
            <div class="payment-method-card p-4 rounded-2xl border border-slate-200 bg-white hover:border-purpleBrand cursor-pointer transition-all flex items-center justify-between" data-method="card">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-black">
                  <span class="material-symbols-outlined text-xl">credit_card</span>
                </div>
                <div>
                  <h3 class="text-xs font-black text-slate-900">Credit / Debit Card</h3>
                  <p class="text-[10px] font-bold text-slate-500">Visa, Mastercard, RuPay, Maestro</p>
                </div>
              </div>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300"></span>
            </div>

          </div>
        </div>

      </div>

      <!-- RIGHT 5 COLS: ORDER SUMMARY & PLACE ORDER BUTTON -->
      <div class="lg:col-span-5 space-y-6">

        <!-- ORDER SUMMARY ITEM LIST & BREAKDOWN -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 flex items-center gap-2">
              <span class="material-symbols-outlined text-purpleBrand text-lg">shopping_bag</span>
              Order Items Summary
            </h3>
            <span class="text-xs font-bold text-slate-400" id="summary-items-count">0 items</span>
          </div>

          <!-- Items List Container -->
          <div id="checkout-items-wrapper" class="divide-y divide-slate-100 max-h-64 overflow-y-auto pr-1 space-y-2">
            <!-- Dynamically populated -->
          </div>

          <!-- Price Summary Breakdown -->
          <div class="space-y-3 pt-3 border-t border-slate-100 text-xs font-bold text-slate-600">
            <div class="flex items-center justify-between">
              <span>Item Total (MRP)</span>
              <span class="text-slate-900 font-black" id="summary-subtotal">₹0</span>
            </div>

            <div class="flex items-center justify-between">
              <span>Delivery Charge (Standard)</span>
              <span class="text-slate-900 font-black" id="summary-delivery">₹30</span>
            </div>

            <div class="flex items-center justify-between">
              <span>Platform & Handling Fee</span>
              <span class="text-slate-900 font-black" id="summary-platform">₹5</span>
            </div>

            <!-- Tip Rider -->
            <div class="flex items-center justify-between pt-1">
              <span class="flex items-center gap-1">
                <span>🚴 Delivery Partner Tip</span>
              </span>
              <div class="flex gap-1">
                <button class="tip-btn px-2 py-0.5 bg-slate-100 rounded text-[10px] font-black hover:bg-purpleBrand hover:text-white" data-tip="10">+₹10</button>
                <button class="tip-btn px-2 py-0.5 bg-slate-100 rounded text-[10px] font-black hover:bg-purpleBrand hover:text-white" data-tip="20">+₹20</button>
                <button class="tip-btn px-2 py-0.5 bg-slate-100 rounded text-[10px] font-black hover:bg-purpleBrand hover:text-white" data-tip="30">+₹30</button>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-baseline justify-between text-slate-900">
              <div>
                <span class="text-sm font-black block font-display">Grand Total To Pay</span>
                <span class="text-[10px] font-bold text-slate-400">All products at MRP + Standard Charges</span>
              </div>
              <span class="text-2xl font-black font-display text-purpleBrand" id="summary-grand-total">₹0</span>
            </div>
          </div>

          <!-- PLACE ORDER ANIMATED BUTTON -->
          <button id="btn-place-order" class="w-full py-4 bg-gradient-to-r from-purpleBrand via-purpleDark to-indigo-700 hover:from-purpleDark hover:to-purpleBrand text-white font-black text-sm rounded-2xl shadow-xl shadow-purple-900/20 active:scale-95 transition-all duration-300 flex items-center justify-between px-6 group">
            <div class="text-left">
              <span class="text-[10px] uppercase font-bold text-purple-200 block">Confirm Order</span>
              <span class="text-base font-black font-display" id="btn-place-total">Pay & Place Order • ₹0</span>
            </div>
            <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <span class="material-symbols-outlined text-lg">check_circle</span>
            </div>
          </button>

          <p class="text-[10px] font-bold text-slate-400 text-center flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified_user</span>
            Instant Order Confirmation • Live Delivery Tracking
          </p>
        </div>

      </div>

    </div>

  </main>

  <!-- UPI QR CODE MODAL -->
  <div id="upi-qr-modal" class="fixed inset-0 z-[10000] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full text-center space-y-4 shadow-2xl relative">
      <button id="close-upi-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>

      <div class="w-14 h-14 rounded-full bg-purple-100 text-purpleBrand mx-auto flex items-center justify-center">
        <span class="material-symbols-outlined text-3xl">qr_code_2</span>
      </div>

      <div>
        <h3 class="text-base font-black font-display text-slate-900">Scan & Pay via UPI</h3>
        <p class="text-xs text-slate-500 font-bold mt-1">Scan using GPay, PhonePe, Paytm or BHIM</p>
      </div>

      <div class="w-48 h-48 mx-auto border-2 border-purpleBrand/30 rounded-2xl p-2 bg-white flex items-center justify-center shadow-inner">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi://pay?pa=bhusawalconnect@upi&pn=BhusawalConnect&cu=INR" alt="UPI QR Code" class="w-full h-full object-contain" />
      </div>

      <button id="btn-confirm-upi-paid" class="w-full py-3 bg-purpleBrand hover:bg-purpleDark text-white font-black text-xs rounded-xl shadow-md active:scale-95 transition-all">
        I Have Paid • Complete Order
      </button>
    </div>
  </div>

  <Switcher />

  <!-- CLIENT-SIDE CHECKOUT ENGINE & MAP -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      let selectedAddress = 'Plot 42, Near Station Road, Shivaji Nagar, Bhusawal';
      let selectedInstruction = '';
      let selectedPaymentMethod = 'upi';
      let selectedTipAmount = 0;

      // 1. Initialize Leaflet Map for Bhusawal Location Picker
      let map, marker;
      const bhusawalCoords = [21.0478, 75.7896];

      if (window.L && document.getElementById('leaflet-map')) {
        map = L.map('leaflet-map').setView(bhusawalCoords, 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(map);

        marker = L.marker(bhusawalCoords, { draggable: true }).addTo(map);
        marker.bindPopup('<b>Delivery Location</b><br>Bhusawal, Maharashtra').openPopup();

        marker.on('dragend', function(e) {
          const latlng = marker.getLatLng();
          const displayEl = document.getElementById('display-selected-address');
          if (displayEl) {
            displayEl.textContent = `Custom Location (${latlng.lat.toFixed(4)}, ${latlng.lng.toFixed(4)}), Bhusawal`;
          }
        });

        map.on('click', function(e) {
          marker.setLatLng(e.latlng);
          const displayEl = document.getElementById('display-selected-address');
          if (displayEl) {
            displayEl.textContent = `Custom Pin (${e.latlng.lat.toFixed(4)}, ${e.latlng.lng.toFixed(4)}), Bhusawal`;
          }
        });
      }

      // 2. GPS Location Button
      document.getElementById('btn-use-gps')?.addEventListener('click', () => {
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(pos => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            if (map && marker) {
              map.setView([lat, lng], 15);
              marker.setLatLng([lat, lng]);
            }
            const displayEl = document.getElementById('display-selected-address');
            if (displayEl) {
              displayEl.textContent = `📍 GPS Location (${lat.toFixed(4)}, ${lng.toFixed(4)}), Bhusawal`;
            }
            alert('GPS location updated successfully!');
          }, () => {
            alert('Using default Bhusawal center location.');
          });
        }
      });

      // 3. Address Selection
      document.querySelectorAll('.address-option-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.address-option-card').forEach(c => {
            c.classList.remove('border-2', 'border-purpleBrand', 'bg-purple-50/50');
            c.classList.add('border', 'border-slate-200', 'bg-white');
          });
          card.classList.replace('border', 'border-2');
          card.classList.replace('border-slate-200', 'border-purpleBrand');
          card.classList.replace('bg-white', 'bg-purple-50/50');

          selectedAddress = card.dataset.address;
          const displayEl = document.getElementById('display-selected-address');
          if (displayEl) displayEl.textContent = selectedAddress;
        });
      });

      // 4. Instructions Selection
      document.querySelectorAll('.instruction-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('.instruction-chip').forEach(c => {
            c.classList.remove('border-purpleBrand', 'bg-purple-50');
          });
          chip.classList.add('border-purpleBrand', 'bg-purple-50');
          selectedInstruction = chip.dataset.text;
        });
      });

      // 5. Payment Method Selection
      document.querySelectorAll('.payment-method-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.payment-method-card').forEach(c => {
            c.classList.remove('border-2', 'border-purpleBrand', 'bg-purple-50/40');
            c.classList.add('border', 'border-slate-200', 'bg-white');
          });
          card.classList.replace('border', 'border-2');
          card.classList.replace('border-slate-200', 'border-purpleBrand');
          card.classList.replace('bg-white', 'bg-purple-50/40');

          selectedPaymentMethod = card.dataset.method;
        });
      });

      // 6. Tip Buttons
      document.querySelectorAll('.tip-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedTipAmount = parseInt(btn.dataset.tip || '0');
          renderCheckoutSummary();
        });
      });

      // 7. Load & Render Cart Items
      function getCartItems() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) { return []; }
      }

      function renderCheckoutSummary() {
        const cart = getCartItems();
        const wrapper = document.getElementById('checkout-items-wrapper');
        const countEl = document.getElementById('summary-items-count');

        if (!cart || cart.length === 0) {
          if (wrapper) {
            wrapper.innerHTML = '<p class="text-xs font-bold text-slate-400 py-4 text-center">Your cart is empty. Please add items to proceed.</p>';
          }
          if (countEl) countEl.textContent = '0 items';
          return;
        }

        const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
        if (countEl) countEl.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'}`;

        let html = '';
        let subtotal = 0;

        cart.forEach(item => {
          const name = item.name || 'Grocery Product';
          const qty = item.quantity || 1;
          const mrpPrice = parseFloat(item.mrp || item.MRP || item.price || 0);
          const itemTotal = Math.round(mrpPrice * qty);
          subtotal += itemTotal;
          const img = item.image || item.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

          html += `
            <div class="py-2 flex items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <img src="${img}" alt="${name}" class="w-9 h-9 object-contain rounded-lg border border-slate-100 p-0.5 flex-shrink-0" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                <div class="min-w-0 flex-1">
                  <h4 class="font-extrabold text-slate-800 truncate">${name}</h4>
                  <p class="text-[10px] text-slate-400 font-bold">Qty: ${qty} × ₹${mrpPrice}</p>
                </div>
              </div>
              <span class="font-black text-slate-900 flex-shrink-0">₹${itemTotal}</span>
            </div>
          `;
        });

        if (wrapper) wrapper.innerHTML = html;

        const deliveryFee = 30;
        const platformFee = 5;
        const grandTotal = Math.round(subtotal + deliveryFee + platformFee + selectedTipAmount);

        const subtotalEl = document.getElementById('summary-subtotal');
        const grandEl = document.getElementById('summary-grand-total');
        const btnTotalEl = document.getElementById('btn-place-total');

        if (subtotalEl) subtotalEl.textContent = `₹${Math.round(subtotal)}`;
        if (grandEl) grandEl.textContent = `₹${grandTotal}`;
        if (btnTotalEl) btnTotalEl.textContent = `Pay & Place Order • ₹${grandTotal}`;
      }

      // 8. Place Order Action
      document.getElementById('btn-place-order')?.addEventListener('click', () => {
        const cart = getCartItems();
        if (!cart || cart.length === 0) {
          alert('Your cart is empty! Please add products before placing an order.');
          window.location.href = '/grocery';
          return;
        }

        if (selectedPaymentMethod === 'upi') {
          document.getElementById('upi-qr-modal')?.classList.remove('hidden');
        } else {
          executeOrderPlacement();
        }
      });

      document.getElementById('close-upi-modal')?.addEventListener('click', () => {
        document.getElementById('upi-qr-modal')?.classList.add('hidden');
      });

      document.getElementById('btn-confirm-upi-paid')?.addEventListener('click', () => {
        document.getElementById('upi-qr-modal')?.classList.add('hidden');
        executeOrderPlacement();
      });

      function executeOrderPlacement() {
        const cart = getCartItems();
        const subtotal = cart.reduce((sum, i) => sum + (parseFloat(i.mrp || i.MRP || i.price || 0) * (i.quantity || 1)), 0);
        const grandTotal = Math.round(subtotal + 30 + 5 + selectedTipAmount);
        const orderId = 'BHU-' + Math.floor(100000 + Math.random() * 900000);

        const orderRecord = {
          id: orderId,
          date: new Date().toISOString(),
          items: cart,
          address: selectedAddress,
          paymentMethod: selectedPaymentMethod,
          total: grandTotal,
          status: 'Confirmed'
        };

        // Save order in history
        try {
          const orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
          orders.unshift(orderRecord);
          localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
        } catch(e) {}

        // Clear cart
        localStorage.removeItem('bhusawal_cart');

        // Redirect to Beautiful Confirmation Screen
        window.location.href = `/order_confirmation?orderId=${orderId}&total=${grandTotal}`;
      }

      renderCheckoutSummary();
    });
  </script>
</body>
</html>
