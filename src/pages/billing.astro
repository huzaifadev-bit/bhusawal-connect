  <!-- Payment Mode Card -->
  <div class="bg-white rounded-2xl p-4 shadow-[0_8px_16px_rgba(0,0,0,0.02)] border border-neutral-100 space-y-3">
   <h3 class="text-xs font-extrabold text-neutral-800">Select Payment Method</h3>
   <div class="grid grid-cols-2 gap-3">
    <!-- UPI Option -->
    <button id="pay-method-upi" class="border-2 border-primary bg-primary/5 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center">
     <span class="material-symbols-outlined text-primary text-xl" id="upi-icon">qr_code_scanner</span>
     <span class="text-xs font-black text-neutral-800">Pay via UPI</span>
     <span class="text-[8px] text-neutral-400 font-bold">Instant & Secure</span>
    </button>
    <!-- Cash Option -->
    <button id="pay-method-cash" class="border border-neutral-200 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center">
     <span class="material-symbols-outlined text-neutral-500 text-xl" id="cash-icon">payments</span>
     <span class="text-xs font-black text-neutral-800">Cash on Delivery</span>
     <span class="text-[8px] text-neutral-400 font-bold">Pay at your doorstep</span>
