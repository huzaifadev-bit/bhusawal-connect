     I don't need a bag <span class="text-xs">🌱</span>
    </span>
   </label>
   <span class="text-[10px] text-emerald-600 font-extrabold">Save ₹10</span>
  </div>

  <!-- Final Pay Button -->
  <div class="flex items-center justify-between gap-4">
   <div>
    <p class="text-[10px] text-neutral-500 font-bold uppercase tracking-wider">To Pay</p>
    <h4 class="text-lg font-black text-neutral-800" id="bottom-pay-total">₹0</h4>
   </div>
   <button id="btn-pay" class="flex-grow h-14 bg-primary text-on-primary font-black text-sm rounded-xl hover:brightness-110 active:scale-[0.98] transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
    <span>Click to Pay</span>
    <span id="btn-pay-price">₹0</span>
   </button>
  </div>
 </div>

 <script is:inline>
  // Load current cart from localStorage based on type param
  const urlParams = new URLSearchParams(window.location.search);
  const cartType = urlParams.get('type') || 'grocery';
  let cartKey = 'bhusawal_cart';
  if (cartType === 'food') cartKey = 'bhusawal_cart_food';
  else if (cartType === 'medicine') cartKey = 'bhusawal_cart_medicine';

  function getNormalizedCartObj() {
    let raw = [];
    try {
      raw = JSON.parse(localStorage.getItem(cartKey) || localStorage.getItem('bhusawal_cart') || '[]');
    } catch(e) {}

    const obj = {};
    if (Array.isArray(raw)) {
      raw.forEach(item => {
        const title = item.name || item.title || 'Grocery Item';
        obj[title] = {
          qty: item.quantity || item.qty || 1,
          price: parseFloat(item.mrp || item.MRP || item.price || 0),
          imgUrl: item.image || item.img || item.imgUrl || '/assets/d686bc969706f3bd6cf093f663be9579.jpg',
          packSize: item.unit || item.pack || item.packSize || '1 Unit'
        };
      });
    } else if (typeof raw === 'object' && raw !== null) {
      Object.keys(raw).forEach(key => {
        const val = raw[key];
        if (typeof val === 'object') {
          obj[key] = {
            qty: val.qty || val.quantity || 1,
            price: parseFloat(val.mrp || val.MRP || val.price || 0),
            imgUrl: val.imgUrl || val.image || '/assets/d686bc969706f3bd6cf093f663be9579.jpg',
            packSize: val.packSize || val.unit || '1 Unit'
          };
        } else if (typeof val === 'number') {
          obj[key] = { qty: val, price: 60, imgUrl: '/assets/d686bc969706f3bd6cf093f663be9579.jpg', packSize: '1 Unit' };
        }
      });
    }
    return obj;
  }

  let cart = getNormalizedCartObj();
  let selectedTip = 0;
  let noBag = true;

  // Calculate actual delivery distance based on cached user coordinates from Shivaji Nagar
  function calculateActualDistance() {
   const cachedLat = localStorage.getItem('bhusawal_user_lat');
   const cachedLng = localStorage.getItem('bhusawal_user_lng');
   if (cachedLat && cachedLng) {
    const lat1 = parseFloat(cachedLat);
    const lng1 = parseFloat(cachedLng);
    const lat2 = 21.0478; // store lat
    const lng2 = 75.7896; // store lng
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
    const dist = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return parseFloat(dist.toFixed(1));
   }
   return 3.5; // fallback above 3km if location not cached yet
  }

  let deliveryDistance = calculateActualDistance();
  localStorage.setItem('bhusawal_delivery_distance', deliveryDistance);

  // Update address header with distance
  document.getElementById('header-address').textContent = `Shivaji Nagar, Bhusawal (${deliveryDistance} km away)`;

