<html class="light" lang="en">
<head>
 <meta charset="utf-8" />
 <meta content="width=device-width, initial-scale=1.0" name="viewport" />
 <title>Checkout | Bhusawal Connect</title>
 <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline="" />
 <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
 <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
 <style>
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f4f6f8; }
  .material-symbols-outlined {
   font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .custom-scroll::-webkit-scrollbar {
   display: none;
  }
 </style>
 <script is:inline id="tailwind-config">
  tailwind.config = {
   darkMode: "class",
   theme: {
    extend: {
     colors: {
      primary: "#e51a4c",
      "primary-container": "#ffdad6",
      "on-primary": "#ffffff",
      "on-surface": "#1a1c1c",
      "on-surface-variant": "#5b4039",
      background: "#f4f6f8",
      surface: "#ffffff",
      "surface-container": "#eeeeee",
      tertiary: "#006e1c"
     }
    }
   }
  };
