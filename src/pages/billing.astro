    <button data-tip="35" class="border border-neutral-200 py-2 rounded-xl text-xs font-extrabold text-neutral-700 flex flex-col items-center gap-1 hover:border-primary hover:text-primary active:scale-95 transition-all">
     <span>🥪 ₹35</span>
