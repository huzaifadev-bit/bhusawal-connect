   <div class="space-y-4" id="billing-items-container">
    <!-- Rendered dynamically -->
   </div>
   <div class="border-t border-neutral-100 pt-3 mt-3 flex justify-between items-center text-xs">
    <span class="text-neutral-500 font-bold">Forgot something?</span>
    <a href="/grocery" class="text-primary font-extrabold hover:underline">Add More Items</a>
   </div>
  </div>

  <!-- Recommendations Section (Dynamic) -->
  <div class="bg-white rounded-2xl p-4 shadow-[0_8px_16px_rgba(0,0,0,0.02)] border border-neutral-100 overflow-hidden" id="recommendations-card">
   <h3 class="text-xs font-extrabold text-neutral-800 mb-3" id="recommendations-title">Special offers for you</h3>
   <div class="flex gap-3 overflow-x-auto custom-scroll pb-2" id="recommendations-container">
    <!-- Rendered dynamically -->
   </div>
  </div>

