    { name: "Brooke Bond Red Label Tea (250 g)", price: 140, mrp: 150, img: "https://www.bbassets.com/media/uploads/p/l/266542_9-brooke-bond-red-label-tea.jpg", pack: "250 g Box", category: "Beverages" },
    { name: "Parle-G Gold Glucose Biscuits", price: 10, mrp: 10, img: "https://www.bbassets.com/media/uploads/p/l/100080_14-parle-g-glucose-biscuits.jpg", pack: "100 g", category: "Snacks & Confectionery" },
    { name: "Britannia Marie Gold Biscuits", price: 25, mrp: 25, img: "https://www.bbassets.com/media/uploads/p/l/100021_13-britannia-marie-gold-biscuits.jpg", pack: "150 g", category: "Snacks & Confectionery" },
    { name: "Amul Pasteurised Butter (100 g)", price: 58, mrp: 58, img: "https://www.bbassets.com/media/uploads/p/l/100001_19-amul-butter-pasteurised.jpg", pack: "100 g", category: "Dairy & Breakfast" }
  ];

  const SPICES_AND_OIL = [
    { name: "Everest Turmeric Powder (100 g)", price: 35, mrp: 35, img: "https://www.bbassets.com/media/uploads/p/l/10000473_12-everest-turmeric-powder.jpg", pack: "100 g", category: "Grocery Staples" },
    { name: "Fortune Sunlite Sunflower Oil (1 L)", price: 135, mrp: 150, img: "https://www.bbassets.com/media/uploads/p/l/274262_14-fortune-sunlite-refined-sunflower-oil.jpg", pack: "1 L Pouch", category: "Grocery Staples" },
    { name: "Solapur Red Onion (Fresh, 1 kg)", price: 35, mrp: 40, img: "https://www.bbassets.com/media/uploads/p/l/10000148_30-local-fresh-onion.jpg", pack: "1 kg", category: "Fruits & Vegetables" },
    { name: "Fresh Garlic (Lahsun, 250 g)", price: 40, mrp: 45, img: "https://www.bbassets.com/media/uploads/p/l/10000118_20-local-fresh-garlic.jpg", pack: "250 g", category: "Fruits & Vegetables" }
  ];

    let fullCatalogData = [];

  async function loadCatalogForRecommendations() {
    if (fullCatalogData.length > 0) return fullCatalogData;
    try {
      const res = await fetch('/grocery_catalog.json');
      fullCatalogData = await res.json();
    } catch (e) {
      console.warn("Could not load full catalog for recommendations", e);
    }
    return fullCatalogData;
  }

  function getRecommendations() {
    const items = Object.values(cart);
    const titleEl = document.getElementById('recommendations-title');

    if (items.length === 0) {
      if (titleEl) titleEl.textContent = "🔥 Trending & Daily Need Items";
      return TRENDING_DAILY_PRODUCTS;
    }

    if (cartType === 'food') {
      if (titleEl) titleEl.textContent = "Pairs well with your food order";
      return FOOD_RECOMMENDATIONS;
    }
    if (cartType === 'medicine') {
      if (titleEl) titleEl.textContent = "Suggested first-aid & health items";
      return MEDICINE_RECOMMENDATIONS;
    }

    // Extract categories and brands of items in cart
    const cartCategories = new Set();
    const cartNames = new Set(items.map(i => (i.title || i.name || '').toLowerCase()));

    items.forEach(i => {
      if (i.category) cartCategories.add(i.category);
    });

    if (fullCatalogData.length > 0) {
      let matched = [];

      // 1. Complementary category pairing
      if (Array.from(cartCategories).some(c => c.includes('Dairy') || c.includes('Breakfast'))) {
        if (titleEl) titleEl.textContent = "☕ Perfect with your Dairy items (Tea, Coffee & Bakery)";
        matched = fullCatalogData.filter(p => (p.Category === 'Beverages' || p.Category === 'Snacks & Confectionery') && !cartNames.has(p["Product Name"].toLowerCase()));
      } else if (Array.from(cartCategories).some(c => c.includes('Fruits') || c.includes('Vegetables') || c.includes('Staples'))) {
        if (titleEl) titleEl.textContent = "🌾 Essential Cooking Ingredients & Spices";
        matched = fullCatalogData.filter(p => (p.Category === 'Grocery Staples' || p.Category === 'Fruits & Vegetables') && !cartNames.has(p["Product Name"].toLowerCase()));
      } else if (Array.from(cartCategories).some(c => c.includes('Snacks') || c.includes('Instant'))) {
        if (titleEl) titleEl.textContent = "🥤 Cold Drinks & Refreshing Munchies";
        matched = fullCatalogData.filter(p => (p.Category === 'Beverages' || p.Category === 'Snacks & Confectionery') && !cartNames.has(p["Product Name"].toLowerCase()));
      } else if (Array.from(cartCategories).some(c => c.includes('Personal') || c.includes('Baby') || c.includes('Home'))) {
        if (titleEl) titleEl.textContent = "🧴 Suggested Health & Household Essentials";
        matched = fullCatalogData.filter(p => (p.Category === 'Personal Care' || p.Category === 'Home Cleaning & Household') && !cartNames.has(p["Product Name"].toLowerCase()));
      } else {
        if (titleEl) titleEl.textContent = "Frequently Bought Together";
        matched = fullCatalogData.filter(p => !cartNames.has(p["Product Name"].toLowerCase()));
      }

      if (matched.length > 0) {
        return matched.slice(0, 8).map(p => ({
          name: p["Product Name"],
          price: p.MRP,
          mrp: p.MRP,
          img: p["Product Image URL"] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg',
          pack: p["Pack Size"] || '1 Unit',
          category: p.Category
        }));
      }
    }

    if (titleEl) titleEl.textContent = "Frequently Bought Together";
    return TRENDING_DAILY_PRODUCTS;
  }

  // Pre-load catalog asynchronously
  loadCatalogForRecommendations().then(() => {
    renderRecommendations();
  });

  function renderCartItems() {
   const container = document.getElementById('billing-items-container');
   const items = Object.entries(cart);
   
   document.getElementById('cart-item-count-label').textContent = items.reduce((sum, [_, d]) => sum + d.qty, 0) + ' items';

   if (items.length === 0) {
    container.innerHTML = `
      <div class="text-center py-8 px-4 space-y-3">
        <div class="w-16 h-16 bg-neutral-100 rounded-full flex items-center justify-center mx-auto text-neutral-400">
          <span class="material-symbols-outlined text-3xl">shopping_cart</span>
        </div>
        <h3 class="text-sm font-black text-neutral-800">Your cart is empty</h3>
        <p class="text-xs text-neutral-500 font-bold max-w-xs mx-auto">Explore daily sales & trending items below or browse our 25,000+ grocery catalog!</p>
        <a href="/grocery" class="inline-block bg-[#0c831f] text-white text-xs font-black px-6 py-2.5 rounded-xl shadow-md hover:bg-emerald-700 active:scale-95 transition-all mt-2">
          Explore All Categories 🛍️
        </a>
      </div>
    `;
    updateBillTotals();
    return;
   }

   let html = '';
   items.forEach(([title, data]) => {
    const imgUrl = data.imgUrl || '/assets/d686bc969706f3bd6cf093f663be9579.jpg';
    html += `
     <div class="flex items-center gap-3 py-1.5 justify-between">
      <div class="flex items-center gap-3 flex-1 min-w-0">
       <img src="${imgUrl}" class="w-10 h-10 object-contain shrink-0" onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
       <div class="min-w-0 flex-1">
        <h4 class="text-xs font-extrabold text-neutral-800 truncate">${title}</h4>
        <p class="text-[9px] text-neutral-400 font-bold mt-0.5">${data.packSize || '1 Unit'}</p>
       </div>
      </div>
      <div class="flex items-center gap-4">
       <span class="text-xs font-black text-neutral-800">₹${data.price * data.qty}</span>
       <!-- Stepper -->
       <div class="flex items-center bg-primary rounded-lg shadow-sm overflow-hidden text-white shrink-0">
        <button class="w-6 h-6 flex items-center justify-center font-bold text-xs hover:bg-white/20" onclick="updateQty('${title}', -1)">−</button>
        <span class="w-5 text-center text-[10px] font-black">${data.qty}</span>
        <button class="w-6 h-6 flex items-center justify-center font-bold text-xs hover:bg-white/20" onclick="updateQty('${title}', 1)">+</button>
       </div>
      </div>
     </div>
    `;
   });
   container.innerHTML = html;
   updateBillTotals();
  }

  function renderRecommendations() {
   const container = document.getElementById('recommendations-container');
   const items = getRecommendations();
   
   let html = '';
   items.forEach(p => {
    html += `
     <div class="w-28 bg-white border border-neutral-100 p-2 rounded-xl flex flex-col justify-between shrink-0 shadow-[0_4px_8px_rgba(0,0,0,0.01)]">
      <div class="w-full aspect-square relative mb-2 flex items-center justify-center">
       <img src="${p.img}" class="w-full h-full object-contain "  onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
      </div>
      <div>
       <h4 class="text-[9px] font-extrabold text-neutral-800 line-clamp-2 h-6 mt-1 leading-snug">${p.name}</h4>
       <p class="text-[8px] text-neutral-400 font-bold mt-0.5">${p.pack}</p>
       <div class="flex items-center justify-between mt-2">
        <span class="text-[10px] font-black text-neutral-800">₹${p.price}</span>
        <button class="bg-white border border-primary text-primary px-2 py-0.5 rounded text-[8px] font-black hover:bg-primary/5 active:scale-95 transition-all" onclick="addRecommendedItem('${p.name}', ${p.price}, '${p.img}', '${p.pack}', '${p.category}')">+ ADD</button>
       </div>
      </div>
     </div>
    `;
   });
   container.innerHTML = html;
  }

  window.updateQty = (title, delta) => {
   if (cart[title]) {
    cart[title].qty += delta;
    if (cart[title].qty <= 0) {
     delete cart[title];
    }
    localStorage.setItem(cartKey, JSON.stringify(cart));
    renderCartItems();
    renderRecommendations(); // refresh if cart content category profile changes
   }
  };

  window.addRecommendedItem = (name, price, img, pack, category) => {
   if (cart[name]) {
    cart[name].qty++;
   } else {
    cart[name] = {
     price: price,
     qty: 1,
     imgUrl: img,
     packSize: pack,
     category: category,
     btnClass: "absolute bottom-2 right-2 bg-white border border-primary text-primary px-3 py-1 rounded-lg text-[10px] font-extrabold shadow-md hover:bg-primary/5 active:scale-95 transition-all duration-200"
    };
   }
   localStorage.setItem(cartKey, JSON.stringify(cart));
   renderCartItems();
   renderRecommendations();
  };

  function updateBillTotals() {
   let itemTotal = 0;
   Object.values(cart).forEach(item => {
    itemTotal += item.price * item.qty;
   });

   const deliveryFee = itemTotal === 0 ? 0 : 25; // Standard Delivery Charge on EVERY order

   const bagFee = noBag ? 0 : 10;
   
   // Night Fee calculation (after 11 PM, under ₹300 item total)
   const now = new Date();
   const isNightTime = now.getHours() >= 23 || now.getHours() < 6 || urlParams.get('night') === 'true';
   let nightFee = 0;
   if (isNightTime && itemTotal > 0 && itemTotal < 300) {
    if (deliveryDistance <= 1.5) {
     nightFee = 10;
    } else if (deliveryDistance <= 3.0) {
     nightFee = 20;
    } else {
     nightFee = 30;
    }
   }

   const grandTotal = itemTotal > 0 ? (itemTotal + deliveryFee + bagFee + selectedTip + nightFee) : 0;

   document.getElementById('bill-item-total').textContent = '₹' + itemTotal;
   document.getElementById('bill-delivery-fee').textContent = '₹' + deliveryFee;


   const nightFeeRow = document.getElementById('night-fee-row');
   if (nightFee > 0) {
    nightFeeRow.classList.remove('hidden');
    document.getElementById('bill-night-fee').textContent = '₹' + nightFee;
   } else {
    nightFeeRow.classList.add('hidden');
   }
   
   const tipRow = document.getElementById('tip-row');
   if (selectedTip > 0) {
    tipRow.style.display = 'flex';
    document.getElementById('bill-tip-amount').textContent = '₹' + selectedTip;
   } else {
    tipRow.style.display = 'none';
   }

   document.getElementById('bill-grand-total').textContent = '₹' + grandTotal;
   document.getElementById('bottom-pay-total').textContent = '₹' + grandTotal;
   document.getElementById('btn-pay-price').textContent = '₹' + grandTotal;
  }

  // Bind Tip Options
  document.querySelectorAll('#tip-options-grid button').forEach(btn => {
   btn.addEventListener('click', () => {
    // Toggle active styling
    document.querySelectorAll('#tip-options-grid button').forEach(b => {
     b.classList.remove('border-primary', 'text-primary', 'bg-primary/5');
     b.classList.add('border-neutral-200', 'text-neutral-700');
    });

    const val = btn.getAttribute('data-tip');
    if (val === 'custom') {
     const amt = parseInt(prompt("Enter custom tip amount (₹):") || '0');
     selectedTip = isNaN(amt) ? 0 : amt;
     if (selectedTip > 0) {
      btn.classList.add('border-primary', 'text-primary', 'bg-primary/5');
      btn.querySelector('span').textContent = '₹' + selectedTip;
     } else {
      btn.querySelector('span').textContent = 'Custom';
     }
    } else {
     selectedTip = parseInt(val);
     btn.classList.add('border-primary', 'text-primary', 'bg-primary/5');
    }
    updateBillTotals();
   });
  });

  // Address Selection & Delivery Zone Validation State
  let selectedAddress = null;

  function renderCheckoutAddresses() {
    const addresses = window.AddressManager ? window.AddressManager.getAddresses() : [];
    const container = document.getElementById('checkout-address-list');
    const zoneError = document.getElementById('delivery-zone-error');
    if (!container) return;

    container.innerHTML = '';
    
    if (addresses.length === 0) {
      container.innerHTML = `
        <div class="p-3 bg-neutral-50 rounded-xl border border-dashed border-neutral-300 text-center">
          <p class="text-xs font-bold text-neutral-600">No saved delivery address found.</p>
          <a href="/profile" class="inline-block mt-2 text-xs font-black text-rose-600 bg-rose-50 px-3 py-1 rounded-lg border border-rose-200">Add Address in Profile</a>
        </div>
      `;
      selectedAddress = null;
      validateSelectedAddress();
      return;
    }

    const defaultAddr = window.AddressManager.getDefaultAddress();
    selectedAddress = defaultAddr || addresses[0];

    addresses.forEach(addr => {
      const isSelected = selectedAddress && selectedAddress.id === addr.id;
      const isZoneValid = window.BhusawalDeliveryZone ? window.BhusawalDeliveryZone.isWithinDeliveryZone(addr.lat, addr.lng) : true;

      const div = document.createElement('label');
      div.className = `flex items-start gap-3 p-3 rounded-xl border ${isSelected ? 'border-rose-500 bg-rose-50/50' : 'border-neutral-200 bg-white'} cursor-pointer transition-all`;
      div.innerHTML = `
        <input type="radio" name="checkout-addr" value="${addr.id}" ${isSelected ? 'checked' : ''} class="mt-1 text-rose-600 focus:ring-rose-500" />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-xs font-black text-neutral-800">${addr.tag || 'Home'}</span>
            ${addr.isDefault ? '<span class="text-[9px] font-black bg-rose-100 text-rose-700 px-1.5 py-0.2 rounded uppercase">Default</span>' : ''}
            ${!isZoneValid ? '<span class="text-[9px] font-black bg-red-100 text-red-700 px-1.5 py-0.2 rounded uppercase">Out of Zone</span>' : ''}
          </div>
          <p class="text-[11px] font-bold text-neutral-600 leading-tight mt-0.5 truncate">${addr.fullAddress}</p>
        </div>
      `;

      div.querySelector('input').addEventListener('change', () => {
        selectedAddress = addr;
        if (window.BhusawalDeliveryZone) {
          deliveryDistance = Math.round(window.BhusawalDeliveryZone.getDistanceToBhusawal(addr.lat, addr.lng) * 10) / 10;
        }
        renderCheckoutAddresses();
        updateBillTotals();
      });

      container.appendChild(div);
    });

    validateSelectedAddress();
  }

  function validateSelectedAddress() {
    const zoneError = document.getElementById('delivery-zone-error');
    const payBtn = document.getElementById('btn-pay');
    
    if (!selectedAddress) {
      zoneError.classList.remove('hidden');
      document.getElementById('delivery-zone-msg').textContent = 'Please select a valid delivery address before proceeding.';
      payBtn.disabled = true;
      payBtn.classList.add('opacity-50', 'cursor-not-allowed');
      return false;
    }

    const isValidZone = window.BhusawalDeliveryZone ? window.BhusawalDeliveryZone.isWithinDeliveryZone(selectedAddress.lat, selectedAddress.lng) : true;
    if (!isValidZone) {
      zoneError.classList.remove('hidden');
      document.getElementById('delivery-zone-msg').textContent = 'Sorry, Bhusawal Connect does not currently deliver to this location outside Bhusawal.';
      payBtn.disabled = true;
      payBtn.classList.add('opacity-50', 'cursor-not-allowed');
      return false;
    }

    zoneError.classList.add('hidden');
    payBtn.disabled = false;
    payBtn.classList.remove('opacity-50', 'cursor-not-allowed');

    const headerAddr = document.getElementById('header-address');
    if (headerAddr) headerAddr.textContent = selectedAddress.fullAddress.substring(0, 32) + '...';
    return true;
  }

  // Payment Mode State & Handlers
  let selectedPaymentMethod = 'UPI';
  const payMethodUpi = document.getElementById('pay-method-upi');
  const payMethodCash = document.getElementById('pay-method-cash');
  const upiIcon = document.getElementById('upi-icon');
  const cashIcon = document.getElementById('cash-icon');

  payMethodUpi.addEventListener('click', () => {
   selectedPaymentMethod = 'UPI';
   payMethodUpi.className = "border-2 border-primary bg-primary/5 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center";
   payMethodCash.className = "border border-neutral-200 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center";
   upiIcon.className = "material-symbols-outlined text-primary text-xl";
   cashIcon.className = "material-symbols-outlined text-neutral-500 text-xl";
  });

  payMethodCash.addEventListener('click', () => {
   selectedPaymentMethod = 'Cash';
   payMethodCash.className = "border-2 border-primary bg-primary/5 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center";
   payMethodUpi.className = "border border-neutral-200 p-3 rounded-xl flex flex-col items-center gap-2 hover:border-primary active:scale-95 transition-all text-center";
   cashIcon.className = "material-symbols-outlined text-primary text-xl";
   upiIcon.className = "material-symbols-outlined text-neutral-500 text-xl";
  });

  // Bag checkbox
  document.getElementById('bag-checkbox').addEventListener('change', (e) => {
   noBag = e.target.checked;
   updateBillTotals();
  });

  // Click to Pay button
  let upiTimeout;
  document.getElementById('btn-pay').addEventListener('click', () => {
   if (!validateSelectedAddress()) return;

   const items = Object.entries(cart);
   if (items.length === 0) {
    alert("Your cart is empty!");
    return;
   }

   let grandTotal = 0;
   let itemTotal = 0;
   Object.values(cart).forEach(item => {
    itemTotal += item.price * item.qty;
   });
   const deliveryFee = 30;
   const bagFee = noBag ? 0 : 10;
   
   const now = new Date();
   const isNightTime = now.getHours() >= 23 || now.getHours() < 6 || urlParams.get('night') === 'true';
   let nightFee = 0;
   if (isNightTime && itemTotal > 0 && itemTotal < 300) {
    if (deliveryDistance <= 1.5) {
     nightFee = 10;
    } else if (deliveryDistance <= 3.0) {
     nightFee = 20;
    } else {
     nightFee = 30;
    }
   }
   grandTotal = itemTotal + deliveryFee + bagFee + selectedTip + nightFee;

   const itemsList = items.map(([title, data]) => title + ' x' + data.qty).join(', ');
   
   let prefix = 'BHU';
   if (cartType === 'food') prefix = 'FD';
   else if (cartType === 'medicine') prefix = 'MED';

   const order = {
    id: prefix + '-' + Math.floor(1000 + Math.random() * 9000),
    items: itemsList,
    total: grandTotal,
    date: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    status: 'Preparing',
    paymentMethod: selectedPaymentMethod,
    address: selectedAddress ? selectedAddress.fullAddress : "Shivaji Nagar, Bhusawal",
    lat: selectedAddress ? selectedAddress.lat : 21.0520,
    lng: selectedAddress ? selectedAddress.lng : 75.7980
   };

   function placeOrderAndRedirect() {
    const orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
    orders.unshift(order);
    localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
    localStorage.setItem('bhusawal_active_order', JSON.stringify(order));

    const pendingOrders = JSON.parse(localStorage.getItem('pending_rider_orders') || '[]');
    const newRiderOrder = {
      id: 'ORD-' + Math.floor(100000 + Math.random() * 900000),
      timestamp: new Date().toLocaleString(),
      customerName: "Sahil (Bhusawal Resident)",
      address: selectedAddress ? selectedAddress.fullAddress : "Shivaji Nagar, Bhusawal",
      lat: selectedAddress ? selectedAddress.lat : 21.0520,
      lng: selectedAddress ? selectedAddress.lng : 75.7980,
      phone: "+91 74980 71274",
      items: itemsList,
      totalAmount: grandTotal,
      paymentMethod: selectedPaymentMethod,
      status: "PENDING_ACCEPTANCE",
      storeName: "Bhusawal Express Store",
      storeAddress: "Station Road, Bhusawal",
      riderEarning: 50 + selectedTip
    };
    pendingOrders.unshift(newRiderOrder);
    localStorage.setItem('pending_rider_orders', JSON.stringify(pendingOrders));
    localStorage.setItem('last_active_order', JSON.stringify(newRiderOrder));
    localStorage.removeItem(cartKey);

    // Broadcast Real-time event across tabs
    if (window.BhusawalRealtime) {
      window.BhusawalRealtime.emit('new-order', newRiderOrder);
    }

    // Redirect to live tracking page
    window.location.href = '/track_order';
   }

   if (selectedPaymentMethod === 'UPI') {
    // Show UPI scan modal
    const qrImage = document.getElementById('upi-qr-image');
    qrImage.src = 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=upi://pay?pa=bhusawalconnect@okaxis%26pn=BhusawalConnect%26am=' + grandTotal + '%26cu=INR';
    const modal = document.getElementById('upi-modal');
    modal.classList.remove('hidden');

    document.getElementById('btn-cancel-upi').addEventListener('click', () => {
     modal.classList.add('hidden');
     clearTimeout(upiTimeout);
    });

    upiTimeout = setTimeout(() => {
     placeOrderAndRedirect();
    }, 3000);
   } else {
    placeOrderAndRedirect();
   }
  });

  // Initial render
  renderCartItems();
  renderRecommendations();
  renderCheckoutAddresses();
 </script>
