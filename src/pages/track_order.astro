---
import Switcher from '../components/Switcher.astro';
---

<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Live Delivery Tracking - Bhusawal Connect</title>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <!-- Leaflet Map CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <script src="/assets/realtime_sync.js" is:inline></script>

  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f4f6f8; color: #1a1c1c; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    
    .pulse-ring-purple {
      position: relative;
    }
    .pulse-ring-purple::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      background: rgba(124, 58, 237, 0.2);
      animation: pulse-ring-anim 2s infinite ease-out;
    }
    @keyframes pulse-ring-anim {
      0% { transform: scale(0.5); opacity: 1; }
      100% { transform: scale(1.5); opacity: 0; }
    }
    .custom-rider-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body class="bg-[#f4f6f8] min-h-screen text-slate-900 pb-20">

  <!-- Header -->
  <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-neutral-200/80 px-4 py-3">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/orders" class="p-2 hover:bg-neutral-100 rounded-full transition-all">
          <span class="material-symbols-outlined text-neutral-800">arrow_back</span>
        </a>
        <div>
          <h1 class="text-sm font-black text-neutral-900 leading-tight">Live Delivery Tracking</h1>
          <p class="text-[10px] font-bold text-neutral-500" id="header-order-id">Order ID: #ORD-784920</p>
        </div>
      </div>
      <a href="tel:7498071274" class="border border-purple-200 text-purple-700 bg-purple-50 hover:bg-purple-100 font-extrabold text-xs px-3 py-1.5 rounded-full flex items-center gap-1 transition-all active:scale-95">
        <span class="material-symbols-outlined text-sm">headset_mic</span> Support
      </a>
    </div>
  </header>

  <!-- Realtime Toast Banner -->
  <div id="toast-notification" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-md bg-neutral-900 text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between gap-3 hidden animate-in slide-in-from-top duration-300">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="material-symbols-outlined text-emerald-400 text-xl" id="toast-icon">local_shipping</span>
      <p class="text-xs font-extrabold truncate" id="toast-msg">Rider is assigned to your order</p>
    </div>
    <span class="text-[10px] font-black bg-white/20 px-2 py-0.5 rounded-full uppercase">LIVE</span>
  </div>

  <main class="max-w-md mx-auto relative">

    <!-- Floating Top Status Pill Card -->
    <div class="px-4 pt-3 relative z-20 space-y-2">
      <!-- 300m / 100m Proximity Alert Banner -->
      <div id="rider-nearby-alert" class="hidden bg-amber-500 text-slate-950 font-black text-xs px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 animate-bounce border border-amber-300">
        <span class="material-symbols-outlined text-lg">notifications_active</span>
        <span id="nearby-alert-text">Your Bhusawal Connect rider is nearby (&lt;300m). Please be ready to receive your order!</span>
      </div>

      <div class="bg-white rounded-3xl p-4 shadow-xl border border-neutral-100 flex items-center justify-between gap-3 animate-in slide-in-from-top-4 duration-300">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-2xl shrink-0 border border-purple-200/60 shadow-sm">
            🛵
          </div>
          <div class="min-w-0 flex-1">
            <h2 id="top-status-title" class="text-sm font-black text-neutral-900 truncate">Huzaifa is on the way</h2>
            <p id="top-status-sub" class="text-[11px] font-bold text-neutral-500 truncate mt-0.5">Rider is moving towards your doorstep</p>
          </div>
        </div>
        <div id="top-eta-container" class="bg-purple-100/80 border border-purple-200 text-purple-800 px-3 py-2 rounded-2xl text-center shrink-0">
          <span id="top-eta-mins" class="text-sm font-black block leading-none">8 mins</span>
          <span class="text-[9px] font-black uppercase tracking-wider block mt-0.5 text-purple-600">away</span>
        </div>
      </div>
    </div>

    <!-- Live Map Container of Bhusawal -->
    <div class="h-[55vh] w-full bg-[#e5e9ec] relative mt-3 z-10 overflow-hidden" id="bhusawal-map">
      <!-- Floating Right Controls -->
      <div class="absolute right-4 bottom-10 z-20 flex flex-col gap-2.5">
        <button id="btn-recenter-map" class="w-10 h-10 bg-white rounded-full shadow-xl border border-neutral-200/80 flex items-center justify-center text-neutral-700 hover:bg-neutral-50 active:scale-95 transition-all" title="Recenter Map">
          <span class="material-symbols-outlined text-lg font-bold">my_location</span>
        </button>
      </div>
    </div>

    <!-- Bottom Sheet Drawer -->
    <div class="bg-white rounded-t-3xl -mt-6 relative z-30 px-4 pt-4 pb-12 shadow-[0_-10px_30px_rgba(0,0,0,0.08)] border-t border-neutral-100 space-y-4">
      
      <div class="w-12 h-1 bg-neutral-200 rounded-full mx-auto mb-2"></div>

      <!-- Rider Profile Card -->
      <div class="flex items-center justify-between bg-neutral-50 p-3.5 rounded-2xl border border-neutral-200/80">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-purple-900 text-white flex items-center justify-center font-black text-xl shadow-md border-2 border-purple-400 shrink-0">
            👨‍✈️
          </div>
          <div>
            <h3 id="rider-name" class="text-sm font-black text-neutral-900">Huzaifa Shaikh</h3>
            <p class="text-[10px] text-neutral-500 font-bold mt-0.5">Vehicle: MH-19-BS-2026 (EV Bike)</p>
            <div class="flex items-center gap-1 text-[10px] text-amber-500 font-black mt-0.5">
              <span>★ 4.9</span>
              <span class="text-neutral-400 font-normal">(320+ deliveries)</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a id="btn-call-rider" href="tel:7498071274" class="w-10 h-10 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl flex items-center justify-center active:scale-95 transition-all shadow-md" title="Call Rider">
            <span class="material-symbols-outlined text-lg">call</span>
          </a>
          <a id="btn-chat-rider" href="https://wa.me/917498071274?text=Hi%20Huzaifa,%20regarding%20my%20Bhusawal%20Connect%20order" target="_blank" class="w-10 h-10 bg-purple-600 hover:bg-purple-700 text-white rounded-xl flex items-center justify-center active:scale-95 transition-all shadow-md" title="Chat on WhatsApp">
            <span class="material-symbols-outlined text-lg">chat</span>
          </a>
        </div>
      </div>

      <!-- Live ETA Banner -->
      <div id="bottom-eta-banner" class="bg-purple-50 border border-purple-200/80 rounded-2xl p-3.5 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center text-sm font-black shrink-0">
          ⚡
        </div>
        <p class="text-xs font-bold text-neutral-800 leading-snug">
          Your order is on the way and will reach you in <span id="banner-eta-text" class="font-black text-purple-700">8 mins</span>
        </p>
      </div>

      <!-- Delivery Completion Banner -->
      <div id="delivery-completed-banner" class="hidden bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-3xl p-5 shadow-xl space-y-3 text-center border border-emerald-400/30">
        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto text-2xl shadow-inner border border-white/40">
          🎉
        </div>
        <div>
          <h2 class="text-base font-black">Order Delivered Successfully!</h2>
          <p class="text-xs text-emerald-100 font-bold mt-1">
            Thank you for using Bhusawal Connect! Your delivery partner Huzaifa has delivered your order.
          </p>
        </div>
        <a href="/home" class="block w-full bg-white text-emerald-800 font-black text-xs py-3 rounded-2xl shadow-lg hover:bg-emerald-50 active:scale-95 transition-all mt-2">
          Back to Home Page 🛒
        </a>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-2 gap-3 pt-1">
        <a href="/home" class="w-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all">
          Back to Home
        </a>
        <a href="/grocery" class="w-full bg-[#0c831f] hover:bg-emerald-700 text-white font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all shadow-md">
          Shop More 🛒
        </a>
      </div>

    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Read order info
      let activeOrder = {};
      try {
        activeOrder = JSON.parse(localStorage.getItem('bhusawal_active_order') || localStorage.getItem('last_active_order') || '{}');
      } catch(e) {}

      if (activeOrder.id) {
        document.getElementById('header-order-id').textContent = 'Order ID: #' + activeOrder.id;
      }

      // Store Coords & Destination Coords
      const storeLat = 21.0455;
      const storeLng = 75.7858;
      const custLat = parseFloat(activeOrder.lat) || 21.0520;
      const custLng = parseFloat(activeOrder.lng) || 75.7980;

      // Toast Notification Helper
      function showToast(msg) {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-msg');
        if (toast && text) {
          text.textContent = msg;
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 4000);
        }
      }

      // Initialize Leaflet Map
      let map = null;
      try {
        map = L.map('bhusawal-map', { 
          zoomControl: false, 
          attributionControl: false,
          fadeAnimation: false
        }).setView([21.0487, 75.7919], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19
        }).addTo(map);

        setTimeout(() => map.invalidateSize(), 200);
      } catch(e) {
        console.error(e);
      }

      if (map) {
        // Store Marker
        L.marker([storeLat, storeLng], {
          icon: L.divIcon({
            html: '<div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg border border-white text-sm">🏪</div>',
            iconSize: [32, 32],
            iconAnchor: [16, 16]
          })
        }).addTo(map).bindPopup("Bhusawal Express Store");

        // Customer Destination Marker
        L.marker([custLat, custLng], {
          icon: L.divIcon({
            className: 'custom-pin-icon',
            html: `<div class="bg-slate-900 text-white px-2.5 py-1 rounded-full text-[10px] font-black shadow-xl border border-white flex items-center gap-1">
                     <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                     <span>Delivery Spot</span>
                   </div>`,
            iconSize: [90, 30],
            iconAnchor: [45, 15]
          })
        }).addTo(map).bindPopup(activeOrder.address || "Customer House");

        // Route Polyline
        const waypoints = [
          [storeLat, storeLng],
          [21.0470, 75.7890],
          [21.0495, 75.7930],
          [custLat, custLng]
        ];
        const routeLine = L.polyline(waypoints, {
          color: '#7c3aed',
          weight: 6,
          opacity: 0.9,
          lineCap: 'round'
        }).addTo(map);

        map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });

        // Rider Marker
        const riderMarker = L.marker([storeLat, storeLng], {
          icon: L.divIcon({
            className: 'custom-rider-icon',
            html: `<div class="pulse-ring-purple w-11 h-11 rounded-full bg-purple-700 text-white flex items-center justify-center border-2 border-white shadow-2xl text-xl font-bold">🛵</div>`,
            iconSize: [44, 44],
            iconAnchor: [22, 22]
          })
        }).addTo(map);

        document.getElementById('btn-recenter-map')?.addEventListener('click', () => {
          map.invalidateSize();
          map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });
        });

        // Dynamic Movement Simulation & Realtime Broadcast Listener
        let progressStep = 0;
        const totalSteps = 240;
        
        const simInterval = setInterval(() => {
          progressStep++;
          const ratio = progressStep / totalSteps;

          const lat = storeLat + (custLat - storeLat) * ratio;
          const lng = storeLng + (custLng - storeLng) * ratio;
          riderMarker.setLatLng([lat, lng]);

          const remainingMins = Math.max(1, Math.ceil(8 * (1 - ratio)));
          document.getElementById('top-eta-mins').textContent = remainingMins + ' mins';
          document.getElementById('banner-eta-text').textContent = remainingMins + ' mins';

          if (ratio > 0.8 && ratio < 0.95) {
            document.getElementById('rider-nearby-alert')?.classList.remove('hidden');
          }

          if (ratio >= 0.98) {
            clearInterval(simInterval);
            onDeliveryComplete();
          }
        }, 300);

        function onDeliveryComplete() {
          document.getElementById('top-status-title').textContent = "Order Delivered!";
          document.getElementById('top-status-sub').textContent = "Huzaifa delivered your order to your doorstep";
          document.getElementById('bottom-eta-banner')?.classList.add('hidden');
          document.getElementById('delivery-completed-banner')?.classList.remove('hidden');
          showToast("🎉 Order Delivered Successfully!");
        }

        // Listen for Realtime Sync events from Rider Dashboard / Admin
        if (window.BhusawalRealtime) {
          window.BhusawalRealtime.on('rider-location', (pos) => {
            if (pos && pos.lat && pos.lng) {
              riderMarker.setLatLng([pos.lat, pos.lng]);
            }
          });

          window.BhusawalRealtime.on('order-status', (data) => {
            if (data && data.status) {
              showToast("Status Update: " + data.status);
              if (data.status === 'DELIVERED') {
                clearInterval(simInterval);
                riderMarker.setLatLng([custLat, custLng]);
                onDeliveryComplete();
              }
            }
          });
        }
      }
    });
  </script>

  <Switcher />
</body>
</html>
