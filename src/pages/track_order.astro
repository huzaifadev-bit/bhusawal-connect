---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Live Delivery Tracking - Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Leaflet & Google Maps JS SDK -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <script src="/assets/google_maps_loader.js" is:inline></script>
  <script src="/assets/google_live_tracker.js" is:inline></script>
  <script src="/assets/realtime_sync.js" is:inline></script>

  <!-- TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF',
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="bg-slate-50 min-h-screen text-slate-900 pb-20 antialiased">

  <!-- TOP HEADER WITH SUPPORT BUTTON -->
  <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-slate-100 px-4 py-3 shadow-xs">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/orders" class="p-2 hover:bg-slate-100 rounded-full transition-all">
          <span class="material-symbols-outlined text-slate-800">arrow_back</span>
        </a>
        <div>
          <h1 class="text-sm font-black text-slate-900 leading-tight">Live Delivery Tracking</h1>
          <p class="text-[10px] font-bold text-slate-500" id="header-order-id">Order ID: #BHU-849201</p>
        </div>
      </div>

      <!-- SUPPORT BUTTON -->
      <a href="tel:7498071274" class="border border-blue-200 text-blueBrand bg-blueLight hover:bg-blue-100 font-extrabold text-xs px-3.5 py-1.5 rounded-full flex items-center gap-1 transition-all active:scale-95 shadow-xs">
        <span class="material-symbols-outlined text-sm">headset_mic</span> Support
      </a>
    </div>
  </header>

  <!-- Realtime Toast Notification Banner -->
  <div id="toast-notification" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-md bg-slate-900 text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between gap-3 hidden animate-in slide-in-from-top duration-300">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="material-symbols-outlined text-blueBrand text-xl" id="toast-icon">local_shipping</span>
      <p class="text-xs font-extrabold truncate" id="toast-msg">Rider is en route to doorstep</p>
    </div>
    <span class="text-[10px] font-black bg-white/20 px-2 py-0.5 rounded-full uppercase">LIVE</span>
  </div>

  <main class="max-w-md mx-auto relative">

    <!-- Floating Top Status Pill Card with ETA -->
    <div class="px-4 pt-3 relative z-20 space-y-2">
      <!-- Proximity Alert Banner -->
      <div id="rider-nearby-alert" class="hidden bg-amber-500 text-slate-950 font-black text-xs px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 animate-bounce border border-amber-300">
        <span class="material-symbols-outlined text-lg">notifications_active</span>
        <span id="nearby-alert-text">Your Bhusawal Connect rider is nearby (&lt;300m). Please be ready to receive your parcel!</span>
      </div>

      <!-- Top Status Card with Live ETA -->
      <div class="bg-white rounded-3xl p-4 shadow-xl border border-slate-100 flex items-center justify-between gap-3 animate-in slide-in-from-top-4 duration-300">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="w-12 h-12 rounded-2xl bg-blueLight text-blueBrand flex items-center justify-center text-2xl shrink-0 border border-blue-200/60 shadow-xs">
            🛵
          </div>
          <div class="min-w-0 flex-1">
            <h2 id="top-status-title" class="text-sm font-black text-slate-900 truncate">Order Received</h2>
            <p id="top-status-sub" class="text-[11px] font-bold text-slate-500 truncate mt-0.5">Order verified & preparing for dispatch</p>
          </div>
        </div>
        <!-- ETA DISPLAY -->
        <div id="top-eta-container" class="bg-blueLight border border-blue-200 text-blueBrand px-3.5 py-2 rounded-2xl text-center shrink-0">
          <span id="top-eta-mins" class="text-sm font-black block leading-none">18 mins</span>
          <span class="text-[9px] font-black uppercase tracking-wider block mt-0.5 text-blueDark">ETA</span>
        </div>
      </div>
    </div>

    <!-- Live Map Container of Bhusawal (Google Maps / Leaflet System) -->
    <div class="h-[48vh] w-full bg-slate-200 relative mt-3 z-10 overflow-hidden" id="bhusawal-map">
      <!-- Floating Right Controls -->
      <div class="absolute right-4 bottom-10 z-20 flex flex-col gap-2.5">
        <button id="btn-recenter-map" class="w-10 h-10 bg-white rounded-full shadow-xl border border-slate-200 flex items-center justify-center text-slate-700 hover:bg-slate-50 active:scale-95 transition-all" title="Recenter Map">
          <span class="material-symbols-outlined text-lg font-bold">my_location</span>
        </button>
      </div>
    </div>

    <!-- Bottom Sheet Drawer -->
    <div class="bg-white rounded-t-3xl -mt-6 relative z-30 px-4 pt-4 pb-12 shadow-2xl border-t border-slate-100 space-y-4">
      
      <div class="w-12 h-1 bg-slate-200 rounded-full mx-auto mb-2"></div>

      <!-- STEP-BY-STEP MEDICINE ORDER TIMELINE BAR -->
      <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black text-blueBrand uppercase tracking-wider block" id="progress-bar-label">ORDER TIMELINE</span>
          <span class="text-[10px] font-extrabold text-slate-500" id="progress-bar-step-num">Step 1 of 6</span>
        </div>
        
        <!-- 6-STEP TIMELINE GRID -->
        <div class="grid grid-cols-6 gap-1 text-center" id="tracking-steps-bar">
          <!-- Dynamically Populated for Medicine Order (6 steps) -->
        </div>
      </div>

      <!-- LIVE RIDER CARD (WITH CALL RIDER BUTTON) -->
      <div class="flex items-center justify-between bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-blueBrand text-white flex items-center justify-center font-black text-xl shadow-md border-2 border-white shrink-0">
            👨‍✈️
          </div>
          <div>
            <h3 id="rider-name" class="text-sm font-black text-slate-900">Rahul Patil (Fleet Captain)</h3>
            <p class="text-[10px] text-slate-500 font-bold mt-0.5">Vehicle: MH-19-AX-4892 (EV Bike)</p>
            <div class="flex items-center gap-1 text-[10px] text-amber-500 font-black mt-0.5">
              <span>★ 4.9 Rating</span>
              <span class="text-slate-400 font-normal">(420+ deliveries)</span>
            </div>
          </div>
        </div>

        <!-- CALL RIDER & WHATSAPP BUTTONS -->
        <div class="flex items-center gap-2">
          <a id="btn-call-rider" href="tel:7498071274" class="w-10 h-10 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl flex items-center justify-center active:scale-95 transition-all shadow-md" title="Call Rider">
            <span class="material-symbols-outlined text-lg">call</span>
          </a>
          <a id="btn-chat-rider" href="https://wa.me/917498071274?text=Hi%20Rahul,%20regarding%20my%20Bhusawal%20Connect%20order" target="_blank" class="w-10 h-10 bg-blueBrand hover:bg-blueDark text-white rounded-xl flex items-center justify-center active:scale-95 transition-all shadow-md" title="Chat on WhatsApp">
            <span class="material-symbols-outlined text-lg">chat</span>
          </a>
        </div>
      </div>

      <!-- Live ETA Banner -->
      <div id="bottom-eta-banner" class="bg-blueLight border border-blue-200/80 rounded-2xl p-3.5 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-blueBrand text-white flex items-center justify-center text-sm font-black shrink-0">
          ⚡
        </div>
        <p class="text-xs font-bold text-slate-800 leading-snug">
          Your order is being processed and will reach you in <span id="banner-eta-text" class="font-black text-blueBrand">18 mins</span>
        </p>
      </div>

      <!-- Delivery Completion Banner -->
      <div id="delivery-completed-banner" class="hidden bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-3xl p-5 shadow-xl space-y-3 text-center border border-emerald-400/30">
        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto text-2xl shadow-inner border border-white/40">
          🎉
        </div>
        <div>
          <h2 class="text-base font-black">Order Delivered Successfully!</h2>
          <p class="text-xs text-emerald-100 font-bold mt-1">
            Thank you for ordering with Bhusawal Connect! Your items have been delivered safely.
          </p>
        </div>
        <a href="/medicines" class="block w-full bg-white text-emerald-800 font-black text-xs py-3 rounded-2xl shadow-lg hover:bg-emerald-50 active:scale-95 transition-all mt-2">
          Order More Medicines 💊
        </a>
      </div>

      <!-- ORDER SUMMARY & ITEMS BREAKDOWN CARD -->
      <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-3" id="order-summary-card">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-2">Order Summary</h4>
        <div id="order-summary-items-list" class="space-y-2 text-xs font-bold text-slate-700">
          <!-- Dynamically populated -->
        </div>
        <div class="pt-2 border-t border-slate-200 flex items-center justify-between text-xs font-black text-slate-900">
          <span>Total Paid (incl. ₹30 Delivery)</span>
          <span id="order-summary-total" class="text-blueBrand text-sm font-extrabold">₹0</span>
        </div>
      </div>

      <!-- Navigation Action Buttons -->
      <div class="grid grid-cols-2 gap-3 pt-1">
        <a href="/home" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all">
          Back to Home
        </a>
        <a href="/medicines" class="w-full bg-blueBrand hover:bg-blueDark text-white font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all shadow-md">
          Shop Medicines 💊
        </a>
      </div>

    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let activeOrder = {};
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const reqId = urlParams.get('id');
        const orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');

        if (reqId) {
          activeOrder = orders.find(o => o.id === reqId) || {};
        }
        if (!activeOrder.id) {
          activeOrder = JSON.parse(localStorage.getItem('bhusawal_active_order') || localStorage.getItem('last_active_order') || '{}');
        }
      } catch(e) {}

      if (activeOrder.id) {
        document.getElementById('header-order-id').textContent = 'Order ID: #' + activeOrder.id;
      }

      // EXACT 6-STEP MEDICINE ORDER TIMELINE AS REQUESTED:
      // 1. Order Received
      // 2. Prescription Verified (if required)
      // 3. Medicines Packed
      // 4. Picked Up
      // 5. Out For Delivery
      // 6. Delivered

      const MED_TIMELINE_STEPS = [
        { step: 1, label: 'Order Received', icon: '📥' },
        { step: 2, label: 'Prescription Verified', icon: '✅' },
        { step: 3, label: 'Medicines Packed', icon: '📦' },
        { step: 4, label: 'Picked Up', icon: '🛵' },
        { step: 5, label: 'Out For Delivery', icon: '⚡' },
        { step: 6, label: 'Delivered', icon: '🎉' }
      ];

      const stepsBar = document.getElementById('tracking-steps-bar');
      const stepNumLabel = document.getElementById('progress-bar-step-num');
      const barLabel = document.getElementById('progress-bar-label');

      if (barLabel) barLabel.textContent = "ORDER TIMELINE";

      function renderStepBar(currentStep) {
        if (!stepsBar) return;
        if (stepNumLabel) stepNumLabel.textContent = `Step ${currentStep} of 6`;

        let sHtml = '';
        MED_TIMELINE_STEPS.forEach(s => {
          const isDone = currentStep >= s.step;
          const isCurrent = currentStep === s.step;
          sHtml += `
            <div class="step-box flex flex-col items-center gap-1 ${isDone ? 'opacity-100' : 'opacity-40'}" data-step="${s.step}">
              <div class="w-7 h-7 rounded-full ${isCurrent ? 'bg-blueBrand text-white font-black animate-pulse ring-2 ring-blue-200' : (isDone ? 'bg-emerald-500 text-white font-black' : 'bg-slate-200 text-slate-500')} flex items-center justify-center text-xs shadow-xs">
                ${isDone && !isCurrent ? '✓' : s.icon}
              </div>
              <span class="text-[8px] sm:text-[9px] ${isCurrent ? 'font-black text-blueBrand' : (isDone ? 'font-black text-slate-900' : 'font-bold text-slate-400')} leading-tight">
                ${s.label}
              </span>
            </div>
          `;
        });
        stepsBar.className = "grid grid-cols-6 gap-1 text-center";
        stepsBar.innerHTML = sHtml;
      }

      function getMedicineStepNum(status) {
        if (!status || status === 'Order Received' || status === 'Confirmed' || status === 'Prescription Uploaded') return 1;
        if (status === 'Under Verification' || status === 'Verified' || status === 'Prescription Verified') return 2;
        if (status === 'Medicines Packed' || status === 'Packed') return 3;
        if (status === 'Picked Up') return 4;
        if (status === 'Out For Delivery' || status === 'Out for Delivery') return 5;
        if (status === 'Delivered') return 6;
        return 2;
      }

      const initialStep = getMedicineStepNum(activeOrder.status);
      renderStepBar(initialStep);

      // Render Order Summary
      if (activeOrder.items && Array.isArray(activeOrder.items) && activeOrder.items.length > 0) {
        const listEl = document.getElementById('order-summary-items-list');
        if (listEl) {
          let sHtml = '';
          activeOrder.items.forEach(item => {
            const qty = item.quantity || 1;
            const price = parseFloat(item.price || item.mrp || 0);
            sHtml += `
              <div class="flex items-center justify-between text-xs">
                <span>${item.name} × ${qty}</span>
                <span class="font-black">₹${Math.round(price * qty)}</span>
              </div>
            `;
          });
          listEl.innerHTML = sHtml;
        }
      } else {
        const listEl = document.getElementById('order-summary-items-list');
        if (listEl) {
          listEl.innerHTML = `
            <div class="text-xs font-bold text-slate-600 bg-blue-50 p-2.5 rounded-xl border border-blue-100">
              📄 Prescription Document Attached (${activeOrder.fileName || 'Doctor_Prescription.pdf'})
              ${activeOrder.notes ? '<p class="text-[11px] text-slate-500 font-normal mt-0.5">Note: ' + activeOrder.notes + '</p>' : ''}
            </div>
          `;
        }
      }

      if (activeOrder.total) {
        const totalEl = document.getElementById('order-summary-total');
        if (totalEl) totalEl.textContent = '₹' + activeOrder.total;
      }

      const storeLat = 21.0455;
      const storeLng = 75.7858;
      const custLat = parseFloat(activeOrder.lat) || 21.0520;
      const custLng = parseFloat(activeOrder.lng) || 75.7980;

      function showToast(msg) {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-msg');
        if (toast && text) {
          text.textContent = msg;
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 4000);
        }
      }

      // Initialize Google Live Tracker Engine (Shared across Food, Grocery & Medicine)
      const tracker = new window.GoogleLiveTracker('bhusawal-map', {
        storePos: { lat: storeLat, lng: storeLng },
        custPos: { lat: custLat, lng: custLng },
        onNotification: (type, msg) => {
          showToast(msg);
          if (type === '300M_NEARBY' || type === '100M_DOORSTEP') {
            document.getElementById('rider-nearby-alert')?.classList.remove('hidden');
            const alertText = document.getElementById('nearby-alert-text');
            if (alertText) alertText.textContent = msg;
          }
          if (type === 'DELIVERED') {
            onDeliveryComplete();
          }
        },
        onEtaUpdate: (etaText, distText) => {
          document.getElementById('top-eta-mins').textContent = etaText;
          document.getElementById('banner-eta-text').textContent = etaText + ' (' + distText + ')';
        },
        onStatusChange: (status) => {
          const titleEl = document.getElementById('top-status-title');
          const subEl = document.getElementById('top-status-sub');
          
          if (status === 'ACCEPTED' || status === 'Order Received') {
            if (titleEl) titleEl.textContent = "Order Received";
            if (subEl) subEl.textContent = "Partner pharmacy accepted your order";
            renderStepBar(1);
          } else if (status === 'PREPARING_FOOD' || status === 'Under Verification' || status === 'Verified' || status === 'Prescription Verified') {
            if (titleEl) titleEl.textContent = "Prescription Verified";
            if (subEl) subEl.textContent = "Certified pharmacist verified your prescription";
            renderStepBar(2);
          } else if (status === 'FOOD_READY' || status === 'Medicines Packed') {
            if (titleEl) titleEl.textContent = "Medicines Packed";
            if (subEl) subEl.textContent = "Sealed at pharmacy & ready for pickup";
            renderStepBar(3);
          } else if (status === 'PICKED_UP') {
            if (titleEl) titleEl.textContent = "Picked Up";
            if (subEl) subEl.textContent = "Rider collected your medicine parcel";
            renderStepBar(4);
          } else if (status === 'OUT_FOR_DELIVERY') {
            if (titleEl) titleEl.textContent = "Out For Delivery";
            if (subEl) subEl.textContent = "Rider is delivering to your doorstep";
            renderStepBar(5);
          } else if (status === 'DELIVERED') {
            onDeliveryComplete();
          }
        }
      });

      function onDeliveryComplete() {
        renderStepBar(6);
        document.getElementById('top-status-title').textContent = "Order Delivered!";
        document.getElementById('top-status-sub').textContent = "Rider safely delivered your order to your doorstep";
        document.getElementById('bottom-eta-banner')?.classList.add('hidden');
        document.getElementById('delivery-completed-banner')?.classList.remove('hidden');
        showToast("🎉 Order Delivered Successfully!");
      }
    });
  </script>

  <Switcher />
</body>
</html>
