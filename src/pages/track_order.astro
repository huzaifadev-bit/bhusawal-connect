---
import Switcher from '../components/Switcher.astro';
---

<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Live Tracking - Bhusawal Connect</title>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline="" />
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <!-- Leaflet Map CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f4f6f8; color: #1a1c1c; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    
    .pulse-ring-purple {
      position: relative;
    }
    .pulse-ring-purple::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      background: rgba(124, 58, 237, 0.2);
      animation: pulse-ring-anim 2s infinite ease-out;
    }
    @keyframes pulse-ring-anim {
      0% { transform: scale(0.5); opacity: 1; }
      100% { transform: scale(1.5); opacity: 0; }
    }
    .custom-rider-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body class="bg-[#f4f6f8] min-h-screen text-slate-900 pb-20">

  <!-- Header -->
  <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-neutral-200/80 px-4 py-3">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/orders" class="p-2 hover:bg-neutral-100 rounded-full transition-all">
          <span class="material-symbols-outlined text-neutral-800">arrow_back</span>
        </a>
        <div>
          <h1 class="text-sm font-black text-neutral-900 leading-tight">Live tracking</h1>
          <p class="text-[10px] font-bold text-neutral-500" id="header-order-id">Order ID: #ORD-784920</p>
        </div>
      </div>
      <button class="border border-purple-200 text-purple-700 bg-purple-50 hover:bg-purple-100 font-extrabold text-xs px-3 py-1.5 rounded-full flex items-center gap-1 transition-all active:scale-95">
        <span class="material-symbols-outlined text-sm">headset_mic</span> Support
      </button>
    </div>
  </header>

  <main class="max-w-md mx-auto relative">

    <!-- Floating Top Status Pill Card -->
    <div class="px-4 pt-3 relative z-20 space-y-2">
      <!-- 300m / 100m Proximity Alert Banner -->
      <div id="rider-nearby-alert" class="hidden bg-amber-500 text-slate-950 font-black text-xs px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 animate-bounce border border-amber-300">
        <span class="material-symbols-outlined text-lg">notifications_active</span>
        <span id="nearby-alert-text">Your Bhusawal Connect rider is nearby (&lt;300m). Please be ready to receive your order!</span>
      </div>

      <div class="bg-white rounded-3xl p-4 shadow-xl border border-neutral-100 flex items-center justify-between gap-3 animate-in slide-in-from-top-4 duration-300">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-2xl shrink-0 border border-purple-200/60 shadow-sm">
            🛵
          </div>
          <div class="min-w-0 flex-1">
            <h2 id="top-status-title" class="text-sm font-black text-neutral-900 truncate">Huzaifa is on the way</h2>
            <p id="top-status-sub" class="text-[11px] font-bold text-neutral-500 truncate mt-0.5">Rider is on the road, moving towards you</p>
          </div>
        </div>
        <div id="top-eta-container" class="bg-purple-100/80 border border-purple-200 text-purple-800 px-3 py-2 rounded-2xl text-center shrink-0">
          <span id="top-eta-mins" class="text-sm font-black block leading-none">8 mins</span>
          <span class="text-[9px] font-black uppercase tracking-wider block mt-0.5 text-purple-600">away</span>
        </div>
      </div>
    </div>

    <!-- Live Map Container of Bhusawal -->
    <div class="h-[62vh] w-full bg-[#e5e9ec] relative mt-3 z-10 overflow-hidden" id="bhusawal-map">
      <!-- Floating Right Controls like Zepto Image -->
      <div class="absolute right-4 bottom-10 z-20 flex flex-col gap-2.5">
        <button id="btn-recenter-map" class="w-10 h-10 bg-white rounded-full shadow-xl border border-neutral-200/80 flex items-center justify-center text-neutral-700 hover:bg-neutral-50 active:scale-95 transition-all">
          <span class="material-symbols-outlined text-lg font-bold">my_location</span>
        </button>
        <button class="w-10 h-10 bg-white rounded-full shadow-xl border border-neutral-200/80 flex items-center justify-center text-neutral-700 hover:bg-neutral-50 active:scale-95 transition-all">
          <span class="material-symbols-outlined text-lg font-bold">shield</span>
        </button>
      </div>
    </div>

    <!-- Bottom Sheet Drawer -->
    <div class="bg-white rounded-t-3xl -mt-6 relative z-30 px-4 pt-4 pb-12 shadow-[0_-10px_30px_rgba(0,0,0,0.08)] border-t border-neutral-100 space-y-4">
      
      <!-- Drawer Handle -->
      <div class="w-12 h-1 bg-neutral-200 rounded-full mx-auto mb-2"></div>

      <!-- Rider Profile & Call Button -->
      <div class="flex items-center justify-between bg-neutral-50/80 p-3 rounded-2xl border border-neutral-100">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-purple-900 text-white flex items-center justify-center font-black text-lg shadow-md border-2 border-purple-400 shrink-0">
            👨‍✈️
          </div>
          <div>
            <h3 id="rider-name" class="text-sm font-black text-neutral-900">Huzaifa Shaikh</h3>
            <p class="text-[10px] text-neutral-500 font-bold mt-0.5">Your Bhusawal Connect Rider</p>
            <div class="flex items-center gap-1 text-[10px] text-amber-500 font-black mt-0.5">
              <span>★ 4.8</span>
              <span class="text-neutral-400 font-normal">(230+ deliveries)</span>
            </div>
          </div>
        </div>
        <a id="btn-call-rider" href="tel:7498071274" class="border-2 border-purple-600 text-purple-700 hover:bg-purple-50 px-3.5 py-2 rounded-xl text-xs font-black flex items-center gap-1.5 active:scale-95 transition-all shadow-sm">
          <span class="material-symbols-outlined text-sm">call</span> Call rider
        </a>
      </div>

      <!-- Live ETA Banner -->
      <div id="bottom-eta-banner" class="bg-purple-50 border border-purple-200/80 rounded-2xl p-3.5 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center text-sm font-black shrink-0">
          🛡️
        </div>
        <p class="text-xs font-bold text-neutral-800 leading-snug">
          Your order is on the way and will reach you in <span id="banner-eta-text" class="font-black text-purple-700">8 mins</span>
        </p>
      </div>

      <!-- Delivery Completion Celebration Banner (Hidden until delivered) -->
      <div id="delivery-completed-banner" class="hidden bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-3xl p-5 shadow-xl space-y-3 text-center border border-emerald-400/30">
        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto text-2xl shadow-inner border border-white/40">
          🎉
        </div>
        <div>
          <h2 class="text-base font-black">Thank You for Shopping with Bhusawal Connect!</h2>
          <p class="text-xs text-emerald-100 font-bold mt-1">
            Your order has been safely delivered to your doorstep. We hope you enjoyed our 10-minute fast service!
          </p>
        </div>

        <a href="/grocery" class="block w-full bg-white text-emerald-800 font-black text-xs py-3 rounded-2xl shadow-lg hover:bg-emerald-50 active:scale-95 transition-all mt-2">
          Shop More Grocery Items 🛒
        </a>
      </div>

      <!-- Items Summary Row -->
      <div class="flex items-center justify-between bg-neutral-50 p-3 rounded-2xl border border-neutral-100 text-xs">
        <div class="flex items-center gap-2">
          <div class="flex -space-x-2 overflow-hidden">
            <img src="https://www.bbassets.com/media/uploads/p/l/306926_4-amul-taaza-toned-milk.jpg" class="inline-block h-7 w-7 rounded-full ring-2 ring-white object-contain bg-white" />
            <img src="https://www.bbassets.com/media/uploads/p/l/102739_10-lays-potato-chips-indias-magic-masala.jpg" class="inline-block h-7 w-7 rounded-full ring-2 ring-white object-contain bg-white" />
          </div>
          <span id="order-items-badge" class="bg-purple-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full">5 items</span>
        </div>
        <a href="/orders" class="text-xs font-black text-purple-700 flex items-center gap-0.5 hover:underline">
          View order details <span class="material-symbols-outlined text-sm">chevron_right</span>
        </a>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-2 gap-3 pt-1">
        <a href="/home" class="w-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all">
          Back to Home
        </a>
        <a href="/grocery" class="w-full bg-[#0c831f] hover:bg-emerald-700 text-white font-black text-xs py-3 rounded-2xl text-center active:scale-95 transition-all shadow-md">
          Shop More 🛒
        </a>
      </div>

    </div>
  </main>

  <script is:inline>
    // Read active order or rider dispatch
    let activeOrder = JSON.parse(localStorage.getItem('active_rider_order') || localStorage.getItem('last_active_order') || '{}');
    if (activeOrder.id) {
      document.getElementById('header-order-id').textContent = 'Order ID: #' + activeOrder.id;
      if (activeOrder.items) {
        document.getElementById('order-items-badge').textContent = (activeOrder.items.split(',').length || 1) + ' items';
      }
    }

    // Bhusawal Real Road Coordinates
    const storeLat = 21.0455;
    const storeLng = 75.7858;
    const custLat = 21.0520;
    const custLng = 75.7980;

    // Initialize Leaflet Map centered on Bhusawal with Zero-Blank Guarantee
    const mapContainer = document.getElementById('bhusawal-map');
    let map = null;

    try {
      map = L.map('bhusawal-map', { 
        zoomControl: false, 
        attributionControl: false,
        fadeAnimation: false
      }).setView([21.0487, 75.7919], 15);

      // Primary Tile Layer: OpenStreetMap Standard Vector Tiles
      const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        subdomains: ['a', 'b', 'c']
      }).addTo(map);

      // Secondary Backup Tile Layer fallback
      const cartoLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19
      });

      osmLayer.on('tileerror', function() {
        console.warn("OSM tile error, switching to CartoDB fallback layer.");
        map.removeLayer(osmLayer);
        cartoLayer.addTo(map);
      });

      // Invalidate map size multiple times to ensure 100% tile render after DOM layout calculations
      map.invalidateSize();
      setTimeout(() => { map.invalidateSize(); }, 100);
      setTimeout(() => { map.invalidateSize(); }, 500);
      window.addEventListener('resize', () => { map.invalidateSize(); });

    } catch (e) {
      console.error("Map initialization error:", e);
      if (mapContainer) {
        mapContainer.innerHTML = '<div class="p-6 text-center text-xs font-bold text-slate-600">Map loading error. Please check your internet connection or reload the page.</div>';
      }
    }

    if (map) {
      // Custom Map Icons
      const createRiderIcon = () => {
        return L.divIcon({
          className: 'custom-rider-icon',
          html: `<div class="pulse-ring-purple w-11 h-11 rounded-full bg-purple-700 text-white flex items-center justify-center border-2 border-white shadow-2xl text-xl font-bold">
                   🛵
                 </div>`,
          iconSize: [44, 44],
          iconAnchor: [22, 22]
        });
      };

      const createPinIcon = (label) => {
        return L.divIcon({
          className: 'custom-pin-icon',
          html: `<div class="bg-slate-900 text-white px-2.5 py-1 rounded-full text-[10px] font-black shadow-xl border border-white flex items-center gap-1">
                   <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
                   <span>${label}</span>
                 </div>`,
          iconSize: [90, 30],
          iconAnchor: [45, 15]
        });
      };

      // Store Marker
      const storeMarker = L.marker([storeLat, storeLng], {
        icon: L.divIcon({
          html: '<div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg border border-white text-sm">🏪</div>',
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        })
      }).addTo(map).bindPopup("Bhusawal Express Store");

      // Customer Destination Marker
      const destPin = L.marker([custLat, custLng], {
        icon: createPinIcon("Destination")
      }).addTo(map).bindPopup("Customer House (Shivaji Nagar)");

      // Route Polyline (Vibrant Purple Line)
      const routeWaypoints = [
        [storeLat, storeLng],
        [21.0470, 75.7890],
        [21.0495, 75.7930],
        [21.0510, 75.7955],
        [custLat, custLng]
      ];

      const routePolyline = L.polyline(routeWaypoints, {
        color: '#7c3aed',
        weight: 6,
        opacity: 0.9,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);

      map.fitBounds(routePolyline.getBounds(), { padding: [50, 50] });

      // Rider Marker
      const riderMarker = L.marker([storeLat, storeLng], {
        icon: createRiderIcon()
      }).addTo(map);

      // Recenter button click
      document.getElementById('btn-recenter-map')?.addEventListener('click', () => {
        map.invalidateSize();
        map.fitBounds(routePolyline.getBounds(), { padding: [50, 50] });
      });

      // Live 2-3 Second Interval Movement Simulation & ETA Calculator
      let progressStep = 0;
      const totalSteps = 300;
      const startMins = 8;

      const interval = setInterval(() => {
        progressStep++;
        const ratio = progressStep / totalSteps;

        // Smooth rider marker progression
        const lat = storeLat + (custLat - storeLat) * ratio;
        const lng = storeLng + (custLng - storeLng) * ratio;
        riderMarker.setLatLng([lat, lng]);

        // Decreasing ETA Calculation
        const remainingMins = Math.max(1, Math.ceil(startMins * (1 - ratio)));

        const topEtaMins = document.getElementById('top-eta-mins');
        const bannerEtaText = document.getElementById('banner-eta-text');

        if (topEtaMins) topEtaMins.textContent = remainingMins + ' mins';
        if (bannerEtaText) bannerEtaText.textContent = remainingMins + ' mins';

        // Proximity Banners (<300m / <100m)
        const alertBox = document.getElementById('rider-nearby-alert');
        const alertText = document.getElementById('nearby-alert-text');

        if (ratio > 0.7 && ratio < 0.95) {
          if (alertBox) {
            alertBox.classList.remove('hidden');
            if (ratio > 0.88) {
              if (alertText) alertText.textContent = "Your Bhusawal Connect rider Huzaifa is at your doorstep (<100m)! Please receive your order.";
            } else {
              if (alertText) alertText.textContent = "Your Bhusawal Connect rider Huzaifa is nearby (<300m). Please be ready!";
            }
          }
        }

        // Status Updates
        if (ratio > 0.4 && ratio < 0.85) {
          const titleEl = document.getElementById('top-status-title');
          const subEl = document.getElementById('top-status-sub');
          if (titleEl) titleEl.textContent = "Huzaifa is near your locality";
          if (subEl) subEl.textContent = "Approaching Shivaji Nagar, Bhusawal";
        } else if (ratio >= 0.98) {
          // Delivered!
          clearInterval(interval);

          const titleEl = document.getElementById('top-status-title');
          const subEl = document.getElementById('top-status-sub');
          if (titleEl) titleEl.textContent = "Order Delivered!";
          if (subEl) subEl.textContent = "Huzaifa delivered to your doorstep";

          if (topEtaMins) topEtaMins.textContent = "0 mins";
          const etaBox = document.getElementById('top-eta-container');
          if (etaBox) etaBox.className = "bg-emerald-100 border border-emerald-300 text-emerald-800 px-3 py-2 rounded-2xl text-center shrink-0";

          const etaBanner = document.getElementById('bottom-eta-banner');
          if (etaBanner) etaBanner.classList.add('hidden');

          const celebrationBanner = document.getElementById('delivery-completed-banner');
          if (celebrationBanner) {
            celebrationBanner.classList.remove('hidden');
            celebrationBanner.scrollIntoView({ behavior: 'smooth' });
          }
        }
      }, 100);

      // Listen to cross-tab rider status changes
      window.addEventListener('storage', (e) => {
        if (e.key === 'active_rider_order' || e.key === 'last_active_order') {
          const order = JSON.parse(e.newValue || '{}');
          if (order.status === 'DELIVERED') {
            clearInterval(interval);
            riderMarker.setLatLng([custLat, custLng]);
            const titleEl = document.getElementById('top-status-title');
            const subEl = document.getElementById('top-status-sub');
            if (titleEl) titleEl.textContent = "Order Delivered!";
            if (subEl) subEl.textContent = "Huzaifa delivered to your doorstep";
            const etaBanner = document.getElementById('bottom-eta-banner');
            if (etaBanner) etaBanner.classList.add('hidden');
            const celebrationBanner = document.getElementById('delivery-completed-banner');
            if (celebrationBanner) celebrationBanner.classList.remove('hidden');
          }
        }
      });
    }</script>

  <Switcher />
</body>
</html>
