        badge: 'HEALTH & ESSENTIALS',
        categories: ['Personal Care', 'Home Cleaning & Household', 'Baby, Health & Specialty', 'Snacks & Confectionery']
      }
    };

    // Category Keyword Mappings for Granular Filtering
    const categoryKeywords = {
      'atta': ['atta', 'flour', 'maida', 'suji', 'besan', 'wheat flour', 'multigrain'],
      'rice': ['rice', 'basmati', 'poha', 'paddy', 'grain', 'dalia'],
      'oil': ['oil', 'ghee', 'mustard oil', 'sunflower', 'groundnut', 'olive oil'],
      'dal': ['dal', 'pulse', 'moong', 'toor', 'chana', 'urad', 'masoor', 'rajma', 'chole'],
      'masala': ['masala', 'spice', 'chilli', 'turmeric', 'coriander', 'cumin', 'hing', 'garam masala', 'salt', 'pepper'],
      'snacks': ['snack', 'namkeen', 'biscuit', 'chip', 'wafer', 'kurkure', 'chocolate', 'toast', 'rusk', 'noodle', 'pasta'],
      'drinks': ['drink', 'juice', 'soda', 'coke', 'pepsi', 'sprite', 'cold drink', 'beverage', 'water', 'energy drink'],
      'milk': ['milk', 'curd', 'paneer', 'butter', 'cheese', 'yogurt', 'dairy', 'cream'],
      'icecream': ['ice cream', 'dessert', 'kulfi', 'scoop', 'cone', 'cassatta', 'amul ice'],
      'cleaning': ['clean', 'detergent', 'soap', 'dishwash', 'harpic', 'surf', 'rin', 'floor cleaner', 'tissue'],
      'personal': ['shampoo', 'soap', 'toothpaste', 'brush', 'lotion', 'face wash', 'cream', 'deodorant', 'hair oil'],
      'baby': ['baby', 'diaper', 'pampers', 'cerelac', 'wipes', 'baby soap', 'johnson'],
      'stationery': ['pen', 'pencil', 'notebook', 'paper', 'stapler', 'tape', 'marker', 'eraser', 'folder', 'file']
    };

    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const storeIdParam = urlParams.get('store') || 'sai-jeevan';
      const store = storeRegistry[storeIdParam] || storeRegistry['sai-jeevan'];

      // Fill Store Metadata
      document.getElementById('header-store-name').textContent = store.name;
      document.getElementById('header-store-location').textContent = `${store.address.split(',')[1] || 'Bhusawal'} • Express 10 MINS`;
      document.getElementById('store-title').textContent = store.name;
      document.getElementById('store-tagline').textContent = store.tagline;
      document.getElementById('store-rating').innerHTML = `<span class="material-symbols-outlined text-xs text-amber-600">star</span> ${store.rating}`;
      document.getElementById('store-address').textContent = store.address;
      document.getElementById('store-hours').textContent = store.hours;
      const phoneLink = document.getElementById('store-phone-link');
      if (phoneLink) {
        phoneLink.textContent = store.phone;
        phoneLink.href = `tel:${store.phone}`;
      }
      document.getElementById('store-delivery-by').textContent = store.deliveryBy;
      document.getElementById('store-badge-top').textContent = store.badge;
      document.getElementById('store-logo-box').textContent = store.logo;
      document.getElementById('store-cover-img').src = store.cover;

      const searchLabelName = document.getElementById('store-search-label-name');
      if (searchLabelName) {
        searchLabelName.textContent = `SEARCHING ONLY INSIDE ${store.name.toUpperCase()}`;
      }

      const storeSearchInput = document.getElementById('store-search-input');
      if (storeSearchInput) {
        storeSearchInput.placeholder = `Search items inside ${store.name} (e.g. Milk, Oil, Atta, Rice)...`;
      }

      // Fetch Full Catalog Data
      let allCatalog = [];
      try {
        const res = await fetch('/grocery_catalog.json');
        allCatalog = await res.json();
      } catch(e) {
        console.error("Failed to load catalog", e);
      }

      // Scope catalog strictly to this store
      let storeCatalog = allCatalog;
      if (store.categories && store.categories.length > 0) {
        const allowedCats = store.categories.map(c => c.toLowerCase());
        const scoped = allCatalog.filter(p => {
          const cat = (p.Category || '').toLowerCase();
          return allowedCats.some(ac => cat.includes(ac) || ac.includes(cat));
        });
        if (scoped.length > 100) {
          storeCatalog = scoped;
        }
      }

      let currentQuery = '';
      let activeCategory = 'All Products';
      let activeStockFilter = 'all';
      let currentSort = 'popular';
      let limit = 48;
      const BATCH_SIZE = 48;

      function getWishlist() {
        try { return JSON.parse(localStorage.getItem('bhusawal_wishlist') || '[]'); } catch(e) { return []; }
      }

      function toggleWishlist(id) {
        let wish = getWishlist();
        if (wish.includes(id)) {
          wish = wish.filter(i => i !== id);
        } else {
          wish.push(id);
        }
        localStorage.setItem('bhusawal_wishlist', JSON.stringify(wish));
        renderStoreProducts();
      }

      function renderStoreProducts() {
        const grid = document.getElementById('store-products-grid');
        const countLabel = document.getElementById('store-product-count');
        const loadMoreBtn = document.getElementById('store-load-more-btn');
        const feedbackBox = document.getElementById('store-search-feedback');
        const feedbackText = document.getElementById('store-search-feedback-text');
        const clearBtn = document.getElementById('clear-store-search-btn');
        const wishlist = getWishlist();

        let filtered = storeCatalog;

        // INSTANT SEARCH QUERY INSIDE THIS STORE ONLY
        if (currentQuery) {
          const queryTerms = currentQuery.split(/\s+/).filter(Boolean);
          
          filtered = filtered.filter(p => {
            const name = (p["Product Name"] || '').toLowerCase();
            const cat = (p.Category || '').toLowerCase();
            const brand = (p["Brand Name"] || '').toLowerCase();
            const fullText = `${name} ${cat} ${brand}`;

            // Check if every search term matches inside this store item
            return queryTerms.every(term => fullText.includes(term));
          });

          if (feedbackBox && feedbackText) {
            feedbackBox.classList.remove('hidden');
            feedbackText.innerHTML = `Showing results for <span class="text-purpleBrand font-black">"${currentQuery}"</span> in <span class="font-black text-slate-900">${store.name}</span> (${filtered.length} item${filtered.length === 1 ? '' : 's'})`;
          }
          if (clearBtn) clearBtn.classList.remove('hidden');
        } else {
          if (feedbackBox) feedbackBox.classList.add('hidden');
          if (clearBtn) clearBtn.classList.add('hidden');
        }

        // Granular Category Filter
        if (activeCategory && activeCategory !== 'All Products') {
          const target = activeCategory.toLowerCase();
          
          let matchedKeys = [];
          if (target.includes('atta')) matchedKeys = categoryKeywords['atta'];
          else if (target.includes('rice')) matchedKeys = categoryKeywords['rice'];
          else if (target.includes('oil')) matchedKeys = categoryKeywords['oil'];
          else if (target.includes('dal')) matchedKeys = categoryKeywords['dal'];
          else if (target.includes('masala')) matchedKeys = categoryKeywords['masala'];
          else if (target.includes('snack')) matchedKeys = categoryKeywords['snacks'];
          else if (target.includes('drink')) matchedKeys = categoryKeywords['drinks'];
          else if (target.includes('milk')) matchedKeys = categoryKeywords['milk'];
          else if (target.includes('ice cream')) matchedKeys = categoryKeywords['icecream'];
          else if (target.includes('clean')) matchedKeys = categoryKeywords['cleaning'];
          else if (target.includes('personal')) matchedKeys = categoryKeywords['personal'];
          else if (target.includes('baby')) matchedKeys = categoryKeywords['baby'];
          else if (target.includes('stationery')) matchedKeys = categoryKeywords['stationery'];

          if (matchedKeys.length > 0) {
            filtered = filtered.filter(p => {
              const text = `${p["Product Name"] || ''} ${p.Category || ''} ${p["Brand Name"] || ''}`.toLowerCase();
              return matchedKeys.some(k => text.includes(k));
            });
          } else {
            filtered = filtered.filter(p => (p.Category || '').toLowerCase() === target);
          }
        }

        // In Stock Filter
        if (activeStockFilter === 'instock') {
          filtered = filtered.filter(p => p.stock !== 0 && p.outOfStock !== true && p.status !== 'out_of_stock');
        }

        // Sorting
        if (currentSort === 'low-high') {
          filtered.sort((a, b) => parseFloat(a["Selling Price"] || a.sp || a.MRP || 0) - parseFloat(b["Selling Price"] || b.sp || b.MRP || 0));
        } else if (currentSort === 'high-low') {
          filtered.sort((a, b) => parseFloat(b["Selling Price"] || b.sp || b.MRP || 0) - parseFloat(a["Selling Price"] || a.sp || a.MRP || 0));
        } else if (currentSort === 'name') {
          filtered.sort((a, b) => (a["Product Name"] || '').localeCompare(b["Product Name"] || ''));
        }

        if (countLabel) {
          countLabel.textContent = `Showing ${Math.min(limit, filtered.length).toLocaleString()} of ${filtered.length.toLocaleString()} items in ${store.name}`;
        }

        if (!filtered || filtered.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full py-16 text-center space-y-3 bg-white rounded-3xl border border-slate-100 p-8 shadow-xs">
              <div class="w-16 h-16 rounded-full bg-purple-50 text-purpleBrand flex items-center justify-center mx-auto text-3xl">
                🔍
              </div>
              <h3 class="text-base font-black text-slate-900 font-display">No items found for "${currentQuery}"</h3>
              <p class="text-xs font-bold text-slate-500 max-w-md mx-auto">No products matching "${currentQuery}" were found inside ${store.name}. Try searching for "Milk", "Oil", "Atta", or "Rice".</p>
              <button id="reset-empty-search-btn" class="px-5 py-2.5 bg-purpleBrand text-white font-black text-xs rounded-xl shadow-md hover:bg-purpleDark transition-all">
                Reset Store Search
              </button>
            </div>
          `;

          document.getElementById('reset-empty-search-btn')?.addEventListener('click', () => {
            if (storeSearchInput) storeSearchInput.value = '';
            currentQuery = '';
            renderStoreProducts();
          });

          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
          return;
        }

        const visible = filtered.slice(0, limit);
        grid.innerHTML = visible.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id || '';
          const name = (p["Product Name"] || p.name || '').split(" (Batch")[0];
          const brand = p["Brand Name"] || p.brand || store.name;
          const cat = p.Category || 'Grocery';
          const pack = p["Pack Size"] || p.pack || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || p.mrp || p["Selling Price"] || p.sp || 50);
          const sp = parseFloat(p["Selling Price"] || p.sp || p.MRP || p.mrp || mrp);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const isOutOfStock = p.stock === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
          const stockQty = p.stock || (Math.floor(Math.random() * 30) + 10);
          const nameSafe = name.replace(/"/g, '&quot;');
          const isFav = wishlist.includes(id);

          return `
            <div class="product-card group bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-xl hover:border-purple-200 transition-all duration-300 relative flex flex-col overflow-hidden p-3" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-mrp="${mrp}" data-img="${img}" data-unit="${pack}" data-cat="${cat}" data-brand="${brand}">

              <!-- FAVOURITE BUTTON -->
              <button class="fav-btn absolute top-3 right-3 z-30 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md border border-slate-200/80 flex items-center justify-center text-slate-400 hover:text-red-500 hover:scale-110 active:scale-95 transition-all shadow-xs" data-id="${id}" title="Add to Favourites">
                <span class="material-symbols-outlined text-lg ${isFav ? 'text-red-500 fill-1 font-black' : ''}">favorite</span>
              </button>

              <!-- PRODUCT IMAGE -->
              <div class="relative w-full h-36 sm:h-44 bg-gradient-to-b from-slate-50 to-white rounded-2xl flex items-center justify-center p-3 overflow-hidden mb-2">
                ${isOutOfStock ? `
                  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-20 flex items-center justify-center">
                    <span class="bg-slate-900 text-white text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-md">Out of Stock</span>
                  </div>
                ` : ''}

                <img src="${img}" alt="${nameSafe}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />

                <div class="absolute bottom-2 left-2 z-10">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-400 text-slate-950 text-[9px] font-black rounded-md uppercase tracking-wider shadow-xs">
                    ⚡ 10 MINS
                  </span>
                </div>
              </div>

              <!-- PRODUCT DETAILS -->
              <div class="flex flex-col flex-1 px-0.5 space-y-1">
                <span class="text-[10px] font-extrabold text-purpleBrand uppercase tracking-wider truncate">${brand}</span>
                <h3 class="text-xs sm:text-[13px] font-extrabold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem] group-hover:text-purpleBrand transition-colors">${name}</h3>
                
                <div class="flex items-center justify-between text-[10px] font-bold">
                  <span class="text-slate-400">${pack}</span>
                  <span class="px-1.5 py-0.2 rounded bg-emerald-50 text-emerald-700 font-extrabold border border-emerald-100 flex items-center gap-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    In Stock (${stockQty})
                  </span>
                </div>

                <!-- PRICING (MRP & SELLING PRICE) -->
                <div class="flex items-baseline gap-1.5 pt-1">
                  <span class="text-sm sm:text-base font-black text-slate-900">₹${sp}</span>
                  ${mrp > sp ? `
                    <span class="text-[11px] font-bold text-slate-400 line-through">MRP ₹${mrp}</span>
                  ` : `
                    <span class="text-[10px] font-bold text-slate-400">MRP ₹${mrp}</span>
                  `}
                </div>

                <!-- ADD TO CART & QUANTITY SELECTOR -->
                <div class="pt-2 border-t border-slate-100 mt-auto">
                  <div class="cart-action-container" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-mrp="${mrp}" data-img="${img}">
                    <button class="add-to-cart-btn w-full py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-xs font-black rounded-xl active:scale-90 transition-all flex items-center justify-center gap-1" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-mrp="${mrp}" data-img="${img}">
                      <span>+ ADD</span>
                    </button>
                  </div>
                </div>
              </div>

            </div>
          `;
        }).join('');

        if (limit < filtered.length) {
          if (loadMoreBtn) {
            loadMoreBtn.classList.remove('hidden');
            loadMoreBtn.textContent = `Load More Items (${(filtered.length - limit).toLocaleString()} remaining)`;
          }
        } else {
          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
        }

        attachCartListeners();
      }

      // Cart bar & Add to Cart
      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const headerBadge = document.getElementById('cart-badge-header');
          const totalText = document.getElementById('cart-total-text');

          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

          if (countBadge) countBadge.textContent = totalQty;
          if (headerBadge) headerBadge.textContent = totalQty;
          if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);

          if (cart.length > 0) {
            bar?.classList.remove('hidden');
          } else {
            bar?.classList.add('hidden');
          }
        } catch(e) {}
      }
      updateCartBar();

      function attachCartListeners() {
        let cart = [];
        try { cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); } catch(e) {}

        // Sync Action Containers
        document.querySelectorAll('.cart-action-container').forEach(container => {
          const id = container.dataset.id;
          const name = container.dataset.name;
          const price = container.dataset.price;
          const mrp = container.dataset.mrp;
          const img = container.dataset.img;
          if (!id) return;

          const cartItem = cart.find(i => i.id === id);
          const qty = cartItem ? (cartItem.quantity || 1) : 0;

          if (qty > 0) {
            container.innerHTML = `
              <div class="flex items-center justify-between bg-purpleBrand text-white font-extrabold text-xs rounded-xl overflow-hidden shadow-xs">
                <button class="qty-minus-btn px-3 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}">-</button>
                <span class="px-2 text-xs font-black min-w-[1.4rem] text-center">${qty}</span>
                <button class="qty-plus-btn px-3 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-mrp="${mrp}" data-img="${img}">+</button>
              </div>
            `;
          } else {
            container.innerHTML = `
              <button class="add-to-cart-btn w-full py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-xs font-black rounded-xl active:scale-90 transition-all flex items-center justify-center gap-1" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-mrp="${mrp}" data-img="${img}">
                <span>+ ADD</span>
              </button>
            `;
          }
        });

        // Add Button
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = btn.dataset.price;
            const mrp = btn.dataset.mrp;
            const img = btn.dataset.img;
            let currentCart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = currentCart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              currentCart.push({ id, name, price, mrp, image: img, quantity: 1, cat: 'Grocery', store: store.name });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(currentCart));
            updateCartBar();
            attachCartListeners();
          };
        });

        // Plus Button
        document.querySelectorAll('.qty-plus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let currentCart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = currentCart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              currentCart.push({ id, name: btn.dataset.name, price: btn.dataset.price, mrp: btn.dataset.mrp, image: btn.dataset.img, quantity: 1, cat: 'Grocery', store: store.name });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(currentCart));
            updateCartBar();
            attachCartListeners();
          };
        });

        // Minus Button
        document.querySelectorAll('.qty-minus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let currentCart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existingIndex = currentCart.findIndex(i => i.id === id);
            if (existingIndex > -1) {
              if (currentCart[existingIndex].quantity > 1) {
                currentCart[existingIndex].quantity -= 1;
              } else {
                currentCart.splice(existingIndex, 1);
              }
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(currentCart));
            updateCartBar();
            attachCartListeners();
          };
        });

        // Wishlist Favourite Buttons
        document.querySelectorAll('.fav-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            if (id) toggleWishlist(id);
          };
        });
      }

      // INSTANT REALTIME INPUT EVENT LISTENERS (NO PAGE RELOAD)
      const clearSearchBtn = document.getElementById('clear-store-search-btn');
      const feedbackClear = document.getElementById('store-search-feedback-clear');

      storeSearchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        renderStoreProducts();
      });

      clearSearchBtn?.addEventListener('click', () => {
        if (storeSearchInput) storeSearchInput.value = '';
        currentQuery = '';
        renderStoreProducts();
      });

      feedbackClear?.addEventListener('click', () => {
        if (storeSearchInput) storeSearchInput.value = '';
        currentQuery = '';
        renderStoreProducts();
      });

      // Stock Filter Buttons
      document.querySelectorAll('.store-stock-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.store-stock-filter-btn').forEach(b => {
            b.classList.remove('bg-purpleBrand', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'text-slate-700');
          btn.classList.add('bg-purpleBrand', 'text-white', 'shadow-xs');

          activeStockFilter = btn.dataset.filter || 'all';
          renderStoreProducts();
        });
      });

      // Sort Select
      document.getElementById('store-sort-select')?.addEventListener('change', (e) => {
        currentSort = e.target.value;
        renderStoreProducts();
      });

      // Category Pill Listeners
      document.querySelectorAll('.store-cat-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.store-cat-pill').forEach(p => {
            p.classList.remove('bg-purpleBrand', 'text-white', 'shadow-xs');
            p.classList.add('bg-slate-100', 'text-slate-700');
          });
          pill.classList.remove('bg-slate-100', 'text-slate-700');
          pill.classList.add('bg-purpleBrand', 'text-white', 'shadow-xs');

          activeCategory = pill.dataset.category || 'All Products';
          const title = document.getElementById('store-catalog-title');
          if (title) title.textContent = activeCategory === 'All Products' ? `Complete Store Catalog` : `${activeCategory} in ${store.name}`;
          renderStoreProducts();
        });
      });

      // Load More Button
      document.getElementById('store-load-more-btn')?.addEventListener('click', () => {
        limit += BATCH_SIZE;
        renderStoreProducts();
      });

      renderStoreProducts();
    });
  </script>
</body>
</html>
