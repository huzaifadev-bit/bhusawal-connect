---
// Bhusawal Connect - Official Delivery Partner & Captain App
import RiderHomeDashboard from '../components/RiderHomeDashboard.astro';
import RiderOrderRequestModal from '../components/RiderOrderRequestModal.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Bhusawal Connect | Delivery Partner & Captain App</title>
  
  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            riderPrimary: '#2563EB',
            riderPrimaryDark: '#1D4ED8',
            riderPrimaryLight: '#EFF6FF',
            riderSuccess: '#16A34A',
            riderWarning: '#F59E0B',
            riderError: '#DC2626'
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & Material Symbols -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  
  <!-- LEAFLET MAPS FOR LIVE BHUSAWAL FLEET INTERFACE -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- BSL CONNECT FLEET CORE SCRIPTS -->
  <script is:inline src="/assets/bsl_rider_fleet_engine.js"></script>
  <script is:inline src="/assets/bsl_route_sequencer.js"></script>
  <script is:inline src="/assets/bsl_rider_home.js"></script>
  <script is:inline src="/assets/bsl_order_request_engine.js"></script>
  <script is:inline src="/assets/smart_assignment_engine.js"></script>
  <script is:inline src="/assets/delivery_workflow_engine.js"></script>
  <script is:inline src="/assets/rider_push_notifications.js"></script>
  <script is:inline src="/assets/google_navigation_engine.js"></script>
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_dispatch_engine.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>

  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #020617;
      color: #F8FAFC;
    }
    .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen overflow-hidden selection:bg-blue-600 selection:text-white">

  <!-- ==================== 1. FULL RIDER DASHBOARD (MAP-FIRST APPLICATION) ==================== -->
  <RiderHomeDashboard />

  <!-- ==================== 2. REUSABLE UNIFIED ORDER REQUEST ALERT MODAL ==================== -->
  <RiderOrderRequestModal />

  <!-- ==================== 3. PARTNER AUTH & ACCOUNT MANAGEMENT MODAL ==================== -->
  <div id="modal-rider-auth" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/85 backdrop-blur-md overflow-y-auto">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 max-w-md w-full space-y-5 shadow-2xl relative my-auto">
      
      <!-- Close button -->
      <button id="btn-close-auth-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Close">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>

      <!-- STEP 1: MOBILE LOGIN / SWITCH ACCOUNT -->
      <div id="auth-step-login" class="space-y-4">
        <div class="space-y-1">
          <span class="px-2.5 py-0.5 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-md text-[10px] font-black uppercase tracking-wider">Bhusawal Shared Fleet</span>
          <h2 class="text-xl font-black text-white pt-1">Partner Account Login</h2>
          <p class="text-xs text-slate-400">Enter your 10-digit mobile number to access your partner fleet dashboard.</p>
        </div>

        <form id="form-auth-login" class="space-y-4" onsubmit="return false;">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1.5">Registered Mobile Number <span class="text-rose-400">*</span></label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm font-extrabold text-slate-400 border-r border-slate-700 pr-2.5">+91</span>
              <input
                type="tel"
                id="input-auth-mobile"
                maxlength="10"
                placeholder="Enter 10-digit mobile number"
                class="w-full pl-16 pr-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-sm font-bold text-white placeholder:text-slate-500 focus:outline-none focus:border-blue-500"
                required
              />
            </div>
            <p id="error-auth-mobile" class="hidden text-xs font-bold text-rose-400 mt-1 flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">error</span> Enter a valid 10-digit Indian mobile number
            </p>
          </div>

          <button
            type="submit"
            id="btn-auth-send-otp"
            class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white font-black text-xs rounded-xl shadow-lg shadow-blue-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Send OTP Verification</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </button>
        </form>
      </div>

      <!-- STEP 2: OTP VERIFICATION -->
      <div id="auth-step-otp" class="hidden space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <button id="btn-auth-back-to-login" class="text-xs font-bold text-blue-400 flex items-center gap-1 hover:underline cursor-pointer">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Change Number
          </button>
          <span class="text-[10px] font-bold text-slate-500">Step 2 of 4</span>
        </div>

        <div class="space-y-1">
          <h2 class="text-lg font-black text-white">Enter OTP Verification</h2>
          <p class="text-xs text-slate-400">
            Enter 4-digit code sent to <strong id="display-auth-mobile" class="text-white">+91 9876543210</strong>
          </p>
        </div>

        <form id="form-auth-otp" class="space-y-4" onsubmit="return false;">
          <div class="flex justify-between gap-2 max-w-xs mx-auto py-2">
            <input type="tel" maxlength="1" class="auth-otp-box w-12 h-14 bg-slate-950 border-2 border-slate-700 rounded-xl text-center text-xl font-black text-white focus:border-blue-500 focus:outline-none" required />
            <input type="tel" maxlength="1" class="auth-otp-box w-12 h-14 bg-slate-950 border-2 border-slate-700 rounded-xl text-center text-xl font-black text-white focus:border-blue-500 focus:outline-none" required />
            <input type="tel" maxlength="1" class="auth-otp-box w-12 h-14 bg-slate-950 border-2 border-slate-700 rounded-xl text-center text-xl font-black text-white focus:border-blue-500 focus:outline-none" required />
            <input type="tel" maxlength="1" class="auth-otp-box w-12 h-14 bg-slate-950 border-2 border-slate-700 rounded-xl text-center text-xl font-black text-white focus:border-blue-500 focus:outline-none" required />
          </div>

          <p id="error-auth-otp" class="hidden text-xs font-bold text-rose-400 text-center flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span> Invalid OTP. Please try again.
          </p>

          <button
            type="submit"
            id="btn-auth-verify-otp"
            class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white font-black text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Verify & Continue</span>
            <span class="material-symbols-outlined text-sm">check_circle</span>
          </button>
        </form>
      </div>

      <!-- STEP 3: ONBOARDING DETAILS -->
      <div id="auth-step-onboarding" class="hidden space-y-4">
        <div class="space-y-1 border-b border-slate-800 pb-2">
          <span class="text-[10px] font-bold text-slate-500 uppercase">Step 3 of 4</span>
          <h2 class="text-lg font-black text-white">Partner & Vehicle Profile</h2>
        </div>

        <form id="form-auth-onboarding" class="space-y-3" onsubmit="return false;">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Full Name <span class="text-rose-400">*</span></label>
            <input type="text" id="input-auth-name" placeholder="Rahul Ramesh Patil" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs font-bold text-white focus:outline-none focus:border-blue-500" required />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Bike Number <span class="text-rose-400">*</span></label>
              <input type="text" id="input-auth-bike" placeholder="MH 19 AX 4892" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs font-bold text-white uppercase focus:outline-none focus:border-blue-500" required />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">DL Number <span class="text-rose-400">*</span></label>
              <input type="text" id="input-auth-dl" placeholder="MH19 2021004892" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs font-bold text-white uppercase focus:outline-none focus:border-blue-500" required />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">UPI ID for Payouts <span class="text-rose-400">*</span></label>
            <input type="text" id="input-auth-upi" placeholder="rahulpatil@okaxis" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs font-bold text-white focus:outline-none focus:border-blue-500" required />
          </div>

          <button
            type="submit"
            id="btn-auth-save-profile"
            class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-slate-950 font-black text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span>Save & Enter Captain App</span>
            <span class="material-symbols-outlined text-sm">done_all</span>
          </button>
        </form>
      </div>

    </div>
  </div>

  <!-- ==================== RIDER APP CONTROLLER SCRIPT ==================== -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // 1. Initialize BslRiderHome Captain Application Immediately
      if (window.BslRiderHome) {
        window.BslRiderHome.start();
      }

      // 2. Wire Auth / Account Switch Modal
      var authModal = document.getElementById('modal-rider-auth');
      var closeAuthBtn = document.getElementById('btn-close-auth-modal');
      var btnSwitchAccount = document.getElementById('btn-switch-account');
      var btnTopProfile = document.getElementById('btn-top-profile');

      function openAuthModal() {
        if (authModal) authModal.classList.remove('hidden');
      }
      function closeAuthModal() {
        if (authModal) authModal.classList.add('hidden');
      }

      if (closeAuthBtn) closeAuthBtn.addEventListener('click', closeAuthModal);
      if (btnSwitchAccount) btnSwitchAccount.addEventListener('click', openAuthModal);
      if (btnTopProfile) btnTopProfile.addEventListener('click', openAuthModal);

      // Auth Steps
      var stepLogin = document.getElementById('auth-step-login');
      var stepOtp = document.getElementById('auth-step-otp');
      var stepOnboard = document.getElementById('auth-step-onboarding');

      document.getElementById('form-auth-login')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var phone = document.getElementById('input-auth-mobile').value.trim();
        if (phone.length === 10) {
          document.getElementById('display-auth-mobile').textContent = '+91 ' + phone;
          stepLogin.classList.add('hidden');
          stepOtp.classList.remove('hidden');
        }
      });

      document.getElementById('btn-auth-back-to-login')?.addEventListener('click', function() {
        stepOtp.classList.add('hidden');
        stepLogin.classList.remove('hidden');
      });

      document.getElementById('form-auth-otp')?.addEventListener('submit', function(e) {
        e.preventDefault();
        stepOtp.classList.add('hidden');
        stepOnboard.classList.remove('hidden');
      });

      document.getElementById('form-auth-onboarding')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var name = document.getElementById('input-auth-name').value.trim();
        var bike = document.getElementById('input-auth-bike').value.trim().toUpperCase();
        var dl = document.getElementById('input-auth-dl').value.trim().toUpperCase();
        var upi = document.getElementById('input-auth-upi').value.trim();

        var st = (window.BslRiderHome && window.BslRiderHome.getRiderState) ? window.BslRiderHome.getRiderState() : {};
        if (name) st.fullName = name;
        if (bike) st.bikeNo = bike;
        if (dl) st.dlNo = dl;
        if (upi) st.upiId = upi;
        st.isLoggedIn = true;
        st.kycApproved = true;

        if (window.BslRiderHome && window.BslRiderHome.saveRiderState) {
          window.BslRiderHome.saveRiderState(st);
          window.BslRiderHome.renderHomeView(st);
        }

        closeAuthModal();
        alert('🎉 Partner account updated successfully! Welcome to BSL Connect Captain App.');
      });
    });
  </script>
</body>
</html>
