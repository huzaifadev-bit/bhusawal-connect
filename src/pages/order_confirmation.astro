---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
  </style>
</head>

<body class="min-h-screen pb-24 text-slate-800 antialiased flex items-center justify-center p-4">

  <!-- BEAUTIFUL CONFIRMATION CARD -->
  <div class="max-w-lg w-full bg-white rounded-3xl p-6 sm:p-10 border border-slate-100 shadow-2xl text-center space-y-6 animate-in zoom-in-95 duration-300">
    
    <!-- ANIMATED SUCCESS CHECKMARK -->
    <div class="w-24 h-24 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center shadow-lg shadow-emerald-500/10 animate-bounce">
      <span class="material-symbols-outlined text-6xl">check_circle</span>
    </div>

    <!-- TITLE & ORDER ID -->
    <div class="space-y-1">
      <span class="px-3.5 py-1 bg-emerald-50 text-emerald-800 text-xs font-black rounded-full uppercase tracking-wider">
        🎉 Order Placed Successfully!
      </span>
      <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900 pt-2">Thank You for Your Order</h1>
      <p class="text-xs font-bold text-slate-400">Order ID: <span class="text-purpleBrand font-black" id="conf-order-id">#BHU-98214</span></p>
    </div>

    <!-- LIVE ESTIMATED DELIVERY ETA CARD -->
    <div class="p-4 rounded-2xl bg-gradient-to-r from-purple-50 via-indigo-50 to-purple-50 border border-purple-200/80 text-left flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purpleBrand text-white flex items-center justify-center font-black shadow-md">
          <span class="material-symbols-outlined text-xl">bolt</span>
        </div>
        <div>
          <h3 class="text-xs font-black text-slate-900">Estimated Delivery Time</h3>
          <p class="text-[11px] font-bold text-purpleBrand">10-15 Minutes Doorstep Delivery</p>
        </div>
      </div>
      <span class="text-xs font-black text-slate-900 bg-white px-3 py-1 rounded-xl shadow-xs border border-purple-100">Bhusawal Express</span>
    </div>

    <!-- ADDRESS & PAYMENT SUMMARY -->
    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-2 text-xs font-bold text-slate-600">
      <div class="flex items-center justify-between">
        <span class="text-slate-400">Delivery Address:</span>
        <span class="text-slate-900 font-black truncate max-w-[200px]" id="conf-address">Shivaji Nagar, Bhusawal</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-slate-400">Total Amount Paid:</span>
        <span class="text-purpleBrand font-black text-sm" id="conf-total">₹0</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-slate-400">Payment Status:</span>
        <span class="text-emerald-700 font-black">✓ Confirmed</span>
      </div>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="space-y-3 pt-2">
      <a href="/track_order" class="w-full py-3.5 bg-purpleBrand hover:bg-purpleDark text-white font-black text-xs sm:text-sm rounded-2xl shadow-lg shadow-purple-900/15 active:scale-95 transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-base">near_me</span>
        <span>Track Live Delivery Rider</span>
      </a>

      <div class="grid grid-cols-2 gap-3">
        <a href="/orders" class="py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs rounded-xl transition-all flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-sm">receipt_long</span>
          <span>Order History</span>
        </a>
        <a href="/grocery" class="py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs rounded-xl transition-all flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-sm">storefront</span>
          <span>Shop More</span>
        </a>
      </div>
    </div>

  </div>

  <Switcher />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const orderId = params.get('orderId') || ('#BHU-' + Math.floor(100000 + Math.random() * 900000));
      const total = params.get('total') || '340';

      const idEl = document.getElementById('conf-order-id');
      const totalEl = document.getElementById('conf-total');

      if (idEl) idEl.textContent = '#' + orderId.replace('#', '');
      if (totalEl) totalEl.textContent = '₹' + total;
    });
  </script>
</body>
</html>
