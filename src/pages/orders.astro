---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders & Purchase History | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <script src="/assets/google_maps_routing_service.js" is:inline></script>
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/profile" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <a href="/grocery" class="px-4 py-1.5 bg-purpleBrand text-white text-xs font-black rounded-xl hover:bg-purpleDark transition-all shadow-xs flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">add_shopping_cart</span>
        <span>+ New Order</span>
      </a>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE TITLE & SEARCH BAR -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/60 pb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">My Orders</h1>
        <p class="text-xs font-bold text-slate-400 mt-0.5" id="orders-subtitle">View current active orders, past purchase history & tax invoices</p>
      </div>

      <!-- Live Search Input -->
      <div class="relative max-w-md w-full">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
        <input type="text" id="search-orders-input" placeholder="Search by Order ID or item name (e.g. Milk, #BHU)..." class="w-full bg-white border border-slate-200 rounded-2xl pl-10 pr-4 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-purpleBrand focus:ring-2 focus:ring-purpleBrand/20 transition-all shadow-xs" />
      </div>
    </div>

    <!-- FILTER TABS (CURRENT ORDERS, PAST ORDERS, ALL) -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
      <button class="order-filter-tab px-4 py-2 rounded-xl bg-purpleBrand text-white font-black text-xs transition-all shadow-xs flex items-center gap-1.5" data-filter="all">
        <span>All Orders</span>
        <span class="px-2 py-0.5 rounded-md bg-white/20 text-[10px]" id="count-all">0</span>
      </button>

      <button class="order-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-black text-xs border border-slate-200 transition-all flex items-center gap-1.5" data-filter="active">
        <span class="w-2 h-2 rounded-full bg-purpleBrand animate-ping"></span>
        <span>Current Orders</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px]" id="count-active">0</span>
      </button>

      <button class="order-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-black text-xs border border-slate-200 transition-all flex items-center gap-1.5" data-filter="past">
        <span>📦 Past Orders</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px]" id="count-past">0</span>
      </button>

      <button class="order-filter-tab px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-slate-700 font-black text-xs border border-slate-200 transition-all flex items-center gap-1.5" data-filter="cancelled">
        <span>× Cancelled</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px]" id="count-cancelled">0</span>
      </button>
    </div>

    <!-- ORDERS CARDS CONTAINER -->
    <div id="orders-cards-container" class="space-y-5">
      <div class="p-8 bg-white rounded-3xl text-center text-slate-400 font-bold text-xs">
        Loading customer order history...
      </div>
    </div>

  </main>

  <!-- TAX INVOICE MODAL -->
  <div id="invoice-modal" class="fixed inset-0 z-[10000] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-4 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <button id="close-invoice-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>

      <!-- Printable Tax Invoice Content -->
      <div id="invoice-print-area" class="space-y-4 text-left">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <div>
            <h2 class="text-xl font-black font-display text-purpleBrand">Bhusawal Connect</h2>
            <p class="text-[10px] text-slate-400 font-bold">Official Tax Invoice / Bill Receipt</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-black text-slate-900 block" id="inv-order-id">#BHU-98214</span>
            <span class="text-[10px] font-bold text-slate-400" id="inv-date">Date: 02 Aug 2026</span>
          </div>
        </div>

        <div class="text-xs font-bold text-slate-600 space-y-1 bg-slate-50 p-3.5 rounded-2xl border border-slate-100">
          <p class="text-slate-900 font-black">Delivery Details:</p>
          <p id="inv-customer-name">Authenticated Customer</p>
          <p id="inv-address" class="text-[11px] text-slate-500 leading-snug">Station Road, Bhusawal</p>
        </div>

        <!-- Items Table -->
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 font-black text-[10px] uppercase">
              <th class="py-2">Item Description</th>
              <th class="py-2 text-center">Qty</th>
              <th class="py-2 text-right">MRP</th>
              <th class="py-2 text-right">Total</th>
            </tr>
          </thead>
          <tbody id="inv-items-table" class="divide-y divide-slate-100 font-bold text-slate-800">
            <!-- Items -->
          </tbody>
        </table>

        <!-- Totals -->
        <div class="border-t border-slate-200 pt-3 space-y-1.5 text-xs font-bold text-slate-600 text-right">
          <div class="flex justify-between"><span>Subtotal (MRP):</span><span id="inv-subtotal">₹0</span></div>
          <div class="flex justify-between"><span>Delivery Fee (Fixed):</span><span id="inv-delivery">₹30</span></div>
          <div class="flex justify-between text-sm font-black text-slate-900 pt-2 border-t border-slate-100"><span>Grand Total:</span><span id="inv-grand-total" class="text-purpleBrand text-base">₹0</span></div>
        </div>
      </div>

      <button onclick="window.print();" class="w-full py-3.5 bg-purpleBrand hover:bg-purpleDark text-white font-black text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-base">print</span>
        <span>Print or Download PDF Invoice</span>
      </button>
    </div>
  </div>

  <!-- CLIENT-SIDE SUPABASE ORDERS ENGINE -->
  <script type="module">
    import { getCurrentCustomer, getCustomerOrders, syncCustomerOrder } from '/src/lib/customerAuth.ts';

    document.addEventListener('DOMContentLoaded', async () => {
      let currentFilter = 'all';
      let searchQuery = '';

      const container = document.getElementById('orders-cards-container');
      const customerSession = await getCurrentCustomer();
      let customerOrdersList = [];

      if (customerSession && customerSession.profile) {
        const dbOrders = await getCustomerOrders(customerSession.profile.id);
        if (dbOrders && dbOrders.length > 0) {
          customerOrdersList = dbOrders.map(o => ({
            id: o.legacy_order_id || o.id,
            date: o.created_at,
            status: o.status,
            paymentStatus: o.payment_status,
            paymentMethod: o.payment_method,
            total: o.total_amount,
            items: o.order_data?.items || [],
            address: o.order_data?.address?.full || 'Bhusawal',
          }));
        }
      }

      if (!customerOrdersList || customerOrdersList.length === 0) {
        try {
          customerOrdersList = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
        } catch(e) {}
      }

      function renderOrdersList() {
        const activeOrders = customerOrdersList.filter(o => o.status !== 'Delivered' && o.status !== 'Cancelled');
        const pastOrders = customerOrdersList.filter(o => o.status === 'Delivered');
        const cancelledOrders = customerOrdersList.filter(o => o.status === 'Cancelled');

        document.getElementById('count-all').textContent = customerOrdersList.length;
        document.getElementById('count-active').textContent = activeOrders.length;
        document.getElementById('count-past').textContent = pastOrders.length;
        document.getElementById('count-cancelled').textContent = cancelledOrders.length;

        let filtered = customerOrdersList.filter(o => {
          if (currentFilter === 'active') return o.status !== 'Delivered' && o.status !== 'Cancelled';
          if (currentFilter === 'past') return o.status === 'Delivered';
          if (currentFilter === 'cancelled') return o.status === 'Cancelled';
          return true;
        });

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          filtered = filtered.filter(o => {
            const matchesId = (o.id || '').toLowerCase().includes(q);
            const matchesItem = (o.items || []).some(i => ((i.name || i.title || '').toLowerCase().includes(q)));
            return matchesId || matchesItem;
          });
        }

        if (filtered.length === 0) {
          container.innerHTML = `
            <div class="bg-white rounded-3xl p-8 text-center space-y-3 border border-slate-100">
              <span class="material-symbols-outlined text-4xl text-slate-300">shopping_bag</span>
              <h3 class="text-base font-black text-slate-800">No orders found</h3>
              <p class="text-xs font-bold text-slate-400">Explore products in Bhusawal Connect to place your first order</p>
              <a href="/grocery" class="inline-block px-4 py-2 bg-purpleBrand text-white font-black text-xs rounded-xl shadow-xs">Start Shopping →</a>
            </div>
          `;
          return;
        }

        let html = '';
        filtered.forEach(order => {
          const id = order.id || 'BHU-99000';
          const status = order.status || 'PLACED';
          const total = order.total || 0;
          const address = order.address || 'Bhusawal';
          const dateStr = order.date ? new Date(order.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Recent';
          const isCompleted = status === 'Delivered';
          const isCancelled = status === 'Cancelled';

          let statusBadge = `<span class="px-3 py-1 rounded-full bg-purple-100 text-purpleBrand text-xs font-black">${status}</span>`;
          if (isCompleted) {
            statusBadge = `<span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black">✓ Delivered</span>`;
          } else if (isCancelled) {
            statusBadge = `<span class="px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-black">× Cancelled</span>`;
          }

          html += `
            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-purple-300 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-black bg-purpleBrand text-white px-2 py-0.5 rounded-md uppercase tracking-wider">🛒 Order</span>
                    <h3 class="text-base font-black font-display text-slate-900">#${id}</h3>
                    ${statusBadge}
                  </div>
                  <p class="text-xs font-bold text-slate-400 mt-1">Placed on ${dateStr}</p>
                </div>
                <div class="text-left sm:text-right">
                  <span class="text-base font-black font-display text-purpleBrand block">₹${total}</span>
                  <span class="text-[10px] font-bold text-slate-400">Express Delivery in Bhusawal</span>
                </div>
              </div>

              <div class="text-xs font-bold text-slate-600 flex items-center gap-1.5 truncate">
                <span class="material-symbols-outlined text-sm text-purpleBrand shrink-0">location_on</span>
                <span class="truncate">${address}</span>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-100">
                <div class="flex items-center gap-2">
                  ${!isCompleted && !isCancelled ? `
                    <a href="/track_order?id=${encodeURIComponent(id)}" class="px-4 py-2 bg-purpleBrand hover:bg-purpleDark text-white text-xs font-black rounded-xl shadow-md flex items-center gap-1.5 transition-all">
                      <span class="material-symbols-outlined text-sm">near_me</span>
                      <span>Track Delivery</span>
                    </a>
                  ` : `
                    <button class="btn-reorder-card px-4 py-2 bg-purpleBrand hover:bg-purpleDark text-white text-xs font-black rounded-xl shadow-md flex items-center gap-1.5 transition-all" data-items='${JSON.stringify(order.items || [])}'>
                      <span class="material-symbols-outlined text-sm">replay</span>
                      <span>Reorder Items</span>
                    </button>
                  `}
                </div>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;

        // Reorder button listener
        document.querySelectorAll('.btn-reorder-card').forEach(btn => {
          btn.onclick = () => {
            try {
              const items = JSON.parse(btn.dataset.items || '[]');
              if (items.length > 0) {
                localStorage.setItem('bhusawal_cart', JSON.stringify(items));
                alert('Items added to cart with current prices! Redirecting to cart...');
                window.location.href = '/cart';
              }
            } catch(e) {
              alert('Could not reorder items.');
            }
          };
        });
      }

      // Filter Tabs Handler
      document.querySelectorAll('.order-filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.order-filter-tab').forEach(t => {
            t.classList.remove('bg-purpleBrand', 'text-white', 'shadow-xs');
            t.classList.add('bg-white', 'text-slate-700');
          });
          tab.classList.replace('bg-white', 'bg-purpleBrand');
          tab.classList.replace('text-slate-700', 'text-white');
          tab.classList.add('shadow-xs');

          currentFilter = tab.dataset.filter;
          renderOrdersList();
        });
      });

      // Search Input Listener
      document.getElementById('search-orders-input')?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderOrdersList();
      });

      renderOrdersList();
    });
  </script>
</body>
</html>