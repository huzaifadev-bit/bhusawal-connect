  <!-- ==================== CLIENT DYNAMIC SCRIPT ==================== -->
  <script is:inline>
    (function() {
      // 1. STATE VARIABLES
      var selectedRideType = 'Standard Scooter';
      var baseFare = 20;
      var perKmFare = 7;
      var distanceKm = 3.2;

      // Coordinate state
      var pickupCoords = [21.0455, 75.7893];
      var dropCoords = [21.0385, 75.8050];
      var activePickerTarget = 'pickup';

      // Predefined Bhusawal Landmark Database for Autocomplete
      var bhusawalLocations = [
        { name: 'Varangaon Road, Near Station Square, Bhusawal', lat: 21.0455, lng: 75.7893 },
        { name: 'Bhusawal Railway Station Platform Gate 1', lat: 21.0480, lng: 75.7850 },
        { name: 'Jamner Road Market, Near Railway Overbridge, Bhusawal', lat: 21.0385, lng: 75.8050 },
        { name: 'Ordnance Factory Estate, Jamner Road, Bhusawal', lat: 21.0290, lng: 75.8120 },
        { name: 'Deepnagar Thermal Power Station Colony, Bhusawal', lat: 21.0620, lng: 75.8250 },
        { name: 'Nahata Arts & Science College Chowk, Bhusawal', lat: 21.0410, lng: 75.7920 },
        { name: 'Khedi Road, Tapi River Bridge End, Bhusawal', lat: 21.0550, lng: 75.7780 },
        { name: 'Pandurang Talkies Chowk, Main Road, Bhusawal', lat: 21.0440, lng: 75.7880 },
        { name: 'Municipal Council Office, Subhash Chowk, Bhusawal', lat: 21.0465, lng: 75.7910 }
      ];

      // 2. LEAFLET ROUTE MAP INITIALIZATION
      var map, pickupMarker, dropMarker, routePolyline;
      function initRouteMap() {
        var mapContainer = document.getElementById('route-map');
        if (!mapContainer || typeof L === 'undefined') return;

        map = L.map('route-map', {
          zoomControl: false,
          scrollWheelZoom: false
        }).setView([21.0420, 75.7970], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '© OpenStreetMap'
        }).addTo(map);

        var pickupIcon = L.divIcon({
          className: 'custom-pin-icon',
          html: '<div style="background:#10B981;color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;box-shadow:0 4px 10px rgba(0,0,0,0.3);border:2px solid #fff;">📍</div>',
          iconSize: [32, 32]
        });

        var dropIcon = L.divIcon({
          className: 'custom-pin-icon',
          html: '<div style="background:#EF4444;color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;box-shadow:0 4px 10px rgba(0,0,0,0.3);border:2px solid #fff;">🏁</div>',
          iconSize: [32, 32]
        });

        pickupMarker = L.marker(pickupCoords, { icon: pickupIcon }).addTo(map).bindPopup('<b>Passenger Pickup</b>');
        dropMarker = L.marker(dropCoords, { icon: dropIcon }).addTo(map).bindPopup('<b>Drop Destination</b>');

        updateRoutePolyline();
      }

      function updateRoutePolyline() {
        if (!map) return;
        if (routePolyline) map.removeLayer(routePolyline);

        // Recalculate straight distance
        var lat1 = pickupCoords[0], lon1 = pickupCoords[1];
        var lat2 = dropCoords[0], lon2 = dropCoords[1];
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        var rawDist = R * c * 1.35;
        distanceKm = Math.max(1.0, parseFloat(rawDist.toFixed(1)));

        if (pickupMarker) pickupMarker.setLatLng(pickupCoords);
        if (dropMarker) dropMarker.setLatLng(dropCoords);

        var latlngs = [pickupCoords, [(pickupCoords[0]+dropCoords[0])/2, (pickupCoords[1]+dropCoords[1])/2], dropCoords];
        routePolyline = L.polyline(latlngs, { color: '#0284C7', weight: 4, dashArray: '8, 8' }).addTo(map);
        map.fitBounds(routePolyline.getBounds(), { padding: [35, 35] });

        var estMins = Math.max(5, Math.round(distanceKm * 3));
        var distTxt = document.getElementById('route-distance-text');
        var timeTxt = document.getElementById('route-time-text');
        if (distTxt) distTxt.textContent = distanceKm + ' km';
        if (timeTxt) timeTxt.textContent = estMins + ' mins ETA';

        calculateFare();
        validateAddresses();
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(initRouteMap, 300);
      } else {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(initRouteMap, 300); });
      }

      // 3. FARE CALCULATOR
      function calculateFare() {
        var distanceCost = Math.round(distanceKm * perKmFare);
        var totalBeforeDiscount = baseFare + distanceCost;
        var discount = 10;
        var finalTotal = Math.max(15, totalBeforeDiscount - discount);

        var baseCostEl = document.getElementById('fare-base-cost');
        var distKmEl = document.getElementById('fare-distance-km');
        var distCostEl = document.getElementById('fare-distance-cost');
        var fareDisplayEl = document.getElementById('total-fare-display');
        var barFareTotalEl = document.getElementById('bar-fare-total');

        if (baseCostEl) baseCostEl.textContent = '₹' + baseFare;
        if (distKmEl) distKmEl.textContent = distanceKm + ' km';
        if (distCostEl) distCostEl.textContent = '₹' + distanceCost;
        if (fareDisplayEl) fareDisplayEl.textContent = '₹' + finalTotal;
        if (barFareTotalEl) barFareTotalEl.textContent = '₹' + finalTotal;

        var optionBtns = document.querySelectorAll('.ride-type-btn');
        optionBtns.forEach(function(btn) {
          var bFare = parseInt(btn.getAttribute('data-base') || '20');
          var pFare = parseInt(btn.getAttribute('data-perkm') || '7');
          var optTotal = Math.max(15, (bFare + Math.round(distanceKm * pFare)) - discount);
          var fareLabel = btn.querySelector('.ride-option-fare');
          if (fareLabel) fareLabel.textContent = '₹' + optTotal;
        });

        return finalTotal;
      }

      // 4. ADDRESS VALIDATION
      function validateAddresses() {
        var pickupInput = document.getElementById('pickup-address-input');
        var dropInput = document.getElementById('drop-address-input');
        var pickupVal = pickupInput ? pickupInput.value.trim().toLowerCase() : '';
        var dropVal = dropInput ? dropInput.value.trim().toLowerCase() : '';

        var banner = document.getElementById('address-validation-banner');
        var bannerText = document.getElementById('validation-banner-text');
        var bookBtn = document.getElementById('btn-book-bike-ride');

        var isValid = true;
        var errorMsg = '';

        if (!pickupVal) {
          isValid = false;
          errorMsg = 'Please select a valid Pickup Location!';
        } else if (!dropVal) {
          isValid = false;
          errorMsg = 'Please select a valid Drop Destination!';
        } else if (pickupVal === dropVal) {
          isValid = false;
          errorMsg = 'Pickup and Drop locations must be different!';
        }

        if (!isValid) {
          if (bookBtn) {
            bookBtn.disabled = true;
            bookBtn.classList.add('opacity-50', 'cursor-not-allowed');
            bookBtn.classList.remove('active:scale-95', 'hover:shadow-xl');
          }
        } else {
          if (banner) banner.classList.add('hidden');
          if (bookBtn) {
            bookBtn.disabled = false;
            bookBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            bookBtn.classList.add('active:scale-95', 'hover:shadow-xl');
          }
        }
        return { isValid: isValid, errorMsg: errorMsg };
      }

      // 5. ONE-BUTTON SWAP
      var swapBtn = document.getElementById('btn-swap-addresses');
      if (swapBtn) {
        swapBtn.addEventListener('click', function() {
          var pickupInput = document.getElementById('pickup-address-input');
          var dropInput = document.getElementById('drop-address-input');

          var tempAddr = pickupInput.value;
          pickupInput.value = dropInput.value;
          dropInput.value = tempAddr;

          var tempCoords = pickupCoords;
          pickupCoords = dropCoords;
          dropCoords = tempCoords;

          updateRoutePolyline();
        });
      }

      // 6. AUTOCOMPLETE SEARCH FOR PICKUP & DROP
      function setupAutocomplete(inputId, dropdownId, targetType) {
        var input = document.getElementById(inputId);
        var dropdown = document.getElementById(dropdownId);
        if (!input || !dropdown) return;

        input.addEventListener('input', function() {
          var query = input.value.trim().toLowerCase();
          if (query.length < 2) {
            dropdown.classList.add('hidden');
            return;
          }

          var matches = bhusawalLocations.filter(function(loc) {
            return loc.name.toLowerCase().includes(query);
          });

          if (matches.length === 0) {
            dropdown.innerHTML = '<div class="p-3 text-xs text-slate-400 font-semibold">No landmark match. Enter full street address.</div>';
          } else {
            dropdown.innerHTML = matches.map(function(loc) {
              return '<div class="p-3 hover:bg-skyLight cursor-pointer text-xs font-bold text-slate-800 border-b border-slate-100 flex items-center gap-2 suggestion-item" data-name="' + loc.name + '" data-lat="' + loc.lat + '" data-lng="' + loc.lng + '">' +
                '<span class="material-symbols-outlined text-skyBrand text-sm">location_on</span>' +
                '<span>' + loc.name + '</span>' +
              '</div>';
            }).join('');
          }
          dropdown.classList.remove('hidden');
        });

        dropdown.addEventListener('click', function(e) {
          var item = e.target.closest('.suggestion-item');
          if (item) {
            var name = item.getAttribute('data-name');
            var lat = parseFloat(item.getAttribute('data-lat'));
            var lng = parseFloat(item.getAttribute('data-lng'));

            input.value = name;
            dropdown.classList.add('hidden');

            if (targetType === 'pickup') pickupCoords = [lat, lng];
            else dropCoords = [lat, lng];

            updateRoutePolyline();
          }
        });

        document.addEventListener('click', function(e) {
          if (!input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      setupAutocomplete('pickup-address-input', 'pickup-search-dropdown', 'pickup');
      setupAutocomplete('drop-address-input', 'drop-search-dropdown', 'drop');

      // 7. SELECT ON MAP MODAL PICKER SYSTEM
      var pickerMap;
      var modal = document.getElementById('map-picker-modal');
      var closeModalBtn = document.getElementById('close-map-modal');
      var confirmPickerBtn = document.getElementById('btn-confirm-map-picker');
      var modalTitle = document.getElementById('modal-map-title');
      var pickerAddrTxt = document.getElementById('picker-address-text');
      var pickerPinEmoji = document.getElementById('picker-pin-emoji');

      function openMapPicker(target) {
        activePickerTarget = target;
        if (modal) modal.classList.remove('hidden');

        if (modalTitle) modalTitle.textContent = target === 'pickup' ? 'Select Pickup Location on Map' : 'Select Drop Destination on Map';
        if (pickerPinEmoji) pickerPinEmoji.textContent = target === 'pickup' ? '📍' : '🏁';

        setTimeout(function() {
          if (!pickerMap && typeof L !== 'undefined') {
            pickerMap = L.map('picker-map-container', { zoomControl: true }).setView(target === 'pickup' ? pickupCoords : dropCoords, 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18 }).addTo(pickerMap);

            pickerMap.on('moveend', function() {
              var center = pickerMap.getCenter();
              if (pickerAddrTxt) pickerAddrTxt.textContent = 'Selected Spot: ' + center.lat.toFixed(4) + ', ' + center.lng.toFixed(4) + ' (Bhusawal)';
            });
          } else if (pickerMap) {
            pickerMap.invalidateSize();
            pickerMap.setView(target === 'pickup' ? pickupCoords : dropCoords, 15);
          }
        }, 200);
      }

      var pickupMapBtn = document.getElementById('btn-pickup-select-map');
      if (pickupMapBtn) pickupMapBtn.addEventListener('click', function() { openMapPicker('pickup'); });

      var dropMapBtn = document.getElementById('btn-drop-select-map');
      if (dropMapBtn) dropMapBtn.addEventListener('click', function() { openMapPicker('drop'); });

      if (closeModalBtn) closeModalBtn.addEventListener('click', function() { if (modal) modal.classList.add('hidden'); });

      if (confirmPickerBtn) {
        confirmPickerBtn.addEventListener('click', function() {
          if (pickerMap) {
            var center = pickerMap.getCenter();
            var lat = center.lat, lng = center.lng;
            var formattedAddr = 'Map Location (' + lat.toFixed(4) + ', ' + lng.toFixed(4) + '), Bhusawal';

            if (activePickerTarget === 'pickup') {
              pickupCoords = [lat, lng];
              var input = document.getElementById('pickup-address-input');
              if (input) input.value = formattedAddr;
            } else {
              dropCoords = [lat, lng];
              var input = document.getElementById('drop-address-input');
              if (input) input.value = formattedAddr;
            }
            updateRoutePolyline();
          }
          if (modal) modal.classList.add('hidden');
        });
      }

      // 8. GPS AUTO-DETECT BUTTONS
      function handleGPS(targetType, btnId, inputId) {
        var btn = document.getElementById(btnId);
        if (!btn) return;
        btn.addEventListener('click', function() {
          if (navigator.geolocation) {
            btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span> Locating...';
            navigator.geolocation.getCurrentPosition(function(pos) {
              var lat = pos.coords.latitude;
              var lng = pos.coords.longitude;
              var addr = 'GPS Location (' + lat.toFixed(4) + ', ' + lng.toFixed(4) + '), Bhusawal';
              
              var input = document.getElementById(inputId);
              if (input) input.value = addr;

              if (targetType === 'pickup') pickupCoords = [lat, lng];
              else dropCoords = [lat, lng];

              updateRoutePolyline();

              btn.innerHTML = '<span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span> Located!';
              setTimeout(function() {
                btn.innerHTML = '<span class="material-symbols-outlined text-sm">gps_fixed</span> <span>GPS Location</span>';
              }, 2000);
            }, function() {
              alert('GPS Permission denied or unavailable. Using Bhusawal default.');
              btn.innerHTML = '<span class="material-symbols-outlined text-sm">gps_fixed</span> <span>GPS Location</span>';
            });
          }
        });
      }

      handleGPS('pickup', 'btn-pickup-gps', 'pickup-address-input');
      handleGPS('drop', 'btn-drop-gps', 'drop-address-input');

      // 9. SAVED & RECENT CHIPS HANDLERS
      var savedPickups = document.querySelectorAll('.chip-saved-pickup');
      savedPickups.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var addr = chip.getAttribute('data-addr');
          var input = document.getElementById('pickup-address-input');
          if (input) input.value = addr;
          updateRoutePolyline();
        });
      });

      var savedDrops = document.querySelectorAll('.chip-saved-drop');
      savedDrops.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var addr = chip.getAttribute('data-addr');
          var input = document.getElementById('drop-address-input');
          if (input) input.value = addr;
          updateRoutePolyline();
        });
      });

      // 10. RIDE TYPE PICKER HANDLER
      var rideTypeBtns = document.querySelectorAll('.ride-type-btn');
      rideTypeBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          rideTypeBtns.forEach(function(b) {
            b.classList.remove('active', 'border-skyBrand', 'bg-skyLight');
            b.classList.add('border-slate-200/80', 'bg-slate-50');
          });
          btn.classList.add('active', 'border-skyBrand', 'bg-skyLight');
          btn.classList.remove('border-slate-200/80', 'bg-slate-50');

          selectedRideType = btn.getAttribute('data-type');
          baseFare = parseInt(btn.getAttribute('data-base') || '20');
          perKmFare = parseInt(btn.getAttribute('data-perkm') || '7');

          calculateFare();
        });
      });

      // 11. BOOK BIKE RIDE BUTTON ACTION
      var bookBtn = document.getElementById('btn-book-bike-ride');
      if (bookBtn) {
        bookBtn.addEventListener('click', function() {
          var valRes = validateAddresses();
          if (!valRes.isValid) {
            var banner = document.getElementById('address-validation-banner');
            var bannerText = document.getElementById('validation-banner-text');
            if (bannerText) bannerText.textContent = valRes.errorMsg;
            if (banner) banner.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }

          var pickupAddr = (document.getElementById('pickup-address-input') || {}).value || '';
          var dropAddr = (document.getElementById('drop-address-input') || {}).value || '';
          var passengerName = (document.getElementById('passenger-name') || {}).value || '';
          var passengerPhone = (document.getElementById('passenger-phone') || {}).value || '';

          if (!passengerName.trim() || !passengerPhone.trim()) {
            alert('Please enter Passenger Name and Mobile Number');
            return;
          }

          var finalFare = calculateFare();
          var orderId = 'RIDE-BHU-' + Math.floor(100000 + Math.random() * 900000);

          var rideOrder = {
            id: orderId,
            type: 'BIKE_RIDE',
            rideType: selectedRideType,
            passengerName: passengerName,
            passengerPhone: passengerPhone,
            pickupAddress: pickupAddr,
            dropAddress: dropAddr,
            distance: distanceKm + ' km',
            total: finalFare,
            status: 'Captain Assigned',
            captain: 'Karan Sharma (Fleet Captain)',
            bikeNumber: 'MH 19 BJ 4820 (Sky Blue Scooter)',
            timestamp: new Date().toISOString()
          };

          try {
            localStorage.setItem('bhusawal_active_order', JSON.stringify(rideOrder));
            var orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            orders.unshift(rideOrder);
            localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
          } catch(e) {}

          alert('🛵 Bike ride booked! Captain Karan Sharma is assigned and reaching pickup location in 2 minutes. Redirecting to live tracking...');
          window.location.href = '/track_order';
        });
      }

      var pIn = document.getElementById('pickup-address-input');
      var dIn = document.getElementById('drop-address-input');
      if (pIn) pIn.addEventListener('input', validateAddresses);
      if (dIn) dIn.addEventListener('input', validateAddresses);

    })();
  </script>
</body>
</html>
