---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Pickup & Drop Service | Bhusawal Connect</title>
  
  <!-- TAILWIND & GOOGLE FONTS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- LEAFLET MAPS FOR ROUTE PREVIEW & MAP PICKER -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- ENERGETIC YELLOW & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            yellowBrand: '#FACC15',
            yellowDark: '#CA8A04',
            yellowLight: '#FEF9C3',
            yellowBorder: '#FEF08A',
            yellowAccent: '#EAB308',
            yellowDeep: '#854D0E'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }

    /* Custom Leaflet Pin Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(202, 138, 4, 0.2);
    }
  </style>
</head>

<body class="pb-36 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors active:scale-95">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>📦 Personal Pickup & Drop</span>
          <span class="bg-yellowLight text-yellowDeep text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-yellowBorder">ITEM COURIER</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Request Bhusawal Connect to pick up & deliver any item for you</p>
      </div>
    </div>

    <!-- Help & Support -->
    <a href="tel:+919876543210" class="flex items-center gap-1.5 px-3 py-1.5 bg-yellowLight text-yellowDeep text-xs font-black rounded-full border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all shadow-xs">
      <span class="material-symbols-outlined text-sm">headset_mic</span>
      <span class="hidden sm:inline">24x7 Support</span>
    </a>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-7">

    <!-- VALIDATION ERROR TOAST BANNER (Hidden by default) -->
    <div id="address-validation-banner" class="hidden bg-rose-500 text-white p-4 rounded-2xl shadow-lg border border-rose-600 flex items-center justify-between gap-3 animate-bounce">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-xl">warning</span>
        <p class="text-xs font-black" id="validation-banner-text">Pickup and Drop locations must be different!</p>
      </div>
      <button type="button" onclick="document.getElementById('address-validation-banner').classList.add('hidden');" class="text-white hover:text-rose-200 font-black text-xs">✕</button>
    </div>


    <!-- ==================== HERO BANNER: DELIVERY EXECUTIVE CARRYING PARCEL/SHOPPING BAG ==================== -->
    <section class="bg-gradient-to-r from-yellowBrand via-amber-400 to-yellowDark text-slate-950 rounded-3xl p-6 sm:p-8 shadow-xl overflow-hidden relative group">
      <div class="absolute -top-12 -right-12 w-56 h-56 bg-white/25 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center relative z-10">
        <div class="sm:col-span-7 space-y-3 text-center sm:text-left">
          <span class="px-3 py-1 rounded-full bg-slate-950 text-yellowBrand text-[10px] font-black uppercase tracking-wider shadow-sm">
            PERSONAL PICKUP & DELIVERY SERVICE
          </span>
          <h2 class="text-2xl sm:text-3xl font-black font-display text-slate-950 leading-tight">
            Forgot something? We'll Pick It Up For You!
          </h2>
          <p class="text-xs sm:text-sm text-slate-900 font-bold leading-relaxed">
            Need lunch box from home, keys left at work, or packages picked up? Our delivery executives collect & deliver anywhere in Bhusawal in 25 minutes!
          </p>

          <div class="pt-1 flex flex-wrap items-center justify-center sm:justify-start gap-2.5 text-[11px] font-black text-slate-900">
            <span class="bg-white/40 px-2.5 py-1 rounded-full border border-slate-900/10">⚡ Doorstep Pickup</span>
            <span class="bg-white/40 px-2.5 py-1 rounded-full border border-slate-900/10">🛡️ Insured Handover</span>
            <span class="bg-white/40 px-2.5 py-1 rounded-full border border-slate-900/10">🔒 OTP Verified Delivery</span>
          </div>
        </div>

        <div class="sm:col-span-5 flex items-center justify-center">
          <div class="w-full max-w-[260px] aspect-video sm:aspect-square bg-white rounded-2xl p-2 border-2 border-slate-900/15 shadow-2xl overflow-hidden group-hover:scale-105 transition-transform duration-300">
            <img 
              src="/assets/scooter_parcel_delivery.jpg" 
              alt="Delivery executive carrying a parcel and shopping bag" 
              class="w-full h-full object-cover rounded-xl"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?auto=format&fit=crop&w=600&q=80';" 
            />
          </div>
        </div>
      </div>
    </section>


    <!-- ==================== ADDRESS SELECTION ==================== -->
    <div class="space-y-4">
      
      <!-- ==================== 1. PICKUP ADDRESS ==================== -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-yellowBrand transition-all" id="pickup-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-yellowBrand text-slate-950 flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">upload_location</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>📍 Pickup Address</span>
                <span class="text-[10px] font-extrabold text-yellowDeep bg-yellowLight px-2 py-0.5 rounded-full border border-yellowBorder">Where to Collect Item</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select location where our executive collects your item</p>
            </div>
          </div>

          <!-- ADDRESS METHOD ACTION BUTTONS -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btn-pickup-gps" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-950 bg-yellowBrand hover:bg-yellowDark hover:text-white px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">gps_fixed</span>
              <span>GPS Location</span>
            </button>

            <button id="btn-pickup-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-yellowLight hover:bg-yellowBrand px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">map</span>
              <span>Select on Map</span>
            </button>
          </div>
        </div>

        <!-- SEARCH AUTOCOMPLETE INPUT -->
        <div class="relative">
          <label for="pickup-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Pickup Address (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-yellowDark text-lg">search</span>
            <input 
              type="text" 
              id="pickup-address-input" 
              value="Varangaon Road, Near Station Square, Bhusawal" 
              placeholder="Search pickup landmark, colony or street in Bhusawal..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
              autocomplete="off"
            />
            <button id="clear-pickup-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <!-- Live Search Suggestions Dropdown -->
          <div id="pickup-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- SENDER DETAILS (NAME & PHONE) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="sender-name" class="text-[11px] font-bold text-slate-600 block mb-1">Sender Name <span class="text-rose-500">*</span></label>
            <input 
              type="text" 
              id="sender-name" 
              value="Rahul Patil" 
              placeholder="Person handing over item" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
            />
          </div>

          <div>
            <label for="sender-phone" class="text-[11px] font-bold text-slate-600 block mb-1">Sender Mobile <span class="text-rose-500">*</span></label>
            <input 
              type="tel" 
              id="sender-phone" 
              value="9876543210" 
              placeholder="10-digit phone number" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
            />
          </div>
        </div>

        <!-- SAVED & RECENT PICKUP CHIPS -->
        <div class="space-y-2 pt-1 border-t border-slate-100">
          <div class="flex items-center justify-between text-[11px] font-bold">
            <span class="text-slate-500">💾 Saved & 🕒 Recent Pickup Locations:</span>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-[11px] font-bold" id="pickup-quick-chips">
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-yellowLight text-yellowDeep border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Home - Varangaon Road, Bhusawal">
              🏠 Home (Varangaon Rd)
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-yellowLight text-yellowDeep border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Office - Railway Divisional Office, Bhusawal">
              🏢 Work (Railway Div Office)
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-yellowLight hover:text-yellowDeep transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Jamner Road Market, Bhusawal">
              🕒 Jamner Rd Market
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-yellowLight hover:text-yellowDeep transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Bhusawal Station Platform Gate 1">
              🚉 Railway Station
            </button>
          </div>
        </div>
      </section>


      <!-- ==================== SWAP LOCATIONS BUTTON ==================== -->
      <div class="flex items-center justify-center my-[-8px] relative z-20">
        <button 
          id="btn-swap-addresses" 
          type="button" 
          class="flex items-center gap-2 bg-gradient-to-r from-yellowBrand to-yellowDark text-slate-950 px-5 py-2.5 rounded-full font-black text-xs shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all border-2 border-white cursor-pointer group"
          title="Swap Pickup and Drop Locations with 1 Click"
        >
          <span class="material-symbols-outlined text-base group-hover:rotate-180 transition-transform duration-500">swap_vert</span>
          <span>Swap Pickup & Drop</span>
        </button>
      </div>


      <!-- ==================== 2. DROP ADDRESS ==================== -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-yellowBrand transition-all" id="drop-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-slate-900 text-yellowBrand flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">download_location</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>🏁 Drop Address</span>
                <span class="text-[10px] font-extrabold text-slate-900 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200">Where to Deliver</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select destination location for item delivery</p>
            </div>
          </div>

          <!-- ADDRESS METHOD ACTION BUTTONS -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btn-drop-gps" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-950 bg-yellowBrand hover:bg-yellowDark hover:text-white px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">gps_fixed</span>
              <span>GPS Location</span>
            </button>

            <button id="btn-drop-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-yellowLight hover:bg-yellowBrand px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">map</span>
              <span>Select on Map</span>
            </button>
          </div>
        </div>

        <!-- SEARCH AUTOCOMPLETE INPUT -->
        <div class="relative">
          <label for="drop-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Drop Address (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-900 text-lg">flag</span>
            <input 
              type="text" 
              id="drop-address-input" 
              value="Jamner Road, Near Ordnance Factory Gate, Bhusawal" 
              placeholder="Search destination landmark, area or street in Bhusawal..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
              autocomplete="off"
            />
            <button id="clear-drop-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <!-- Live Search Suggestions Dropdown -->
          <div id="drop-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- RECEIVER DETAILS (NAME & PHONE) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="receiver-name" class="text-[11px] font-bold text-slate-600 block mb-1">Receiver Name <span class="text-rose-500">*</span></label>
            <input 
              type="text" 
              id="receiver-name" 
              value="Priya Patil" 
              placeholder="Person receiving item" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
            />
          </div>

          <div>
            <label for="receiver-phone" class="text-[11px] font-bold text-slate-600 block mb-1">Receiver Mobile <span class="text-rose-500">*</span></label>
            <input 
              type="tel" 
              id="receiver-phone" 
              value="9123456789" 
              placeholder="10-digit phone number" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
            />
          </div>
        </div>

        <!-- SAVED & RECENT DROP CHIPS -->
        <div class="space-y-2 pt-1 border-t border-slate-100">
          <div class="flex items-center justify-between text-[11px] font-bold">
            <span class="text-slate-500">💾 Saved & 🕒 Popular Drop Destinations:</span>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-[11px] font-bold" id="drop-quick-chips">
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-yellowLight text-yellowDeep border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Ordnance Factory Estate, Jamner Road, Bhusawal">
              🏢 Ordnance Factory
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-yellowLight text-yellowDeep border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Deepnagar Thermal Power Station Colony, Bhusawal">
              ⚡ Deepnagar Township
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-yellowLight hover:text-yellowDeep transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Nahata Arts & Science College Chowk, Bhusawal">
              🎓 Nahata Chowk
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-yellowLight hover:text-yellowDeep transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Khedi Road, Tapi River Bridge End, Bhusawal">
              🕒 Khedi Road
            </button>
          </div>
        </div>
      </section>

    </div>


    <!-- ==================== GOOGLE MAPS ROUTE PREVIEW ==================== -->
    <section class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="text-yellowDark">🗺️</span>
            <span>Google Maps Delivery Route</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium">Real-time distance and delivery route calculation in Bhusawal</p>
        </div>

        <div class="flex items-center gap-2 bg-yellowLight border border-yellowBorder px-3 py-1 rounded-xl text-xs font-black text-yellowDeep shadow-xs">
          <span>⚡ <span id="route-distance-text">3.2 km</span></span>
          <span class="text-yellowDark/40">•</span>
          <span>⏱️ <span id="route-time-text">25 mins Delivery</span></span>
        </div>
      </div>

      <!-- MAP CONTAINER -->
      <div class="w-full h-56 sm:h-64 rounded-2xl overflow-hidden border border-slate-200 relative shadow-inner z-10" id="route-map">
        <!-- Leaflet map initialized via JS -->
      </div>
    </section>


    <!-- ==================== WHAT DO YOU WANT US TO PICK UP? ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-5">
      <div>
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
          <span class="text-yellowDark text-xl">📦</span>
          <span>What do you want us to pick up?</span>
          <span class="text-[10px] font-extrabold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">Required</span>
        </h2>
        <p class="text-xs text-slate-500 font-medium">Select the item type so our executive brings appropriate bag/box</p>
      </div>

      <!-- 10 QUICK ITEM CATEGORIES -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3" id="item-categories-grid">
        <button type="button" class="item-cat-btn active p-3 rounded-2xl border-2 border-yellowBrand bg-yellowLight text-left transition-all cursor-pointer shadow-2xs active:scale-95" data-cat="Documents">
          <span class="text-2xl block mb-1">📄</span>
          <span class="text-xs font-black text-slate-900 block">Documents</span>
          <span class="text-[10px] text-slate-500 font-semibold">Papers, Files</span>
        </button>

        <button type="button" class="item-cat-btn p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 text-left transition-all cursor-pointer shadow-2xs hover:border-yellowBrand active:scale-95" data-cat="Keys">
          <span class="text-2xl block mb-1">🔑</span>
          <span class="text-xs font-black text-slate-900 block">Keys</span>
          <span class="text-[10px] text-slate-500 font-semibold">Home, Vehicle</span>
        </button>

        <button type="button" class="item-cat-btn p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 text-left transition-all cursor-pointer shadow-2xs hover:border-yellowBrand active:scale-95" data-cat="Tiffin">
          <span class="text-2xl block mb-1">🍱</span>
          <span class="text-xs font-black text-slate-900 block">Tiffin</span>
          <span class="text-[10px] text-slate-500 font-semibold">Home Lunch Box</span>
        </button>

        <button type="button" class="item-cat-btn p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 text-left transition-all cursor-pointer shadow-2xs hover:border-yellowBrand active:scale-95" data-cat="Shopping Bag">
          <span class="text-2xl block mb-1">🛍</span>
          <span class="text-xs font-black text-slate-900 block">Shopping Bag</span>
          <span class="text-[10px] text-slate-500 font-semibold">Retail Purchase</span>
        </button>

        <button type="button" class="item-cat-btn p-3 rounded-2xl border-2 border-slate-200 bg-slate-50 text-left transition-all cursor-pointer shadow-2xs hover:border-yellowBrand active:scale-95" data-cat="Clothes">
          <span class="text-2xl block mb-1">👕</span>
