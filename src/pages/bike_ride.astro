---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🛵 Pickup & Drop (Bike Taxi) | Bhusawal Connect</title>
  
  <!-- TAILWIND & GOOGLE FONTS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- LEAFLET MAPS FOR ROUTE PREVIEW & MAP PICKER -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- ENERGETIC YELLOW & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            yellowBrand: '#FACC15',
            yellowDark: '#CA8A04',
            yellowLight: '#FEF9C3',
            yellowBorder: '#FEF08A',
            yellowAccent: '#EAB308',
            yellowDeep: '#854D0E'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }

    /* Custom Leaflet Pin Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(202, 138, 4, 0.2);
    }
  </style>
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
</head>

<body class="pb-36 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors active:scale-95">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>🛵 Pickup & Drop</span>
          <span class="bg-yellowLight text-yellowDeep text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-yellowBorder">BIKE TAXI ONLY</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Fast Bike Taxi across Bhusawal</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <!-- History Link -->
      <a href="/parcel_history" class="px-3 py-1.5 bg-yellowLight text-yellowDeep text-xs font-black rounded-xl border border-yellowBorder hover:bg-yellowBrand hover:text-slate-950 transition-all flex items-center gap-1 shadow-2xs">
        <span class="material-symbols-outlined text-base">history</span>
        <span class="hidden sm:inline">Ride History</span>
      </a>

      <!-- 24/7 Support -->
      <a href="tel:+919876543210" class="flex items-center gap-1 px-2.5 py-1.5 bg-slate-100 text-slate-700 text-xs font-black rounded-xl hover:bg-slate-200 transition-all">
        <span class="material-symbols-outlined text-sm">headset_mic</span>
      </a>
    </div>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-7">

    <!-- ==================== HERO SECTION REDESIGN ==================== -->
    <section class="relative overflow-hidden bg-gradient-to-br from-yellowBrand via-amber-400 to-yellow-500 rounded-3xl p-6 sm:p-10 text-slate-950 shadow-xl border border-yellowDark/20 group">
      
      <!-- BACKGROUND ACCENT GLOWS -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/30 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-amber-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- LEFT COLUMN: CONTENT -->
        <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
          
          <!-- TOP BADGE -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950 text-yellowBrand text-xs font-black uppercase tracking-wider shadow-md">
            <span class="w-2 h-2 rounded-full bg-yellowBrand animate-ping"></span>
            <span>BHUSAWAL SUPER APP • 24/7 BIKE TAXI</span>
          </div>

          <!-- HEADLINE -->
          <h1 class="text-3xl sm:text-5xl font-black font-display tracking-tight text-slate-950 leading-tight sm:leading-none">
            Book a Bike Taxi in Minutes
          </h1>

          <!-- SUBHEADING -->
          <p class="text-base sm:text-xl font-extrabold text-slate-900/90 tracking-wide uppercase">
            Fast • Affordable • Safe
          </p>

          <!-- CTA BUTTON (LARGE YELLOW BUTTON) -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a 
              href="#pickup-section-card" 
              onclick="document.getElementById('pickup-address-input').focus();"
              class="w-full sm:w-auto px-10 py-4 bg-yellowBrand hover:bg-yellowDark text-slate-950 hover:text-white active:scale-95 transition-all duration-300 rounded-2xl font-black text-lg sm:text-xl shadow-2xl flex items-center justify-center gap-3 border-2 border-slate-950 group/btn cursor-pointer"
            >
              <span>🛵 Book Bike Taxi</span>
              <span class="material-symbols-outlined text-2xl group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>

          <!-- 4 FEATURE BADGES -->
          <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 text-left">
            
            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">⚡</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Fast Pickup</p>
                <p class="text-[10px] font-bold text-slate-600">~3 Mins ETA</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">📍</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Live Tracking</p>
                <p class="text-[10px] font-bold text-slate-600">Real-time GPS</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">🛡</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Verified Riders</p>
                <p class="text-[10px] font-bold text-slate-600">100% Safe Rides</p>
              </div>
            </div>

            <div class="bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-white/80 shadow-md flex items-center gap-2.5 hover:scale-105 transition-transform">
              <span class="text-xl">💰</span>
              <div>
                <p class="text-xs font-black text-slate-900 leading-tight">Affordable Fare</p>
                <p class="text-[10px] font-bold text-slate-600">From ₹25 Only</p>
              </div>
            </div>

          </div>

        </div>

        <!-- RIGHT COLUMN: MODERN BIKE TAXI ILLUSTRATION -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/90 bg-white group-hover:scale-[1.02] transition-transform duration-300">
            <img 
              src="/assets/services/service_bike_taxi_hero.jpg?v=3" 
              alt="Modern Bike Taxi Illustration with Rider and Passenger wearing Helmets" 
              class="w-full h-60 sm:h-72 lg:h-84 object-cover"
              onerror="this.onerror=null;this.src='/assets/service_bike_taxi_hero.jpg';"
            />
            
            <!-- OVERLAY BADGE -->
            <div class="absolute bottom-3 left-3 right-3 bg-slate-950/85 backdrop-blur-md p-3 rounded-2xl text-white flex items-center justify-between border border-white/20">
              <div class="flex items-center gap-2">
                <span class="text-xl">🛵</span>
                <div>
                  <p class="text-xs font-black text-yellowBrand">Premium Bike Taxi</p>
                  <p class="text-[10px] text-slate-300 font-medium">Helmet Safety • Instant Rider</p>
                </div>
              </div>
              <span class="text-[10px] font-black bg-yellowBrand text-slate-950 px-2.5 py-1 rounded-lg uppercase shadow-xs">Fast & Safe</span>
            </div>

          </div>
        </div>

      </div>

    </section>

    <!-- VALIDATION ERROR TOAST BANNER -->
    <div id="address-validation-banner" class="hidden bg-rose-500 text-white p-4 rounded-2xl shadow-lg border border-rose-600 flex items-center justify-between gap-3 animate-bounce">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-xl">warning</span>
        <p class="text-xs font-black" id="validation-banner-text">Pickup and Drop locations must be different!</p>
      </div>
      <button type="button" onclick="document.getElementById('address-validation-banner').classList.add('hidden');" class="text-white hover:text-rose-200 font-black text-xs">✕</button>
    </div>


    <!-- ==================== 1. ADDRESS SELECTION (PICKUP & DROP) ==================== -->
    <div class="space-y-4">
      
      <!-- PICKUP LOCATION -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-yellowBrand transition-all" id="pickup-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-yellowBrand text-slate-950 flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">my_location</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>📍 Pickup Address</span>
                <span class="text-[10px] font-extrabold text-yellowDeep bg-yellowLight px-2 py-0.5 rounded-full border border-yellowBorder">Boarding Spot</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select where driver collects you</p>
            </div>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btn-pickup-gps" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-950 bg-yellowBrand hover:bg-yellowDark hover:text-white px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">gps_fixed</span>
              <span>GPS Location</span>
            </button>

            <button id="btn-pickup-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-yellowLight hover:bg-yellowBrand px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">map</span>
              <span>Select on Map</span>
            </button>
          </div>
        </div>

        <div class="relative">
          <label for="pickup-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Pickup Address (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-yellowDark text-lg">search</span>
            <input 
              type="text" 
              id="pickup-address-input" 
              value="Varangaon Road, Near Station Square, Bhusawal" 
              placeholder="Search pickup landmark, colony or street in Bhusawal..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
              autocomplete="off"
            />
            <button id="clear-pickup-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <div id="pickup-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically -->
          </div>
        </div>
      </section>


      <!-- DROP LOCATION -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-yellowBrand transition-all" id="drop-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">location_on</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>🏁 Drop Address</span>
                <span class="text-[10px] font-extrabold text-slate-700 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200">Destination</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select your ride destination in Bhusawal</p>
            </div>
          </div>

          <button id="btn-drop-select-map" type="button" class="flex items-center gap-1 text-[11px] font-black text-slate-900 bg-yellowLight hover:bg-yellowBrand px-3 py-1.5 rounded-xl border border-yellowBorder transition-all shadow-xs active:scale-95">
            <span class="material-symbols-outlined text-sm">map</span>
            <span>Select on Map</span>
          </button>
        </div>

        <div class="relative">
          <label for="drop-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Drop Address (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg">search</span>
            <input 
              type="text" 
              id="drop-address-input" 
              value="Jamner Road, Ordnance Factory Gate, Bhusawal" 
              placeholder="Search drop location, shop or colony..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellowBrand transition-all" 
              autocomplete="off"
            />
            <button id="clear-drop-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <div id="drop-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically -->
          </div>
        </div>
      </section>

    </div>


    <!-- ==================== 2. GOOGLE MAPS ROUTE ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="text-yellowDark">🗺️</span>
            <span>Google Maps Route & Live Navigation</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium">Real-time route calculation between pickup and drop points</p>
        </div>

        <div class="flex items-center gap-2 bg-yellowLight border border-yellowBorder px-3 py-1 rounded-xl text-xs font-black text-yellowDeep shadow-2xs">
          <span>⚡ <span id="route-distance-text">3.2 km</span></span>
          <span class="text-yellowDark">•</span>
          <span>⏱️ <span id="route-time-text">12 mins</span></span>
        </div>
      </div>

      <!-- MAP CONTAINER -->
      <div class="w-full h-56 sm:h-64 rounded-2xl overflow-hidden border border-slate-200 relative shadow-inner z-10" id="route-map">
        <iframe
          class="w-full h-full border-0 absolute inset-0 z-0"
          src="https://maps.google.com/maps?q=21.0478,75.7896&hl=en&z=14&output=embed"
          allowfullscreen=""
          loading="lazy"
          title="Google Maps Bhusawal Route">
        </iframe>
        <div class="absolute bottom-3 left-3 z-10 bg-slate-950/90 text-white text-[10px] font-black px-3 py-1.5 rounded-xl border border-yellowBrand/40 shadow-lg backdrop-blur-xs flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-yellowBrand animate-ping"></span>
          <span>Google Maps Base Layer • Bhusawal Junction Zone</span>
        </div>
      </div>
    </section>


    <!-- ==================== 3. ESTIMATED BIKE FARE & BREAKDOWN ==================== -->
    <section class="bg-gradient-to-br from-yellowLight via-white to-amber-50/60 rounded-3xl p-5 sm:p-6 border border-yellowBorder shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-yellowBrand text-slate-950 flex items-center justify-center font-black shadow-xs">
            <span class="material-symbols-outlined text-lg">receipt_long</span>
          </div>
          <div>
            <h2 class="text-base font-black font-display text-slate-900">Fare Estimation</h2>
            <p class="text-xs text-slate-500 font-medium">Bike Taxi pricing calculated on distance & duration</p>
          </div>
        </div>

        <span class="bg-yellowBrand text-slate-950 text-[11px] font-black px-3 py-1 rounded-full border border-yellowDark/20 shadow-2xs">
          🛵 Bike Taxi
        </span>
      </div>

      <div class="bg-white/90 backdrop-blur-md rounded-2xl p-4 border border-yellowBorder space-y-2.5">
        <!-- 1. Estimated Distance -->
        <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-yellowDark text-sm">straighten</span>
            Estimated Distance
          </span>
          <span class="font-bold text-slate-900" id="fare-distance-km">3.2 km</span>
        </div>

        <!-- 2. Estimated Time -->
        <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-yellowDark text-sm">schedule</span>
            Estimated Time
          </span>
          <span class="font-bold text-slate-900" id="fare-duration-text">12 Mins</span>
        </div>

        <!-- 3. Base Fare -->
        <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-yellowDark text-sm">payments</span>
            Base Fare
          </span>
          <span class="font-bold text-slate-900" id="fare-base-amount">₹25</span>
        </div>

        <!-- 4. Distance Charge -->
        <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-yellowDark text-sm">add_road</span>
            Distance Charge
          </span>
          <span class="font-bold text-slate-900" id="fare-distance-cost">₹9</span>
        </div>

        <div class="flex items-center justify-between text-xs font-semibold text-emerald-600 pt-1 border-t border-slate-100">
          <span>Welcome Pass Discount</span>
          <span class="font-bold">-₹5</span>
        </div>

        <!-- 5. Total Fare -->
        <div class="flex items-center justify-between text-base sm:text-lg font-black font-display text-slate-900 pt-2 border-t-2 border-slate-200">
          <span>Total Fare</span>
          <span class="text-xl sm:text-2xl text-yellowDeep" id="total-fare-display">₹29</span>
        </div>
      </div>
    </section>

  </main>


  <!-- ==================== MAP PICKER MODAL ==================== -->
  <div id="map-picker-modal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl space-y-0 flex flex-col max-h-[90vh]">
      
      <!-- MODAL HEADER -->
      <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-yellowBrand text-xl">pin_drop</span>
          <div>
            <h3 class="text-sm font-black font-display" id="modal-map-title">Select Location on Map</h3>
            <p class="text-[10px] text-slate-400 font-medium">Drag map to pin exact spot in Bhusawal</p>
          </div>
        </div>
        <button id="close-map-modal" type="button" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-colors">✕</button>
      </div>

      <!-- MAP CONTAINER -->
      <div class="h-80 w-full relative bg-slate-100" id="picker-map-container">
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
          <div class="w-10 h-10 -mt-10 flex flex-col items-center">
            <span class="text-3xl drop-shadow-md animate-bounce" id="picker-pin-emoji">📍</span>
            <span class="w-3 h-1.5 bg-slate-900/40 rounded-full blur-xs"></span>
          </div>
        </div>
      </div>

      <!-- FOOTER -->
      <div class="p-4 bg-white border-t border-slate-100 space-y-3">
        <div>
          <span class="text-[10px] font-black text-yellowDark uppercase tracking-wider block">Selected Location</span>
          <p class="text-xs font-bold text-slate-800 truncate" id="picker-address-text">Varangaon Road, Bhusawal</p>
        </div>

        <button id="btn-confirm-map-picker" type="button" class="w-full py-3 bg-yellowBrand hover:bg-yellowDark text-slate-950 hover:text-white text-xs font-black rounded-xl shadow-md transition-all active:scale-95">
          Confirm Selected Location
        </button>
      </div>

    </div>
  </div>


  <!-- ==================== RIDER SEARCH & ASSIGNMENT MODAL ==================== -->
  <div id="partner-search-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-3xl overflow-hidden shadow-2xl border border-slate-100 text-center space-y-0 relative animate-in fade-in zoom-in-95 duration-200">
      
      <!-- CLOSE MODAL BUTTON -->
      <button id="btn-close-partner-search-modal" class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>

      <!-- PHASE 1: SEARCHING RADAR ANIMATION -->
      <div id="partner-searching-phase" class="p-6 sm:p-8 space-y-5">
        <div class="relative w-28 h-28 mx-auto flex items-center justify-center my-2">
          <!-- Pulse Rings -->
          <div class="absolute inset-0 bg-yellowBrand/20 rounded-full animate-ping"></div>
          <div class="absolute inset-2 bg-yellowBrand/30 rounded-full animate-pulse"></div>
          
          <div class="w-20 h-20 rounded-full bg-yellowBrand text-slate-950 flex items-center justify-center text-4xl shadow-xl relative z-10 border-4 border-white">
            <span>🛵</span>
          </div>
        </div>

        <div class="space-y-1">
          <h3 class="text-xl font-black font-display text-slate-900">Searching Nearby Bike Riders...</h3>
          <p class="text-xs font-bold text-slate-500">Connecting your pickup request with nearby Bike Taxi riders in Bhusawal</p>
        </div>

        <div class="bg-yellowLight rounded-2xl p-3 border border-yellowBorder flex items-center justify-around text-xs font-black text-yellowDeep">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">near_me</span>
            <span>5 Active Bike Riders</span>
          </div>
          <div class="w-px h-4 bg-yellowBorder"></div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">schedule</span>
            <span>~3 Mins ETA</span>
          </div>
        </div>

        <button id="btn-cancel-search" type="button" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-all">
          Cancel Request
        </button>
      </div>

      <!-- PHASE 2: BIKE RIDER ACCEPTED DETAILS -->
      <div id="partner-accepted-phase" class="hidden p-6 sm:p-8 space-y-5 text-left bg-gradient-to-b from-yellowLight/50 to-white">
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-black text-emerald-700 uppercase tracking-wider">Bike Ride Accepted 🎉</span>
          </div>
          <span class="text-xs font-black text-yellowDeep bg-yellowLight px-2.5 py-0.5 rounded-full border border-yellowBorder">🛵 Bike Taxi</span>
        </div>

        <!-- RIDER PROFILE CARD -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3.5">
          <div class="relative">
            <img id="modal-driver-avatar" src="/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg" alt="Rider" class="w-14 h-14 rounded-full object-cover border-2 border-yellowBrand shadow-xs" />
            <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-black">✓</span>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <h4 class="text-base font-black font-display text-slate-900 truncate">Vikram Patil</h4>
              <span class="bg-emerald-100 text-emerald-800 text-[9px] font-black px-1.5 py-0.5 rounded-md uppercase">VERIFIED</span>
            </div>
            <p class="text-xs font-bold text-slate-500">4.9 ⭐ • 850+ Bike Rides Completed</p>
            <p class="text-xs font-black text-yellowDeep mt-0.5">EV Bike • MH 19 BJ 5921</p>
          </div>
        </div>

        <!-- TRIP METRICS -->
        <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 grid grid-cols-2 gap-2 text-xs">
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase block">Boarding OTP</span>
            <span class="text-base font-black font-mono text-slate-900">4892</span>
          </div>
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase block">Arrival Time</span>
            <span class="text-sm font-black text-emerald-700">3 Mins</span>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="grid grid-cols-2 gap-2.5">
          <a href="tel:+919876543210" class="py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-base">call</span>
            <span>Call Rider</span>
          </a>

          <button id="btn-track-live-ride" type="button" class="py-3 bg-yellowBrand hover:bg-yellowDark text-slate-950 hover:text-white font-black text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-base">near_me</span>
            <span>Track Live Ride</span>
          </button>
        </div>

      </div>

    </div>
  </div>


  <!-- ==================== FIXED BOTTOM ACTION BAR ==================== -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-4 py-3.5 shadow-2xl">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      
      <div>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block">Total Bike Fare</span>
        <div class="flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black font-display text-yellowDeep" id="bar-fare-total">₹29</span>
          <span class="text-xs text-slate-400 line-through font-bold">₹40</span>
        </div>
      </div>

      <button 
        id="btn-confirm-ride-booking" 
        type="button" 
        class="flex-1 sm:flex-none px-8 sm:px-12 py-4 bg-yellowBrand hover:bg-yellowDark text-slate-950 hover:text-white text-base sm:text-lg font-black rounded-2xl shadow-xl hover:shadow-2xl active:scale-95 transition-all border-2 border-slate-950 flex items-center justify-center gap-3 cursor-pointer"
      >
        <span>Continue</span>
        <span class="material-symbols-outlined text-xl">arrow_forward</span>
      </button>

    </div>
  </div>
<!-- ==================== CLIENT DYNAMIC SCRIPT ==================== -->
  <script is:inline>
    (function() {
      // STATE VARIABLES FOR BIKE TAXI ONLY
      var baseFare = 25;
      var perKmFare = 7;
      var distanceKm = 3.2;

      var pickupCoords = [21.0455, 75.7893];
      var dropCoords = [21.0385, 75.8050];

      var sampleBhusawalPoints = [
        { name: 'Varangaon Road, Near Station Square, Bhusawal', coords: [21.0455, 75.7893] },
        { name: 'Jamner Road, Ordnance Factory Gate, Bhusawal', coords: [21.0385, 75.8050] },
        { name: 'Khadka Road, ZP School, Bhusawal', coords: [21.0512, 75.7920] },
        { name: 'Main Market, Cloth Market Square, Bhusawal', coords: [21.0480, 75.7845] },
        { name: 'Railway Colony, Quarter 42, Bhusawal', coords: [21.0420, 75.7980] },
        { name: 'Tapti Nagar, Block C, Bhusawal', coords: [21.0550, 75.8110] }
      ];

      // FARE CALCULATION (BIKE TAXI)
      function recalculateFare() {
        var extraDist = Math.max(0, distanceKm - 2);
        var distCost = Math.round(extraDist * perKmFare);
        var total = baseFare + distCost - 5; // ₹5 promo discount
        if (total < baseFare) total = baseFare;

        var elBase = document.getElementById('fare-base-amount');
        var elDistKm = document.getElementById('fare-distance-km');
        var elDistCost = document.getElementById('fare-distance-cost');
        var elTotalDisplay = document.getElementById('total-fare-display');
        var elBarTotal = document.getElementById('bar-fare-total');
        var elRouteDist = document.getElementById('route-distance-text');
        var elRouteTime = document.getElementById('route-time-text');
        var elDurationText = document.getElementById('fare-duration-text');

        var mins = Math.round(distanceKm * 4);
        if (mins < 8) mins = 8;

        if (elBase) elBase.textContent = '₹' + baseFare;
        if (elDistKm) elDistKm.textContent = distanceKm.toFixed(1) + ' km';
        if (elDistCost) elDistCost.textContent = '₹' + distCost;
        if (elTotalDisplay) elTotalDisplay.textContent = '₹' + total;
        if (elBarTotal) elBarTotal.textContent = '₹' + total;
        if (elRouteDist) elRouteDist.textContent = distanceKm.toFixed(1) + ' km';
        if (elRouteTime) elRouteTime.textContent = mins + ' mins';
        if (elDurationText) elDurationText.textContent = mins + ' Mins';
      }

      // INITIALIZE LEAFLET ROUTE MAP
      var map, routePolyline, pickupMarker, dropMarker;

      function initMap() {
        var mapContainer = document.getElementById('route-map');
        if (!mapContainer || typeof L === 'undefined') return;

        map = L.map('route-map', { zoomControl: false }).setView(pickupCoords, 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var yellowIcon = L.divIcon({
          className: 'custom-yellow-pin',
          html: '<div style="background:#FACC15;color:#000;padding:4px 8px;border-radius:12px;font-weight:900;font-size:11px;border:2px solid #CA8A04;">📍 Pickup</div>',
          iconSize: [60, 30]
        });

        var dropIcon = L.divIcon({
          className: 'custom-drop-pin',
          html: '<div style="background:#0F172A;color:#FFF;padding:4px 8px;border-radius:12px;font-weight:900;font-size:11px;border:2px solid #334155;">🏁 Drop</div>',
          iconSize: [60, 30]
        });

        pickupMarker = L.marker(pickupCoords, { icon: yellowIcon }).addTo(map);
        dropMarker = L.marker(dropCoords, { icon: dropIcon }).addTo(map);

        routePolyline = L.polyline([pickupCoords, dropCoords], {
          color: '#CA8A04',
          weight: 5,
          opacity: 0.8,
          dashArray: '10, 10'
        }).addTo(map);

        map.fitBounds(routePolyline.getBounds(), { padding: [30, 30] });
      }

      setTimeout(initMap, 500);

      // AUTOCOMPLETE DROPDOWNS
      function setupAutocomplete(inputId, dropdownId, onSelect) {
        var input = document.getElementById(inputId);
        var dropdown = document.getElementById(dropdownId);
        if (!input || !dropdown) return;

        input.addEventListener('input', function() {
          var val = input.value.toLowerCase().trim();
          if (val.length < 2) {
            dropdown.classList.add('hidden');
            return;
          }

          var matches = sampleBhusawalPoints.filter(function(p) {
            return p.name.toLowerCase().indexOf(val) !== -1;
          });

          if (matches.length === 0) {
            dropdown.classList.add('hidden');
            return;
          }

          var html = '';
          matches.forEach(function(m, idx) {
            html += `<div class="p-3 hover:bg-yellowLight cursor-pointer border-b border-slate-100 flex items-center gap-2 text-xs font-bold text-slate-800 dropdown-item-${inputId}" data-idx="${idx}">
              <span class="material-symbols-outlined text-yellowDark text-base">location_on</span>
              <span>${m.name}</span>
            </div>`;
          });

          dropdown.innerHTML = html;
          dropdown.classList.remove('hidden');

          dropdown.querySelectorAll(`.dropdown-item-${inputId}`).forEach(function(item) {
            item.addEventListener('click', function() {
              var idx = item.getAttribute('data-idx');
              var match = matches[idx];
              input.value = match.name;
              dropdown.classList.add('hidden');
              onSelect(match.coords);
            });
          });
        });
      }

      setupAutocomplete('pickup-address-input', 'pickup-search-dropdown', function(coords) {
        pickupCoords = coords;
        if (pickupMarker) pickupMarker.setLatLng(pickupCoords);
        updatePolyline();
      });

      setupAutocomplete('drop-address-input', 'drop-search-dropdown', function(coords) {
        dropCoords = coords;
        if (dropMarker) dropMarker.setLatLng(dropCoords);
        updatePolyline();
      });

      function updatePolyline() {
        if (routePolyline) routePolyline.setLatLngs([pickupCoords, dropCoords]);
        if (map) map.fitBounds(routePolyline.getBounds(), { padding: [30, 30] });

        // Calculate approximate distance
        var lat1 = pickupCoords[0], lon1 = pickupCoords[1];
        var lat2 = dropCoords[0], lon2 = dropCoords[1];
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        distanceKm = Math.round((6371 * c * 1.3) * 10) / 10;
        if (distanceKm < 1.5) distanceKm = 2.4;

        recalculateFare();
      }

      // BOOK BIKE RIDE CLICK HANDLER
      var btnConfirm = document.getElementById('btn-confirm-ride-booking');
      var searchModal = document.getElementById('partner-search-modal');
      var searchPhase1 = document.getElementById('partner-searching-phase');
      var searchPhase2 = document.getElementById('partner-accepted-phase');

      if (btnConfirm) {
        btnConfirm.addEventListener('click', function() {
          var pickVal = (document.getElementById('pickup-address-input') || {}).value || 'Varangaon Road, Bhusawal';
          var dropVal = (document.getElementById('drop-address-input') || {}).value || 'Jamner Road, Bhusawal';

          if (pickVal === dropVal) {
            var banner = document.getElementById('address-validation-banner');
            if (banner) banner.classList.remove('hidden');
            return;
          }

          // Open 2-Phase Searching Modal
          if (searchModal) {
            searchModal.classList.remove('hidden');
            if (searchPhase1) searchPhase1.classList.remove('hidden');
            if (searchPhase2) searchPhase2.classList.add('hidden');

            // Phase 2 transition after 3 seconds
            setTimeout(function() {
              if (searchPhase1) searchPhase1.classList.add('hidden');
              if (searchPhase2) searchPhase2.classList.remove('hidden');

              // SAVE ACTIVE ORDER IN LOCALSTORAGE
              var activeOrder = {
                id: 'RIDE-BHU-' + Math.floor(100000 + Math.random() * 900000),
                type: 'BIKE_RIDE',
                rideType: 'Bike Taxi',
                pickupAddress: pickVal,
                dropAddress: dropVal,
                total: document.getElementById('total-fare-display').textContent.replace('₹', ''),
                status: 'Request Accepted',
                rider: 'Vikram Patil',
                vehicle: 'EV Bike (MH 19 BJ 5921)',
                otp: '4892',
                otpVerified: false,
                timestamp: new Date().toISOString()
              };

              try {
                localStorage.setItem('bhusawal_active_order', JSON.stringify(activeOrder));
                var existing = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
                existing.unshift(activeOrder);
                localStorage.setItem('bhusawal_orders', JSON.stringify(existing));
              } catch(e) {}

            }, 3000);
          }
        });
      }

      // MODAL CLOSE & TRACK LIVE RIDE BUTTONS
      var btnCloseModal = document.getElementById('btn-close-partner-search-modal');
      var btnCancelSearch = document.getElementById('btn-cancel-search');
      var btnTrackRide = document.getElementById('btn-track-live-ride');

      if (btnCloseModal) btnCloseModal.addEventListener('click', function() { if (searchModal) searchModal.classList.add('hidden'); });
      if (btnCancelSearch) btnCancelSearch.addEventListener('click', function() { if (searchModal) searchModal.classList.add('hidden'); });

      if (btnTrackRide) {
        btnTrackRide.addEventListener('click', function() {
          window.location.href = '/track_order';
        });
      }

    })();
  </script>
</body>
</html>
