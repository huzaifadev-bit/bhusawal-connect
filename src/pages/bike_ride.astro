---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pickup & Drop Bike Ride (Passenger Transport) | Bhusawal Connect</title>
  
  <!-- TAILWIND & GOOGLE FONTS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- LEAFLET MAPS FOR ROUTE PREVIEW & MAP PICKER -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- SKY BLUE & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            skyBrand: '#0284C7',
            skyDark: '#0369A1',
            skyLight: '#F0F9FF',
            skyBorder: '#BAE6FD',
            skyAccent: '#38BDF8'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }

    /* Custom Leaflet Pin Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.15);
    }
  </style>
</head>

<body class="pb-36 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors active:scale-95">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>🛵 Bike Ride Pickup & Drop</span>
          <span class="bg-skyLight text-skyBrand text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-skyBorder">PASSENGER RIDE</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Fast, Affordable & Safe Scooter Transport across Bhusawal</p>
      </div>
    </div>

    <!-- Help & Support -->
    <a href="tel:+919876543210" class="flex items-center gap-1.5 px-3 py-1.5 bg-skyLight text-skyBrand text-xs font-black rounded-full border border-skyBorder hover:bg-skyBrand hover:text-white transition-all shadow-xs">
      <span class="material-symbols-outlined text-sm">headset_mic</span>
      <span class="hidden sm:inline">24x7 Ride Support</span>
    </a>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-7">

    <!-- VALIDATION ERROR TOAST BANNER (Hidden by default) -->
    <div id="address-validation-banner" class="hidden bg-rose-500 text-white p-4 rounded-2xl shadow-lg border border-rose-600 flex items-center justify-between gap-3 animate-bounce">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-xl">warning</span>
        <p class="text-xs font-black" id="validation-banner-text">Pickup and Drop locations must be different!</p>
      </div>
      <button type="button" onclick="document.getElementById('address-validation-banner').classList.add('hidden');" class="text-white hover:text-rose-200 font-black text-xs">✕</button>
    </div>


    <!-- ==================== LARGE HERO ILLUSTRATION (TWO PEOPLE RIDING A SCOOTER/BIKE) ==================== -->
    <section class="bg-gradient-to-r from-skyBrand via-sky-600 to-skyDark text-white rounded-3xl p-6 shadow-md overflow-hidden relative group">
      <!-- Background subtle glow -->
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center relative z-10">
        
        <!-- LEFT 7 COLS: RIDE PROMO CONTENT -->
        <div class="sm:col-span-7 space-y-3 text-center sm:text-left">
          
          <!-- Live Nearby Riders Indicator -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-black tracking-wide border border-white/30">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>⚡ <strong class="text-emerald-300">4 Captains Active</strong> near Station Chowk (~2 min pickup)</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black font-display leading-tight">
            Book a Quick Bike Ride in Bhusawal!
          </h2>

          <p class="text-xs sm:text-sm text-sky-100 font-medium leading-relaxed">
            Skip the traffic jams! Get picked up directly from your doorstep and ride comfortably with our verified, helmet-equipped local captains.
          </p>

          <div class="pt-1 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-[11px] font-bold text-sky-50">
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-emerald-300">verified</span>
              <span>Sanitized Helmet Included</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-amber-300">speed</span>
              <span>2-Min Quick Pickup</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-sky-200">security</span>
              <span>Live GPS Tracking</span>
            </div>
          </div>
        </div>

        <!-- RIGHT 5 COLS: LARGE HERO ILLUSTRATION (TWO PEOPLE RIDING A SCOOTER/BIKE) -->
        <div class="sm:col-span-5 flex items-center justify-center">
          <div class="w-full max-w-[260px] aspect-video sm:aspect-square bg-white/10 rounded-2xl p-2 border border-white/20 shadow-2xl overflow-hidden group-hover:scale-105 transition-transform duration-300">
            <img 
              src="/assets/bike_ride_hero.jpg" 
              alt="Two people riding together on a scooter bike ride" 
              class="w-full h-full object-cover rounded-xl"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=600&q=80';" 
            />
          </div>
        </div>

      </div>
    </section>


    <!-- ==================== PASSENGER PICKUP & DROP ADDRESS SELECTION ==================== -->
    <div class="space-y-4">
      
      <!-- ==================== 1. PICKUP LOCATION ==================== -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-skyBrand transition-all" id="pickup-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">my_location</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>1. Passenger Pickup Location</span>
                <span class="text-[10px] font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Where to Board</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select your current location for captain pickup</p>
            </div>
          </div>

          <!-- ADDRESS METHOD ACTION BUTTONS -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btn-pickup-gps" type="button" class="flex items-center gap-1 text-[11px] font-bold text-skyBrand bg-skyLight hover:bg-skyBrand hover:text-white px-2.5 py-1.5 rounded-xl border border-skyBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">gps_fixed</span>
              <span>GPS Location</span>
            </button>

            <button id="btn-pickup-select-map" type="button" class="flex items-center gap-1 text-[11px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-600 hover:text-white px-2.5 py-1.5 rounded-xl border border-indigo-200 transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">map</span>
              <span>Select on Map</span>
            </button>
          </div>
        </div>

        <!-- SEARCH AUTOCOMPLETE INPUT -->
        <div class="relative">
          <label for="pickup-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Pickup Location (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg">search</span>
            <input 
              type="text" 
              id="pickup-address-input" 
              value="Varangaon Road, Near Station Square, Bhusawal" 
              placeholder="Search pickup landmark, colony or street in Bhusawal..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-skyBrand/40 transition-all" 
              autocomplete="off"
            />
            <button id="clear-pickup-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <!-- Live Search Suggestions Dropdown -->
          <div id="pickup-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- PASSENGER DETAILS (NAME & PHONE) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="passenger-name" class="text-[11px] font-bold text-slate-600 block mb-1">Passenger Name <span class="text-rose-500">*</span></label>
            <input 
              type="text" 
              id="passenger-name" 
              value="Rahul Patil" 
              placeholder="Your Name" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-skyBrand/40 transition-all" 
            />
          </div>

          <div>
            <label for="passenger-phone" class="text-[11px] font-bold text-slate-600 block mb-1">Mobile Number <span class="text-rose-500">*</span></label>
            <input 
              type="tel" 
              id="passenger-phone" 
              value="9876543210" 
              placeholder="10-digit mobile number" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-skyBrand/40 transition-all" 
            />
          </div>
        </div>

        <!-- SAVED & RECENT PICKUP CHIPS -->
        <div class="space-y-2 pt-1 border-t border-slate-100">
          <div class="flex items-center justify-between text-[11px] font-bold">
            <span class="text-slate-500">💾 Saved & 🕒 Recent Pickup Locations:</span>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-[11px] font-bold" id="pickup-quick-chips">
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-skyLight text-skyBrand border border-skyBorder hover:bg-skyBrand hover:text-white transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Home - Varangaon Road, Bhusawal">
              🏠 Home (Varangaon Rd)
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-skyLight text-skyBrand border border-skyBorder hover:bg-skyBrand hover:text-white transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Office - Railway Divisional Office, Bhusawal">
              🏢 Work (Railway Div Office)
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-skyLight hover:text-skyBrand transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Jamner Road Market, Bhusawal">
              🕒 Jamner Rd Market
            </button>
            <button type="button" class="chip-saved-pickup px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-skyLight hover:text-skyBrand transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Bhusawal Station Platform Gate 1">
              🚉 Railway Station
            </button>
          </div>
        </div>
      </section>


      <!-- ==================== SWAP BUTTON ==================== -->
      <div class="flex items-center justify-center my-[-8px] relative z-20">
        <button 
          id="btn-swap-addresses" 
          type="button" 
          class="flex items-center gap-2 bg-gradient-to-r from-skyBrand to-skyDark text-white px-5 py-2.5 rounded-full font-black text-xs shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all border-2 border-white cursor-pointer group"
          title="Swap Pickup and Drop Locations with 1 Click"
        >
          <span class="material-symbols-outlined text-base group-hover:rotate-180 transition-transform duration-500">swap_vert</span>
          <span>Swap Pickup & Drop</span>
        </button>
      </div>


      <!-- ==================== 2. DROP LOCATION ==================== -->
      <section class="bg-white rounded-3xl p-5 sm:p-6 border-2 border-slate-200/80 shadow-sm space-y-4 relative overflow-hidden group hover:border-skyBrand transition-all" id="drop-section-card">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-rose-500 text-white flex items-center justify-center font-black shadow-md shrink-0">
              <span class="material-symbols-outlined text-xl">location_on</span>
            </div>
            <div>
              <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
                <span>2. Drop Destination</span>
                <span class="text-[10px] font-extrabold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">Destination</span>
              </h2>
              <p class="text-xs text-slate-500 font-medium">Select your ride destination in Bhusawal</p>
            </div>
          </div>

          <!-- ADDRESS METHOD ACTION BUTTONS -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btn-drop-gps" type="button" class="flex items-center gap-1 text-[11px] font-bold text-skyBrand bg-skyLight hover:bg-skyBrand hover:text-white px-2.5 py-1.5 rounded-xl border border-skyBorder transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">gps_fixed</span>
              <span>GPS Location</span>
            </button>

            <button id="btn-drop-select-map" type="button" class="flex items-center gap-1 text-[11px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-600 hover:text-white px-2.5 py-1.5 rounded-xl border border-indigo-200 transition-all shadow-xs active:scale-95">
              <span class="material-symbols-outlined text-sm">map</span>
              <span>Select on Map</span>
            </button>
          </div>
        </div>

        <!-- SEARCH AUTOCOMPLETE INPUT -->
        <div class="relative">
          <label for="drop-address-input" class="text-[11px] font-bold text-slate-600 block mb-1">Search Drop Destination (Google Maps Autocomplete)</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-slate-400 text-lg">flag</span>
            <input 
              type="text" 
              id="drop-address-input" 
              value="Jamner Road, Near Ordnance Factory Gate, Bhusawal" 
              placeholder="Search destination landmark, area or street in Bhusawal..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-skyBrand/40 transition-all" 
              autocomplete="off"
            />
            <button id="clear-drop-input" type="button" class="absolute right-3 text-slate-400 hover:text-slate-600 hidden text-xs font-bold">✕</button>
          </div>

          <!-- Live Search Suggestions Dropdown -->
          <div id="drop-search-dropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-30 hidden max-h-48 overflow-y-auto">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- SAVED & RECENT DROP CHIPS -->
        <div class="space-y-2 pt-1 border-t border-slate-100">
          <div class="flex items-center justify-between text-[11px] font-bold">
            <span class="text-slate-500">💾 Saved & 🕒 Popular Drop Destinations:</span>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-[11px] font-bold" id="drop-quick-chips">
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-skyLight text-skyBrand border border-skyBorder hover:bg-skyBrand hover:text-white transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Ordnance Factory Estate, Jamner Road, Bhusawal">
              🏢 Ordnance Factory
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-skyLight text-skyBrand border border-skyBorder hover:bg-skyBrand hover:text-white transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Deepnagar Thermal Power Station Colony, Bhusawal">
              ⚡ Deepnagar Township
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-skyLight hover:text-skyBrand transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Nahata Arts & Science College Chowk, Bhusawal">
              🎓 Nahata Chowk
            </button>
            <button type="button" class="chip-saved-drop px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-skyLight hover:text-skyBrand transition-all shrink-0 shadow-2xs active:scale-95" data-addr="Khedi Road, Tapi River Bridge End, Bhusawal">
              🕒 Khedi Road
            </button>
          </div>
        </div>
      </section>

    </div>


    <!-- ==================== GOOGLE MAPS ROUTE PREVIEW ==================== -->
    <section class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
            <span class="text-skyBrand">🗺️</span>
            <span>Google Maps Route Preview</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium">Real-time distance and rider route calculation in Bhusawal</p>
        </div>

        <div class="flex items-center gap-2 bg-skyLight border border-skyBorder px-3 py-1 rounded-xl text-xs font-black text-skyBrand shadow-xs">
          <span>⚡ <span id="route-distance-text">3.2 km</span></span>
          <span class="text-slate-300">•</span>
          <span>⏱️ <span id="route-time-text">10 mins ETA</span></span>
        </div>
      </div>

      <!-- MAP CONTAINER -->
      <div class="w-full h-56 sm:h-64 rounded-2xl overflow-hidden border border-slate-200 relative shadow-inner z-10" id="route-map">
        <!-- Leaflet map initialized via JS -->
      </div>
    </section>


    <!-- ==================== RIDE TYPE SELECTION ==================== -->
    <section class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
      <div>
        <h2 class="text-base font-black font-display text-slate-900 flex items-center gap-2">
          <span class="text-skyBrand text-lg">🛵</span>
          <span>Choose Your Ride Type</span>
        </h2>
        <p class="text-xs text-slate-500 font-medium">Select your preferred passenger ride option</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="ride-type-grid">
        
        <!-- Standard Scooter Ride -->
        <button type="button" class="ride-type-btn active p-4 rounded-2xl border-2 border-skyBrand bg-skyLight text-left space-y-2 cursor-pointer transition-all shadow-xs active:scale-95" data-type="Standard Scooter" data-base="20" data-perkm="7">
          <div class="flex items-center justify-between">
            <span class="text-2xl">🛵</span>
            <span class="bg-skyBrand text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase">FASTEST</span>
          </div>
          <div>
            <h3 class="text-xs font-black text-slate-900">Standard Scooter Ride</h3>
            <p class="text-[11px] font-semibold text-slate-500 mt-0.5">Quick single-passenger ride</p>
          </div>
          <div class="pt-1 flex items-baseline justify-between border-t border-skyBorder">
            <span class="text-xs font-bold text-slate-600">Fare: ₹20 base + ₹7/km</span>
            <span class="text-sm font-black text-skyBrand ride-option-fare">₹42</span>
          </div>
        </button>

        <!-- Electric EV Scooter Ride -->
        <button type="button" class="ride-type-btn p-4 rounded-2xl border-2 border-slate-200/80 bg-slate-50 text-left space-y-2 cursor-pointer transition-all shadow-xs hover:border-skyBrand active:scale-95" data-type="Electric EV Ride" data-base="15" data-perkm="6">
          <div class="flex items-center justify-between">
            <span class="text-2xl">⚡</span>
            <span class="bg-emerald-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase">ECO FRIENDLY</span>
          </div>
          <div>
            <h3 class="text-xs font-black text-slate-900">Electric EV Ride</h3>
            <p class="text-[11px] font-semibold text-slate-500 mt-0.5">Silent, zero emission ride</p>
          </div>
          <div class="pt-1 flex items-baseline justify-between border-t border-slate-200">
            <span class="text-xs font-bold text-slate-600">Fare: ₹15 base + ₹6/km</span>
            <span class="text-sm font-black text-skyBrand ride-option-fare">₹34</span>
          </div>
        </button>

        <!-- Premium Helmet Extra Comfort -->
        <button type="button" class="ride-type-btn p-4 rounded-2xl border-2 border-slate-200/80 bg-slate-50 text-left space-y-2 cursor-pointer transition-all shadow-xs hover:border-skyBrand active:scale-95" data-type="Comfort Plus Ride" data-base="25" data-perkm="8">
          <div class="flex items-center justify-between">
            <span class="text-2xl">🪖</span>
            <span class="bg-indigo-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase">COMFORT PLUS</span>
          </div>
          <div>
            <h3 class="text-xs font-black text-slate-900">Comfort Plus Ride</h3>
            <p class="text-[11px] font-semibold text-slate-500 mt-0.5">Fresh visor helmet & padded seat</p>
          </div>
