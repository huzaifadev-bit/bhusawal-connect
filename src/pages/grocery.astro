  <!-- Floating Cart Bar -->
  <div id="floating-cart-bar" class="fixed bottom-4 left-3 right-3 sm:left-auto sm:right-6 sm:max-w-md z-40 bg-[#0c831f] text-white rounded-2xl p-3 sm:p-3.5 shadow-2xl flex items-center justify-between cursor-pointer hover:bg-emerald-700 active:scale-98 transition-all hidden">
