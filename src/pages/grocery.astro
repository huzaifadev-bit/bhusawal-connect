---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read the database at build-time for static rendering
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read grocery catalog at build time", err);
}

// Helper to filter items for static server rendering
function getCategoryItems(catName, limit = 12) {
  return catalog.filter(p => {
    const cat = p.Category || '';
    const name = (p["Product Name"] || '').toLowerCase();
    if (catName === 'Fruits & Vegetables') return cat.includes('Vegetables') || cat.includes('Fruits') || name.includes('veggie') || name.includes('fruit');
    if (catName === 'Dairy') return cat.includes('Dairy') || cat.includes('Breakfast') || cat.includes('Bakery');
    if (catName === 'Staples') return cat.includes('Staples') || cat.includes('Atta') || cat.includes('Rice') || cat.includes('Dal') || cat.includes('Oil') || cat.includes('Ghee') || cat.includes('Masala');
    if (catName === 'Snacks') return cat.includes('Snacks') || cat.includes('Biscuits') || cat.includes('Chocolates') || cat.includes('Beverages') || cat.includes('Instant');
    if (catName === 'Home') return cat.includes('Cleaning') || cat.includes('Household') || cat.includes('Laundry');
    if (catName === 'Personal Care') return cat.includes('Personal') || cat.includes('Bath') || cat.includes('Skin') || cat.includes('Hair');
    return true;
  }).slice(0, limit);
}

const veggies = getCategoryItems('Fruits & Vegetables', 12);
const dairy = getCategoryItems('Dairy', 12);
const staples = getCategoryItems('Staples', 12);
const snacks = getCategoryItems('Snacks', 12);
const home = getCategoryItems('Home', 12);
const personal = getCategoryItems('Personal Care', 12);
