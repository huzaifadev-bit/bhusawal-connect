---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read master grocery catalog at build time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read grocery catalog at build time", err);
}

// Master categories list from catalog
const categoriesList = [
  { id: 'all', name: 'All Products', icon: '⚡' },
  { id: 'fruits', name: 'Fruits & Vegetables', icon: '🥬' },
  { id: 'dairy', name: 'Dairy & Breakfast', icon: '🥛' },
  { id: 'staples', name: 'Grocery Staples', icon: '🌾' },
  { id: 'snacks', name: 'Snacks & Confectionery', icon: '🍿' },
  { id: 'beverages', name: 'Beverages', icon: '🥤' },
  { id: 'personal', name: 'Personal Care', icon: '✨' },
  { id: 'home', name: 'Home Cleaning & Household', icon: '🧹' },
  { id: 'instant', name: 'Instant & Frozen Foods', icon: '🍜' },
  { id: 'baby', name: 'Baby, Health & Specialty', icon: '👶' },
];

// Featured Partner Stores in Bhusawal Marketplace
const partnerStores = [
  {
    id: 'sai-jeevan',
    name: 'Sai Jeevan Super Mall',
    tagline: 'Premium Supermarket & Daily Needs Mart',
    location: 'Station Road, Bhusawal',
    badge: 'TOP RATED SUPERSTORE',
    rating: '4.8 ★',
    eta: '10 MINS',
    icon: '🏬',
    image: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=500&q=80',
    color: 'border-purpleBrand bg-purple-50 text-purpleBrand',
    categories: ['Fruits & Vegetables', 'Dairy & Breakfast', 'Grocery Staples', 'Snacks & Confectionery', 'Beverages', 'Home Cleaning & Household']
  },
  {
    id: 'central-supermarket',
    name: 'Bhusawal Central Supermarket',
    tagline: 'Staples, Snacks, Household & Beverages',
    location: 'Station Road, Bhusawal',
    badge: 'FEATURED PARTNER',
    rating: '4.8 ★',
    eta: '10 MINS',
    icon: '🏬',
    image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=500&q=80',
    color: 'border-emerald-200 bg-emerald-50 text-emerald-700',
    categories: ['Grocery Staples', 'Snacks & Confectionery', 'Beverages', 'Home Cleaning & Household']
  },
  {
    id: 'fresh-green-mart',
    name: 'Fresh Green Mart & Organics',
    tagline: 'Farm-fresh Fruits, Vegetables & Dairy',
    location: 'Jamner Road, Bhusawal',
    badge: 'FARM FRESH',
    rating: '4.7 ★',
    eta: '12 MINS',
    icon: '🥦',
    image: 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?auto=format&fit=crop&w=500&q=80',
    color: 'border-green-200 bg-green-50 text-green-700',
    categories: ['Fruits & Vegetables', 'Dairy & Breakfast', 'Grocery Staples']
  },
  {
    id: 'dinshaws-dairy-hub',
    name: "Dinshaw's Dairy & Bakery Hub",
    tagline: 'Fresh Milk, Cheese, Bakery & Frozen',
    location: 'Varangaon Road, Bhusawal',
    badge: 'DAIRY SPECIALIST',
    rating: '4.9 ★',
    eta: '8 MINS',
    icon: '🥛',
    image: 'https://images.unsplash.com/photo-1528751014936-863e6e7a319c?auto=format&fit=crop&w=500&q=80',
    color: 'border-amber-200 bg-amber-50 text-amber-800',
    categories: ['Dairy & Breakfast', 'Instant & Frozen Foods', 'Beverages']
  },
  {
    id: 'khandesh-agro-spices',
    name: 'Khandesh Agro & Spices Store',
    tagline: 'Pure Grains, Spices, Pulses & Oils',
    location: 'Main Market, Bhusawal',
    badge: 'LOCAL TRADITIONAL',
    rating: '4.6 ★',
    eta: '15 MINS',
    icon: '🌾',
    image: 'https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=500&q=80',
    color: 'border-orange-200 bg-orange-50 text-orange-800',
    categories: ['Grocery Staples', 'Instant & Frozen Foods']
  },
  {
    id: 'city-organic-daily',
    name: 'City Organic & Daily Needs',
    tagline: 'Personal Care, Baby Care & Essentials',
    location: 'Civil Lines, Bhusawal',
    badge: 'HEALTH & ESSENTIALS',
    rating: '4.8 ★',
    eta: '10 MINS',
    icon: '✨',
    image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=500&q=80',
    color: 'border-blue-200 bg-blue-50 text-blue-800',
    categories: ['Personal Care', 'Home Cleaning & Household', 'Baby, Health & Specialty', 'Snacks & Confectionery']
  }
];

// Server-render first 48 items
const initialProducts = catalog.slice(0, 48);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Grocery Marketplace & Partner Superstores</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="px-2 py-0.5 rounded-md bg-purple-100 text-purpleBrand text-[10px] font-black uppercase tracking-wider">⚡ MARKETPLACE</span>
          <h1 class="text-base font-black font-display text-slate-900 leading-tight">Grocery Superstore</h1>
        </div>
        <p class="text-[11px] text-slate-500 font-bold truncate max-w-[200px] sm:max-w-xs">
          Partner Stores & Direct Superstore • Bhusawal
        </p>
      </div>
    </div>

    <a href="/billing" class="relative w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold hover:bg-purple-200 transition-colors">
      <span class="material-symbols-outlined text-xl">shopping_bag</span>
      <span id="cart-badge-header" class="absolute -top-1 -right-1 bg-purpleBrand text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
    </a>
  </header>

  <!-- STICKY SEARCH, FILTERS & SORTING BAR -->
  <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 shadow-sm space-y-3">
    
    <!-- Search Bar -->
    <div class="flex items-center gap-2 bg-slate-100 rounded-2xl px-4 py-2.5 border border-slate-200/80 focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:bg-white transition-all">
      <span class="material-symbols-outlined text-slate-400">search</span>
      <input type="text" id="grocery-search-input" placeholder="Search 25,000+ items across partner stores..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
      <button id="clear-search-btn" class="hidden text-slate-400 hover:text-slate-600">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>

    <!-- Filter Pills & Sorting Dropdown -->
    <div class="flex items-center justify-between gap-2 overflow-x-auto no-scrollbar pt-1">
      <div class="flex items-center gap-2">
        <button class="diet-filter-btn px-3 py-1.5 rounded-xl bg-purpleBrand text-white text-xs font-black shadow-xs transition-all" data-filter="all">All Items</button>
        <button class="diet-filter-btn px-3.5 py-1.5 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold transition-all" data-filter="instock">In Stock Only</button>
      </div>

      <div class="flex items-center gap-2">
        <label for="sort-select" class="text-xs font-bold text-slate-400 hidden sm:inline">Sort:</label>
        <select id="sort-select" class="bg-slate-100 border border-slate-200 text-slate-800 text-xs font-extrabold rounded-xl px-3 py-1.5 outline-none cursor-pointer hover:bg-slate-200 transition-colors">
          <option value="popular">Popularity</option>
          <option value="low-high">Price: Low to High</option>
          <option value="high-low">Price: High to Low</option>
          <option value="name">Name: A to Z</option>
        </select>
      </div>
    </div>

  </div>

  <!-- FEATURED PROMO BANNER -->
  <div class="px-4 pt-4">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-800 via-purple-700 to-indigo-900 text-white p-5 shadow-lg shadow-purple-900/10">
      <div class="relative z-10 max-w-xl space-y-1">
        <span class="px-2.5 py-0.5 bg-amber-400 text-slate-950 text-[10px] font-black uppercase tracking-wider rounded-full inline-block mb-1">BHUSAWAL MARKETPLACE</span>
        <h2 class="text-xl sm:text-2xl font-black font-display leading-tight">25,500+ Items from Local Partner Stores</h2>
        <p class="text-xs text-purple-100 font-semibold">Shop from top Bhusawal partner superstores or order directly from master catalog</p>
      </div>
    </div>
  </div>

  <!-- ==================== FEATURED PARTNER STORES HORIZONTAL CAROUSEL ==================== -->
  <div class="px-4 pt-5 space-y-3">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 flex items-center gap-2">
          <span>🏬 Featured Partner Stores</span>
          <span class="text-[10px] font-black text-purpleBrand bg-purple-100 px-2 py-0.5 rounded-full border border-purple-200 uppercase">Bhusawal Marketplace</span>
        </h2>
        <p class="text-xs text-slate-500 font-medium">Click any store card to open its dedicated store profile and storefront</p>
      </div>
    </div>

    <!-- CAROUSEL CONTAINER -->
    <div class="flex gap-3.5 overflow-x-auto no-scrollbar pb-2 pt-1 scroll-smooth" id="partner-stores-carousel">
      {partnerStores.map(store => (
        <a 
          href={`/store_profile?store=${store.id}`}
          class="partner-store-card flex-shrink-0 w-64 sm:w-72 bg-white rounded-3xl p-3.5 border-2 border-slate-100 shadow-xs hover:shadow-xl hover:border-purpleBrand transition-all duration-300 cursor-pointer relative group flex flex-col justify-between"
          data-store-id={store.id}
        >
          <!-- Store Image & Badge Header -->
          <div class="relative w-full h-28 rounded-2xl overflow-hidden mb-3 bg-slate-100">
            <img src={store.image} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute top-2 left-2">
              <span class="px-2 py-0.5 bg-white/95 backdrop-blur-md text-slate-900 text-[9px] font-black rounded-lg uppercase tracking-wider shadow-xs">
                {store.badge}
              </span>
            </div>

            <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-white">
              <span class="text-xs font-bold text-slate-200 flex items-center gap-1 truncate max-w-[160px]">
                <span class="material-symbols-outlined text-xs shrink-0">location_on</span>
                <span class="truncate">{store.location}</span>
              </span>
              <span class="bg-amber-400 text-slate-950 text-[10px] font-black px-1.5 py-0.5 rounded shrink-0">
                {store.rating}
              </span>
            </div>
          </div>

          <!-- Store Info & Details -->
          <div class="space-y-1">
            <h3 class="text-sm font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors leading-tight flex items-center gap-1.5">
              <span>{store.icon}</span>
              <span class="truncate">{store.name}</span>
            </h3>
            <p class="text-[11px] font-semibold text-slate-500 truncate">{store.tagline}</p>
          </div>

          <!-- Action Button & ETA -->
          <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-500 flex items-center gap-1">
              <span class="material-symbols-outlined text-xs text-purpleBrand">bolt</span>
              <span>{store.eta} ETA</span>
            </span>

            <span class="store-browse-btn px-3 py-1 bg-purple-50 group-hover:bg-purpleBrand text-purpleBrand group-hover:text-white text-[10px] font-black rounded-xl border border-purple-200 transition-all">
              View Store Profile →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- MAIN CONTAINER (CATEGORY SIDEBAR + PRODUCT GRID) -->
  <div class="px-4 py-5 md:flex md:gap-6">
    
    <!-- Mobile Categories Horizontal Bar -->
    <div class="md:hidden flex gap-2 overflow-x-auto no-scrollbar pb-3 mb-3 border-b border-slate-100">
      {categoriesList.map(cat => (
        <button class="mobile-cat-btn flex-shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-white border border-slate-200 text-xs font-extrabold text-slate-700 hover:border-purpleBrand transition-all" data-category={cat.name}>
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </button>
      ))}
    </div>

    <!-- Desktop Category Sidebar -->
    <aside class="hidden md:block w-64 flex-shrink-0 space-y-2 sticky top-44 h-fit">
      <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider px-3 mb-2">Categories</h3>
      <div class="bg-white rounded-3xl p-2.5 border border-slate-100 shadow-sm space-y-1">
        {categoriesList.map(cat => (
          <button class="desktop-cat-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-extrabold text-slate-700 hover:bg-purple-50 hover:text-purpleBrand transition-all" data-category={cat.name}>
            <div class="flex items-center gap-2.5">
              <span class="text-base">{cat.icon}</span>
              <span>{cat.name}</span>
            </div>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
          </button>
        ))}
      </div>
    </aside>

    <!-- Product Grid Section -->
    <main class="flex-1 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200/60 pb-2">
        <h2 id="active-category-title" class="text-lg font-black font-display text-slate-900">All Products Catalog</h2>
        <span id="product-count-label" class="text-xs font-bold text-slate-400">Loading catalog...</span>
      </div>

      <!-- Products Grid -->
      <div id="grocery-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 sm:gap-4.5">
        {initialProducts.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id || '';
          const name = p["Product Name"] || '';
          const brand = p["Brand Name"] || p.brand || 'Bhusawal Fresh';
          const cat = p.Category || 'Grocery';
          const pack = p["Pack Size"] || p.pack || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || p.mrp || p["Selling Price"] || p.sp || 0);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const isOutOfStock = p.stock === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
          const descSafe = (p.desc || p.Description || '').replace(/"/g, '&quot;');
          const nameSafe = name.replace(/"/g, '&quot;');

          return (
            <div class="product-card group bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-xl hover:border-purple-200 transition-all duration-300 relative flex flex-col overflow-hidden cursor-pointer p-3" data-id={id} data-name={nameSafe} data-price={mrp} data-mrp={mrp} data-img={img} data-unit={pack} data-cat={cat} data-brand={brand} data-desc={descSafe}>

              <div class="relative w-full h-36 sm:h-44 bg-gradient-to-b from-slate-50 to-white rounded-2xl flex items-center justify-center p-3 overflow-hidden mb-2">
                {isOutOfStock && (
                  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-20 flex items-center justify-center">
                    <span class="bg-slate-900 text-white text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-md">Out of Stock</span>
                  </div>
                )}

                <img src={img} alt={name} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />

                <div class="absolute bottom-2 left-2 z-10">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-400 text-slate-950 text-[9px] font-black rounded-md uppercase tracking-wider shadow-xs">
                    ⚡ 10 MINS
                  </span>
                </div>
              </div>

              <div class="flex flex-col flex-1 px-0.5">
                <span class="text-[10px] font-extrabold text-purpleBrand uppercase tracking-wider truncate mb-0.5">{brand}</span>
                <h3 class="text-xs sm:text-[13px] font-extrabold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem] group-hover:text-purpleBrand transition-colors">{name}</h3>
                <p class="text-[11px] font-semibold text-slate-400 mb-2">{pack}</p>

                <div class="flex items-center justify-between gap-1 mt-auto pt-2 border-t border-slate-100">
                  <span class="text-sm font-black text-slate-900">MRP ₹{mrp}</span>

                  <div class="cart-action-container" data-id={id} data-name={nameSafe} data-price={mrp} data-img={img}>
                    <button class="add-to-cart-btn px-3.5 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-[10px] font-black rounded-xl active:scale-90 transition-all" data-id={id} data-name={nameSafe} data-price={mrp} data-img={img}>
                      + ADD
                    </button>
                  </div>
                </div>
              </div>

            </div>
          );
        })}
      </div>

      <!-- LOAD MORE -->
      <div id="load-more-container" class="py-8 text-center space-y-2">
        <button id="load-more-btn" class="px-8 py-3 bg-purpleBrand hover:bg-purpleDark text-white font-black text-xs rounded-2xl shadow-lg active:scale-95 transition-all">
          Load More Products
        </button>
        <p id="pagination-status-text" class="text-xs font-bold text-slate-400"></p>
      </div>

    </main>
  </div>

  <!-- FLOATING CART BAR -->
  <div id="floating-cart-bar" class="hidden fixed bottom-6 left-4 right-4 max-w-xl mx-auto bg-purpleBrand text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between z-50 animate-in fade-in slide-in-from-bottom-2">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center font-black text-sm" id="cart-count-badge">
        0
      </div>
      <div>
        <p class="text-xs font-black text-white" id="cart-total-text">₹0</p>
        <p class="text-[10px] text-purple-200">View items in cart</p>
      </div>
    </div>
    <a href="/billing" class="bg-white text-purpleBrand font-black text-xs px-5 py-2.5 rounded-xl flex items-center gap-1.5 shadow-md hover:bg-purple-50 active:scale-95 transition-all">
      <span>Proceed to Checkout</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <Switcher />

  <!-- CLIENT-SIDE CATALOG ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      let catalogData = [];
      try {
        const res = await fetch('/grocery_catalog.json');
        catalogData = await res.json();
      } catch(e) {
        console.error("Failed to load grocery catalog", e);
      }

      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const headerBadge = document.getElementById('cart-badge-header');
          const totalText = document.getElementById('cart-total-text');

          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

          if (countBadge) countBadge.textContent = totalQty;
          if (headerBadge) headerBadge.textContent = totalQty;
          if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);

          if (cart.length > 0) {
            bar?.classList.remove('hidden');
          } else {
            bar?.classList.add('hidden');
          }
        } catch(e) {}
      }
      updateCartBar();

      function syncCartActionButtons() {
        let cart = [];
        try { cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); } catch(e) {}

        document.querySelectorAll('.cart-action-container').forEach(container => {
          const id = container.dataset.id;
          const name = container.dataset.name;
          const price = container.dataset.price;
          const img = container.dataset.img;
          if (!id) return;

          const cartItem = cart.find(i => i.id === id);
          const qty = cartItem ? (cartItem.quantity || 1) : 0;

          if (qty > 0) {
            container.innerHTML = `
              <div class="flex items-center justify-between bg-purpleBrand text-white font-extrabold text-xs rounded-xl overflow-hidden shadow-xs">
                <button class="qty-minus-btn px-2.5 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}">-</button>
                <span class="px-1.5 text-[11px] font-black min-w-[1.2rem] text-center">${qty}</span>
                <button class="qty-plus-btn px-2.5 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-img="${img}">+</button>
              </div>
            `;
          } else {
            container.innerHTML = `
              <button class="add-to-cart-btn px-3.5 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-[10px] font-black rounded-xl active:scale-90 transition-all" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-img="${img}">
                + ADD
              </button>
            `;
          }
        });

        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = btn.dataset.price;
            const img = btn.dataset.img;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Grocery' });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });

        document.querySelectorAll('.qty-plus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name: btn.dataset.name, price: btn.dataset.price, mrp: btn.dataset.price, image: btn.dataset.img, quantity: 1, cat: 'Grocery' });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });

        document.querySelectorAll('.qty-minus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existingIndex = cart.findIndex(i => i.id === id);
            if (existingIndex > -1) {
              if (cart[existingIndex].quantity > 1) {
                cart[existingIndex].quantity -= 1;
              } else {
                cart.splice(existingIndex, 1);
              }
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });
      }

      const searchInput = document.getElementById('grocery-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const grid = document.getElementById('grocery-products-grid');
      const countLabel = document.getElementById('product-count-label');
      const titleLabel = document.getElementById('active-category-title');
      const loadMoreBtn = document.getElementById('load-more-btn');
      const sortSelect = document.getElementById('sort-select');

      let currentQuery = '';
      let currentCategory = 'All Products';
      let currentFilter = 'all';
      let currentSort = 'popular';

      let currentFiltered = [];
      let currentLimit = 48;
      const BATCH_SIZE = 48;

      function renderProducts() {
        if (!currentFiltered || currentFiltered.length === 0) {
          grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 font-bold">No products found.</div>`;
          if (countLabel) countLabel.textContent = '0 Products';
          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
          return;
        }

        const visibleItems = currentFiltered.slice(0, currentLimit);
        
        if (countLabel) {
          countLabel.textContent = `Showing ${visibleItems.length.toLocaleString()} of ${currentFiltered.length.toLocaleString()} Products (${catalogData.length.toLocaleString()} Total)`;
        }

        grid.innerHTML = visibleItems.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id || '';
          const name = (p["Product Name"] || p.name || '').split(" (Batch")[0];
          const brand = p["Brand Name"] || p.brand || 'Bhusawal Fresh';
          const cat = p.Category || 'Grocery';
          const pack = p["Pack Size"] || p.pack || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || p.mrp || p["Selling Price"] || p.sp || 50);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const descSafe = (p.desc || p.Description || '').replace(/"/g, '&quot;');
          const nameSafe = name.replace(/"/g, '&quot;');

          return `
            <div class="product-card group bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-xl hover:border-purple-200 transition-all duration-300 relative flex flex-col overflow-hidden cursor-pointer p-3" data-id="${id}" data-name="${nameSafe}" data-price="${mrp}" data-mrp="${mrp}" data-img="${img}" data-unit="${pack}" data-cat="${cat}" data-brand="${brand}" data-desc="${descSafe}">

              <div class="relative w-full h-36 sm:h-44 bg-gradient-to-b from-slate-50 to-white rounded-2xl flex items-center justify-center p-3 overflow-hidden mb-2">
                <img src="${img}" alt="${nameSafe}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />

                <div class="absolute bottom-2 left-2 z-10">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-400 text-slate-950 text-[9px] font-black rounded-md uppercase tracking-wider shadow-xs">
                    ⚡ 10 MINS
                  </span>
                </div>
              </div>

              <div class="flex flex-col flex-1 px-0.5">
                <span class="text-[10px] font-extrabold text-purpleBrand uppercase tracking-wider truncate mb-0.5">${brand}</span>
                <h3 class="text-xs sm:text-[13px] font-extrabold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem] group-hover:text-purpleBrand transition-colors">${name}</h3>
                <p class="text-[11px] font-semibold text-slate-400 mb-2">${pack}</p>

                <div class="flex items-center justify-between gap-1 mt-auto pt-2 border-t border-slate-100">
                  <span class="text-sm font-black text-slate-900">MRP ₹${mrp}</span>

                  <div class="cart-action-container" data-id="${id}" data-name="${nameSafe}" data-price="${mrp}" data-img="${img}">
                    <button class="add-to-cart-btn px-3.5 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 text-[10px] font-black rounded-xl active:scale-90 transition-all" data-id="${id}" data-name="${nameSafe}" data-price="${mrp}" data-img="${img}">
                      + ADD
                    </button>
                  </div>
                </div>
              </div>

            </div>
          `;
        }).join('');

        if (currentLimit < currentFiltered.length) {
          if (loadMoreBtn) {
            loadMoreBtn.classList.remove('hidden');
            loadMoreBtn.textContent = `Load More (${(currentFiltered.length - currentLimit).toLocaleString()} remaining)`;
          }
        } else {
          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
        }

        syncCartActionButtons();
      }

      function filterCatalog() {
        if (!catalogData || catalogData.length === 0) return;
        let res = catalogData;

        if (currentQuery) {
          const q = currentQuery;
          res = res.filter(p => {
            const name = (p["Product Name"] || '').toLowerCase();
            const cat = (p.Category || '').toLowerCase();
            const brand = (p["Brand Name"] || '').toLowerCase();
            return name.includes(q) || cat.includes(q) || brand.includes(q);
          });
        }

        if (currentCategory && currentCategory !== 'All Products') {
          const target = currentCategory.toLowerCase();
          res = res.filter(p => (p.Category || '').toLowerCase() === target);
        }

        currentFiltered = res;
        currentLimit = BATCH_SIZE;
        renderProducts();
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        if (currentQuery) clearBtn?.classList.remove('hidden');
        else clearBtn?.classList.add('hidden');
        filterCatalog();
      });

      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn?.classList.add('hidden');
        filterCatalog();
      });

      document.querySelectorAll('.desktop-cat-btn, .mobile-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.category || 'All Products';
          if (titleLabel) titleLabel.textContent = currentCategory;
          filterCatalog();
        });
      });

      filterCatalog();
    });
  </script>
</body>
</html>
