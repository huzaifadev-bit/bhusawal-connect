---

<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline src="/bhusawal_age_verification.js"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Modern Grocery Marketplace</title>
  <meta name="description" content="Order groceries from top Bhusawal stores. Premium cards, instant search, 10 min delivery." />

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: '#16a34a',
            brandDark: '#15803d',
            brandLight: '#f0fdf4',
            brandMuted: '#dcfce7'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8faf9; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Skeleton loading shimmer */
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .skeleton {
      background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s ease-in-out infinite;
      border-radius: 16px;
    }

    /* Smooth entry animation */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
      animation: fadeUp 0.3s ease-out forwards;
      opacity: 0;
    }

    /* Category pill active glow */
    .cat-pill-active {
      box-shadow: 0 4px 14px -2px rgba(22, 163, 74, 0.35);
      transform: scale(1.02);
    }

    /* Section header */
    .section-title {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      color: #0f172a;
      font-size: 1.05rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Modern Product Card Styling */
    .product-card-v2 {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .product-card-v2:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 32px -8px rgba(22,163,74,0.16), 0 4px 12px -4px rgba(0,0,0,0.06);
    }

    /* Green scrollbar for horizontal sections */
    .green-scroll::-webkit-scrollbar { height: 4px; }
    .green-scroll::-webkit-scrollbar-track { background: #f0fdf4; border-radius: 4px; }
    .green-scroll::-webkit-scrollbar-thumb { background: #86efac; border-radius: 4px; }

    /* Highlight matching search text */
    .search-match-hl {
      background-color: #dcfce7;
      color: #15803d;
      font-weight: 800;
      padding: 0 2px;
      border-radius: 4px;
    }

    .search-overlay-shadow {
      box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.15), 0 10px 20px -5px rgba(22, 163, 74, 0.08);
    }
  </style>
  <script is:inline src="/bhusawal_master_db.js"></script>
  <script is:inline src="/bhusawal_backend.js"></script>
  <script is:inline src="/bhusawal_notifications.js"></script>
</head>

<body class="pb-32 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased">

  <!-- ==================== STICKY HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-green-100/60 px-4 py-3 shadow-sm">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/home" class="w-9 h-9 rounded-full bg-green-50 flex items-center justify-center text-green-700 hover:bg-green-100 active:scale-90 transition-all">
          <span class="material-symbols-outlined text-xl">arrow_back</span>
        </a>
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="text-base font-black font-display text-slate-900 leading-tight">Grocery</h1>
            <span class="px-1.5 py-0.5 rounded-md bg-green-100 text-green-700 text-[9px] font-black uppercase tracking-wider">⚡ 10 min</span>
          </div>
          <p class="text-[11px] text-slate-500 font-semibold">Bhusawal's #1 Grocery Delivery</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a href="/wishlist" class="w-9 h-9 rounded-full bg-green-50 flex items-center justify-center text-green-700 hover:bg-green-100 transition-colors">
          <span class="material-symbols-outlined text-xl text-red-500">favorite</span>
        </a>
        <a href="/cart" class="relative w-9 h-9 rounded-full bg-green-600 text-white flex items-center justify-center hover:bg-green-700 transition-colors">
          <span class="material-symbols-outlined text-lg">shopping_bag</span>
          <span id="cart-badge-header" class="absolute -top-1 -right-1 bg-amber-400 text-slate-900 text-[9px] font-black w-4.5 h-4.5 rounded-full flex items-center justify-center border-2 border-white min-w-[18px] min-h-[18px]">0</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ==================== SEARCH CONTAINER ==================== -->
  <div class="sticky top-[57px] z-40 bg-white/95 backdrop-blur-xl px-4 py-2.5 border-b border-green-100/40">
    <div class="relative">
      <div class="flex items-center gap-2.5 bg-green-50/80 rounded-2xl px-4 py-2.5 border border-green-200/60 focus-within:ring-2 focus-within:ring-green-500/30 focus-within:bg-white focus-within:border-green-400 transition-all">
        <span class="material-symbols-outlined text-green-600 text-xl shrink-0">search</span>
        <input
          type="text"
          id="grocery-search-input"
          placeholder="Search 2,699 Master SKUs (Name, Brand, Category, Subcategory)..."
          class="w-full bg-transparent outline-none text-xs sm:text-sm font-semibold text-slate-800 placeholder-slate-400"
          autocomplete="off"
        />
        <span id="search-spinner" class="hidden text-green-600 shrink-0 animate-spin">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        </span>
        <button id="clear-search-btn" class="hidden text-slate-400 hover:text-slate-600 shrink-0 transition-colors">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <!-- ZEPTO INSTANT AUTO-SUGGEST & OVERLAY DROPDOWN -->
      <div
        id="grocery-search-dropdown"
        class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl border border-green-100 search-overlay-shadow max-h-[75vh] overflow-y-auto no-scrollbar z-50 p-4 space-y-4"
      >
        <div id="search-dropdown-empty" class="space-y-4">
          <div id="recent-searches-box" class="hidden">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">schedule</span> Recent Searches
              </span>
              <button id="clear-recent-searches" class="text-[10px] font-bold text-red-500 hover:underline">Clear All</button>
            </div>
            <div id="recent-searches-list" class="flex flex-wrap gap-1.5"></div>
          </div>

          <div>
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1 mb-2">
              <span>🔥</span> Trending Searches in Bhusawal
            </span>
            <div class="flex flex-wrap gap-1.5" id="trending-searches-list">
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Amul Milk">
                <span>🥛</span> Amul Milk
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Fortune Oil">
                <span>🫒</span> Fortune Oil
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Aashirvaad Atta">
                <span>🌾</span> Aashirvaad Atta
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Haldiram Bhujia">
                <span>🍿</span> Haldiram Bhujia
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Tata Tea">
                <span>☕</span> Tata Tea
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Lay's Chips">
                <span>🥔</span> Lay's Chips
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Surf Excel">
                <span>🧹</span> Surf Excel
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Basmati Rice">
                <span>🍚</span> Basmati Rice
              </button>
              <button class="trending-tag px-3 py-1 bg-green-50 hover:bg-green-600 text-green-800 hover:text-white rounded-xl text-xs font-extrabold border border-green-200/80 transition-all flex items-center gap-1" data-query="Dettol Soap">
                <span>✨</span> Dettol Soap
              </button>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100">
            <span class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1 mb-2">
              <span>⭐</span> Popular Grocery Staples
            </span>
            <div id="dropdown-popular-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
          </div>
        </div>

        <div id="search-dropdown-results" class="hidden space-y-3">
          <div id="dropdown-shortcuts-box" class="flex flex-wrap gap-1.5"></div>
          <div class="space-y-1.5">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Matching Products</span>
            <div id="dropdown-products-preview" class="space-y-1"></div>
          </div>
          <button id="see-all-results-btn" class="w-full py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl font-extrabold text-xs flex items-center justify-center gap-1.5 shadow-md active:scale-98 transition-all">
            <span>View All Matching Results</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== MAIN CONTENT ==================== -->
  <div id="homepage-sections">

    <!-- FEATURED PARTNER STORES -->
    <section class="px-4 pt-5 pb-1">
      <div class="flex items-center justify-between mb-3">
        <h2 class="section-title"><span>🏬</span> Partner Stores</h2>
        <span class="text-[10px] font-bold text-green-600 bg-green-50 px-2 py-0.5 rounded-full border border-green-200">Bhusawal</span>
      </div>

      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2 scroll-smooth green-scroll">
        {partnerStores.map(store => (
          <a
            href={`/store_profile?store=${store.id}`}
            class="flex-shrink-0 w-56 sm:w-64 bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-lg hover:border-green-200 transition-all duration-300 group"
          >
            <div class="relative w-full h-28 overflow-hidden">
              <img src={store.image} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
              <div class="absolute top-2 left-2">
                <span class="px-1.5 py-0.5 bg-green-500 text-white text-[8px] font-black rounded-md uppercase tracking-wider">{store.badge}</span>
              </div>
              <div class="absolute bottom-2 left-2 right-2 flex justify-between items-end">
                <span class="text-white text-[10px] font-bold truncate flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[10px]">location_on</span>
                  {store.location}
                </span>
                <span class="bg-amber-400 text-slate-900 text-[9px] font-black px-1.5 py-0.5 rounded-md flex items-center gap-0.5">⭐ {store.rating}</span>
              </div>
            </div>
            <div class="p-3 space-y-1">
              <h3 class="text-xs font-extrabold text-slate-900 group-hover:text-green-700 transition-colors flex items-center gap-1.5 truncate">
                <span>{store.icon}</span>
                <span class="truncate">{store.name}</span>
              </h3>
              <p class="text-[10px] text-slate-500 font-medium truncate">{store.tagline}</p>
              <div class="flex items-center justify-between pt-1.5 border-t border-slate-100 mt-1.5">
                <span class="text-[10px] font-bold text-green-600 flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-xs">bolt</span> {store.eta}
                </span>
                <span class="text-[9px] font-black text-green-600 group-hover:text-white group-hover:bg-green-600 bg-green-50 px-2 py-0.5 rounded-lg border border-green-200 group-hover:border-green-600 transition-all">Visit →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- HORIZONTAL CATEGORIES BAR -->
    <section class="px-4 pt-4 pb-2">
      <div class="flex items-center justify-between mb-3">
        <h2 class="section-title"><span>📦</span> Explore Categories</h2>
        <span class="text-[10px] font-bold text-green-700 bg-green-50 px-2.5 py-0.5 rounded-full border border-green-200">21 Categories</span>
      </div>

      <div class="relative">
        <div class="flex gap-2.5 overflow-x-auto no-scrollbar pb-2 pt-1 scroll-smooth green-scroll" id="categories-scroll">
          {categoriesList.map((cat, i) => (
            <button
              class={`cat-pill flex-shrink-0 flex items-center gap-2 px-3.5 sm:px-4 py-2.5 rounded-2xl text-xs font-extrabold transition-all duration-300 active:scale-95 border cursor-pointer select-none group ${
                i === 0
                  ? 'bg-green-600 text-white border-green-600 cat-pill-active'
                  : 'bg-white text-slate-700 border-slate-200/90 hover:border-green-400 hover:bg-green-50/80 hover:text-green-800'
              }`}
              data-cat-id={cat.id}
              data-category={cat.name}
            >
              <span class="text-base sm:text-lg group-hover:scale-110 transition-transform duration-200 shrink-0">{cat.icon}</span>
              <div class="text-left min-w-0">
                <span class="whitespace-nowrap font-black block leading-tight">{cat.name}</span>
                <span class="text-[9px] font-semibold opacity-75 whitespace-nowrap block hidden sm:inline">{cat.desc}</span>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- FREQUENTLY BOUGHT -->
    <section class="px-4 pt-3 pb-1" id="section-frequently-bought">
      <div class="flex items-center justify-between mb-3">
        <h2 class="section-title"><span>🔄</span> Frequently Bought</h2>
        <button class="text-[10px] font-bold text-green-600 hover:underline" onclick="document.getElementById('all-products-anchor')?.scrollIntoView({behavior:'smooth'})">View All →</button>
      </div>
      <div class="flex gap-3.5 overflow-x-auto no-scrollbar pb-2.5 scroll-smooth green-scroll" id="frequently-bought-row">
        <div class="flex gap-3.5">
          {Array.from({length:6}).map((_,i) => (
            <div class="flex-shrink-0 w-40 sm:w-44 h-64 skeleton rounded-3xl"></div>
          ))}
        </div>
      </div>
