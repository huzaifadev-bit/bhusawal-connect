  <!-- Synchronous JSON Catalog Data Script -->
  <script id="grocery-catalog-data" type="application/json" is:inline set:html={JSON.stringify(catalog)}></script>

  <!-- Client-side Execution Script -->
  <script is:inline>
    let fullCatalog = JSON.parse(document.getElementById('grocery-catalog-data').textContent || '[]');
    const modalEl = document.getElementById('zepto-product-modal');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    if (modalCloseBtn && modalEl) {
      modalCloseBtn.onclick = (e) => {
        e.stopPropagation();
        modalEl.classList.add('hidden');
        modalEl.classList.remove('flex');
      };
    }

    if (modalEl) {
      modalEl.onclick = (e) => {
        if (e.target === modalEl) {
          modalEl.classList.add('hidden');
          modalEl.classList.remove('flex');
        }
      };
    }

    let cart = JSON.parse(localStorage.getItem('bhusawal_cart_grocery') || '{}');
    let cartCount = 0;
    let cartTotal = 0;

    const mainEl = document.querySelector('main');
    const originalMainHTML = mainEl ? mainEl.innerHTML : '';
    const cartBar = document.getElementById('floating-cart-bar') || document.querySelector('.fixed.bottom-4');
    const cartTextCount = cartBar ? cartBar.querySelectorAll('p')[0] : null;
    const cartTextDetails = cartBar ? cartBar.querySelectorAll('p')[1] : null;

    function isPersonalCareProduct(p) {
      const name = (p["Product Name"] || "").toLowerCase();
      const dbCat = p.Category || "";
      if (dbCat.includes('Personal') || dbCat.includes('Baby') || dbCat.includes('Hygiene') || dbCat.includes('Health') || dbCat.includes('Specialty')) return true;
      const keywords = ['shampoo', 'soap', 'lotion', 'body wash', 'toothpaste', 'toothbrush', 'cream', 'facewash', 'face wash', 'handwash', 'conditioner', 'diaper', 'wipes', 'pears', 'dettol', 'dove', 'nivea', 'colgate', 'sensodyne'];
      return keywords.some(k => name.includes(k));
    }

    function getActualCategory(p) {
      const name = (p["Product Name"] || "").toLowerCase();
      const dbCat = p.Category || "";

      if (isPersonalCareProduct(p)) return 'Personal Care';
      if (dbCat.includes('Cleaning') || dbCat.includes('Laundry') || dbCat.includes('Dishwash') || dbCat.includes('Household') || name.includes('detergent') || name.includes('harpic') || name.includes('lizol') || name.includes('vim') || name.includes('pooja') || name.includes('camphor')) return 'Home';
      if (dbCat.includes('Vegetables') || dbCat.includes('Fruits') || name.includes('sabzi') || name.includes('onion') || name.includes('potato') || name.includes('tomato') || name.includes('apple') || name.includes('banana')) return 'Fruits & Vegetables';
      if (dbCat.includes('Dairy') || dbCat.includes('Breakfast') || dbCat.includes('Bakery') || name.includes('milk') || name.includes('doodh') || name.includes('paneer') || name.includes('butter') || name.includes('curd') || name.includes('dahi') || name.includes('cheese') || name.includes('bread')) return 'Dairy';
      if (dbCat.includes('Atta') || dbCat.includes('Rice') || dbCat.includes('Dal') || dbCat.includes('Staples') || dbCat.includes('Oil') || dbCat.includes('Ghee') || dbCat.includes('Masala') || name.includes('atta') || name.includes('basmati') || name.includes('flour') || name.includes('turmeric') || name.includes('salt') || name.includes('sugar')) return 'Staples';
      return 'Snacks';
    }

    function updateCartBar() {
      localStorage.setItem('bhusawal_cart_grocery', JSON.stringify(cart));
      cartCount = Object.values(cart).reduce((sum, item) => sum + item.qty, 0);
      cartTotal = Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
      if (cartBar) {
        if (cartCount > 0) {
          cartBar.classList.remove('hidden');
          if (cartTextCount) cartTextCount.textContent = cartCount + ' Item' + (cartCount > 1 ? 's' : '');
          if (cartTextDetails) cartTextDetails.textContent = '₹' + cartTotal + ' • Shivaji Nagar';
        } else {
          cartBar.classList.add('hidden');
        }
      }
    }

    function replaceWithStepper(btn, title, price, themeColor) {
      const btnClass = btn.className;
      const stepper = document.createElement('div');
      stepper.className = 'absolute bottom-2 right-2 flex items-center rounded-lg shadow-md overflow-hidden z-10';
      stepper.style.backgroundColor = themeColor;
      stepper.innerHTML = '<button class="qty-minus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">−</button>' +
        '<span class="qty-value w-6 h-7 flex items-center justify-center text-white text-[11px] font-extrabold">1</span>' +
        '<button class="qty-plus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">+</button>';
      
      btn.replaceWith(stepper);

      if (!cart[title]) {
        cart[title] = { price, qty: 1, themeColor };
      }
      updateCartBar();

      const qtyDisplay = stepper.querySelector('.qty-value');
      qtyDisplay.textContent = cart[title].qty;

      stepper.querySelector('.qty-plus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty++;
        qtyDisplay.textContent = cart[title].qty;
        updateCartBar();
      });

      stepper.querySelector('.qty-minus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty--;
        if (cart[title].qty <= 0) {
          delete cart[title];
          const addBtn = document.createElement('button');
          addBtn.className = btnClass;
          addBtn.textContent = 'ADD';
          stepper.replaceWith(addBtn);
          bindAddButton(addBtn);
        } else {
          qtyDisplay.textContent = cart[title].qty;
        }
        updateCartBar();
      });
    }

    function bindAddButton(btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.group');
        if (!card) return;
        const titleEl = card.querySelector('h3');
        if (!titleEl) return;
        const title = titleEl.textContent.trim();
        const priceEl = card.querySelector('.selling-price');
        const price = priceEl ? parseInt(priceEl.textContent.replace(/[^0-9]/g, '')) : 50;
        
        let themeColor = '#0c831f';
        const classes = Array.from(btn.classList);
        for (const cls of classes) {
          if (cls.startsWith('border-[') && cls.endsWith(']')) {
            themeColor = cls.substring(8, cls.length - 1);
            break;
          }
        }
        replaceWithStepper(btn, title, price, themeColor);
      });
    }

    function syncUIWithCart() {
      document.querySelectorAll('.group').forEach(card => {
        const titleEl = card.querySelector('h3');
        if (!titleEl) return;
        const title = titleEl.textContent.trim();
        if (cart[title]) {
          const btn = card.querySelector('.btn-add-static') || card.querySelector('.btn-add-dynamic');
          if (btn) {
            const priceEl = card.querySelector('.selling-price');
            const price = priceEl ? parseInt(priceEl.textContent.replace(/[^0-9]/g, '')) : 50;
            let themeColor = '#0c831f';
            replaceWithStepper(btn, title, price, themeColor);
          }
        }
      });
      updateCartBar();
    }

    function bindStaticButtons() {
      document.querySelectorAll('main button.btn-add-static').forEach(btn => bindAddButton(btn));
      syncUIWithCart();
    }

    function openProductModal(item) {
      if (!modalEl) return;
      document.getElementById('modal-img').src = item["Product Image URL"] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg';
      document.getElementById('modal-title').textContent = item["Product Name"];
      document.getElementById('modal-brand').textContent = item.Brand || 'Bhusawal Local';
      document.getElementById('modal-pack').textContent = item["Pack Size"] || '1 Unit';
      document.getElementById('modal-price').textContent = '₹' + (item.MRP || 50);
      
      // Load Similar Products inside modal
      const recContainer = document.getElementById('recommendations-container');
      if (recContainer) {
        const simProducts = fullCatalog.filter(p => p["Product Name"] !== item["Product Name"]).slice(0, 3);
        let recHtml = '';
        simProducts.forEach(r => {
          recHtml += '<div class="bg-neutral-50 rounded-xl p-2 border border-neutral-200/60 flex flex-col justify-between group hover:border-[#0c831f]/30 transition-all cursor-pointer">' +
            '<div class="w-full aspect-square rounded-lg bg-white p-1 mb-1 flex items-center justify-center overflow-hidden relative">' +
              '<img src="' + (r["Product Image URL"] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg') + '" class="w-full h-full object-contain group-hover:scale-105 transition-transform" />' +
            '</div>' +
            '<div>' +
              '<h4 class="text-[10px] font-extrabold text-neutral-800 line-clamp-1 leading-tight">' + r["Product Name"] + '</h4>' +
              '<div class="flex items-center justify-between mt-1">' +
                '<span class="text-[10px] font-extrabold text-[#0c831f]">₹' + r.MRP + '</span>' +
                '<button class="bg-white border border-[#0c831f] text-[#0c831f] text-[9px] px-2 py-0.5 rounded font-extrabold hover:bg-[#0c831f]/5 active:scale-95 btn-add-dynamic">ADD</button>' +
              '</div>' +
            '</div>' +
          '</div>';
        });
        recContainer.innerHTML = recHtml;
        recContainer.querySelectorAll('.btn-add-dynamic').forEach(btn => bindAddButton(btn));
      }

      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
    }

    function renderProductList(title, products) {
      const cleanTitle = title.replace(/\s*\(\d+\s*Items\)/i, '').trim();
      let themeColor = '#0c831f';
      let bannerTitle = 'FRESH PRODUCE';
      let bannerSub = 'Farm Fresh & Safe Products Delivered in 10 Mins';
      let bannerBg = 'from-emerald-500/10 to-teal-500/10';

      if (cleanTitle.includes('Sexual') || cleanTitle.includes('Wellness')) {
        themeColor = '#e11d48';
        bannerTitle = 'SEXUAL WELLNESS & CONDOMS';
        bannerSub = 'Discreet Delivery in 10 Mins • Condoms, Lubes & Intimate Care';
        bannerBg = 'from-rose-500/10 to-red-500/10';
      } else if (cleanTitle.includes('Ice Cream')) {
        themeColor = '#ec4899';
        bannerTitle = 'ICE CREAM & FROZEN DESSERTS';
        bannerSub = 'Chilled Cones, Tubs, Bars & Local Kulfi';
        bannerBg = 'from-pink-500/10 to-rose-500/10';
      } else if (cleanTitle.includes('Drinks') || cleanTitle.includes('Juices')) {
        themeColor = '#06b6d4';
        bannerTitle = 'COLD DRINKS & JUICES';
        bannerSub = 'Carbonated Drinks, Fruit Juices & Energy Drinks';
        bannerBg = 'from-cyan-500/10 to-blue-500/10';
      } else if (cleanTitle.includes('Tea') || cleanTitle.includes('Coffee')) {
        themeColor = '#eab308';
        bannerTitle = 'TEA, COFFEE & BEVERAGES';
        bannerSub = 'Premium Tea Leaves, Instant Coffee & Morning Drinks';
        bannerBg = 'from-yellow-500/10 to-amber-500/10';
      } else if (cleanTitle.includes('Biscuits')) {
        themeColor = '#d97706';
        bannerTitle = 'BISCUITS & COOKIES';
        bannerSub = 'Cream Biscuits, Cookies, Rusks & Bakery Essentials';
        bannerBg = 'from-amber-500/10 to-orange-500/10';
      } else if (cleanTitle.includes('Instant')) {
        themeColor = '#f97316';
        bannerTitle = 'INSTANT FOOD & NOODLES';
        bannerSub = 'Maggi, Pasta, Oats, Soups & 2-Min Meal Mixes';
        bannerBg = 'from-orange-500/10 to-red-500/10';
      } else if (cleanTitle.includes('Baby')) {
        themeColor = '#6366f1';
        bannerTitle = 'BABY CARE & DIAPERS';
        bannerSub = 'Pampers, Wipes, Baby Skincare & Cerelac';
        bannerBg = 'from-indigo-500/10 to-purple-500/10';
      } else if (cleanTitle.includes('Pet')) {
        themeColor = '#ca8a04';
        bannerTitle = 'PET CARE & FOOD';
        bannerSub = 'Pedigree, Whiskas & Pet Care Supplies';
        bannerBg = 'from-yellow-600/10 to-amber-600/10';
      } else if (cleanTitle.includes('Dairy')) {
        themeColor = '#2563eb';
        bannerTitle = 'DAIRY & BREAKFAST';
        bannerSub = 'Milk, Butter, Cheese & Morning Essentials';
        bannerBg = 'from-blue-500/10 to-cyan-500/10';
      } else if (cleanTitle.includes('Staples')) {
        themeColor = '#d97706';
        bannerTitle = 'KITCHEN STAPLES';
        bannerSub = 'Flours, Grains, Oils & Everyday Spices';
        bannerBg = 'from-amber-500/10 to-yellow-500/10';
      } else if (cleanTitle.includes('Snacks')) {
        themeColor = '#7c3aed';
        bannerTitle = 'SNACKS & MUNCHIES';
        bannerSub = 'Crisps, Cookies, Chocolates & Drinks';
        bannerBg = 'from-purple-500/10 to-indigo-500/10';
      }

      let landingHtml = '<div class="space-y-6 pb-20">' +
        '<div class="flex items-center justify-between">' +
          '<div class="flex items-center gap-1 text-xs font-extrabold text-neutral-500">' +
            '<span>Home</span> › <span class="text-neutral-900 font-black">' + cleanTitle + '</span>' +
          '</div>' +
          '<button id="btn-clear-filter" class="bg-neutral-100 hover:bg-rose-100 hover:text-rose-700 text-neutral-700 text-xs font-black px-4 py-2 rounded-xl flex items-center gap-1 transition-all active:scale-95">' +
            'Back to Home <span class="material-symbols-outlined text-sm">close</span>' +
          '</button>' +
        '</div>' +

        '<div class="w-full bg-gradient-to-r ' + bannerBg + ' rounded-3xl p-6 border border-neutral-200/60 relative overflow-hidden flex items-center justify-between">' +
          '<div class="space-y-2">' +
            '<span class="bg-[#0c831f] text-white text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-widest">Bhusawal Express</span>' +
            '<h1 class="text-xl sm:text-2xl font-black text-neutral-900 leading-none">' + bannerTitle + '</h1>' +
            '<p class="text-xs text-neutral-500 font-extrabold">' + bannerSub + '</p>' +
          '</div>' +
          '<div class="text-4xl select-none">🛍️</div>' +
        '</div>' +

        '<div id="category-pdp-grid-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2.5 sm:gap-4">' +
          generateCardGridHtml(products, themeColor) +
        '</div>' +
      '</div>';

      mainEl.innerHTML = landingHtml;
      mainEl.querySelectorAll('.btn-add-dynamic').forEach(b => bindAddButton(b));
      syncUIWithCart();

      document.getElementById('btn-clear-filter').addEventListener('click', () => {
        restoreOriginalGrid();
      });
    }

    function generateCardGridHtml(products, themeColor) {
      if (products.length === 0) {
        return '<div class="col-span-full py-10 text-center text-xs font-bold text-neutral-400">No items available in this category.</div>';
      }
      let html = '';
      products.forEach(p => {
        html += '<div data-product-card class="bg-white rounded-2xl p-2.5 shadow-[0_8px_16px_rgba(0,0,0,0.02)] flex flex-col group border border-neutral-100/80 hover:border-emerald-500/30 transition-all duration-300 relative cursor-pointer">' +
          '<div class="w-full aspect-square rounded-xl bg-white border border-neutral-100/60 mb-2.5 relative flex items-center justify-center p-2.5 overflow-hidden">' +
            '<img alt="' + (p["Product Name"] || '') + '" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="' + (p["Product Image URL"] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg') + '" />' +
            '<button class="absolute bottom-2 right-2 bg-white border border-[' + themeColor + '] text-[' + themeColor + '] px-3 py-1 rounded-lg text-[10px] font-extrabold shadow-md hover:bg-[' + themeColor + ']/5 active:scale-95 transition-all duration-200 btn-add-dynamic">ADD</button>' +
          '</div>' +
          '<div class="flex-grow flex flex-col justify-between">' +
            '<div>' +
              '<span class="bg-[#0c831f] text-white px-1.5 py-0.5 rounded text-[10px] font-extrabold selling-price">₹' + p.MRP + '</span>' +
              '<h3 class="text-[11px] font-extrabold text-neutral-800 line-clamp-2 h-7.5 mt-1.5 leading-snug">' + p["Product Name"] + '</h3>' +
            '</div>' +
            '<div class="mt-1">' +
              '<p class="text-[9px] text-neutral-500 font-bold">' + (p["Pack Size"] || '1 Unit') + '</p>' +

            '</div>' +
          '</div>' +
        '</div>';
      });
      return html;
    }

    function bindScrollButtons() {
      document.querySelectorAll('[data-target]').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (fullCatalog.length > 0) {
            let matches = [];
            
            if (targetId === 'section-sexual-wellness') {
              matches = fullCatalog.filter(p => p.Category === 'Sexual Wellness');
            } else if (targetId === 'section-icecream') {
              matches = fullCatalog.filter(p => p.Category === 'Ice Cream & Frozen Desserts');
            } else if (targetId === 'section-drinks') {
              matches = fullCatalog.filter(p => p.Category === 'Beverages' && !p["Product Name"].toLowerCase().includes('tea') && !p["Product Name"].toLowerCase().includes('coffee') && !p["Product Name"].toLowerCase().includes('chai'));
            } else if (targetId === 'section-tea') {
              matches = fullCatalog.filter(p => p.Category === 'Beverages' && (p["Product Name"].toLowerCase().includes('tea') || p["Product Name"].toLowerCase().includes('coffee') || p["Product Name"].toLowerCase().includes('chai') || p["Product Name"].toLowerCase().includes('nescafe')));
            } else if (targetId === 'section-biscuits') {
              matches = fullCatalog.filter(p => p.Category === 'Snacks & Confectionery' && (p["Product Name"].toLowerCase().includes('biscuit') || p["Product Name"].toLowerCase().includes('cookie') || p["Product Name"].toLowerCase().includes('rusk') || p["Product Name"].toLowerCase().includes('parle')));
            } else if (targetId === 'section-instant') {
              matches = fullCatalog.filter(p => p.Category === 'Instant & Frozen Foods');
            } else if (targetId === 'section-baby') {
              matches = fullCatalog.filter(p => p.Category === 'Baby Care');
            } else if (targetId === 'section-pet-care') {
              matches = fullCatalog.filter(p => p.Category === 'Pet Care');
            } else if (targetId === 'section-cleaning') {
              matches = fullCatalog.filter(p => p.Category === 'Home Cleaning & Household');
            } else if (targetId === 'section-personal') {
              matches = fullCatalog.filter(p => p.Category === 'Personal Care');
            } else if (targetId === 'section-veggies') {
              matches = fullCatalog.filter(p => p.Category === 'Fruits & Vegetables');
            } else if (targetId === 'section-dairy') {
              matches = fullCatalog.filter(p => p.Category === 'Dairy & Breakfast');
            } else if (targetId === 'section-atta') {
              matches = fullCatalog.filter(p => p.Category === 'Grocery Staples');
            } else if (targetId === 'section-chips') {
              matches = fullCatalog.filter(p => p.Category === 'Snacks & Confectionery');
            } else {
              matches = fullCatalog.slice(0, 30);
            }
            
            const labelSpan = Array.from(btn.querySelectorAll('span')).find(s => !s.classList.contains('material-symbols-outlined'));
            const label = labelSpan ? labelSpan.textContent.trim() : (btn.textContent.trim() || 'Category');
            renderProductList(label, matches);
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
    }

    function bindViewAllButtons() {
      document.querySelectorAll('[data-view-all]').forEach(btn => {
        btn.addEventListener('click', () => {
          const category = btn.getAttribute('data-view-all');
          if (fullCatalog.length > 0) {
            let matches = fullCatalog.filter(p => p.Category === category);
            if (matches.length === 0) {
              matches = fullCatalog.filter(p => getActualCategory(p) === category);
            }
            renderProductList(category, matches);
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
    }

    function restoreOriginalGrid() {
      mainEl.innerHTML = originalMainHTML;
      bindStaticButtons();
      bindScrollButtons();
      bindViewAllButtons();
    }

    // Card click event delegation to open Zepto popup modal
    document.addEventListener('click', (e) => {
      const card = e.target.closest('[data-product-card]');
      if (card && !e.target.closest('button')) {
        const titleEl = card.querySelector('h3');
        if (titleEl) {
          const title = titleEl.textContent.trim();
          const item = fullCatalog.find(p => p["Product Name"] === title) || {
            "Product Name": title,
            "Brand": "Bhusawal Local",
            "MRP": parseInt(card.querySelector('.selling-price')?.textContent.replace(/[^0-9]/g, '') || '50'),
            "Pack Size": "1 Unit",
            "Product Image URL": card.querySelector('img')?.src || '/assets/d686bc969706f3bd6cf093f663be9579.jpg'
          };
          openProductModal(item);
        }
      }
    });

    // Initialize initial button bindings
    bindStaticButtons();
    bindScrollButtons();
    bindViewAllButtons();

    // Live search
    const searchInput = document.getElementById('zepto-search-input');
    const clearBtn = document.getElementById('zepto-clear-btn');
    const searchDropdown = document.getElementById('zepto-search-dropdown');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        if (q.length > 0) {
          if (clearBtn) clearBtn.classList.remove('hidden');
          const matches = fullCatalog.filter(p => (p["Product Name"] || "").toLowerCase().includes(q));
          let html = '';
          matches.slice(0, 6).forEach(item => {
            html += '<div data-title="' + item["Product Name"] + '" class="p-3 hover:bg-neutral-50 cursor-pointer flex items-center justify-between search-dropdown-row">' +
              '<div class="flex items-center gap-3">' +
                '<img src="' + (item["Product Image URL"] || '/assets/d686bc969706f3bd6cf093f663be9579.jpg') + '" class="w-8 h-8 object-contain rounded bg-white p-0.5 border" />' +
                '<h4 class="text-xs font-black text-neutral-800">' + item["Product Name"] + '</h4>' +
              '</div>' +
              '<span class="text-xs font-black text-[#0c831f]">₹' + item.MRP + '</span>' +
            '</div>';
          });
          searchDropdown.innerHTML = html;
          searchDropdown.classList.remove('hidden');

          searchDropdown.querySelectorAll('.search-dropdown-row').forEach(row => {
            row.addEventListener('click', () => {
              const t = row.getAttribute('data-title');
              const item = matches.find(p => p["Product Name"] === t);
              if (item) openProductModal(item);
            });
          });
        } else {
          if (clearBtn) clearBtn.classList.add('hidden');
          if (searchDropdown) searchDropdown.classList.add('hidden');
          restoreOriginalGrid();
        }
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          clearBtn.classList.add('hidden');
          if (searchDropdown) searchDropdown.classList.add('hidden');
          restoreOriginalGrid();
        });
      }
    }
  
    if (cartBar) {
      cartBar.onclick = (e) => {
        e.stopPropagation();
        window.location.href = '/billing';
      };
    }
  </script>
  <Switcher />
</body>
</html>
