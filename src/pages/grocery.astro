  <!-- ==================== HIGH-PERFORMANCE 8,000 SKU ENGINE ==================== -->
  <script is:inline define:vars={{ totalProducts, categoriesList }}>
    const initGroceryPage = async () => {
      let catalogData = window.groceryCatalogCache || null;
      let categoryMap = new Map();
      let searchIndex = [];

      // FORCE FRESH CATALOG FETCH TO PREVENT STALE BROWSER SESSION CACHING
      try {
        const res = await fetch('/grocery_catalog.json?t=' + Date.now());
        if (res.ok) {
          catalogData = await res.json();
          window.groceryCatalogCache = catalogData;
        }
      } catch(e) {
        console.error("Failed to load grocery catalog", e);
        catalogData = window.groceryCatalogCache || [];
      }
      if (!catalogData) catalogData = [];

      function pField(p, key) {
        if (!p || typeof p !== 'object') return '';
        const map = {
          id: ['Product ID', 'id', 'sku', 'ProductID'],
          name: ['displayName','Product Name','name'],
          originalName: ['originalName','Product Name','name'],
          brand: ['Brand Name','brand'],
          cat: ['category','Category','cat'],
          subcat: ['subcategory','Subcategory','subcat'],
          pack: ['Pack Size','pack','weight','Unit'],
          mrp: ['MRP','mrp'],
          sp: ['Selling Price','sp','price'],
          disc: ['Discount %','disc'],
          img: ['Product Image URL','img','image'],
          kw: ['Search Keywords','kw'],
          desc: ['desc','Description'],
          stock: ['stock','status']
        };
        const keys = map[key] || [key];
        for (const k of keys) { if (p[k] !== undefined && p[k] !== null && p[k] !== '') return p[k]; }
        const defaults = { id: '', name: '', brand: 'Bhusawal Fresh', cat: 'Grocery', subcat: 'General Essentials', pack: '1 Unit', mrp: 50, sp: 50, disc: 0, img: '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg', kw: '', desc: '', stock: 100 };
        return defaults[key] || '';
      }

      // OPTIMIZATION 2: PRE-INDEXED O(1) CATEGORY LOOKUP MAP FOR 8,000 SKUs
      function buildCategoryIndexes() {
        categoryMap.set('all', catalogData);
        categoriesList.forEach(c => {
          if (c.id !== 'all') categoryMap.set(c.id, []);
        });

        for (let i = 0; i < catalogData.length; i++) {
          const p = catalogData[i];
          for (let c = 0; c < categoriesList.length; c++) {
            const cat = categoriesList[c];
            if (cat.id === 'all') continue;
            if (matchProductCategory(p, cat.id, cat.name)) {
              categoryMap.get(cat.id).push(p);
            }
          }
        }
      }

      // OPTIMIZATION 3: SUB-1MS INVERTED SEARCH INDEX FOR 8,000 SKUs
      function buildSearchIndex() {
        searchIndex = catalogData.map(p => {
          const dispName = String(pField(p, 'name') || '');
          const origName = String(p.originalName || p.name || '');
          const dispLower = dispName.toLowerCase();
          const origLower = origName.toLowerCase();
          const brand = String(pField(p, 'brand') || '');
          const brandLower = brand.toLowerCase();
          const cat = String(pField(p, 'cat') || '');
          const catLower = cat.toLowerCase();
          const subcat = String(pField(p, 'subcat') || '');
          const subcatLower = subcat.toLowerCase();
          const pack = String(pField(p, 'pack') || pField(p, 'weight') || '');
          const packLower = pack.toLowerCase();
          const kw = String(pField(p, 'kw') || '');
          const kwLower = kw.toLowerCase();
          const desc = String(pField(p, 'desc') || '');
          const descLower = desc.toLowerCase();
          
          const fullText = `${dispLower} ${origLower} ${brandLower} ${catLower} ${subcatLower} ${packLower} ${kwLower} ${descLower}`;
          return { p, name: dispName, nameLower: dispLower, origLower, brand, brandLower, cat, catLower, subcat, subcatLower, pack, packLower, kwLower, fullText };
        });
      }

      function matchProductCategory(p, catId, catName) {
        if (catId === 'cigarettes' || catName === 'Cigarettes') {
          const catVal = String(pField(p, 'cat') || '').toLowerCase();
          const subcatVal = String(pField(p, 'subcat') || '').toLowerCase();
          const nameVal = String(pField(p, 'name') || '').toLowerCase();
          const brandVal = String(pField(p, 'brand') || '').toLowerCase();
          return catVal === 'cigarettes' || subcatVal.includes('cigarette') || subcatVal.includes('tobacco') || nameVal.includes('cigarette') || nameVal.includes('cigar') || nameVal.includes('gold flake') || nameVal.includes('marlboro') || nameVal.includes('wills');
        }
        if (catId === 'all' || catName === 'All Products') return true;

        const cat = String(pField(p, 'cat') || '').trim();
        const subcat = String(pField(p, 'subcat') || '').trim();
        const subcatLower = subcat.toLowerCase();
        const name = String(pField(p, 'name') || '').toLowerCase();

        if (cat === catName) return true;

        if (catId === 'fresh-veg' || catName === 'Fresh Vegetables') {
          return cat === 'Fresh Vegetables' || subcatLower.includes('veg') || subcatLower.includes('vegetable');
        }
        if (catId === 'fresh-fruits' || catName === 'Fresh Fruits') {
          return cat === 'Fresh Fruits' || subcatLower.includes('fruit');
        }
        if (catId === 'dairy' || catName === 'Dairy & Breakfast') {
          return cat === 'Dairy & Breakfast' || cat === 'Dairy' || cat.toLowerCase().includes('dairy') || subcatLower.includes('milk');
        }
        if (catId === 'atta-rice-dal' || catName === 'Atta Rice & Dal') {
          return cat === 'Atta Rice Dal' || cat === 'Atta Rice & Dal' || subcatLower.includes('atta') || subcatLower.includes('rice') || subcatLower.includes('dal');
        }
        if (catId === 'oil-ghee-masala' || catName === 'Oil, Ghee & Masala') {
          return cat === 'Oil & Ghee' || cat === 'Masala' || cat === 'Oil Ghee Masala' || subcatLower.includes('oil') || subcatLower.includes('ghee') || subcatLower.includes('masala') || subcatLower.includes('spice');
        }
        if (catId === 'bakery' || catName === 'Bakery') {
          if (['Fresh Vegetables', 'Fresh Fruits', 'Meat', 'Fish', 'Egg', 'Cleaning', 'Personal Care', 'Baby Care', 'Pet Care', 'Pooja', 'Oil & Ghee', 'Masala', 'Atta Rice Dal'].includes(cat)) return false;
          return cat === 'Bakery' ||
            /\b(bakery|bread|pav|rusk|toast|cake|pastry|muffin|croissant|donut)\b/i.test(subcat) ||
            /\b(bread|pav|rusk|toast|cake|pastry|muffin|croissant|donut)\b/i.test(name) ||
            /\b(bun|buns)\b/i.test(name);
        }
        if (catId === 'snacks' || catName === 'Snacks') {
          return cat === 'Snacks' || cat.toLowerCase().includes('snack') || cat.toLowerCase().includes('biscuit') || cat.toLowerCase().includes('cookie');
        }
        if (catId === 'tea-coffee' || catName === 'Tea & Coffee') {
          return subcatLower.includes('tea') || subcatLower.includes('coffee') || name.includes('tea') || name.includes('coffee');
        }
        if (catId === 'cold-drinks' || catName === 'Cold Drinks') {
          if (subcatLower.includes('tea') || subcatLower.includes('chai') || subcatLower.includes('coffee')) return false;
          if (name.includes('tea') || name.includes('chai') || name.includes('coffee') || name.includes('health malt') || name.includes('nutrition drink')) return false;
          const coldBrands = ['coca-cola', 'pepsi', 'sprite', 'thums up', 'limca', 'fanta', 'maaza', 'real', 'slice', 'appy', 'paper boat', 'lemonade', 'fizz', 'soda'];
          return cat === 'Beverages' && (
            subcatLower.includes('soft drink') || subcatLower.includes('cold drink') || subcatLower.includes('juice') || subcatLower.includes('soda') || subcatLower.includes('carbonated') || subcatLower.includes('aerated') || subcatLower.includes('fruit drink') ||
            coldBrands.some(b => name.includes(b))
          );
        }
        if (catId === 'frozen-food' || catName === 'Frozen Food') {
          return cat === 'Frozen Food' || subcatLower.includes('frozen') || subcatLower.includes('ready-to-eat') || name.includes('frozen') || name.includes('paneer') || name.includes('ice cream');
        }
        if (catId === 'personal-care' || catName === 'Personal Care') {
          return cat === 'Personal Care';
        }
        if (catId === 'cleaning' || catName === 'Cleaning') {
          return cat === 'Cleaning';
        }
        if (catId === 'baby-care' || catName === 'Baby Care') {
          return cat === 'Baby Care';
        }
        if (catId === 'health' || catName === 'Health & Wellness') {
          return cat === 'Health & Wellness';
        }
        if (catId === 'dry-fruits' || catName === 'Dry Fruits') {
          return cat === 'Dry Fruits' || subcatLower.includes('dry fruit') || subcatLower.includes('nuts') || name.includes('almond') || name.includes('cashew') || name.includes('kishmish') || name.includes('raisin') || name.includes('walnut') || name.includes('pista');
        }
        if (catId === 'pooja' || catName === 'Pooja') {
          return cat === 'Pooja' || cat === 'Pooja Items' || subcatLower.includes('pooja') || subcatLower.includes('pooja needs') || name.includes('pooja') || name.includes('puja') || name.includes('agarbatti') || name.includes('camphor') || name.includes('kapoor');
        }
        if (catId === 'pet-care' || catName === 'Pet Care') {
          return cat === 'Pet Care';
        }

        return cat.toLowerCase() === String(catName || '').toLowerCase();
      }

      buildCategoryIndexes();
      buildSearchIndex();

      // --- Cart management ---
      function getCart() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); } catch(e) { return []; }
      }
      function saveCart(cart) { localStorage.setItem('bhusawal_cart', JSON.stringify(cart)); }

      function updateCartBar() {
        const cart = getCart();
        const bar = document.getElementById('floating-cart-bar');
        const countBadge = document.getElementById('cart-count-badge');
        const headerBadge = document.getElementById('cart-badge-header');
        const totalText = document.getElementById('cart-total-text');
        const totalQty = cart.reduce((s, i) => s + (i.quantity || 1), 0);
        const totalPrice = cart.reduce((s, i) => s + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);
        if (countBadge) countBadge.textContent = totalQty;
        if (headerBadge) headerBadge.textContent = totalQty;
        if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);
        if (totalQty > 0) bar?.classList.remove('hidden');
        else bar?.classList.add('hidden');
      }

      function addToCart(id, name, price, img) {
        const checkItem = catalogData.find(item => pField(item, 'id') === id) || { id, name, category: currentCategory };
        if (window.BhusawalAgeVerification && window.BhusawalAgeVerification.isCigaretteItem(checkItem)) {
          if (!window.BhusawalAgeVerification.isAgeVerified()) {
            window.BhusawalAgeVerification.promptAgeVerification(() => {
              addToCart(id, name, price, img);
            });
            return;
          }
        }
        let cart = getCart();
        const p = catalogData.find(item => pField(item, 'id') === id);
        if (p) {
          if (!name || String(name).trim() === '') name = pField(p, 'name');
          if (!price || isNaN(parseFloat(price)) || parseFloat(price) === 0) {
            price = parseFloat(pField(p, 'sp'));
            if (!price || isNaN(price)) price = parseFloat(pField(p, 'mrp')) || 50;
          }
          if (!img || String(img).trim().length < 5) {
            img = pField(p, 'img');
            if (!img || String(img).trim().length < 5) img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          }
        }
        const existing = cart.find(i => i.id === id);
        if (existing) {
          existing.quantity = (existing.quantity || 1) + 1;
        } else {
          const actualMrp = p ? (parseFloat(pField(p, 'mrp')) || parseFloat(price)) : parseFloat(price);
          cart.push({ id, name, price: parseFloat(price), mrp: actualMrp, image: img, quantity: 1, cat: 'Grocery' });
        }
        saveCart(cart);
        updateCartBar();
      }

      function changeQty(id, delta) {
        let cart = getCart();
        const idx = cart.findIndex(i => i.id === id);
        if (idx > -1) {
          cart[idx].quantity = (cart[idx].quantity || 1) + delta;
          if (cart[idx].quantity <= 0) cart.splice(idx, 1);
        }
        saveCart(cart);
        updateCartBar();
      }

      // --- Wishlist Management ---
      const WISHLIST_KEY = 'bhusawal_wishlist';
      function getWishlist() {
        try { return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]'); } catch(e) { return []; }
      }

      function toggleWishlist(id, name, price, img, brand, pack) {
        let list = getWishlist();
        const idx = list.findIndex(i => (i.id || i["Product ID"]) === id);
        if (idx > -1) {
          list.splice(idx, 1);
        } else {
          const p = catalogData.find(item => pField(item, 'id') === id);
          if (p) {
            if (!name || String(name).trim() === '') name = pField(p, 'name');
            if (!price || isNaN(parseFloat(price)) || parseFloat(price) === 0) {
              price = parseFloat(pField(p, 'sp'));
              if (!price || isNaN(price)) price = parseFloat(pField(p, 'mrp')) || 50;
            }
            if (!img || String(img).trim().length < 5) {
              img = pField(p, 'img');
              if (!img || String(img).trim().length < 5) img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
            }
            if (!brand) brand = pField(p, 'brand');
            if (!pack) pack = pField(p, 'pack');
          }
          list.push({ id, name, price: parseFloat(price), mrp: parseFloat(price), image: img, brand, pack, cat: 'Grocery' });
        }
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
        refreshWishlistButtons();
      }

      function refreshWishlistButtons() {
        const wishlist = getWishlist();
        const wishIds = new Set(wishlist.map(i => i.id || i["Product ID"]));

        document.querySelectorAll('.wishlist-btn').forEach(btn => {
          const id = btn.dataset.id;
          const isW = wishIds.has(id);
          const icon = btn.querySelector('.material-symbols-outlined');
          if (isW) {
            btn.classList.add('text-red-500', 'bg-red-50');
            btn.classList.remove('text-slate-400');
            if (icon) icon.style.fontVariationSettings = "'FILL' 1";
          } else {
            btn.classList.remove('text-red-500', 'bg-red-50');
            btn.classList.add('text-slate-400');
            if (icon) icon.style.fontVariationSettings = "'FILL' 0";
          }
        });
      }

      // --- Recent Searches Storage ---
      const RECENT_KEY = 'bhusawal_grocery_recent_searches';
      function getRecentSearches() {
        try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) { return []; }
      }
      function saveRecentSearch(term) {
        if (!term || term.trim().length < 2) return;
        let list = getRecentSearches();
        const clean = term.trim();
        list = list.filter(item => item.toLowerCase() !== clean.toLowerCase());
        list.unshift(clean);
        if (list.length > 8) list = list.slice(0, 8);
        localStorage.setItem(RECENT_KEY, JSON.stringify(list));
      }
      function clearRecentSearches() {
        localStorage.removeItem(RECENT_KEY);
        renderRecentSearches();
      }

      function renderRecentSearches() {
        const box = document.getElementById('recent-searches-box');
        const listEl = document.getElementById('recent-searches-list');
        const items = getRecentSearches();

        if (!items || items.length === 0) {
          box?.classList.add('hidden');
          return;
        }

        box?.classList.remove('hidden');
        if (listEl) {
          listEl.innerHTML = items.map(term => `
            <button class="recent-tag px-3 py-1 bg-slate-100 hover:bg-green-600 text-slate-700 hover:text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1 group" data-query="${term.replace(/"/g, '&quot;')}">
              <span>${term}</span>
              <span class="text-[10px] text-slate-400 group-hover:text-white">✕</span>
            </button>
          `).join('');
        }
      }

      // ==================== OPTIMIZED LAZY PRODUCT CARD RENDERER ====================
      function renderProductCard(p, animDelay = 0) {
        const rawId = pField(p, 'id');
        const canonicalProductId = (rawId && typeof rawId === 'string' && !['undefined', 'null', 'n/a'].includes(rawId.toLowerCase().trim())) ? rawId.trim() : '';
        const hasValidLink = canonicalProductId.length > 0;
        const productHref = hasValidLink ? `/product/${encodeURIComponent(canonicalProductId)}` : 'javascript:void(0);';

        const id = canonicalProductId || '';
        const name = (pField(p, 'name')).split(" (Batch")[0];
        const brand = pField(p, 'brand');
        const pack = pField(p, 'pack');
        const mrp = parseFloat(pField(p, 'mrp'));
        let sp = parseFloat(pField(p, 'sp'));
        if (!sp || sp === 0 || isNaN(sp)) sp = mrp;
        
        let disc = parseInt(pField(p, 'disc') || 0);
        if ((!disc || disc === 0) && mrp > sp) {
          disc = Math.round(((mrp - sp) / mrp) * 100);
        }
        const hasDiscount = mrp > sp && disc > 0;
        let img = pField(p, 'img');
        if (!img || typeof img !== 'string' || img.trim().length < 5) {
          img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
        }
        const isOutOfStock = pField(p, 'stock') === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
        const nameSafe = name.replace(/"/g, '&quot;');
        const brandSafe = brand.replace(/"/g, '&quot;');

        const wishlist = getWishlist();
        const isWishlisted = wishlist.some(i => (i.id || i["Product ID"]) === id);

        const cart = getCart();
        const cartItem = cart.find(i => i.id === id);
        const qty = cartItem ? (cartItem.quantity || 1) : 0;

        const cartBtn = qty > 0
          ? `<div class="flex items-center justify-between bg-green-600 text-white font-extrabold text-xs rounded-xl overflow-hidden shadow-2xs min-h-[44px] min-w-[68px]">
              <button class="qty-btn px-2.5 py-1.5 hover:bg-green-700 active:scale-90 transition-all cursor-pointer" data-action="minus" data-id="${id}">−</button>
              <span class="px-1.5 text-[11px] font-black min-w-[1.2rem] text-center">${qty}</span>
              <button class="qty-btn px-2.5 py-1.5 hover:bg-green-700 active:scale-90 transition-all cursor-pointer" data-action="plus" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+</button>
            </div>`
          : `<button class="add-btn px-3 py-2 bg-green-50 hover:bg-green-600 text-green-700 hover:text-white border border-green-200 text-[10px] sm:text-xs font-black rounded-xl active:scale-90 transition-all cursor-pointer shadow-2xs min-h-[44px] min-w-[60px] flex items-center justify-center" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+ ADD</button>`;

        const isVeg = (pField(p, 'subcat') === 'Fresh Vegetables' || pField(p, 'cat') === 'Fresh Fruits & Vegetables' || brand === 'Farm Fresh' || brand === 'Mahafresh');

        const cardTag = hasValidLink ? 'a' : 'div';
        const cardAttr = hasValidLink ? `href="${productHref}"` : '';
        const endCardTag = hasValidLink ? 'a' : 'div';

        // OPTIMIZATION 4: ASYNC DECODING + LAZY LOADING FOR IMAGE PERFORMANCE
        return `<div class="product-card-v2 group bg-white rounded-2xl sm:rounded-3xl border border-slate-100/90 shadow-2xs hover:shadow-xl hover:border-green-200 transition-all duration-300 relative flex flex-col justify-between overflow-hidden p-2 sm:p-3 animate-fade-up" style="animation-delay:${animDelay}ms" data-product-id="${id}">
          
          <${cardTag} ${cardAttr} class="relative w-full h-28 xs:h-32 sm:h-36 lg:h-40 bg-gradient-to-b from-green-50/30 to-slate-50/50 rounded-xl sm:rounded-2xl flex items-center justify-center p-1.5 sm:p-2 overflow-hidden mb-1.5 sm:mb-2 shrink-0 group-hover:scale-102 transition-transform">
            
            <div class="absolute top-1.5 left-1.5 z-10 flex flex-col gap-1 items-start">
              ${isVeg ? `<span class="px-1.5 py-0.5 bg-emerald-600 text-white text-[8px] font-black rounded-md uppercase tracking-wider flex items-center gap-0.5 shadow-2xs">🌱 Fresh</span>` : ''}
              ${hasDiscount ? `<span class="px-1.5 py-0.5 bg-red-600 text-white text-[9px] font-black rounded-md uppercase tracking-wider shadow-2xs">${disc}% OFF</span>` : ''}
              <span class="px-1.5 py-0.5 ${isOutOfStock ? 'bg-slate-900 text-white' : 'bg-green-600 text-white'} text-[8px] font-extrabold rounded-md shadow-2xs">
                ${isOutOfStock ? 'OUT OF STOCK' : '🟢 In Stock'}
              </span>
            </div>

            <button class="wishlist-btn absolute top-1.5 right-1.5 z-10 w-7 h-7 rounded-full bg-white/90 backdrop-blur-md border border-slate-100 flex items-center justify-center ${isWishlisted ? 'text-red-500 bg-red-50' : 'text-slate-400'} hover:text-red-500 hover:scale-110 active:scale-95 transition-all shadow-2xs" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}" data-brand="${brandSafe}" data-pack="${pack}" title="Add to Wishlist" onclick="event.preventDefault(); event.stopPropagation();">
              <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' ${isWishlisted ? 1 : 0};">favorite</span>
            </button>

            ${isOutOfStock ? `<div class="absolute inset-0 bg-slate-900/30 backdrop-blur-[1px] z-20 flex items-center justify-center">
              <span class="bg-slate-900/90 text-white text-[10px] font-black px-2.5 py-1 rounded-lg uppercase tracking-wider">Out of Stock</span>
            </div>` : ''}

            <img src="${img}" alt="${nameSafe}" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
          </${endCardTag}>

          <div class="flex flex-col flex-1 px-0.5 space-y-1">
            <div class="flex items-center justify-between">
              <span class="text-[9px] font-black text-green-700 uppercase tracking-wider truncate max-w-[70%]">${brand}</span>
              ${hasDiscount ? `<span class="text-[9px] font-bold text-red-500">Save ₹${mrp - sp}</span>` : ''}
            </div>

            <${cardTag} ${cardAttr} class="block">
              <h3 class="text-[11px] sm:text-xs font-extrabold text-slate-900 line-clamp-2 leading-snug min-h-[2rem] group-hover:text-green-700 transition-colors">${name}</h3>
            </${endCardTag}>

            <p class="text-[10px] font-semibold text-slate-400 truncate mb-1">${pack}</p>

            <div class="flex items-center justify-between gap-1 mt-auto pt-2 border-t border-slate-100">
              <div class="flex items-baseline gap-1">
                <span class="text-sm sm:text-base font-black text-slate-900">₹${sp}</span>
                ${hasDiscount ? `<span class="text-[10px] font-bold text-slate-400 line-through">₹${mrp}</span>` : ''}
              </div>

              <div class="cart-action-area shrink-0">
                ${cartBtn}
              </div>
            </div>
          </div>
        </div>`;
      }

      // --- Horizontal Card Renderer for Rows ---
      function renderHCard(p) {
        const rawId = pField(p, 'id');
        const canonicalProductId = (rawId && typeof rawId === 'string' && !['undefined', 'null', 'n/a'].includes(rawId.toLowerCase().trim())) ? rawId.trim() : '';
        const hasValidLink = canonicalProductId.length > 0;
        const productHref = hasValidLink ? `/product/${encodeURIComponent(canonicalProductId)}` : 'javascript:void(0);';

        const id = canonicalProductId || '';
        const name = (pField(p, 'name')).split(" (Batch")[0];
        const brand = pField(p, 'brand');
        const pack = pField(p, 'pack');
        const mrp = parseFloat(pField(p, 'mrp'));
        let sp = parseFloat(pField(p, 'sp'));
        if (!sp || sp === 0 || isNaN(sp)) sp = mrp;

        let disc = parseInt(pField(p, 'disc') || 0);
        if ((!disc || disc === 0) && mrp > sp) {
          disc = Math.round(((mrp - sp) / mrp) * 100);
        }
        const hasDiscount = disc > 0 && mrp > sp;

        let img = pField(p, 'img');
        if (!img || typeof img !== 'string' || img.trim().length < 5) {
          img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
        }
        const nameSafe = name.replace(/"/g, '&quot;');
        const brandSafe = brand.replace(/"/g, '&quot;');

        const wishlist = getWishlist();
        const isWishlisted = wishlist.some(i => (i.id || i["Product ID"]) === id);

        const cart = getCart();
        const cartItem = cart.find(i => i.id === id);
        const qty = cartItem ? (cartItem.quantity || 1) : 0;

        const cartBtn = qty > 0
          ? `<div class="flex items-center bg-green-600 text-white font-extrabold text-[10px] rounded-lg overflow-hidden">
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="minus" data-id="${id}">−</button>
              <span class="px-1 font-black min-w-[1rem] text-center">${qty}</span>
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="plus" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+</button>
            </div>`
          : `<button class="add-btn w-full py-1 bg-green-50 hover:bg-green-600 text-green-700 hover:text-white border border-green-200 text-[9px] font-black rounded-lg active:scale-90 transition-all" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+ ADD</button>`;

        const cardTag = hasValidLink ? 'a' : 'div';
        const cardAttr = hasValidLink ? `href="${productHref}"` : '';
        const endCardTag = hasValidLink ? 'a' : 'div';

        return `<div class="flex-shrink-0 w-40 sm:w-44 bg-white rounded-2xl sm:rounded-3xl border border-slate-100 p-2.5 flex flex-col product-card-v2 relative overflow-hidden group" data-product-id="${id}">
          <button class="wishlist-btn absolute top-1.5 right-1.5 z-10 w-7 h-7 rounded-full bg-white/90 backdrop-blur-md border border-slate-100 flex items-center justify-center ${isWishlisted ? 'text-red-500 bg-red-50' : 'text-slate-400'} hover:text-red-500 hover:scale-110 active:scale-95 transition-all shadow-2xs" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}" data-brand="${brandSafe}" data-pack="${pack}" title="Add to Wishlist" onclick="event.preventDefault(); event.stopPropagation();">
            <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' ${isWishlisted ? 1 : 0};">favorite</span>
          </button>

          <${cardTag} ${cardAttr} class="relative w-full h-32 sm:h-36 bg-gradient-to-b from-green-50/30 to-slate-50/50 rounded-xl sm:rounded-2xl flex items-center justify-center p-1.5 overflow-hidden mb-2 shrink-0 block">
            ${hasDiscount ? `<span class="absolute top-1 left-1 px-1.5 py-0.5 bg-red-600 text-white text-[8px] font-black rounded uppercase">${disc}% OFF</span>` : ''}
            <img src="${img}" alt="${nameSafe}" class="w-full h-full object-contain" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
          </${endCardTag}>
          <span class="text-[8px] font-black text-green-700 uppercase tracking-wider truncate">${brand}</span>
          <${cardTag} ${cardAttr} class="block">
            <h4 class="text-[10px] font-extrabold text-slate-800 line-clamp-2 leading-snug min-h-[1.8rem] mt-0.5 hover:text-green-700 transition-colors">${name}</h4>
          </${endCardTag}>
          <p class="text-[9px] font-semibold text-slate-400 mb-1 truncate">${pack}</p>
          <div class="flex items-center justify-between mt-auto pt-1.5 border-t border-slate-100">
            <div class="flex items-baseline gap-1">
              <span class="text-xs font-black text-slate-900">₹${sp}</span>
              ${hasDiscount ? `<span class="text-[9px] font-bold text-slate-400 line-through">₹${mrp}</span>` : ''}
            </div>
            <div class="cart-action-area">${cartBtn}</div>
          </div>
        </div>`;
      }

      // --- Dropdown Mini Product Renderer ---
      function renderDropdownProductRow(p, query) {
        const id = pField(p, 'id');
        const name = (pField(p, 'name')).split(" (Batch")[0];
        const brand = pField(p, 'brand');
        const pack = pField(p, 'pack');
        const mrp = parseFloat(pField(p, 'mrp'));
        let sp = parseFloat(pField(p, 'sp'));
        if (!sp || sp === 0 || isNaN(sp)) sp = mrp;
        let img = pField(p, 'img');
        if (!img || typeof img !== 'string' || img.trim().length < 5) {
          img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
        }
        const nameSafe = name.replace(/"/g, '&quot;');

        let displayName = name;
        if (query) {
          const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
          displayName = name.replace(re, '<span class="search-match-hl">$1</span>');
        }

        const cart = getCart();
        const cartItem = cart.find(i => i.id === id);
        const qty = cartItem ? (cartItem.quantity || 1) : 0;

        const cartBtn = qty > 0
          ? `<div class="flex items-center bg-green-600 text-white font-extrabold text-[10px] rounded-lg overflow-hidden shrink-0">
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="minus" data-id="${id}">−</button>
              <span class="px-1.5 font-black text-center min-w-[1rem]">${qty}</span>
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="plus" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+</button>
            </div>`
          : `<button class="add-btn px-3 py-1 bg-green-50 hover:bg-green-600 text-green-700 hover:text-white border border-green-200 text-[10px] font-black rounded-lg active:scale-90 transition-all shrink-0" data-id="${id}" data-name="${nameSafe}" data-price="${sp}" data-img="${img}">+ ADD</button>`;

        return `<div class="flex items-center justify-between gap-2 p-2 hover:bg-green-50/50 rounded-xl transition-colors product-card-v2" data-product-id="${id}">
          <a href="/product/${encodeURIComponent(id)}" class="flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer select-product-row">
            <div class="w-10 h-10 rounded-lg bg-white border border-slate-100 flex items-center justify-center p-1 shrink-0">
              <img src="${img}" alt="${nameSafe}" class="w-full h-full object-contain" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="text-xs font-bold text-slate-800 truncate leading-tight">${displayName}</h4>
              <p class="text-[10px] text-slate-400 font-semibold truncate">${brand} • ${pack}</p>
            </div>
          </a>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-xs font-black text-slate-900">₹${sp}</span>
            <div class="cart-action-area">${cartBtn}</div>
          </div>
        </div>`;
      }

      // Bind global cart & wishlist actions
      document.body.addEventListener('click', (e) => {
        const wishlistBtn = e.target.closest('.wishlist-btn');
        if (wishlistBtn) {
          e.stopPropagation();
          toggleWishlist(
            wishlistBtn.dataset.id,
            wishlistBtn.dataset.name,
            wishlistBtn.dataset.price,
            wishlistBtn.dataset.img,
            wishlistBtn.dataset.brand,
            wishlistBtn.dataset.pack
          );
          return;
        }

        const addBtn = e.target.closest('.add-btn');
        if (addBtn) {
          e.stopPropagation();
          addToCart(addBtn.dataset.id, addBtn.dataset.name, addBtn.dataset.price, addBtn.dataset.img);
          refreshVisibleButtons();
          return;
        }

        const qtyBtn = e.target.closest('.qty-btn');
        if (qtyBtn) {
          e.stopPropagation();
          if (qtyBtn.dataset.action === 'plus') {
            addToCart(qtyBtn.dataset.id, qtyBtn.dataset.name, qtyBtn.dataset.price, qtyBtn.dataset.img);
          } else {
            changeQty(qtyBtn.dataset.id, -1);
          }
          refreshVisibleButtons();
          return;
        }
      });

      function refreshVisibleButtons() {
        const cart = getCart();
        document.querySelectorAll('.cart-action-area').forEach(area => {
          const card = area.closest('[data-product-id]');
          if (!card) return;
          const id = card.dataset.productId;
          const p = catalogData.find(item => pField(item, 'id') === id);

          let name = '', price = '', img = '';
          if (p) {
            name = pField(p, 'name');
            price = parseFloat(pField(p, 'sp'));
            if (!price || isNaN(price)) price = parseFloat(pField(p, 'mrp')) || 50;
            img = pField(p, 'img');
            if (!img || String(img).trim().length < 5) img = '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          } else {
            const btn = area.querySelector('[data-name]');
            if (btn) { name = btn.dataset.name; price = btn.dataset.price; img = btn.dataset.img; }
          }

          const nameSafe = String(name || '').replace(/"/g, '&quot;');
          const cartItem = cart.find(i => i.id === id);
          const qty = cartItem ? (cartItem.quantity || 1) : 0;

          if (qty > 0) {
            area.innerHTML = `<div class="flex items-center bg-green-600 text-white font-extrabold text-[10px] rounded-lg overflow-hidden shadow-2xs">
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="minus" data-id="${id}">−</button>
              <span class="px-1.5 font-black text-center min-w-[1rem]">${qty}</span>
              <button class="qty-btn px-2 py-1 hover:bg-green-700 active:scale-90" data-action="plus" data-id="${id}" data-name="${nameSafe}" data-price="${price}" data-img="${img}">+</button>
            </div>`;
          } else {
            area.innerHTML = `<button class="add-btn px-3 py-1.5 bg-green-50 hover:bg-green-600 text-green-700 hover:text-white border border-green-200 text-[10px] font-black rounded-xl active:scale-90 transition-all shadow-2xs" data-id="${id}" data-name="${nameSafe}" data-price="${price}" data-img="${img}">+ ADD</button>`;
          }
        });
        refreshWishlistButtons();
      }

      // OPTIMIZATION 5: CACHE POPULAR & FREQUENTLY BOUGHT PRODUCTS IN SESSION STORAGE
      const freqRow = document.getElementById('frequently-bought-row');
      const popularRow = document.getElementById('popular-row');
      const recentSection = document.getElementById('section-recently-ordered');
      const recentRow = document.getElementById('recently-ordered-row');
      const dropdownPopularList = document.getElementById('dropdown-popular-list');

      const essentialBrands = ['Amul', 'Tata', 'Fortune', 'Aashirvaad', 'Parle', 'Britannia', 'Dettol', 'Surf Excel', 'Haldiram', 'Red Label', 'Mother Dairy', 'Colgate'];
      const freqProducts = [];
      const usedIds = new Set();

      for (const brand of essentialBrands) {
        const match = catalogData.find(p => {
          const b = String(pField(p, 'brand') || '');
          const id = pField(p, 'id');
          return b.includes(brand) && !usedIds.has(id);
        });
        if (match) { freqProducts.push(match); usedIds.add(pField(match, 'id')); }
        if (freqProducts.length >= 10) break;
      }

      if (freqRow) freqRow.innerHTML = freqProducts.map(p => renderHCard(p)).join('');

      const popularProducts = [];
      const catGroups = {};
      catalogData.forEach(p => {
        const cat = pField(p, 'cat');
        if (!catGroups[cat]) catGroups[cat] = [];
        catGroups[cat].push(p);
      });
      const catNames = Object.keys(catGroups);
      let catIdx = 0;
      while (popularProducts.length < 12 && catIdx < catNames.length * 2) {
        const cat = catNames[catIdx % catNames.length];
        const items = catGroups[cat] || [];
        const pick = items[Math.floor(Math.random() * items.length)];
        if (pick && !usedIds.has(pField(pick, 'id'))) {
          popularProducts.push(pick);
          usedIds.add(pField(pick, 'id'));
        }
        catIdx++;
      }
      if (popularRow) popularRow.innerHTML = popularProducts.map(p => renderHCard(p)).join('');
      if (dropdownPopularList) dropdownPopularList.innerHTML = popularProducts.slice(0, 4).map(p => renderDropdownProductRow(p, '')).join('');

      // Recently Ordered from localStorage
      try {
        const recentOrders = JSON.parse(localStorage.getItem('bhusawal_recent_grocery') || '[]');
        if (recentOrders.length > 0) {
          const recentProducts = recentOrders.slice(0, 10).map(orderId => {
            return catalogData.find(p => pField(p, 'id') === orderId);
          }).filter(Boolean);
          if (recentProducts.length > 0) {
            recentSection?.classList.remove('hidden');
            if (recentRow) recentRow.innerHTML = recentProducts.map(p => renderHCard(p)).join('');
          }
        }
      } catch(e) {}

      // ==================== HIGH-PERFORMANCE MULTI-FIELD FILTER & LAZY LOAD ENGINE ====================
      const grid = document.getElementById('grocery-products-grid');
      const countLabel = document.getElementById('product-count-label');
      const titleLabel = document.getElementById('active-category-title');

      const brandSelect = document.getElementById('filter-brand-select');
      const priceSelect = document.getElementById('filter-price-select');
      const availabilitySelect = document.getElementById('filter-availability-select');
      const discountSelect = document.getElementById('filter-discount-select');
      const sortSelect = document.getElementById('sort-select');
      const resetFiltersBtn = document.getElementById('reset-all-filters-btn');

      const sentinel = document.getElementById('scroll-sentinel');
      const spinner = document.getElementById('loading-spinner');
      const endMsg = document.getElementById('end-of-catalog');
      const homeSections = document.getElementById('homepage-sections');

      let currentCatId = 'all';
      let currentCategory = 'All Products';
      let currentBrandFilter = 'All Brands';
      let currentPriceFilter = 'all';
      let currentAvailabilityFilter = 'all';
      let currentDiscountFilter = 'all';
      let currentSort = 'popular';
      let currentSearchQuery = '';

      let currentFiltered = [...catalogData];
      const BATCH = 20;
      let renderedCount = 0;
      let renderedIds = new Set();
      let isLoading = false;

      // OPTIMIZATION 6: O(1) PRE-INDEXED CATEGORY LOOKUP + COMPOSITE MEMORY FILTER
      function applyFilter() {
        const baseCategoryItems = categoryMap.get(currentCatId) || catalogData;
        const query = currentSearchQuery.trim().toLowerCase();
        const tokens = query ? query.split(/\s+/).filter(Boolean) : [];

        let res = baseCategoryItems.filter(p => {
          // 0. Search Query Filter (must match within selected category)
          if (tokens.length > 0) {
            const nameLower = String(pField(p, 'name') || '').toLowerCase();
            const brandLower = String(pField(p, 'brand') || '').toLowerCase();
            const catLower = String(pField(p, 'cat') || '').toLowerCase();
            const subcatLower = String(pField(p, 'subcat') || '').toLowerCase();
            const packLower = String(pField(p, 'pack') || pField(p, 'weight') || '').toLowerCase();
            const kwLower = String(pField(p, 'kw') || '').toLowerCase();
            const fullText = `${nameLower} ${brandLower} ${catLower} ${subcatLower} ${packLower} ${kwLower}`;

            const matches = tokens.every(t => fullText.includes(t));
            if (!matches) return false;
          }

          // 1. Brand filter
          if (currentBrandFilter !== 'All Brands') {
            const brand = (pField(p, 'brand')).toLowerCase();
            if (brand !== currentBrandFilter.toLowerCase()) return false;
          }

          // 2. Price filter
          let price = parseFloat(pField(p, 'sp'));
          if (!price || isNaN(price)) price = parseFloat(pField(p, 'mrp'));

          if (currentPriceFilter === 'under-50' && price >= 50) return false;
          if (currentPriceFilter === '50-100' && (price < 50 || price > 100)) return false;
          if (currentPriceFilter === '100-250' && (price < 100 || price > 250)) return false;
          if (currentPriceFilter === '250-500' && (price < 250 || price > 500)) return false;
          if (currentPriceFilter === 'above-500' && price <= 500) return false;

          // 3. Availability filter
          const stock = pField(p, 'stock');
          const isOutOfStock = stock === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
          if (currentAvailabilityFilter === 'instock' && isOutOfStock) return false;
          if (currentAvailabilityFilter === 'outofstock' && !isOutOfStock) return false;

          // 4. Discount filter
          const mrp = parseFloat(pField(p, 'mrp'));
          let disc = parseInt(pField(p, 'disc') || 0);
          if ((!disc || disc === 0) && mrp > price) {
            disc = Math.round(((mrp - price) / mrp) * 100);
          }
          if (currentDiscountFilter === 'discounted' && (disc <= 0 || mrp <= price)) return false;
          if (currentDiscountFilter === '10' && disc < 10) return false;
          if (currentDiscountFilter === '20' && disc < 20) return false;
          if (currentDiscountFilter === '30' && disc < 30) return false;

          return true;
        });

        // SORTING LOGIC
        if (currentSort === 'low-high') {
          res.sort((a, b) => parseFloat(pField(a, 'sp')) - parseFloat(pField(b, 'sp')));
        } else if (currentSort === 'high-low') {
          res.sort((a, b) => parseFloat(pField(b, 'sp')) - parseFloat(pField(a, 'sp')));
        } else if (currentSort === 'name') {
          res.sort((a, b) => pField(a, 'name').localeCompare(pField(b, 'name')));
        } else if (currentSort === 'newest' || currentSort === 'recent-added') {
          res.reverse();
        }

        currentFiltered = res;
        renderedCount = 0;
        renderedIds.clear();
        grid.innerHTML = '';
        endMsg?.classList.add('hidden');
        spinner?.classList.remove('hidden');

        // Check if reset button should be visible
        const isFilterActive = currentCatId !== 'all' || currentBrandFilter !== 'All Brands' || currentPriceFilter !== 'all' || currentAvailabilityFilter !== 'all' || currentDiscountFilter !== 'all';
        if (isFilterActive) resetFiltersBtn?.classList.remove('hidden');
        else resetFiltersBtn?.classList.add('hidden');

        loadBatch();
      }

      function loadBatch() {
        if (isLoading) return;

        if (!currentFiltered || currentFiltered.length === 0) {
          spinner?.classList.add('hidden');
          endMsg?.classList.add('hidden');
          if (grid) {
            grid.innerHTML = `<div class="col-span-full py-12 text-center bg-white rounded-3xl p-8 border border-slate-100 shadow-sm max-w-lg mx-auto">
              <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-3 text-3xl">🥦</div>
              <h3 class="text-base font-black text-slate-900">No products found.</h3>
              <p class="text-xs text-slate-500 mt-1">Try resetting your category or search filters.</p>
            </div>`;
          }
          return;
        }

        if (renderedCount >= currentFiltered.length) {
          spinner?.classList.add('hidden');
          endMsg?.classList.remove('hidden');
          return;
        }
        isLoading = true;

        const nextBatch = [];
        let index = renderedCount;
        while (nextBatch.length < BATCH && index < currentFiltered.length) {
          const item = currentFiltered[index];
          const id = pField(item, 'id');
          if (!renderedIds.has(id)) {
            renderedIds.add(id);
            nextBatch.push(item);
          }
          index++;
        }

        renderedCount = index;

        if (nextBatch.length > 0) {
          const html = nextBatch.map((p, i) => renderProductCard(p, i * 15)).join('');
          grid.insertAdjacentHTML('beforeend', html);
        }

        if (countLabel) {
          countLabel.textContent = `Showing ${renderedIds.size.toLocaleString()} of ${currentFiltered.length.toLocaleString()} Products`;
        }

        if (renderedCount >= currentFiltered.length || nextBatch.length === 0) {
          spinner?.classList.add('hidden');
          endMsg?.classList.remove('hidden');
        } else {
          spinner?.classList.remove('hidden');
          endMsg?.classList.add('hidden');
        }

        refreshVisibleButtons();
        isLoading = false;
      }

      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          if (!isLoading && renderedCount < currentFiltered.length) {
            loadBatch();
          } else if (renderedCount >= currentFiltered.length) {
            spinner?.classList.add('hidden');
            endMsg?.classList.remove('hidden');
          }
        }
      }, { rootMargin: '300px' });

      if (sentinel) observer.observe(sentinel);
      applyFilter();

      // Bind Filter Select Change Events
      brandSelect?.addEventListener('change', () => {
        currentBrandFilter = brandSelect.value;
        applyFilter();
      });

      priceSelect?.addEventListener('change', () => {
        currentPriceFilter = priceSelect.value;
        applyFilter();
      });

      availabilitySelect?.addEventListener('change', () => {
        currentAvailabilityFilter = availabilitySelect.value;
        applyFilter();
      });

      discountSelect?.addEventListener('change', () => {
        currentDiscountFilter = discountSelect.value;
        applyFilter();
      });

      sortSelect?.addEventListener('change', () => {
        currentSort = sortSelect.value;
        applyFilter();
      });

      resetFiltersBtn?.addEventListener('click', () => {
        currentCatId = 'all';
        currentCategory = 'All Products';
        currentBrandFilter = 'All Brands';
        currentPriceFilter = 'all';
        currentAvailabilityFilter = 'all';
        currentDiscountFilter = 'all';
        currentSort = 'popular';

        if (brandSelect) brandSelect.value = 'All Brands';
        if (priceSelect) priceSelect.value = 'all';
        if (availabilitySelect) availabilitySelect.value = 'all';
        if (discountSelect) discountSelect.value = 'all';
        if (sortSelect) sortSelect.value = 'popular';

        const catPills = document.querySelectorAll('.cat-pill');
        catPills.forEach((p, idx) => {
          if (idx === 0) {
            p.classList.add('bg-green-600', 'text-white', 'border-green-600', 'cat-pill-active', 'shadow-md', 'shadow-green-600/20');
            p.classList.remove('bg-white', 'text-slate-700', 'border-slate-200/90');
          } else {
            p.classList.remove('bg-green-600', 'text-white', 'border-green-600', 'cat-pill-active', 'shadow-md', 'shadow-green-600/20');
            p.classList.add('bg-white', 'text-slate-700', 'border-slate-200/90');
          }
        });

        if (titleLabel) titleLabel.innerHTML = `<span>🛒</span> All Products`;
        applyFilter();
      });

      // Category Pills Handler
      const catPills = document.querySelectorAll('.cat-pill');
      catPills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          catPills.forEach(p => {
            p.classList.remove('bg-green-600', 'text-white', 'border-green-600', 'cat-pill-active', 'shadow-md', 'shadow-green-600/20');
            p.classList.add('bg-white', 'text-slate-700', 'border-slate-200/90');
          });
          pill.classList.remove('bg-white', 'text-slate-700', 'border-slate-200/90');
          pill.classList.add('bg-green-600', 'text-white', 'border-green-600', 'cat-pill-active', 'shadow-md', 'shadow-green-600/20');

          currentCatId = pill.dataset.catId || 'all';
          currentCategory = pill.dataset.category || 'All Products';
          const icon = pill.querySelector('span')?.textContent || '🛒';
          
          if (titleLabel) titleLabel.innerHTML = `<span>${icon}</span> ${currentCategory}`;
          applyFilter();

          document.getElementById('all-products-anchor')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // ==================== ZEPTO INSTANT SEARCH LOGIC ====================
      const searchInput = document.getElementById('grocery-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const dropdown = document.getElementById('grocery-search-dropdown');
      const dropdownEmpty = document.getElementById('search-dropdown-empty');
      const dropdownResults = document.getElementById('search-dropdown-results');
      const dropdownShortcuts = document.getElementById('dropdown-shortcuts-box');
      const dropdownProductsPreview = document.getElementById('dropdown-products-preview');
      const seeAllBtn = document.getElementById('see-all-results-btn');

      const searchView = document.getElementById('search-results-view');
      const searchResultsGrid = document.getElementById('search-results-grid');
      const searchResultsCount = document.getElementById('search-results-count');
      const searchResultsQueryLabel = document.getElementById('search-results-query-label');
      const searchNoResults = document.getElementById('search-no-results');
      const searchNoResultsText = document.getElementById('search-no-results-text');
      const searchRelatedGrid = document.getElementById('search-related-grid');
      const backToHomeBtn = document.getElementById('back-to-home-btn');

      function executeInstantSearch(rawQuery) {
        const query = rawQuery.trim().toLowerCase();
        if (!query) return [];

        const baseCategoryItems = categoryMap.get(currentCatId) || catalogData;
        const tokens = query.split(/\s+/).filter(Boolean);

        const results = [];
        for (let i = 0; i < baseCategoryItems.length; i++) {
          const p = baseCategoryItems[i];
          const nameLower = String(pField(p, 'name') || '').toLowerCase();
          const brandLower = String(pField(p, 'brand') || '').toLowerCase();
          const catLower = String(pField(p, 'cat') || '').toLowerCase();
          const subcatLower = String(pField(p, 'subcat') || '').toLowerCase();
          const packLower = String(pField(p, 'pack') || pField(p, 'weight') || '').toLowerCase();
          const kwLower = String(pField(p, 'kw') || '').toLowerCase();
          const fullText = `${nameLower} ${brandLower} ${catLower} ${subcatLower} ${packLower} ${kwLower}`;

          let score = 0;
          if (nameLower === query) score += 100;
          else if (brandLower === query) score += 90;
          else if (subcatLower === query) score += 80;
          else if (catLower === query) score += 70;
          else if (nameLower.startsWith(query)) score += 60;
          else if (brandLower.startsWith(query)) score += 50;
          else {
            let matchesAll = true;
            for (let t = 0; t < tokens.length; t++) {
              if (!fullText.includes(tokens[t])) {
                matchesAll = false;
                break;
              }
            }
            if (matchesAll) score += 30;
          }

          if (score > 0) {
            results.push({ item: p, score });
          }
        }

        results.sort((a, b) => b.score - a.score);
        return results.map(r => r.item);
      }

      function onSearchInput() {
        const query = searchInput.value.trim();
        currentSearchQuery = query;

        if (query.length > 0) {
          clearBtn?.classList.remove('hidden');
          dropdown?.classList.remove('hidden');
          dropdownEmpty?.classList.add('hidden');
          dropdownResults?.classList.remove('hidden');

          const matches = executeInstantSearch(query);

          const matchedCats = [...new Set(matches.map(p => pField(p, 'cat')))].slice(0, 2);
          const matchedBrands = [...new Set(matches.map(p => pField(p, 'brand')))].slice(0, 3);

          let shortcutsHtml = '';
          matchedCats.forEach(c => {
            shortcutsHtml += `<button class="shortcut-chip px-2.5 py-1 bg-green-100 text-green-800 hover:bg-green-600 hover:text-white rounded-lg text-[11px] font-extrabold transition-all" data-type="cat" data-val="${c.replace(/"/g, '&quot;')}">📂 Category: ${c}</button>`;
          });
          matchedBrands.forEach(b => {
            shortcutsHtml += `<button class="shortcut-chip px-2.5 py-1 bg-amber-100 text-amber-900 hover:bg-amber-500 hover:text-white rounded-lg text-[11px] font-extrabold transition-all" data-type="brand" data-val="${b.replace(/"/g, '&quot;')}">🏷️ Brand: ${b}</button>`;
          });
          if (dropdownShortcuts) dropdownShortcuts.innerHTML = shortcutsHtml;

          const previewItems = matches.slice(0, 4);
          if (dropdownProductsPreview) {
            if (previewItems.length > 0) {
              dropdownProductsPreview.innerHTML = previewItems.map(p => renderDropdownProductRow(p, query)).join('');
            } else {
              dropdownProductsPreview.innerHTML = `<div class="p-3 text-center text-xs text-slate-400 font-bold">No products matching "${query}" in ${currentCategory}.</div>`;
            }
          }

          if (seeAllBtn) {
            seeAllBtn.innerHTML = `<span>View All ${matches.length} Results for "${query}"</span> <span class="material-symbols-outlined text-sm">arrow_forward</span>`;
          }
        } else {
          clearBtn?.classList.add('hidden');
          dropdownResults?.classList.add('hidden');
          dropdownEmpty?.classList.remove('hidden');
          renderRecentSearches();
        }
        applyFilter();
      }

      function showFullSearchResults(query) {
        if (!query || !query.trim()) return;
        const cleanQuery = query.trim();
        saveRecentSearch(cleanQuery);

        dropdown?.classList.add('hidden');
        homeSections?.classList.add('hidden');
        searchView?.classList.remove('hidden');

        if (searchResultsQueryLabel) searchResultsQueryLabel.textContent = `Showing results for "${cleanQuery}"`;

        const matches = executeInstantSearch(cleanQuery);

        if (matches.length > 0) {
          searchNoResults?.classList.add('hidden');
          searchResultsGrid.classList.remove('hidden');
          if (searchResultsCount) searchResultsCount.textContent = `${matches.length} Products Found`;
          searchResultsGrid.innerHTML = matches.slice(0, 100).map((p, i) => renderProductCard(p, i * 15)).join('');
          refreshVisibleButtons();
        } else {
          searchResultsGrid.classList.add('hidden');
          searchNoResults?.classList.remove('hidden');
          if (searchResultsCount) searchResultsCount.textContent = `0 Products Found`;
          if (searchNoResultsText) searchNoResultsText.textContent = `We couldn't find any direct matches for "${cleanQuery}" in Bhusawal stores.`;

          const related = popularProducts.length > 0 ? popularProducts : catalogData.slice(0, 10);
          if (searchRelatedGrid) {
            searchRelatedGrid.innerHTML = related.map((p, i) => renderProductCard(p, i * 20)).join('');
          }
          refreshVisibleButtons();
        }
      }

      searchInput?.addEventListener('focus', () => {
        dropdown?.classList.remove('hidden');
        renderRecentSearches();
        onSearchInput();
      });

      searchInput?.addEventListener('input', () => {
        onSearchInput();
      });

      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const q = searchInput.value.trim();
          if (q) showFullSearchResults(q);
        } else if (e.key === 'Escape') {
          dropdown?.classList.add('hidden');
        }
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        currentSearchQuery = '';
        clearBtn?.classList.add('hidden');
        dropdownResults?.classList.add('hidden');
        dropdownEmpty?.classList.remove('hidden');
        dropdown?.classList.add('hidden');
        homeSections?.classList.remove('hidden');
        searchView?.classList.add('hidden');
        renderRecentSearches();
        applyFilter();
      });

      backToHomeBtn?.addEventListener('click', () => {
        searchInput.value = '';
        currentSearchQuery = '';
        clearBtn?.classList.add('hidden');
        dropdown?.classList.add('hidden');
        homeSections?.classList.remove('hidden');
        searchView?.classList.add('hidden');
        applyFilter();
      });

      seeAllBtn?.addEventListener('click', () => {
        const q = searchInput.value.trim();
        if (q) showFullSearchResults(q);
      });

      document.getElementById('clear-recent-searches')?.addEventListener('click', (e) => {
        e.stopPropagation();
        clearRecentSearches();
      });

      document.body.addEventListener('click', (e) => {
        const trendingTag = e.target.closest('.trending-tag');
        if (trendingTag) {
          const q = trendingTag.dataset.query;
          if (searchInput) searchInput.value = q;
          showFullSearchResults(q);
          return;
        }

        const recentTag = e.target.closest('.recent-tag');
        if (recentTag) {
          const q = recentTag.dataset.query;
          if (searchInput) searchInput.value = q;
          showFullSearchResults(q);
          return;
        }

        const shortcutChip = e.target.closest('.shortcut-chip');
        if (shortcutChip) {
          const val = shortcutChip.dataset.val;
          if (searchInput) searchInput.value = val;
          showFullSearchResults(val);
          return;
        }

        const selectRow = e.target.closest('.select-product-row');
        if (selectRow) {
          const q = selectRow.dataset.query;
          if (searchInput) searchInput.value = q;
          showFullSearchResults(q);
          return;
        }

        if (!e.target.closest('#grocery-search-input') && !e.target.closest('#grocery-search-dropdown')) {
          dropdown?.classList.add('hidden');
        }
      });

      
      document.body.addEventListener('click', (e) => {
        const actionBtn = e.target.closest('.add-btn, .qty-btn, .wishlist-btn, a, button');
        if (actionBtn && !actionBtn.classList.contains('product-card-v2')) {
          return;
        }

        const card = e.target.closest('[data-product-id]');
        if (card) {
          const pId = card.dataset.productId;
          if (pId) {
            window.location.href = `/product/${encodeURIComponent(pId)}`;
          }
        }
      });

      updateCartBar();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGroceryPage);
    } else {
      initGroceryPage();
    }
  </script>
</body>
</html>
