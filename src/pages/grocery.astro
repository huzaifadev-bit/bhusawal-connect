---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read organized catalog database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read grocery catalog at build time", err);
}

// Extract distinct categories from catalog
const categoriesList = [
  { id: 'all', name: 'All Products', icon: '⚡' },
  { id: 'fruits_veg', name: 'Fresh Fruits & Vegetables', icon: '🥬' },
  { id: 'atta_rice', name: 'Atta, Rice & Dal', icon: '🌾' },
  { id: 'oil_ghee', name: 'Oil, Ghee & Masala', icon: '🛢️' },
  { id: 'dairy', name: 'Dairy & Breakfast', icon: '🥛' },
  { id: 'beverages', name: 'Tea, Coffee & Beverages', icon: '🥤' },
  { id: 'juices', name: 'Juices, Soft Drinks & Water', icon: '🍹' },
  { id: 'chocolates', name: 'Chocolates & Candies', icon: '🍫' },
  { id: 'snacks', name: 'Chips, Snacks & Namkeen', icon: '🍿' },
  { id: 'biscuits', name: 'Biscuits & Cookies', icon: '🍞' },
  { id: 'noodles', name: 'Noodles & Pasta', icon: '🍜' },
  { id: 'personal', name: 'Personal Care', icon: '✨' },
  { id: 'home', name: 'Home Cleaning', icon: '🧹' },
  { id: 'laundry', name: 'Laundry', icon: '🧺' },
];

// Initial 48 items for server-rendering
const initialProducts = catalog.slice(0, 48);
---

<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Grocery Superstore</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-24 max-w-7xl mx-auto min-h-screen text-slate-800">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3 shadow-sm flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="px-2 py-0.5 rounded-md bg-purple-100 text-purpleBrand text-[10px] font-black uppercase tracking-wider">⚡ 10 MINS</span>
          <h1 class="text-base font-black font-display text-slate-900 leading-tight">Grocery Superstore</h1>
        </div>
        <p class="text-[11px] text-slate-500 font-bold truncate max-w-[200px] sm:max-w-xs" id="delivery-addr-header">
          Delivering to Bhusawal
        </p>
      </div>
    </div>

    <a href="/billing" class="relative w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold hover:bg-purple-200 transition-colors">
      <span class="material-symbols-outlined text-xl">shopping_bag</span>
      <span id="cart-badge-header" class="absolute -top-1 -right-1 bg-purpleBrand text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
    </a>
  </header>

  <!-- STICKY SEARCH & FILTER BAR -->
  <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 shadow-sm space-y-3">
    
    <div class="flex items-center gap-2 bg-slate-100 rounded-2xl px-4 py-2.5 border border-slate-200/80 focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:bg-white transition-all">
      <span class="material-symbols-outlined text-slate-400">search</span>
      <input type="text" id="grocery-search-input" placeholder="Search 23,000+ groceries, snacks, milk, fruits..." class="w-full bg-transparent outline-none text-sm font-medium text-slate-800 placeholder-slate-400" autocomplete="off" />
      <button id="clear-search-btn" class="hidden text-slate-400 hover:text-slate-600">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>

    <!-- Filter Pills & Sorting -->
    <div class="flex items-center justify-between gap-2 overflow-x-auto no-scrollbar pt-1">
      <div class="flex items-center gap-2">
        <button class="diet-filter-btn px-3 py-1.5 rounded-xl bg-purpleBrand text-white text-xs font-black shadow-sm transition-all" data-filter="all">All</button>
        <button class="diet-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold transition-all" data-filter="deals">⚡ Offers & Discounts</button>
      </div>

      <select id="sort-select" class="bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold rounded-xl px-2.5 py-1.5 outline-none cursor-pointer">
        <option value="popular">Popularity</option>
        <option value="low-high">Price: Low to High</option>
        <option value="high-low">Price: High to Low</option>
        <option value="discount">Highest Discount</option>
      </select>
    </div>

  </div>

  <!-- FEATURED PROMO BANNER -->
  <div class="px-4 pt-4">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-700 via-purple-600 to-indigo-700 text-white p-5 shadow-lg shadow-purple-900/10">
      <div class="relative z-10">
        <span class="px-2.5 py-0.5 bg-amber-400 text-slate-900 text-[10px] font-black uppercase tracking-wider rounded-full inline-block mb-2">BHUSAWAL CONNECT CATALOG</span>
        <h2 class="text-xl font-black font-display leading-tight">23,043 Products Organized into Categories</h2>
        <p class="text-xs text-purple-100 mt-1">Fresh Fruits, Atta & Rice, Ghee, Dairy, Beverages, Snacks & Cleaning</p>
      </div>
    </div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="px-4 py-4 md:flex md:gap-6">
    
    <!-- Mobile Categories Horizontal Bar -->
    <div class="md:hidden flex gap-2 overflow-x-auto no-scrollbar pb-3 mb-2 border-b border-slate-100">
      {categoriesList.map(cat => (
        <button class="mobile-cat-btn flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-2xl bg-white border border-slate-200 text-xs font-extrabold text-slate-700 hover:border-purpleBrand transition-all" data-category={cat.name}>
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </button>
      ))}
    </div>

    <!-- Desktop Sidebar Categories -->
    <aside class="hidden md:block w-64 flex-shrink-0 space-y-2 sticky top-44 h-fit">
      <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider px-3 mb-2">Categories</h3>
      <div class="bg-white rounded-3xl p-2 border border-slate-100 shadow-sm space-y-1 max-h-[75vh] overflow-y-auto no-scrollbar">
        {categoriesList.map(cat => (
          <button class="desktop-cat-btn w-full flex items-center justify-between px-3 py-2.5 rounded-2xl text-xs font-extrabold text-slate-700 hover:bg-purple-50 hover:text-purpleBrand transition-all" data-category={cat.name}>
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-base flex-shrink-0">{cat.icon}</span>
              <span class="truncate">{cat.name}</span>
            </div>
            <span class="material-symbols-outlined text-sm text-slate-300 flex-shrink-0">chevron_right</span>
          </button>
        ))}
      </div>
    </aside>

    <!-- Product Grid Section -->
    <main class="flex-1 space-y-4">
      <div class="flex items-center justify-between">
        <h2 id="active-category-title" class="text-lg font-black font-display text-slate-900">All Products</h2>
        <span id="product-count-label" class="text-xs font-bold text-slate-400">Total 23,043 Products</span>
      </div>

      <!-- Products Grid -->
      <div id="grocery-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {initialProducts.map(p => {
          const id = p.ProductID || p.id || '';
          const name = p["Product Name"] || '';
          const cat = p.Category || 'Grocery';
          const pack = p["Weight/Variant"] || p["Pack Size"] || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || 0);
          const price = parseFloat(p["Selling Price"] || p["Offer Price"] || mrp);
          const img = p["Product Image URL"] || p["Product Image"] || p["Image URL"] || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const discountPct = p["Discount %"] || (mrp > price ? Math.round(((mrp - price) / mrp) * 100) : 0);

          return (
            <div class="product-card bg-white rounded-2xl border border-slate-100 p-3 shadow-sm hover:shadow-md transition-shadow relative flex flex-col justify-between group cursor-pointer" data-id={id} data-name={name} data-price={price} data-mrp={mrp} data-img={img} data-unit={pack} data-cat={cat} data-desc={p["Product Description"] || p.Description || ''}>
              
              {discountPct > 0 && (
                <span class="absolute top-2.5 left-2.5 bg-purpleBrand text-white text-[9px] font-black px-1.5 py-0.5 rounded-full z-10 shadow-sm">
                  {discountPct}% OFF
                </span>
              )}

              <div class="h-32 w-full flex items-center justify-center mb-2 overflow-hidden rounded-xl bg-slate-50 relative group-hover:scale-105 transition-transform duration-300">
                <img src={img} alt={name} class="max-h-full max-w-full object-contain p-2" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              </div>

              <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider truncate">{cat}</p>
                <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 h-8 leading-tight mb-1">{name}</h4>
                <p class="text-[10px] text-slate-500 font-bold mb-2">{pack}</p>
                
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-xs font-black text-slate-900">₹{price}</span>
                    {mrp > price && (
                      <span class="text-[10px] text-slate-400 line-through ml-1">₹{mrp}</span>
                    )}
                  </div>
                  <button class="add-to-cart-btn px-3 py-1 bg-purpleBrand text-white text-xs font-black rounded-lg shadow-sm hover:bg-purpleDark active:scale-95 transition-all" data-id={id} data-name={name} data-price={price} data-img={img}>
                    ADD
                  </button>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </main>

  </div>

  <!-- FLOATING CART BAR -->
  <div id="floating-cart-bar" class="hidden fixed bottom-6 left-4 right-4 max-w-xl mx-auto bg-purpleBrand text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between z-50">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center font-black text-sm" id="cart-count-badge">
        0
      </div>
      <div>
        <p class="text-xs font-black text-white" id="cart-total-text">₹0</p>
        <p class="text-[10px] text-purple-200">View items in cart</p>
      </div>
    </div>
    <a href="/billing" class="bg-white text-purpleBrand font-extrabold text-xs px-5 py-2.5 rounded-xl flex items-center gap-1.5 shadow-md hover:bg-purple-50 active:scale-95 transition-all">
      <span>Proceed to Checkout</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <!-- PRODUCT DETAIL MODAL -->
  <div id="product-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto relative animate-in fade-in slide-in-from-bottom-4">
      <button id="close-modal-btn" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
        <span class="material-symbols-outlined">close</span>
      </button>

      <div class="h-56 w-full bg-slate-50 rounded-2xl flex items-center justify-center p-4">
        <img id="modal-img" src="" alt="" class="max-h-full max-w-full object-contain" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
      </div>

      <div>
        <span id="modal-cat" class="text-xs font-black text-purpleBrand uppercase tracking-wider">Category</span>
        <h3 id="modal-title" class="text-lg font-black font-display text-slate-900 mt-1">Product Title</h3>
        <p id="modal-unit" class="text-xs font-bold text-slate-500 mt-0.5">Unit Size</p>
        <p id="modal-desc" class="text-xs text-slate-600 mt-2 leading-relaxed">Description</p>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100">
        <div>
          <span class="text-xl font-black text-slate-900" id="modal-price">₹0</span>
          <span class="text-sm text-slate-400 line-through ml-2" id="modal-mrp">₹0</span>
        </div>
        <button id="modal-add-btn" class="px-6 py-2.5 bg-purpleBrand text-white font-extrabold text-sm rounded-xl shadow-md hover:bg-purpleDark active:scale-95 transition-all">
          ADD TO CART
        </button>
      </div>
    </div>
  </div>

  <Switcher />

  <!-- CLIENT-SIDE CATALOG ENGINE FOR 23,043 ORGANIZED ITEMS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      let catalogData = [];
      try {
        const res = await fetch('/grocery_catalog.json');
        catalogData = await res.json();
        console.log("Loaded organized catalog items count:", catalogData.length);
      } catch(e) {
        console.error("Failed to load organized grocery catalog", e);
      }

      // 1. Cart Bar State
      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const headerBadge = document.getElementById('cart-badge-header');
          const totalText = document.getElementById('cart-total-text');

          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

          if (countBadge) countBadge.textContent = totalQty;
          if (headerBadge) headerBadge.textContent = totalQty;
          if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);

          if (cart.length > 0) {
            bar?.classList.remove('hidden');
          } else {
            bar?.classList.add('hidden');
          }
        } catch(e) {}
      }

      updateCartBar();

      // 2. Add to Cart Handler
      function attachAddToCartListeners() {
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = btn.dataset.price;
            const img = btn.dataset.img;

            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name, price, image: img, quantity: 1 });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();

            btn.textContent = 'ADDED!';
            btn.classList.replace('bg-purpleBrand', 'bg-emerald-600');
            setTimeout(() => {
              btn.textContent = 'ADD';
              btn.classList.replace('bg-emerald-600', 'bg-purpleBrand');
            }, 1200);
          };
        });
      }
      attachAddToCartListeners();

      // 3. Product Detail Modal
      const modal = document.getElementById('product-modal');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalCat = document.getElementById('modal-cat');
      const modalUnit = document.getElementById('modal-unit');
      const modalDesc = document.getElementById('modal-desc');
      const modalPrice = document.getElementById('modal-price');
      const modalMrp = document.getElementById('modal-mrp');
      const modalAddBtn = document.getElementById('modal-add-btn');

      function attachModalClickListeners() {
        document.querySelectorAll('.product-card').forEach(card => {
          card.onclick = () => {
            modalImg.src = card.dataset.img;
            modalTitle.textContent = card.dataset.name;
            modalCat.textContent = card.dataset.cat || 'Grocery';
            modalUnit.textContent = card.dataset.unit || '1 Pack';
            modalDesc.textContent = card.dataset.desc || '';
            modalPrice.textContent = '₹' + card.dataset.price;
            modalMrp.textContent = parseFloat(card.dataset.mrp) > parseFloat(card.dataset.price) ? '₹' + card.dataset.mrp : '';

            modalAddBtn.onclick = () => {
              let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
              const id = card.dataset.id;
              const existing = cart.find(i => i.id === id);
              if (existing) {
                existing.quantity = (existing.quantity || 1) + 1;
              } else {
                cart.push({ id, name: card.dataset.name, price: card.dataset.price, image: card.dataset.img, quantity: 1 });
              }
              localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
              updateCartBar();
              modal.classList.add('hidden');
            };

            modal.classList.remove('hidden');
          };
        });
      }
      attachModalClickListeners();

      document.getElementById('close-modal-btn')?.addEventListener('click', () => {
        modal.classList.add('hidden');
      });

      // 4. Client Search & Filtering over 23,043 Items
      const searchInput = document.getElementById('grocery-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const grid = document.getElementById('grocery-products-grid');
      const countLabel = document.getElementById('product-count-label');
      const titleLabel = document.getElementById('active-category-title');

      let currentQuery = '';
      let currentCategory = 'all';
      let currentFilter = 'all';

      function renderProducts(filtered) {
        if (filtered.length === 0) {
          grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 font-bold">No products found matching your search.</div>`;
          countLabel.textContent = '0 Items';
          return;
        }

        countLabel.textContent = `Showing ${filtered.length} of ${catalogData.length} Products`;
        grid.innerHTML = filtered.map(p => {
          const id = p.ProductID || p.id || '';
          const name = p["Product Name"] || '';
          const cat = p.Category || 'Grocery';
          const pack = p["Weight/Variant"] || p["Pack Size"] || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || 0);
          const price = parseFloat(p["Selling Price"] || p["Offer Price"] || mrp);
          const img = p["Product Image URL"] || p["Product Image"] || p["Image URL"] || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const discountPct = p["Discount %"] || (mrp > price ? Math.round(((mrp - price) / mrp) * 100) : 0);

          return `
            <div class="product-card bg-white rounded-2xl border border-slate-100 p-3 shadow-sm hover:shadow-md transition-shadow relative flex flex-col justify-between group cursor-pointer" data-id="${id}" data-name="${name}" data-price="${price}" data-mrp="${mrp}" data-img="${img}" data-unit="${pack}" data-cat="${cat}" data-desc="${(p["Product Description"] || p.Description || '').replace(/"/g, '&quot;')}">
              ${discountPct > 0 ? `<span class="absolute top-2.5 left-2.5 bg-purpleBrand text-white text-[9px] font-black px-1.5 py-0.5 rounded-full z-10 shadow-sm">${discountPct}% OFF</span>` : ''}
              <div class="h-32 w-full flex items-center justify-center mb-2 overflow-hidden rounded-xl bg-slate-50 relative group-hover:scale-105 transition-transform duration-300">
                <img src="${img}" alt="${name}" class="max-h-full max-w-full object-contain p-2" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              </div>
              <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider truncate">${cat}</p>
                <h4 class="text-xs font-extrabold text-slate-800 line-clamp-2 h-8 leading-tight mb-1">${name}</h4>
                <p class="text-[10px] text-slate-500 font-bold mb-2">${pack}</p>
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-xs font-black text-slate-900">₹${price}</span>
                    ${mrp > price ? `<span class="text-[10px] text-slate-400 line-through ml-1">₹${mrp}</span>` : ''}
                  </div>
                  <button class="add-to-cart-btn px-3 py-1 bg-purpleBrand text-white text-xs font-black rounded-lg shadow-sm hover:bg-purpleDark active:scale-95 transition-all" data-id="${id}" data-name="${name}" data-price="${price}" data-img="${img}">ADD</button>
                </div>
              </div>
            </div>
          `;
        }).join('');

        attachAddToCartListeners();
        attachModalClickListeners();
      }

      function filterCatalog() {
        if (catalogData.length === 0) return;

        let res = catalogData;

        // Search Query over Product Name, Category, Brand, Search Keywords
        if (currentQuery) {
          res = res.filter(p => {
            const name = (p["Product Name"] || '').toLowerCase();
            const cat = (p.Category || '').toLowerCase();
            const brand = (p.Brand || '').toLowerCase();
            const kw = (p["Search Keywords"] || '').toLowerCase();
            return name.includes(currentQuery) || cat.includes(currentQuery) || brand.includes(currentQuery) || kw.includes(currentQuery);
          });
        }

        // Category Filter
        if (currentCategory !== 'all') {
          res = res.filter(p => (p.Category || '').toLowerCase().includes(currentCategory.toLowerCase()));
        }

        // Offers Filter
        if (currentFilter === 'deals') {
          res = res.filter(p => parseFloat(p.MRP || 0) > parseFloat(p["Selling Price"] || p["Offer Price"] || p.MRP || 0));
        }

        renderProducts(res.slice(0, 80));
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        if (currentQuery) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
        filterCatalog();
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        clearBtn.classList.add('hidden');
        filterCatalog();
      });

      // Category Click Handlers
      document.querySelectorAll('.desktop-cat-btn, .mobile-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.category || 'all';
          titleLabel.textContent = currentCategory === 'all' ? 'All Products' : currentCategory;
          filterCatalog();
        });
      });

      // Filter Buttons
      document.querySelectorAll('.diet-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.diet-filter-btn').forEach(b => {
            b.classList.replace('bg-purpleBrand', 'bg-slate-100');
            b.classList.replace('text-white', 'text-slate-700');
          });
          btn.classList.replace('bg-slate-100', 'bg-purpleBrand');
          btn.classList.replace('text-slate-700', 'text-white');

          currentFilter = btn.dataset.filter || 'all';
          filterCatalog();
        });
      });

      // URL Search Param Auto-fill
      const urlParams = new URLSearchParams(window.location.search);
      const searchParam = urlParams.get('search');
      const catParam = urlParams.get('category');
      if (searchParam && searchInput) {
        searchInput.value = searchParam;
        currentQuery = searchParam.toLowerCase();
        clearBtn.classList.remove('hidden');
      }
      if (catParam) {
        currentCategory = catParam;
        titleLabel.textContent = catParam;
      }
      if (searchParam || catParam) {
        setTimeout(filterCatalog, 300);
      }
    });
  </script>
</body>
</html>
