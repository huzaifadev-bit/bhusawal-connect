---
import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read restored original database at build-time
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
  catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
  console.error("Failed to read grocery catalog at build time", err);
}

// Extract distinct categories from master catalog
const categoriesList = [
  { id: 'all', name: 'All Products', icon: '⚡' },
  { id: 'fruits', name: 'Fruits & Vegetables', icon: '🥬' },
  { id: 'dairy', name: 'Dairy & Breakfast', icon: '🥛' },
  { id: 'staples', name: 'Grocery Staples', icon: '🌾' },
  { id: 'snacks', name: 'Snacks & Confectionery', icon: '🍿' },
  { id: 'beverages', name: 'Beverages', icon: '🥤' },
  { id: 'personal', name: 'Personal Care', icon: '✨' },
  { id: 'home', name: 'Home Cleaning & Household', icon: '🧹' },
  { id: 'instant', name: 'Instant & Frozen Foods', icon: '🍜' },
  { id: 'baby', name: 'Baby, Health & Specialty', icon: '👶' },
];

// Initial 48 items for server-rendering
const initialProducts = catalog.slice(0, 48);
---

<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhusawal Connect | Grocery Superstore</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-24 max-w-7xl mx-auto min-h-screen text-slate-800">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3 shadow-sm flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="px-2 py-0.5 rounded-md bg-purple-100 text-purpleBrand text-[10px] font-black uppercase tracking-wider">⚡ 10 MINS</span>
          <h1 class="text-base font-black font-display text-slate-900 leading-tight">Grocery Superstore</h1>
        </div>
        <p class="text-[11px] text-slate-500 font-bold truncate max-w-[200px] sm:max-w-xs" id="delivery-addr-header">
          Delivering to Bhusawal
        </p>
      </div>
    </div>

    <a href="/billing" class="relative w-10 h-10 rounded-full bg-purple-100 text-purpleBrand flex items-center justify-center font-bold hover:bg-purple-200 transition-colors">
      <span class="material-symbols-outlined text-xl">shopping_bag</span>
      <span id="cart-badge-header" class="absolute -top-1 -right-1 bg-purpleBrand text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
    </a>
  </header>

  <!-- STICKY SEARCH & FILTER BAR -->
  <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md px-4 py-3 border-b border-slate-100 shadow-sm space-y-3">
    
    <div class="flex items-center gap-2 bg-slate-100 rounded-2xl px-4 py-2.5 border border-slate-200/80 focus-within:ring-2 focus-within:ring-purpleBrand/40 focus-within:bg-white transition-all">
      <span class="material-symbols-outlined text-slate-400">search</span>
      <input type="text" id="grocery-search-input" placeholder="Search 5,000+ items across all categories..." class="w-full bg-transparent outline-none text-sm font-medium text-slate-800 placeholder-slate-400" autocomplete="off" />
      <button id="clear-search-btn" class="hidden text-slate-400 hover:text-slate-600">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>

    <!-- Filter Pills & Sorting -->
    <div class="flex items-center justify-between gap-2 overflow-x-auto no-scrollbar pt-1">
      <div class="flex items-center gap-2">
        <button class="diet-filter-btn px-3 py-1.5 rounded-xl bg-purpleBrand text-white text-xs font-black shadow-sm transition-all" data-filter="all">All</button>
        <button class="diet-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-bold transition-all" data-filter="deals">⚡ Offers & Discounts</button>
      </div>

      <select id="sort-select" class="bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold rounded-xl px-2.5 py-1.5 outline-none cursor-pointer">
        <option value="popular">Popularity</option>
        <option value="low-high">Price: Low to High</option>
        <option value="high-low">Price: High to Low</option>
        <option value="discount">Highest Discount</option>
      </select>
    </div>

  </div>

  <!-- FEATURED PROMO BANNER -->
  <div class="px-4 pt-4">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-700 via-purple-600 to-indigo-700 text-white p-5 shadow-lg shadow-purple-900/10">
      <div class="relative z-10">
        <span class="px-2.5 py-0.5 bg-amber-400 text-slate-900 text-[10px] font-black uppercase tracking-wider rounded-full inline-block mb-2">BHUSAWAL EXPRESS</span>
        <h2 class="text-xl font-black font-display leading-tight">5,050+ Original Products Live</h2>
        <p class="text-xs text-purple-100 mt-1">Personal Care, Spices, Dairy, Snacks & Household Essentials</p>
      </div>
    </div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="px-4 py-4 md:flex md:gap-6">
    
    <!-- Mobile Categories Horizontal Bar -->
    <div class="md:hidden flex gap-2 overflow-x-auto no-scrollbar pb-3 mb-2 border-b border-slate-100">
      {categoriesList.map(cat => (
        <button class="mobile-cat-btn flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-2xl bg-white border border-slate-200 text-xs font-extrabold text-slate-700 hover:border-purpleBrand transition-all" data-category={cat.name}>
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </button>
      ))}
    </div>

    <!-- Desktop Sidebar Categories -->
    <aside class="hidden md:block w-64 flex-shrink-0 space-y-2 sticky top-44 h-fit">
      <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider px-3 mb-2">Categories</h3>
      <div class="bg-white rounded-3xl p-2 border border-slate-100 shadow-sm space-y-1">
        {categoriesList.map(cat => (
          <button class="desktop-cat-btn w-full flex items-center justify-between px-3 py-2.5 rounded-2xl text-xs font-extrabold text-slate-700 hover:bg-purple-50 hover:text-purpleBrand transition-all" data-category={cat.name}>
            <div class="flex items-center gap-2">
              <span class="text-base">{cat.icon}</span>
              <span>{cat.name}</span>
            </div>
            <span class="material-symbols-outlined text-sm text-slate-300">chevron_right</span>
          </button>
        ))}
      </div>
    </aside>

    <!-- Product Grid Section -->
    <main class="flex-1 space-y-4">
      <div class="flex items-center justify-between">
        <h2 id="active-category-title" class="text-lg font-black font-display text-slate-900">All Products</h2>
        <span id="product-count-label" class="text-xs font-bold text-slate-400">Loading Products...</span>
      </div>

      <!-- Products Grid -->
      <div id="grocery-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4.5">
        {initialProducts.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id || '';
          const name = p["Product Name"] || '';
          const brand = p["Brand Name"] || p.brand || 'Bhusawal Fresh';
          const cat = p.Category || 'Grocery';
          const pack = p["Pack Size"] || p.pack || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || p.mrp || 0);
          const price = parseFloat(p["Selling Price"] || p.sp || mrp);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const hasDiscount = mrp > price;
          const discountPct = hasDiscount ? Math.round(((mrp - price) / mrp) * 100) : 0;
          const isOutOfStock = p.stock === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
          const descSafe = (p.desc || p.Description || '').replace(/"/g, '&quot;');
          const nameSafe = name.replace(/"/g, '&quot;');

          return (
            <div class="product-card group bg-white rounded-[20px] border border-slate-100/90 shadow-sm hover:shadow-xl hover:border-purple-200/80 transition-all duration-300 relative flex flex-col overflow-hidden cursor-pointer p-2.5 sm:p-3" data-id={id} data-name={name} data-price={price} data-mrp={mrp} data-img={img} data-unit={pack} data-cat={cat} data-brand={brand} data-desc={descSafe}>

              {/* IMAGE CONTAINER WITH GRADIENT BACKGROUND */}
              <div class="relative w-full h-36 sm:h-44 bg-gradient-to-b from-slate-50/90 via-slate-50/40 to-white rounded-2xl flex items-center justify-center p-3 overflow-hidden mb-2">
                
                {/* Discount Badge */}
                {hasDiscount && discountPct > 0 && (
                  <span class="absolute top-2 left-2 z-10 bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-[10px] sm:text-[11px] font-black px-2 py-0.5 rounded-lg shadow-sm flex items-center gap-0.5 tracking-tight">
                    {discountPct}% OFF
                  </span>
                )}

                {/* Out of Stock Overlay */}
                {isOutOfStock && (
                  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-20 flex items-center justify-center">
                    <span class="bg-slate-900 text-white text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-md border border-slate-700">Out of Stock</span>
                  </div>
                )}

                {/* Favourite Heart */}
                <button class="fav-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md border border-slate-200/80 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all duration-200 z-10 shadow-sm" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                  <span class="material-symbols-outlined text-[19px]" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
                </button>

                {/* Large Product Image */}
                <img src={img} alt={name} class="max-h-full max-w-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300 ease-out" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />

                {/* Fast Delivery Badge */}
                <div class="absolute bottom-2 left-2 z-10">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-400/95 backdrop-blur-sm text-slate-950 text-[9px] font-black rounded-md uppercase tracking-wider shadow-xs">
                    <span class="material-symbols-outlined text-[11px]">bolt</span>
                    10 MINS
                  </span>
                </div>
              </div>

              {/* DETAILS */}
              <div class="flex flex-col flex-1 px-1 pt-0.5 pb-1">
                {/* Brand Name */}
                <span class="text-[10px] font-extrabold text-purpleBrand uppercase tracking-wider truncate mb-0.5">{brand}</span>

                {/* Product Name */}
                <h3 class="text-xs sm:text-[13px] font-bold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem] group-hover:text-purpleBrand transition-colors">{name}</h3>

                {/* Pack Size / Variant */}
                <p class="text-[11px] font-semibold text-slate-500 mb-2">{pack}</p>

                {/* Price + Action */}
                <div class="flex items-center justify-between gap-2 mt-auto pt-1.5 border-t border-slate-100">
                  <div class="flex flex-col">
                    <div class="flex items-baseline gap-1">
                      <span class="text-sm sm:text-base font-black text-slate-900 leading-none">₹{price}</span>
                      {hasDiscount && (
                        <span class="text-[10px] sm:text-[11px] font-bold text-slate-400 line-through leading-none">₹{mrp}</span>
                      )}
                    </div>
                    {hasDiscount && (
                      <span class="text-[9px] font-extrabold text-emerald-600 mt-0.5">Save ₹{mrp - price}</span>
                    )}
                  </div>

                  {isOutOfStock ? (
                    <button disabled class="px-3 py-1.5 bg-slate-100 text-slate-400 text-[11px] font-extrabold rounded-xl border border-slate-200 cursor-not-allowed">UNAVAILABLE</button>
                  ) : (
                    <div class="cart-action-container" data-id={id} data-name={nameSafe} data-price={price} data-img={img}>
                      <button class="add-to-cart-btn px-4 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 hover:border-purpleBrand text-[11px] font-black rounded-xl shadow-xs hover:shadow-md active:scale-95 transition-all duration-200" data-id={id} data-name={nameSafe} data-price={price} data-img={img}>
                        ADD
                      </button>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- LOAD MORE & PAGINATION CONTAINER -->
      <div id="load-more-container" class="py-8 text-center space-y-3">
        <button id="load-more-btn" class="px-8 py-3 bg-purpleBrand text-white font-extrabold text-xs rounded-2xl shadow-lg hover:bg-purpleDark active:scale-95 transition-all">
          Load More Products
        </button>
        <p id="pagination-status-text" class="text-xs font-bold text-slate-400"></p>
      </div>
    </main>
  </div>

  <!-- FLOATING CART BAR -->
  <div id="floating-cart-bar" class="hidden fixed bottom-6 left-4 right-4 max-w-xl mx-auto bg-purpleBrand text-white p-3.5 rounded-2xl shadow-2xl flex items-center justify-between z-50">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center font-black text-sm" id="cart-count-badge">
        0
      </div>
      <div>
        <p class="text-xs font-black text-white" id="cart-total-text">₹0</p>
        <p class="text-[10px] text-purple-200">View items in cart</p>
      </div>
    </div>
    <a href="/billing" class="bg-white text-purpleBrand font-extrabold text-xs px-5 py-2.5 rounded-xl flex items-center gap-1.5 shadow-md hover:bg-purple-50 active:scale-95 transition-all">
      <span>Proceed to Checkout</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <!-- PRODUCT DETAIL MODAL -->
  <div id="product-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto relative animate-in fade-in slide-in-from-bottom-4">
      <button id="close-modal-btn" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
        <span class="material-symbols-outlined">close</span>
      </button>

      <div class="h-56 w-full bg-slate-50 rounded-2xl flex items-center justify-center p-4">
        <img id="modal-img" src="" alt="" class="max-h-full max-w-full object-contain" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
      </div>

      <div>
        <span id="modal-cat" class="text-xs font-black text-purpleBrand uppercase tracking-wider">Category</span>
        <h3 id="modal-title" class="text-lg font-black font-display text-slate-900 mt-1">Product Title</h3>
        <p id="modal-unit" class="text-xs font-bold text-slate-500 mt-0.5">Unit Size</p>
        <p id="modal-desc" class="text-xs text-slate-600 mt-2 leading-relaxed">Description</p>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100">
        <div>
          <span class="text-xl font-black text-slate-900" id="modal-price">₹0</span>
          <span class="text-sm text-slate-400 line-through ml-2" id="modal-mrp">₹0</span>
        </div>
        <button id="modal-add-btn" class="px-6 py-2.5 bg-purpleBrand text-white font-extrabold text-sm rounded-xl shadow-md hover:bg-purpleDark active:scale-95 transition-all">
          ADD TO CART
        </button>
      </div>
    </div>
  </div>

  <Switcher />

  <!-- CLIENT-SIDE CATALOG ENGINE FOR 5050 ORIGINAL ITEMS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      let catalogData = [];
      try {
        const res = await fetch('/grocery_catalog.json');
        catalogData = await res.json();
        console.log("Loaded original catalog items count:", catalogData.length);
      } catch(e) {
        console.error("Failed to load original grocery catalog", e);
      }

      // 1. Cart Bar State
      function updateCartBar() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const bar = document.getElementById('floating-cart-bar');
          const countBadge = document.getElementById('cart-count-badge');
          const headerBadge = document.getElementById('cart-badge-header');
          const totalText = document.getElementById('cart-total-text');

          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          const totalPrice = cart.reduce((sum, i) => sum + (parseFloat(i.price || 0) * (i.quantity || 1)), 0);

          if (countBadge) countBadge.textContent = totalQty;
          if (headerBadge) headerBadge.textContent = totalQty;
          if (totalText) totalText.textContent = '₹' + Math.round(totalPrice);

          if (cart.length > 0) {
            bar?.classList.remove('hidden');
          } else {
            bar?.classList.add('hidden');
          }
        } catch(e) {}
      }

      updateCartBar();

      // 2. Interactive Quantity & Cart Action Controller
      function syncCartActionButtons() {
        let cart = [];
        try { cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); } catch(e) {}

        document.querySelectorAll('.cart-action-container').forEach(container => {
          const id = container.dataset.id;
          const name = container.dataset.name;
          const price = container.dataset.price;
          const img = container.dataset.img;
          if (!id) return;

          const cartItem = cart.find(i => i.id === id);
          const qty = cartItem ? (cartItem.quantity || 1) : 0;

          if (qty > 0) {
            container.innerHTML = `
              <div class="flex items-center justify-between bg-purpleBrand text-white font-extrabold text-xs rounded-xl overflow-hidden shadow-md shadow-purple-900/20">
                <button class="qty-minus-btn px-2.5 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}">-</button>
                <span class="px-1.5 text-[11px] font-black min-w-[1.2rem] text-center">${qty}</span>
                <button class="qty-plus-btn px-2.5 py-1.5 hover:bg-purpleDark active:scale-90 transition-all" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-img="${img}">+</button>
              </div>
            `;
          } else {
            container.innerHTML = `
              <button class="add-to-cart-btn px-4 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 hover:border-purpleBrand text-[11px] font-black rounded-xl shadow-xs hover:shadow-md active:scale-95 transition-all duration-200" data-id="${id}" data-name="${name ? name.replace(/"/g, '&quot;') : ''}" data-price="${price}" data-img="${img}">
                ADD
              </button>
            `;
          }
        });

        // Attach ADD click handlers
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = btn.dataset.price;
            const img = btn.dataset.img;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name, price, image: img, quantity: 1 });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });

        // Attach Plus click handlers
        document.querySelectorAll('.qty-plus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name: btn.dataset.name, price: btn.dataset.price, image: btn.dataset.img, quantity: 1 });
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });

        // Attach Minus click handlers
        document.querySelectorAll('.qty-minus-btn').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            const existingIndex = cart.findIndex(i => i.id === id);
            if (existingIndex > -1) {
              if (cart[existingIndex].quantity > 1) {
                cart[existingIndex].quantity -= 1;
              } else {
                cart.splice(existingIndex, 1);
              }
            }
            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            updateCartBar();
            syncCartActionButtons();
          };
        });
      }

      function attachAddToCartListeners() {
        syncCartActionButtons();
      }
      attachAddToCartListeners();

      // 3. Product Detail Modal
      const modal = document.getElementById('product-modal');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalCat = document.getElementById('modal-cat');
      const modalUnit = document.getElementById('modal-unit');
      const modalDesc = document.getElementById('modal-desc');
      const modalPrice = document.getElementById('modal-price');
      const modalMrp = document.getElementById('modal-mrp');
      const modalAddBtn = document.getElementById('modal-add-btn');

      function attachModalClickListeners() {
        document.querySelectorAll('.product-card').forEach(card => {
          card.onclick = () => {
            modalImg.src = card.dataset.img;
            modalTitle.textContent = card.dataset.name;
            modalCat.textContent = card.dataset.cat || 'Grocery';
            modalUnit.textContent = card.dataset.unit || '1 Pack';
            modalDesc.textContent = card.dataset.desc || '';
            modalPrice.textContent = '₹' + card.dataset.price;
            modalMrp.textContent = parseFloat(card.dataset.mrp) > parseFloat(card.dataset.price) ? '₹' + card.dataset.mrp : '';

            modalAddBtn.onclick = () => {
              let cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
              const id = card.dataset.id;
              const existing = cart.find(i => i.id === id);
              if (existing) {
                existing.quantity = (existing.quantity || 1) + 1;
              } else {
                cart.push({ id, name: card.dataset.name, price: card.dataset.price, image: card.dataset.img, quantity: 1 });
              }
              localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
              updateCartBar();
              modal.classList.add('hidden');
            };

            modal.classList.remove('hidden');
          };
        });
      }
      attachModalClickListeners();

      document.getElementById('close-modal-btn')?.addEventListener('click', () => {
        modal.classList.add('hidden');
      });

      // 4. Client Search & Filtering over 25,500 Items with Infinite Scroll
      const searchInput = document.getElementById('grocery-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const grid = document.getElementById('grocery-products-grid');
      const countLabel = document.getElementById('product-count-label');
      const titleLabel = document.getElementById('active-category-title');
      const loadMoreBtn = document.getElementById('load-more-btn');
      const paginationStatusText = document.getElementById('pagination-status-text');

      let currentQuery = '';
      let currentCategory = 'All Products'; // matches data-category="All Products"
      let currentFilter = 'all';

      let currentFiltered = [];
      let currentLimit = 48;
      const BATCH_SIZE = 48;

      function renderProducts() {
        if (!currentFiltered || currentFiltered.length === 0) {
          grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 font-bold">No products found matching your search.</div>`;
          if (countLabel) countLabel.textContent = '0 Products';
          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
          if (paginationStatusText) paginationStatusText.textContent = '';
          return;
        }

        const visibleItems = currentFiltered.slice(0, currentLimit);
        
        if (countLabel) {
          countLabel.textContent = `Showing ${visibleItems.length.toLocaleString()} of ${currentFiltered.length.toLocaleString()} Products (${catalogData.length.toLocaleString()} Total)`;
        }

        grid.innerHTML = visibleItems.map(p => {
          const id = p["Product ID"] || p.ProductID || p.id || '';
          const name = p["Product Name"] || '';
          const brand = p["Brand Name"] || p.brand || 'Bhusawal Fresh';
          const cat = p.Category || 'Grocery';
          const pack = p["Pack Size"] || p.pack || p.Unit || '1 Unit';
          const mrp = parseFloat(p.MRP || p.mrp || 0);
          const price = parseFloat(p["Selling Price"] || p.sp || mrp);
          const img = p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';
          const hasDiscount = mrp > price;
          const discountPct = hasDiscount ? Math.round(((mrp - price) / mrp) * 100) : 0;
          const isOutOfStock = p.stock === 0 || p.outOfStock === true || p.inStock === false || p.status === 'out_of_stock';
          const descSafe = (p.desc || p.Description || '').replace(/"/g, '&quot;');
          const nameSafe = name.replace(/"/g, '&quot;');

          return `
            <div class="product-card group bg-white rounded-[20px] border border-slate-100/90 shadow-sm hover:shadow-xl hover:border-purple-200/80 transition-all duration-300 relative flex flex-col overflow-hidden cursor-pointer p-2.5 sm:p-3" data-id="${id}" data-name="${nameSafe}" data-price="${price}" data-mrp="${mrp}" data-img="${img}" data-unit="${pack}" data-cat="${cat}" data-brand="${brand}" data-desc="${descSafe}">

              <div class="relative w-full h-36 sm:h-44 bg-gradient-to-b from-slate-50/90 via-slate-50/40 to-white rounded-2xl flex items-center justify-center p-3 overflow-hidden mb-2">
                ${hasDiscount && discountPct > 0 ? `
                  <span class="absolute top-2 left-2 z-10 bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-[10px] sm:text-[11px] font-black px-2 py-0.5 rounded-lg shadow-sm flex items-center gap-0.5 tracking-tight">
                    ${discountPct}% OFF
                  </span>
                ` : ''}

                ${isOutOfStock ? `
                  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[1px] z-20 flex items-center justify-center">
                    <span class="bg-slate-900 text-white text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-md border border-slate-700">Out of Stock</span>
                  </div>
                ` : ''}

                <button class="fav-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md border border-slate-200/80 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all duration-200 z-10 shadow-sm" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                  <span class="material-symbols-outlined text-[19px]" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
                </button>

                <img src="${img}" alt="${nameSafe}" class="max-h-full max-w-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300 ease-out" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />

                <div class="absolute bottom-2 left-2 z-10">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-400/95 backdrop-blur-sm text-slate-950 text-[9px] font-black rounded-md uppercase tracking-wider shadow-xs">
                    <span class="material-symbols-outlined text-[11px]">bolt</span>
                    10 MINS
                  </span>
                </div>
              </div>

              <div class="flex flex-col flex-1 px-1 pt-0.5 pb-1">
                <span class="text-[10px] font-extrabold text-purpleBrand uppercase tracking-wider truncate mb-0.5">${brand}</span>
                <h3 class="text-xs sm:text-[13px] font-bold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem] group-hover:text-purpleBrand transition-colors">${name}</h3>
                <p class="text-[11px] font-semibold text-slate-500 mb-2">${pack}</p>

                <div class="flex items-center justify-between gap-2 mt-auto pt-1.5 border-t border-slate-100">
                  <div class="flex flex-col">
                    <div class="flex items-baseline gap-1">
                      <span class="text-sm sm:text-base font-black text-slate-900 leading-none">₹${price}</span>
                      ${hasDiscount ? `<span class="text-[10px] sm:text-[11px] font-bold text-slate-400 line-through leading-none">₹${mrp}</span>` : ''}
                    </div>
                    ${hasDiscount ? `<span class="text-[9px] font-extrabold text-emerald-600 mt-0.5">Save ₹${mrp - price}</span>` : ''}
                  </div>

                  ${isOutOfStock ? `
                    <button disabled class="px-3 py-1.5 bg-slate-100 text-slate-400 text-[11px] font-extrabold rounded-xl border border-slate-200 cursor-not-allowed">UNAVAILABLE</button>
                  ` : `
                    <div class="cart-action-container" data-id="${id}" data-name="${nameSafe}" data-price="${price}" data-img="${img}">
                      <button class="add-to-cart-btn px-4 py-1.5 bg-purple-50 hover:bg-purpleBrand text-purpleBrand hover:text-white border border-purple-200 hover:border-purpleBrand text-[11px] font-black rounded-xl shadow-xs hover:shadow-md active:scale-95 transition-all duration-200" data-id="${id}" data-name="${nameSafe}" data-price="${price}" data-img="${img}">
                        ADD
                      </button>
                    </div>
                  `}
                </div>
              </div>
            </div>
          `;
        }).join('');

        if (currentLimit < currentFiltered.length) {
          if (loadMoreBtn) {
            loadMoreBtn.classList.remove('hidden');
            const remaining = currentFiltered.length - currentLimit;
            loadMoreBtn.textContent = `Load More (${Math.min(BATCH_SIZE, remaining).toLocaleString()} more)`;
          }
          if (paginationStatusText) {
            paginationStatusText.textContent = `Showing ${visibleItems.length.toLocaleString()} of ${currentFiltered.length.toLocaleString()} products`;
          }
        } else {
          if (loadMoreBtn) loadMoreBtn.classList.add('hidden');
          if (paginationStatusText) {
            paginationStatusText.textContent = currentFiltered.length > 0 
              ? `All ${currentFiltered.length.toLocaleString()} matching products loaded`
              : '';
          }
        }

        attachAddToCartListeners();
        attachModalClickListeners();
      }

      function filterCatalog() {
        if (!catalogData || catalogData.length === 0) return;

        let res = catalogData;

        // Search Query over Product Name, Category, Brand Name, Search Keywords
        if (currentQuery) {
          const q = currentQuery;
          res = res.filter(p => {
            const name = (p["Product Name"] || '').toLowerCase();
            const cat = (p.Category || '').toLowerCase();
            const brand = (p["Brand Name"] || '').toLowerCase();
            const kw = (p["Search Keywords"] || '').toLowerCase();
            return name.includes(q) || cat.includes(q) || brand.includes(q) || kw.includes(q);
          });
        }

        // Category Filter — "All Products" means no category filter
        if (currentCategory && currentCategory !== 'All Products') {
          const target = currentCategory.toLowerCase();
          res = res.filter(p => {
            const cat = (p.Category || '').toLowerCase();
            // Exact match on category name (case-insensitive)
            return cat === target;
          });
        }

        // Offers Filter
        if (currentFilter === 'deals') {
          res = res.filter(p => parseFloat(p.MRP || 0) > parseFloat(p["Selling Price"] || p.MRP || p.mrp || p["Selling Price"] || p.sp || p.MRP || 0));
        }

        currentFiltered = res;
        currentLimit = BATCH_SIZE;
        renderProducts();
      }

      // Load More Button Event
      loadMoreBtn?.addEventListener('click', () => {
        currentLimit += BATCH_SIZE;
        renderProducts();
      });

      // Infinite Scroll via IntersectionObserver
      if (loadMoreBtn) {
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting && currentLimit < currentFiltered.length) {
            currentLimit += BATCH_SIZE;
            renderProducts();
          }
        }, { rootMargin: '300px' });
        observer.observe(loadMoreBtn);
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        if (currentQuery) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
        filterCatalog();
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        clearBtn.classList.add('hidden');
        filterCatalog();
      });

      // Highlight active category button
      function setActiveCategoryBtn(activeCategory) {
        document.querySelectorAll('.desktop-cat-btn').forEach(b => {
          if (b.dataset.category === activeCategory) {
            b.classList.add('bg-purple-50', 'text-purpleBrand', 'border-purpleBrand');
          } else {
            b.classList.remove('bg-purple-50', 'text-purpleBrand', 'border-purpleBrand');
          }
        });
        document.querySelectorAll('.mobile-cat-btn').forEach(b => {
          if (b.dataset.category === activeCategory) {
            b.classList.add('bg-purpleBrand', 'text-white', 'border-purpleBrand');
            b.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
          } else {
            b.classList.remove('bg-purpleBrand', 'text-white', 'border-purpleBrand');
            b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          }
        });
      }

      // Category Click Handlers
      document.querySelectorAll('.desktop-cat-btn, .mobile-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.category || 'All Products';
          titleLabel.textContent = currentCategory;
          setActiveCategoryBtn(currentCategory);
          filterCatalog();
        });
      });

      // Filter Buttons
      document.querySelectorAll('.diet-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.diet-filter-btn').forEach(b => {
            b.classList.replace('bg-purpleBrand', 'bg-slate-100');
            b.classList.replace('text-white', 'text-slate-700');
          });
          btn.classList.replace('bg-slate-100', 'bg-purpleBrand');
          btn.classList.replace('text-slate-700', 'text-white');

          currentFilter = btn.dataset.filter || 'all';
          filterCatalog();
        });
      });

      // URL Search Param Auto-fill
      const urlParams = new URLSearchParams(window.location.search);
      const searchParam = urlParams.get('search');
      const catParam = urlParams.get('category');
      if (searchParam && searchInput) {
        searchInput.value = searchParam;
        currentQuery = searchParam.toLowerCase();
        clearBtn.classList.remove('hidden');
      }
      if (catParam) {
        currentCategory = catParam;
        titleLabel.textContent = catParam;
        setActiveCategoryBtn(catParam);
      }

      // Initial render — always call filterCatalog
      filterCatalog();
      setActiveCategoryBtn(currentCategory);
    });
  </script>
</body>
</html>
