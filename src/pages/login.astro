---
// Server-side: read MSG91 widget credentials from environment
const rawWidgetId = import.meta.env.MSG91_WIDGET_ID || process.env.MSG91_WIDGET_ID || '';
const rawWidgetTokenAuth = import.meta.env.MSG91_WIDGET_TOKEN_AUTH || process.env.MSG91_WIDGET_TOKEN_AUTH || '';
const serverAuthKey = import.meta.env.MSG91_AUTH_KEY || process.env.MSG91_AUTH_KEY || '';

// SAFETY GUARD: Never leak master MSG91_AUTH_KEY to client HTML!
// If MSG91_WIDGET_TOKEN_AUTH is identical to MSG91_AUTH_KEY, block it from client injection.
const widgetId = rawWidgetId;
const widgetTokenAuth = (rawWidgetTokenAuth && rawWidgetTokenAuth !== serverAuthKey) ? rawWidgetTokenAuth : '';
---


