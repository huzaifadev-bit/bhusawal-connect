        <button id="btn-change-number" class="text-xs font-bold text-purpleBrand hover:underline">Change</button>
      </div>

      <!-- 6-DIGIT OTP DIGITS INPUT BOXES -->
      <div class="space-y-3">
        <label class="text-xs font-black text-slate-700 block uppercase tracking-wider">Enter 6-Digit SMS OTP</label>
        
        <div class="flex items-center justify-between gap-1.5">
          <input type="text" maxlength="1" inputmode="numeric" autocomplete="one-time-code" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
          <input type="text" maxlength="1" inputmode="numeric" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
          <input type="text" maxlength="1" inputmode="numeric" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
          <input type="text" maxlength="1" inputmode="numeric" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
          <input type="text" maxlength="1" inputmode="numeric" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
          <input type="text" maxlength="1" inputmode="numeric" class="otp-box w-11 h-12 sm:w-12 sm:h-14 bg-slate-50 border-2 border-slate-200 focus:border-purpleBrand focus:bg-white text-center text-lg font-black text-slate-900 rounded-xl outline-none transition-all" />
        </div>

        <!-- Real OTP Helper Hint -->
        <p class="text-[10px] font-extrabold text-purpleBrand text-center bg-purple-50 py-1 rounded-lg">
          🔒 Secure SMS OTP verification powered by Bhusawal Connect Auth Engine
        </p>

        <!-- OTP Error Message -->
        <p id="otp-error-msg" class="text-[11px] font-bold text-rose-500 hidden text-center">
          Invalid SMS OTP code. Please check and try again.
        </p>
      </div>

      <!-- RESEND OTP TIMER CONTAINER -->
      <div class="flex items-center justify-between text-xs font-bold text-slate-500 pt-1">
        <span id="resend-timer-text">Resend OTP in <strong id="timer-seconds" class="text-slate-900 font-black">60s</strong></span>
        <button id="btn-resend-otp" class="hidden text-purpleBrand hover:underline font-black">Resend OTP via SMS</button>
      </div>

      <!-- VERIFY & CONTINUE BUTTON -->
      <button id="btn-verify-otp" class="w-full py-4 bg-purpleBrand hover:bg-purpleDark text-white font-black text-xs sm:text-sm rounded-2xl shadow-xl shadow-purple-900/20 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2">
        <span id="btn-verify-text">Verify & Continue</span>
        <span class="material-symbols-outlined text-base">check_circle</span>
      </button>

    </div>

    <!-- STEP 3: LOGIN SUCCESS SCREEN -->
    <div id="step-success-screen" class="hidden text-center py-6 space-y-4 animate-in zoom-in-95 duration-300">
      <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-lg animate-bounce">
        <span class="material-symbols-outlined text-5xl">check_circle</span>
      </div>
      <div>
        <h2 class="text-xl font-black font-display text-slate-900">Authenticated!</h2>
        <p class="text-xs font-bold text-slate-400 mt-1">Recognized customer session. Redirecting to Bhusawal Connect...</p>
      </div>
      <div class="w-8 h-8 border-4 border-purpleBrand border-t-transparent rounded-full animate-spin mx-auto"></div>
    </div>

    <!-- FOOTER TERMS & PRIVACY LINKS -->
    <div class="border-t border-slate-100 pt-4 text-center">
      <p class="text-[10px] font-bold text-slate-400 leading-normal">
        By continuing, you agree to Bhusawal Connect's 
        <a href="#" class="text-purpleBrand hover:underline font-black">Terms of Service</a> & 
        <a href="#" class="text-purpleBrand hover:underline font-black">Privacy Policy</a>
      </p>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- AUTHENTICATION INTEGRATION MODULE                          -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!--
    MSG91 OTP Widget Configuration.
    widgetId and tokenAuth are injected by Astro SSR from server-side env vars
    via define:vars (NOT from PUBLIC_* env vars, NOT hardcoded).
    The tokenAuth is MSG91's browser-facing widget token (required by their SDK).
    The server-side MSG91_AUTH_KEY is used only in /api/auth/verify-widget-token.
  -->
  <script is:inline define:vars={{ widgetId, widgetTokenAuth }}>
    // Store widget config globally for the module script to access
    window.__msg91WidgetId = widgetId || '';
    window.__msg91TokenAuth = widgetTokenAuth || '';
    window.__msg91WidgetReady = false;
  </script>

  <!-- Load MSG91 OTP Widget SDK -->
  <script is:inline src="https://verify.msg91.com/otp-provider.js"></script>

  <!-- Main Authentication Module -->
  <script type="module">
    import { setupRecaptcha, sendPhoneOtp, verifyPhoneOtp, subscribeToAuth } from '/src/lib/firebase.ts';
    import { getCurrentCustomer, syncCustomerProfile } from '/src/lib/customerAuth.ts';

    document.addEventListener('DOMContentLoaded', async () => {
      // ── DOM References ──
      const mobileScreen = document.getElementById('step-mobile-screen');
      const otpScreen = document.getElementById('step-otp-screen');
      const successScreen = document.getElementById('step-success-screen');

      const mobileInput = document.getElementById('mobile-input');
      const mobileError = document.getElementById('mobile-error-msg');
      const mobileErrorText = document.getElementById('mobile-error-text');
      const sendOtpBtn = document.getElementById('btn-send-otp');
      const sendOtpText = document.getElementById('btn-send-otp-text');

      const displayMobile = document.getElementById('display-mobile-number');
      const backBtn = document.getElementById('btn-back-to-mobile');
      const changeNumberBtn = document.getElementById('btn-change-number');
      const otpBoxes = document.querySelectorAll('.otp-box');
      const otpError = document.getElementById('otp-error-msg');
      const verifyBtn = document.getElementById('btn-verify-otp');
      const verifyText = document.getElementById('btn-verify-text');

      const timerText = document.getElementById('resend-timer-text');
      const timerSec = document.getElementById('timer-seconds');
      const resendBtn = document.getElementById('btn-resend-otp');

      // ── State ──
      let recaptchaVerifier = null;
      let confirmationResult = null;
      let timerInterval = null;
      let activePhone = '';
      let sendOtpInProgress = false;

      // ── Helpers ──
      const redirectAfterLogin = () => {
        const urlParams = new URLSearchParams(window.location.search);
        window.location.href = urlParams.get('redirect') || '/customer';
      };

      const showError = (msg) => {
        if (mobileErrorText) mobileErrorText.textContent = msg;
        mobileError.classList.remove('hidden');
      };

      const hideError = () => {
        mobileError.classList.add('hidden');
      };

      const resetSendBtn = () => {
        sendOtpText.textContent = 'Send OTP via SMS';
        sendOtpBtn.disabled = false;
        sendOtpInProgress = false;
      };

      // ── Server-side widget token verification ──
      const verifyWidgetTokenAndRedirect = async (accessToken) => {
        if (!accessToken) {
          showError('Verification succeeded but no token received. Please try again.');
          mobileScreen.classList.remove('hidden');
          otpScreen.classList.add('hidden');
          resetSendBtn();
          return;
        }

        try {
          const verifyRes = await fetch('/api/auth/verify-widget-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accessToken })
          });
          const verifyData = await verifyRes.json().catch(() => ({}));

          if (verifyRes.ok && verifyData.success) {
            mobileScreen.classList.add('hidden');
            otpScreen.classList.add('hidden');
            successScreen.classList.remove('hidden');
            setTimeout(redirectAfterLogin, 600);
          } else {
            showError(verifyData.message || 'Server verification failed. Please try again.');
            mobileScreen.classList.remove('hidden');
            otpScreen.classList.add('hidden');
            resetSendBtn();
          }
        } catch (err) {
          showError('Network error during verification. Please try again.');
          mobileScreen.classList.remove('hidden');
          otpScreen.classList.add('hidden');
          resetSendBtn();
        }
      };

      // ── 0. Auto-detect returning authenticated customer ──
      const currentSupabase = await getCurrentCustomer();
      if (currentSupabase && currentSupabase.profile) {
        mobileScreen.classList.add('hidden');
        otpScreen.classList.add('hidden');
        successScreen.classList.remove('hidden');
        setTimeout(redirectAfterLogin, 600);
        return;
      }

      subscribeToAuth((user) => {
        if (user) {
          mobileScreen.classList.add('hidden');
          otpScreen.classList.add('hidden');
          successScreen.classList.remove('hidden');
          setTimeout(redirectAfterLogin, 600);
        }
      });

      // ── 1. Firebase recaptcha fallback setup ──
      try {
        recaptchaVerifier = setupRecaptcha('recaptcha-container');
      } catch (err) {
        // Firebase recaptcha is a fallback; non-critical if it fails
      }

      // ── 2. Send OTP — Primary: MSG91 Widget, Fallback: Server API → Direct OTP ──
      sendOtpBtn?.addEventListener('click', async () => {
        // Prevent duplicate submissions
        if (sendOtpInProgress) return;

        const val = mobileInput.value.trim();
        if (!val || val.length !== 10 || isNaN(val)) {
          showError('Please enter a valid 10-digit Indian mobile number.');
          return;
        }
        hideError();
        activePhone = val;
        sendOtpInProgress = true;
        sendOtpText.textContent = 'Sending SMS OTP...';
        sendOtpBtn.disabled = true;

        try {
          // PRIMARY: MSG91 OTP Widget (initSendOTP)
          const wid = window.__msg91WidgetId;
          const wta = window.__msg91TokenAuth;

          if (wid && wta && typeof window.initSendOTP === 'function') {
            const widgetConfig = {
              widgetId: wid,
              tokenAuth: wta,
              identifier: `91${val}`,
              success: async (data) => {
                const accessToken = data?.message || data?.access_token || data?.accessToken || '';
                await verifyWidgetTokenAndRedirect(accessToken);
              },
              failure: (error) => {
                showError('OTP verification was cancelled or failed. Please try again.');
                mobileScreen.classList.remove('hidden');
                resetSendBtn();
              }
            };

            window.initSendOTP(widgetConfig);
            return;
          }

          // Server-side MSG91 OTP API
          const res = await fetch('/api/auth/request-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: val })
          });
          const apiData = await res.json().catch(() => ({}));

          if (res.ok && apiData.success) {
            displayMobile.textContent = `+91 ******${val.slice(-4)}`;
            mobileScreen.classList.add('hidden');
            otpScreen.classList.remove('hidden');
            if (otpBoxes[0]) {
              setTimeout(() => otpBoxes[0].focus(), 100);
            }
            startResendTimer(60);
            resetSendBtn();
            return;
          }

          showError(apiData.message || 'Unable to send OTP. Please check server configuration.');
          resetSendBtn();
        } catch (err) {
          console.error('[Login] OTP send error:', err);
          showError('Network error while requesting OTP. Please try again.');
          resetSendBtn();
        }
      });

      // Enter key triggers Send OTP
      mobileInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') sendOtpBtn.click();
      });

      // ── 3. OTP Box Navigation & Paste (fallback OTP UI) ──
      otpBoxes.forEach((box, index) => {
        box.addEventListener('input', (e) => {
          if (e.target.value.length === 1 && index < otpBoxes.length - 1) {
            otpBoxes[index + 1].focus();
          }
        });

        box.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !e.target.value && index > 0) {
            otpBoxes[index - 1].focus();
          }
        });

        box.addEventListener('paste', (e) => {
          const pasteData = e.clipboardData?.getData('text') || '';
          const digits = pasteData.replace(/\D/g, '').slice(0, 6);
          if (digits.length > 0) {
            e.preventDefault();
            digits.split('').forEach((digit, i) => {
              if (otpBoxes[i]) otpBoxes[i].value = digit;
            });
            if (digits.length === 6 && verifyBtn) verifyBtn.focus();
          }
        });
      });

      // ── 4. Back & Change Phone Number ──
      const returnToMobileStep = () => {
        clearInterval(timerInterval);
        otpScreen.classList.add('hidden');
        mobileScreen.classList.remove('hidden');
        if (mobileInput) mobileInput.focus();
      };

      backBtn?.addEventListener('click', returnToMobileStep);
      changeNumberBtn?.addEventListener('click', returnToMobileStep);

      // ── 5. Resend Timer ──
      function startResendTimer(seconds = 60) {
        let sec = seconds;
        timerText.classList.remove('hidden');
        resendBtn.classList.add('hidden');
        if (timerSec) timerSec.textContent = `${sec}s`;

        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          sec--;
          if (timerSec) timerSec.textContent = `${sec}s`;
          if (sec <= 0) {
            clearInterval(timerInterval);
            timerText.classList.add('hidden');
            resendBtn.classList.remove('hidden');
          }
        }, 1000);
      }

      resendBtn?.addEventListener('click', async () => {
        if (activePhone) {
          sendOtpBtn.click();
        }
      });

      // ── 6. Verify OTP (Strict MSG91 server verification) ──
      verifyBtn?.addEventListener('click', async () => {
        let enteredOtp = '';
        otpBoxes.forEach(box => enteredOtp += box.value);

        if (enteredOtp.length < 4) {
          otpError.textContent = 'Please enter the complete OTP code.';
          otpError.classList.remove('hidden');
          return;
        }
        otpError.classList.add('hidden');
        verifyText.textContent = 'Verifying...';
        verifyBtn.disabled = true;

        try {
          // Server-side MSG91 OTP verification
          const verifyRes = await fetch('/api/auth/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: activePhone, otp: enteredOtp })
          });
          const verifyData = await verifyRes.json().catch(() => ({}));

          if (verifyRes.ok && verifyData.success) {
            const profileData = {
              id: verifyData.user?.id || 'CUST-' + activePhone.slice(-4),
              phone: '+91 ' + activePhone,
              name: verifyData.user?.name || 'Customer',
              email: verifyData.user?.email || '',
              isLoggedIn: true,
            };
            localStorage.setItem('bhusawal_user_profile', JSON.stringify(profileData));
            localStorage.setItem('bhusawal_user_phone', '+91' + activePhone);
            try {
              localStorage.setItem('bhusawal_auth_session', JSON.stringify({
                user: profileData,
                phone: '+91' + activePhone,
                loginTime: new Date().toISOString()
              }));
            } catch (e) {}
            window.dispatchEvent(new Event('storage'));

            otpScreen.classList.add('hidden');
            successScreen.classList.remove('hidden');
            setTimeout(redirectAfterLogin, 600);
            return;
          }

          throw new Error(verifyData.message || 'Invalid OTP code. Please try again.');
        } catch (err) {
          otpError.textContent = err.message || 'Invalid OTP code. Please try again.';
          otpError.classList.remove('hidden');
        } finally {
          verifyText.textContent = 'Verify & Continue';
          verifyBtn.disabled = false;
        }
      });
    });
  </script>
