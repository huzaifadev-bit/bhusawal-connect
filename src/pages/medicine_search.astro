 <script is:inline>
  // client_side_classification_engine_inserted

function isPersonalCareProduct(p) {
  const name = (p["Product Name"] || "").toLowerCase();
  const dbCat = p.Category || "";
  
  if (dbCat === 'Personal Care' || dbCat === 'Baby Care' || dbCat === 'Women\'s Hygiene' || dbCat === 'Sexual Wellness' || dbCat === 'OTC Medical Products') {
    return true;
  }

  // Definite personal care indicators (never food)
  const definitePersonalCare = [
    'shampoo', 'shamp', 'lotion', 'body wash', 'bodywash', 'deodorant', 'perfume', 'toothbrush', 
    'toothpaste', 'toothpowder', 'mouthwash', 'conditioner', 'cleanser', 'serum', 'moisturiser', 
    'moisturizer', 'scrub', 'spray', 'hair water', 'attar', 'sandalwood', 'eau de', 'toilette', 
    'cologne', 'body mist', 'buds', 'sunscreen', 'sun block', 'sunblock', 'lip balm', 'lip therapy', 
    'facewash', 'face wash', 'handwash', 'hand wash', 'hair care', 'skin care', 'body care', 'face care', 
    'hygiene', 'sheet mask', 'skin mask', 'bathing bar', 'bath bar', 'body milk'
  ];
  if (definitePersonalCare.some(kw => name.includes(kw))) {
    return true;
  }

  // Soap (avoid dishwash/laundry)
  if (name.includes('soap') && !name.includes('dish') && !name.includes('laund')) {
    return true;
  }

  // Cream (avoid ice cream, sour cream, cooking creams, biscuits, cheese, chocolate)
  if (name.includes('cream')) {
    const foodCreams = ['ice cream', 'biscuit', 'toast', 'sour', 'whipped', 'onion', 'garlic', 'culinary', 'cheese', 'salad', 'soup', 'cookie', 'chocolate'];
    if (!foodCreams.some(fc => name.includes(fc))) {
      return true;
    }
  }

  // Oil (avoid cooking oils, ghee)
  if (name.includes('oil')) {
    const cookingOils = ['cooking', 'mustard', 'refined', 'soyabean', 'sunflower', 'groundnut', 'olive', 'rice bran', 'ghee', 'sesame', 'castor oil for cooking', 'spices'];
    if (!cookingOils.some(co => name.includes(co))) {
      return true;
    }
  }

  // Powder (avoid baking, cooking powders)
  if (name.includes('powder')) {
    const foodPowders = ['baking', 'custard', 'cocoa', 'sugar', 'chili', 'chilly', 'turmeric', 'coriander', 'jeera', 'masala', 'pepper', 'detergent', 'washing', 'soap powder', 'chutney'];
    if (!foodPowders.some(fp => name.includes(fp))) {
      return true;
    }
  }

  // Gel (avoid food gels)
  if (name.includes('gel') && !name.includes('food') && !name.includes('jelly') && !name.includes('flavor')) {
    return true;
  }

  // Brush (avoid paint brushes, etc.)
  if (name.includes('brush') && !name.includes('paint') && !name.includes('wire')) {
    return true;
  }

  // Check personal care brands
  const brands = [
    'pears', 'nivea', 'dove', 'himalaya', 'tresemme', 'colgate', 'oral-b', 'pantene', 'sunsilk', 
    'parachute', 'vaseline', 'sensodyne', 'dettol', 'fiama', 'liril', 'cinthol', 'santoor', 
    'biotique', 'lux', 'mamaearth', 'ponds', 'pond\'s', 'loreal', 'l\'oreal', 'garnier', 'gillette', 
    'lakme', 'yardley', 'clinique', 'vlcc', 'neutrogena', 'cetaphil', 'body shop', 'forest essentials', 
    'mama earth', 'soulflower', 'head & shoulders', 'head and shoulders', 'johnson\'s', 'johnson baby', 
    'guggal', 'guggul', 'attar'
  ];
  if (brands.some(b => name.includes(b))) {
    return true;
  }

  return false;
}

function getActualCategory(p) {
  const name = (p["Product Name"] || "").toLowerCase();
  const dbCat = p.Category || "";
  
  // Check laundry / cleaning items placed in wrong categories (like Spices & Masalas)
  const isHouseholdName = (
    name.includes('detergent') || name.includes('washing powder') || name.includes('cleaner') || 
    name.includes('disinfectant') || name.includes('scrubber') || name.includes('foil') || 
    name.includes('garbage bag') || name.includes('pooja') || name.includes('camphor') ||
    name.includes('wick') || name.includes('batti') || name.includes('kapoor') ||
    (name.includes('dish') && name.includes('wash'))
  );

  if (isPersonalCareProduct(p)) {
    return 'Personal Care';
  }
  
  if (isHouseholdName || dbCat === 'Home Cleaning' || dbCat === 'Laundry' || dbCat === 'Bathroom Cleaning' || dbCat === 'Kitchen Cleaning' || dbCat === 'Pooja Items' || dbCat === 'Disposable Products' || dbCat === 'Kitchen Essentials') {
    return 'Home';
  }

  if (dbCat === 'Fruits & Vegetables') {
    return 'Fruits & Vegetables';
  }
  
  if (dbCat === 'Dairy' || dbCat === 'Bakery') {
    return 'Dairy';
  }
  
  if (dbCat === 'Rice, Atta & Flour' || dbCat === 'Dal & Pulses' || dbCat === 'Cooking Oil & Ghee' || dbCat === 'Spices & Masalas' || dbCat === 'Salt, Sugar & Jaggery') {
    return 'Staples';
  }
  
  if (dbCat === 'Snacks' || dbCat === 'Biscuits & Cookies' || dbCat === 'Chocolates' || dbCat === 'Noodles & Pasta' || dbCat === 'Beverages' || dbCat === 'Tea & Coffee' || dbCat === 'Ice Cream' || dbCat === 'Frozen Foods') {
    return 'Snacks';
  }
  
  return 'Staples';
}

  // Smooth scroll and dynamic click behavior
  let fullCatalog = [];
  let cart = JSON.parse(localStorage.getItem('bhusawal_cart_medicine') || '{}');
  let cartCount = 0;
  let cartTotal = 0;

  const mainEl = document.querySelector('main');
  const originalMainHTML = mainEl.innerHTML;
  const cartBar = document.querySelector('.fixed.bottom-24');
  const cartTextCount = cartBar.querySelector('p.font-bold');
  const cartTextDetails = cartBar.querySelector('p.text-white\\/80');

  function updateCartBar() {
   localStorage.setItem('bhusawal_cart_medicine', JSON.stringify(cart));
   cartCount = Object.values(cart).reduce((sum, item) => sum + item.qty, 0);
   cartTotal = Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
   if (cartCount > 0) {
    cartBar.classList.remove('hidden');
    cartTextCount.textContent = cartCount + ' Item' + (cartCount > 1 ? 's' : '');
    cartTextDetails.textContent = '₹' + cartTotal + ' • Shivaji Nagar';
   } else {
    cartBar.classList.add('hidden');
   }
  }

  function replaceWithStepper(btn, title, price, themeColor, imgUrl = '', packSize = '', category = '') {
   const btnClass = btn.className;
   const stepper = document.createElement('div');
   stepper.className = 'absolute bottom-2 right-2 flex items-center rounded-lg shadow-md overflow-hidden z-10';
   stepper.style.backgroundColor = themeColor;
   stepper.innerHTML = `
    <button class="qty-minus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">−</button>
    <span class="qty-value w-6 h-7 flex items-center justify-center text-white text-[11px] font-extrabold">1</span>
    <button class="qty-plus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">+</button>
   `;
   btn.replaceWith(stepper);

   if (!cart[title]) {
    cart[title] = { price, qty: 1, themeColor, btnClass, imgUrl, packSize, category };
   }
   updateCartBar();

   const qtyDisplay = stepper.querySelector('.qty-value');
   qtyDisplay.textContent = cart[title].qty;

   stepper.querySelector('.qty-plus').addEventListener('click', (e) => {
    e.stopPropagation();
    cart[title].qty++;
    qtyDisplay.textContent = cart[title].qty;
    updateCartBar();
   });

   stepper.querySelector('.qty-minus').addEventListener('click', (e) => {
    e.stopPropagation();
    cart[title].qty--;
    if (cart[title].qty <= 0) {
     delete cart[title];
     const addBtn = document.createElement('button');
     addBtn.className = btnClass;
     addBtn.textContent = 'ADD';
     stepper.replaceWith(addBtn);
     bindAddButton(addBtn);
    } else {
     qtyDisplay.textContent = cart[title].qty;
    }
    updateCartBar();
   });
  }

  function bindAddButton(btn) {
   btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const card = btn.closest('.group');
    const title = card.querySelector('h3').textContent.trim();
    const priceText = card.querySelector('.selling-price').textContent.trim();
    const price = parseInt(priceText.replace(/[^\d]/g, ''));
    
    const imgEl = card.querySelector('img');
    const imgUrl = imgEl ? imgEl.getAttribute('src') : '';
    
    const packEl = card.querySelector('p.text-neutral-500');
    const packSize = packEl ? packEl.textContent.trim() : '';
    
    const catEl = card.querySelector('.absolute.top-2.left-2');
    const category = catEl ? catEl.textContent.trim() : 'Medicines';
    
    let themeColor = '#10b981';
    const classes = Array.from(btn.classList);
    for (const cls of classes) {
     if (cls.startsWith('border-[') && cls.endsWith(']')) {
      themeColor = cls.substring(8, cls.length - 1);
      break;
     }
    }
    replaceWithStepper(btn, title, price, themeColor, imgUrl, packSize, category);
   });
  }

  function syncUIWithCart() {
   document.querySelectorAll('.group').forEach(card => {
    const titleEl = card.querySelector('h3');
    if (!titleEl) return;
    const title = titleEl.textContent.trim();
    if (cart[title]) {
     const btn = card.querySelector('.btn-add-static') || card.querySelector('.btn-add-dynamic');
     if (btn) {
      const priceText = card.querySelector('.selling-price').textContent.trim();
      const price = parseInt(priceText.replace(/[^\d]/g, ''));
      
      let themeColor = '#10b981';
      const classes = Array.from(btn.classList);
      for (const cls of classes) {
       if (cls.startsWith('border-[') && cls.endsWith(']')) {
        themeColor = cls.substring(8, cls.length - 1);
        break;
       }
      }

      const imgEl = card.querySelector('img');
      const imgUrl = imgEl ? imgEl.getAttribute('src') : '';
      
      const packEl = card.querySelector('p.text-neutral-500');
      const packSize = packEl ? packEl.textContent.trim() : '';
      
      const catEl = card.querySelector('.absolute.top-2.left-2');
      const category = catEl ? catEl.textContent.trim() : 'Medicines';

      replaceWithStepper(btn, title, price, themeColor, imgUrl, packSize, category);
     }
    }
   });
   updateCartBar();
  }

  function bindStaticButtons() {
   document.querySelectorAll('main button.btn-add-static').forEach(btn => bindAddButton(btn));
   syncUIWithCart();
  }

  function bindScrollButtons() {
   document.querySelectorAll('[data-target]').forEach(btn => {
    btn.addEventListener('click', () => {
     const targetId = btn.getAttribute('data-target');
     if (fullCatalog.length > 0) {
      let matches = [];
      if (targetId === 'section-veggies') matches = fullCatalog.filter(item => getActualCategory(item) === 'Fruits & Vegetables');
      else if (targetId === 'section-dairy') matches = fullCatalog.filter(item => getActualCategory(item) === 'Dairy');
      else if (targetId === 'section-staples') matches = fullCatalog.filter(item => getActualCategory(item) === 'Staples');
      else if (targetId === 'section-snacks') matches = fullCatalog.filter(item => getActualCategory(item) === 'Snacks');
      else if (targetId === 'section-personal') matches = fullCatalog.filter(item => getActualCategory(item) === 'Personal Care');
      else if (targetId === 'section-household') matches = fullCatalog.filter(item => getActualCategory(item) === 'Home');
      else {
       const allowedCats = categoryMappings[targetId] || [];
       matches = fullCatalog.filter(item => allowedCats.includes(item.Category));
      }
      const categoryLabel = btn.querySelector('span:last-child').textContent.trim();
      renderProductList(categoryLabel, matches.slice(0, 100));
      window.scrollTo({ top: 0, behavior: 'smooth' });
     } else {
      const targetEl = document.getElementById(targetId);
      if (targetEl) {
       targetEl.scrollIntoView({ behavior: 'smooth' });
      }
     }
    });
   });
  }

  function renderProductList(title, products) {
   const heading = '<div class="flex items-center justify-between mb-6">' +
    '<h2 class="font-headline-md text-headline-md text-on-surface">' + title + ' (' + products.length + ' Items)</h2>' +
    '<button id="btn-clear-filter" class="text-primary font-label-md text-label-md flex items-center gap-1">' +
     'Back to Home <span class="material-symbols-outlined text-sm">close</span>' +
    '</button>' +
   '</div>';

   let gridHTML = '<div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">';
   products.forEach(p => {
    const actualCategory = getActualCategory(p);
    const tag = actualCategory === 'Fruits & Vegetables' ? 'Organic' : 'Bestseller';
    const tagColor = actualCategory === 'Fruits & Vegetables' ? 'bg-emerald-600 text-white' : 'bg-[#ffc107] text-neutral-900';
    const price = p.MRP;
    const mrpHtml = '';
    const discountHtml = '';
    const ratingCount = p.StockQuantity || '3.5k';

    let iconName = 'shopping_bag';
    if (getActualCategory(p) === 'Fruits & Vegetables') iconName = 'eco';
    else if (getActualCategory(p) === 'Dairy') iconName = 'water_drop';
    else if (getActualCategory(p) === 'Staples') iconName = 'inventory_2';
    else if (getActualCategory(p) === 'Snacks') iconName = 'cookie';
    else if (getActualCategory(p) === 'Home') iconName = 'cleaning_services';
    else if (getActualCategory(p) === 'Personal Care') iconName = 'sanitizer';

    let themeColor = '#ff3f6c';
    let hoverBorderClass = 'hover:border-primary/20';
    
    if (actualCategory === 'Fruits & Vegetables') {
      themeColor = '#0c831f';
      hoverBorderClass = 'hover:border-emerald-500/30';
    } else if (actualCategory === 'Dairy') {
      themeColor = '#2563eb';
      hoverBorderClass = 'hover:border-blue-500/30';
    } else if (actualCategory === 'Staples') {
      themeColor = '#d97706';
      hoverBorderClass = 'hover:border-amber-500/30';
    } else if (actualCategory === 'Snacks') {
      themeColor = '#7c3aed';
      hoverBorderClass = 'hover:border-purple-500/30';
    } else if (actualCategory === 'Home') {
      themeColor = '#0d9488';
      hoverBorderClass = 'hover:border-teal-500/30';
    } else if (actualCategory === 'Personal Care') {
      themeColor = '#db2777';
      hoverBorderClass = 'hover:border-pink-500/30';
    }

    gridHTML += '<div class="bg-white rounded-2xl p-2.5 shadow-[0_8px_16px_rgba(0,0,0,0.02)] flex flex-col group border border-neutral-100/80 ' + hoverBorderClass + ' hover:shadow-[0_8px_24px_rgba(0,0,0,0.05)] transition-all duration-300 relative">' +
     '<div class="w-full aspect-square rounded-xl bg-white border border-neutral-100/60 mb-2.5 relative flex items-center justify-center p-2.5 overflow-hidden">' +
      '<div class="w-full h-full flex items-center justify-center bg-neutral-100/30 rounded-lg">' +
       '<span class="material-symbols-outlined text-2xl text-neutral-300 group-hover:scale-110 transition-transform duration-300" data-icon="' + iconName + '">' + iconName + '</span>' +
      '</div>' +
      '<div class="absolute top-2 left-2 ' + tagColor + ' text-[7px] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-wider">' + tag + '</div>' +
      '<button class="absolute bottom-2 right-2 bg-white border border-[' + themeColor + '] text-[' + themeColor + '] px-3 py-1 rounded-lg text-[10px] font-extrabold shadow-md hover:bg-[' + themeColor + ']/5 active:scale-95 transition-all duration-200 btn-add-dynamic">ADD</button>' +
     '</div>' +
     '<div class="flex-grow flex flex-col justify-between">' +
      '<div>' +
       '<div class="flex items-center flex-wrap gap-1">' +
        '<span class="bg-[#0c831f] text-white px-1.5 py-0.5 rounded text-[10px] font-extrabold selling-price">₹' + price + '</span>' +
        mrpHtml +
       '</div>' +
       discountHtml +
       '<h3 class="text-[11px] font-extrabold text-neutral-800 line-clamp-2 h-7.5 mt-1.5 leading-snug">' + p["Product Name"] + '</h3>' +
      '</div>' +
      '<div class="mt-1">' +
       '<p class="text-[9px] text-neutral-500 font-bold">' + (p["Pack Size"] || '1 Unit') + '</p>' +
       '<div class="flex items-center gap-0.5 text-[9px] text-neutral-500 font-extrabold mt-0.5">' +
        '<span class="text-[#0c831f]">★</span>' +
        '<span>4.7</span>' +
        '<span class="text-neutral-400 font-normal">(' + ratingCount + ')</span>' +
       '</div>' +
      '</div>' +
     '</div>' +
    '</div>';
   });
   gridHTML += '</div>';

   mainEl.innerHTML = '<section class="pb-20">' + heading + gridHTML + '</section>';

   mainEl.querySelectorAll('.btn-add-dynamic').forEach(btn => bindAddButton(btn));
   syncUIWithCart();

   document.getElementById('btn-clear-filter').addEventListener('click', () => {
    restoreOriginalGrid();
   });
  }

  // Bind initial behaviors
  bindStaticButtons();
  bindScrollButtons();

  // Bind Search Input dynamic matches
  const searchInput = document.querySelector('input');
  if (searchInput) {
   searchInput.addEventListener('input', (e) => {
    const query = e.target.value.trim().toLowerCase();
    if (query.length > 1) {
     const matches = fullCatalog.filter(item => {
      const nameMatch = (item["Product Name"] || '').toLowerCase().includes(query);
      const brandMatch = (item["Brand Name"] || '').toLowerCase().includes(query);
      const categoryMatch = getActualCategory(item).toLowerCase().includes(query);
      return nameMatch || brandMatch || categoryMatch;
     });
     renderProductList('Search Results for "' + e.target.value + '"', matches.slice(0, 40));
    } else if (query.length === 0) {
     restoreOriginalGrid();
    }
   });
  }

  // Scroll shadow effect
  window.addEventListener('scroll', () => {
   const header = document.querySelector('header');
   if (header) {
    if (window.scrollY > 10) {
     header.classList.add('shadow-md');
    } else {
     header.classList.remove('shadow-md');
    }
   }
  });

  // Cart redirect
  cartBar.addEventListener('click', () => {
   if (cartCount > 0) {
    window.location.href = '/billing?type=medicine';
   }
  });
 </script>
 <Switcher />
<script>
    if (!localStorage.getItem('bhusawal_user_token')) {
      window.location.href = '/';
    }
</script>
