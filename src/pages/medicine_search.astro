      ];

      // UI ELEMENTS
      var searchInput = document.getElementById('med-search-input');
      var searchClearBtn = document.getElementById('med-search-clear');
      var suggestionsDropdown = document.getElementById('med-suggestions-dropdown');
      var gridEl = document.getElementById('med-results-grid');
      var emptyEl = document.getElementById('med-empty-state');
      var resultsTitle = document.getElementById('results-title');
      var resultsCountBadge = document.getElementById('results-count-badge');
      var resultsQueryLabel = document.getElementById('results-query-label');
      var priceValLabel = document.getElementById('price-val-label');
      var headerCartBadge = document.getElementById('header-cart-badge');

      // FILTERS INPUTS
      var sortSelect = document.getElementById('filter-sort');
      var rxRadios = document.querySelectorAll('input[name="rx_filter"]');
      var instockCheckbox = document.getElementById('filter-instock');
      var categorySelect = document.getElementById('filter-category');
      var brandSelect = document.getElementById('filter-brand');
      var priceRange = document.getElementById('filter-price-range');
      var resetBtn = document.getElementById('btn-reset-filters');
      var emptyResetBtn = document.getElementById('btn-empty-reset');

      // STATE
      var currentQuery = '';

      // INITIAL PARAMETERS FROM URL (?q=... or ?cat=...)
      function readUrlParams() {
        var params = new URLSearchParams(window.location.search);
        var q = params.get('q');
        var cat = params.get('cat');
        if (q && q.trim()) {
          searchInput.value = q.trim();
          currentQuery = q.trim().toLowerCase();
          searchClearBtn.classList.remove('hidden');
          searchClearBtn.classList.add('flex');
        }
        if (cat && cat.trim()) {
          for (var i = 0; i < categorySelect.options.length; i++) {
            if (categorySelect.options[i].value.toLowerCase() === cat.trim().toLowerCase()) {
              categorySelect.selectedIndex = i;
              break;
            }
          }
        }
      }

      // CART MANAGEMENT
      
      // GLOBAL MED CART FUNCTIONS EXPOSED TO WINDOW FOR Direct 100% RELIABLE CLICK HANDLERS
      window.getGlobalCart = function() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); }
        catch(e) { return []; }
      };

      window.saveGlobalCart = function(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        if (typeof updateAllCartUI === 'function') updateAllCartUI();
      };

      window.goToMedDetails = function(event, id) {
        if (event.target.closest('.btn-add-med') || event.target.closest('.med-qty-selector') || event.target.closest('.med-fav-btn')) {
          return;
        }
        window.location.href = '/medicine_details?id=' + id;
      };

      window.addMedToCart = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;

        var id = card.getAttribute('data-id');
        var name = card.getAttribute('data-name');
        var price = parseFloat(card.getAttribute('data-price')) || 0;
        var mrp = parseFloat(card.getAttribute('data-mrp')) || price;
        var img = card.getAttribute('data-img');
        var brand = card.getAttribute('data-brand') || '';
        var rxRequired = card.getAttribute('data-rx') === 'true';

        var cart = window.getGlobalCart();
        var existing = cart.find(function(c) { return c.id === id; });
        if (existing) {
          existing.quantity = (existing.quantity || 1) + 1;
        } else {
          cart.push({
            id: id,
            name: name,
            price: price,
            mrp: mrp,
            image: img,
            quantity: 1,
            restaurant: brand || 'Bhusawal Express Pharmacy',
            cat: 'Medicines',
            rxRequired: rxRequired
          });
        }
        window.saveGlobalCart(cart);
      };

      window.medQtyPlus = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;
        var id = card.getAttribute('data-id');
        var cart = window.getGlobalCart();
        var item = cart.find(function(c) { return c.id === id; });
        if (item) {
          item.quantity = (item.quantity || 1) + 1;
          window.saveGlobalCart(cart);
        }
      };

      window.medQtyMinus = function(btn, event) {
        if (event) event.stopPropagation();
        var card = btn.closest('.med-card');
        if (!card) return;
        var id = card.getAttribute('data-id');
        var cart = window.getGlobalCart();
        var idx = cart.findIndex(function(c) { return c.id === id; });
        if (idx > -1) {
          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            cart.splice(idx, 1);
          }
          window.saveGlobalCart(cart);
        }
      };

      window.toggleMedFav = function(btn, event) {
        if (event) event.stopPropagation();
        btn.classList.toggle('text-rose-500');
        btn.classList.toggle('border-rose-200');
        btn.classList.toggle('text-slate-400');
        btn.classList.toggle('border-slate-200');
      };

      function getGlobalCart() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); }
        catch(e) { return []; }
      }

      function saveGlobalCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateAllCartUI();
      }

      function updateAllCartUI() {
        var cart = getGlobalCart();
        var totalCount = cart.reduce(function(sum, item) { return sum + (item.quantity || 1); }, 0);
        var totalPrice = cart.reduce(function(sum, item) { return sum + (parseFloat(item.price || 0) * (item.quantity || 1)); }, 0);

        if (headerCartBadge) headerCartBadge.textContent = totalCount;

        var floatBar = document.getElementById('med-floating-cart-bar');
        var floatCount = document.getElementById('med-float-count');
        var floatTotal = document.getElementById('med-float-total');

        if (floatBar) {
          if (totalCount > 0) {
            floatBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
            if (floatCount) floatCount.textContent = totalCount + (totalCount === 1 ? ' ITEM' : ' ITEMS');
            if (floatTotal) floatTotal.textContent = '₹' + Math.round(totalPrice);
          } else {
            floatBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          }
        }

        // Update grid steppers
        document.querySelectorAll('.med-card').forEach(function(card) {
          var cid = card.getAttribute('data-id');
          var cartItem = cart.find(function(c) { return c.id === cid; });
          var addBtn = card.querySelector('.btn-add-med');
          var qtySel = card.querySelector('.med-qty-selector');
          var qtyCount = card.querySelector('.med-qty-count');

          if (cartItem && cartItem.quantity > 0) {
            if (addBtn) addBtn.classList.add('hidden');
            if (qtySel) qtySel.classList.remove('hidden');
            if (qtyCount) qtyCount.textContent = cartItem.quantity;
          } else {
            if (addBtn) addBtn.classList.remove('hidden');
            if (qtySel) qtySel.classList.add('hidden');
          }
        });
      }

      // SEARCH SUGGESTIONS GENERATOR
      function generateSuggestions(query) {
        if (!query || query.length < 2) {
          suggestionsDropdown.classList.add('hidden');
          return;
        }

        var q = query.toLowerCase();
        var matches = [];

        medicineCatalog.forEach(function(m) {
          var nMatch = m.name.toLowerCase().includes(q);
          var bMatch = m.brand.toLowerCase().includes(q);
          var sMatch = m.salt.toLowerCase().includes(q);
          var dMatch = m.disease.toLowerCase().includes(q);
          var cMatch = m.category.toLowerCase().includes(q);

          if (nMatch || bMatch || sMatch || dMatch || cMatch) {
            matches.push({
              item: m,
              type: nMatch ? 'Medicine' : (bMatch ? 'Brand' : (sMatch ? 'Salt Name' : (dMatch ? 'Condition' : 'Category')))
            });
          }
        });

        if (matches.length === 0) {
          suggestionsDropdown.innerHTML = `
            <div class="px-4 py-3 text-xs text-slate-500 font-medium italic">
              No matching medicines, salts, or brands for "${query}"
            </div>
          `;
        } else {
          var html = '<div class="divide-y divide-slate-100">';
          matches.slice(0, 7).forEach(function(match) {
            var m = match.item;
            html += `
              <div class="suggestion-item px-4 py-2.5 hover:bg-blue-50 cursor-pointer flex items-center justify-between transition-colors" data-name="${m.name}">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-7 h-7 rounded-lg bg-blueLight text-blueBrand flex items-center justify-center text-xs shrink-0 font-black">💊</span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-slate-800 truncate">${m.name}</div>
                    <div class="text-[10px] text-slate-400 font-semibold truncate">${m.brand} • <span class="text-blueBrand font-bold">${m.salt}</span></div>
                  </div>
                </div>
                <div class="flex items-center gap-1 shrink-0 ml-2">
                  <span class="text-[9px] font-black text-slate-500 uppercase tracking-wider bg-slate-100 px-1.5 py-0.5 rounded">${match.type}</span>
                  <span class="text-xs font-black text-slate-900">₹${m.price}</span>
                </div>
              </div>
            `;
          });
          html += '</div>';
          suggestionsDropdown.innerHTML = html;
        }

        suggestionsDropdown.classList.remove('hidden');
      }

      // RENDER PRODUCTS GRID & APPLY ALL FILTERS
      function renderFilteredProducts() {
        var query = searchInput.value.trim().toLowerCase();
        var selectedSort = sortSelect.value;
        var selectedRx = document.querySelector('input[name="rx_filter"]:checked').value;
        var inStockOnly = instockCheckbox.checked;
        var selectedCat = categorySelect.value;
        var selectedBrand = brandSelect.value;
        var maxPrice = parseFloat(priceRange.value);

        // Update Price Range Label
        priceValLabel.textContent = '₹' + maxPrice.toLocaleString();

        // 1. FILTERING
        var filtered = medicineCatalog.filter(function(m) {
          // Search query check (Name, Brand, Salt, Disease, Category)
          if (query) {
            var nMatch = m.name.toLowerCase().includes(query);
            var bMatch = m.brand.toLowerCase().includes(query);
            var sMatch = m.salt.toLowerCase().includes(query);
            var dMatch = m.disease.toLowerCase().includes(query);
            var cMatch = m.category.toLowerCase().includes(query);
            if (!nMatch && !bMatch && !sMatch && !dMatch && !cMatch) return false;
          }

          // Rx / OTC filter
          if (selectedRx === 'otc' && m.rxRequired) return false;
          if (selectedRx === 'rx' && !m.rxRequired) return false;

          // In Stock check
          if (inStockOnly && !m.inStock) return false;

          // Category check
          if (selectedCat !== 'all' && m.category.toLowerCase() !== selectedCat.toLowerCase()) return false;

          // Brand check
          if (selectedBrand !== 'all' && m.brand.toLowerCase() !== selectedBrand.toLowerCase()) return false;

          // Price check
          if (m.price > maxPrice) return false;

          return true;
        });

        // 2. SORTING
        if (selectedSort === 'price_low') {
          filtered.sort(function(a, b) { return a.price - b.price; });
        } else if (selectedSort === 'price_high') {
          filtered.sort(function(a, b) { return b.price - a.price; });
        } else if (selectedSort === 'newest') {
          filtered.sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
        } else {
          // Popular (default)
          filtered.sort(function(a, b) { return b.popularity - a.popularity; });
        }

        // 3. RENDER UI
        resultsCountBadge.textContent = filtered.length + ' item' + (filtered.length === 1 ? '' : 's');
        if (query) {
          resultsTitle.textContent = 'Results for "' + searchInput.value.trim() + '"';
        } else if (selectedCat !== 'all') {
          resultsTitle.textContent = selectedCat + ' Medicines';
        } else {
          resultsTitle.textContent = 'Showing Medicines';
        }

        if (filtered.length === 0) {
          gridEl.classList.add('hidden');
          emptyEl.classList.remove('hidden');
          return;
        }

        gridEl.classList.remove('hidden');
        emptyEl.classList.add('hidden');

        var html = '';
        filtered.forEach(function(item) {
          var isDiscount = item.mrp > item.price;
          var discountPct = isDiscount ? Math.round(((item.mrp - item.price) / item.mrp) * 100) : 0;

          html += `
            <div 
              class="med-card bg-white rounded-2xl border border-slate-100 p-3 flex flex-col justify-between shadow-xs hover:shadow-lg hover:border-blue-200 transition-all cursor-pointer group relative"
              data-id="${item.id}"
              data-name="${item.name}"
              data-price="${item.price}"
              data-mrp="${item.mrp}"
              data-img="${item.image}"
              data-brand="${item.brand}"
              data-category="${item.category}"
              data-rx="${item.rxRequired ? 'true' : 'false'}"
              onclick="window.goToMedDetails(event, '${item.id}');"
            >
              <!-- Wishlist Fav Button -->
              <button 
                class="med-fav-btn absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-white/90 backdrop-blur-sm border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:border-rose-200 transition-all z-10 active:scale-90"
                onclick="event.stopPropagation();"
                aria-label="Add to Wishlist"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>

              <!-- Rx Badge -->
              ${item.rxRequired ? `
                <span class="absolute top-2.5 left-2.5 bg-rose-500 text-white text-[8px] font-black px-1.5 py-0.5 rounded-md uppercase tracking-wider z-10 shadow-sm">
                  Rx
                </span>
              ` : ''}

              <!-- Image Box -->
              <div class="w-full aspect-square bg-slate-50 rounded-xl p-2 mb-2.5 flex items-center justify-center border border-slate-100/60 overflow-hidden relative">
                <span class="absolute bottom-1.5 left-1.5 bg-blueLight text-blueBrand text-[8px] font-black px-1.5 py-0.5 rounded-md border border-blue-200/60">
                  ${item.pack}
                </span>
                <img src="${item.image}" alt="${item.name}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" loading="lazy" />
              </div>

              <!-- Metadata -->
              <span class="text-[9px] font-extrabold text-blueBrand uppercase tracking-wider block mb-0.5 truncate">
                ${item.brand} • ${item.category}
              </span>

              <!-- Name & Salt -->
              <h3 class="text-[11px] sm:text-xs font-black font-display text-slate-900 line-clamp-1 leading-tight">
                ${item.name}
              </h3>
              <p class="text-[9.5px] font-semibold text-slate-400 line-clamp-1 mt-0.5">
                Salt: <span class="text-slate-600 font-bold">${item.salt}</span>
              </p>

              <!-- Condition Tag -->
              <div class="mt-1">
                <span class="text-[8.5px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200/60 inline-block line-clamp-1">
                  💡 ${item.disease}
                </span>
              </div>

              <!-- Price & Actions -->
              <div class="pt-2 border-t border-slate-100 mt-2.5">
                <div class="flex items-center gap-1.5 mb-2">
                  <span class="text-sm sm:text-base font-black font-display text-slate-900">₹${item.price}</span>
                  ${isDiscount ? `<span class="text-[9px] text-slate-400 line-through font-bold">₹${item.mrp}</span>` : ''}
                  ${isDiscount ? `<span class="text-[9px] font-black text-emerald-600 bg-emerald-50 px-1 py-0.5 rounded">${discountPct}% OFF</span>` : ''}
                </div>

                <div class="med-cart-actions">
                  <button 
                    class="btn-add-med w-full py-1.5 bg-blueLight text-blueBrand hover:bg-blueBrand hover:text-white border border-blue-200 text-xs font-black rounded-xl active:scale-95 transition-all"
                    onclick="window.addMedToCart(this, event);"
                  >
                    + ADD
                  </button>
                  <div class="med-qty-selector hidden flex items-center justify-between w-full bg-blueBrand rounded-xl overflow-hidden">
                    <button class="med-qty-minus px-3 py-1.5 text-white text-sm font-black hover:bg-blueDark transition-colors" onclick="window.medQtyMinus(this, event)">−</button>
                    <span class="med-qty-count text-white text-xs font-black">1</span>
                    <button class="med-qty-plus px-3 py-1.5 text-white text-sm font-black hover:bg-blueDark transition-colors" onclick="window.medQtyPlus(this, event)">+</button>
                  </div>
                </div>
              </div>
            </div>
          `;
        });

        gridEl.innerHTML = html;
        updateAllCartUI();
      }

      // RESET FILTERS
      function resetAllFilters() {
        searchInput.value = '';
        currentQuery = '';
        searchClearBtn.classList.add('hidden');
        suggestionsDropdown.classList.add('hidden');
        sortSelect.value = 'popular';
        document.querySelector('input[name="rx_filter"][value="all"]').checked = true;
        instockCheckbox.checked = false;
        categorySelect.value = 'all';
        brandSelect.value = 'all';
        priceRange.value = '3000';
        renderFilteredProducts();
      }

      // LISTENERS
      searchInput.addEventListener('input', function(e) {
        var val = e.target.value;
        if (val.trim()) {
          searchClearBtn.classList.remove('hidden');
          searchClearBtn.classList.add('flex');
        } else {
          searchClearBtn.classList.add('hidden');
        }
        generateSuggestions(val.trim());
        renderFilteredProducts();
      });

      searchClearBtn.addEventListener('click', function() {
        searchInput.value = '';
        searchClearBtn.classList.add('hidden');
        suggestionsDropdown.classList.add('hidden');
        renderFilteredProducts();
      });

      // Suggestion Item Click
      document.addEventListener('click', function(e) {
        var item = e.target.closest('.suggestion-item');
        if (item) {
          var name = item.getAttribute('data-name');
          searchInput.value = name;
          suggestionsDropdown.classList.add('hidden');
          renderFilteredProducts();
        } else if (!e.target.closest('#med-search-input') && !e.target.closest('#med-suggestions-dropdown')) {
          suggestionsDropdown.classList.add('hidden');
        }
      });

      // Quick Tag Buttons
      document.querySelectorAll('.quick-tag-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          searchInput.value = btn.textContent.trim();
          searchClearBtn.classList.remove('hidden');
          searchClearBtn.classList.add('flex');
          renderFilteredProducts();
        });
      });

      // Filter Inputs Change
      sortSelect.addEventListener('change', renderFilteredProducts);
      rxRadios.forEach(function(r) { r.addEventListener('change', renderFilteredProducts); });
      instockCheckbox.addEventListener('change', renderFilteredProducts);
      categorySelect.addEventListener('change', renderFilteredProducts);
      brandSelect.addEventListener('change', renderFilteredProducts);
      priceRange.addEventListener('input', renderFilteredProducts);

      resetBtn.addEventListener('click', resetAllFilters);
      emptyResetBtn.addEventListener('click', resetAllFilters);

      // ADD TO CART CLICK HANDLERS
      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.btn-add-med');
        if (addBtn) {
          e.stopPropagation();
          var card = addBtn.closest('.med-card');
          if (!card) return;

          var id = card.getAttribute('data-id');
          var name = card.getAttribute('data-name');
          var price = parseFloat(card.getAttribute('data-price')) || 0;
          var mrp = parseFloat(card.getAttribute('data-mrp')) || price;
          var img = card.getAttribute('data-img');
          var brand = card.getAttribute('data-brand') || '';

          var cart = getGlobalCart();
          var existing = cart.find(function(c) { return c.id === id; });
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({
              id: id, name: name, price: price, mrp: mrp, image: img,
              quantity: 1, restaurant: brand || 'Bhusawal Express Pharmacy', cat: 'Medicines'
            });
          }
          saveGlobalCart(cart);
        }
      });

      // QUANTITY SELECTOR CLICK HANDLERS
      document.addEventListener('click', function(e) {
        var plusBtn = e.target.closest('.med-qty-plus');
        var minusBtn = e.target.closest('.med-qty-minus');

        if (plusBtn) {
          e.stopPropagation();
          var card = plusBtn.closest('.med-card');
          if (!card) return;
          var id = card.getAttribute('data-id');
          var cart = getGlobalCart();
          var item = cart.find(function(c) { return c.id === id; });
          if (item) { item.quantity = (item.quantity || 1) + 1; saveGlobalCart(cart); }
        }

        if (minusBtn) {
          e.stopPropagation();
          var card = minusBtn.closest('.med-card');
          if (!card) return;
          var id = card.getAttribute('data-id');
          var cart = getGlobalCart();
          var idx = cart.findIndex(function(c) { return c.id === id; });
          if (idx > -1) {
            if (cart[idx].quantity > 1) {
              cart[idx].quantity -= 1;
            } else {
              cart.splice(idx, 1);
            }
            saveGlobalCart(cart);
          }
        }
      });

      // INIT
      readUrlParams();
      renderFilteredProducts();
    })();
  </script>

</body>
</html>
