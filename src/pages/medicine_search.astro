import fs from 'fs';
import path from 'path';
import Switcher from '../components/Switcher.astro';

// Read the database at build-time for static rendering
const jsonPath = path.join(process.cwd(), 'public/grocery_catalog.json');
let catalog = [];
try {
 catalog = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
} catch (err) {
 console.error("Failed to read grocery catalog at build time", err);
}

function isPersonalCareProduct(p) {
  const name = (p["Product Name"] || "").toLowerCase();
  const dbCat = p.Category || "";
  
  if (dbCat === 'Personal Care' || dbCat === 'Baby Care' || dbCat === 'Women\'s Hygiene' || dbCat === 'Sexual Wellness' || dbCat === 'OTC Medical Products') {
    return true;
  }

  // Definite personal care indicators (never food)
  const definitePersonalCare = [
    'shampoo', 'shamp', 'lotion', 'body wash', 'bodywash', 'deodorant', 'perfume', 'toothbrush', 
    'toothpaste', 'toothpowder', 'mouthwash', 'conditioner', 'cleanser', 'serum', 'moisturiser', 
    'moisturizer', 'scrub', 'spray', 'hair water', 'attar', 'sandalwood', 'eau de', 'toilette', 
    'cologne', 'body mist', 'buds', 'sunscreen', 'sun block', 'sunblock', 'lip balm', 'lip therapy', 
    'facewash', 'face wash', 'handwash', 'hand wash', 'hair care', 'skin care', 'body care', 'face care', 
    'hygiene', 'sheet mask', 'skin mask', 'bathing bar', 'bath bar', 'body milk'
  ];
  if (definitePersonalCare.some(kw => name.includes(kw))) {
    return true;
  }

  // Soap (avoid dishwash/laundry)
  if (name.includes('soap') && !name.includes('dish') && !name.includes('laund')) {
    return true;
  }

  // Cream (avoid ice cream, sour cream, cooking creams, biscuits, cheese, chocolate)
  if (name.includes('cream')) {
    const foodCreams = ['ice cream', 'biscuit', 'toast', 'sour', 'whipped', 'onion', 'garlic', 'culinary', 'cheese', 'salad', 'soup', 'cookie', 'chocolate'];
    if (!foodCreams.some(fc => name.includes(fc))) {
      return true;
    }
  }

  // Oil (avoid cooking oils, ghee)
  if (name.includes('oil')) {
    const cookingOils = ['cooking', 'mustard', 'refined', 'soyabean', 'sunflower', 'groundnut', 'olive', 'rice bran', 'ghee', 'sesame', 'castor oil for cooking', 'spices'];
    if (!cookingOils.some(co => name.includes(co))) {
      return true;
    }
  }

  // Powder (avoid baking, cooking powders)
  if (name.includes('powder')) {
    const foodPowders = ['baking', 'custard', 'cocoa', 'sugar', 'chili', 'chilly', 'turmeric', 'coriander', 'jeera', 'masala', 'pepper', 'detergent', 'washing', 'soap powder', 'chutney'];
    if (!foodPowders.some(fp => name.includes(fp))) {
      return true;
    }
  }

  // Gel (avoid food gels)
  if (name.includes('gel') && !name.includes('food') && !name.includes('jelly') && !name.includes('flavor')) {
    return true;
  }

  // Brush (avoid paint brushes, etc.)
  if (name.includes('brush') && !name.includes('paint') && !name.includes('wire')) {
    return true;
  }

  // Check personal care brands
  const brands = [
    'pears', 'nivea', 'dove', 'himalaya', 'tresemme', 'colgate', 'oral-b', 'pantene', 'sunsilk', 
    'parachute', 'vaseline', 'sensodyne', 'dettol', 'fiama', 'liril', 'cinthol', 'santoor', 
    'biotique', 'lux', 'mamaearth', 'ponds', 'pond\'s', 'loreal', 'l\'oreal', 'garnier', 'gillette', 
    'lakme', 'yardley', 'clinique', 'vlcc', 'neutrogena', 'cetaphil', 'body shop', 'forest essentials', 
    'mama earth', 'soulflower', 'head & shoulders', 'head and shoulders', 'johnson\'s', 'johnson baby', 
    'guggal', 'guggul', 'attar'
  ];
  if (brands.some(b => name.includes(b))) {
    return true;
  }

  return false;
}

function getActualCategory(p) {
  const name = (p["Product Name"] || "").toLowerCase();
  const dbCat = p.Category || "";
  
  // Check laundry / cleaning items placed in wrong categories (like Spices & Masalas)
  const isHouseholdName = (
    name.includes('detergent') || name.includes('washing powder') || name.includes('cleaner') || 
    name.includes('disinfectant') || name.includes('scrubber') || name.includes('foil') || 
    name.includes('garbage bag') || name.includes('pooja') || name.includes('camphor') ||
    name.includes('wick') || name.includes('batti') || name.includes('kapoor') ||
    (name.includes('dish') && name.includes('wash'))
  );

  if (isPersonalCareProduct(p)) {
    return 'Personal Care';
  }
  
  if (isHouseholdName || dbCat === 'Home Cleaning' || dbCat === 'Laundry' || dbCat === 'Bathroom Cleaning' || dbCat === 'Kitchen Cleaning' || dbCat === 'Pooja Items' || dbCat === 'Disposable Products' || dbCat === 'Kitchen Essentials') {
    return 'Home';
  }

  if (dbCat === 'Fruits & Vegetables') {
    return 'Fruits & Vegetables';
  }
  
  if (dbCat === 'Dairy' || dbCat === 'Bakery') {
    return 'Dairy';
  }
  
  if (dbCat === 'Rice, Atta & Flour' || dbCat === 'Dal & Pulses' || dbCat === 'Cooking Oil & Ghee' || dbCat === 'Spices & Masalas' || dbCat === 'Salt, Sugar & Jaggery') {
    return 'Staples';
  }
  
  if (dbCat === 'Snacks' || dbCat === 'Biscuits & Cookies' || dbCat === 'Chocolates' || dbCat === 'Noodles & Pasta' || dbCat === 'Beverages' || dbCat === 'Tea & Coffee' || dbCat === 'Ice Cream' || dbCat === 'Frozen Foods') {
    return 'Snacks';
  }
  
  return 'Staples';
}


// Filter popular items per category for initial static load using re-classification engine
const veggies = catalog.filter(i => getActualCategory(i) === 'Fruits & Vegetables').slice(0, 8);
const dairy = catalog.filter(i => getActualCategory(i) === 'Dairy').slice(0, 8);
const staples = catalog.filter(i => getActualCategory(i) === 'Staples').slice(0, 8);
const snacks = catalog.filter(i => getActualCategory(i) === 'Snacks').slice(0, 8);
const household = catalog.filter(i => getActualCategory(i) === 'Home').slice(0, 8);
const personal = catalog.filter(i => getActualCategory(i) === 'Personal Care').slice(0, 8);
