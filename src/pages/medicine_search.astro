---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Medicines & Health Products | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="pb-36 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER & TOP NAV ==================== -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs px-4 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <a href="/medicines" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-700 transition-colors active:scale-95">
          <span class="material-symbols-outlined text-xl">arrow_back</span>
        </a>
        <div>
          <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-none">Medicine Search</h1>
          <p class="text-[10px] text-slate-500 font-semibold mt-0.5">Search by Name, Brand, Salt Name or Disease</p>
        </div>
      </div>

      <!-- Quick Cart Button -->
      <a href="/cart" class="flex items-center gap-1.5 bg-blueLight border border-blue-200 text-blueBrand px-3 py-1.5 rounded-xl font-bold text-xs hover:bg-blueBrand hover:text-white transition-all">
        <span class="material-symbols-outlined text-base">shopping_bag</span>
        <span id="header-cart-badge" class="font-extrabold">0</span>
      </a>
    </div>
  </header>

  <!-- ==================== SEARCH BAR WITH LIVE AUTOCOMPLETE ==================== -->
  <section class="max-w-7xl mx-auto px-4 mt-4 relative z-30">
    <div class="relative">
      <div class="relative flex items-center">
        <span class="material-symbols-outlined absolute left-4 text-slate-400 text-xl pointer-events-none">search</span>
        <input 
          type="text" 
          id="med-search-input" 
          class="w-full bg-white border-2 border-slate-200 rounded-2xl py-3.5 pl-11 pr-10 text-sm font-semibold text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blueBrand focus:ring-4 focus:ring-blue-100 shadow-sm transition-all"
          placeholder="Search 'Paracetamol', 'Dolo', 'Fever', 'Sanofi', 'Diabetes'..." 
          autocomplete="off"
        />
        <button id="med-search-clear" class="absolute right-3.5 w-6 h-6 rounded-full bg-slate-100 text-slate-400 hover:text-slate-600 hidden items-center justify-center text-xs transition-colors">
          ✕
        </button>
      </div>

      <!-- Live Search Suggestions Dropdown -->
      <div id="med-suggestions-dropdown" class="absolute left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden hidden max-h-80 overflow-y-auto z-50">
        <!-- Dynamically populated via JS -->
      </div>
    </div>

    <!-- Quick Search Badges / Tags -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar mt-2.5 pb-1 text-xs">
      <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider shrink-0">Popular:</span>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Fever & Pain</button>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Paracetamol</button>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Diabetes</button>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Blood Pressure</button>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Acidity & Gas</button>
      <button class="quick-tag-btn px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:border-blueBrand hover:text-blueBrand transition-all shrink-0">Multivitamins</button>
    </div>
  </section>

  <!-- ==================== MAIN CONTENT & FILTERS ==================== -->
  <main class="max-w-7xl mx-auto px-4 mt-5">
    <div class="flex flex-col lg:flex-row gap-6">

      <!-- SIDEBAR FILTERS (Desktop) & TOGGLE MODAL (Mobile) -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs space-y-5 sticky top-20">
          
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h2 class="text-sm font-black font-display text-slate-900 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-blueBrand text-lg">tune</span>
              <span>Filters</span>
            </h2>
            <button id="btn-reset-filters" class="text-[11px] font-bold text-blueBrand hover:underline">Reset All</button>
          </div>

          <!-- 1. Sort By -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Sort By</label>
            <select id="filter-sort" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 outline-none focus:border-blueBrand">
              <option value="popular">Popularity / Relevance</option>
              <option value="price_low">Price: Low to High</option>
              <option value="price_high">Price: High to Low</option>
              <option value="newest">Newest Arrivals</option>
            </select>
          </div>

          <!-- 2. Prescription & Type Filter -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Medicine Type</label>
            <div class="space-y-1.5 text-xs font-semibold text-slate-600">
              <label class="flex items-center gap-2 cursor-pointer hover:text-slate-900">
                <input type="radio" name="rx_filter" value="all" checked class="accent-blueBrand" />
                <span>All Medicines</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer hover:text-slate-900">
                <input type="radio" name="rx_filter" value="otc" class="accent-blueBrand" />
                <span>OTC (No Prescription)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer hover:text-slate-900">
                <input type="radio" name="rx_filter" value="rx" class="accent-blueBrand" />
                <span class="flex items-center gap-1">
                  <span>Prescription Required</span>
                  <span class="bg-rose-500 text-white text-[8px] font-black px-1 rounded">Rx</span>
                </span>
              </label>
            </div>
          </div>

          <!-- 3. Availability Filter -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Availability</label>
            <label class="flex items-center gap-2 text-xs font-semibold text-slate-600 cursor-pointer hover:text-slate-900">
              <input type="checkbox" id="filter-instock" class="rounded text-blueBrand focus:ring-blueBrand accent-blueBrand" />
              <span>In Stock Only</span>
            </label>
          </div>

          <!-- 4. Category Filter -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Category</label>
            <select id="filter-category" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 outline-none focus:border-blueBrand">
              <option value="all">All Categories</option>
              <option value="Pain Relief">Pain Relief</option>
              <option value="Cold & Fever">Cold & Fever</option>
              <option value="Diabetes">Diabetes</option>
              <option value="Heart Care">Heart Care</option>
              <option value="Blood Pressure">Blood Pressure</option>
              <option value="Vitamins">Vitamins</option>
              <option value="Supplements">Supplements</option>
              <option value="Protein">Protein</option>
              <option value="Ayurvedic">Ayurvedic</option>
              <option value="Baby Care">Baby Care</option>
              <option value="Women's Care">Women's Care</option>
              <option value="Men's Care">Men's Care</option>
              <option value="Skin Care">Skin Care</option>
              <option value="Hair Care">Hair Care</option>
              <option value="Dental Care">Dental Care</option>
              <option value="Eye Care">Eye Care</option>
              <option value="Digestive Care">Digestive Care</option>
              <option value="Medical Devices">Medical Devices</option>
              <option value="Personal Care">Personal Care</option>
              <option value="Covid Essentials">Covid Essentials</option>
            </select>
          </div>

          <!-- 5. Brand Filter -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Brand</label>
            <select id="filter-brand" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 outline-none focus:border-blueBrand">
              <option value="all">All Brands</option>
              <option value="Micro Labs">Micro Labs</option>
              <option value="Sanofi">Sanofi</option>
              <option value="Sun Pharma">Sun Pharma</option>
              <option value="Cipla">Cipla</option>
              <option value="Abbott">Abbott</option>
              <option value="USV">USV</option>
              <option value="GSK">GSK</option>
              <option value="Torrent">Torrent</option>
              <option value="Glenmark">Glenmark</option>
              <option value="Himalaya">Himalaya</option>
              <option value="Dabur">Dabur</option>
              <option value="Patanjali">Patanjali</option>
              <option value="Omron">Omron</option>
              <option value="Dr. Morepen">Dr. Morepen</option>
            </select>
          </div>

          <!-- 6. Price Filter -->
          <div class="space-y-2">
            <label class="text-xs font-black text-slate-700 uppercase tracking-wider block">Max Price: <span id="price-val-label" class="text-blueBrand font-extrabold">₹3,000</span></label>
            <input type="range" id="filter-price-range" min="20" max="3000" step="50" value="3000" class="w-full accent-blueBrand cursor-pointer" />
            <div class="flex justify-between text-[10px] text-slate-400 font-bold">
              <span>₹20</span>
              <span>₹3,000</span>
            </div>
          </div>

        </div>
      </aside>

      <!-- RESULTS PRODUCT GRID -->
      <section class="flex-1 space-y-4">
        
        <!-- Header Info -->
        <div class="flex items-center justify-between bg-white rounded-2xl border border-slate-200 p-3.5 px-4 shadow-xs">
          <div>
            <h2 class="text-sm sm:text-base font-black font-display text-slate-900 flex items-center gap-2">
              <span id="results-title">Showing Medicines</span>
              <span id="results-count-badge" class="bg-blueLight text-blueBrand text-xs font-extrabold px-2 py-0.5 rounded-full border border-blue-200">0 items</span>
            </h2>
            <p id="results-query-label" class="text-[11px] text-slate-500 font-semibold mt-0.5">Filter or search to explore our full pharmacy catalog</p>
          </div>

          <!-- Active Filter Tags Display -->
          <div id="active-filter-chips" class="hidden flex-wrap items-center gap-1.5">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Grid Container -->
        <div id="med-results-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
          <!-- Dynamically Rendered Cards -->
        </div>

        <!-- Empty State -->
        <div id="med-empty-state" class="hidden bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-4 shadow-xs">
          <div class="w-16 h-16 rounded-full bg-blueLight text-blueBrand mx-auto flex items-center justify-center">
            <span class="material-symbols-outlined text-3xl">search_off</span>
          </div>
          <div>
            <h3 class="text-base font-black text-slate-800 font-display">No Medicines Found</h3>
            <p class="text-xs text-slate-500 font-medium max-w-md mx-auto mt-1">We couldn't find any products matching your search criteria. Try adjusting your query or resetting filters.</p>
          </div>
          <button id="btn-empty-reset" class="px-5 py-2 bg-blueBrand text-white text-xs font-bold rounded-xl hover:bg-blueDark transition-colors shadow-sm">
            Reset Filters
          </button>
        </div>

      </section>

    </div>
  </main>

  <!-- ==================== FLOATING CART BAR ==================== -->
  <div id="med-floating-cart-bar" class="fixed bottom-4 left-4 right-4 max-w-xl mx-auto bg-slate-900 text-white rounded-2xl p-3.5 shadow-2xl z-50 flex items-center justify-between transition-all transform translate-y-32 opacity-0 pointer-events-none border border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-blueBrand text-white flex items-center justify-center font-black shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span id="med-float-count" class="text-xs font-black bg-white/20 px-2 py-0.5 rounded-md">0 ITEMS</span>
          <span class="text-xs text-slate-400 font-bold">•</span>
          <span id="med-float-total" class="text-sm font-black text-white">₹0</span>
        </div>
        <p class="text-[10px] text-slate-400 font-semibold mt-0.5">10 Min Express Pharmacy Delivery</p>
      </div>
    </div>

    <a href="/cart" class="px-5 py-2.5 bg-blueBrand hover:bg-blueDark text-white text-xs font-black rounded-xl active:scale-95 transition-all shadow-md flex items-center gap-1">
      <span>Continue to Cart</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <Switcher />

  <!-- ==================== CLIENT SIDE CATALOG & INSTANT FILTERING SCRIPT ==================== -->
