---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Medicine Details | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF',
            emeraldBrand: '#10B981'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAFC; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased bg-slate-50">

  <!-- TOP NAV HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/medicines" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-blueBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <!-- CART BUTTON -->
    <a href="/cart" class="relative px-3.5 py-1.5 bg-blueLight border border-blue-200 text-blueBrand text-xs font-black rounded-xl hover:bg-blueBrand hover:text-white transition-all flex items-center gap-1.5 shadow-xs">
      <span class="material-symbols-outlined text-lg">shopping_cart</span>
      <span>Cart</span>
      <span id="detail-cart-badge" class="bg-blueBrand text-white text-[10px] font-black px-1.5 py-0.2 rounded-full">0</span>
    </a>
  </header>

  <!-- MAIN PRODUCT DETAILS CONTENT -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PRODUCT DISPLAY CARD -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm grid grid-cols-1 md:grid-cols-12 gap-8 items-start">

      <!-- LEFT 5 COLS: PRODUCT IMAGE & RX BADGE -->
      <div class="md:col-span-5 space-y-4">
        <div class="w-full aspect-square bg-slate-50 rounded-2xl p-6 border border-slate-100 flex items-center justify-center relative overflow-hidden group">
          <span id="rx-badge" class="hidden absolute top-3 left-3 bg-rose-500 text-white text-[10px] font-black px-2.5 py-1 rounded-lg uppercase tracking-wider shadow-sm z-10">
            Prescription Required
          </span>

          <img id="med-img" src="" alt="Medicine Product" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" />
        </div>

        <div class="p-3.5 bg-blueLight/60 rounded-2xl border border-blue-200/80 text-xs text-slate-600 space-y-1">
          <div class="flex items-center gap-1.5 font-extrabold text-blueBrand">
            <span class="material-symbols-outlined text-base">verified</span>
            <span>100% Genuine Pharmacy Sourced</span>
          </div>
          <p class="text-[11px] font-semibold text-slate-500">Stored at controlled temperatures. Certified by Bhusawal Partner Pharmacists.</p>
        </div>
      </div>

      <!-- RIGHT 7 COLS: METADATA, PRICE & ADD TO CART -->
      <div class="md:col-span-7 space-y-5">
        
        <div>
          <span id="med-brand-cat" class="text-xs font-black text-blueBrand uppercase tracking-wider block mb-1">BRAND • CATEGORY</span>
          <h1 id="med-title" class="text-xl sm:text-2xl font-black font-display text-slate-900 leading-tight">Loading Medicine Details...</h1>
          <p id="med-salt" class="text-xs font-extrabold text-slate-500 mt-1">Salt Composition: <span class="text-slate-800" id="salt-text">Paracetamol 650mg</span></p>
        </div>

        <!-- PACK SIZE & RATING BADGES -->
        <div class="flex items-center gap-3">
          <span id="med-pack" class="px-3 py-1 bg-slate-100 text-slate-700 font-extrabold text-xs rounded-lg border border-slate-200">Strip of 15 Tablets</span>
          <span id="med-rating" class="px-2.5 py-1 bg-amber-50 text-amber-700 font-black text-xs rounded-lg border border-amber-200 flex items-center gap-1">⭐ 4.8 Rating</span>
        </div>

        <!-- PRICE & DISCOUNT -->
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-1">
          <div class="flex items-baseline gap-2">
            <span id="med-price" class="text-3xl font-black font-display text-slate-900">₹0</span>
            <span id="med-mrp" class="text-sm font-bold text-slate-400 line-through">₹0</span>
            <span id="med-off" class="text-xs font-black text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">10% OFF</span>
          </div>
          <p class="text-[11px] text-slate-400 font-bold">Inclusive of all taxes + ₹30 Delivery Fee at Checkout</p>
        </div>

        <!-- ADD TO CART & QUANTITY SELECTOR CONTROLS -->
        <div class="space-y-3 pt-2">
          <div id="add-action-box">
            <button id="btn-add-main" class="w-full py-4 bg-blueBrand hover:bg-blueDark text-white font-black text-sm rounded-2xl shadow-lg shadow-blue-900/20 active:scale-95 transition-all flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-lg">add_shopping_cart</span>
              <span>Add to Cart</span>
            </button>

            <div id="qty-stepper-box" class="hidden flex items-center justify-between w-full bg-blueBrand text-white font-black rounded-2xl overflow-hidden p-1 shadow-md">
              <button id="btn-qty-minus" class="w-12 h-12 flex items-center justify-center hover:bg-blueDark transition-colors text-xl">-</button>
              <span id="qty-val" class="text-base font-black px-4">1</span>
              <button id="btn-qty-plus" class="w-12 h-12 flex items-center justify-center hover:bg-blueDark transition-colors text-xl">+</button>
            </div>
          </div>
        </div>

        <!-- PRODUCT DESCRIPTION & USES -->
        <div class="space-y-3 pt-4 border-t border-slate-100">
          <h3 class="text-sm font-black font-display text-slate-900 uppercase tracking-wider">Product Highlights & Directions</h3>
          <p id="med-desc" class="text-xs font-semibold text-slate-600 leading-relaxed">
            Formulated to provide fast relief from pain and fever symptoms. Always follow your doctor's dosage instructions.
          </p>
        </div>

      </div>

    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE DETAILS & CART ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      const DEFAULT_MEDICINE = {
        id: 'M1',
        name: 'Dolo 650mg Tablet',
        brand: 'Micro Labs',
        salt: 'Paracetamol (650mg)',
        category: 'Pain Relief',
        disease: 'Fever & Body Pain',
        price: 32,
        mrp: 35,
        rating: 4.8,
        pack: 'Strip of 15 Tablets',
        rxRequired: false,
        image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80',
        desc: 'Dolo 650mg Tablet helps relieve pain and fever by blocking the release of certain chemical messengers responsible for fever and pain.'
      };

      function getCart() {
        try { return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]'); }
        catch(e) { return []; }
      }

      function saveCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateCartBadge();
        updateStepperUI();
      }

      function updateCartBadge() {
        const cart = getCart();
        const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        document.getElementById('detail-cart-badge').textContent = count;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const reqId = urlParams.get('id') || 'M1';

      // Sample dataset lookup or default fallback
      const catalog = [
        DEFAULT_MEDICINE,
        { id: 'M2', name: 'Crocin Advance 500mg', brand: 'GSK', salt: 'Paracetamol (500mg)', category: 'Cold & Fever', price: 28, mrp: 30, rating: 4.7, pack: 'Strip of 15 Tablets', rxRequired: false, image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80', desc: 'Fast pain relief tablet with Optizorb technology for rapid absorption.' },
        { id: 'M3', name: 'Allegra 120mg Anti-Allergy', brand: 'Sanofi', salt: 'Fexofenadine (120mg)', category: 'Cold & Fever', price: 195, mrp: 210, rating: 4.9, pack: 'Strip of 10 Tablets', rxRequired: true, image: 'https://images.unsplash.com/photo-1471864190281-a93a3070b6de?auto=format&fit=crop&w=800&q=80', desc: 'Provides non-drowsy relief from allergy symptoms like sneezing, runny nose, and itchy eyes.' }
      ];

      const currentItem = catalog.find(i => i.id === reqId) || DEFAULT_MEDICINE;

      // Populate UI
      document.getElementById('med-title').textContent = currentItem.name;
      document.getElementById('med-brand-cat').textContent = `${currentItem.brand} • ${currentItem.category}`;
      document.getElementById('salt-text').textContent = currentItem.salt;
      document.getElementById('med-pack').textContent = currentItem.pack;
      document.getElementById('med-rating').textContent = `⭐ ${currentItem.rating} Rating`;
      document.getElementById('med-price').textContent = `₹${currentItem.price}`;
      document.getElementById('med-mrp').textContent = `₹${currentItem.mrp}`;
      document.getElementById('med-desc').textContent = currentItem.desc;
      document.getElementById('med-img').src = currentItem.image;

      if (currentItem.rxRequired) {
        document.getElementById('rx-badge').classList.remove('hidden');
      }

      function updateStepperUI() {
        const cart = getCart();
        const existing = cart.find(i => i.id === currentItem.id);
        const addBtn = document.getElementById('btn-add-main');
        const stepper = document.getElementById('qty-stepper-box');
        const qtyVal = document.getElementById('qty-val');

        if (existing && existing.quantity > 0) {
          addBtn.classList.add('hidden');
          stepper.classList.remove('hidden');
          qtyVal.textContent = existing.quantity;
        } else {
          addBtn.classList.remove('hidden');
          stepper.classList.add('hidden');
        }
      }

      document.getElementById('btn-add-main')?.addEventListener('click', () => {
        let cart = getCart();
        const existing = cart.find(i => i.id === currentItem.id);
        if (existing) {
          existing.quantity = (existing.quantity || 1) + 1;
        } else {
          cart.push({
            id: currentItem.id,
            name: currentItem.name,
            price: currentItem.price,
            mrp: currentItem.mrp,
            image: currentItem.image,
            quantity: 1,
            restaurant: currentItem.brand || 'Bhusawal Express Pharmacy',
            cat: currentItem.category || 'Medicines',
            rxRequired: currentItem.rxRequired
          });
        }
        saveCart(cart);
      });

      document.getElementById('btn-qty-plus')?.addEventListener('click', () => {
        let cart = getCart();
        const item = cart.find(i => i.id === currentItem.id);
        if (item) {
          item.quantity = (item.quantity || 1) + 1;
          saveCart(cart);
        }
      });

      document.getElementById('btn-qty-minus')?.addEventListener('click', () => {
        let cart = getCart();
        const idx = cart.findIndex(i => i.id === currentItem.id);
        if (idx > -1) {
          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            cart.splice(idx, 1);
          }
          saveCart(cart);
        }
      });

      updateCartBadge();
      updateStepperUI();
    });
  </script>

</body>
</html>
