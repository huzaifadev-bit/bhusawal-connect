---
import Switcher from '../components/Switcher.astro';
import catalog from '../../public/grocery_catalog.json';

// Build store catalog datasets from real grocery_catalog.json
const totalProducts = catalog.length;

// Filter subset samples for specific stores
const dairyProducts = catalog.filter(p => (p.Category || '').includes('Dairy') || (p["Product Name"] || '').toLowerCase().includes('milk') || (p["Product Name"] || '').toLowerCase().includes('paneer')).slice(0, 40);
const foodProducts = catalog.filter(p => (p.Category || '').includes('Instant') || (p.Category || '').includes('Snacks') || (p["Product Name"] || '').toLowerCase().includes('maggi') || (p["Product Name"] || '').toLowerCase().includes('biryani')).slice(0, 40);
const pharmacyProducts = catalog.filter(p => (p.Category || '').includes('Personal') || (p.Category || '').includes('Wellness') || (p["Product Name"] || '').toLowerCase().includes('dettol') || (p["Product Name"] || '').toLowerCase().includes('nivea')).slice(0, 40);
const icecreamProducts = catalog.filter(p => (p.Category || '').includes('Beverages') || (p["Product Name"] || '').toLowerCase().includes('ice') || (p["Product Name"] || '').toLowerCase().includes('cadbury') || (p["Product Name"] || '').toLowerCase().includes('amul')).slice(0, 40);
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Local Stores & Shops | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            purpleBrand: '#7c3aed',
            purpleDark: '#6d28d9',
            purpleLight: '#f3e8ff'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="min-h-screen pb-32 text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <a href="/home" class="flex items-center gap-1.5">
        <span class="text-lg font-black font-display text-purpleBrand tracking-tight">bhusawal<span class="text-slate-900">connect</span></span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <span class="px-3 py-1 bg-purple-50 text-purpleBrand text-xs font-black rounded-xl border border-purple-100">
        🏬 Verified Stores
      </span>
    </div>
  </header>

  <!-- STORES DIRECTORY INDEX VIEW (SHOWN WHEN NO STORE SELECTED) -->
  <main id="stores-index-view" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <div class="border-b border-slate-200/60 pb-4">
      <h1 class="text-2xl sm:text-3xl font-black font-display text-slate-900">Bhusawal Partner Stores</h1>
      <p class="text-xs font-bold text-slate-400 mt-0.5">Order directly from your favorite local supermarkets, bakeries & pharmacies</p>
    </div>

    <!-- STORES CARDS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      <!-- STORE 1: Express Superstore -->
      <div class="store-select-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-purple-200 transition-all cursor-pointer overflow-hidden group" data-id="express_superstore">
        <div class="h-36 w-full relative overflow-hidden bg-slate-100">
          <img src="https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=800&q=80" alt="Bhusawal Express Superstore" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
          <span class="absolute top-3 right-3 px-2.5 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase shadow-xs">Open Now</span>
        </div>
        <div class="p-5 space-y-3 relative">
          <div class="w-14 h-14 rounded-2xl bg-white p-1 shadow-lg border border-slate-100 -mt-10 mb-2 relative z-10 flex items-center justify-center text-2xl">
            🏬
          </div>
          <div>
            <h3 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">Bhusawal Express Superstore</h3>
            <p class="text-xs font-bold text-slate-400">Shivaji Nagar • 25,500+ Products</p>
          </div>
          <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
            <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> 4.9 (1,240+)</span>
            <span>⏱️ 10-15 Mins</span>
            <span>7:00 AM - 10:30 PM</span>
          </div>
        </div>
      </div>

      <!-- STORE 2: Royal Biryani & Caterers -->
      <div class="store-select-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-purple-200 transition-all cursor-pointer overflow-hidden group" data-id="royal_biryani">
        <div class="h-36 w-full relative overflow-hidden bg-slate-100">
          <img src="https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80" alt="Royal Biryani & Caterers" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
          <span class="absolute top-3 right-3 px-2.5 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase shadow-xs">Open Now</span>
        </div>
        <div class="p-5 space-y-3 relative">
          <div class="w-14 h-14 rounded-2xl bg-white p-1 shadow-lg border border-slate-100 -mt-10 mb-2 relative z-10 flex items-center justify-center text-2xl">
            🍲
          </div>
          <div>
            <h3 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">Royal Biryani & Caterers</h3>
            <p class="text-xs font-bold text-slate-400">Jamner Road • Mughlai & North Indian</p>
          </div>
          <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
            <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> 4.8 (850+)</span>
            <span>⏱️ 20-25 Mins</span>
            <span>11:00 AM - 11:00 PM</span>
          </div>
        </div>
      </div>

      <!-- STORE 3: Modern Pharmacy -->
      <div class="store-select-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-purple-200 transition-all cursor-pointer overflow-hidden group" data-id="modern_pharmacy">
        <div class="h-36 w-full relative overflow-hidden bg-slate-100">
          <img src="https://images.unsplash.com/photo-1586015555751-63bb77f4322a?auto=format&fit=crop&w=800&q=80" alt="Modern Pharmacy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
          <span class="absolute top-3 right-3 px-2.5 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase shadow-xs">Open Now</span>
        </div>
        <div class="p-5 space-y-3 relative">
          <div class="w-14 h-14 rounded-2xl bg-white p-1 shadow-lg border border-slate-100 -mt-10 mb-2 relative z-10 flex items-center justify-center text-2xl">
            💊
          </div>
          <div>
            <h3 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">Modern Pharmacy & Wellness</h3>
            <p class="text-xs font-bold text-slate-400">Station Road • Medicines & Hygiene</p>
          </div>
          <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
            <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> 4.9 (920+)</span>
            <span>⏱️ 10-15 Mins</span>
            <span>8:00 AM - 10:00 PM</span>
          </div>
        </div>
      </div>

      <!-- STORE 4: Shiv Dairy & Sweets -->
      <div class="store-select-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-purple-200 transition-all cursor-pointer overflow-hidden group" data-id="shiv_dairy">
        <div class="h-36 w-full relative overflow-hidden bg-slate-100">
          <img src="https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80" alt="Shiv Dairy & Sweets" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
          <span class="absolute top-3 right-3 px-2.5 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase shadow-xs">Open Now</span>
        </div>
        <div class="p-5 space-y-3 relative">
          <div class="w-14 h-14 rounded-2xl bg-white p-1 shadow-lg border border-slate-100 -mt-10 mb-2 relative z-10 flex items-center justify-center text-2xl">
            🥛
          </div>
          <div>
            <h3 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">Shiv Dairy & Sweets</h3>
            <p class="text-xs font-bold text-slate-400">Varangaon Road • Fresh Milk, Paneer & Sweets</p>
          </div>
          <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
            <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> 4.9 (1,500+)</span>
            <span>⏱️ 10-15 Mins</span>
            <span>6:00 AM - 10:00 PM</span>
          </div>
        </div>
      </div>

      <!-- STORE 5: Kwality Wall's Hub -->
      <div class="store-select-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-purple-200 transition-all cursor-pointer overflow-hidden group" data-id="kwality_hub">
        <div class="h-36 w-full relative overflow-hidden bg-slate-100">
          <img src="https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80" alt="Kwality Wall's Hub" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
          <span class="absolute top-3 right-3 px-2.5 py-1 bg-emerald-500 text-white text-[10px] font-black rounded-full uppercase shadow-xs">Open Now</span>
        </div>
        <div class="p-5 space-y-3 relative">
          <div class="w-14 h-14 rounded-2xl bg-white p-1 shadow-lg border border-slate-100 -mt-10 mb-2 relative z-10 flex items-center justify-center text-2xl">
            🍦
          </div>
          <div>
            <h3 class="text-base font-black font-display text-slate-900 group-hover:text-purpleBrand transition-colors">Kwality Wall's Ice Cream Hub</h3>
            <p class="text-xs font-bold text-slate-400">City Center • Desserts & Shakes</p>
          </div>
          <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
            <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> 4.7 (610+)</span>
            <span>⏱️ 12-18 Mins</span>
            <span>10:00 AM - 11:30 PM</span>
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- INDIVIDUAL DYNAMIC STORE PAGE VIEW (CONTAINER) -->
  <main id="single-store-view" class="hidden max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    
    <!-- BACK TO STORES BUTTON -->
    <button id="btn-back-stores" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white border border-slate-200 text-slate-700 font-extrabold text-xs rounded-xl hover:bg-slate-100 transition-all shadow-xs">
      <span class="material-symbols-outlined text-base">arrow_back</span>
      <span>Back to All Stores</span>
    </button>

    <!-- STORE COVER & HEADER HERO -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden space-y-4">
      
      <!-- Cover Banner Image -->
      <div class="h-44 sm:h-56 w-full relative bg-slate-100">
        <img id="store-cover-img" src="" alt="Store Cover" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-slate-900/20 to-transparent"></div>
        <span id="store-status-badge" class="absolute top-4 right-4 px-3 py-1 bg-emerald-500 text-white text-xs font-black rounded-full uppercase shadow-md">Open Now</span>
      </div>

      <!-- Store Info Content -->
      <div class="px-6 pb-6 pt-0 relative flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="flex items-start gap-4">
          <!-- Logo avatar -->
          <div id="store-logo-avatar" class="w-20 h-20 rounded-3xl bg-white p-2 shadow-xl border border-slate-100 -mt-12 relative z-10 flex items-center justify-center text-4xl shrink-0">
            🏬
          </div>
          <div class="space-y-1">
            <h1 id="store-name-title" class="text-2xl sm:text-3xl font-black font-display text-slate-900">Bhusawal Express Superstore</h1>
            <p id="store-tag-desc" class="text-xs font-bold text-slate-400">Shivaji Nagar • Supermarket</p>
            <div class="flex flex-wrap items-center gap-3 text-xs font-black text-slate-700 pt-1">
              <span class="flex items-center gap-1 text-amber-600"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span> <span id="store-rating-val">4.9</span></span>
              <span>⏱️ <span id="store-eta-val">10-15 Mins</span></span>
              <span>🕒 <span id="store-timing-val">7:00 AM - 10:30 PM</span></span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- STICKY STORE SEARCH BAR -->
    <div class="sticky top-20 z-40 bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-slate-200 shadow-md">
      <div class="relative w-full">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
        <input type="text" id="store-search-input" placeholder="Search within this store (e.g. Milk, Biryani, Oil)..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-2 text-xs font-bold text-slate-900 outline-none focus:border-purpleBrand focus:bg-white transition-all" />
      </div>
    </div>

    <!-- STORE PRODUCT GRID -->
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h2 class="text-lg font-black font-display text-slate-900" id="store-grid-heading">Store Products</h2>
        <span class="text-xs font-bold text-slate-400" id="store-product-count">Showing catalog items</span>
      </div>

      <div id="store-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <!-- Dynamically rendered -->
      </div>
    </div>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE STORE LOGIC -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      const indexView = document.getElementById('stores-index-view');
      const singleView = document.getElementById('single-store-view');
      const storeSearchInput = document.getElementById('store-search-input');

      // STORES DATABASE SCHEMA (USES EXISTING CATALOG DATA)
      const STORES = {
        express_superstore: {
          name: 'Bhusawal Express Superstore',
          tag: 'Shivaji Nagar • 25,500+ Supermarket Items',
          rating: '4.9 (1,240+ Ratings)',
          eta: '10-15 Mins Doorstep Delivery',
          timing: '7:00 AM - 10:30 PM',
          cover: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?auto=format&fit=crop&w=800&q=80',
          logo: '🏬',
          filterKw: ''
        },
        royal_biryani: {
          name: 'Royal Biryani & Caterers',
          tag: 'Jamner Road • Mughlai, Biryani & Fast Food',
          rating: '4.8 (850+ Ratings)',
          eta: '20-25 Mins Express Delivery',
          timing: '11:00 AM - 11:00 PM',
          cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80',
          logo: '🍲',
          filterKw: 'biryani'
        },
        modern_pharmacy: {
          name: 'Modern Pharmacy & Wellness',
          tag: 'Station Road • Essential Medicines & Hygiene',
          rating: '4.9 (920+ Ratings)',
          eta: '10-15 Mins Priority Delivery',
          timing: '8:00 AM - 10:00 PM',
          cover: 'https://images.unsplash.com/photo-1586015555751-63bb77f4322a?auto=format&fit=crop&w=800&q=80',
          logo: '💊',
          filterKw: 'personal'
        },
        shiv_dairy: {
          name: 'Shiv Dairy & Sweets',
          tag: 'Varangaon Road • Fresh Milk, Paneer, Curd & Sweets',
          rating: '4.9 (1,500+ Ratings)',
          eta: '10-15 Mins Fresh Delivery',
          timing: '6:00 AM - 10:00 PM',
          cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80',
          logo: '🥛',
          filterKw: 'dairy'
        },
        kwality_hub: {
          name: 'Kwality Wall's Ice Cream Hub',
          tag: 'City Center • Ice Creams, Shakes & Frozen Desserts',
          rating: '4.7 (610+ Ratings)',
          eta: '12-18 Mins Cold-Chain Delivery',
          timing: '10:00 AM - 11:30 PM',
          cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80',
          logo: '🍦',
          filterKw: 'beverages'
        }
      };

      let activeStoreId = null;
      let activeStoreProducts = [];

      // Open Store Page Function
      function openStorePage(storeId) {
        const store = STORES[storeId] || STORES.express_superstore;
        activeStoreId = storeId;

        document.getElementById('store-cover-img').src = store.cover;
        document.getElementById('store-logo-avatar').textContent = store.logo;
        document.getElementById('store-name-title').textContent = store.name;
        document.getElementById('store-tag-desc').textContent = store.tag;
        document.getElementById('store-rating-val').textContent = store.rating;
        document.getElementById('store-eta-val').textContent = store.eta;
        document.getElementById('store-timing-val').textContent = store.timing;

        // Fetch products for store from global catalog dataset window
        window.fetchStoreProducts(store.filterKw, (products) => {
          activeStoreProducts = products;
          renderStoreProducts('');
        });

        indexView.classList.add('hidden');
        singleView.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function renderStoreProducts(query) {
        const grid = document.getElementById('store-products-grid');
        const countEl = document.getElementById('store-product-count');

        let filtered = activeStoreProducts;
        if (query) {
          const q = query.toLowerCase();
          filtered = activeStoreProducts.filter(p => 
            (p.name || '').toLowerCase().includes(q) || 
            (p.brand || '').toLowerCase().includes(q)
          );
        }

        if (countEl) countEl.textContent = `${filtered.length} products available`;

        if (filtered.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full bg-white rounded-3xl p-8 text-center space-y-2 border border-slate-100">
              <span class="material-symbols-outlined text-3xl text-slate-300">search_off</span>
              <p class="text-xs font-black text-slate-800">No products match "${query}" in this store</p>
            </div>
          `;
          return;
        }

        let html = '';
        filtered.forEach(p => {
          const id = p.id;
          const name = p.name;
          const mrp = p.mrp;
          const img = p.img;
          const pack = p.pack;

          html += `
            <div class="bg-white rounded-3xl border border-slate-100 p-3 flex flex-col justify-between shadow-xs hover:shadow-lg hover:border-purple-200 transition-all group">
              <div>
                <div class="w-full aspect-square bg-slate-50/80 rounded-2xl p-2 mb-2 flex items-center justify-center border border-slate-100 overflow-hidden">
                  <img src="${img}" alt="${name}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                </div>
                <h3 class="text-xs sm:text-[13px] font-bold text-slate-800 line-clamp-2 leading-snug min-h-[2.2rem]">${name}</h3>
                <p class="text-[11px] font-semibold text-slate-400 mt-0.5">${pack}</p>
              </div>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-1 mt-2">
                <span class="text-xs sm:text-sm font-black text-slate-900">MRP ₹${mrp}</span>
                <button class="btn-add-store-cart px-3 py-1.5 bg-purple-50 text-purpleBrand hover:bg-purpleBrand hover:text-white border border-purple-200 text-[10px] font-black rounded-xl active:scale-90 transition-all" data-id="${id}" data-name="${name.replace(/"/g, '&quot;')}" data-price="${mrp}" data-img="${img}">
                  + ADD
                </button>
              </div>
            </div>
          `;
        });

        grid.innerHTML = html;

        // Bind Cart Add Action
        grid.querySelectorAll('.btn-add-store-cart').forEach(btn => {
          btn.onclick = () => {
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            const price = parseFloat(btn.dataset.price);
            const img = btn.dataset.img;

            let cart = [];
            try {
              cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
            } catch(e) {}

            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity = (existing.quantity || 1) + 1;
            } else {
              cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Store Item' });
            }

            localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
            btn.textContent = '✓ ADDED';
            btn.classList.replace('bg-purple-50', 'bg-emerald-600');
            btn.classList.replace('text-purpleBrand', 'text-white');
            setTimeout(() => {
              btn.textContent = '+ ADD';
              btn.classList.replace('bg-emerald-600', 'bg-purple-50');
              btn.classList.replace('text-white', 'text-purpleBrand');
            }, 1200);
          };
        });
      }

      // Store Click Event Listeners
      document.querySelectorAll('.store-select-card').forEach(card => {
        card.addEventListener('click', () => {
          openStorePage(card.dataset.id);
        });
      });

      // Back Button
      document.getElementById('btn-back-stores')?.addEventListener('click', () => {
        singleView.classList.add('hidden');
        indexView.classList.remove('hidden');
      });

      // Store Search Input
      storeSearchInput?.addEventListener('input', (e) => {
        renderStoreProducts(e.target.value.trim());
      });

      // Check URL parameters (e.g. /shops?id=express_superstore)
      const params = new URLSearchParams(window.location.search);
      const storeIdParam = params.get('id');
      if (storeIdParam && STORES[storeIdParam]) {
        openStorePage(storeIdParam);
      }

    });
  </script>

  <!-- HELPER SCRIPT TO FETCH PRODUCTS FROM INLINE ASTRO JSON -->
  <script is:inline>
    window.fetchStoreProducts = function(kw, callback) {
      fetch('/grocery_catalog.json')
        .then(res => res.json())
        .then(data => {
          let items = data;
          if (kw) {
            items = data.filter(p => 
              (p.Category || '').toLowerCase().includes(kw.toLowerCase()) || 
              (p["Product Name"] || '').toLowerCase().includes(kw.toLowerCase())
            );
          }
          const formatted = items.slice(0, 100).map(p => ({
            id: p["Product ID"] || p.ProductID || p.id,
            name: p["Product Name"] || p.name,
            mrp: parseFloat(p.MRP || p.mrp || p["Selling Price"] || p.sp || 50),
            img: p["Product Image URL"] || p.img || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg',
            pack: p["Pack Size"] || p.pack || '1 Unit'
          }));
          callback(formatted);
        })
        .catch(err => {
          console.error("Failed to load store products", err);
          callback([]);
        });
    };
  </script>
</body>
</html>
