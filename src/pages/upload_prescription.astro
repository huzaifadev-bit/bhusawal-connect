---
import Switcher from '../components/Switcher.astro';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upload Doctor Prescription | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- CLEAN LIGHT BLUE (#3B82F6) & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            blueBrand: '#3B82F6',
            blueDark: '#2563EB',
            blueLight: '#EFF6FF'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="pb-32 max-w-4xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/medicines" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors active:scale-95">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="text-base sm:text-lg font-black font-display text-slate-900 leading-tight flex items-center gap-2">
          <span>📋 Upload Prescription</span>
          <span class="bg-blueLight text-blueBrand text-[10px] font-black px-2 py-0.5 rounded-full uppercase border border-blue-200">EXPRESS RX</span>
        </h1>
        <p class="text-xs text-slate-500 font-medium">Licensed Pharmacist Verification & Fast Doorstep Delivery</p>
      </div>
    </div>

    <a href="/cart" class="w-10 h-10 rounded-full bg-blueLight text-blueBrand flex items-center justify-center font-bold hover:bg-blueBrand hover:text-white transition-all shadow-xs">
      <span class="material-symbols-outlined text-xl">shopping_bag</span>
    </a>
  </header>

  <main class="px-4 sm:px-6 py-6 space-y-6">

    <!-- HERO BANNER -->
    <div class="bg-gradient-to-r from-blueLight via-white to-blue-50/50 rounded-3xl p-6 border border-blue-100 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1.5 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-600 text-[10px] font-black px-2.5 py-0.5 rounded-full border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Pharmacists Active 24x7
          </span>
          <span class="inline-flex items-center gap-1 bg-blue-50 text-blueBrand text-[10px] font-black px-2.5 py-0.5 rounded-full border border-blue-200">
            🛡️ 100% Confidential
          </span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black font-display text-slate-900 tracking-tight">Need Medicines via Prescription?</h2>
        <p class="text-xs sm:text-sm text-slate-600 font-medium max-w-lg">Upload your prescription photo or document. Our verified Bhusawal chemist will process your order within 10-15 minutes!</p>
      </div>
      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-blueBrand text-white flex items-center justify-center shadow-lg shrink-0">
        <span class="material-symbols-outlined text-4xl sm:text-5xl">description</span>
      </div>
    </div>

    <!-- UPLOAD SELECTION CARDS -->
    <div class="grid grid-cols-2 gap-4">
      <!-- Hidden file inputs -->
      <input type="file" id="camera-input" accept="image/*" capture="environment" class="hidden" />
      <input type="file" id="gallery-input" accept="image/*" class="hidden" />

      <!-- Camera Option -->
      <button id="btn-camera" type="button" class="group flex flex-col items-center justify-center p-6 rounded-3xl bg-white border border-slate-200/80 shadow-sm hover:shadow-md hover:border-blueBrand transition-all active:scale-95 text-center space-y-3 cursor-pointer">
        <div class="w-14 h-14 rounded-2xl bg-blueLight text-blueBrand group-hover:bg-blueBrand group-hover:text-white transition-colors flex items-center justify-center shadow-xs">
          <span class="material-symbols-outlined text-3xl">photo_camera</span>
        </div>
        <div>
          <h3 class="text-sm font-black font-display text-slate-900 group-hover:text-blueBrand transition-colors">Take Photo</h3>
          <p class="text-[11px] text-slate-500 font-medium">Use Phone Camera</p>
        </div>
      </button>

      <!-- Gallery Option -->
      <button id="btn-gallery" type="button" class="group flex flex-col items-center justify-center p-6 rounded-3xl bg-white border border-slate-200/80 shadow-sm hover:shadow-md hover:border-blueBrand transition-all active:scale-95 text-center space-y-3 cursor-pointer">
        <div class="w-14 h-14 rounded-2xl bg-blueLight text-blueBrand group-hover:bg-blueBrand group-hover:text-white transition-colors flex items-center justify-center shadow-xs">
          <span class="material-symbols-outlined text-3xl">image</span>
        </div>
        <div>
          <h3 class="text-sm font-black font-display text-slate-900 group-hover:text-blueBrand transition-colors">Choose File</h3>
          <p class="text-[11px] text-slate-500 font-medium">Gallery or PDF</p>
        </div>
      </button>
    </div>

    <!-- UPLOAD PREVIEW STATUS BOX -->
    <div id="upload-status" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-4 flex items-center justify-between gap-4 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-white p-1 border border-emerald-200 overflow-hidden shrink-0 shadow-xs">
          <img src="" alt="Prescription Preview" class="w-full h-full object-cover rounded-lg" id="status-preview-img" />
        </div>
        <div>
          <h4 class="text-xs font-black text-slate-900 truncate max-w-[200px] sm:max-w-xs" id="status-file-name">prescription.jpg</h4>
          <p class="text-[11px] font-bold text-emerald-600 flex items-center gap-1 mt-0.5">
            <span class="material-symbols-outlined text-sm">check_circle</span>
            Prescription attached & ready
          </p>
        </div>
      </div>
      <button id="btn-remove" type="button" class="text-xs font-black text-rose-600 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-xl border border-rose-200 transition-colors">
        Remove
      </button>
    </div>

    <!-- PREFERRED PHARMACY OPTIONAL CARD -->
    <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-blueLight text-blueBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-lg">store</span>
        </div>
        <div>
          <h3 class="text-sm font-black font-display text-slate-900">Pharmacy Preference</h3>
          <p class="text-[11px] text-slate-500 font-medium">Optional — Specify store name or leave blank for nearest verified partner</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
        <div>
          <label for="pharmacy-name-choice" class="text-[11px] font-bold text-slate-600 block mb-1">Pharmacy Name</label>
          <input type="text" id="pharmacy-name-choice" placeholder="e.g. Apollo Pharmacy, Samarth Medical" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blueBrand/40 transition-all" />
        </div>
        <div>
          <label for="pharmacy-address-choice" class="text-[11px] font-bold text-slate-600 block mb-1">Store Area / Landmark</label>
          <input type="text" id="pharmacy-address-choice" placeholder="e.g. Station Road, Jamner Gate" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blueBrand/40 transition-all" />
        </div>
      </div>
    </div>

    <!-- HOW IT WORKS STEPS -->
    <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm space-y-4">
      <h3 class="text-xs font-black uppercase tracking-wider text-slate-400 font-display">How Express Delivery Works</h3>
      
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-blueBrand text-white flex items-center justify-center text-xs font-black shrink-0 mt-0.5">1</div>
          <div>
            <h4 class="text-xs font-black text-slate-900">Upload Doctor Prescription</h4>
            <p class="text-[11px] text-slate-500 font-medium">Take a clear picture or upload document containing doctor's seal & patient info.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-blueBrand text-white flex items-center justify-center text-xs font-black shrink-0 mt-0.5">2</div>
          <div>
            <h4 class="text-xs font-black text-slate-900">Pharmacist Verification</h4>
            <p class="text-[11px] text-slate-500 font-medium">Our licensed chemist reviews dosage and calls you if any substitute is required.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-blueBrand text-white flex items-center justify-center text-xs font-black shrink-0 mt-0.5">3</div>
          <div>
            <h4 class="text-xs font-black text-slate-900">10-15 Min Express Delivery</h4>
            <p class="text-[11px] text-slate-500 font-medium">Rider picks up packed medicines directly from pharmacy and delivers to your doorstep.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SUBMIT / CONTINUE BUTTON -->
    <div class="pt-2">
      <button 
        id="btn-continue" 
        disabled 
        type="button" 
        class="w-full py-4 bg-slate-200 text-slate-400 font-black text-sm rounded-2xl cursor-not-allowed transition-all shadow-md flex items-center justify-center gap-2"
      >
        <span>Submit Prescription & Track Order</span>
        <span class="material-symbols-outlined text-lg">arrow_forward</span>
      </button>
    </div>

  </main>

  <Switcher />

  <script is:inline>
    (function() {
      var cameraInput = document.getElementById('camera-input');
      var galleryInput = document.getElementById('gallery-input');
      var btnCamera = document.getElementById('btn-camera');
      var btnGallery = document.getElementById('btn-gallery');
      var btnRemove = document.getElementById('btn-remove');
      var statusBox = document.getElementById('upload-status');
      var btnContinue = document.getElementById('btn-continue');
      var previewImg = document.getElementById('status-preview-img');
      var fileNameEl = document.getElementById('status-file-name');
      var currentObjectUrl = null;

      var defaultPreviewSrc = 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=200&q=80';

      if (btnCamera && cameraInput) {
        btnCamera.addEventListener('click', function() {
          cameraInput.value = '';
          cameraInput.click();
        });
      }

      if (btnGallery && galleryInput) {
        btnGallery.addEventListener('click', function() {
          galleryInput.value = '';
          galleryInput.click();
        });
      }

      function handleFileSelection(e) {
        var files = e.target.files;
        if (files && files[0]) {
          var file = files[0];

          if (fileNameEl) fileNameEl.textContent = file.name;

          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
          }

          if (previewImg) {
            previewImg.onerror = function() {
              this.src = defaultPreviewSrc;
            };

            if (file.type && file.type.startsWith('image/')) {
              currentObjectUrl = URL.createObjectURL(file);
              previewImg.src = currentObjectUrl;
            } else {
              previewImg.src = defaultPreviewSrc;
            }
          }

          if (statusBox) statusBox.classList.remove('hidden');

          if (btnContinue) {
            btnContinue.disabled = false;
            btnContinue.classList.remove('bg-slate-200', 'text-slate-400', 'cursor-not-allowed');
            btnContinue.classList.add('bg-blueBrand', 'hover:bg-blueDark', 'text-white', 'shadow-lg', 'active:scale-95');
          }
        }
      }

      if (cameraInput) cameraInput.addEventListener('change', handleFileSelection);
      if (galleryInput) galleryInput.addEventListener('change', handleFileSelection);

      if (btnRemove) {
        btnRemove.addEventListener('click', function() {
          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
          }
          if (statusBox) statusBox.classList.add('hidden');
          if (cameraInput) cameraInput.value = '';
          if (galleryInput) galleryInput.value = '';

          if (btnContinue) {
            btnContinue.disabled = true;
            btnContinue.classList.add('bg-slate-200', 'text-slate-400', 'cursor-not-allowed');
            btnContinue.classList.remove('bg-blueBrand', 'hover:bg-blueDark', 'text-white', 'shadow-lg', 'active:scale-95');
          }
        });
      }

      if (btnContinue) {
        btnContinue.addEventListener('click', function() {
          var nameChoice = (document.getElementById('pharmacy-name-choice') || {}).value || '';
          var addressChoice = (document.getElementById('pharmacy-address-choice') || {}).value || '';

          var pharmacyDisplay = 'Nearest Partner Pharmacy';
          if (nameChoice.trim()) {
            pharmacyDisplay = nameChoice.trim();
            if (addressChoice.trim()) {
              pharmacyDisplay += ' (' + addressChoice.trim() + ')';
            }
          }

          var orderId = 'RX-BHU-' + Math.floor(100000 + Math.random() * 900000);
          var rxOrder = {
            id: orderId,
            type: 'PRESCRIPTION',
            patientName: 'Customer',
            mobile: '9876543210',
            address: 'Varangaon Road, Bhusawal',
            notes: 'Prescription uploaded directly',
            storeChoice: nameChoice.trim() ? 'PREFERRED' : 'NEAREST',
            pharmacy: pharmacyDisplay,
            fileName: (fileNameEl ? fileNameEl.textContent : '') || 'Prescription.jpg',
            total: 0,
            status: 'Accepted',
            timestamp: new Date().toISOString()
          };

          try {
            localStorage.setItem('bhusawal_active_order', JSON.stringify(rxOrder));
            var orders = JSON.parse(localStorage.getItem('bhusawal_orders') || '[]');
            orders.unshift(rxOrder);
            localStorage.setItem('bhusawal_orders', JSON.stringify(orders));
          } catch(e) {}

          window.location.href = '/track_order';
        });
      }
    })();
  </script>
</body>
</html>