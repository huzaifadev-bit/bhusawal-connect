---
import Switcher from '../components/Switcher.astro';
import foodCatalog from '../../public/food_catalog.json';

// 6 DYNAMIC FEATURED PRODUCT SECTIONS
const featuredSections = [
  { id: 'popular', name: 'Popular Today', icon: '🔥', subtitle: 'Most ordered food items in Bhusawal today', slice: [0, 15] },
  { id: 'trending', name: 'Trending Near You', icon: '⚡', subtitle: 'Hot and trending dishes in your area right now', slice: [15, 30] },
  { id: 'bestsellers', name: 'Best Sellers', icon: '⭐', subtitle: 'Top rated customer favorites with 4.8+ rating', slice: [30, 45] },
  { id: 'newlyadded', name: 'Newly Added', icon: '✨', subtitle: 'Freshly introduced local cafe & hotel specialties', slice: [45, 60] },
  { id: 'recommended', name: 'Recommended For You', icon: '🎯', subtitle: 'Handpicked delicious meals based on your tastes', slice: [60, 75] },
  { id: 'frequentlyordered', name: 'Frequently Ordered', icon: '🔄', subtitle: 'Daily staples & quick meal favorites', slice: [75, 90] }
];

// Standardized 18 Food Category Sections Definition
const categorySections = [
  { id: 'breakfast', name: 'Breakfast', icon: '🍳', subtitle: 'Tarri Poha, Upma, Idli, Dosa & Morning Bites' },
  { id: 'pizza', name: 'Pizza', icon: '🍕', subtitle: 'Cheesy Margheritas, Farmhouse & Peri Peri Pizzas' },
  { id: 'burger', name: 'Burger', icon: '🍔', subtitle: 'Crispy Veg, Paneer & Chicken Burgers' },
  { id: 'sandwich', name: 'Sandwich', icon: '🥪', subtitle: 'Grilled Cheese, Veg & Club Sandwiches' },
  { id: 'rolls', name: 'Rolls', icon: '🌯', subtitle: 'Kathi Rolls, Paneer & Egg Chicken Rolls' },
  { id: 'chinese', name: 'Chinese', icon: '🍜', subtitle: 'Noodles, Manchurian, Fried Rice & Starters' },
  { id: 'biryani', name: 'Biryani', icon: '🍲', subtitle: 'Aromatic Dum Biryani, Hyderabadi & Thalis' },
  { id: 'veg_meals', name: 'Veg Meals', icon: '🥘', subtitle: 'Paneer Curries, Dal Tadka, Sev Bhaji & Main Course' },
  { id: 'chicken', name: 'Chicken', icon: '🍗', subtitle: 'Butter Chicken, Handi, Tandoori & Curries' },
  { id: 'mutton', name: 'Mutton', icon: '🍖', subtitle: 'Mutton Curry, Masala & Handi Delights' },
  { id: 'fish', name: 'Fish', icon: '🐟', subtitle: 'Fish Curry, Fish Fry & Seafood Specialties' },
  { id: 'egg', name: 'Egg', icon: '🥚', subtitle: 'Egg Curry, Bhurji, Masala & Egg Rice' },
  { id: 'rice', name: 'Rice', icon: '🍚', subtitle: 'Jeera Rice, Pulao, Dal Khichdi & Fried Rice' },
  { id: 'roti_naan', name: 'Roti & Naan', icon: '🫓', subtitle: 'Butter Roti, Garlic Naan, Laccha Paratha & Chapatis' },
  { id: 'snacks', name: 'Snacks', icon: '🍟', subtitle: 'Kanda Bhaji, Samosas, French Fries & Pakodas' },
  { id: 'desserts', name: 'Desserts', icon: '🍰', subtitle: 'Rabdi Gulab Jamun, Rasgulla, Brownie & Ice Creams' },
  { id: 'beverages', name: 'Beverages', icon: '🥤', subtitle: 'Masala Chai, Cold Coffee, Lime Soda, Shakes & Lassi' }
];

// Helper to filter items for category sections
function getItemsForCategory(secId: string) {
  if (secId === 'breakfast') return foodCatalog.filter(x => x.category === 'Breakfast');
  if (secId === 'pizza') return foodCatalog.filter(x => x.category === 'Pizza');
  if (secId === 'burger') return foodCatalog.filter(x => x.category === 'Burgers');
  if (secId === 'sandwich') return foodCatalog.filter(x => x.category === 'Sandwiches');
  if (secId === 'rolls') return foodCatalog.filter(x => x.category === 'Rolls');
  if (secId === 'chinese') return foodCatalog.filter(x => x.category === 'Chinese');
  if (secId === 'biryani') return foodCatalog.filter(x => x.category === 'Biryani');
  if (secId === 'veg_meals') return foodCatalog.filter(x => x.category === 'Veg Main Course');
  if (secId === 'chicken') return foodCatalog.filter(x => x.category === 'Chicken');
  if (secId === 'mutton') return foodCatalog.filter(x => x.category === 'Mutton');
  if (secId === 'fish') return foodCatalog.filter(x => x.category === 'Fish');
  if (secId === 'egg') return foodCatalog.filter(x => x.category === 'Egg');
  if (secId === 'rice') return foodCatalog.filter(x => x.category === 'Rice');
  if (secId === 'roti_naan') return foodCatalog.filter(x => x.category === 'Roti & Naan');
  if (secId === 'snacks') return foodCatalog.filter(x => x.category === 'Snacks');
  if (secId === 'desserts') return foodCatalog.filter(x => x.category === 'Desserts');
  if (secId === 'beverages') return foodCatalog.filter(x => x.category === 'Beverages');
  return [];
}

// Featured Partner Restaurants (1 Compact Horizontal Row Only)
const featuredPartnerRestaurants = [
  {
    id: 'royal_biryani',
    name: 'Royal Biryani & Caterers',
    logo: '🍲',
    cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80',
    rating: '4.8',
    deliveryTime: '20-25 min'
  },
  {
    id: 'sagar_grand',
    name: 'Hotel Sagar Grand',
    logo: '🏨',
    cover: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    deliveryTime: '15-20 min'
  },
  {
    id: 'shiv_dairy',
    name: 'Shiv Dairy & Sweets',
    logo: '🥛',
    cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    deliveryTime: '10-15 min'
  },
  {
    id: 'kwality_hub',
    name: "Kwality Wall's Ice Cream Hub",
    logo: '🍦',
    cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80',
    rating: '4.7',
    deliveryTime: '12-18 min'
  }
];
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Food Shopping & Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE BRAND TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="pb-32 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== TOP SECTION: DELIVERY ADDRESS, SEARCH & NOTIFICATION ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="food-address-btn">
        <div class="w-9 h-9 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-redBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-redBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="food-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button & Global Cart Button -->
    <div class="flex items-center gap-2">
      <a href="/notifications" class="relative w-10 h-10 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold hover:bg-red-100 transition-colors" title="Notifications">
        <span class="material-symbols-outlined text-xl">notifications</span>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-redBrand rounded-full border-2 border-white animate-ping"></span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-redBrand text-white flex items-center justify-center font-bold hover:bg-redDark transition-colors shadow-md group">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="food-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-7">

    <!-- ==================== SEARCH BAR & COMPREHENSIVE FILTER ENGINE ==================== -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2 space-y-2.5 relative" id="search-container-box">
      
      <!-- Search Input -->
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-redBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input 
          type="text" 
          id="food-search-input" 
          placeholder="Search 225+ dishes (Poha, Biryani, Thalis, Pizza, Burgers, Paneer, Sweets)..." 
          class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" 
          autocomplete="off" 
        />
        <button id="clear-food-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <!-- Instant Suggestions Dropdown Box -->
      <div id="food-search-suggestions" class="hidden absolute top-full left-0 right-0 mt-1.5 bg-white rounded-3xl border border-slate-200 shadow-2xl z-50 max-h-80 overflow-y-auto no-scrollbar p-2 divide-y divide-slate-100">
        <!-- Dynamic suggestion rows injected via JS -->
      </div>

      <!-- FULLY FUNCTIONAL INSTANT FILTER CHIPS (HORIZONTALLY SCROLLABLE) -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-xs font-black">
        
        <!-- Clear All Filters Pill -->
        <button id="reset-all-filters-btn" class="hidden px-3 py-1.5 rounded-full bg-rose-100 text-rose-700 hover:bg-rose-600 hover:text-white border border-rose-200 transition-all shrink-0 flex items-center gap-1 active:scale-95">
          <span class="material-symbols-outlined text-sm">restart_alt</span>
          <span>Clear Filters</span>
        </button>

        <!-- Diet Filters -->
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 flex items-center gap-1.5 active:scale-95" data-filter-type="diet" data-filter-val="veg">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
          <span>Veg</span>
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 flex items-center gap-1.5 active:scale-95" data-filter-type="diet" data-filter-val="nonveg">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-600"></span>
          <span>Non-Veg</span>
        </button>

        <!-- Meal Time Filters -->
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="meal" data-filter-val="breakfast">
          🍳 Breakfast
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="meal" data-filter-val="lunch">
          🍱 Lunch
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="meal" data-filter-val="dinner">
          🌙 Dinner
        </button>

        <!-- Cuisine & Category Filters -->
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="fastfood">
          🍔 Fast Food
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="chinese">
          🍜 Chinese
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="northindian">
          🥘 North Indian
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="southindian">
          🥞 South Indian
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="desserts">
          🍰 Desserts
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="cuisine" data-filter-val="beverages">
          🥤 Beverages
        </button>

        <!-- Price Range Filters -->
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="price" data-filter-val="under100">
          🏷️ Under ₹100
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="price" data-filter-val="100-200">
          🏷️ ₹100–₹200
        </button>
        <button class="filter-pill-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80 transition-all shrink-0 active:scale-95" data-filter-type="price" data-filter-val="above200">
          🏷️ Above ₹200
        </button>

      </div>
    </div>

    <!-- ==================== FEATURED PARTNER RESTAURANTS (1 HORIZONTAL ROW ONLY) ==================== -->
    <section class="space-y-3 pt-1 border-b border-slate-100 pb-5" id="featured-restaurants-section">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
          <span class="text-amber-500">⭐</span>
          <span>Featured Partner Restaurants</span>
        </h2>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Scroll →</span>
      </div>

      <div class="flex items-center gap-4 overflow-x-auto no-scrollbar py-1.5 px-0.5">
        {featuredPartnerRestaurants.map(rest => (
          <div 
            class="compact-rest-card w-64 sm:w-72 shrink-0 bg-white rounded-2xl border border-slate-100 shadow-xs hover:shadow-lg hover:border-redBrand transition-all cursor-pointer overflow-hidden flex flex-col justify-between group"
            onclick={`window.location.href='/shops?id=${rest.id}';`}
          >
            <div class="h-28 sm:h-32 bg-slate-100 relative overflow-hidden">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <span class="absolute top-2 left-2 px-2 py-0.5 bg-white/95 backdrop-blur-md text-emerald-700 text-[9px] font-black rounded-full uppercase tracking-wider shadow-xs border border-slate-200">
                ✓ Verified
              </span>

              <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-redBrand text-white text-[9px] font-black rounded-full shadow-xs">
                ⚡ {rest.deliveryTime}
              </span>
            </div>

            <div class="p-3 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-redLight text-redBrand flex items-center justify-center text-lg shrink-0 border border-red-100">
                {rest.logo}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-xs font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">
                  {rest.name}
                </h3>
                <div class="flex items-center gap-1 text-[10px] font-bold text-amber-500 mt-0.5">
                  <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                  <span>{rest.rating} Rating</span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Quick Navigation Chips for Featured & Category Sections -->
    <div class="sticky top-32 z-30 bg-white/95 backdrop-blur-md py-2 -mx-4 sm:-mx-6 px-4 sm:px-6 border-b border-slate-100" id="quick-sections-bar">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
        {featuredSections.map(sec => (
          <a 
            href={`#section-${sec.id}`}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-redLight text-redBrand hover:bg-redBrand hover:text-white font-black text-xs whitespace-nowrap transition-all shrink-0 border border-red-200 active:scale-95"
          >
            <span>{sec.icon}</span>
            <span>{sec.name}</span>
          </a>
        ))}

        <span class="text-slate-300">|</span>

        {categorySections.map(sec => (
          <a 
            href={`#section-${sec.id}`}
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-redBrand hover:text-white font-extrabold text-xs whitespace-nowrap transition-all shrink-0 border border-slate-200/80 active:scale-95"
          >
            <span>{sec.icon}</span>
            <span>{sec.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ==================== 6 DYNAMIC FEATURED PRODUCT SECTIONS (FOOD PRODUCTS ONLY) ==================== -->
    <div class="space-y-10 pt-2" id="featured-food-sections-container">
      {featuredSections.map(sec => {
        const items = foodCatalog.slice(sec.slice[0], sec.slice[1]);
        if (items.length === 0) return null;

        return (
          <section id={`section-${sec.id}`} class="food-scroll-section space-y-3.5 scroll-mt-48">
            <div class="flex items-end justify-between px-1">
              <div>
                <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
                  <span>{sec.icon}</span>
                  <span>{sec.name}</span>
                </h2>
                <p class="text-xs text-slate-500 font-medium mt-0.5">{sec.subtitle} ({items.length} items)</p>
              </div>
              <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider shrink-0">Scroll →</span>
            </div>

            <!-- HORIZONTALLY SCROLLABLE PRODUCT CAROUSEL WITH QUICK VIEW AND ADD TO CART -->
            <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2 px-0.5">
              {items.map(item => (
                <div 
                  class="food-product-card w-52 sm:w-60 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-red-200 transition-all duration-300 group relative cursor-pointer"
                  data-id={item.id}
                  data-name={item.name}
                  data-category={item.category}
                  data-price={item.price}
                  data-isveg={item.isVeg ? 'true' : 'false'}
                  data-kw={item.searchKeywords ? item.searchKeywords.join(' ') : ''}
                  onclick={`window.location.href='/product?id=${item.id}';`}
                >
                  <div>
                    <div class="w-full aspect-square bg-slate-50/90 rounded-2xl p-2.5 mb-3 flex items-center justify-center border border-slate-100 overflow-hidden relative group-hover:bg-red-50/30 transition-colors">
                      
                      <!-- Veg / Non-Veg Badge -->
                      <div class="absolute top-2 left-2 bg-white/95 backdrop-blur-md px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-1 shadow-xs z-10 border border-slate-200">
                        <span class={`w-2 h-2 rounded-full shrink-0 ${item.isVeg ? 'bg-emerald-600' : 'bg-rose-600'}`}></span>
                        <span class={item.isVeg ? 'text-emerald-700' : 'text-rose-700'}>{item.isVeg ? 'VEG' : 'NON-VEG'}</span>
                      </div>

                      <!-- Rating Badge -->
                      <div class="absolute top-2 right-2 bg-amber-50 text-amber-800 border border-amber-200/80 px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-0.5 shadow-xs z-10">
                        <span>⭐</span>
                        <span>{item.rating || '4.8'}</span>
                      </div>

                      <!-- Preparation Time Badge -->
                      <div class="absolute bottom-2 left-2 bg-slate-900/85 backdrop-blur-md text-white px-2 py-0.5 rounded-full text-[9px] font-extrabold flex items-center gap-1 shadow-xs z-10">
                        <span>⏱️ {item.prepTime || '15-20 min'}</span>
                      </div>

                      <!-- QUICK VIEW BUTTON -->
                      <button 
                        class="btn-quick-view absolute inset-x-3 bottom-2 py-1.5 bg-white/95 backdrop-blur-md text-slate-800 text-[10px] font-black rounded-xl border border-slate-200 shadow-md opacity-0 group-hover:opacity-100 transition-opacity z-20 flex items-center justify-center gap-1 hover:bg-redBrand hover:text-white hover:border-redBrand"
                        onclick={`event.stopPropagation(); window.location.href='/product?id=${item.id}';`}
                      >
                        <span class="material-symbols-outlined text-xs">visibility</span>
                        <span>Quick View</span>
                      </button>

                      <!-- Large Product Image -->
                      <img 
                        loading="lazy" 
                        src={item.image} 
                        alt={item.name} 
                        class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
                        onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';"
                      />
                    </div>

                    <span class="text-[10px] font-extrabold text-redBrand uppercase tracking-wider block mb-0.5 truncate">
                      {item.category}
                    </span>

                    <h3 class="text-xs sm:text-sm font-black font-display text-slate-900 line-clamp-2 leading-snug min-h-[2.4rem] group-hover:text-redBrand transition-colors">
                      {item.name}
                    </h3>
                  </div>

                  <!-- PRICE & ADD TO CART BUTTON / STEPPER -->
                  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 mt-3">
                    <div class="flex flex-col">
                      <span class="text-[9px] text-slate-400 font-bold uppercase">Price</span>
                      <span class="text-sm sm:text-base font-black font-display text-slate-900">₹{item.price}</span>
                    </div>

                    <div 
                      class="food-direct-action-box" 
                      data-id={item.id} 
                      data-name={item.name} 
                      data-price={item.price} 
                      data-img={item.image}
                      data-category={item.category}
                      onclick="event.stopPropagation();"
                    >
                      <button class="btn-add-direct-food px-3.5 py-1.5 bg-redLight text-redBrand hover:bg-redBrand hover:text-white border border-red-200 text-xs font-black rounded-xl active:scale-90 transition-all shadow-xs flex items-center gap-1">
                        <span>+ ADD</span>
                      </button>

                      <div class="qty-control-wrapper hidden items-center bg-redLight border border-red-200 rounded-xl p-0.5 shadow-xs">
                        <button class="btn-qty-minus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                          -
                        </button>
                        <span class="food-qty-num px-2 text-xs font-black text-redBrand min-w-[16px] text-center">1</span>
                        <button class="btn-qty-plus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                          +
                        </button>
                      </div>
                    </div>
                  </div>

                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <!-- ==================== 18 CATEGORY SECTIONS (FOOD PRODUCTS ONLY) ==================== -->
    <div class="space-y-10 pt-2" id="all-food-sections-container">
      {categorySections.map(sec => {
        const items = getItemsForCategory(sec.id);
        if (items.length === 0) return null;

        return (
          <section id={`section-${sec.id}`} class="food-scroll-section space-y-3.5 scroll-mt-48">
            <div class="flex items-end justify-between px-1">
              <div>
                <h2 class="text-lg sm:text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
                  <span>{sec.icon}</span>
                  <span>{sec.name}</span>
                </h2>
                <p class="text-xs text-slate-500 font-medium mt-0.5">{sec.subtitle} ({items.length} items)</p>
              </div>

              <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider shrink-0">Scroll →</span>
            </div>

            <div class="flex items-stretch gap-4 overflow-x-auto no-scrollbar py-2 px-0.5">
              {items.map(item => (
                <div 
                  class="food-product-card w-52 sm:w-60 shrink-0 bg-white rounded-3xl border border-slate-100 p-3.5 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-red-200 transition-all duration-300 group relative cursor-pointer"
                  data-id={item.id}
                  data-name={item.name}
                  data-category={item.category}
                  data-price={item.price}
                  data-isveg={item.isVeg ? 'true' : 'false'}
                  data-kw={item.searchKeywords ? item.searchKeywords.join(' ') : ''}
                  onclick={`window.location.href='/product?id=${item.id}';`}
                >
                  <div>
                    <div class="w-full aspect-square bg-slate-50/90 rounded-2xl p-2.5 mb-3 flex items-center justify-center border border-slate-100 overflow-hidden relative group-hover:bg-red-50/30 transition-colors">
                      
                      <div class="absolute top-2 left-2 bg-white/95 backdrop-blur-md px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-1 shadow-xs z-10 border border-slate-200">
                        <span class={`w-2 h-2 rounded-full shrink-0 ${item.isVeg ? 'bg-emerald-600' : 'bg-rose-600'}`}></span>
                        <span class={item.isVeg ? 'text-emerald-700' : 'text-rose-700'}>{item.isVeg ? 'VEG' : 'NON-VEG'}</span>
                      </div>

                      <div class="absolute top-2 right-2 bg-amber-50 text-amber-800 border border-amber-200/80 px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-0.5 shadow-xs z-10">
                        <span>⭐</span>
                        <span>{item.rating || '4.8'}</span>
                      </div>

                      <div class="absolute bottom-2 left-2 bg-slate-900/85 backdrop-blur-md text-white px-2 py-0.5 rounded-full text-[9px] font-extrabold flex items-center gap-1 shadow-xs z-10">
                        <span>⏱️ {item.prepTime || '15-20 min'}</span>
                      </div>

                      <!-- QUICK VIEW BUTTON -->
                      <button 
                        class="btn-quick-view absolute inset-x-3 bottom-2 py-1.5 bg-white/95 backdrop-blur-md text-slate-800 text-[10px] font-black rounded-xl border border-slate-200 shadow-md opacity-0 group-hover:opacity-100 transition-opacity z-20 flex items-center justify-center gap-1 hover:bg-redBrand hover:text-white hover:border-redBrand"
                        onclick={`event.stopPropagation(); window.location.href='/product?id=${item.id}';`}
                      >
                        <span class="material-symbols-outlined text-xs">visibility</span>
                        <span>Quick View</span>
                      </button>

                      <img 
                        loading="lazy" 
                        src={item.image} 
                        alt={item.name} 
                        class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
                        onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';"
                      />
                    </div>

                    <span class="text-[10px] font-extrabold text-redBrand uppercase tracking-wider block mb-0.5 truncate">
                      {item.category}
                    </span>

                    <h3 class="text-xs sm:text-sm font-black font-display text-slate-900 line-clamp-2 leading-snug min-h-[2.4rem] group-hover:text-redBrand transition-colors">
                      {item.name}
                    </h3>
                  </div>

                  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 mt-3">
                    <div class="flex flex-col">
                      <span class="text-[9px] text-slate-400 font-bold uppercase">Price</span>
                      <span class="text-sm sm:text-base font-black font-display text-slate-900">₹{item.price}</span>
                    </div>

                    <div 
                      class="food-direct-action-box" 
                      data-id={item.id} 
                      data-name={item.name} 
                      data-price={item.price} 
                      data-img={item.image}
                      data-category={item.category}
                      onclick="event.stopPropagation();"
                    >
                      <button class="btn-add-direct-food px-3.5 py-1.5 bg-redLight text-redBrand hover:bg-redBrand hover:text-white border border-red-200 text-xs font-black rounded-xl active:scale-90 transition-all shadow-xs flex items-center gap-1">
                        <span>+ ADD</span>
                      </button>

                      <div class="qty-control-wrapper hidden items-center bg-redLight border border-red-200 rounded-xl p-0.5 shadow-xs">
                        <button class="btn-qty-minus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                          -
                        </button>
                        <span class="food-qty-num px-2 text-xs font-black text-redBrand min-w-[16px] text-center">1</span>
                        <button class="btn-qty-plus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                          +
                        </button>
                      </div>
                    </div>
                  </div>

                </div>
              ))}
            </div>

          </section>
        );
      })}
    </div>

  </main>

  <!-- ==================== FIXED BOTTOM FLOATING CART BAR ==================== -->
  <div id="food-floating-cart-bar" class="fixed bottom-4 left-4 right-4 max-w-xl mx-auto bg-slate-900 text-white rounded-2xl p-3.5 shadow-2xl z-50 flex items-center justify-between transition-all transform translate-y-32 opacity-0 pointer-events-none border border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-redBrand text-white flex items-center justify-center font-black shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span id="float-cart-count" class="text-xs font-black bg-white/20 px-2 py-0.5 rounded-md">0 ITEMS</span>
          <span class="text-xs text-slate-400 font-bold">•</span>
          <span id="float-cart-total" class="text-sm font-black text-white">₹0</span>
        </div>
        <p class="text-[10px] text-slate-400 font-semibold mt-0.5">Fixed delivery fee ₹30 added at checkout</p>
      </div>
    </div>

    <a href="/cart" class="px-5 py-2.5 bg-redBrand hover:bg-redDark text-white text-xs font-black rounded-xl active:scale-95 transition-all shadow-md flex items-center gap-1">
      <span>View Cart</span>
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </a>
  </div>

  <Switcher />

  <!-- Client-Side Catalog Array for Instant Search Dropdown Suggestions -->
  <script is:inline define:vars={{ foodCatalog }}>
    window.BHUSAWAL_FOOD_CATALOG = foodCatalog || [];
  </script>

  <!-- Dynamic Client Script for Multi-Field Product Search, Comprehensive Filters & Global Cart Sync -->
  <script is:inline>
    (function() {
      var foodCatalog = window.BHUSAWAL_FOOD_CATALOG || [];

      var activeFilters = {
        diet: null,
        meal: null,
        cuisine: null,
        price: null
      };

      // GLOBAL CART MANAGEMENT
      function getGlobalCart() {
        let raw = [];
        try {
          raw = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {}
        if (!Array.isArray(raw)) return [];
        return raw;
      }

      function saveGlobalCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new Event('cartUpdated'));
        updateAllCartUI();
      }

      function updateAllCartUI() {
        var cart = getGlobalCart();
        var totalCount = 0;
        var subtotalPrice = 0;

        cart.forEach(function(item) {
          var qty = item.quantity || 1;
          var p = parseFloat(item.price || item.mrp || item.MRP || 0);
          totalCount += qty;
          subtotalPrice += p * qty;
        });

        var badge = document.getElementById('food-cart-badge');
        if (badge) badge.textContent = totalCount;

        var floatBar = document.getElementById('food-floating-cart-bar');
        var floatCount = document.getElementById('float-cart-count');
        var floatTotal = document.getElementById('float-cart-total');

        if (floatBar) {
          if (totalCount > 0) {
            floatBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
            if (floatCount) floatCount.textContent = totalCount + (totalCount === 1 ? ' ITEM' : ' ITEMS');
            if (floatTotal) floatTotal.textContent = '₹' + subtotalPrice;
          } else {
            floatBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          }
        }

        document.querySelectorAll('.food-direct-action-box').forEach(function(box) {
          var itemId = box.getAttribute('data-id');
          var addBtn = box.querySelector('.btn-add-direct-food');
          var qtyWrapper = box.querySelector('.qty-control-wrapper');
          var qtyNum = box.querySelector('.food-qty-num');

          var existing = cart.find(function(c) { return c.id === itemId; });
          if (existing && existing.quantity > 0) {
            if (addBtn) addBtn.classList.add('hidden');
            if (qtyWrapper) {
              qtyWrapper.classList.remove('hidden');
              qtyWrapper.classList.add('flex');
            }
            if (qtyNum) qtyNum.textContent = existing.quantity;
          } else {
            if (addBtn) addBtn.classList.remove('hidden');
            if (qtyWrapper) {
              qtyWrapper.classList.add('hidden');
              qtyWrapper.classList.remove('flex');
            }
          }
        });
      }

      // Add to Cart Click Handler
      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.btn-add-direct-food');
        if (addBtn) {
          e.stopPropagation();
          var box = addBtn.closest('.food-direct-action-box');
          if (!box) return;

          var id = box.getAttribute('data-id');
          var name = box.getAttribute('data-name');
          var price = parseFloat(box.getAttribute('data-price')) || 0;
          var img = box.getAttribute('data-img');
          var category = box.getAttribute('data-category') || 'Food';

          var cart = getGlobalCart();
          var existing = cart.find(function(c) { return c.id === id; });
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
          } else {
            cart.push({
              id: id,
              name: name,
              price: price,
              mrp: price,
              image: img,
              quantity: 1,
              restaurant: 'Bhusawal Food Express',
              cat: category
            });
          }
          saveGlobalCart(cart);
          return;
        }

        var plusBtn = e.target.closest('.btn-qty-plus');
        if (plusBtn) {
          e.stopPropagation();
          var box = plusBtn.closest('.food-direct-action-box');
          if (!box) return;
          var id = box.getAttribute('data-id');
          var cart = getGlobalCart();
          var existing = cart.find(function(c) { return c.id === id; });
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
            saveGlobalCart(cart);
          }
          return;
        }

        var minusBtn = e.target.closest('.btn-qty-minus');
        if (minusBtn) {
          e.stopPropagation();
          var box = minusBtn.closest('.food-direct-action-box');
          if (!box) return;
          var id = box.getAttribute('data-id');
          var cart = getGlobalCart();
          var existingIndex = cart.findIndex(function(c) { return c.id === id; });
          if (existingIndex > -1) {
            if (cart[existingIndex].quantity > 1) {
              cart[existingIndex].quantity -= 1;
            } else {
              cart.splice(existingIndex, 1);
            }
            saveGlobalCart(cart);
          }
          return;
        }
      });

      // FILTER ENGINE WITH AUTOMATIC EMPTY SECTION HIDING
      var searchInput = document.getElementById('food-search-input');
      var clearSearchBtn = document.getElementById('clear-food-search');
      var suggestionsBox = document.getElementById('food-search-suggestions');
      var resetFiltersBtn = document.getElementById('reset-all-filters-btn');

      function applyCombinedFilters() {
        var q = (searchInput?.value || '').toLowerCase().trim();

        if (clearSearchBtn) {
          if (q.length > 0) clearSearchBtn.classList.remove('hidden');
          else clearSearchBtn.classList.add('hidden');
        }

        var hasActiveFilter = activeFilters.diet || activeFilters.meal || activeFilters.cuisine || activeFilters.price || q;
        if (resetFiltersBtn) {
          if (hasActiveFilter) resetFiltersBtn.classList.remove('hidden');
          else resetFiltersBtn.classList.add('hidden');
        }

        document.querySelectorAll('.food-product-card').forEach(function(card) {
          var name = (card.getAttribute('data-name') || '').toLowerCase();
          var category = (card.getAttribute('data-category') || '').toLowerCase();
          var kw = (card.getAttribute('data-kw') || '').toLowerCase();
          var isVeg = card.getAttribute('data-isveg') === 'true';
          var price = parseFloat(card.getAttribute('data-price')) || 0;

          var matchesSearch = !q || name.includes(q) || category.includes(q) || kw.includes(q);
          if (q === 'veg' || q === 'vegetarian') matchesSearch = isVeg;
          if (q === 'nonveg' || q === 'non-veg') matchesSearch = !isVeg;

          var matchesDiet = true;
          if (activeFilters.diet === 'veg') matchesDiet = isVeg;
          if (activeFilters.diet === 'nonveg') matchesDiet = !isVeg;

          var matchesMeal = true;
          if (activeFilters.meal === 'breakfast') {
            matchesMeal = category === 'breakfast' || kw.includes('breakfast') || kw.includes('poha') || kw.includes('dosa') || kw.includes('idli') || kw.includes('upma');
          } else if (activeFilters.meal === 'lunch') {
            matchesMeal = category === 'veg main course' || category === 'chicken' || category === 'mutton' || category === 'fish' || category === 'rice' || category === 'roti & naan';
          } else if (activeFilters.meal === 'dinner') {
            matchesMeal = category === 'biryani' || category === 'veg main course' || category === 'chicken' || category === 'mutton' || category === 'roti & naan' || category === 'chinese';
          }

          var matchesCuisine = true;
          if (activeFilters.cuisine === 'fastfood') {
            matchesCuisine = category === 'burgers' || category === 'sandwiches' || category === 'rolls' || category === 'pizza' || category === 'snacks';
          } else if (activeFilters.cuisine === 'chinese') {
            matchesCuisine = category === 'chinese' || kw.includes('chinese') || kw.includes('noodles') || kw.includes('manchurian') || kw.includes('schezwan');
          } else if (activeFilters.cuisine === 'northindian') {
            matchesCuisine = category === 'veg main course' || category === 'chicken' || category === 'roti & naan' || kw.includes('paneer') || kw.includes('butter chicken') || kw.includes('dal');
          } else if (activeFilters.cuisine === 'southindian') {
            matchesCuisine = category === 'breakfast' && (name.includes('dosa') || name.includes('idli') || name.includes('vada') || name.includes('uttapam'));
          } else if (activeFilters.cuisine === 'desserts') {
            matchesCuisine = category === 'desserts' || kw.includes('sweet') || kw.includes('ice cream');
          } else if (activeFilters.cuisine === 'beverages') {
            matchesCuisine = category === 'beverages' || kw.includes('chai') || kw.includes('coffee') || kw.includes('shake');
          }

          var matchesPrice = true;
          if (activeFilters.price === 'under100') {
            matchesPrice = price <= 100;
          } else if (activeFilters.price === '100-200') {
            matchesPrice = price >= 100 && price <= 200;
          } else if (activeFilters.price === 'above200') {
            matchesPrice = price > 200;
          }

          if (matchesSearch && matchesDiet && matchesMeal && matchesCuisine && matchesPrice) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // AUTOMATICALLY HIDE EMPTY SECTIONS IF NO PRODUCTS MATCH
        document.querySelectorAll('.food-scroll-section').forEach(function(sec) {
          var visibleCards = sec.querySelectorAll('.food-product-card:not(.hidden)');
          if (visibleCards.length > 0) sec.classList.remove('hidden');
          else sec.classList.add('hidden');
        });

        renderSuggestionsDropdown(q);
      }

      function renderSuggestionsDropdown(q) {
        if (!suggestionsBox) return;

        if (!q || q.length < 2) {
          suggestionsBox.classList.add('hidden');
          suggestionsBox.innerHTML = '';
          return;
        }

        var matches = foodCatalog.filter(function(item) {
          var name = (item.name || '').toLowerCase();
          var category = (item.category || '').toLowerCase();
          var kw = (item.searchKeywords || []).join(' ').toLowerCase();

          var match = name.includes(q) || category.includes(q) || kw.includes(q);
          if (q === 'veg') match = item.isVeg;
          if (q === 'nonveg' || q === 'non-veg') match = !item.isVeg;

          if (activeFilters.diet === 'veg' && !item.isVeg) return false;
          if (activeFilters.diet === 'nonveg' && item.isVeg) return false;

          return match;
        }).slice(0, 7);

        if (matches.length === 0) {
          suggestionsBox.innerHTML = `
            <div class="p-3 text-center text-xs font-bold text-slate-400">
              No food dishes matching "<span class="text-slate-800">${q}</span>". Try 'pizza', 'paneer' or 'biryani'.
            </div>
          `;
          suggestionsBox.classList.remove('hidden');
          return;
        }

        var html = '';
        matches.forEach(function(item) {
          var dietText = item.isVeg ? 'VEG' : 'NON-VEG';
          var img = item.image || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

          html += `
            <div class="suggestion-item p-2.5 hover:bg-red-50/60 rounded-2xl cursor-pointer flex items-center justify-between transition-colors group" data-id="${item.id}" data-name="${item.name}">
              <div class="flex items-center gap-3">
                <img src="${img}" alt="${item.name}" class="w-10 h-10 rounded-xl object-cover border border-slate-100" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                <div>
                  <h4 class="text-xs font-extrabold text-slate-900 group-hover:text-redBrand transition-colors">${item.name}</h4>
                  <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 mt-0.5">
                    <span class="text-redBrand uppercase font-black">${item.category}</span>
                    <span>•</span>
                    <span class="flex items-center gap-1 font-black ${item.isVeg ? 'text-emerald-700' : 'text-rose-700'}">
                      <span class="w-1.5 h-1.5 rounded-full ${item.isVeg ? 'bg-emerald-600' : 'bg-rose-600'}"></span> ${dietText}
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <span class="text-xs font-black text-slate-900">₹${item.price}</span>
                <span class="material-symbols-outlined text-sm text-slate-400 group-hover:text-redBrand group-hover:translate-x-0.5 transition-all">arrow_forward</span>
              </div>
            </div>
          `;
        });

        suggestionsBox.innerHTML = html;
        suggestionsBox.classList.remove('hidden');
      }

      document.querySelectorAll('.filter-pill-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var fType = btn.getAttribute('data-filter-type');
          var fVal = btn.getAttribute('data-filter-val');

          if (activeFilters[fType] === fVal) {
            activeFilters[fType] = null;
            btn.classList.remove('bg-redBrand', 'text-white', 'border-redBrand', 'shadow-sm');
            btn.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200/80');
          } else {
            document.querySelectorAll('.filter-pill-btn[data-filter-type="' + fType + '"]').forEach(function(b) {
              b.classList.remove('bg-redBrand', 'text-white', 'border-redBrand', 'shadow-sm');
              b.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200/80');
            });

            activeFilters[fType] = fVal;
            btn.classList.add('bg-redBrand', 'text-white', 'border-redBrand', 'shadow-sm');
            btn.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200/80');
          }

          applyCombinedFilters();
        });
      });

      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', function() {
          activeFilters.diet = null;
          activeFilters.meal = null;
          activeFilters.cuisine = null;
          activeFilters.price = null;

          if (searchInput) searchInput.value = '';

          document.querySelectorAll('.filter-pill-btn').forEach(function(b) {
            b.classList.remove('bg-redBrand', 'text-white', 'border-redBrand', 'shadow-sm');
            b.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200/80');
          });

          applyCombinedFilters();
        });
      }

      if (suggestionsBox) {
        suggestionsBox.addEventListener('click', function(e) {
          var row = e.target.closest('.suggestion-item');
          if (!row) return;

          var itemId = row.getAttribute('data-id');
          window.location.href = '/product?id=' + itemId;
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', function() {
          applyCombinedFilters();
        });

        searchInput.addEventListener('focus', function(e) {
          if (e.target.value.trim().length >= 2) {
            renderSuggestionsDropdown(e.target.value.trim());
          }
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', function() {
          if (searchInput) searchInput.value = '';
          clearSearchBtn.classList.add('hidden');
          applyCombinedFilters();
        });
      }

      document.addEventListener('click', function(e) {
        var searchBox = document.getElementById('search-container-box');
        if (searchBox && !searchBox.contains(e.target)) {
          if (suggestionsBox) suggestionsBox.classList.add('hidden');
        }
      });

      window.addEventListener('storage', updateAllCartUI);
      window.addEventListener('cartUpdated', updateAllCartUI);

      document.addEventListener('DOMContentLoaded', updateAllCartUI);
      updateAllCartUI();
    })();
  </script>

</body>
</html>
