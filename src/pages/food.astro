---

<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Food Delivery - Restaurant Menu</title>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline="" />
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "secondary-container": "#e5e2e1",
            "on-primary": "#ffffff",
            "on-surface-variant": "#5b4039",
            "outline": "#907067",
            "on-primary-container": "#ffffff",
            "surface-tint": "#7c3aed",
            "secondary": "#5f5e5e",
            "inverse-primary": "#ffb5a0",
            "outline-variant": "#e4beb4",
            "on-secondary-fixed": "#1c1b1b",
            "background": "#f9f9f9",
            "error-container": "#ffdad6",
            "tertiary": "#006e1c",
            "surface-container-lowest": "#ffffff",
            "on-error": "#ffffff",
            "inverse-surface": "#2f3131",
            "on-tertiary": "#ffffff",
            "surface-container-highest": "#e2e2e2",
            "secondary-fixed": "#e5e2e1",
            "tertiary-fixed": "#94f990",
            "surface-container": "#eeeeee",
            "on-surface": "#1a1c1c",
            "primary": "#ea580c",
            "primary-container": "#ff782e",
            "on-secondary-container": "#656464",
            "surface-container-low": "#f3f3f3",
            "surface-dim": "#dadada",
            "primary-fixed": "#ffedd5",
            "on-primary-fixed-variant": "#862200",
            "error": "#ba1a1a",
            "on-error-container": "#93000a",
            "surface-container-high": "#e8e8e8",
            "surface-bright": "#f9f9f9",
            "on-secondary": "#ffffff",
            "surface": "#f9f9f9"
          },
          "fontFamily": {
            "label-sm": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"],
            "body-md": ["Plus Jakarta Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "headline-lg-mobile": ["Plus Jakarta Sans"]
          },
          "spacing": {
            "margin-mobile": "16px",
            "gutter": "16px"
          }
        }
      }
    }
  </script>
  
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f9f9f9; min-height: 100dvh; }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="text-on-surface bg-background pb-32">
  <!-- Top App Bar -->
  <header class="bg-surface/90 dark:bg-inverse-surface/90 backdrop-blur-xl shadow-sm top-0 sticky z-50 flex items-center justify-between px-margin-mobile h-16 w-full">
    <div class="flex items-center gap-2 min-w-0">
        <a href="/home" class="p-2 hover:bg-surface-container-high rounded-full transition-colors active:scale-95 duration-150 flex-shrink-0 flex items-center justify-center mr-1">
            <span class="material-symbols-outlined text-primary">arrow_back</span>
        </a>
  
        <!-- Delivery Time & Location Info -->
        <div class="flex flex-col min-w-0">
            <div class="flex items-center gap-1">
                <span class="material-symbols-outlined text-primary text-sm font-black animate-pulse" style="font-variation-settings: 'FILL' 1;">bolt</span>
                <span class="font-extrabold text-[13px] tracking-tight text-on-surface" id="header-eta">20 minutes</span>
            </div>
            <div class="flex items-center gap-0.5 text-[10px] text-on-surface-variant font-extrabold cursor-pointer hover:text-primary transition-colors min-w-0 uppercase tracking-wide">
                <span class="truncate" id="header-address">Home - Varangaon Road, Bhusawal</span>
                <span class="material-symbols-outlined text-xs flex-shrink-0">keyboard_arrow_down</span>
            </div>
        </div>
    </div>
    <!-- Profile Avatar on Top Right -->
    <a href="/profile" class="w-9 h-9 rounded-full overflow-hidden border border-outline-variant/30 flex-shrink-0 hover:ring-2 hover:ring-primary/20 active:scale-90 transition-all flex items-center justify-center">
        <img class="w-full h-full object-cover" src="/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg" alt="Profile"  onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
    </a>
</header>

  <main class="max-w-xl mx-auto px-margin-mobile pt-4 space-y-5">
    <!-- Restaurant Menu Banner -->
    <div class="bg-white rounded-2xl p-4 border border-outline-variant/10 shadow-[0_4px_16px_rgba(0,0,0,0.03)] flex justify-between items-center">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="font-extrabold text-lg text-on-surface">Food Menu & Delivery</h1>
          <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">38+ Dishes</span>
        </div>
        <p class="text-xs text-neutral-500 mt-0.5">Thalis • Starters • Main Course • Biryani • Chinese • Desserts</p>
        <div class="flex items-center gap-3 mt-2 text-xs font-bold text-neutral-700">
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-yellow-500 text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
            <span>4.8 (3.1k+ ratings)</span>
          </div>
          <span class="text-neutral-300">•</span>
          <span class="text-primary">20-25 mins</span>
        </div>
      </div>
      <div class="w-14 h-14 rounded-2xl overflow-hidden bg-primary/10 flex items-center justify-center flex-shrink-0 border border-primary/20">
        <span class="material-symbols-outlined text-primary text-3xl">restaurant_menu</span>
      </div>
    </div>

    <!-- Clean Search Input Bar -->
    <div class="relative">
      <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-neutral-400 text-lg">search</span>
      <input 
        id="search-food" 
        type="text" 
        placeholder="Search menu (Paneer, Butter Chicken, Biryani, Naan...)" 
        class="w-full bg-white border border-neutral-200/80 rounded-2xl py-3 pl-11 pr-10 text-xs font-semibold text-neutral-800 shadow-[0_2px_8px_rgba(0,0,0,0.02)] focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all placeholder:text-neutral-400" 
      />
      <button id="clear-search" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>
    </div>

    <!-- Unified Quick Filter Pills (Diet & Categories) -->
    <div class="bg-white p-3 rounded-2xl border border-outline-variant/10 shadow-sm space-y-3">
      <!-- Dietary Preference Buttons (Primary Filters) -->
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-extrabold text-neutral-500 uppercase tracking-wider pl-1">Diet Filter</span>
        <div class="flex gap-2" id="diet-buttons">
          <button id="btn-all" data-diet="all" class="diet-btn px-4 py-1.5 rounded-xl border border-primary bg-primary text-white font-extrabold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1">
            🍽️ All Dishes
          </button>
          <button id="btn-veg" data-diet="veg" class="diet-btn px-4 py-1.5 rounded-xl border border-emerald-300 bg-white text-emerald-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-emerald-50">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Veg Only
          </button>
          <button id="btn-nonveg" data-diet="nonveg" class="diet-btn px-4 py-1.5 rounded-xl border border-red-300 bg-white text-red-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-red-50">
            <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span> Non-Veg
          </button>
        </div>
      </div>

      <!-- Category Filter Pills (Horizontal Scroll) -->
      <div class="flex gap-2 overflow-x-auto no-scrollbar pt-2 border-t border-neutral-100" id="category-pills">
        <button data-cat="all" class="cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-primary text-white shadow-sm active:scale-95">
          ✨ All Menu
        </button>
        {categoryOrder.map(cat => (
          <button data-cat={cat.key} class="cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-neutral-100 text-neutral-700 hover:bg-primary/10 active:scale-95">
            {cat.title}
          </button>
        ))}
      </div>
    </div>

    <!-- Clean Active Filter Status Bar -->
    <div id="filter-status-banner" class="bg-white border border-neutral-200/80 rounded-xl px-4 py-2 flex items-center justify-between text-xs font-bold text-neutral-700 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span id="filter-status-text" class="truncate font-bold">Showing: All Menu (38 Dishes)</span>
      </div>
      <button id="reset-all-filters" class="text-primary hover:text-primary/80 font-extrabold text-[11px] flex-shrink-0 transition-colors">Reset</button>
    </div>

    <!-- Static Pre-Rendered Menu Sections with Explicit Veg/NonVeg Grouping -->
    <div class="space-y-6" id="menu-container">
      {categoryOrder.map(cat => {
        const vegItems = foodCatalog.filter(item => item.category === cat.key && item.type === 'veg');
        const nonvegItems = foodCatalog.filter(item => item.category === cat.key && item.type === 'nonveg');
        if (vegItems.length === 0 && nonvegItems.length === 0) return null;

        return (
          <section class="space-y-4 food-category-section" data-cat={cat.key}>
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200">
              <h2 class="font-extrabold text-base text-on-surface">{cat.title}</h2>
              <span class="text-xs font-bold text-neutral-400">({vegItems.length + nonvegItems.length})</span>
            </div>

            <!-- Veg Sub-group -->
            {vegItems.length > 0 && (
              <div class="space-y-3 food-diet-group" data-group-diet="veg">
                <div class="flex items-center gap-1.5 pt-1">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                  <h3 class="text-xs font-extrabold text-emerald-800 uppercase tracking-wider">🟢 Pure Veg {cat.key} ({vegItems.length})</h3>
                </div>
                <div class="space-y-3">
                  {vegItems.map(item => (
                    <div 
                      class="bg-white rounded-2xl p-4 border border-outline-variant/10 border-l-[5px] border-l-emerald-600 shadow-[0_4px_12px_rgba(0,0,0,0.03)] flex justify-between items-center food-item gap-3 transition-all" 
                      data-id={item.id} 
                      data-type={item.type}
                      data-cat={item.category}
                      data-name={item.name.toLowerCase()}
                      data-desc={item.desc.toLowerCase()}
                    >
                      <div class="flex-1 min-w-0 pr-2">
                        <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                          <span class="bg-emerald-50 text-emerald-700 border border-emerald-300 text-[10px] font-black px-2 py-0.5 rounded-full flex items-center gap-1 flex-shrink-0">
                            <span class="w-2 h-2 rounded-full bg-emerald-600"></span> VEG
                          </span>
                          <span class="text-[10px] font-extrabold px-2 py-0.5 rounded bg-amber-100 text-amber-900">{item.tag}</span>
                          <span class="text-[10px] font-extrabold text-neutral-600 flex items-center gap-0.5">
                            <span class="text-yellow-500">★</span> {item.rating}
                          </span>
                        </div>
                        <h3 class="font-extrabold text-label-md text-on-surface leading-tight mt-1">{item.name}</h3>
                        <p class="text-[11px] text-on-surface-variant mt-1 line-clamp-2 leading-snug">{item.desc}</p>
                        <p class="font-extrabold text-on-surface mt-2 text-sm">₹{item.price}</p>
                      </div>
                      
                      <div class="flex flex-col items-center flex-shrink-0 relative">
                        <div class="w-24 h-24 rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-100 shadow-inner relative">
                          <img 
                            src={item.img} 
                            alt={item.name} 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform" 
                            onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';"
                          />
                        </div>
                        <div class="btn-slot mt-2">
                          <button 
                            class="bg-white border border-primary text-primary px-5 py-1.5 rounded-xl text-xs font-extrabold shadow-md hover:bg-primary/5 active:scale-95 transition-all btn-add" 
                            data-name={item.name} 
                            data-price={item.price} 
                            data-img={item.img}
                          >
                            ADD
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Non-Veg Sub-group -->
            {nonvegItems.length > 0 && (
              <div class="space-y-3 food-diet-group" data-group-diet="nonveg">
                <div class="flex items-center gap-1.5 pt-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
                  <h3 class="text-xs font-extrabold text-red-800 uppercase tracking-wider">🔴 Non-Veg {cat.key} ({nonvegItems.length})</h3>
                </div>
                <div class="space-y-3">
                  {nonvegItems.map(item => (
                    <div 
                      class="bg-white rounded-2xl p-4 border border-outline-variant/10 border-l-[5px] border-l-red-600 shadow-[0_4px_12px_rgba(0,0,0,0.03)] flex justify-between items-center food-item gap-3 transition-all" 
                      data-id={item.id} 
                      data-type={item.type}
                      data-cat={item.category}
                      data-name={item.name.toLowerCase()}
                      data-desc={item.desc.toLowerCase()}
                    >
                      <div class="flex-1 min-w-0 pr-2">
                        <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                          <span class="bg-red-50 text-red-700 border border-red-300 text-[10px] font-black px-2 py-0.5 rounded-full flex items-center gap-1 flex-shrink-0">
                            <span class="w-2 h-2 rounded-full bg-red-600"></span> NON-VEG
                          </span>
                          <span class="text-[10px] font-extrabold px-2 py-0.5 rounded bg-amber-100 text-amber-900">{item.tag}</span>
                          <span class="text-[10px] font-extrabold text-neutral-600 flex items-center gap-0.5">
                            <span class="text-yellow-500">★</span> {item.rating}
                          </span>
                        </div>
                        <h3 class="font-extrabold text-label-md text-on-surface leading-tight mt-1">{item.name}</h3>
                        <p class="text-[11px] text-on-surface-variant mt-1 line-clamp-2 leading-snug">{item.desc}</p>
                        <p class="font-extrabold text-on-surface mt-2 text-sm">₹{item.price}</p>
                      </div>
                      
                      <div class="flex flex-col items-center flex-shrink-0 relative">
                        <div class="w-24 h-24 rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-100 shadow-inner relative">
                          <img 
                            src={item.img} 
                            alt={item.name} 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform" 
                            onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';"
                          />
                        </div>
                        <div class="btn-slot mt-2">
                          <button 
                            class="bg-white border border-primary text-primary px-5 py-1.5 rounded-xl text-xs font-extrabold shadow-md hover:bg-primary/5 active:scale-95 transition-all btn-add" 
                            data-name={item.name} 
                            data-price={item.price} 
                            data-img={item.img}
                          >
                            ADD
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </main>

    <!-- Interactive Food Dish Details Modal -->
  <div id="food-modal" class="hidden fixed inset-0 z-[100] flex items-end justify-center sm:items-center p-0 sm:p-4 bg-black/60 backdrop-blur-sm transition-all duration-300">
    <div class="bg-white w-full max-w-md rounded-t-[32px] sm:rounded-[32px] p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto relative animate-in slide-in-from-bottom duration-300">
      <!-- Close Button -->
      <button id="close-food-modal" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-600 hover:bg-neutral-200 transition-colors z-10">
        <span class="material-symbols-outlined text-lg">close</span>
      </button>

      <!-- Dish Image -->
      <div class="w-full h-56 rounded-2xl bg-neutral-50 border border-neutral-100 flex items-center justify-center p-2 relative overflow-hidden">
        <img id="fmodal-img" src="/assets/d686bc969706f3bd6cf093f663be9579.jpg" alt="Dish" class="w-full h-full object-cover rounded-xl" onerror="this.onerror=null;this.src='/assets/d686bc969706f3bd6cf093f663be9579.jpg';" />
        <span id="fmodal-diet-badge" class="absolute top-3 left-3 bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] font-black px-2.5 py-0.5 rounded-full flex items-center gap-1">
          🟢 VEG
        </span>
      </div>

      <!-- Header Info -->
      <div>
        <div class="flex items-center justify-between">
          <span id="fmodal-category" class="text-[11px] font-extrabold text-primary uppercase tracking-wider">Restaurant Specialty</span>
          <div class="flex items-center gap-1 text-xs font-bold text-neutral-600">
            <span class="text-yellow-500">★</span>
            <span id="fmodal-rating">4.8 (1.2k+ ratings)</span>
          </div>
        </div>
        <h2 id="fmodal-title" class="text-xl font-extrabold text-neutral-900 mt-1 leading-tight">Dish Name</h2>
        <p id="fmodal-tag" class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded w-max mt-1">Bestseller</p>
      </div>

      <!-- Pricing Row -->
      <div class="flex items-baseline gap-2 pt-1 border-t border-neutral-100">
        <span id="fmodal-price" class="text-2xl font-black text-on-surface">₹240</span>
        <span class="text-xs font-bold text-neutral-400">Taxes & Packaging included</span>
      </div>

      <!-- Description & Ingredients -->
      <div class="space-y-2 pt-1">
        <h3 class="text-xs font-extrabold text-neutral-900 uppercase tracking-wider">Dish Description</h3>
        <p id="fmodal-desc" class="text-xs text-neutral-600 leading-relaxed font-medium">
          Prepared fresh to order using authentic spices and premium ingredients. Delivered hot in leak-proof packaging.
        </p>
        <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-bold text-neutral-700">
          <div class="bg-neutral-50 p-2 rounded-xl border border-neutral-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-base">timer</span>
            <span>20-25 Mins Hot</span>
          </div>
          <div class="bg-neutral-50 p-2 rounded-xl border border-neutral-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 text-base">restaurant</span>
            <span>Freshly Cooked</span>
          </div>
        </div>
      </div>

      <!-- Modal Action Footer -->
      <div class="pt-3 border-t border-neutral-100">
        <button id="fmodal-btn-add" class="w-full bg-primary text-white font-extrabold py-3.5 rounded-2xl shadow-lg shadow-primary/20 hover:brightness-105 active:scale-[0.98] transition-all text-xs flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">shopping_basket</span>
          <span>Add Item • <strong id="fmodal-btn-price">₹240</strong></span>
        </button>
      </div>
    </div>
  </div>
  <!-- Cart Floating Bar -->
  <div class="fixed bottom-24 left-4 right-4 z-50">
    <div class="bg-primary text-on-primary h-16 rounded-2xl flex items-center justify-between px-6 shadow-xl cursor-pointer hover:brightness-110 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined">shopping_basket</span>
        </div>
        <div>
          <p class="font-bold text-label-md leading-none">0 Items</p>
          <p class="text-[10px] text-white/80">₹0 • Food Order</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-bold uppercase tracking-widest text-sm">Place Order</span>
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </div>
  </div>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 w-full flex justify-around items-center h-20 pb-safe px-4 bg-surface/80 backdrop-blur-xl z-50 border-t border-outline-variant/30 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary transition-all" href="/home">
      <span class="material-symbols-outlined">home</span>
      <span class="font-label-sm text-label-sm">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary transition-all" href="/orders">
      <span class="material-symbols-outlined">receipt_long</span>
      <span class="font-label-sm text-label-sm">Orders</span>
    </a>
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary transition-all" href="/grocery">
      <span class="material-symbols-outlined">search</span>
      <span class="font-label-sm text-label-sm">Search</span>
    </a>
    <a class="flex flex-col items-center justify-center text-secondary hover:text-primary transition-all" href="/profile">
      <span class="material-symbols-outlined">person</span>
      <span class="font-label-sm text-label-sm">Account</span>
    </a>
  </nav>

  <script is:inline>
    // Bulletproof Client-side Filtering using setProperty !important
    let currentCategory = 'all';
    let currentDietFilter = 'all';
    let searchQuery = '';

    let cart = JSON.parse(localStorage.getItem('bhusawal_cart_food') || '{}');
    let cartCount = 0;
    let cartTotal = 0;

    const cartBar = document.querySelector('.fixed.bottom-24');
    const cartTextCount = cartBar ? cartBar.querySelector('p.font-bold') : null;
    const cartTextDetails = cartBar ? cartBar.querySelector('p.text-white\/80') : null;

    function updateCartBar() {
      if (!cartBar) return;
      localStorage.setItem('bhusawal_cart_food', JSON.stringify(cart));
      cartCount = Object.values(cart).reduce((sum, item) => sum + item.qty, 0);
      cartTotal = Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
      if (cartCount > 0) {
        cartBar.style.setProperty('display', 'flex', 'important');
        if (cartTextCount) cartTextCount.textContent = cartCount + ' Item' + (cartCount > 1 ? 's' : '');
        if (cartTextDetails) cartTextDetails.textContent = `₹${cartTotal} • Food Order`;
      } else {
        cartBar.style.setProperty('display', 'none', 'important');
      }
    }

    function updateFilterStatusBanner(totalVisible) {
      const statusText = document.getElementById('filter-status-text');
      if (!statusText) return;

      let catText = currentCategory === 'all' ? 'All Categories' : currentCategory;
      let dietText = currentDietFilter === 'all' ? 'All Dishes' : (currentDietFilter === 'veg' ? '🟢 Veg Only' : '🔴 Non-Veg Only');
      let searchText = searchQuery ? ` for "${searchQuery}"` : '';

      statusText.textContent = `Showing: ${dietText} • ${catText}${searchText} (${totalVisible} Dishes)`;
    }

    function filterMenu() {
      const sections = document.querySelectorAll('.food-category-section');
      let totalVisible = 0;

      sections.forEach(sec => {
        const secCat = sec.getAttribute('data-cat');
        let secVisibleCount = 0;

        // Check category level
        const matchesCategory = (currentCategory === 'all') || (secCat === currentCategory);

        // Sub diet groups
        const dietGroups = sec.querySelectorAll('.food-diet-group');
        dietGroups.forEach(group => {
          const groupDiet = group.getAttribute('data-group-diet');
          let groupVisibleCount = 0;

          const items = group.querySelectorAll('.food-item');
          items.forEach(item => {
            const type = item.getAttribute('data-type');
            const name = item.getAttribute('data-name') || '';
            const desc = item.getAttribute('data-desc') || '';

            const matchesDiet = (currentDietFilter === 'all') || (type === currentDietFilter);
            const matchesSearch = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery);

            if (matchesCategory && matchesDiet && matchesSearch) {
              item.style.setProperty('display', 'flex', 'important');
              groupVisibleCount++;
              secVisibleCount++;
              totalVisible++;
            } else {
              item.style.setProperty('display', 'none', 'important');
            }
          });

          if (groupVisibleCount > 0 && matchesCategory) {
            group.style.setProperty('display', 'block', 'important');
          } else {
            group.style.setProperty('display', 'none', 'important');
          }
        });

        if (secVisibleCount > 0 && matchesCategory) {
          sec.style.setProperty('display', 'block', 'important');
        } else {
          sec.style.setProperty('display', 'none', 'important');
        }
      });

      updateFilterStatusBanner(totalVisible);
    }

    function replaceWithStepper(btn, title, price, imgUrl = '') {
      const stepper = document.createElement('div');
      stepper.className = 'flex items-center rounded-xl shadow-md overflow-hidden bg-primary z-10';
      stepper.innerHTML = `
        <button class="qty-minus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">−</button>
        <span class="qty-value w-6 h-7 flex items-center justify-center text-white text-[11px] font-extrabold">1</span>
        <button class="qty-plus w-7 h-7 flex items-center justify-center text-white font-bold text-sm hover:bg-white/20 active:scale-90 transition-all">+</button>
      `;
      btn.replaceWith(stepper);

      if (!cart[title]) {
        cart[title] = { price, qty: 1, themeColor: '#ea580c', imgUrl, packSize: '1 serving', category: 'Food Delivery' };
      }
      updateCartBar();

      const qtyDisplay = stepper.querySelector('.qty-value');
      qtyDisplay.textContent = cart[title].qty;

      stepper.querySelector('.qty-plus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty++;
        qtyDisplay.textContent = cart[title].qty;
        updateCartBar();
      });

      stepper.querySelector('.qty-minus').addEventListener('click', (e) => {
        e.stopPropagation();
        cart[title].qty--;
        if (cart[title].qty <= 0) {
          delete cart[title];
          const addBtn = document.createElement('button');
          addBtn.className = 'bg-white border border-primary text-primary px-5 py-1.5 rounded-xl text-xs font-extrabold shadow-md hover:bg-primary/5 active:scale-95 transition-all btn-add';
          addBtn.setAttribute('data-name', title);
          addBtn.setAttribute('data-price', price);
          addBtn.setAttribute('data-img', imgUrl);
          addBtn.textContent = 'ADD';
          stepper.replaceWith(addBtn);
          bindAddButton(addBtn);
        } else {
          qtyDisplay.textContent = cart[title].qty;
        }
        updateCartBar();
      });
    }

    function bindAddButton(btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const title = btn.getAttribute('data-name');
        const price = parseInt(btn.getAttribute('data-price'));
        const imgUrl = btn.getAttribute('data-img');
        replaceWithStepper(btn, title, price, imgUrl);
      });
    }

    function syncUIWithCart() {
      document.querySelectorAll('.food-item').forEach(card => {
        const titleEl = card.querySelector('h3');
        if (!titleEl) return;
        const title = titleEl.textContent.trim();
        if (cart[title]) {
          const btn = card.querySelector('.btn-add');
          if (btn) {
            const price = cart[title].price;
            const imgUrl = cart[title].imgUrl;
            replaceWithStepper(btn, title, price, imgUrl);
          }
        }
      });
      updateCartBar();
    }

    // Category Pill Handlers
    document.querySelectorAll('.cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-btn').forEach(b => {
          b.className = 'cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-neutral-100 text-neutral-700 hover:bg-primary/10 active:scale-95';
        });
        btn.className = 'cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-primary text-white shadow-sm active:scale-95';
        currentCategory = btn.getAttribute('data-cat');
        filterMenu();
      });
    });

    // Diet Filter Handlers
    const btnAll = document.getElementById('btn-all');
    const btnVeg = document.getElementById('btn-veg');
    const btnNonVeg = document.getElementById('btn-nonveg');

    if (btnAll) {
      btnAll.addEventListener('click', () => {
        btnAll.className = "diet-btn px-4 py-1.5 rounded-xl border border-primary bg-primary text-white font-extrabold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1";
        if (btnVeg) btnVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-emerald-300 bg-white text-emerald-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-emerald-50";
        if (btnNonVeg) btnNonVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-red-300 bg-white text-red-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-red-50";
        currentDietFilter = 'all';
        filterMenu();
      });
    }

    if (btnVeg) {
      btnVeg.addEventListener('click', () => {
        if (btnAll) btnAll.className = "diet-btn px-4 py-1.5 rounded-xl border border-outline-variant bg-white text-neutral-600 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-neutral-50";
        btnVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-emerald-600 bg-emerald-600 text-white font-extrabold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1";
        if (btnNonVeg) btnNonVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-red-300 bg-white text-red-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-red-50";
        currentDietFilter = 'veg';
        filterMenu();
      });
    }

    if (btnNonVeg) {
      btnNonVeg.addEventListener('click', () => {
        if (btnAll) btnAll.className = "diet-btn px-4 py-1.5 rounded-xl border border-outline-variant bg-white text-neutral-600 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-neutral-50";
        if (btnVeg) btnVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-emerald-300 bg-white text-emerald-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-emerald-50";
        btnNonVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-red-600 bg-red-600 text-white font-extrabold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1";
        currentDietFilter = 'nonveg';
        filterMenu();
      });
    }

    // Reset All Filters
    const resetBtn = document.getElementById('reset-all-filters');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentCategory = 'all';
        currentDietFilter = 'all';
        searchQuery = '';

        const searchInput = document.getElementById('search-food');
        if (searchInput) searchInput.value = '';

        // Reset Category Buttons
        document.querySelectorAll('.cat-btn').forEach((b, idx) => {
          if (idx === 0) b.className = 'cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-primary text-white shadow-sm active:scale-95';
          else b.className = 'cat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all bg-neutral-100 text-neutral-700 hover:bg-primary/10 active:scale-95';
        });

        // Reset Diet Buttons
        if (btnAll) btnAll.className = "diet-btn px-4 py-1.5 rounded-xl border border-primary bg-primary text-white font-extrabold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1";
        if (btnVeg) btnVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-emerald-300 bg-white text-emerald-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-emerald-50";
        if (btnNonVeg) btnNonVeg.className = "diet-btn px-4 py-1.5 rounded-xl border border-red-300 bg-white text-red-700 font-extrabold text-xs active:scale-95 transition-all flex items-center gap-1 hover:bg-red-50";

        filterMenu();
      });
    }

    // Search Input Handler
    const searchInput = document.getElementById('search-food');
    const clearBtn = document.getElementById('clear-search');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        if (searchQuery) {
          if (clearBtn) clearBtn.classList.remove('hidden');
        } else {
          if (clearBtn) clearBtn.classList.add('hidden');
        }
        filterMenu();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        clearBtn.classList.add('hidden');
        filterMenu();
      });
    }

    
    // Food Details Modal Script
    const fModal = document.getElementById('food-modal');
    const closeFoodModalBtn = document.getElementById('close-food-modal');
    let currentFoodModalItem = null;

    if (closeFoodModalBtn && fModal) {
      closeFoodModalBtn.addEventListener('click', () => fModal.classList.add('hidden'));
      fModal.addEventListener('click', (e) => {
        if (e.target === fModal) fModal.classList.add('hidden');
      });
    }

    function openFoodModal(card) {
      if (!fModal) return;
      const titleEl = card.querySelector('h3');
      const title = titleEl ? titleEl.textContent.trim() : '';
      const type = card.getAttribute('data-type') || 'veg';
      const priceText = card.querySelector('p.font-extrabold') ? card.querySelector('p.font-extrabold').textContent.trim() : '₹0';
      const price = parseInt(priceText.replace(/[^\d]/g, '')) || 0;
      const desc = card.querySelector('p.text-\[11px\]') ? card.querySelector('p.text-\[11px\]').textContent.trim() : '';
      const imgEl = card.querySelector('img');
      const imgUrl = imgEl ? imgEl.getAttribute('src') : '';

      document.getElementById('fmodal-title').textContent = title;
      document.getElementById('fmodal-price').textContent = priceText;
      document.getElementById('fmodal-btn-price').textContent = priceText;
      document.getElementById('fmodal-desc').textContent = desc || 'Prepared fresh using authentic spices and premium ingredients.';
      document.getElementById('fmodal-img').src = imgUrl || '/assets/d686bc969706f3bd6cf093f663be9579.jpg';

      const dietBadge = document.getElementById('fmodal-diet-badge');
      if (type === 'nonveg') {
        dietBadge.className = 'absolute top-3 left-3 bg-red-100 text-red-800 border border-red-300 text-[10px] font-black px-2.5 py-0.5 rounded-full flex items-center gap-1';
        dietBadge.innerHTML = '🔴 NON-VEG';
      } else {
        dietBadge.className = 'absolute top-3 left-3 bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] font-black px-2.5 py-0.5 rounded-full flex items-center gap-1';
        dietBadge.innerHTML = '🟢 VEG';
      }

      currentFoodModalItem = { title, price, imgUrl };
      fModal.classList.remove('hidden');
    }

    const fmodalAddBtn = document.getElementById('fmodal-btn-add');
    if (fmodalAddBtn) {
      fmodalAddBtn.addEventListener('click', () => {
        if (currentFoodModalItem) {
          if (!cart[currentFoodModalItem.title]) {
            cart[currentFoodModalItem.title] = { price: currentFoodModalItem.price, qty: 1, themeColor: '#ea580c', imgUrl: currentFoodModalItem.imgUrl, packSize: '1 serving', category: 'Food Delivery' };
          } else {
            cart[currentFoodModalItem.title].qty++;
          }
          updateCartBar();
          syncUIWithCart();
          fModal.classList.add('hidden');
        }
      });
    }

    document.addEventListener('click', (e) => {
      const foodCard = e.target.closest('.food-item');
      if (foodCard && !e.target.closest('button')) {
        openFoodModal(foodCard);
      }
    });

    // Initial binding
    document.querySelectorAll('.btn-add').forEach(btn => bindAddButton(btn));
    syncUIWithCart();

    if (cartBar) {
      cartBar.addEventListener('click', () => {
        if (cartCount > 0) {
          window.location.href = '/billing?type=food';
        }
      });
    }
  </script>

  <Switcher />
  <script src="/assets/zepto_search.js" defer></script>
</body>
</html>
