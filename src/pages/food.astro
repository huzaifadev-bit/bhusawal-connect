---
import Switcher from '../components/Switcher.astro';

// Banners for Food Slider
const foodBanners = [
  {
    id: 1,
    title: 'Royal Biryani Special',
    subtitle: 'Hot & Authentic Dum Biryani delivered in 20 Mins',
    tag: 'BHUSAWAL FOOD EXPRESS',
    bgGradient: 'from-red-600 via-red-700 to-rose-900',
    btnText: 'Order Biryani Now',
    link: '/shops?id=royal_biryani'
  },
  {
    id: 2,
    title: 'Special Veg Deluxe Thali',
    subtitle: 'Fresh Home-style Thalis & Sabzi from Sagar Grand',
    tag: 'TOP RATED DINING',
    bgGradient: 'from-rose-600 via-red-600 to-red-800',
    btnText: 'Explore Thalis',
    link: '/shops?id=sagar_grand'
  },
  {
    id: 3,
    title: 'Fresh Sweets & Dairy Treats',
    subtitle: 'Pure Cow Ghee Sweets & Malai Paneer from Shiv Dairy',
    tag: 'FRESH MORNING',
    bgGradient: 'from-red-700 via-rose-700 to-red-900',
    btnText: 'Order Sweets',
    link: '/shops?id=shiv_dairy'
  }
];

// Partner Sponsored Restaurants
const sponsoredPartnerRestaurants = [
  {
    id: 'royal_biryani',
    name: 'Royal Biryani & Caterers',
    logo: '🍲',
    cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80',
    rating: '4.8',
    ratingsCount: '850+',
    deliveryTime: '20-25 min',
    cuisine: 'Mughlai • Dum Biryani • North Indian',
    isVerified: true
  },
  {
    id: 'sagar_grand',
    name: 'Hotel Sagar Grand',
    logo: '🏨',
    cover: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    ratingsCount: '1,120+',
    deliveryTime: '15-20 min',
    cuisine: 'Multi-Cuisine • Thalis • North Indian',
    isVerified: true
  },
  {
    id: 'shiv_dairy',
    name: 'Shiv Dairy & Sweets',
    logo: '🥛',
    cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    ratingsCount: '1,500+',
    deliveryTime: '10-15 min',
    cuisine: 'Fresh Milk • Paneer • Traditional Sweets',
    isVerified: true
  },
  {
    id: 'kwality_hub',
    name: "Kwality Wall's Ice Cream Hub",
    logo: '🍦',
    cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80',
    rating: '4.7',
    ratingsCount: '610+',
    deliveryTime: '12-18 min',
    cuisine: 'Ice Creams • Shakes • Sundaes • Desserts',
    isVerified: true
  },
  {
    id: 'tandoor_hut',
    name: 'Tandoor Hut Chinese & Grill',
    logo: '🍜',
    cover: 'https://images.unsplash.com/photo-1585032226651-759b368d7246?auto=format&fit=crop&w=800&q=80',
    rating: '4.6',
    ratingsCount: '740+',
    deliveryTime: '25-30 min',
    cuisine: 'Indo-Chinese • Hakka Noodles • Rolls',
    isVerified: true
  },
  {
    id: 'thali_house',
    name: 'Bhusawal Thali House',
    logo: '🍱',
    cover: 'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=800&q=80',
    rating: '4.8',
    ratingsCount: '980+',
    deliveryTime: '18-22 min',
    cuisine: 'Special Veg Thalis • Solkadhi • Maharashtrian',
    isVerified: true
  },
  {
    id: 'south_corner',
    name: 'South Corner Dosa Point',
    logo: '🥞',
    cover: 'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=800&q=80',
    rating: '4.7',
    ratingsCount: '520+',
    deliveryTime: '15-20 min',
    cuisine: 'Masala Dosa • Idli Sambar • Filter Coffee',
    isVerified: true
  },
  {
    id: 'burger_station',
    name: 'Burger & Fries Station',
    logo: '🍔',
    cover: 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80',
    rating: '4.5',
    ratingsCount: '430+',
    deliveryTime: '20-25 min',
    cuisine: 'Burgers • Peri Peri Fries • Shakes • Pizza',
    isVerified: true
  }
];
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Food Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- 1. TOP HEADER (DELIVERY ADDRESS & NOTIFICATION BUTTON) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="food-address-btn">
        <div class="w-9 h-9 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-redBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-redBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="food-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button & Cart Button -->
    <div class="flex items-center gap-2">
      <a href="/notifications" class="relative w-10 h-10 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold hover:bg-red-100 transition-colors" title="Notifications">
        <span class="material-symbols-outlined text-xl">notifications</span>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-redBrand rounded-full border-2 border-white animate-ping"></span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-redBrand text-white flex items-center justify-center font-bold hover:bg-redDark transition-colors shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="food-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-6">

    <!-- 2. SEARCH BAR -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-redBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="food-search-input" placeholder="Search partner restaurants, cuisines (e.g. Biryani, Thali, Pizza)..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
        <button id="clear-food-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- 3. FOOD BANNER SLIDER / CAROUSEL -->
    <section class="relative overflow-hidden rounded-3xl shadow-xl bg-gradient-to-r from-red-600 via-red-700 to-rose-900 text-white p-6 sm:p-8">
      <div class="relative z-10 max-w-xl space-y-3" id="banner-slider-content">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 bg-white text-redBrand text-[10px] font-black uppercase tracking-wider rounded-full shadow-xs">BHUSAWAL FOOD EXPRESS</span>
          <span class="px-2.5 py-0.5 bg-white/20 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded-full">HOT & FRESH</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-white leading-tight" id="banner-slider-title">Craving Something Delicious?</h1>
        <p class="text-xs sm:text-sm text-red-100 font-semibold" id="banner-slider-subtitle">Order Biryani, Thalis, Starters & Sweets from top verified Bhusawal partner restaurants with 20-Min delivery.</p>
        <div class="pt-1">
          <a href="/shops?id=royal_biryani" id="banner-slider-btn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-redBrand hover:bg-redLight font-black text-xs rounded-xl shadow-md transition-all active:scale-95">
            <span>Order Now</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Slider Indicator Dots -->
      <div class="absolute bottom-3 right-4 flex items-center gap-1.5 z-10">
        <span class="w-2.5 h-2.5 rounded-full bg-white transition-all cursor-pointer" id="dot-0"></span>
        <span class="w-2 h-2 rounded-full bg-white/40 transition-all cursor-pointer" id="dot-1"></span>
        <span class="w-2 h-2 rounded-full bg-white/40 transition-all cursor-pointer" id="dot-2"></span>
      </div>
    </section>

    <!-- 4. HORIZONTAL SECTION: SPONSORED RESTAURANTS -->
    <section class="space-y-4 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span class="text-amber-500">⭐</span>
            <span>Sponsored Restaurants</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Verified partner restaurants in Bhusawal</p>
        </div>
        <span class="px-3 py-1 bg-amber-100 text-amber-800 text-[10px] font-black uppercase tracking-wider rounded-full border border-amber-200">
          PARTNERS
        </span>
      </div>

      <!-- HORIZONTAL SCROLLABLE & RESPONSIVE GRID -->
      <div id="sponsored-restaurants-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
        {sponsoredPartnerRestaurants.map(rest => (
          <div 
            class="restaurant-card group bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-2xl hover:border-redBrand transition-all duration-300 overflow-hidden cursor-pointer flex flex-col justify-between relative"
            data-id={rest.id}
            data-name={rest.name.toLowerCase()} 
            data-cuisine={rest.cuisine.toLowerCase()}
            onclick={`window.location.href='/shops?id=${rest.id}';`}
          >
            
            <!-- Cover Image -->
            <div class="h-48 sm:h-52 bg-slate-100 relative overflow-hidden rounded-t-3xl">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
              
              <!-- Verified Partner Badge -->
              <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shadow-md z-10 border border-slate-200">
                <span>✓ Verified Partner</span>
              </div>

              <!-- Rating Badge -->
              <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-md text-amber-400 px-2.5 py-1 rounded-full text-[10px] font-black flex items-center gap-1 shadow-xs z-10">
                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="text-white">{rest.rating}</span>
                <span class="text-slate-400 text-[9px]">({rest.ratingsCount})</span>
              </div>

              <!-- Delivery Time -->
              <div class="absolute bottom-3 right-3 bg-redBrand text-white px-2.5 py-1 rounded-full text-[10px] font-black flex items-center gap-1 shadow-xs z-10">
                <span>⚡ {rest.deliveryTime}</span>
              </div>
            </div>

            <!-- Details -->
            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-redLight text-redBrand flex items-center justify-center text-2xl shrink-0 border border-red-100 shadow-xs">
                  {rest.logo}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-base sm:text-lg font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">
                    {rest.name}
                  </h3>
                  <p class="text-xs font-bold text-slate-400 mt-0.5 truncate">{rest.cuisine}</p>
                </div>
              </div>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold text-redBrand group-hover:underline flex items-center gap-1">
                  <span>View Menu</span>
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </span>
                <span class="px-2.5 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-extrabold border border-emerald-100">
                  Open Now
                </span>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE SEARCH ENGINE & BANNER SLIDER -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // Update Cart Badge
      function updateCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const badge = document.getElementById('food-cart-badge');
          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          if (badge) badge.textContent = totalQty;
        } catch(e) {}
      }

      updateCartBadge();

      // Banner Slider Logic
      const banners = [
        {
          title: 'Royal Biryani Special',
          subtitle: 'Hot & Authentic Dum Biryani delivered in 20 Mins',
          btnText: 'Order Biryani Now',
          link: '/shops?id=royal_biryani'
        },
        {
          title: 'Special Veg Deluxe Thali',
          subtitle: 'Fresh Home-style Thalis & Sabzi from Sagar Grand',
          btnText: 'Explore Thalis',
          link: '/shops?id=sagar_grand'
        },
        {
          title: 'Fresh Sweets & Dairy Treats',
          subtitle: 'Pure Cow Ghee Sweets & Malai Paneer from Shiv Dairy',
          btnText: 'Order Sweets',
          link: '/shops?id=shiv_dairy'
        }
      ];

      let currentBannerIdx = 0;

      function updateBannerSlide(idx) {
        currentBannerIdx = idx;
        const b = banners[idx];
        const titleEl = document.getElementById('banner-slider-title');
        const subEl = document.getElementById('banner-slider-subtitle');
        const btnEl = document.getElementById('banner-slider-btn');

        if (titleEl) titleEl.textContent = b.title;
        if (subEl) subEl.textContent = b.subtitle;
        if (btnEl) {
          btnEl.setAttribute('href', b.link);
          btnEl.querySelector('span').textContent = b.btnText;
        }

        [0, 1, 2].forEach(i => {
          const dot = document.getElementById(`dot-${i}`);
          if (dot) {
            if (i === idx) {
              dot.className = 'w-2.5 h-2.5 rounded-full bg-white transition-all cursor-pointer';
            } else {
              dot.className = 'w-2 h-2 rounded-full bg-white/40 transition-all cursor-pointer';
            }
          }
        });
      }

      [0, 1, 2].forEach(i => {
        document.getElementById(`dot-${i}`)?.addEventListener('click', () => updateBannerSlide(i));
      });

      setInterval(() => {
        currentBannerIdx = (currentBannerIdx + 1) % banners.length;
        updateBannerSlide(currentBannerIdx);
      }, 4000);

      // Search Filtering Engine
      const searchInput = document.getElementById('food-search-input');
      const clearBtn = document.getElementById('clear-food-search');
      const cards = document.querySelectorAll('.restaurant-card');

      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        
        if (query.length > 0) {
          clearBtn?.classList.remove('hidden');
        } else {
          clearBtn?.classList.add('hidden');
        }

        cards.forEach(card => {
          const name = card.dataset.name || '';
          const cuisine = card.dataset.cuisine || '';

          if (!query || name.includes(query) || cuisine.includes(query)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        cards.forEach(card => card.classList.remove('hidden'));
      });

    });
  </script>
</body>
</html>
