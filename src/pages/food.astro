    name: 'Royal Shahi Mutton Dum Biryani',
    restaurant: 'Royal Biryani & Caterers',
    isVeg: false,
    price: 320,
    rating: '4.9',
    category: 'biryani',
    image: 'https://images.unsplash.com/photo-1633945274405-b6c8069047b0?auto=format&fit=crop&w=800&q=80'
