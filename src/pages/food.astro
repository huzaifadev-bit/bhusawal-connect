---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Food Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- 1. TOP HEADER (DELIVERY ADDRESS & NOTIFICATION BUTTON) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="food-address-btn">
        <div class="w-9 h-9 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-redBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-redBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="food-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button -->
    <div class="flex items-center gap-2">
      <a href="/notifications" class="relative w-10 h-10 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold hover:bg-red-100 transition-colors" title="Notifications">
        <span class="material-symbols-outlined text-xl">notifications</span>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-redBrand rounded-full border-2 border-white animate-ping"></span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-redBrand text-white flex items-center justify-center font-bold hover:bg-redDark transition-colors shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="food-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-8">

    <!-- 2. STICKY SEARCH BAR -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-redBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="food-search-input" placeholder="Search dishes, restaurants, cuisines (e.g. Biryani, Thali, Paneer)..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
        <button id="clear-food-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- 3. BANNER CAROUSEL SHOWCASE -->
    <section class="relative overflow-hidden rounded-3xl shadow-xl bg-gradient-to-r from-red-600 via-red-700 to-rose-900 text-white p-6 sm:p-8">
      <div class="relative z-10 max-w-xl space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 bg-white text-redBrand text-[10px] font-black uppercase tracking-wider rounded-full shadow-xs">BHUSAWAL FOOD EXPRESS</span>
          <span class="px-2.5 py-0.5 bg-white/20 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded-full">HOT & FRESH</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-white leading-tight">Craving Something Delicious?</h1>
        <p class="text-xs sm:text-sm text-red-100 font-semibold">Order Biryani, Thalis, Starters & Sweets from top verified Bhusawal restaurants with 20-Min delivery.</p>
      </div>
    </section>

    <!-- 4. ⭐ SPONSORED RESTAURANTS (ALWAYS FIRST) -->
    <!-- DESKTOP: 3 per row, TABLET: 2 per row, MOBILE: 1 per row -->
    <section class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span class="text-amber-500">⭐</span>
            <span>Sponsored Restaurants</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top featured dining spots in Bhusawal</p>
        </div>
        <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 text-[10px] font-black uppercase tracking-wider rounded-md">FEATURED</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {sponsoredRestaurants.map(rest => (
          <div class="restaurant-card group bg-white rounded-3xl border-2 border-amber-200 shadow-sm hover:shadow-2xl hover:border-redBrand transition-all duration-300 overflow-hidden cursor-pointer flex flex-col relative" data-name={rest.name.toLowerCase()} data-cuisine={rest.cuisine.toLowerCase()} onclick="window.location.href='/shops';">
            
            <!-- Large Cover Image Container -->
            <div class="h-48 bg-slate-100 relative overflow-hidden rounded-t-3xl">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
              
              <!-- Sponsored Badge -->
              <div class="absolute top-3 left-3 bg-amber-500 text-white px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shadow-md z-10">
                <span>⭐ SPONSORED</span>
              </div>

              <!-- Favourite Heart Button -->
              <button class="fav-rest-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
              </button>

              <!-- ETA & Distance Badge -->
              <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black flex items-center gap-2 shadow-xs z-10">
                <span class="flex items-center gap-1">⚡ {rest.deliveryTime}</span>
                <span>•</span>
                <span class="flex items-center gap-1">📍 {rest.distance}</span>
              </div>
            </div>

            <!-- Card Details Container -->
            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-redLight text-redBrand flex items-center justify-center text-2xl shrink-0 border border-red-100 shadow-xs">
                  {rest.logo}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <h3 class="text-base sm:text-lg font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">{rest.name}</h3>
                    <span class="text-emerald-600 text-xs shrink-0" title="Verified Partner">✓</span>
                  </div>
                  <p class="text-xs font-bold text-slate-400 mt-0.5 truncate">{rest.cuisine}</p>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
                <!-- Rating -->
                <span class="flex items-center gap-1 text-amber-600 bg-amber-50 px-2.5 py-1 rounded-xl border border-amber-100">
                  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                  {rest.rating} <span class="text-[10px] text-slate-400 font-semibold">({rest.ratingsCount})</span>
                </span>
                
                <div class="flex items-center gap-2">
                  <!-- Verified Badge -->
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-extrabold uppercase">
                    Verified Partner
                  </span>
                  <!-- Open Now Badge -->
                  <span class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-extrabold border border-emerald-100">
                    Open Now
                  </span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- 5. 🔥 POPULAR RESTAURANTS -->
    <!-- DESKTOP: 3 per row, TABLET: 2 per row, MOBILE: 1 per row -->
    <section class="space-y-4 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span class="text-orange-500">🔥</span>
            <span>Popular Restaurants</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Most ordered dining spots in Bhusawal</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {popularRestaurants.map(rest => (
          <div class="restaurant-card group bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-2xl hover:border-redBrand transition-all duration-300 overflow-hidden cursor-pointer flex flex-col relative" data-name={rest.name.toLowerCase()} data-cuisine={rest.cuisine.toLowerCase()} onclick="window.location.href='/shops';">
            
            <div class="h-44 sm:h-48 bg-slate-100 relative overflow-hidden rounded-t-3xl">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
              
              <!-- Favourite Heart Button -->
              <button class="fav-rest-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
              </button>

              <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black flex items-center gap-2 shadow-xs z-10">
                <span>⚡ {rest.deliveryTime}</span>
                <span>•</span>
                <span>📍 {rest.distance}</span>
              </div>
            </div>

            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-redLight text-redBrand flex items-center justify-center text-2xl shrink-0 border border-red-100 shadow-xs">
                  {rest.logo}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <h3 class="text-base sm:text-lg font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">{rest.name}</h3>
                    <span class="text-emerald-600 text-xs shrink-0" title="Verified Partner">✓</span>
                  </div>
                  <p class="text-xs font-bold text-slate-400 mt-0.5 truncate">{rest.cuisine}</p>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
                <span class="flex items-center gap-1 text-amber-600 bg-amber-50 px-2.5 py-1 rounded-xl border border-amber-100">
                  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                  {rest.rating} <span class="text-[10px] text-slate-400 font-semibold">({rest.ratingsCount})</span>
                </span>
                
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-extrabold uppercase">
                    Verified Partner
                  </span>
                  <span class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-extrabold border border-emerald-100">
                    Open Now
                  </span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- 6. 🍽️ ALL RESTAURANTS -->
    <!-- DESKTOP: 3 per row, TABLET: 2 per row, MOBILE: 1 per row -->
    <section class="space-y-4 pt-2">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span>🍽️</span>
            <span>All Restaurants</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Explore all food partners delivering across Bhusawal</p>
        </div>
      </div>

      <div id="all-restaurants-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {allRestaurants.map(rest => (
          <div class="restaurant-card group bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-2xl hover:border-redBrand transition-all duration-300 overflow-hidden cursor-pointer flex flex-col relative" data-name={rest.name.toLowerCase()} data-cuisine={rest.cuisine.toLowerCase()} onclick="window.location.href='/shops';">
            
            <div class="h-44 sm:h-48 bg-slate-100 relative overflow-hidden rounded-t-3xl">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent"></div>
              
              {rest.isSponsored && (
                <div class="absolute top-3 left-3 bg-amber-500 text-white px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider shadow-xs z-10">
                  ⭐ SPONSORED
                </div>
              )}

              <!-- Favourite Heart Button -->
              <button class="fav-rest-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
              </button>

              <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black flex items-center gap-2 shadow-xs z-10">
                <span>⚡ {rest.deliveryTime}</span>
                <span>•</span>
                <span>📍 {rest.distance}</span>
              </div>
            </div>

            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-redLight text-redBrand flex items-center justify-center text-2xl shrink-0 border border-red-100 shadow-xs">
                  {rest.logo}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <h3 class="text-base sm:text-lg font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">{rest.name}</h3>
                    <span class="text-emerald-600 text-xs shrink-0" title="Verified Partner">✓</span>
                  </div>
                  <p class="text-xs font-bold text-slate-400 mt-0.5 truncate">{rest.cuisine}</p>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-2 border-t border-slate-100">
                <span class="flex items-center gap-1 text-amber-600 bg-amber-50 px-2.5 py-1 rounded-xl border border-amber-100">
                  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                  {rest.rating} <span class="text-[10px] text-slate-400 font-semibold">({rest.ratingsCount})</span>
                </span>
                
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-extrabold uppercase">
                    Verified Partner
                  </span>
                  <span class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-extrabold border border-emerald-100">
                    Open Now
                  </span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE SEARCH ENGINE & CART BADGE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // Update Cart Badge
      function updateCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
          const badge = document.getElementById('food-cart-badge');
          const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
          if (badge) badge.textContent = totalQty;
        } catch(e) {}
      }

      updateCartBadge();

      // Search Filtering Engine for Restaurants
      const searchInput = document.getElementById('food-search-input');
      const clearBtn = document.getElementById('clear-food-search');
      const restaurantCards = document.querySelectorAll('.restaurant-card');

      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        
        if (query.length > 0) {
          clearBtn?.classList.remove('hidden');
        } else {
          clearBtn?.classList.add('hidden');
        }

        restaurantCards.forEach(card => {
          const name = card.dataset.name || '';
          const cuisine = card.dataset.cuisine || '';

          if (name.includes(query) || cuisine.includes(query)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        restaurantCards.forEach(card => card.classList.remove('hidden'));
      });

    });
  </script>
</body>
</html>
