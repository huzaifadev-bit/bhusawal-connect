---
import Switcher from '../components/Switcher.astro';
import foodCatalog from '../../public/food_catalog.json';

// Standardized Food Categories
const foodCategories = [
  { id: 'all', name: 'All Foods', icon: '🍽️', kw: '' },
  { id: 'breakfast', name: 'Breakfast', icon: '🍳', kw: 'breakfast' },
  { id: 'burgers', name: 'Burgers', icon: '🍔', kw: 'burgers' },
  { id: 'pizza', name: 'Pizza', icon: '🍕', kw: 'pizza' },
  { id: 'sandwiches', name: 'Sandwiches', icon: '🥪', kw: 'sandwiches' },
  { id: 'rolls', name: 'Rolls', icon: '🌯', kw: 'rolls' },
  { id: 'chinese', name: 'Chinese', icon: '🍜', kw: 'chinese' },
  { id: 'biryani', name: 'Biryani', icon: '🍲', kw: 'biryani' },
  { id: 'veg_main', name: 'Veg Main Course', icon: '🥘', kw: 'veg main course' },
  { id: 'chicken', name: 'Chicken', icon: '🍗', kw: 'chicken' },
  { id: 'mutton', name: 'Mutton', icon: '🍖', kw: 'mutton' },
  { id: 'fish', name: 'Fish', icon: '🐟', kw: 'fish' },
  { id: 'egg', name: 'Egg', icon: '🥚', kw: 'egg' },
  { id: 'rice', name: 'Rice', icon: '🍚', kw: 'rice' },
  { id: 'roti_naan', name: 'Roti & Naan', icon: '🫓', kw: 'roti & naan' },
  { id: 'desserts', name: 'Desserts', icon: '🍰', kw: 'desserts' },
  { id: 'beverages', name: 'Beverages', icon: '🥤', kw: 'beverages' }
];

// Featured Partner Restaurants (1 Compact Horizontal Row Only)
const featuredPartnerRestaurants = [
  {
    id: 'royal_biryani',
    name: 'Royal Biryani & Caterers',
    logo: '🍲',
    cover: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80',
    rating: '4.8',
    deliveryTime: '20-25 min',
    isVerified: true
  },
  {
    id: 'sagar_grand',
    name: 'Hotel Sagar Grand',
    logo: '🏨',
    cover: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    deliveryTime: '15-20 min',
    isVerified: true
  },
  {
    id: 'shiv_dairy',
    name: 'Shiv Dairy & Sweets',
    logo: '🥛',
    cover: 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=800&q=80',
    rating: '4.9',
    deliveryTime: '10-15 min',
    isVerified: true
  },
  {
    id: 'kwality_hub',
    name: "Kwality Wall's Ice Cream Hub",
    logo: '🍦',
    cover: 'https://images.unsplash.com/photo-1560008511-11c63416e52d?auto=format&fit=crop&w=800&q=80',
    rating: '4.7',
    deliveryTime: '12-18 min',
    isVerified: true
  }
];
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Food Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE BRAND TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- ==================== TOP SECTION: DELIVERY ADDRESS, SEARCH & NOTIFICATION ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="food-address-btn">
        <div class="w-9 h-9 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-redBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-redBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="food-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button & Cart Button -->
    <div class="flex items-center gap-2">
      <a href="/notifications" class="relative w-10 h-10 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold hover:bg-red-100 transition-colors" title="Notifications">
        <span class="material-symbols-outlined text-xl">notifications</span>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-redBrand rounded-full border-2 border-white animate-ping"></span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-redBrand text-white flex items-center justify-center font-bold hover:bg-redDark transition-colors shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="food-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-6">

    <!-- Search Bar (Searches Food Name, Category, Restaurant & Keywords) -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-redBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="food-search-input" placeholder="Search food items, biryani, thalis, pizza, burger..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
        <button id="clear-food-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- ==================== FEATURED PARTNER RESTAURANTS (1 HORIZONTAL ROW ONLY) ==================== -->
    <section class="space-y-3 pt-1">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
          <span class="text-amber-500">⭐</span>
          <span>Featured Partner Restaurants</span>
        </h2>
        <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Scroll →</span>
      </div>

      <!-- SINGLE COMPACT HORIZONTAL SCROLLING ROW -->
      <div class="flex items-center gap-4 overflow-x-auto no-scrollbar py-1.5 px-0.5">
        {featuredPartnerRestaurants.map(rest => (
          <div 
            class="compact-rest-card w-64 sm:w-72 shrink-0 bg-white rounded-2xl border border-slate-100 shadow-xs hover:shadow-lg hover:border-redBrand transition-all cursor-pointer overflow-hidden flex flex-col justify-between group"
            onclick={`window.location.href='/shops?id=${rest.id}';`}
          >
            <!-- Cover Image -->
            <div class="h-28 sm:h-32 bg-slate-100 relative overflow-hidden">
              <img src={rest.cover} alt={rest.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <!-- Verified Partner Badge -->
              <span class="absolute top-2 left-2 px-2 py-0.5 bg-white/95 backdrop-blur-md text-emerald-700 text-[9px] font-black rounded-full uppercase tracking-wider shadow-xs border border-slate-200">
                ✓ Verified
              </span>

              <!-- Delivery Time -->
              <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-redBrand text-white text-[9px] font-black rounded-full shadow-xs">
                ⚡ {rest.deliveryTime}
              </span>
            </div>

            <!-- Compact Content -->
            <div class="p-3 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-redLight text-redBrand flex items-center justify-center text-lg shrink-0 border border-red-100">
                {rest.logo}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-xs font-black font-display text-slate-900 group-hover:text-redBrand transition-colors truncate">
                  {rest.name}
                </h3>
                <div class="flex items-center gap-1 text-[10px] font-bold text-amber-500 mt-0.5">
                  <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                  <span>{rest.rating} Rating</span>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- ==================== FOOD CATEGORIES (HORIZONTAL CHIPS) ==================== -->
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-base sm:text-lg font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
          <span>🍕</span>
          <span>Food Categories</span>
        </h2>
      </div>

      <!-- HORIZONTAL CATEGORY CHIPS -->
      <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1">
        {foodCategories.map((cat, idx) => (
          <button 
            class={`food-cat-chip flex items-center gap-2 px-4 py-2 rounded-full font-black text-xs whitespace-nowrap cursor-pointer transition-all active:scale-95 shrink-0 shadow-xs ${
              idx === 0 
                ? 'bg-redBrand text-white shadow-md ring-2 ring-redBrand/30' 
                : 'bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80'
            }`}
            data-kw={cat.kw}
          >
            <span class="text-base leading-none">{cat.icon}</span>
            <span>{cat.name}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ==================== ALL FOOD PRODUCTS (STANDARDIZED PRODUCT GRID) ==================== -->
    <section id="all-food-products" class="space-y-4 pt-4 border-t border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-1">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span>🍽️</span>
            <span>All Food Products</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5" id="catalog-count-subtitle">Order directly from standardized Bhusawal Connect food menu ({foodCatalog.length} items)</p>
        </div>

        <!-- FILTERS & SORTING BAR -->
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          
          <!-- Veg / Non-Veg Diet Filter Pills -->
          <div class="flex items-center bg-slate-100 border border-slate-200/80 p-0.5 rounded-xl text-xs font-bold">
            <button class="diet-filter-btn px-3 py-1.5 rounded-lg font-black text-xs transition-all bg-white text-slate-900 shadow-xs" data-diet="all">All</button>
            <button class="diet-filter-btn px-3 py-1.5 rounded-lg font-extrabold text-xs text-slate-600 hover:text-emerald-700 transition-all flex items-center gap-1" data-diet="veg">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Veg
            </button>
            <button class="diet-filter-btn px-3 py-1.5 rounded-lg font-extrabold text-xs text-slate-600 hover:text-rose-700 transition-all flex items-center gap-1" data-diet="nonveg">
              <span class="w-2 h-2 rounded-full bg-rose-600"></span> Non-Veg
            </button>
          </div>

          <!-- Sort Select Dropdown -->
          <select id="food-sort-select" class="bg-slate-100 border border-slate-200/80 text-slate-800 text-xs font-extrabold rounded-xl px-3 py-2 outline-none focus:border-redBrand cursor-pointer">
            <option value="default">Sort: Default</option>
            <option value="low-high">Price: Low to High</option>
            <option value="high-low">Price: High to Low</option>
          </select>

        </div>
      </div>

      <!-- PRODUCT GRID STATIC SSR + DYNAMIC CLIENT HYDRATION -->
      <div id="direct-food-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-5">
        {foodCatalog.map(item => (
          <div 
            class="food-product-card bg-white rounded-3xl border border-slate-100 p-3 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-red-200 transition-all duration-300 group relative"
            data-id={item.id}
          >
            <div>
              <!-- Large Food Image Container (Square Aspect) -->
              <div class="w-full aspect-square bg-slate-50/80 rounded-2xl p-2 mb-2 flex items-center justify-center border border-slate-100 overflow-hidden relative">
                
                <!-- Veg / Non-Veg Badge -->
                <div class="absolute top-2 left-2 bg-white/95 backdrop-blur-md px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-1 shadow-xs z-10 border border-slate-200">
                  <span class={`w-2 h-2 rounded-full ${item.isVeg !== false ? 'bg-emerald-600' : 'bg-rose-600'} shrink-0`}></span>
                  <span class={item.isVeg !== false ? 'text-emerald-700' : 'text-rose-700'}>{item.isVeg !== false ? 'VEG' : 'NON-VEG'}</span>
                </div>

                <!-- Prep Time Badge -->
                <div class="absolute bottom-2 left-2 bg-slate-900/80 backdrop-blur-md text-white px-2 py-0.5 rounded-full text-[9px] font-extrabold flex items-center gap-0.5 shadow-xs z-10">
                  <span>⏱️ {item.prepTime || '15 mins'}</span>
                </div>

                <!-- Favourite Heart Button -->
                <button class="fav-food-btn absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                  <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
                </button>

                <img loading="lazy" src={item.image || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg'} alt={item.name} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              </div>

              <!-- Category Tag (NO RESTAURANT NAME DISPLAYED ON CARDS) -->
              <span class="text-[10px] font-bold text-redBrand uppercase tracking-wider block mb-0.5">
                {item.category}
              </span>

              <!-- Food Name -->
              <h3 class="text-xs sm:text-[13px] font-extrabold text-slate-900 line-clamp-2 leading-snug min-h-[2.2rem]">
                {item.name}
              </h3>
            </div>

            <!-- Price & Add / Quantity Selector -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-1 mt-2">
              <span class="text-xs sm:text-sm font-black text-slate-900">₹{item.price}</span>

              <div class="food-direct-action-box" data-id={item.id} data-name={item.name} data-price={item.price} data-img={item.image}>
                <button class="btn-add-direct-food px-3.5 py-1.5 bg-redLight text-redBrand hover:bg-redBrand hover:text-white border border-red-200 text-[10px] font-black rounded-xl active:scale-90 transition-all shadow-xs">
                  + ADD
                </button>
                
                <div class="qty-control-wrapper hidden items-center bg-redLight border border-red-200 rounded-xl p-0.5 shadow-xs">
                  <button class="btn-qty-minus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                    -
                  </button>
                  <span class="food-qty-num px-2 text-xs font-black text-redBrand min-w-[16px] text-center">1</span>
                  <button class="btn-qty-plus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                    +
                  </button>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE CATALOG, SEARCH, FILTER & CART ENGINE -->
  <script is:inline define:vars={{ initialCatalog: foodCatalog }}>
    document.addEventListener('DOMContentLoaded', () => {

      // Clear old browser cache if catalog version updated
      try {
        const CURRENT_VERSION = 'bc_food_v3.5';
        if (localStorage.getItem('bhusawal_food_catalog_version') !== CURRENT_VERSION) {
          localStorage.setItem('bhusawal_food_catalog_version', CURRENT_VERSION);
          localStorage.setItem('bhusawal_food_catalog', JSON.stringify(initialCatalog));
        }
      } catch(e) {}

      const RESTAURANT_NAMES = {
        royal_biryani: 'Royal Biryani & Caterers',
        sagar_grand: 'Hotel Sagar Grand',
        shiv_dairy: 'Shiv Dairy & Sweets',
        kwality_hub: "Kwality Wall's Ice Cream Hub",
        tandoor_hut: 'Tandoor Hut Chinese & Grill',
        south_corner: 'South Corner Dosa Point',
        burger_station: 'Burger & Fries Station'
      };

      function getActiveCatalog() {
        try {
          const stored = localStorage.getItem('bhusawal_food_catalog');
          if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed) && parsed.length > 0) return parsed;
          }
        } catch(e) {}
        return initialCatalog;
      }

      function getCart() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {
          return [];
        }
      }

      function setCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        updateCartBadge();
        syncDirectFoodQtyUi();
      }

      function updateCartBadge() {
        const cart = getCart();
        const badge = document.getElementById('food-cart-badge');
        const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
        if (badge) badge.textContent = totalQty;
      }

      let activeCatalog = getActiveCatalog();
      let activeCategoryKw = '';
      let activeDiet = 'all';
      let activeSortMode = 'default';

      // Render Food Products Grid
      function renderFoodGrid() {
        const grid = document.getElementById('direct-food-grid');
        const countSubtitle = document.getElementById('catalog-count-subtitle');
        if (!grid) return;

        const query = (document.getElementById('food-search-input')?.value || '').trim().toLowerCase();

        // 1. Filter items
        let filtered = activeCatalog.filter(item => {
          const name = (item.name || '').toLowerCase();
          const category = (item.category || '').toLowerCase();
          const keywords = (item.searchKeywords || []).join(' ').toLowerCase();
          const restName = (RESTAURANT_NAMES[item.restaurantId] || '').toLowerCase();

          // Search matching Name, Category, Restaurant Name, or Keywords
          const matchesSearch = !query || 
            name.includes(query) || 
            category.includes(query) || 
            keywords.includes(query) ||
            restName.includes(query);

          // Category Filter
          const matchesCategory = !activeCategoryKw || 
            category.includes(activeCategoryKw) || 
            keywords.includes(activeCategoryKw);

          // Diet Filter (Veg / Non-Veg)
          let matchesDiet = true;
          if (activeDiet === 'veg') matchesDiet = item.isVeg === true;
          if (activeDiet === 'nonveg') matchesDiet = item.isVeg === false;

          return matchesSearch && matchesCategory && matchesDiet;
        });

        // 2. Sort items
        if (activeSortMode === 'low-high') {
          filtered.sort((a, b) => parseFloat(a.price || 0) - parseFloat(b.price || 0));
        } else if (activeSortMode === 'high-low') {
          filtered.sort((a, b) => parseFloat(b.price || 0) - parseFloat(a.price || 0));
        }

        if (countSubtitle) {
          countSubtitle.textContent = `Showing ${filtered.length} products in Bhusawal Connect food menu`;
        }

        if (filtered.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full bg-white rounded-3xl p-8 text-center space-y-2 border border-slate-100">
              <span class="material-symbols-outlined text-4xl text-slate-300">search_off</span>
              <h3 class="text-sm font-black text-slate-800">No food items found matching your filters</h3>
              <p class="text-xs font-bold text-slate-400">Try clearing your search query or selecting another category.</p>
            </div>
          `;
          return;
        }

        let html = '';
        filtered.forEach(item => {
          const id = item.id;
          const name = item.name;
          const category = item.category || 'Food';
          const isVeg = item.isVeg !== false;
          const price = parseFloat(item.price || 0);
          const prepTime = item.prepTime || '15 mins';
          const image = item.image || '/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';

          html += `
            <div 
              class="food-product-card bg-white rounded-3xl border border-slate-100 p-3 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-red-200 transition-all duration-300 group relative"
              data-id="${id}"
            >
              <div>
                <!-- Large Food Image Container (Square Aspect) -->
                <div class="w-full aspect-square bg-slate-50/80 rounded-2xl p-2 mb-2 flex items-center justify-center border border-slate-100 overflow-hidden relative">
                  
                  <!-- Veg / Non-Veg Badge -->
                  <div class="absolute top-2 left-2 bg-white/95 backdrop-blur-md px-2 py-0.5 rounded-full text-[9px] font-black flex items-center gap-1 shadow-xs z-10 border border-slate-200">
                    <span class="w-2 h-2 rounded-full ${isVeg ? 'bg-emerald-600' : 'bg-rose-600'} shrink-0"></span>
                    <span class="${isVeg ? 'text-emerald-700' : 'text-rose-700'}">${isVeg ? 'VEG' : 'NON-VEG'}</span>
                  </div>

                  <!-- Prep Time Badge -->
                  <div class="absolute bottom-2 left-2 bg-slate-900/80 backdrop-blur-md text-white px-2 py-0.5 rounded-full text-[9px] font-extrabold flex items-center gap-0.5 shadow-xs z-10">
                    <span>⏱️ ${prepTime}</span>
                  </div>

                  <!-- Favourite Heart Button -->
                  <button class="fav-food-btn absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                    <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
                  </button>

                  <img loading="lazy" src="${image}" alt="${name}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
                </div>

                <!-- Category Tag (NO RESTAURANT NAME DISPLAYED ON CARDS) -->
                <span class="text-[10px] font-bold text-redBrand uppercase tracking-wider block mb-0.5">
                  ${category}
                </span>

                <!-- Food Name -->
                <h3 class="text-xs sm:text-[13px] font-extrabold text-slate-900 line-clamp-2 leading-snug min-h-[2.2rem]">
                  ${name}
                </h3>
              </div>

              <!-- Price & Add / Quantity Selector -->
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-1 mt-2">
                <span class="text-xs sm:text-sm font-black text-slate-900">₹${price}</span>

                <div class="food-direct-action-box" data-id="${id}" data-name="${name.replace(/"/g, '&quot;')}" data-price="${price}" data-img="${image}">
                  <button class="btn-add-direct-food px-3.5 py-1.5 bg-redLight text-redBrand hover:bg-redBrand hover:text-white border border-red-200 text-[10px] font-black rounded-xl active:scale-90 transition-all shadow-xs">
                    + ADD
                  </button>
                  
                  <div class="qty-control-wrapper hidden items-center bg-redLight border border-red-200 rounded-xl p-0.5 shadow-xs">
                    <button class="btn-qty-minus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                      -
                    </button>
                    <span class="food-qty-num px-2 text-xs font-black text-redBrand min-w-[16px] text-center">1</span>
                    <button class="btn-qty-plus w-6 h-6 rounded-lg bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white">
                      +
                    </button>
                  </div>
                </div>

              </div>
            </div>
          `;
        });

        grid.innerHTML = html;
        bindFoodActionHandlers();
        syncDirectFoodQtyUi();
      }

      function syncDirectFoodQtyUi() {
        const cart = getCart();
        document.querySelectorAll('.food-direct-action-box').forEach(box => {
          const id = box.dataset.id;
          const item = cart.find(i => i.id === id);
          const addBtn = box.querySelector('.btn-add-direct-food');
          const qtyWrapper = box.querySelector('.qty-control-wrapper');
          const qtyNum = box.querySelector('.food-qty-num');

          if (item && item.quantity > 0) {
            addBtn?.classList.add('hidden');
            qtyWrapper?.classList.remove('hidden');
            qtyWrapper?.classList.add('flex');
            if (qtyNum) qtyNum.textContent = item.quantity;
          } else {
            addBtn?.classList.remove('hidden');
            qtyWrapper?.classList.add('hidden');
            qtyWrapper?.classList.remove('flex');
          }
        });
      }

      function bindFoodActionHandlers() {
        document.querySelectorAll('.food-direct-action-box').forEach(box => {
          const id = box.dataset.id;
          const name = box.dataset.name;
          const price = parseFloat(box.dataset.price);
          const img = box.dataset.img;

          const addBtn = box.querySelector('.btn-add-direct-food');
          const minusBtn = box.querySelector('.btn-qty-minus');
          const plusBtn = box.querySelector('.btn-qty-plus');

          addBtn?.onclick = () => {
            let cart = getCart();
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity += 1;
            } else {
              cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Food Express' });
            }
            setCart(cart);
          };

          minusBtn?.onclick = () => {
            let cart = getCart();
            const existing = cart.find(i => i.id === id);
            if (existing) {
              if (existing.quantity > 1) {
                existing.quantity -= 1;
              } else {
                cart = cart.filter(i => i.id !== id);
              }
              setCart(cart);
            }
          };

          plusBtn?.onclick = () => {
            let cart = getCart();
            const existing = cart.find(i => i.id === id);
            if (existing) {
              existing.quantity += 1;
              setCart(cart);
            }
          };
        });
      }

      // Initialize Grid
      renderFoodGrid();
      updateCartBadge();

      // Search Input Listener
      const searchInput = document.getElementById('food-search-input');
      const clearBtn = document.getElementById('clear-food-search');
      searchInput?.addEventListener('input', (e) => {
        if (e.target.value.length > 0) {
          clearBtn?.classList.remove('hidden');
        } else {
          clearBtn?.classList.add('hidden');
        }
        renderFoodGrid();
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        renderFoodGrid();
      });

      // Sort Select Listener
      document.getElementById('food-sort-select')?.addEventListener('change', (e) => {
        activeSortMode = e.target.value;
        renderFoodGrid();
      });

      // Diet Filter Buttons (All, Veg, Non-Veg)
      const dietBtns = document.querySelectorAll('.diet-filter-btn');
      dietBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          dietBtns.forEach(b => {
            b.classList.remove('bg-white', 'text-slate-900', 'shadow-xs');
            b.classList.add('text-slate-600');
          });

          btn.classList.remove('text-slate-600');
          btn.classList.add('bg-white', 'text-slate-900', 'shadow-xs');

          activeDiet = btn.dataset.diet;
          renderFoodGrid();
        });
      });

      // Category Chips Listener
      const categoryChips = document.querySelectorAll('.food-cat-chip');
      categoryChips.forEach(chip => {
        chip.addEventListener('click', () => {
          categoryChips.forEach(c => {
            c.classList.remove('bg-redBrand', 'text-white', 'shadow-md', 'ring-2', 'ring-redBrand/30');
            c.classList.add('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200/80');
          });

          chip.classList.remove('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200/80');
          chip.classList.add('bg-redBrand', 'text-white', 'shadow-md', 'ring-2', 'ring-redBrand/30');

          activeCategoryKw = chip.dataset.kw || '';
          renderFoodGrid();
        });
      });

    });
  </script>
</body>
</html>
