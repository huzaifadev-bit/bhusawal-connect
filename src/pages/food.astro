---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Food Delivery | Bhusawal Connect</title>
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script src="/assets/03ba5d9f9e95fc3599acebcbe7e5fb9a.js" is:inline></script>
  <link href="/assets/31a15fd7aedbddede41c276e836f7170.css" rel="stylesheet" />
  <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <!-- RED & WHITE THEME TAILWIND CONFIGURATION -->
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            redBrand: '#E53935',
            redDark: '#C62828',
            redLight: '#FFEBEE'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #ffffff; }
    h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>

<body class="pb-28 max-w-7xl mx-auto min-h-screen text-slate-800 antialiased bg-white">

  <!-- 1. TOP HEADER (DELIVERY ADDRESS & NOTIFICATION BUTTON) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 shadow-xs flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <a href="/home" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>

      <!-- Delivery Address -->
      <div class="flex items-center gap-2 cursor-pointer hover:opacity-95 transition-opacity" id="food-address-btn">
        <div class="w-9 h-9 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <span class="text-xs font-black text-redBrand uppercase tracking-wider">DELIVERING TO</span>
            <span class="material-symbols-outlined text-sm text-redBrand">expand_more</span>
          </div>
          <p class="text-xs font-bold text-slate-800 truncate max-w-[200px] sm:max-w-xs" id="food-delivery-address-text">
            Home - Varangaon Road, Bhusawal
          </p>
        </div>
      </div>
    </div>

    <!-- Notification Button -->
    <div class="flex items-center gap-2">
      <a href="/notifications" class="relative w-10 h-10 rounded-full bg-redLight text-redBrand flex items-center justify-center font-bold hover:bg-red-100 transition-colors" title="Notifications">
        <span class="material-symbols-outlined text-xl">notifications</span>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-redBrand rounded-full border-2 border-white animate-ping"></span>
      </a>

      <a href="/cart" class="relative w-10 h-10 rounded-full bg-redBrand text-white flex items-center justify-center font-bold hover:bg-redDark transition-colors shadow-md">
        <span class="material-symbols-outlined text-xl">shopping_bag</span>
        <span id="food-cart-badge" class="absolute -top-1 -right-1 bg-slate-900 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
      </a>
    </div>

  </header>

  <main class="px-4 sm:px-6 py-5 space-y-6">

    <!-- 2. STICKY SEARCH BAR -->
    <div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md py-2">
      <div class="flex items-center gap-2 bg-slate-100/90 rounded-2xl px-4 py-3 border border-slate-200/80 shadow-inner focus-within:ring-2 focus-within:ring-redBrand/40 focus-within:bg-white transition-all">
        <span class="material-symbols-outlined text-slate-400">search</span>
        <input type="text" id="food-search-input" placeholder="Search dishes, restaurants, cuisines (e.g. Biryani, Thali, Paneer)..." class="w-full bg-transparent outline-none text-xs sm:text-sm font-bold text-slate-800 placeholder-slate-400" autocomplete="off" />
        <button id="clear-food-search" class="hidden text-slate-400 hover:text-slate-600">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- 3. STICKY FOOD CATEGORIES CHIPS SECTION -->
    <section class="sticky top-32 z-30 bg-white/95 backdrop-blur-md py-2 border-y border-slate-100/80 -mx-4 sm:-mx-6 px-4 sm:px-6">
      <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1">
        {foodCategories.map((cat, idx) => (
          <button 
            class={`food-cat-chip flex items-center gap-2 px-4 py-2.5 rounded-full font-black text-xs whitespace-nowrap cursor-pointer transition-all active:scale-95 shrink-0 ${
              idx === 0 
                ? 'bg-redBrand text-white shadow-md ring-2 ring-redBrand/30' 
                : 'bg-slate-100 text-slate-700 hover:bg-redLight hover:text-redBrand border border-slate-200/80'
            }`}
            data-kw={cat.kw}
          >
            <span class="text-base leading-none">{cat.icon}</span>
            <span>{cat.name}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 4. BANNER CAROUSEL SHOWCASE -->
    <section class="relative overflow-hidden rounded-3xl shadow-xl bg-gradient-to-r from-red-600 via-red-700 to-rose-900 text-white p-6 sm:p-8">
      <div class="relative z-10 max-w-xl space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 bg-white text-redBrand text-[10px] font-black uppercase tracking-wider rounded-full shadow-xs">BHUSAWAL FOOD EXPRESS</span>
          <span class="px-2.5 py-0.5 bg-white/20 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded-full">HOT & FRESH</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-display text-white leading-tight">Craving Something Delicious?</h1>
        <p class="text-xs sm:text-sm text-red-100 font-semibold">Order Biryani, Thalis, Starters & Sweets from top verified Bhusawal restaurants with 20-Min delivery.</p>
      </div>
    </section>

    <!-- 5. REDESIGNED FOOD CARDS GRID -->
    <!-- DESKTOP: 4 per row, LAPTOP: 3 per row, TABLET: 2 per row, MOBILE: 1 per row -->
    <section class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <div>
          <h2 class="text-xl font-black font-display text-slate-900 tracking-tight flex items-center gap-2">
            <span>🔥</span>
            <span>Popular Food Dishes</span>
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Top ordered items from verified Bhusawal kitchens</p>
        </div>
        <span class="px-3 py-1 bg-redLight text-redBrand text-xs font-black rounded-full border border-red-100">
          ⚡ 20-Min Express
        </span>
      </div>

      <div id="food-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
        {foodItems.map(item => (
          <div 
            class="food-item-card group bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-xl hover:border-red-200 transition-all duration-300 overflow-hidden flex flex-col justify-between relative" 
            data-id={item.id}
            data-name={item.name.toLowerCase()} 
            data-restaurant={item.restaurant.toLowerCase()}
            data-category={item.category.toLowerCase()}
          >
            
            <!-- Large Food Image Container -->
            <div class="h-48 sm:h-52 w-full bg-slate-100 relative overflow-hidden rounded-t-3xl">
              <img src={item.image} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/assets/c183e18c0ed9f3d665c77b7c2d692a70.jpg';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <!-- Veg / Non-Veg Badge -->
              <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-black flex items-center gap-1.5 shadow-md z-10 border border-slate-200">
                {item.isVeg ? (
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 border border-emerald-700 flex items-center justify-center shrink-0"></span>
                ) : (
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-600 border border-rose-700 flex items-center justify-center shrink-0"></span>
                )}
                <span class={item.isVeg ? 'text-emerald-700 font-extrabold' : 'text-rose-700 font-extrabold'}>
                  {item.isVeg ? 'VEG' : 'NON-VEG'}
                </span>
              </div>

              <!-- Favourite Heart Button -->
              <button class="fav-food-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-200 active:scale-90 transition-all z-10 shadow-xs" onclick="event.stopPropagation(); this.classList.toggle('text-rose-500'); this.classList.toggle('bg-rose-50'); this.classList.toggle('text-slate-400'); this.querySelector('span').textContent = this.classList.contains('text-rose-500') ? 'favorite' : 'favorite_border';">
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">favorite_border</span>
              </button>

              <!-- Rating Tag -->
              <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-md text-amber-400 px-2.5 py-1 rounded-full text-[10px] font-black flex items-center gap-1 shadow-xs z-10">
                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="text-white">{item.rating}</span>
              </div>
            </div>

            <!-- Card Details -->
            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-1">
                <p class="text-[11px] font-extrabold text-redBrand uppercase tracking-wider flex items-center gap-1">
                  <span>🏪</span> {item.restaurant}
                </p>
                <h3 class="text-sm sm:text-base font-black font-display text-slate-900 group-hover:text-redBrand transition-colors line-clamp-2 leading-snug">
                  {item.name}
                </h3>
              </div>

              <div class="flex items-center justify-between text-xs font-black text-slate-700 pt-3 border-t border-slate-100 mt-2">
                <div>
                  <span class="text-xs text-slate-400 font-bold block">MRP Price</span>
                  <span class="text-base font-black text-slate-900">₹{item.price}</span>
                </div>

                <!-- ADD BUTTON & ANIMATED QUANTITY SELECTOR CONTAINER -->
                <div class="food-card-action-box" data-id={item.id} data-name={item.name} data-price={item.price} data-img={item.image}>
                  <button class="btn-add-food px-4 py-2 bg-redBrand hover:bg-redDark text-white text-xs font-black rounded-2xl active:scale-95 transition-all shadow-md flex items-center gap-1">
                    <span>+ ADD</span>
                  </button>
                  
                  <div class="qty-control-wrapper hidden items-center bg-redLight border border-red-200 rounded-2xl p-0.5 shadow-sm">
                    <button class="btn-qty-minus w-7 h-7 rounded-xl bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white shadow-xs">
                      -
                    </button>
                    <span class="food-qty-num px-2.5 text-xs font-black text-redBrand min-w-[20px] text-center">1</span>
                    <button class="btn-qty-plus w-7 h-7 rounded-xl bg-white text-redBrand flex items-center justify-center font-black active:scale-90 transition-all hover:bg-redBrand hover:text-white shadow-xs">
                      +
                    </button>
                  </div>
                </div>

              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

  </main>

  <Switcher />

  <!-- CLIENT-SIDE CART ENGINE & ANIMATED QUANTITY CONTROLS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // Cart Storage Helper
      function getCart() {
        try {
          return JSON.parse(localStorage.getItem('bhusawal_cart') || '[]');
        } catch(e) {
          return [];
        }
      }

      function setCart(cart) {
        localStorage.setItem('bhusawal_cart', JSON.stringify(cart));
        updateCartBadge();
        syncFoodCardQtyUi();
      }

      // Update Header Cart Badge
      function updateCartBadge() {
        const cart = getCart();
        const badge = document.getElementById('food-cart-badge');
        const totalQty = cart.reduce((sum, i) => sum + (i.quantity || 1), 0);
        if (badge) badge.textContent = totalQty;
      }

      // Sync All Food Card UI with Cart Quantities
      function syncFoodCardQtyUi() {
        const cart = getCart();
        document.querySelectorAll('.food-card-action-box').forEach(box => {
          const id = box.dataset.id;
          const item = cart.find(i => i.id === id);
          const addBtn = box.querySelector('.btn-add-food');
          const qtyWrapper = box.querySelector('.qty-control-wrapper');
          const qtyNum = box.querySelector('.food-qty-num');

          if (item && item.quantity > 0) {
            addBtn?.classList.add('hidden');
            qtyWrapper?.classList.remove('hidden');
            qtyWrapper?.classList.add('flex');
            if (qtyNum) qtyNum.textContent = item.quantity;
          } else {
            addBtn?.classList.remove('hidden');
            qtyWrapper?.classList.add('hidden');
            qtyWrapper?.classList.remove('flex');
          }
        });
      }

      // Initialize UI
      updateCartBadge();
      syncFoodCardQtyUi();

      // Bind Add Button & Quantity Selectors
      document.querySelectorAll('.food-card-action-box').forEach(box => {
        const id = box.dataset.id;
        const name = box.dataset.name;
        const price = parseFloat(box.dataset.price);
        const img = box.dataset.img;

        const addBtn = box.querySelector('.btn-add-food');
        const minusBtn = box.querySelector('.btn-qty-minus');
        const plusBtn = box.querySelector('.btn-qty-plus');

        addBtn?.addEventListener('click', () => {
          let cart = getCart();
          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity += 1;
          } else {
            cart.push({ id, name, price, mrp: price, image: img, quantity: 1, cat: 'Food Delivery' });
          }
          setCart(cart);
        });

        minusBtn?.addEventListener('click', () => {
          let cart = getCart();
          const existing = cart.find(i => i.id === id);
          if (existing) {
            if (existing.quantity > 1) {
              existing.quantity -= 1;
            } else {
              cart = cart.filter(i => i.id !== id);
            }
            setCart(cart);
          }
        });

        plusBtn?.addEventListener('click', () => {
          let cart = getCart();
          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.quantity += 1;
            setCart(cart);
          }
        });
      });

      // Search & Category Filtering
      const searchInput = document.getElementById('food-search-input');
      const clearBtn = document.getElementById('clear-food-search');
      const foodCards = document.querySelectorAll('.food-item-card');
      const categoryChips = document.querySelectorAll('.food-cat-chip');

      let activeCategoryKw = '';

      function applyFoodFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();

        foodCards.forEach(card => {
          const name = card.dataset.name || '';
          const rest = card.dataset.restaurant || '';
          const cat = card.dataset.category || '';

          const matchesSearch = !query || name.includes(query) || rest.includes(query);
          const matchesCategory = !activeCategoryKw || cat.includes(activeCategoryKw) || name.includes(activeCategoryKw);

          if (matchesSearch && matchesCategory) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      searchInput?.addEventListener('input', (e) => {
        if (e.target.value.length > 0) {
          clearBtn?.classList.remove('hidden');
        } else {
          clearBtn?.classList.add('hidden');
        }
        applyFoodFilters();
      });

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        applyFoodFilters();
      });

      categoryChips.forEach(chip => {
        chip.addEventListener('click', () => {
          categoryChips.forEach(c => {
            c.classList.remove('bg-redBrand', 'text-white', 'shadow-md', 'ring-2', 'ring-redBrand/30');
            c.classList.add('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200/80');
          });

          chip.classList.remove('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200/80');
          chip.classList.add('bg-redBrand', 'text-white', 'shadow-md', 'ring-2', 'ring-redBrand/30');

          activeCategoryKw = chip.dataset.kw || '';
          applyFoodFilters();
        });
      });

    });
  </script>
</body>
</html>
