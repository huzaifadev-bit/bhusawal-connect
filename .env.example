# =================================================================
# Bhusawal Connect - Environment Configuration Template
# Copy this file to .env and populate with your production credentials.
# NEVER commit .env to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. MSG91 OTP Gateway & Widget Authentication (Required)
# -----------------------------------------------------------------
# Master MSG91 AuthKey from MSG91 Dashboard (used STRICTLY on server-side)
# Used by /api/auth/verify-phone-otp and /api/auth/verify-widget-token
# DO NOT prefix with PUBLIC_
MSG91_AUTH_KEY="your_msg91_authkey_here"

# MSG91 Widget Configuration
# Official Widget ID generated in MSG91 OTP Widget Dashboard
MSG91_WIDGET_ID="366a426b4d52323538343338"

# Optional: MSG91 Widget Token Auth (if enabled in widget settings)
# Leave empty if widget uses direct Widget ID authentication
MSG91_WIDGET_TOKEN_AUTH=""

# Fallback SMS OTP credentials (for direct API fallback if widget fails)
MSG91_TEMPLATE_ID="your_dlt_template_id_here"
MSG91_OTP_API_URL="https://control.msg91.com/api/v5/otp"

# -----------------------------------------------------------------
# 2. Supabase Configuration (Optional - for Cloud Persistence)
# -----------------------------------------------------------------
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_ACCESS_TOKEN=""

# -----------------------------------------------------------------
# 3. Firebase Authentication (Fallback OTP Provider)
# -----------------------------------------------------------------
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# -----------------------------------------------------------------
# 4. Google Sheets / Drive / Sync Integration (Optional)
# -----------------------------------------------------------------
GOOGLE_API_KEY=""
GOOGLE_SHEET_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
